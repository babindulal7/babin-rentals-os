<file path="src/modules/operations/operationsShell.css">
/* RULING 2026-10-13: keep every stage label readable and the active stage visible
   on phones; preserve all existing stage gates and navigation callbacks. */
.operations-shell__stages {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  padding-bottom: 12px;
  margin-bottom: 16px;
  border-bottom: 1px solid var(--border);
}

.operations-shell__stages .ui-button__label { min-width: 0; overflow-wrap: anywhere; }
.operations-shell__actions {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

@media (max-width: 767px) {
  .operations-shell__stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .operations-shell__actions { flex-direction: column-reverse; align-items: stretch; gap: 8px; }
}

/* Desktop dock (≥1280): the job sits beside the queue instead of covering it. */
.operations-shell__panel {
  display: flex;
  flex-direction: column;
  min-width: 0;
  position: sticky;
  top: calc(var(--header-h, 64px) + 12px);
  max-height: calc(100vh - var(--header-h, 64px) - 24px);
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--r-md, 12px);
  overflow: hidden;
}
.operations-shell__panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
}
.operations-shell__panel-title { margin: 0; font-size: var(--t-body, 15px); font-weight: 700; color: var(--text); overflow-wrap: anywhere; }
.operations-shell__panel-sub { margin: 2px 0 0; font-size: var(--t-meta); color: var(--text2); }
.operations-shell__panel-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 16px; }
.operations-shell__panel-foot { padding: 12px 16px; border-top: 1px solid var(--border); background: var(--card); }

.operations-v2__split { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--sp-md, 16px); align-items: start; }
@media (min-width: 1280px) {
  .operations-v2__split--open { grid-template-columns: minmax(0, 1fr) minmax(480px, 44%); }
}
.operations-v2__table tbody tr.operations-v2__row--active { background: color-mix(in srgb, var(--nav-active-bg) 60%, transparent); box-shadow: inset 3px 0 0 var(--primary); }
.operations-v2__table tbody tr.operations-v2__row--cursor { outline: 2px solid var(--focus-ring, var(--primary)); outline-offset: -2px; }

/* Why Confirm is disabled, in the footer beside it rather than far down the page. */
.operations-shell__blocked { margin: 0; font-size: var(--t-meta); color: var(--text2); overflow-wrap: anywhere; }

/* RULING 2026-10-14 (R14-10). Phone: the four stage steps share ONE row (icon over name over state) instead of a 2×2 grid of
   three-line buttons, and the Booking / Client cells — already in the sheet title — drop out, so the
   first screen reaches the equipment instead of ending in chrome. State stays as text + icon. */
.operations-shell__stage-name { font-weight: 600; }
@media (max-width: 767px) {
  .operations-shell__stages { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .operations-shell__stages .ui-button { flex-direction: column; justify-content: flex-start; gap: 2px; padding: 6px 2px !important; min-height: 44px; }
  .operations-shell__stages .ui-button__label { text-align: center; line-height: 1.15; max-width: 100%; overflow: hidden; }
  .operations-shell__stage-name { display: block; font-size: 11.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .operations-shell__stage-sep { display: none; }
  .operations-shell__stage-state { display: block; font-size: 10.5px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .operations-shell__strip-dup { display: none; }
}
@media (max-width: 359px) {
  .operations-shell__stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

/* RULING 2026-10-14 (R14-11). Tablet and up, full-screen sheet: the "still needed" hint sits BETWEEN the two buttons on one
   row instead of above them — a whole line of height back for the checklist. The dock keeps its
   stacked footer (it is too narrow for three things in a row). Phones keep the stacked footer. */
@media (min-width: 768px) {
  .app-modal .operations-shell__footer { flex-direction: row !important; align-items: center; gap: 12px !important; }
  .app-modal .operations-shell__actions { display: contents; }
  .app-modal .operations-shell__actions > :first-child { order: 0; }
  .app-modal .operations-shell__blocked { order: 1; flex: 1 1 0; min-width: 0; text-align: center; }
  .app-modal .operations-shell__actions > :last-child { order: 2; }
}

/* Short tablets (landscape): the four stage steps are one line each, so they do not need the
   padding that keeps them comfortable when their labels wrap. They stay ≥ 44px. */
@media (min-width: 768px) and (max-height: 860px) {
  .operations-shell__stages .ui-button { padding-top: 4px !important; padding-bottom: 4px !important; }
}


/* RULING 2026-10-16: one consistent four-step navigator for every rental operation. */
.operations-shell__stages {
  padding: 8px;
  gap: 8px;
  border: 1px solid var(--border);
  border-radius: var(--r-card);
  background: var(--surface);
}

.operations-shell__stages .operations-shell__stage {
  min-height: 64px;
  border-radius: var(--r-input);
}

.operations-shell__stage .ui-button__label {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 3px;
}

.operations-shell__stage-sep { display: none; }
.operations-shell__stage-name { font-size: var(--t-ui); }
.operations-shell__stage-state { font-size: var(--t-th); font-weight: 500; }

@media (max-width: 767px) {
  .operations-shell__stages { padding: 6px; gap: 4px; }
  .operations-shell__stage .ui-button__label { align-items: center; }
  .operations-shell__stage-name { font-size: var(--t-th); }
}
</file>

<file path="src/modules/rentals/actions/RentalLifecycleDialog.tsx">
import { useRef, useState } from 'react'
import { Modal } from '../../../components/ui/Modal'
import { Button } from '../../../components/ui/Button'
import { useAuth } from '../../../lib/auth'
import { newClientUuid } from '../../../lib/supabase'
import { archiveRental, revertRental } from '../../../actions/rentals/manageRentalLifecycle'
import { rentalRevertTargets, type RevertTarget } from '../../../lib/rentalLifecycle'
import type { SelectedRentalBookingFacts } from '../../../lib/rentalMoreActionsRegistry'

export function RentalLifecycleDialog({ booking, action, onClose, onSuccess }: {
  booking: SelectedRentalBookingFacts; action: 'revert' | 'archive'; onClose: () => void; onSuccess: () => void
}) {
  const { user } = useAuth()
  const targets = rentalRevertTargets(booking)
  const [target, setTarget] = useState<RevertTarget>(targets[0] ?? 'Quote')
  const [reason, setReason] = useState('')
  const [busy, setBusy] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const pending = useRef(false)
  // Freeze retries after an uncertain network outcome; never reuse a key for changed data.
  const request = useRef<{ bookingId: string; reason: string; clientUuid: string; targetStage?: RevertTarget } | null>(null)
  const submit = async () => {
    if (pending.current || !user) return
    pending.current = true
    setBusy(true)
    setError(null)
    request.current ??= { bookingId: booking.id, reason: reason.trim(), clientUuid: newClientUuid(),
      ...(action === 'revert' ? { targetStage: target } : {}) }
    try {
      await (action === 'archive' ? archiveRental : revertRental)(request.current, { userId: user.id, role: user.role })
      onSuccess()
      onClose()
    } catch (err) { setError(err instanceof Error ? err.message : String(err)) }
    finally { pending.current = false; setBusy(false) }
  }
  return <Modal isOpen onClose={busy ? () => {} : onClose} title={action === 'archive' ? 'Archive booking' : 'Revert booking stage'}>
    <div style={{ display: 'grid', gap: 16 }}>
      <p>{action === 'archive'
        ? 'Hide this Closed or Cancelled booking from the default rental list. It remains searchable and its history is kept.'
        : 'Only available before handover. Packing history is kept. Returning to Quote releases equipment reservations.'}</p>
      {action === 'revert' && <label>Return to
        <select aria-label="Return to stage" value={target} disabled={busy || Boolean(request.current)}
          onChange={e => setTarget(e.target.value as RevertTarget)} style={{ width: '100%', minHeight: 44,
            padding: 10, background: 'var(--input-bg)', color: 'var(--text)', border: '1px solid var(--border)', borderRadius: 8, font: 'inherit' }}>
          {targets.map(stage => <option key={stage} value={stage}>{stage}</option>)}
        </select>
      </label>}
      <label>Reason (at least 10 characters)
        <textarea aria-label="Lifecycle change reason" value={reason} disabled={busy || Boolean(request.current)}
          onChange={e => setReason(e.target.value)} rows={3} style={{ width: '100%', padding: 10,
            background: 'var(--input-bg)', color: 'var(--text)', border: '1px solid var(--border)', borderRadius: 8, font: 'inherit' }} />
      </label>
      {error && <p role="alert" style={{ color: 'var(--danger)' }}>{error}</p>}
      <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 8 }}>
        <Button variant="secondary" disabled={busy} onClick={onClose}>Back</Button>
        <Button loading={busy} disabled={!user || busy || reason.trim().length < 10} onClick={() => { void submit() }}>
          {request.current && error ? 'Retry change' : action === 'archive' ? 'Archive booking' : 'Confirm revert'}
        </Button>
      </div>
    </div>
  </Modal>
}
</file>

<file path="src/modules/rentals/booking/BookingDatesSection.tsx">
import Icon from '../../../components/ui/Icon'
import { formatBs, formatAd, type BsDate } from '../../../lib/bs'
import type { Paisa } from '../../../lib/money'
import { Section } from './BookingFormWidgets'
import { DateTimeField } from './DateTimeField'
import { DatePresets } from './DatePresets'
import { SHOOT_PRESETS } from './newRentalUtils'

export interface BookingDatesSectionProps {
  title?: string
  open: boolean
  onToggle: () => void
  days: number
  dayWord: string
  pickup: string
  pickupBs?: BsDate | null | undefined
  pickupTime: string
  ret: string
  returnTime: string
  pricingHints?: Record<number, Paisa> | undefined
  onPickupChange: (date: string) => void
  onPickupTimeChange: (time: string) => void
  onReturnChange: (date: string) => void
  onReturnTimeChange: (time: string) => void
  onPresetDatesPick: (pickup: string, ret: string) => void
  onApplyShootPreset: (presetId: (typeof SHOOT_PRESETS)[number]['id']) => void
}

export function BookingDatesSection({
  title = 'Rental period',
  open,
  onToggle,
  days,
  dayWord,
  pickup,
  pickupBs,
  pickupTime,
  ret,
  returnTime,
  pricingHints,
  onPickupChange,
  onPickupTimeChange,
  onReturnChange,
  onReturnTimeChange,
  onPresetDatesPick,
  onApplyShootPreset,
}: BookingDatesSectionProps) {
  return (
    <Section
      id="section-1"
      collapsible={false}
      title={title}
      badge={
        days > 0 ? (
          <span
            style={{
              display: 'inline-flex',
              alignItems: 'center',
              gap: 4,
              padding: '2px 8px',
              borderRadius: 'var(--r-badge)',
              background: 'var(--st-primary-bg)',
              color: 'var(--st-primary-fg)',
              fontSize: 11,
              fontWeight: 600,
            }}
          >
            <Icon name="calendar" size={11} /> {days} {dayWord}
          </span>
        ) : null
      }
      open={open}
      onToggle={onToggle}
      summary={
        days === 0
          ? 'Return must be later than pickup'
          : `${pickupBs ? formatBs(pickupBs) : formatAd(new Date(pickup))} → ${days} ${dayWord}`
      }
    >
      <div
        className="rental-day-guidance-banner"
        style={{
          display: 'flex',
          alignItems: 'center',
          gap: 8,
          marginBottom: 12,
          padding: '6px 10px',
          borderRadius: 'var(--r-xs)',
          background: 'var(--surface-2)',
          border: '1px solid var(--border)',
          fontSize: 'var(--t-meta)',
          color: 'var(--text2)',
        }}
      >
        <Icon name="info" size={13} style={{ flexShrink: 0, color: 'var(--primary)' }} />
        <span>
          <strong>Rental day runs 06:00 → 06:00 NPT.</strong> Multi-day rentals calculate continuous 24-hour spans from the 06:00 Kathmandu cut.
        </span>
      </div>
      <div className="new-rental-period-fields">
        <DateTimeField
          label="Out"
          required
          dateValue={pickup}
          timeValue={pickupTime}
          onDateChange={onPickupChange}
          onTimeChange={onPickupTimeChange}
        />
        <DateTimeField
          label="Return"
          required
          dateValue={ret}
          timeValue={returnTime}
          onDateChange={onReturnChange}
          onTimeChange={onReturnTimeChange}
          error={days === 0 ? 'Return must be later than pickup. Change the return date or its time.' : undefined}
        />
      </div>
      <div className="new-rental-date-shortcuts">
        <DatePresets
          outDate={pickup}
          returnDate={ret}
          days={days}
          onPick={onPresetDatesPick}
          minReturnDate={pickup}
          {...(pricingHints ? { priceHints: pricingHints } : {})}
        />
      </div>
      <details className="new-rental-preset-disclosure">
        <summary>Use a shoot preset</summary>
        <div className="new-rental-shoot-presets" role="group" aria-label="Production shoot presets">
          {SHOOT_PRESETS.map((p) => (
            <button
              key={p.id}
              type="button"
              className="new-rental-preset-chip"
              onClick={() => onApplyShootPreset(p.id)}
              title={p.description}
            >
              <Icon name={p.icon} size={12} />
              <span>{p.label}</span>
            </button>
          ))}
        </div>
      </details>
    </Section>
  )
}
</file>

<file path="src/modules/rentals/booking/RentalPricingSection.tsx">
import { useEffect, useState } from 'react'
import Icon from '../../../components/ui/Icon'
import { Button, Input } from '../../../components/ui'
import { Field, Section, inputStyle } from './BookingFormWidgets'
import { DiscountChips } from './DiscountChips'
import { VatToggle } from './VatToggle'
import { formatMoney, toRupees } from '../../../lib/money'
import { lookupCouponByCode } from '../../../lib/queries/couponLookup'
import {
  type PricingPipelineResult,
  promotionDateAd,
  type PromoCodeDefinition,
} from '../../../lib/pricingPipeline'
import './rental-pricing.css'

const sub = {
  margin: '0 0 12px',
  fontSize: 'var(--t-ui)',
  fontWeight: 700,
  color: 'var(--text)',
} as const

const moneyBlock = {
  background: 'var(--card2)',
  borderRadius: 'var(--r-card)',
  padding: 'var(--sp-md)',
  minWidth: 0,
} as const

export interface RentalPricingSectionProps {
  open: boolean
  onToggle: () => void
  isDesktop: boolean
  pricing: PricingPipelineResult
  canCrewMoney: boolean
  vatOn: boolean
  setVatOn: (val: boolean) => void
  vatRatePercent: number
  discountPct: number
  setDiscountPct: (pct: number) => void
  manualDiscountReason: string
  setManualDiscountReason: (r: string) => void
  manualDiscountAuthorizedBy: string
  setManualDiscountAuthorizedBy: (a: string) => void
  womenDopEligible: boolean
  setWomenDopEligible: (val: boolean) => void
  isStudentBundle: boolean
  promoCodeInput: string
  setPromoCodeInput: (code: string) => void
  promoCodeApplied: PromoCodeDefinition | null
  setPromoCodeApplied: (promo: PromoCodeDefinition | null) => void
  promoNotice: { tone: 'success' | 'danger'; text: string } | null
  setPromoNotice: (notice: { tone: 'success' | 'danger'; text: string } | null) => void
  pickupAt: Date | null
  manualDepositOverride: boolean
  setManualDepositOverride: (val: boolean) => void
  manualDepositAmount: string
  setManualDepositAmount: (val: string) => void
  depositOverrideReason: string
  setDepositOverrideReason: (r: string) => void
  depositAuthorizedBy: string
  setDepositAuthorizedBy: (a: string) => void
  title?: string
}

export function RentalPricingSection({
  open,
  onToggle,
  pricing,
  canCrewMoney: _canCrewMoney,
  vatOn,
  setVatOn,
  vatRatePercent,
  discountPct,
  setDiscountPct,
  manualDiscountReason,
  setManualDiscountReason,
  manualDiscountAuthorizedBy,
  setManualDiscountAuthorizedBy,
  womenDopEligible,
  setWomenDopEligible,
  isStudentBundle,
  promoCodeInput,
  setPromoCodeInput,
  promoCodeApplied,
  setPromoCodeApplied,
  promoNotice,
  setPromoNotice,
  pickupAt,
  manualDepositOverride,
  setManualDepositOverride,
  manualDepositAmount,
  setManualDepositAmount,
  depositOverrideReason,
  setDepositOverrideReason,
  depositAuthorizedBy,
  setDepositAuthorizedBy,
  title = 'Pricing & Terms',
}: RentalPricingSectionProps) {
  const hasDiscountOptions = womenDopEligible || Boolean(promoCodeApplied) || Boolean(promoCodeInput) || Boolean(promoNotice)
  const [discountOptionsOpen, setDiscountOptionsOpen] = useState(hasDiscountOptions)

  useEffect(() => {
    if (hasDiscountOptions) setDiscountOptionsOpen(true)
  }, [hasDiscountOptions])

  return (
    <Section
      id="section-5"
      title={title}
      badge={
        pricing.rentalTotalPaisa > 0 ? (
          <span
            className="figure"
            style={{
              display: 'inline-flex',
              alignItems: 'center',
              gap: 4,
              padding: '2px 8px',
              borderRadius: 'var(--r-badge)',
              background: 'var(--st-success-bg)',
              color: 'var(--st-success-fg)',
              fontSize: 11,
              fontWeight: 700,
            }}
          >
            {formatMoney(pricing.rentalTotalPaisa)}
          </span>
        ) : null
      }
      open={open}
      onToggle={onToggle}
      collapsible={false}
      summary={`${formatMoney(pricing.rentalTotalPaisa)} total`}
    >
      {/* RULING 2026-10-08: common pricing controls first; optional adjustments disclose their active state. */}
      <div className="new-rental-pricing-layout">
        {/* User ruling, 7 Oct: Discounts & Taxes precede Rental Charges. */}
        <div className="new-rental-pricing-adjustments" style={moneyBlock}>
          <h3 style={sub}>Discounts & Taxes</h3>
          <div style={{ marginTop: 8 }}>
            <div className="new-rental-pricing-presets">
              <DiscountChips
                percent={discountPct}
                onPercent={setDiscountPct}
                amount={formatMoney(pricing.discounts.discountPaisa)}
                onSelectPreset={(pct, reason) => {
                  setDiscountPct(pct)
                  if (reason && (!manualDiscountReason || manualDiscountReason.trim() === '')) {
                    setManualDiscountReason(reason)
                  }
                }}
              />
            </div>
            {/* User accepted label clarity, 7 Oct: optional adjustments have no star. */}
            <div className="new-rental-pricing-custom-discount">
              <Field label="Manual Discount %">
                <Input
                  type="number"
                  min={0}
                  max={100}
                  value={discountPct}
                  onChange={(e) =>
                    setDiscountPct(
                      Math.min(100, Math.max(0, Number(e.target.value) || 0)),
                    )
                  }
                  style={inputStyle}
                />
              </Field>
              <p className="new-rental-pricing-help">Choose a preset above or enter a percentage.</p>
            </div>

            {discountPct > 0 && (
              <div className="new-rental-pricing-discount-details">
                <Field label="Discount Reason (optional)">
                  <Input
                    value={manualDiscountReason}
                    onChange={(e) => setManualDiscountReason(e.target.value)}
                    placeholder="e.g. Director courtesy"
                    style={inputStyle}
                  />
                </Field>
                <Field label="Authorized By (optional note)">
                  <Input
                    value={manualDiscountAuthorizedBy}
                    onChange={(e) => setManualDiscountAuthorizedBy(e.target.value)}
                    placeholder="e.g. Babin"
                    style={inputStyle}
                  />
                </Field>
              </div>
            )}

            <div className="new-rental-pricing-vat">
              <VatToggle ratePercent={vatRatePercent} on={vatOn} onChange={setVatOn} />
            </div>

            <details
              className="new-rental-pricing-options"
              open={discountOptionsOpen}
              onToggle={(event) => setDiscountOptionsOpen(event.currentTarget.open)}
            >
              <summary>
                <span>More discount options</span>
                <span className="new-rental-pricing-option-state">
                  {[womenDopEligible ? 'Women DoP +5%' : '', promoCodeApplied?.code ?? ''].filter(Boolean).join(' · ') || 'Promo & eligibility'}
                </span>
                <Icon name="chevron_down" size={16} />
              </summary>
              <div className="new-rental-pricing-options-body">
                {/* Women DoP / Director toggle */}
                <label
                  htmlFor="women-dop-eligible"
                  className="new-rental-pricing-checkbox"
                >
                  <input
                    id="women-dop-eligible"
                    type="checkbox"
                    aria-label="Women DoP / Director (+5% discount)"
                    checked={womenDopEligible}
                    onChange={(e) => setWomenDopEligible(e.target.checked)}
                    style={{ cursor: 'pointer', width: 16, height: 16 }}
                  />
                  <span>
                    <strong>Women DoP / Director (+5% discount)</strong>
                  </span>
                </label>

                {/* Promo code */}
                <div style={{ marginTop: 12, paddingTop: 10, borderTop: '1px solid var(--border)' }}>
                  <Field label="Promo code (optional)" labelId="new-rental-promo-label">
                    <div className="new-rental-pricing-promo">
                      <Input
                        aria-labelledby="new-rental-promo-label"
                        value={promoCodeInput}
                        onChange={(e) => {
                          setPromoCodeInput(e.target.value.toUpperCase())
                          setPromoNotice(null)
                        }}
                        placeholder="Promo code"
                        style={{ ...inputStyle, textTransform: 'uppercase' }}
                      />
                      <Button
                        variant="secondary"
                        type="button"
                        aria-label="Apply promo code"
                        onClick={async () => {
                          const code = promoCodeInput.trim().toUpperCase()
                          if (!code) {
                            setPromoNotice({ tone: 'danger', text: 'Enter a promo code.' })
                            return
                          }
                          /* RULING 2026-10-07: a code is a `coupons` row, never an in-code constant. */
                          const today = promotionDateAd(pickupAt ?? new Date())
                          const found = await lookupCouponByCode(code, today)
                          if (!found.ok) {
                            setPromoNotice({ tone: 'danger', text: found.reason })
                            return
                          }
                          const promo = found.promo
                          if (promo.minSpendPaisa && pricing.grossSubtotalPaisa < promo.minSpendPaisa) {
                            setPromoNotice({
                              tone: 'danger',
                              text: `Promo "${code}" requires minimum rental spend of ${formatMoney(promo.minSpendPaisa)}.`,
                            })
                            return
                          }
                          setPromoCodeApplied(promo)
                          setPromoNotice({
                            tone: 'success',
                            text: `Promo "${code}" applied: ${promo.discountPercent}% off${promo.description ? ` (${promo.description})` : ''}.`,
                          })
                        }}
                      >
                        Apply
                      </Button>
                      {promoCodeApplied && (
                        <Button
                          variant="ghost"
                          type="button"
                          aria-label="Clear promo code"
                          onClick={() => {
                            setPromoCodeApplied(null)
                            setPromoCodeInput('')
                            setPromoNotice(null)
                          }}
                        >
                          Clear
                        </Button>
                      )}
                    </div>
                  </Field>
                </div>
              </div>
            </details>
            {promoNotice && (
                <div
                  role={promoNotice.tone === 'danger' ? 'alert' : 'status'}
                  style={{
                    marginTop: 6,
                    fontSize: '12px',
                    color:
                      promoNotice.tone === 'success' ? 'var(--st-success-fg, #065f46)' : 'var(--danger-text)',
                  }}
                >
                  {promoNotice.text}
                </div>
            )}

            {/* Active pricing rules remain visible even when optional controls are closed. */}
            {isStudentBundle && (
              <p className="new-rental-pricing-notice new-rental-pricing-notice--info">
                <Icon name="info" size={16} />
                Student/College flat-rate bundle lines do not receive stacking discounts.
              </p>
            )}

            {/* Stacking cap indicator */}
            {pricing.discounts.capped && (
              <div
                style={{
                  marginTop: 10,
                  padding: '6px 10px',
                  borderRadius: 'var(--r-btn)',
                  background: 'var(--st-warning-bg, #fffbeb)',
                  color: 'var(--st-warning-fg, #92400e)',
                  fontSize: '12px',
                }}
              >
                <Icon
                  name="alert_triangle"
                  size={12}
                  style={{ display: 'inline', marginRight: 4, verticalAlign: '-1px' }}
                />
                Discounts capped at 25% maximum per company policy.
              </div>
            )}

            {/* Validation errors */}
            {pricing.discounts.validationErrors.length > 0 && (
              <div style={{ marginTop: 9, padding: 10, borderRadius: 'var(--r-btn)', background: 'var(--st-danger-bg)' }}>
                {pricing.discounts.validationErrors.map((err, i) => (
                  <div
                    key={i}
                    style={{
                      display: 'flex',
                      gap: 6,
                      alignItems: 'flex-start',
                      fontSize: 'var(--t-meta)',
                      fontWeight: 600,
                      color: 'var(--st-danger-fg)',
                      lineHeight: 1.4,
                    }}
                  >
                    <Icon name="error" size={12} style={{ flexShrink: 0, marginTop: 2 }} />
                    {err}
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>

        {/* Security Deposit inputs */}
        <div className="new-rental-pricing-deposit-card" style={moneyBlock}>
          <h3 style={sub}>Security Deposit</h3>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginTop: 8 }}>
            <span style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>Recommended Deposit</span>
            <span style={{ fontSize: 'var(--t-meta)', fontWeight: 600 }}>
              {formatMoney(pricing.securityDeposit.recommendedPaisa)}
            </span>
          </div>

          <label
            htmlFor="manual-deposit-override"
            className="new-rental-pricing-checkbox new-rental-pricing-override"
          >
            <input
              id="manual-deposit-override"
              type="checkbox"
              aria-label="Manual security deposit override"
              aria-controls="new-rental-deposit-fields"
              aria-expanded={manualDepositOverride}
              checked={manualDepositOverride}
              onChange={(e) => {
                setManualDepositOverride(e.target.checked)
                if (!e.target.checked) {
                  setManualDepositAmount('')
                  setDepositOverrideReason('')
                  setDepositAuthorizedBy('')
                } else {
                  setManualDepositAmount(String(toRupees(pricing.securityDeposit.recommendedPaisa)))
                }
              }}
            />
            <span>Manual Deposit Override</span>
            <span className="new-rental-pricing-option-state">{manualDepositOverride ? 'On' : 'Off'}</span>
          </label>

          {manualDepositOverride && (
            <div id="new-rental-deposit-fields" className="new-rental-pricing-deposit-fields">
              <Field label="Override Amount (Rs) *">
                <Input
                  type="number"
                  min={0}
                  value={manualDepositAmount}
                  onChange={(e) => setManualDepositAmount(e.target.value)}
                  placeholder="0"
                  style={inputStyle}
                />
              </Field>
              <Field label="Override Reason *">
                <Input
                  value={depositOverrideReason}
                  onChange={(e) => setDepositOverrideReason(e.target.value)}
                  placeholder="e.g. Low risk repeat client with corporate guarantee"
                  style={inputStyle}
                />
              </Field>
              <Field label="Authorized By *">
                <Input
                  value={depositAuthorizedBy}
                  onChange={(e) => setDepositAuthorizedBy(e.target.value)}
                  placeholder="e.g. Managing Director Babin"
                  style={inputStyle}
                />
              </Field>
            </div>
          )}

          {pricing.securityDeposit.validationErrors.length > 0 && (
            <div style={{ marginTop: 9, padding: 10, borderRadius: 'var(--r-btn)', background: 'var(--st-danger-bg)' }}>
              {pricing.securityDeposit.validationErrors.map((err, i) => (
                <div
                  key={i}
                  style={{
                    display: 'flex',
                    gap: 6,
                    alignItems: 'flex-start',
                    fontSize: 'var(--t-meta)',
                    fontWeight: 600,
                    color: 'var(--st-danger-fg)',
                    lineHeight: 1.4,
                  }}
                >
                  <Icon name="error" size={12} style={{ flexShrink: 0, marginTop: 2 }} />
                  {err}
                </div>
              ))}
            </div>
          )}

          <p className="new-rental-pricing-help" style={{ marginTop: 12 }}>
            Refundable and separate from rent. It never reduces rental outstanding.
          </p>
          <p className="new-rental-pricing-payment-note" style={{ marginTop: 12 }}>
            <Icon name="info" size={16} />
            <span>Record advance payments and deposits in Booking Detail after the booking and invoice are created.</span>
          </p>
        </div>
      </div>
    </Section>
  )
}
