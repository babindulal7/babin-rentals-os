.movement-panel__search-input::placeholder {
  color: var(--text-tertiary);
}

.movement-panel__search-clear {
  position: absolute;
  right: 0.25rem;
  width: 2.75rem;
  height: 2.75rem;
  border: none;
  background: transparent;
  color: var(--muted);
  display: grid;
  place-items: center;
  cursor: pointer;
  border-radius: var(--r-btn);
  padding: 0;
}

.movement-panel__search-clear:hover {
