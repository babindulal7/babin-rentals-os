import { useId, type ReactNode } from 'react'
import Icon, { type IconName } from './Icon'
import './choice-cards.css'

export interface ChoiceCardOption<T extends string = string> {
  value: T
  label: string
  /** One short line under the label: what the option means, never what it costs. */
  hint?: string
  icon?: IconName
  disabled?: boolean
}

export interface ChoiceCardsProps<T extends string = string> {
  /** The visible group label, rendered as the fieldset's legend. */
  legend: ReactNode
  /** Shared `name` for the radio inputs — one per group on the page. */
  name: string
  options: readonly ChoiceCardOption<T>[]
  value: T
  onChange: (value: T) => void
  required?: boolean
  /** Narrowest a card may get before the grid drops a column. */
  minCardWidth?: string
}

/**
 * # ChoiceCards — a short list of mutually exclusive options as tap cards
 *
 * For a form value with a handful of options, where a `<select>` costs two taps
 * (open, pick) and hides the choices until opened. Every option is on screen and
 * one tap selects it (R-39). Taken from the Miraz Bakery POS payment step.
 *
 * Not `SegmentedControl`: that is a `tablist` for switching views. This is a
 * form value, so it is a `fieldset` of native radios. The browser supplies the
 * keyboard behaviour (Tab into the group, arrows move the choice) and the
 * accessible name, so none of it is re-implemented here.
 *
 * - Law 11: the chosen card shows a check icon and a heavier border, not only a
 *   colour change.
 * - Law 13/14: the grid is `auto-fit`, so it reflows by the width it is given,
 *   with no breakpoint and no platform branch.
 * - Law 15: every card is at least `var(--tap)` tall.
 */
export function ChoiceCards<T extends string = string>({
  legend,
  name,
  options,
  value,
  onChange,
  required = false,
  // 10rem leaves room for the icon, a short label and its hint on one line
  // each (three across in the Record Payment dialog, one column on a phone).
  minCardWidth = '10rem',
}: ChoiceCardsProps<T>) {
  // Each radio gets an id its card's label points at. Wrapping alone would
  // label it too, but an explicit `for` is what every assistive tech honours.
  const baseId = useId()
  return (
    <fieldset className="choice-cards">
      <legend className="choice-cards__legend">
        {legend}
        {required && (
          <>
            {' '}
            <span aria-hidden="true" style={{ color: 'var(--danger)' }}>*</span>
          </>
        )}
      </legend>
      <div
        className="choice-cards__grid"
        style={{ gridTemplateColumns: `repeat(auto-fit, minmax(min(100%, ${minCardWidth}), 1fr))` }}
      >
        {options.map((o, i) => {
          const checked = o.value === value
          const inputId = `${baseId}-${i}`
          return (
            <label
              key={o.value}
              htmlFor={inputId}
              className="choice-card"
              data-checked={checked ? 'true' : undefined}
              data-disabled={o.disabled ? 'true' : undefined}
            >
              <input
                id={inputId}
                type="radio"
                className="choice-card__input"
                name={name}
                value={o.value}
                checked={checked}
                disabled={o.disabled}
                required={required}
                onChange={() => onChange(o.value)}
              />
              {o.icon && <Icon name={o.icon} size={18} className="choice-card__icon" />}
              <span className="choice-card__text">
                <span className="choice-card__label">{o.label}</span>
                {o.hint && <span className="choice-card__hint">{o.hint}</span>}
              </span>
              {/* A corner badge, not an inline icon: it takes no width from the
                  label, so choosing a card never re-wraps its text. */}
              {checked && (
                <span className="choice-card__check">
                  <Icon name="check" size={12} fill />
                </span>
              )}
            </label>
          )
        })}
      </div>
    </fieldset>
  )
}
</file>

<file path="src/components/ui/ConfirmDialog.tsx">
import { useState } from 'react'
import type { ReactNode } from 'react'
import { Modal } from './Modal'
import { Button } from './Page'

/**
 * Shared confirm/destructive-action dialog, built on Modal (size="sm").
 *
 * Mirrors the reason-gate UX already hand-rolled in ClientDetail.tsx /
 * ClientsDirectory.tsx's "Block Client" flow and VoidInvoiceModal.tsx: a
 * required textarea with a minimum length, a live character count, and a
 * confirm button that stays disabled until the reason clears the bar.
 */

export interface ConfirmDialogProps {
  isOpen: boolean
  onClose: () => void
  onConfirm: (reason?: string) => void
  title: string
  /** Body copy — a plain string or richer JSX describing the consequence. */
  description?: ReactNode
  confirmLabel?: string
  cancelLabel?: string
  /** 'danger' renders the confirm button in the destructive/red skin. */
  variant?: 'default' | 'danger'
  /** When set, a required reason textarea gates the confirm button. */
  requireReason?: { minLength: number; label: string }
  /** Disables the confirm button independent of the reason gate (e.g. while a submit is in flight). */
  isSubmitting?: boolean
}

export function ConfirmDialog({
  isOpen,
  onClose,
  onConfirm,
  title,
  description,
  confirmLabel = 'Confirm',
  cancelLabel = 'Cancel',
  variant = 'default',
  requireReason,
  isSubmitting = false,
}: ConfirmDialogProps) {
  const [reason, setReason] = useState('')

  const trimmedLength = reason.trim().length
  const reasonSatisfied = !requireReason || trimmedLength >= requireReason.minLength
  const canConfirm = reasonSatisfied && !isSubmitting

  const handleClose = () => {
    setReason('')
    onClose()
  }

  const handleConfirm = () => {
    if (!canConfirm) return
    onConfirm(requireReason ? reason.trim() : undefined)
  }

  return (
    <Modal
      isOpen={isOpen}
      onClose={handleClose}
      title={title}
      size="sm"
      footer={
        <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 10, width: '100%' }}>
          <Button variant="secondary" onClick={handleClose} disabled={isSubmitting}>
            {cancelLabel}
          </Button>
          <Button
            variant={variant === 'danger' ? 'danger' : 'primary'}
            onClick={handleConfirm}
            disabled={!canConfirm}
          >
            {confirmLabel}
          </Button>
        </div>
      }
    >
      <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
        {description && (
          <div style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', lineHeight: 1.5 }}>{description}</div>
        )}

        {requireReason && (
          <label style={{ display: 'flex', flexDirection: 'column', gap: 6, fontSize: 'var(--t-meta)' }}>
            <span style={{ fontWeight: 600, color: 'var(--text2)' }}>{requireReason.label}</span>
            <textarea
              value={reason}
              onChange={(e) => setReason(e.target.value)}
              rows={3}
              style={{
                padding: 10,
                borderRadius: 'var(--r-input)',
                border: '1px solid var(--border)',
                background: 'var(--card2)',
                color: 'var(--text)',
                fontSize: 'var(--t-meta)',
                fontFamily: 'inherit',
                resize: 'vertical',
              }}
            />
            <span style={{ color: reasonSatisfied ? 'var(--muted)' : 'var(--danger)' }}>
              {trimmedLength} / {requireReason.minLength} characters minimum
            </span>
          </label>
        )}
      </div>
    </Modal>
  )
}
</file>

<file path="src/components/ui/ConflictNotificationBanner.tsx">
import { useState, useEffect } from 'react'
import Icon from './Icon'
import { countUnresolvedConflicts } from '../../lib/offlineQueue'
import { ConflictResolutionModal } from './ConflictResolutionModal'

/**
 * ConflictNotificationBanner — Plan §Phase 9 Conflict Notification
 *
 * Implements:
 * - Surfaces detected sync conflicts prominently so they are never silent.
 * - Opens the interactive ConflictResolutionModal naming both sides.
 * - Adheres to Law 11 (icon + label + colour) and Law 15 (44×44px touch target).
 */
export function ConflictNotificationBanner() {
  const [conflictCount, setConflictCount] = useState(0)
  const [modalOpen, setModalOpen] = useState(false)

  const checkConflicts = async () => {
    try {
      const count = await countUnresolvedConflicts()
      setConflictCount(count)
    } catch {
      // Storage unavailable or checking error
    }
  }

  useEffect(() => {
    void checkConflicts()
    const interval = setInterval(() => void checkConflicts(), 15000)
    return () => clearInterval(interval)
  }, [])

  if (conflictCount === 0) return null

  return (
    <>
      <div
        data-testid="conflict-notification-banner"
        style={{
          /* The danger status pair from theme.css — solid fill, its own ink. */
          background: 'var(--st-danger-bg)',
          color: 'var(--st-danger-fg)',
          padding: '6px 16px',
          fontSize: 'var(--t-meta)',
          fontWeight: 600,
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between',
          gap: 12,
        }}
      >
        <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
          <Icon name="alert_triangle" size={16} />
          <span>
            {conflictCount === 1
              ? '1 offline sync conflict requires review'
              : `${conflictCount} offline sync conflicts require review`}
            {' — a newer server edit was detected during replay.'}
          </span>
        </div>

        <button
          type="button"
          onClick={() => setModalOpen(true)}
          data-testid="review-conflicts-btn"
          style={{
            /* The same pair inverted. main's copy painted --st-danger-fg under
               #fff text, which on this theme is white on white. */
            background: 'var(--st-danger-fg)',
            color: 'var(--st-danger-bg)',
            border: 'none',
            borderRadius: 'var(--r-btn)',
            padding: '0 12px',
            minHeight: 44, // Law 15 minimum touch target
            minWidth: 44,
            cursor: 'pointer',
            fontSize: 'var(--t-meta)',
            fontWeight: 600,
            fontFamily: 'inherit',
            display: 'inline-flex',
            alignItems: 'center',
            justifyContent: 'center',
          }}
        >
          Review Conflicts
        </button>
      </div>

      <ConflictResolutionModal
        isOpen={modalOpen}
        onClose={() => {
          setModalOpen(false)
          void checkConflicts()
        }}
        onResolved={() => void checkConflicts()}
      />
    </>
  )
}
