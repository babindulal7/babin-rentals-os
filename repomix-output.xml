import { PageHeader, type PageHeaderProps } from './Page'

export interface ScreenHeaderProps extends Omit<PageHeaderProps, 'title'> {
  embedded?: boolean | undefined
  title: string
}

/**
 * Universal embedded-page header contract.
 *
 * When `embedded` is true (e.g. inside tabbed interfaces like Clients, Inventory,
 * Finance, or Tools):
 * - Suppresses duplicate <h1> and outer page-title block
 * - Retains contextual description as a clean subtitle row
 * - Preserves primary and secondary actions without competing with the parent page header
 *
 * When `embedded` is false:
 * - Renders the standard full PageHeader.
 */
export function ScreenHeader({
  embedded = false,
  leading,
  icon,
  title,
  description,
  actions,
  ...rest
}: ScreenHeaderProps) {
  if (!embedded) {
    return (
      <PageHeader
        title={title}
        {...(leading !== undefined ? { leading } : {})}
        {...(icon !== undefined ? { icon } : {})}
        {...(description !== undefined ? { description } : {})}
        {...(actions !== undefined ? { actions } : {})}
        {...rest}
      />
    )
  }

  // When embedded and having no subtitle or actions, suppress empty row
  if (!description && !actions && !leading) return null

  return (
    <div
      className="screen-header-embedded"
      style={{
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'space-between',
        gap: 'var(--sp-md)',
        flexWrap: 'wrap',
        marginBottom: 'var(--sp-sm)',
      }}
    >
      <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)', minWidth: 0, flex: '1 1 260px' }}>
        {leading}
        {description ? (
          <p style={{ margin: 0, minWidth: 0, fontSize: 'var(--t-meta)', color: 'var(--text2)', lineHeight: 1.5 }}>
            {description}
          </p>
        ) : (
          <span />
        )}
      </div>
      {actions && (
        <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)', flexWrap: 'wrap', marginLeft: 'auto', alignSelf: 'flex-start', flexShrink: 0 }}>
          {actions}
        </div>
      )}
    </div>
  )
}

export default ScreenHeader
</file>

<file path="src/components/ui/Select.tsx">
import React, { forwardRef, useState, useRef, useEffect, useId, useCallback, ReactNode, useImperativeHandle } from 'react'
import { createPortal } from 'react-dom'
import Icon from './Icon'
import { InfoTooltip } from './InfoTooltip'
import { floatingLayer } from './floatingLayer'

export interface SelectOption {
  value: string
  label: ReactNode
  disabled?: boolean
}

export interface SelectProps extends Omit<React.SelectHTMLAttributes<HTMLSelectElement>, 'options'> {
  label?: string
  error?: string | null
  helperText?: string
  info?: ReactNode
  options?: SelectOption[]
  icon?: React.ReactNode
  placeholder?: string
}

export const Select = forwardRef<HTMLSelectElement, SelectProps>(
  ({ label, error, helperText, info, options, icon, children, className, style, id, value, defaultValue, onChange, ...props }, ref) => {
    const selectId = id || (label ? label.toLowerCase().replace(/\s+/g, '-') : undefined)
    const reactId = useId()
    /* Stable ids for the ARIA wiring. The native select keeps `selectId`
       untouched (tests and any getElementById callers depend on it); the
       trigger and listbox derive their own. */
    const baseId = selectId ?? `select-${reactId}`
    const triggerId = `${baseId}-trigger`
    const labelId = `${baseId}-label`
    const listboxId = `${baseId}-listbox`
    const optionId = (i: number) => `${baseId}-opt-${i}`

    const [isOpen, setIsOpen] = useState(false)
    const [highlight, setHighlight] = useState(-1)
    const containerRef = useRef<HTMLDivElement>(null)
    const triggerRef = useRef<HTMLButtonElement>(null)
    const nativeSelectRef = useRef<HTMLSelectElement>(null)
    const listboxRef = useRef<HTMLDivElement>(null)
    /* Floating position of the portaled listbox. Measured from the trigger
       when the menu opens and re-measured on scroll/resize so it tracks. */
    const [menuPos, setMenuPos] = useState<{ top: number; left: number; width: number; maxHeight: number } | null>(null)
    const typeahead = useRef({ query: '', at: 0 })

    // Forward ref manually so we can still use the local ref if needed
    useImperativeHandle(ref, () => nativeSelectRef.current as HTMLSelectElement)

    // Parse options from children if `options` is not provided
    const parsedOptions: SelectOption[] = options || React.Children.toArray(children).map(child => {
      if (React.isValidElement(child) && child.type === 'option') {
        /* RULING 2026-09-23 (visual pass): bare `<option>Label</option>` children
           carried no `value`, so the native shadow select mounted them with
           `key={undefined}` — React's unique-key warning on every screen — and
           the trigger's open-value comparison read undefined. A bare option's
           value is its text content (that's how a native select answers it),
           so the parse does exactly that. */
        return {
          value: child.props.value ?? String(child.props.children),
          label: child.props.children,
          disabled: child.props.disabled
        }
      }
      return null
    }).filter(Boolean) as SelectOption[]

    // Controlled vs uncontrolled state for internal tracking
    const [internalValue, setInternalValue] = useState<string | number | readonly string[] | undefined>(value ?? defaultValue)
    const activeValue = value !== undefined ? value : internalValue

    const selectedIndex = parsedOptions.findIndex(o => String(o.value) === String(activeValue))
    const selectedOption = selectedIndex >= 0 ? parsedOptions[selectedIndex] : undefined
    const displayLabel = selectedOption ? selectedOption.label : (activeValue || '')

    useEffect(() => {
      const handleClickOutside = (event: MouseEvent) => {
        const target = event.target as Node
        // The open listbox is portaled to document.body — a pointer inside
        // it is logically inside, even though it is outside `containerRef`.
        if (listboxRef.current?.contains(target)) return
        if (containerRef.current && !containerRef.current.contains(target)) {
          setIsOpen(false)
        }
      }
      document.addEventListener('mousedown', handleClickOutside)
      return () => document.removeEventListener('mousedown', handleClickOutside)
    }, [])

    /* Keep the keyboard highlight visible as it moves through a long list. */
    useEffect(() => {
      if (!isOpen || highlight < 0) return
      document.getElementById(optionId(highlight))?.scrollIntoView({ block: 'nearest' })
      // eslint-disable-next-line react-hooks/exhaustive-deps
    }, [isOpen, highlight])

    /* Measures the trigger and places the floating listbox: below it when
       there is room, above it when the viewport bottom is tight. */
    const measureMenu = useCallback(() => {
      const el = triggerRef.current
      if (!el) return
      const r = el.getBoundingClientRect()
      const MENU_GAP = 6
      const MENU_MAX = 300
      const roomBelow = Math.max(0, window.innerHeight - r.bottom - MENU_GAP - 8)
      const roomAbove = Math.max(0, r.top - MENU_GAP - 8)
      const openUp = roomBelow < 160 && roomAbove > roomBelow
      const width = Math.min(r.width, Math.max(0, window.innerWidth - 16))
      const left = Math.max(8, Math.min(r.left, window.innerWidth - width - 8))
      setMenuPos(
        openUp
          ? { top: Math.max(8, r.top - MENU_GAP - Math.min(MENU_MAX, roomAbove)), left, width, maxHeight: Math.min(MENU_MAX, roomAbove) }
          : { top: Math.max(8, r.bottom + MENU_GAP), left, width, maxHeight: Math.min(MENU_MAX, roomBelow) },
      )
    }, [])

    /* Re-track the trigger while open so scrolling never detaches the menu. */
    useEffect(() => {
      if (!isOpen) return
      window.addEventListener('scroll', measureMenu, true)
      window.addEventListener('resize', measureMenu)
      return () => {
        window.removeEventListener('scroll', measureMenu, true)
        window.removeEventListener('resize', measureMenu)
      }
    }, [isOpen, measureMenu])

    const openMenu = () => {
      if (props.disabled) return
      setHighlight(selectedIndex >= 0 ? selectedIndex : nextEnabled(-1, 1))
      measureMenu()
      setIsOpen(true)
    }

    const closeMenu = () => {
      setIsOpen(false)
      setHighlight(-1)
    }

    /* First enabled index walking from `from` in `dir` (1 or -1); -1 if none. */
    const nextEnabled = (from: number, dir: 1 | -1): number => {
      for (let i = from + dir; i >= 0 && i < parsedOptions.length; i += dir) {
        const o = parsedOptions[i]
        if (o && !o.disabled) return i
      }
      return -1
    }

    const handleSelect = (val: string) => {
      if (value === undefined) {
        setInternalValue(val)
      }
      closeMenu()

      // Trigger native select change event so React hook form / standard onChange handlers work properly
      if (nativeSelectRef.current) {
        const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLSelectElement.prototype, 'value')?.set
        nativeInputValueSetter?.call(nativeSelectRef.current, val)
        const event = new Event('change', { bubbles: true })
        nativeSelectRef.current.dispatchEvent(event)
      }
      if (onChange) {
        // Fallback synthetic event just in case
        onChange({
          target: { value: val },
          currentTarget: { value: val }
        } as React.ChangeEvent<HTMLSelectElement>)
      }
    }

    /* Single-character typeahead: successive keystrokes within a second build
       a prefix; only string labels participate (ReactNode labels can't). */
    const handleTypeahead = (char: string) => {
      const now = Date.now()
      const t = typeahead.current
      t.query = now - t.at > 1000 ? char : t.query + char
      t.at = now
      const q = t.query.toLowerCase()
      const start = isOpen && highlight >= 0 ? highlight : selectedIndex
      const n = parsedOptions.length
      for (let step = 1; step <= n; step += 1) {
        const i = (start + step + n) % n
        const opt = parsedOptions[i]
        if (!opt || opt.disabled || typeof opt.label !== 'string') continue
        if (opt.label.toLowerCase().startsWith(q)) {
          if (isOpen) setHighlight(i)
          else handleSelect(opt.value)
          return
        }
      }
    }

    const handleTriggerKeyDown = (e: React.KeyboardEvent<HTMLButtonElement>) => {
      if (props.disabled) return
      if (!isOpen) {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Enter' || e.key === ' ') {
          e.preventDefault()
          openMenu()
          return
        }
        if (e.key.length === 1 && !e.altKey && !e.ctrlKey && !e.metaKey) {
          handleTypeahead(e.key)
        }
        return
      }
      switch (e.key) {
        case 'Escape':
          e.preventDefault()
          /* The dropdown consumes its own Escape. Without this, Modal's
             window-level listener also fired and closed the surrounding form. */
          e.stopPropagation()
          closeMenu()
          return
        case 'ArrowDown': {
          e.preventDefault()
          const next = nextEnabled(highlight, 1)
          if (next !== -1) setHighlight(next)
          return
        }
        case 'ArrowUp': {
          e.preventDefault()
          const prev = nextEnabled(highlight, -1)
          if (prev !== -1) setHighlight(prev)
          return
        }
        case 'Home': {
          e.preventDefault()
          const first = nextEnabled(-1, 1)
          if (first !== -1) setHighlight(first)
          return
        }
        case 'End': {
          e.preventDefault()
          const last = nextEnabled(parsedOptions.length, -1)
          if (last !== -1) setHighlight(last)
          return
        }
        case 'Enter':
        case ' ': {
          e.preventDefault()
          const chosen = highlight >= 0 ? parsedOptions[highlight] : undefined
          if (chosen && !chosen.disabled) {
            handleSelect(chosen.value)
          } else {
            closeMenu()
          }
          return
        }
        case 'Tab':
          // Tab commits nothing and moves on — close so the popup doesn't
          // linger over whatever gets focus next.
          closeMenu()
          return
        default:
          if (e.key.length === 1 && !e.altKey && !e.ctrlKey && !e.metaKey) {
            e.preventDefault()
            handleTypeahead(e.key)
          }
      }
    }
    return (
      <div style={{ width: '100%', display: 'flex', flexDirection: 'column', gap: 6 }}>
        {label && (
          <div style={{ display: 'flex', alignItems: 'center', gap: 4 }}>
            <label
              id={labelId}
              /* Points at the TRIGGER now, not the invisible native select —
                 clicking the label focuses the control a user can actually see. */
              htmlFor={triggerId}
              style={{
                fontSize: 'var(--t-th)',
                fontWeight: 600,
                textTransform: 'uppercase',
                letterSpacing: '0.04em',
                color: 'var(--muted)',
              }}
            >
              {label}
              {props.required && <span style={{ color: 'var(--danger-text)', marginLeft: 'var(--sp-xs)' }}>*</span>}
            </label>
            {info && <InfoTooltip content={info} />}
          </div>
        )}

        <div ref={containerRef} style={{ position: 'relative', display: 'flex', alignItems: 'center' }}>

          {/* Hidden native select — the form/test bridge. Out of the tab order
              and the accessibility tree; the trigger below is the control. */}
          <select
            id={selectId}
            ref={nativeSelectRef}
            value={activeValue}
            onChange={onChange}
            tabIndex={-1}
            aria-hidden="true"
            style={{ opacity: 0, position: 'absolute', pointerEvents: 'none', width: 0, height: 0, zIndex: -1 }}
            {...props}
          >
            {parsedOptions.map((opt) => (
              <option key={opt.value} value={opt.value} disabled={opt.disabled}>
                {typeof opt.label === 'string' || typeof opt.label === 'number' ? opt.label : opt.value}
              </option>
            ))}
          </select>

          {icon && (
            <div
              style={{
                position: 'absolute',
                left: 12,
                display: 'flex',
                alignItems: 'center',
                pointerEvents: 'none',
                color: 'var(--muted)',
                zIndex: 2,
              }}
            >
              {icon}
            </div>
          )}

          {/* Trigger button */}
          <button
            id={triggerId}
            ref={triggerRef}
            type="button"
            className={className}
            role="combobox"
            aria-haspopup="listbox"
            aria-expanded={isOpen}
            aria-controls={isOpen ? listboxId : undefined}
            aria-activedescendant={isOpen && highlight >= 0 ? optionId(highlight) : undefined}
            /* Label + own content, so a screen reader hears "Payment method,
               Cash, combobox" rather than the label alone. */
            aria-labelledby={label ? `${labelId} ${triggerId}` : undefined}
            aria-label={props['aria-label']}
            aria-invalid={error ? true : undefined}
            aria-required={props.required || props['aria-required'] || undefined}
            onClick={() => {
              if (props.disabled) return
              if (isOpen) closeMenu()
              else openMenu()
            }}
            onKeyDown={handleTriggerKeyDown}
            style={{
              width: '100%',
              minHeight: 44,
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
              padding: '8px 14px',
              paddingLeft: icon ? 38 : 14,
              paddingRight: 38,
              fontSize: 'var(--t-body)',
              borderRadius: 'var(--r-input)',
              background: 'var(--input-bg)',
              border: '1px solid',
              borderColor: error ? 'var(--danger)' : isOpen ? 'var(--input-focus)' : 'var(--input-border)',
              color: activeValue !== undefined && activeValue !== '' ? 'var(--text)' : 'var(--muted)',
              transition: 'border-color 0.15s ease',
              cursor: props.disabled ? 'not-allowed' : 'pointer',
              opacity: props.disabled ? 0.5 : 1,
              ...style,
            }}
          >
            <span style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
              {displayLabel || (props.placeholder ? props.placeholder : 'Select...')}
            </span>
            <div
              style={{
                position: 'absolute',
                right: 12,
                display: 'flex',
                alignItems: 'center',
                pointerEvents: 'none',
                color: 'var(--muted)',
                transform: isOpen ? 'rotate(180deg)' : 'none',
                transition: 'transform 0.2s ease',
              }}
            >
              <Icon name="chevron_down" size={16} />
            </div>
          </button>

          {/* Dropdown Menu — portaled to document.body so table scroll
              containers, drawers and modals can never clip it. Position is
              measured from the trigger (see measureMenu). */}
          {isOpen && menuPos && createPortal(
            <div
              id={listboxId}
              ref={listboxRef}
              role="listbox"
              aria-labelledby={label ? labelId : undefined}
              style={{
                position: 'fixed',
                top: menuPos.top,
                left: menuPos.left,
                width: menuPos.width,
                zIndex: floatingLayer(triggerRef.current),
                maxHeight: menuPos.maxHeight,
                overflowY: 'auto',
                background: 'var(--dropdown)',
                backdropFilter: 'blur(16px)',
                WebkitBackdropFilter: 'blur(16px)',
                border: '1px solid var(--border2)',
                borderRadius: 'var(--r-card)',
                boxShadow: 'var(--shadow-xl)',
                padding: '6px',
                animation: 'modal-scale-in 0.18s cubic-bezier(0.16, 1, 0.3, 1)',
                display: 'flex',
                flexDirection: 'column',
                gap: 2,
              }}
            >
              {parsedOptions.map((opt, i) => {
                const isSelected = String(activeValue) === String(opt.value)
                const isHighlighted = i === highlight
                return (
                  /* role="option", not <button>: focus never leaves the trigger
                     (select-only combobox pattern), the highlight travels via
                     aria-activedescendant instead. */
                  <div
                    key={opt.value}
                    id={optionId(i)}
                    role="option"
                    aria-selected={isSelected}
                    aria-disabled={opt.disabled || undefined}
                    onClick={() => {
                      if (!opt.disabled) handleSelect(opt.value)
                    }}
                    onMouseEnter={() => {
                      if (!opt.disabled) setHighlight(i)
                    }}
                    style={{
                      width: '100%',
                      textAlign: 'left',
                      padding: '8px 12px',
                      fontSize: 'var(--t-body)',
                      background: isSelected
                        ? 'var(--st-primary-bg)'
                        : isHighlighted
                          ? 'var(--surface-card-hover)' // RULING 2026-09-23: --st-hover never existed; its rgba(0,0,0,.05) fallback is invisible on the dark theme
                          : 'transparent',
                      color: isSelected ? 'var(--st-primary-fg)' : opt.disabled ? 'var(--muted)' : 'var(--text)',
                      borderRadius: 'var(--r-xs)',
                      border: 'none',
                      cursor: opt.disabled ? 'not-allowed' : 'pointer',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'space-between',
                      transition: 'background 0.1s ease',
                    }}
                  >
                    <span>{opt.label}</span>
                    {isSelected && <Icon name="check" size={16} style={{ color: 'var(--primary)', flexShrink: 0 }} />}
                  </div>
                )
              })}
              {parsedOptions.length === 0 && (
                <div style={{ padding: '12px', color: 'var(--muted)', fontSize: 'var(--t-meta)', textAlign: 'center' }}>
                  No options
                </div>
              )}
            </div>,
            document.body,
          )}
        </div>

        {error ? (
          <div
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: 6,
              fontSize: 'var(--t-meta)',
              color: 'var(--danger-text)',
            }}
          >
            <Icon name="error" size={14} />
            <span>{error}</span>
          </div>
        ) : helperText ? (
          <span style={{ fontSize: 'var(--t-meta)', color: 'var(--muted)' }}>{helperText}</span>
        ) : null}
      </div>
    )
  }
)

Select.displayName = 'Select'
</file>

<file path="src/components/ui/ServiceDueBadge.tsx">
import React from 'react'
import { IconTool } from '@tabler/icons-react'
import { Badge } from './Badge'
import { serviceStatus, type ServiceRow } from '../../lib/serviceDue'

export interface ServiceDueBadgeProps {
  /** One row of `product_units_service_v`, or nothing known about this unit. */
  row: ServiceRow | undefined
  size?: 'sm' | 'md'
}

/**
 * `Service due` — RULING 2026-09-08 (R-28).
 *
 * ## It renders NOTHING when nothing is due
 *
 * Not an "OK" badge, not a grey dash. Most models have no preventive plan at
 * all, so most rows have nothing to say, and a column of green ticks is how the
 * eye learns to skip the one amber row. `serviceStatus` returns `null` for that
 * case and this returns `null` with it.
 *
 * ## Warns only
 *
 * This is a badge and never a gate. R-28: the unit **stays bookable**, nothing
 * moves it to Maintenance, nothing opens a work order. A caller that disables an
 * action because this rendered has misread the ruling — the Packing Queue shows
 * it *beside* an enabled Pack button on purpose.
 *
 * ## Never colour alone
 *
 * Wrench icon + words + tone, in that order of reliability. The words change
 * (`Service due` → `Overdue by 12 days`) before the colour does, so the state is
 * legible in greyscale, at a glance, and to a screen reader — CLAUDE.md's
 * "never colour alone", which is an accessibility rule first.
 *
 * The tooltip carries the reason and the counters (`— usage (42 of 40 rental
 * days)`), built by `lib/serviceDue.ts`; it is on `title` rather than a custom
 * popover so it survives on touch-less and on keyboard focus without this
 * component owning any interaction.
 */
export const ServiceDueBadge: React.FC<ServiceDueBadgeProps> = ({ row, size = 'sm' }) => {
  if (row === undefined) return null

  const status = serviceStatus(row)
  if (status === null) return null

  return (
    <span title={status.detail} style={{ display: 'inline-flex' }}>
      <Badge label={status.label} tone={status.tone} icon={<IconTool size={14} />} size={size} />
    </span>
  )
}
</file>

<file path="src/components/ui/Stepper.tsx">
import Icon from './Icon'

export interface StepItem {
  id: number | string
  label: string
  description?: string
  optional?: boolean
}

export interface StepperProps {
  steps: StepItem[]
  currentStep: number // 1-indexed
  onStepClick?: (step: number) => void
  maxClickableStep?: number
  /** Completion must come from validation, never from which section was visited. */
  completedStepIds?: ReadonlyArray<StepItem['id']>
  className?: string
}

export function Stepper({
  steps,
  currentStep,
  onStepClick,
  maxClickableStep = steps.length,
  completedStepIds = [],
  className = '',
}: StepperProps) {
  return (
    <nav className={`rental-stepper ${className}`} aria-label="Workflow Steps">
      <ol className="rental-stepper__list">
        {steps.map((step, index) => {
          const stepNumber = index + 1
          const isCompleted = completedStepIds.includes(step.id)
          const isCurrent = stepNumber === currentStep
          const canClick = onStepClick && (stepNumber <= maxClickableStep || stepNumber <= currentStep)

          return (
            <li
              key={step.id}
              className={`rental-stepper__item ${
                isCompleted ? 'is-completed' : isCurrent ? 'is-current' : 'is-upcoming'
              }`}
              aria-current={isCurrent ? 'step' : undefined}
            >
              <button
                type="button"
                className="rental-stepper__button"
                disabled={!canClick || isCurrent}
                onClick={() => canClick && onStepClick?.(stepNumber)}
                aria-label={`Step ${stepNumber}: ${step.label}${isCompleted ? ' (Completed)' : isCurrent ? ' (Current)' : ''}`}
              >
                <span className="rental-stepper__indicator" aria-hidden="true">
                  {isCompleted ? (
                    <Icon name="check" size={14} />
                  ) : (
                    <span className="rental-stepper__number">{stepNumber}</span>
                  )}
                </span>
                <span className="rental-stepper__text">
                  <span className="rental-stepper__label">{step.label}</span>
                  {step.optional && <span className="rental-stepper__badge">Optional</span>}
                  {step.description && (
                    <span className="rental-stepper__desc">{step.description}</span>
                  )}
                </span>
              </button>
              {index < steps.length - 1 && (
                <div
                  className={`rental-stepper__track ${isCompleted ? 'is-filled' : ''}`}
                  aria-hidden="true"
                />
              )}
            </li>
          )
        })}
      </ol>
    </nav>
  )
}
</file>

