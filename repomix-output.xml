/* RULING 2026-10-13: keep every stage label readable and the active stage visible
   on phones; preserve all existing stage gates and navigation callbacks. */
.operations-shell__stages {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  padding-bottom: 12px;
  margin-bottom: 16px;
  border-bottom: 1px solid var(--border);
}

.operations-shell__stages .ui-button__label { min-width: 0; overflow-wrap: anywhere; }
.operations-shell__actions {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

@media (max-width: 767px) {
  .operations-shell__stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .operations-shell__actions { flex-direction: column-reverse; align-items: stretch; gap: 8px; }
}

/* Desktop dock (≥1280): the job sits beside the queue instead of covering it. */
.operations-shell__panel {
  display: flex;
  flex-direction: column;
  min-width: 0;
  position: sticky;
  top: calc(var(--header-h, 64px) + 12px);
  max-height: calc(100vh - var(--header-h, 64px) - 24px);
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--r-md, 12px);
  overflow: hidden;
}
.operations-shell__panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
}
.operations-shell__panel-title { margin: 0; font-size: var(--t-body, 15px); font-weight: 700; color: var(--text); overflow-wrap: anywhere; }
.operations-shell__panel-sub { margin: 2px 0 0; font-size: var(--t-meta); color: var(--text2); }
.operations-shell__panel-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 16px; }
.operations-shell__panel-foot { padding: 12px 16px; border-top: 1px solid var(--border); background: var(--card); }

.operations-v2__split { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--sp-md, 16px); align-items: start; }
