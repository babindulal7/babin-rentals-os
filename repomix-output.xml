                style={{
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: 6,
                  height: 38,
                  minHeight: 44,
                  minWidth: 96,
                  justifyContent: 'center',
                  whiteSpace: 'nowrap',
                  padding: '4px 11px',
                  borderRadius: 999,
                  background:
                    syncStatus === 'syncing'
                      ? 'var(--nav-active-bg)'
