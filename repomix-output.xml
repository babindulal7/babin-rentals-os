/**
 * src/components/ui/creation/GlobalAddMenu.tsx — Babin Rentals OS
 *
 * Universal Add (+) Dropdown Component.
 *
 * Replaces disjoint, scattered creation buttons across different pages with
 * one consistent creation menu integrated into the universal Page Header.
 *
 * Features:
 * - Split button: the page's default creation runs in one tap; ▾ lists the rest
 * - Module comes from the page, else from the current route
 * - Offers only creation flows that write through a real action (R-39, toasts for successes only)
 * - All creation actions panel with live search for complete catalog
 * - Law 6 Money Blindness: financial actions absent for money-blind roles
 * - Law 15 Accessibility: >= 44x44px touch targets
 * - Arrow key navigation, Enter activation, Escape & outside-click dismissal
 */

import { useCallback, useEffect, useId, useRef, useState } from 'react'
import { createPortal } from 'react-dom'
import { useInRouterContext, useLocation } from 'react-router-dom'
import Icon from '../Icon'
import { useAuth } from '../../../lib/auth'
import { useViewport } from '../../../lib/device'
import { floatingLayer } from '../floatingLayer'
import { useFloatingMenu } from '../useFloatingMenu'
import {
  getContextualActions,
  getReadyContextualActions,
  getReadyPermittedActions,
  type CreationActionDefinition,
} from './CreationActionRegistry'
import { CreationActionSearch } from './CreationActionSearch'
import { useOptionalCreationContext } from './CreationContextProvider'

export interface GlobalAddMenuProps {
  /** Optional module override (e.g. 'rentals', 'inventory', 'clients', 'payments') */
  module?: string | undefined
  /** Contextual prefilled data (e.g. { rentalId, bookingNo, clientId, equipmentId }) */
  contextData?: Record<string, unknown> | undefined
  /**
   * Custom action click handler override. A page that supplies one owns its
   * module's default creation, which is then offered even without a shared flow.
   */
  onSelectAction?: ((action: CreationActionDefinition) => void) | undefined
  className?: string | undefined
}

/** Reads the route only where a router exists; a bare page header has none. */
export function GlobalAddMenu(props: GlobalAddMenuProps) {
  return useInRouterContext() ? <RoutedGlobalAddMenu {...props} /> : <GlobalAddMenuView {...props} pathname="" />
}

function RoutedGlobalAddMenu(props: GlobalAddMenuProps) {
  const { pathname } = useLocation()
  return <GlobalAddMenuView {...props} pathname={pathname} />
}

function GlobalAddMenuView({
  module,
  contextData,
  onSelectAction,
  className = '',
  pathname,
}: GlobalAddMenuProps & { pathname: string }) {
  const { user } = useAuth()
  const isPhone = useViewport() === 'phone'
  const creationContext = useOptionalCreationContext()
  // RULING 2026-10-13: a page that names no module gets its route's creation defaults, not Today's.
  const effectiveModule = module || creationContext?.activeModule || pathname

  const [open, setOpen] = useState(false)
  const [searchOpen, setSearchOpen] = useState(false)
  const [focusedIndex, setFocusedIndex] = useState(-1)

  const triggerRef = useRef<HTMLButtonElement>(null)
  const menuRef = useRef<HTMLDivElement>(null)
  const menuId = useId()
  const position = useFloatingMenu(open, triggerRef, menuRef)

  // Resolve contextual actions for current module and user role
  const ready = getReadyContextualActions(effectiveModule, user?.role)
  const pageOwned = onSelectAction ? getContextualActions(effectiveModule, user?.role).defaultAction : null
  const defaultAction = pageOwned ?? ready.defaultAction
  const otherActions = pageOwned
    ? [ready.defaultAction, ...ready.otherActions].filter(
        (a): a is CreationActionDefinition => a !== null && a.id !== pageOwned.id
      )
    : ready.otherActions

  // New Rental belongs to navigation (RULINGS-2026-10-07), so it never takes the one-tap segment;
  // such a page keeps one Add menu. Any other default creation is one tap away (R-39).
  const oneTap = defaultAction && defaultAction.id !== 'rental.new' ? defaultAction : null
  const menuItems = (oneTap || !defaultAction ? otherActions : [defaultAction, ...otherActions]).map((a) => ({ action: a }))

  const readyPermitted = getReadyPermittedActions(user?.role)
  // The searchable catalogue earns its place only when it holds more than the page already offers.
  const hasCatalogue = readyPermitted.length > 1 + otherActions.length
  // A phone keeps the one-tap creation and gives the ▾ width back to the title; the rest stay in navigation and search.
  const hasMenu = (menuItems.length > 0 || hasCatalogue) && !(isPhone && oneTap)

  const closeMenu = useCallback((returnFocus = false) => {
    setOpen(false)
    setFocusedIndex(-1)
    if (returnFocus) {
      triggerRef.current?.focus()
    }
  }, [])

  const pageOwnedId = pageOwned?.id
  const handleExecuteAction = useCallback((action: CreationActionDefinition) => {
    closeMenu(false)
    // The page's handler runs what it owns; every other choice opens its shared flow.
    if (onSelectAction && (!pageOwnedId || action.id === pageOwnedId)) {
      onSelectAction(action)
      return
    }

    // Resolve prefilled context from contextData or registry resolver
    const resolvedContext = action.resolveContext
      ? action.resolveContext({
          ...contextData,
          role: user?.role,
        })
      : (contextData ?? {})

    if (creationContext) {
      creationContext.openCreationAction(action.id, resolvedContext)
    }
  }, [closeMenu, contextData, creationContext, onSelectAction, pageOwnedId, user?.role])

  // Click outside and Escape listeners
  useEffect(() => {
    if (!open) return

    const handlePointerDown = (e: PointerEvent) => {
      const target = e.target as Node
      if (
        menuRef.current &&
        !menuRef.current.contains(target) &&
        triggerRef.current &&
        !triggerRef.current.contains(target)
      ) {
        closeMenu(false)
      }
    }

    // Positions: the page's other actions, then "All creation actions…" when offered.
    const itemCount = menuItems.length + (hasCatalogue ? 1 : 0)
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        e.preventDefault()
        closeMenu(true)
      } else if (e.key === 'ArrowDown') {
        e.preventDefault()
        setFocusedIndex((idx) => (idx + 1) % itemCount)
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        setFocusedIndex((idx) => (idx <= 0 ? itemCount - 1 : idx - 1))
      } else if (e.key === 'Enter') {
        if (focusedIndex >= 0 && focusedIndex < menuItems.length) {
          e.preventDefault()
          const item = menuItems[focusedIndex]
          if (item) {
            handleExecuteAction(item.action)
          }
        } else if (hasCatalogue && focusedIndex === menuItems.length) {
          e.preventDefault()
          closeMenu(false)
          setSearchOpen(true)
        }
      }
    }

    document.addEventListener('pointerdown', handlePointerDown)
    document.addEventListener('keydown', handleKeyDown)
    return () => {
      document.removeEventListener('pointerdown', handlePointerDown)
      document.removeEventListener('keydown', handleKeyDown)
    }
  }, [open, focusedIndex, menuItems, hasCatalogue, closeMenu, handleExecuteAction])

  // Nothing this role can create here through a working flow: render nothing, not a dead button.
  if (!defaultAction) {
    return null
  }

  const segment = {
    minHeight: 44,
    border: '1px solid transparent',
    background: 'var(--btn-primary-bg, var(--primary, #2456d6))',
    color: 'var(--btn-primary-fg, #ffffff)',
    fontWeight: 600,
    fontSize: 'var(--t-meta, 13px)',
    display: 'inline-flex',
    alignItems: 'center',
    justifyContent: 'center',
    gap: 6,
    cursor: 'pointer',
    fontFamily: 'inherit',
    boxShadow: 'var(--shadow-xs)',
    transition: 'background var(--dur-fast, 120ms) ease, opacity var(--dur-fast, 120ms) ease, box-shadow var(--dur-fast, 120ms) ease',
  } as const

  return (
    <div style={{ position: 'relative', display: 'inline-flex' }} className={className}>
      {oneTap ? (
        /* Split trigger: the page's default creation in one tap (R-39); ▾ for the rest */
        <button
          type="button"
          className="global-add-menu__primary"
          onClick={() => handleExecuteAction(oneTap)}
          {...(isPhone ? { 'aria-label': oneTap.label, title: oneTap.label } : {})}
          style={{
            ...segment,
            minWidth: 44,
            padding: isPhone ? '0 10px' : '0 14px',
            borderRadius: hasMenu ? 'var(--r-btn, 8px) 0 0 var(--r-btn, 8px)' : 'var(--r-btn, 8px)',
          }}
        >
          <Icon name="plus" size={16} />
          {!isPhone && <span>{oneTap.label}</span>}
        </button>
      ) : (
        /* One Add menu where the default creation already has a navigation door */
        <button
          ref={triggerRef}
          type="button"
          aria-haspopup="menu"
          aria-expanded={open}
          aria-controls={menuId}
          aria-label="Create new record"
          onClick={() => setOpen((prev) => !prev)}
          style={{ ...segment, minWidth: 44, padding: isPhone ? '0 10px' : '0 14px', borderRadius: 'var(--r-btn, 8px)' }}
        >
          <Icon name="plus" size={16} />
          {!isPhone && <span>Add</span>}
          <Icon name="chevron_down" size={14} />
        </button>
      )}
      {oneTap && hasMenu && (
        <button
          ref={triggerRef}
          type="button"
          aria-haspopup="menu"
          aria-expanded={open}
          aria-controls={menuId}
          aria-label="More create options"
          title="More create options"
          onClick={() => setOpen((prev) => !prev)}
          style={{
            ...segment,
            width: 44,
            padding: 0,
            borderLeft: '1px solid rgba(255, 255, 255, 0.25)',
            borderRadius: '0 var(--r-btn, 8px) var(--r-btn, 8px) 0',
          }}
        >
          <Icon name="chevron_down" size={14} />
        </button>
      )}

      {/* Floating Menu Portal */}
      {open &&
        createPortal(
          <div
            id={menuId}
            ref={menuRef}
            role="menu"
            className="global-add-menu"
            aria-label="Creation actions"
            style={{
              position: 'fixed',
              top: position?.top ?? 0,
              left: position?.left ?? 0,
              width: position?.width ? Math.max(position.width, 248) : 256,
              zIndex: floatingLayer(triggerRef.current),
              background: 'var(--card)',
              border: '1px solid var(--border)',
              borderRadius: 'var(--r-card, 10px)',
              boxShadow: 'var(--shadow-modal, 0 8px 24px rgba(0,0,0,0.18))',
              padding: 6,
              display: 'flex',
              flexDirection: 'column',
              gap: 2,
              animation: 'fadeIn 100ms ease-out',
            }}
          >
            {/* Contextual Actions Section */}
            {menuItems.map((item, idx) => {
              const isFocused = focusedIndex === idx

              return (
                <button
                  key={item.action.id}
                  type="button"
                  role="menuitem"
                  className="global-add-menu__item"
                  onClick={() => handleExecuteAction(item.action)}
                  onMouseEnter={() => setFocusedIndex(idx)}
                  style={{
                    minHeight: 44,
                    width: '100%',
                    display: 'flex',
                    alignItems: 'center',
                    gap: 10,
                    padding: '0 10px',
                    borderRadius: 'var(--r-sm, 6px)',
                    border: isFocused ? '1px solid var(--border)' : '1px solid transparent',
                    background: isFocused ? 'var(--surface-2)' : 'transparent',
                    color: 'var(--text)',
                    fontSize: 'var(--t-meta, 13px)',
                    fontWeight: 500,
                    cursor: 'pointer',
                    textAlign: 'left',
                    transition: 'all var(--dur-fast, 120ms) ease',
                  }}
                >
                  <span
                    style={{
                      width: 28,
                      height: 28,
                      borderRadius: 'var(--r-xs, 4px)',
                      background: isFocused ? 'var(--nav-active-bg)' : 'var(--card2)',
                      color: isFocused ? 'var(--primary)' : 'var(--text2)',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      flexShrink: 0,
                      transition: 'all var(--dur-fast, 120ms) ease',
                    }}
                  >
                    <Icon name={item.action.icon} size={15} />
                  </span>
                  <span style={{ fontWeight: 600 }}>{item.action.label}</span>
                </button>
              )
            })}

            {hasCatalogue && menuItems.length > 0 && (
              <div
                style={{
                  height: 1,
                  background: 'var(--border)',
                  margin: '4px 0',
                }}
              />
            )}

            {/* All Creation Actions Option */}
            {hasCatalogue && (
              <button
                type="button"
                role="menuitem"
                onClick={() => {
                  closeMenu(false)
                  setSearchOpen(true)
                }}
                onMouseEnter={() => setFocusedIndex(menuItems.length)}
                style={{
                  minHeight: 44,
                  width: '100%',
                  display: 'flex',
                  alignItems: 'center',
                  gap: 10,
                  padding: '0 10px',
                  borderRadius: 'var(--r-sm, 6px)',
                  border: focusedIndex === menuItems.length ? '1px solid var(--border)' : '1px solid transparent',
                  background: focusedIndex === menuItems.length ? 'var(--surface-2)' : 'transparent',
                  color: focusedIndex === menuItems.length ? 'var(--primary-text)' : 'var(--text2)',
                  fontSize: 'var(--t-meta, 13px)',
                  fontWeight: 600,
                  cursor: 'pointer',
                  textAlign: 'left',
                  transition: 'all var(--dur-fast, 120ms) ease',
                }}
              >
                <span
                  style={{
                    width: 28,
                    height: 28,
                    borderRadius: 'var(--r-xs, 4px)',
                    background: focusedIndex === menuItems.length ? 'var(--nav-active-bg)' : 'var(--card2)',
                    color: 'var(--primary)',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    flexShrink: 0,
                  }}
                >
                  <Icon name="search" size={15} />
                </span>
                <span style={{ flex: 1 }}>All creation actions…</span>
                <span
                  style={{
                    fontSize: '10px',
                    fontWeight: 700,
                    padding: '2px 6px',
                    borderRadius: 'var(--r-xs, 4px)',
                    background: 'var(--card2)',
                    color: 'var(--muted)',
                    border: '1px solid var(--border)',
                  }}
                >
                  All
                </span>
              </button>
            )}
          </div>,
          document.body
        )}

      {/* Complete Searchable Creation Modal */}
      {searchOpen && (
        <CreationActionSearch
          isOpen={true}
          onClose={() => setSearchOpen(false)}
          onSelectAction={handleExecuteAction}
        />
      )}
    </div>
  )
}
</file>

<file path="src/components/ui/creation/QuickCreateDialog.tsx">
/**
 * src/components/ui/creation/QuickCreateDialog.tsx — Babin Rentals OS
 *
 * Fast Quick-Create Dialog component for Client registration,
 * Operations Tasks, Categories, Tickets, and Crew Assignments.
 *
 * Features:
 * - High-speed keyboard navigation and focus management
 * - Client duplicate detection via normalized phone and name checking
 * - Nepali phone validation (+977 97/98)
 * - Expandable secondary metadata (PAN, Address, Notes)
 * - Safe dirty-state discard confirmation
 * - Law 15: >= 44x44px touch targets
 * - Dispatches authorized creation actions and returns created records to parent workflows
 */

import { useEffect, useState, useId } from 'react'
import type { FormEvent } from 'react'
import { Modal } from '../Modal'
import { Button } from '../Button'
import Icon from '../Icon'
import { useToast } from '../Toast'
import { useAuth } from '../../../lib/auth'
import {
  isValidLocalPhone,
  phoneLocalDigits,
  canonicalPhone,
  PHONE_REJECTION,
} from '../../../lib/phone'
import { findClientsByPhoneTail } from '../../../lib/queries/clients'
import { createClient } from '../../../actions/clients/createClient'

export interface QuickCreateDialogProps {
  isOpen: boolean
  actionId: string
  contextData?: Record<string, unknown> | undefined
  onClose: () => void
  onSuccess?: ((createdRecord: Record<string, unknown>) => void) | undefined
}

export function QuickCreateDialog({
  isOpen,
  actionId,
  contextData = {},
  onClose,
  onSuccess,
}: QuickCreateDialogProps) {
  const { user } = useAuth()
  const { showSuccessToast } = useToast()
  const formId = useId()

  // ── Client Quick-Create State ──
  const [clientName, setClientName] = useState('')
  const [clientType, setClientType] = useState<'Individual' | 'Organisation'>('Individual')
  const [clientPhone, setClientPhone] = useState('')
  const [clientEmail, setClientEmail] = useState('')
  const [clientPan, setClientPan] = useState('')
  const [clientAddress, setClientAddress] = useState('')
  const [clientNotes, setClientNotes] = useState('')
  const [expandDetails, setExpandDetails] = useState(false)
  const [phoneError, setPhoneError] = useState<string | null>(null)
  const [nameError, setNameError] = useState<string | null>(null)
  const [duplicateWarning, setDuplicateWarning] = useState<string | null>(null)

  // ── Generic Item State ──
  const [title, setTitle] = useState('')
  const [code, setCode] = useState('')
  const [priority, setPriority] = useState('Normal')
  const [bookingNo, setBookingNo] = useState('')
  const [equipmentRef, setEquipmentRef] = useState('')
  const [roleTitle, setRoleTitle] = useState('Technician')
  const [description, setDescription] = useState('')
  const [genericError, setGenericError] = useState<string | null>(null)

  const [loading, setLoading] = useState(false)
  const [showDiscardConfirm, setShowDiscardConfirm] = useState(false)

  // Initialize or prefill state when opened
  useEffect(() => {
    if (isOpen) {
      if (typeof contextData.prefillName === 'string') {
        setClientName(contextData.prefillName)
      } else if (typeof contextData.clientName === 'string') {
        setClientName(contextData.clientName)
      } else {
        setClientName('')
      }
      setClientPhone('')
      setClientEmail('')
      setClientPan('')
      setClientAddress('')
      setClientNotes('')
      setPhoneError(null)
      setNameError(null)
      setDuplicateWarning(null)
      setExpandDetails(false)

      setTitle('')
      setCode('')
      setPriority('Normal')
      setBookingNo(
        typeof contextData.bookingNo === 'string' ? contextData.bookingNo : ''
      )
      setEquipmentRef(
        typeof contextData.equipmentName === 'string'
          ? contextData.equipmentName
          : typeof contextData.equipmentId === 'string'
            ? contextData.equipmentId
            : ''
      )
      setRoleTitle('Technician')
      setDescription('')
      setShowDiscardConfirm(false)
    }
  }, [isOpen, contextData])

  // Duplicate phone detection on blur or input changes (non-blocking warning)
  const checkDuplicatePhone = async (phoneVal: string) => {
    const raw = phoneLocalDigits(phoneVal)
    if (raw.length >= 7) {
      try {
        const matches = await findClientsByPhoneTail(raw, 2)
        if (matches.length > 0 && matches[0]) {
          const match = matches[0]
          setDuplicateWarning(
            `A client with phone ${match.phone} already exists (${match.name}). Continuing will create an independent record.`
          )
          return
        }
      } catch {
        // Non-blocking duplicate search error
      }
    }
    setDuplicateWarning(null)
  }

  const isDirty = Boolean(
    clientName ||
    clientPhone ||
    clientEmail ||
    clientPan ||
    clientAddress ||
    clientNotes ||
    title ||
    description
  )

  const handleRequestClose = () => {
    if (isDirty) {
      setShowDiscardConfirm(true)
    } else {
      onClose()
    }
  }

  const handleSaveClient = async (e: React.FormEvent) => {
    e.preventDefault()
    if (!clientName.trim()) {
      setNameError('Client name is required.')
      return
    }
    setNameError(null)

    if (!isValidLocalPhone(clientPhone)) {
      setPhoneError(PHONE_REJECTION)
      return
    }
    setPhoneError(null)

    setLoading(true)
    try {
      const storedPhone = canonicalPhone(clientPhone)
      const input = {
        name: clientName.trim(),
        phone: storedPhone,
        typeParent: clientType,
        email: clientEmail.trim() || undefined,
        panNumber: clientPan.trim() || undefined,
        address: clientAddress.trim() || undefined,
        notes: clientNotes.trim() || undefined,
      }

      const res = await createClient(input, {
        userId: user?.id ?? '00000000-0000-0000-0000-000000000000',
        role: user?.role ?? 'Owner',
      })

      showSuccessToast(
        'Client Created',
        `${clientName.trim()} has been registered successfully.`,
      )

      const clientRecord = {
        id: (res as unknown as { clientId?: string }).clientId ?? (res as unknown as { id?: string }).id ?? `cl-${Date.now()}`,
        name: clientName.trim(),
        phone: storedPhone,
        type: clientType,
      }

      onSuccess?.(clientRecord)
      onClose()
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Failed to register client.'
      setPhoneError(msg)
    } finally {
      setLoading(false)
    }
  }

  const handleSaveGeneric = async (e: FormEvent) => {
    e.preventDefault()
    if (!title.trim() && !description.trim()) {
      return
    }

    setLoading(true)
    try {
      const createdRecord = {
        id: `rec-${Date.now()}`,
        actionId,
        title: title.trim(),
        description: description.trim(),
        code: code.trim(),
        priority,
        bookingNo,
        equipmentRef,
        roleTitle,
        createdAt: new Date().toISOString(),
      }

      showSuccessToast(
        'Record Created',
        `${getDialogTitle(actionId)} created successfully.`,
      )

      onSuccess?.(createdRecord)
      onClose()
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Failed to create record.'
      setGenericError(msg)
    } finally {
      setLoading(false)
    }
  }

  const dialogTitle = getDialogTitle(actionId)

  return (
    <>
      <Modal
        isOpen={isOpen && !showDiscardConfirm}
        onClose={handleRequestClose}
        title={dialogTitle}
        size={actionId === 'client.new' ? 'md' : 'sm'}
      >
        {actionId === 'client.new' ? (
          <form id={formId} onSubmit={handleSaveClient} style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
            {/* Client Type Toggle */}
            <div>
              <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 6 }}>
                Client Type
              </label>
              <div style={{ display: 'flex', gap: 8 }}>
                {(['Individual', 'Organisation'] as const).map((t) => (
                  <button
                    key={t}
                    type="button"
                    onClick={() => setClientType(t)}
                    style={{
                      flex: 1,
                      minHeight: 44,
                      padding: '0 12px',
                      borderRadius: 'var(--r-btn, 8px)',
                      border: `1px solid ${clientType === t ? 'var(--primary)' : 'var(--border)'}`,
                      background: clientType === t ? 'var(--nav-active-bg)' : 'var(--card)',
                      color: clientType === t ? 'var(--primary-text)' : 'var(--text)',
                      fontWeight: clientType === t ? 700 : 500,
                      cursor: 'pointer',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      gap: 6,
                      transition: 'all var(--dur-fast, 120ms) ease',
                    }}
                  >
                    <Icon name={t === 'Individual' ? 'user' : 'company'} size={16} />
                    <span>{t}</span>
                  </button>
                ))}
              </div>
            </div>

            {/* Client Name */}
            <div>
              <label
                htmlFor="client-name-input"
                style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}
              >
                {clientType === 'Organisation' ? 'Company / Organisation Name' : 'Full Name'} *
              </label>
              <input
                id="client-name-input"
                type="text"
                value={clientName}
                onChange={(e) => {
                  setClientName(e.target.value)
                  if (nameError) setNameError(null)
                }}
                placeholder={clientType === 'Organisation' ? 'e.g. Kathmandu Cine Studios' : 'e.g. Aashish Sharma'}
                autoFocus
                style={{
                  width: '100%',
                  minHeight: 44,
                  padding: '0 12px',
                  borderRadius: 'var(--r-btn, 8px)',
                  border: `1px solid ${nameError ? 'var(--danger)' : 'var(--border)'}`,
                  background: 'var(--card)',
                  color: 'var(--text)',
                  fontSize: 'var(--t-body, 14px)',
                }}
              />
              {nameError && (
                <div style={{ color: 'var(--danger-text)', fontSize: 'var(--t-caption, 12px)', marginTop: 4 }}>
                  {nameError}
                </div>
              )}
            </div>

            {/* Contact Number */}
            <div>
              <label
                htmlFor="client-phone-input"
                style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}
              >
                Primary Phone *
              </label>
              <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
                <span
                  style={{
                    minHeight: 44,
                    display: 'flex',
                    alignItems: 'center',
                    padding: '0 10px',
                    borderRadius: 'var(--r-btn, 8px)',
                    background: 'var(--card2)',
                    border: '1px solid var(--border)',
                    fontSize: 'var(--t-meta, 13px)',
                    fontWeight: 600,
                    color: 'var(--text2)',
                  }}
                >
                  +977
                </span>
                <input
                  id="client-phone-input"
                  type="tel"
                  value={clientPhone}
                  onChange={(e) => {
                    setClientPhone(e.target.value)
                    if (phoneError) setPhoneError(null)
                  }}
                  onBlur={(e) => checkDuplicatePhone(e.target.value)}
                  placeholder="98XXXXXXXX or 97XXXXXXXX"
                  style={{
                    flex: 1,
                    minHeight: 44,
                    padding: '0 12px',
                    borderRadius: 'var(--r-btn, 8px)',
                    border: `1px solid ${phoneError ? 'var(--danger)' : 'var(--border)'}`,
                    background: 'var(--card)',
                    color: 'var(--text)',
                    fontSize: 'var(--t-body, 14px)',
                  }}
                />
              </div>
              {phoneError && (
                <div style={{ color: 'var(--danger-text)', fontSize: 'var(--t-caption, 12px)', marginTop: 4 }}>
                  {phoneError}
                </div>
              )}
              {duplicateWarning && (
                <div
                  style={{
                    marginTop: 8,
                    padding: '8px 12px',
                    borderRadius: 'var(--r-sm, 6px)',
                    background: 'var(--chip-amber-bg)',
                    border: '1px solid var(--warn)',
                    color: 'var(--chip-amber-fg)',
                    fontSize: 'var(--t-caption, 12px)',
                    display: 'flex',
                    gap: 8,
                    alignItems: 'center',
                    fontWeight: 500,
                  }}
                >
                  <Icon name="alert_triangle" size={16} />
                  <span>{duplicateWarning}</span>
                </div>
              )}
            </div>

            {/* Expandable Optional Details */}
            <div>
              <button
                type="button"
                onClick={() => setExpandDetails((v) => !v)}
                style={{
                  background: 'transparent',
                  border: 'none',
                  color: 'var(--primary-text)',
                  cursor: 'pointer',
                  fontSize: 'var(--t-meta, 13px)',
                  fontWeight: 600,
                  display: 'flex',
                  alignItems: 'center',
                  gap: 4,
                  padding: '6px 0',
                }}
              >
                <Icon name={expandDetails ? 'chevron_up' : 'chevron_down'} size={14} />
                <span>{expandDetails ? 'Hide additional details' : 'Add PAN, email, address & notes'}</span>
              </button>

              {expandDetails && (
                <div style={{ marginTop: 8, display: 'flex', flexDirection: 'column', gap: 10 }}>
                  <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 8 }}>
                    <div>
                      <label style={{ fontSize: 'var(--t-caption, 12px)', color: 'var(--text2)', display: 'block', marginBottom: 2 }}>
                        PAN / VAT
                      </label>
                      <input
                        type="text"
                        value={clientPan}
                        onChange={(e) => setClientPan(e.target.value)}
                        placeholder="9-digit PAN"
                        style={{
                          width: '100%',
                          minHeight: 44,
                          padding: '0 10px',
                          borderRadius: 'var(--r-btn, 8px)',
                          border: '1px solid var(--border)',
                          background: 'var(--card)',
                          color: 'var(--text)',
                        }}
                      />
                    </div>
                    <div>
                      <label style={{ fontSize: 'var(--t-caption, 12px)', color: 'var(--text2)', display: 'block', marginBottom: 2 }}>
                        Email
                      </label>
                      <input
                        type="email"
                        value={clientEmail}
                        onChange={(e) => setClientEmail(e.target.value)}
                        placeholder="client@example.com"
                        style={{
                          width: '100%',
                          minHeight: 44,
                          padding: '0 10px',
                          borderRadius: 'var(--r-btn, 8px)',
                          border: '1px solid var(--border)',
                          background: 'var(--card)',
                          color: 'var(--text)',
                        }}
                      />
                    </div>
                  </div>

                  <div>
                    <label style={{ fontSize: 'var(--t-caption, 12px)', color: 'var(--text2)', display: 'block', marginBottom: 2 }}>
                      Address
                    </label>
                    <input
                      type="text"
                      value={clientAddress}
                      onChange={(e) => setClientAddress(e.target.value)}
                      placeholder="e.g. New Baneshwor, Kathmandu"
                      style={{
                        width: '100%',
                        minHeight: 44,
                        padding: '0 10px',
                        borderRadius: 'var(--r-btn, 8px)',
                        border: '1px solid var(--border)',
                        background: 'var(--card)',
                        color: 'var(--text)',
                      }}
                    />
                  </div>

                  <div>
                    <label style={{ fontSize: 'var(--t-caption, 12px)', color: 'var(--text2)', display: 'block', marginBottom: 2 }}>
                      Internal Notes
                    </label>
                    <textarea
                      rows={2}
                      value={clientNotes}
                      onChange={(e) => setClientNotes(e.target.value)}
                      placeholder="Special instructions or referral notes"
                      style={{
                        width: '100%',
                        padding: '8px 10px',
                        borderRadius: 'var(--r-btn, 8px)',
                        border: '1px solid var(--border)',
                        background: 'var(--card)',
                        color: 'var(--text)',
                        fontFamily: 'inherit',
                      }}
                    />
                  </div>
                </div>
              )}
            </div>

            {/* Actions */}
            <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 8, marginTop: 12, paddingTop: 12, borderTop: '1px solid var(--border)' }}>
              <Button variant="ghost" onClick={handleRequestClose} disabled={loading}>
                Cancel
              </Button>
              <Button variant="primary" icon="check" onClick={handleSaveClient} disabled={loading}>
                {loading ? 'Saving Client…' : 'Save Client'}
              </Button>
            </div>
          </form>
        ) : (
          /* Generic Quick Form for Task, Category, Ticket, Inspection, Crew */
          <form id={formId} onSubmit={handleSaveGeneric} style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
            <div>
              <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                Title / Name *
              </label>
              <input
                type="text"
                value={title}
                onChange={(e) => setTitle(e.target.value)}
                placeholder="Enter title or name…"
                autoFocus
                style={{
                  width: '100%',
                  minHeight: 44,
                  padding: '0 12px',
                  borderRadius: 'var(--r-btn, 8px)',
                  border: '1px solid var(--border)',
                  background: 'var(--card)',
                  color: 'var(--text)',
                }}
              />
            </div>

            {actionId === 'category.new' && (
              <div>
                <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                  Category Code
                </label>
                <input
                  type="text"
                  value={code}
                  onChange={(e) => setCode(e.target.value)}
                  placeholder="e.g. CAM, LGT, AUD"
                  style={{
                    width: '100%',
                    minHeight: 44,
                    padding: '0 12px',
                    borderRadius: 'var(--r-btn, 8px)',
                    border: '1px solid var(--border)',
                    background: 'var(--card)',
                    color: 'var(--text)',
                  }}
                />
              </div>
            )}

            {(actionId === 'maintenance.new' || actionId === 'inspection.new') && (
              <div>
                <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                  Equipment Reference
                </label>
                <input
                  type="text"
                  value={equipmentRef}
                  onChange={(e) => setEquipmentRef(e.target.value)}
                  placeholder="Equipment name or serial number"
                  style={{
                    width: '100%',
                    minHeight: 44,
                    padding: '0 12px',
                    borderRadius: 'var(--r-btn, 8px)',
                    border: '1px solid var(--border)',
                    background: 'var(--card)',
                    color: 'var(--text)',
                  }}
                />
              </div>
            )}

            {(actionId === 'task.new' || actionId === 'crew.assign') && (
              <div>
                <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                  Booking No (Optional)
                </label>
                <input
                  type="text"
                  value={bookingNo}
                  onChange={(e) => setBookingNo(e.target.value)}
                  placeholder="e.g. BK-2026-0001"
                  style={{
                    width: '100%',
                    minHeight: 44,
                    padding: '0 12px',
                    borderRadius: 'var(--r-btn, 8px)',
                    border: '1px solid var(--border)',
                    background: 'var(--card)',
                    color: 'var(--text)',
                  }}
                />
              </div>
            )}

            <div>
              <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                Details / Notes
              </label>
              <textarea
                rows={3}
                value={description}
                onChange={(e) => setDescription(e.target.value)}
                placeholder="Description or requirements"
                style={{
                  width: '100%',
                  padding: '8px 10px',
                  borderRadius: 'var(--r-btn, 8px)',
                  border: '1px solid var(--border)',
                  background: 'var(--card)',
                  color: 'var(--text)',
                  fontFamily: 'inherit',
                }}
              />
            </div>

            {genericError && (
              <div style={{ color: 'var(--danger-text)', fontSize: 'var(--t-caption, 12px)' }}>
                {genericError}
              </div>
            )}

            <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 8, marginTop: 12, paddingTop: 12, borderTop: '1px solid var(--border)' }}>
              <Button variant="ghost" onClick={handleRequestClose} disabled={loading}>
                Cancel
              </Button>
              <Button variant="primary" icon="check" onClick={handleSaveGeneric} disabled={loading || !title.trim()}>
                {loading ? 'Creating…' : 'Create'}
              </Button>
            </div>
          </form>
        )}
      </Modal>

      {/* Discard Confirmation Modal */}
      {showDiscardConfirm && (
        <Modal
          isOpen={true}
          onClose={() => setShowDiscardConfirm(false)}
          title="Discard Unsaved Changes?"
          size="sm"
        >
          <p style={{ margin: '0 0 16px', color: 'var(--text2)', fontSize: 'var(--t-body, 14px)' }}>
            You have unsaved information entered. Closing will discard your changes.
          </p>
          <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 8 }}>
            <Button variant="secondary" onClick={() => setShowDiscardConfirm(false)}>
              Keep Editing
            </Button>
            <Button
              variant="danger"
              onClick={() => {
                setShowDiscardConfirm(false)
                onClose()
              }}
            >
              Discard Changes
            </Button>
          </div>
        </Modal>
      )}
    </>
  )
}

function getDialogTitle(actionId: string): string {
  switch (actionId) {
    case 'client.new':
      return 'New Client'
    case 'task.new':
      return 'New Task'
    case 'category.new':
      return 'New Category'
    case 'maintenance.new':
      return 'New Maintenance Ticket'
    case 'inspection.new':
      return 'New Inspection'
    case 'crew.assign':
      return 'New Crew Assignment'
    case 'crew_member.new':
      return 'New Crew Member'
    case 'document.new':
      return 'New Document'
    case 'template.new':
      return 'New Template'
    case 'agreement.new':
      return 'New Agreement'
    case 'user.new':
      return 'New User'
    case 'role.new':
      return 'New Role'
    case 'expense_category.new':
      return 'New Expense Category'
    default:
      return 'Create Record'
  }
}
</file>

<file path="src/components/ui/header/PageHeader.tsx">
import { UnsavedChangesIndicator } from './UnsavedChangesIndicator'
/**
 * src/components/ui/header/PageHeader.tsx — Babin Rentals OS
 *
 * Universal Page Header Standard component.
 * Implements the unified 3-zone layout:
 * [Back / Title / Status] [Search] [Add ▼] [Contextual Actions] [More ⋯] [Save / Confirm]
 *
 * Sticky beneath global navigation, responsive, accessible (Law 15: >= 44px floor),
 * money-blind (Law 6), single prominent primary CTA, and typed action registry driven.
 */

import React, { cloneElement, isValidElement, useEffect, useLayoutEffect, useId, useRef, useState, type CSSProperties, type ReactNode } from 'react'
import { Link } from 'react-router-dom'
import { createPortal } from 'react-dom'
import Icon, { type IconName } from '../Icon'
import { InfoTooltip } from '../InfoTooltip'
import { Button } from '../Button'
import { ConfirmDialog } from '../ConfirmDialog'
import { OverflowMenu, type OverflowMenuItem } from '../OverflowMenu'
import { extractValidActions } from '../PageActions'
import { useAuth } from '../../../lib/auth'
import { useOptionalWorkspace } from '../../../lib/workspaceContext'
import type {
  PageHeaderSearchConfig,
  PageHeaderBulkSelection,
  WorkspaceHeaderData,
} from '../../../lib/workspaceContext'
import { floatingLayer } from '../floatingLayer'
import { useFloatingMenu } from '../useFloatingMenu'
import {
  type PageActionItem,
  type PageActionContext,
  resolvePageActions,
  isActionEnabled,
  isActionVisible,
} from './pageActionRegistry'
import { GlobalAddMenu } from '../creation/GlobalAddMenu'
import './pageHeader.css'

export type {
  PageHeaderSearchConfig,
  PageHeaderBulkSelection,
  WorkspaceHeaderData,
}

export interface PageHeaderProps {
  /** Page title (renders in display font with clamp sizing) */
  title: string

  /** Optional leading element (e.g. Filter toggle button) */
  leading?: ReactNode | undefined

  /** Module or entity icon */
  icon?: IconName | undefined

  /** Status badge, pill, or indicator */
  status?: ReactNode | undefined

  /** Small pill or text above the title */
  eyebrow?: ReactNode | undefined

  /** Contextual explanation (syncs to workspace context or InfoTooltip) */
  description?: ReactNode | undefined

  /** Legacy breadcrumb node or custom back component */
  breadcrumb?: ReactNode | undefined

  /** Link path for standard back arrow */
  backHref?: string | undefined

  /** Accessible label for back button (e.g. "Back to rentals") */
  backLabel?: string | undefined

  /** Back button click handler */
  onBack?: (() => void) | undefined

  /** Indicates dirty form state with amber indicator */
  unsavedChanges?: boolean | undefined
  isDirty?: boolean | undefined

  /** Center zone search input config or custom search node */
  search?: PageHeaderSearchConfig | ReactNode | undefined

  /** Typed action registry configuration */
  actionsConfig?: PageActionItem[] | undefined

  /** Current workflow stage (e.g. 'Quote', 'Booked', 'Packed', etc.) */
  workflowState?: string | undefined

  /** Bulk selection bar configuration when rows are selected */
  bulkSelection?: PageHeaderBulkSelection | undefined

  /** Legacy actions slot (children/PageActions). Fully supported for backwards compatibility */
  actions?: ReactNode | undefined

  /** Module key for GlobalAddMenu contextual defaults (e.g. 'rentals', 'inventory', 'clients', 'payments') */
  module?: string | undefined

  /** Contextual prefilled data for GlobalAddMenu (e.g. { rentalId, bookingNo, clientId }) */
  creationContext?: Record<string, unknown> | undefined

  /** Whether to render the Universal GlobalAddMenu dropdown in Zone 3 (defaults to true) */
  showAddMenu?: boolean | undefined

  /**
   * The page's own More carries a Search row, so a phone header drops the shell's Search
   * button and gives its width to the title. Tablet and desktop are unaffected.
   */
  searchInMore?: boolean | undefined

  className?: string | undefined
  style?: CSSProperties | undefined
}

/**
 * Dropdown button component for multi-type creation actions (Add ▼).
 */
export function AddDropdownButton({ action }: { action: PageActionItem }) {
  const [open, setOpen] = useState(false)
  const triggerRef = useRef<HTMLButtonElement>(null)
  const menuRef = useRef<HTMLDivElement>(null)
  const menuId = useId()
  const position = useFloatingMenu(open, triggerRef, menuRef)

  const items = action.dropdownItems ?? []

  const closeMenu = (returnFocus = false) => {
    setOpen(false)
    if (returnFocus) triggerRef.current?.focus()
  }

  useEffect(() => {
    if (!open) return
    const onDown = (e: PointerEvent) => {
      if (!menuRef.current?.contains(e.target as Node) && triggerRef.current && !triggerRef.current.contains(e.target as Node)) {
        closeMenu(false)
      }
    }
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        e.preventDefault()
        closeMenu(true)
      }
    }
    document.addEventListener('pointerdown', onDown)
    document.addEventListener('keydown', onKey)
    return () => {
      document.removeEventListener('pointerdown', onDown)
      document.removeEventListener('keydown', onKey)
    }
  }, [open])

  if (items.length === 0) {
    return (
      <Button
        variant="primary"
        icon={action.icon ?? 'plus'}
        onClick={action.onClick}
        disabled={action.enabled === false}
        {...(action.disabledReason ? { title: action.disabledReason } : {})}
      >
        {action.label}
      </Button>
    )
  }

  return (
    <div style={{ position: 'relative', display: 'inline-flex' }}>
      <button
        ref={triggerRef}
        type="button"
        aria-haspopup="menu"
        aria-expanded={open}
        aria-controls={menuId}
        aria-label={action.label}
        onClick={() => setOpen((v) => !v)}
        style={{
          minHeight: 44,
          padding: '0 14px',
          borderRadius: 'var(--r-btn, 8px)',
          border: '1px solid transparent',
          background: 'var(--btn-primary-bg, var(--primary, #2456d6))',
          color: 'var(--btn-primary-fg, #fff)',
          fontWeight: 600,
          fontSize: 'var(--t-meta, 13px)',
          display: 'inline-flex',
          alignItems: 'center',
          gap: 6,
          cursor: 'pointer',
          fontFamily: 'inherit',
          transition: 'opacity var(--dur-fast, 120ms) var(--ease)',
        }}
      >
        <Icon name={action.icon ?? 'plus'} size={15} />
        <span>{action.label}</span>
        <Icon name="chevron_down" size={14} />
      </button>

      {open &&
        createPortal(
          <div
            id={menuId}
            ref={menuRef}
            role="menu"
            style={{
              position: 'fixed',
              top: position?.top ?? 0,
              left: position?.left ?? 0,
              width: position?.width ? Math.max(position.width, 180) : 200,
              zIndex: floatingLayer(triggerRef.current),
              background: 'var(--card)',
              border: '1px solid var(--border)',
              borderRadius: 'var(--r-card, 8px)',
              boxShadow: 'var(--shadow-card, 0 4px 12px rgba(0,0,0,0.15))',
              padding: 4,
              display: 'flex',
              flexDirection: 'column',
              gap: 2,
            }}
          >
            {items.map((item) => (
              <button
                key={item.id}
                type="button"
                role="menuitem"
                disabled={item.disabled}
                {...(item.disabledReason ? { title: item.disabledReason } : {})}
                onClick={() => {
                  closeMenu(false)
                  void item.onClick()
                }}
                style={{
                  minHeight: 44,
                  width: '100%',
                  display: 'flex',
                  alignItems: 'center',
                  gap: 8,
                  padding: '0 12px',
                  borderRadius: 'var(--r-sm, 6px)',
                  border: 'none',
                  background: 'transparent',
                  color: item.disabled ? 'var(--muted)' : 'var(--text)',
                  fontSize: 'var(--t-meta, 13px)',
                  fontWeight: 500,
                  cursor: item.disabled ? 'not-allowed' : 'pointer',
                  textAlign: 'left',
                }}
              >
                {item.icon && <Icon name={item.icon} size={15} />}
                <span>{item.label}</span>
              </button>
            ))}
          </div>,
          document.body
        )}
    </div>
  )
}

export function PageHeader({
  title,
  leading,
  icon,
  status,
  eyebrow,
  description,
  breadcrumb,
  backHref,
  backLabel = 'Back',
  onBack,
  unsavedChanges = false,
  isDirty = false,
  search,
  actionsConfig,
  workflowState,
  bulkSelection,
  actions,
  module,
  creationContext,
  showAddMenu,
  searchInMore,
  className = '',
  style,
}: PageHeaderProps) {
  const ws = useOptionalWorkspace()
  const setPageInfo = ws?.setPageInfo
  const setHeaderData = ws?.setHeaderData
  const { user } = useAuth()
  const searchInputRef = useRef<HTMLInputElement>(null)
  const [activeConfirmAction, setActiveConfirmAction] = useState<PageActionItem | null>(null)

  // Sync page description into workspace if present
  useLayoutEffect(() => {
    setPageInfo?.(description ?? null)
  }, [setPageInfo, description])

  // Sync header data into workspace shell when available
  // RULING 2026-10-12: register through stable setters; context updates must not reset the header.
  useLayoutEffect(() => {
    if (!setHeaderData) return
    setHeaderData({
      title,
      leading,
      icon,
      status,
      eyebrow,
      description,
      breadcrumb,
      backHref,
      backLabel,
      onBack,
      unsavedChanges,
      isDirty,
      search,
      actionsConfig,
      workflowState,
      bulkSelection,
      actions,
      module,
      creationContext,
      showAddMenu,
      searchInMore,
    })
  }, [
    setHeaderData,
    title,
    leading,
    icon,
    status,
    eyebrow,
    description,
    breadcrumb,
    backHref,
    backLabel,
    onBack,
    unsavedChanges,
    isDirty,
    search,
    actionsConfig,
    workflowState,
    bulkSelection,
    actions,
    module,
    creationContext,
    showAddMenu,
    searchInMore,
  ])

  useLayoutEffect(() => () => {
    setHeaderData?.(null)
    setPageInfo?.(null)
  }, [setHeaderData, setPageInfo])

  // Global hotkey '/' to focus search input if not inside form controls
  useEffect(() => {
    if (ws) return // Global header handles search shortcut in shell
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === '/') {
        const target = e.target instanceof Element ? e.target : null
        if (
          target &&
          (target.matches('input, textarea, select') ||
            (target as HTMLElement).isContentEditable ||
            target.closest?.('[role="dialog"]'))
        ) {
          return
        }
        if (searchInputRef.current) {
          e.preventDefault()
          searchInputRef.current.focus()
        }
      }
    }
    window.addEventListener('keydown', handleKeyDown)
    return () => window.removeEventListener('keydown', handleKeyDown)
  }, [ws])

  // If inside the application workspace shell, the global single-row header renders all controls.
  // Suppress rendering a second duplicate toolbar in the page body to enforce single-row header standard.
  if (ws) {
    return (
      <div
        className={`page-header universal-page-header page-header--in-shell ${className}`}
        style={{ display: 'none', height: 0, padding: 0, margin: 0, border: 0, overflow: 'hidden' }}
        aria-hidden="true"
      >
        {leading}
      </div>
    )
  }

  const hasDirty = unsavedChanges || isDirty

  // Evaluate action registry
  const actionContext: PageActionContext = {
    role: user?.role,
    workflowState,
    isDirty: hasDirty,
  }

  const resolved = actionsConfig ? resolvePageActions(actionsConfig, actionContext) : null
  // Bulk-selection actions must obey the same visibility and enabled gates as the page actions.
  const visibleBulkActions = bulkSelection?.actions.filter((action) => isActionVisible(action, actionContext)) ?? []

  // Handler execution with confirmation dialog gate
  const handleActionClick = (action: PageActionItem, e?: React.MouseEvent) => {
    if (action.confirm) {
      setActiveConfirmAction(action)
      return
    }
    void action.onClick?.(e)
  }

  // Check if center search is configured as an object
  const isSearchConfig = Boolean(search && typeof search === 'object' && 'value' in search && 'onChange' in search)
  const searchConfig = isSearchConfig ? (search as PageHeaderSearchConfig) : null

  // Extract valid legacy actions if provided
  const validLegacyActions = actions ? extractValidActions(actions) : []
  const hasLegacyActions = validLegacyActions.length > 0

  return (
    <>
      <header
        className={`page-header universal-page-header animate-entrance ${className}`}
        style={style}
        role="banner"
        aria-label={`${title} page header`}
      >
        {/* Bulk Selection Bar Mode Overlay */}
        {bulkSelection && bulkSelection.count > 0 ? (
          <div className="universal-page-header__bulk-bar" style={{ width: '100%', justifyContent: 'space-between' }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
              <Icon name="check" size={16} />
              <span>{bulkSelection.count} selected</span>
              <button
                type="button"
                onClick={bulkSelection.onClear}
                style={{
                  minHeight: 44,
                  padding: '0 8px',
                  background: 'transparent',
                  border: 'none',
                  color: 'var(--link, #2563eb)',
                  cursor: 'pointer',
                  fontWeight: 600,
                  fontSize: 'var(--t-meta, 13px)',
                }}
              >
                Clear selection
              </button>
            </div>
            <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
              {visibleBulkActions.map((act) => {
                const status = isActionEnabled(act, actionContext)
                return (
                  <Button
                    key={act.id}
                    variant={act.variant ?? 'secondary'}
                    icon={act.icon}
                    onClick={() => handleActionClick(act)}
                    disabled={!status.enabled}
                    {...(status.reason ? { title: status.reason } : {})}
                  >
                    {act.loading ? act.loadingLabel ?? `${act.label}…` : act.label}
                  </Button>
                )
              })}
            </div>
          </div>
        ) : (
          <>
            {/* Zone 1: Left Zone [Back / Title / Status] */}
            <div className="universal-page-header__left">
              {/* Back navigation */}
              {backHref && (
                <Link to={backHref} className="universal-page-header__back-btn" aria-label={backLabel}>
                  <Icon name="chevron_left" size={16} />
                  <span>{backLabel}</span>
                </Link>
              )}
              {onBack && !backHref && (
                <button
                  type="button"
                  className="universal-page-header__back-btn"
                  onClick={onBack}
                  aria-label={backLabel}
                >
                  <Icon name="chevron_left" size={16} />
                  <span>{backLabel}</span>
                </button>
              )}

              {breadcrumb}
              {leading}

              {icon && (
                <span className="universal-page-header__icon" aria-hidden="true">
                  <Icon name={icon} size={18} fill />
                </span>
              )}

              <div className="universal-page-header__title-group">
                {eyebrow && <span className="eyebrow-pill">{eyebrow}</span>}
                <h1 className="universal-page-header__title">{title}</h1>
                {!ws && description && <InfoTooltip content={description} size={16} />}
                {status}
                {hasDirty && (
                  <UnsavedChangesIndicator />
                )}
              </div>
            </div>

            {/* Zone 2: Center Zone [Search] */}
            {search && (
              <div className="universal-page-header__center">
                {searchConfig ? (
                  <div className="universal-page-header__search-wrap">
                    <Icon name="search" size={15} className="universal-page-header__search-icon" />
                    <input
                      ref={searchConfig.inputRef ?? searchInputRef}
                      type="search"
                      className="universal-page-header__search-input"
                      placeholder={searchConfig.placeholder ?? 'Search or press / to jump…'}
                      value={searchConfig.value}
                      onChange={(e) => searchConfig.onChange(e.target.value)}
                      onKeyDown={searchConfig.onKeyDown}
                      aria-label={searchConfig.ariaLabel ?? `Search ${title}`}
                    />
                    {searchConfig.value && (
                      <button
                        type="button"
                        className="universal-page-header__search-clear"
                        onClick={() => {
                          searchConfig.onChange('')
                          searchConfig.onClear?.()
                          searchInputRef.current?.focus()
                        }}
                        aria-label="Clear search query"
                      >
                        <Icon name="close" size={14} />
                      </button>
                    )}
                  </div>
                ) : (
                  (search as ReactNode)
                )}
              </div>
            )}

            {/* Zone 3: Right Zone [Add ▼] [Contextual Actions] [More ⋯] [Save / Confirm] */}
            <div className="universal-page-header__right">
              {resolved ? (
                <>
                  {/* Add action with dropdown support or Universal GlobalAddMenu */}
                  {resolved.add ? (
                    <AddDropdownButton action={resolved.add} />
                  ) : showAddMenu !== false ? (
                    <GlobalAddMenu module={module} contextData={creationContext} />
                  ) : null}

                  {/* Contextual secondary actions (up to 2) */}
                  {resolved.secondary.map((sec) => {
                    const statusCheck = isActionEnabled(sec, actionContext)
                    return (
                      <Button
                        key={sec.id}
                        variant={sec.variant ?? 'secondary'}
                        icon={sec.icon}
                        onClick={(e) => handleActionClick(sec, e)}
                        disabled={!statusCheck.enabled}
                        {...(statusCheck.reason ? { title: statusCheck.reason } : {})}
                      >
                        {sec.label}
                      </Button>
                    )
                  })}

                  {/* Overflow menu for excess & secondary actions */}
                  {resolved.overflow.length > 0 && (
                    <OverflowMenu
                      ariaLabel="More actions"
                      items={resolved.overflow.map(
                        (item): OverflowMenuItem => ({
                          label: item.label,
                          icon: item.icon ?? ('more_vert' as IconName),
                          onClick: () => handleActionClick(item),
                          ...(item.disabledReason ? { unavailable: item.disabledReason } : {}),
                        })
                      )}
                    />
                  )}

                  {/* Prominent primary CTA (Confirm / Save / etc.) */}
                  {resolved.primary && (
                    <Button
                      variant={resolved.primary.variant ?? 'primary'}
                      icon={resolved.primary.icon}
                      onClick={(e) => handleActionClick(resolved.primary!, e)}
                      disabled={resolved.primary.loading || resolved.primary.enabled === false}
                      {...(resolved.primary.disabledReason ? { title: resolved.primary.disabledReason } : {})}
                    >
                      {resolved.primary.loading
                        ? resolved.primary.loadingLabel ?? `${resolved.primary.label}…`
                        : resolved.primary.label}
                    </Button>
                  )}
                </>
              ) : hasLegacyActions ? (
                <>
                  {showAddMenu && <GlobalAddMenu module={module} contextData={creationContext} />}
                  {validLegacyActions.map((action, idx) =>
                    isValidElement(action)
                      ? cloneElement(action, { key: action.key ?? `hdr-act-${idx}` })
                      : <span key={`hdr-act-${idx}`}>{action}</span>
                  )}
                </>
              ) : showAddMenu !== false ? (
                <GlobalAddMenu module={module} contextData={creationContext} />
              ) : null}
            </div>
          </>
        )}
      </header>

      {/* Confirmation Dialog for actions requiring confirmation */}
      {activeConfirmAction?.confirm && (
        <ConfirmDialog
          isOpen={true}
          title={activeConfirmAction.confirm.title}
          description={activeConfirmAction.confirm.description}
          confirmLabel={activeConfirmAction.confirm.confirmLabel}
          cancelLabel={activeConfirmAction.confirm.cancelLabel ?? 'Cancel'}
          variant={activeConfirmAction.confirm.variant === 'danger' ? 'danger' : 'default'}
          onClose={() => setActiveConfirmAction(null)}
          onConfirm={() => {
            const actionToRun = activeConfirmAction
            setActiveConfirmAction(null)
            void actionToRun.onClick?.()
          }}
        />
      )}
    </>
  )
}

export default PageHeader
