<file path="src/components/smart-hover/SmartHoverTrigger.tsx">
/**
 * SmartHoverTrigger + SmartHoverPortal — §7–§11, §76, §80–§84.
 *
 * Identifier-only triggers: underline + background highlight on hover,
 * never row scaling (§84). Hover (300ms), safe travel (300ms grace),
 * pin on click / Space, Esc closes with focus return, 500ms long-press
 * opens the bottom sheet on touch (§10).
 */

import { createPortal } from 'react-dom'
import { useCallback, useEffect, useId, useRef, useState, type ReactNode } from 'react'
import { HOVER_DIMS } from '../../lib/smartHover'
import { intelClosed, intelOpened, useIntelSession } from '../../lib/intel/store'
import type { IntelContext, IntelEntityType } from '../../lib/intel/context'
import { useHoverIntent, useHoverKeyboard, useHoverPosition, useLongPress } from './hooks'

export function SmartHoverTrigger({
  label,
  triggerKind = 'identifier',
  large = false,
  renderCard,
  onOpenEntity,
  entityType,
  entityId,
  context,
}: {
  label: string
  triggerKind?: string
  large?: boolean
  renderCard: (opts: { sheet: boolean; onClose: () => void }) => ReactNode
  onOpenEntity?: () => void
  entityType: IntelEntityType
  entityId: string
  context: IntelContext
}) {
  const [open, setOpen] = useState(false)
  const [pinned, setPinned] = useState(false)
  const triggerRef = useRef<HTMLButtonElement>(null)
  const cardWrapRef = useRef<HTMLDivElement>(null)
  const id = useId()
  const session = useIntelSession()
  const [sheet, setSheet] = useState(false)
  const { placed, measure } = useHoverPosition()

  const close = useCallback(() => {
    setOpen(false)
    setPinned(false)
    intelClosed(id)
  }, [id])

  useEffect(() => () => intelClosed(id), [id])

  useEffect(() => {
    if (session.openId !== null && session.openId !== id) {
      setOpen(false)
      setPinned(false)
    }
  }, [session.openId, id])

  const claim = (mode: 'hover' | 'pinned' | 'bottom-sheet'): void => {
    intelOpened(id, { entityType, entityId, context }, mode, triggerRef.current)
  }

  const { handleTriggerEnter, handleLeaveBoth, handleCardEnter, handleCardLeave } = useHoverIntent({
    onOpen: () => {
      const coarse = typeof window !== 'undefined' && window.matchMedia?.('(pointer: coarse)').matches === true
      setSheet(coarse)
      setOpen(true)
      claim(coarse ? 'bottom-sheet' : 'hover')
      requestAnimationFrame(() => measure(triggerRef.current, large))
    },
    onClose: () => {
      if (!pinned) close()
    },
  })

  useHoverKeyboard({ open, pinned, onClose: () => {
    const back = cardWrapRef.current?.querySelector<HTMLButtonElement>('[aria-label="Back to previous preview"]')
    if (back) back.click()
    else close()
  }, onPin: () => setPinned(true), triggerRef })

  const { start, cancel, handleTap } = useLongPress({
    onPreview: () => {
      setSheet(true)
      setOpen(true)
      setPinned(true)
      claim('bottom-sheet')
    },
  })

  useEffect(() => {
    if (!open) return
    const onDown = (e: PointerEvent): void => {
      const t = e.target as Node | null
      if (t === null) return
      const inTrigger = triggerRef.current?.contains(t) ?? false
      const inCard = cardWrapRef.current?.contains(t) ?? false
      if (!inTrigger && !inCard && pinned) close()
      else if (!inTrigger && !inCard && !pinned) {
        // Pinned cards close on outside click; ephemeral ones already
        // close on leave — but a tap outside must still dismiss (§9).
        setOpen(false)
      }
    }
    document.addEventListener('pointerdown', onDown, true)
    return () => document.removeEventListener('pointerdown', onDown, true)
  }, [open, pinned, close])

  useEffect(() => {
    if (!open || sheet) return
    const onResize = (): void => measure(triggerRef.current, large)
    window.addEventListener('resize', onResize)
    window.addEventListener('scroll', onResize, true)
    return () => {
      window.removeEventListener('resize', onResize)
      window.removeEventListener('scroll', onResize, true)
    }
  }, [open, sheet, large, measure])

  const card = open ? (
    sheet ? (
      <div
        role="presentation"
        onClick={(e) => {
          if (e.target === e.currentTarget) close()
        }}
        style={{ position: 'fixed', inset: 0, background: 'var(--scrim)', zIndex: 'var(--z-drawer)', display: 'flex', alignItems: 'flex-end', justifyContent: 'center' }}
      >
        <div ref={cardWrapRef}>{renderCard({ sheet: true, onClose: close })}</div>
      </div>
    ) : (
      <div
        ref={cardWrapRef}
        onMouseEnter={handleCardEnter}
        onMouseLeave={handleCardLeave}
        style={{
          position: 'fixed',
          top: placed?.top ?? 0,
          left: placed?.left ?? 0,
          visibility: placed ? 'visible' : 'hidden',
          zIndex: 'var(--z-dropdown)',
          maxWidth: `min(${HOVER_DIMS.maxWidth}px, calc(100vw - 32px))`,
        }}
      >
        {renderCard({ sheet: false, onClose: close })}
      </div>
    )
  ) : null

  return (
    <>
      <button
        ref={triggerRef}
        type="button"
        data-hover-trigger={triggerKind}
        aria-describedby={open ? id : undefined}
        onMouseEnter={handleTriggerEnter}
        onMouseLeave={handleLeaveBoth}
        onFocus={handleTriggerEnter}
        onBlur={handleLeaveBoth}
        onClick={() => {
          if (open && !pinned) {
            setPinned(true)
            claim('pinned')
          } else if (open && pinned) {
            onOpenEntity?.()
          } else {
            setSheet(false)
            setOpen(true)
            setPinned(true)
            claim('pinned')
            requestAnimationFrame(() => measure(triggerRef.current, large))
          }
        }}
        onKeyDown={(e) => {
          if (e.key === ' ' && !open) {
            e.preventDefault()
            setOpen(true)
            setPinned(true)
            claim('pinned')
          }
          if (e.key === 'Enter' && open) {
            onOpenEntity?.()
          }
        }}
        onTouchStart={start}
        onTouchEnd={(e) => {
          cancel()
          e.preventDefault()
          handleTap(() => onOpenEntity?.())
        }}
        onTouchMove={cancel}
        style={{
          background: open ? 'var(--hover-row)' : 'transparent',
          border: 'none',
          minHeight: 'var(--tap)',
          padding: '2px 4px',
          margin: '-2px -4px',
          color: 'inherit',
          font: 'inherit',
          cursor: 'pointer',
          textDecoration: 'underline',
          textDecorationColor: 'var(--border2)',
          textUnderlineOffset: 3,
          borderRadius: 4,
        }}
      >
        {label}
      </button>
      <span id={id} style={{ display: 'none' }}>Preview available. Press Space to pin.</span>
      {typeof document !== 'undefined' ? createPortal(card, document.body) : null}
    </>
  )
}
</file>

<file path="src/components/ui/__tests__/BarcodeScannerModal.verdict.test.tsx">
// @vitest-environment jsdom
/**
 * # The scanner modal — one scan, one verdict
 *
 * **PK-09.** This modal used to beep success and print its own `matchLabel`
 * ("marked — recorded at session close, nothing saved yet") for every identity
 * match, then hand the item to the consuming screen and never look at what
 * happened there. On a second scan of an already-ticked unit,
 * `PackingWorkspace.pack` wrote "already packed" into the rail behind the open
 * modal: the operator was told the opposite of what was recorded, and the
 * record was the one they could not see. The consumer now answers with a
 * `ScanOutcome`, and this suite pins that the answer is what reaches the
 * screen — banner and session log alike.
 *
 * **PK-07.** The "Available Items for Test Scanning" chips shipped in every
 * build: a list of every scannable unit and its serial, one tap from filling
 * the scan field, on a production floor. They are now behind
 * `import.meta.env.DEV`, which `vite build` folds to `false`.
 *
 * Environment pragma per `vitest.config.ts`, which keeps the suite on `node`.
 */
import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest'
import { act } from 'react'
import { createRoot, type Root } from 'react-dom/client'
import { BarcodeScannerModal, type ScanOutcome, type ScannableItem } from '../BarcodeScannerModal'

vi.mock('../../../lib/device', async (orig) => ({
  ...(await orig<typeof import('../../../lib/device')>()),
  useViewport: () => 'desktop' as const,
}))
;(globalThis as Record<string, unknown>)['IS_REACT_ACT_ENVIRONMENT'] = true

window.matchMedia = ((query: string) =>
  ({
    matches: query.includes('hover: hover'),
    media: query,
    onchange: null,
    addEventListener: () => {},
    removeEventListener: () => {},
    addListener: () => {},
    removeListener: () => {},
    dispatchEvent: () => false,
  }) as unknown as MediaQueryList) as typeof window.matchMedia

const ITEMS: ScannableItem[] = [
  { id: 'row-1', name: 'Sony FX3', serial: 'SN-102' },
  { id: 'row-2', name: 'Gaffer tape', isAccessory: true },
]

let root: Root | null = null
let host: HTMLDivElement | null = null

let mockNow = 1700000000000
beforeEach(() => {
  mockNow = 1700000000000
  vi.spyOn(Date, 'now').mockImplementation(() => {
    mockNow += 3000
    return mockNow
  })
})

afterEach(() => {
  act(() => root?.unmount())
  host?.remove()
  root = null
  host = null
  vi.unstubAllEnvs()
  vi.restoreAllMocks()
})

async function mount(onItemScanned: (item: ScannableItem) => ScanOutcome | void) {
  host = document.createElement('div')
  document.body.appendChild(host)
  root = createRoot(host)
  await act(async () => {
    root?.render(
      <BarcodeScannerModal
        isOpen
        onClose={() => {}}
        mode="pack"
        bookingId="B-901"
        items={ITEMS}
        onItemScanned={onItemScanned}
      />,
    )
  })
}

const text = () => host?.textContent ?? ''

/** Type into the controlled scan field the way React's onChange will see it. */
async function scan(code: string) {
  const input = host?.querySelector('input[type="text"]') as HTMLInputElement
  const setValue = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value')?.set
  await act(async () => {
    setValue?.call(input, code)
    input.dispatchEvent(new Event('input', { bubbles: true }))
  })
  const scanButton = [...(host?.querySelectorAll('button') ?? [])].find((b) => b.textContent === 'Scan')
  await act(async () => {
    scanButton?.dispatchEvent(new MouseEvent('click', { bubbles: true }))
  })
}

describe('PK-09 — the consumer decides what the operator is told', () => {
  it('shows the consumer’s refusal instead of a success it did not earn', async () => {
    let seen = 0
    await mount(() => {
      seen += 1
      return seen === 1
        ? { ok: true, message: 'scanned and ticked packed — nothing is recorded until Complete Packing.' }
        : { ok: false, message: 'was already ticked packed — nothing changed.' }
    })

    await scan('SN-102')
    expect(text()).toContain('scanned and ticked packed')

    await scan('SN-102')
    expect(seen).toBe(2)
    expect(text()).toContain('was already ticked packed — nothing changed.')
    // The default would have claimed a mark on a scan that made none.
    expect(text()).not.toContain('marked — recorded at session close')
  })

  it('carries the same verdict into the session log, not a different one', async () => {
    await mount(() => ({ ok: false, message: 'was already ticked packed — nothing changed.' }))
    await scan('SN-102')
    // Once in the result banner, once in the log below it — one answer, twice.
    const occurrences = text().split('was already ticked packed').length - 1
    expect(occurrences).toBe(2)
  })

  it('names the unit that was scanned, so the verdict is attributable', async () => {
    await mount(() => ({ ok: false, message: 'was already ticked packed — nothing changed.' }))
    await scan('SN-102')
    expect(text()).toContain('Sony FX3 (SN-102)')
  })

  it('falls back to matchLabel for a consumer that answers nothing', async () => {
    await mount(() => undefined)
    await scan('SN-102')
    expect(text()).toContain('marked — recorded at session close, nothing saved yet')
  })

  it('refuses an unscannable row for the reason the flag actually carries', async () => {
    let called = 0
    await mount(() => {
      called += 1
    })
    // `isAccessory` is set by every floor workspace from "no serial and no
    // asset tag" — the refusal used to call such a row "a child accessory",
    // which is a classification nobody supplied.
    await scan('row-2')
    expect(called).toBe(0)
    expect(text()).toContain('has no serial or asset tag to scan')
    expect(text()).not.toContain('child accessory')
  })

  it('still refuses a code that matches nothing, before the consumer is called', async () => {
    let called = 0
    await mount(() => {
      called += 1
    })
    await scan('SN-999')
    expect(called).toBe(0)
    expect(text()).toContain('does not match any scannable item in this booking (B-901)')
  })
})

