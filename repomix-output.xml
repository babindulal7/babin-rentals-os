}

@media (max-width: 767px) {
  .movement-cards-list {
    padding: 0;
  }

  .movement-card {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      "booking client"
      "pickup return"
      "status status";
    gap: 0.75rem 1rem;
    min-height: 0;
    padding: 1rem;
  }

  .movement-card__booking-link { grid-area: booking; }
  .movement-card__client-link { grid-area: client; }
  .movement-card__schedule--pickup { grid-area: pickup; }
  .movement-card__schedule--return { grid-area: return; }
  .movement-card__status-action {
    grid-area: status;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
