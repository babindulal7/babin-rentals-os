            <div role="group" aria-label="Filter the sample gallery by stage" style={{ display: 'flex', gap: 'var(--sp-sm)', flexWrap: 'wrap' }}>
              {STAGE_FILTERS.map((s) => {
                const on = category === s
                const n = live.filter((p) => p.category === s).length
                return (
                  <button
                    key={s}
                    type="button"
                    onClick={() => setCategory(s)}
                    aria-pressed={on}
                    style={{
