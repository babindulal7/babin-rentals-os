  let yearless = 0
  let yearScoped = 0
  let lastMoved: string | null = null
  for (const r of list.rows) {
    if (r.includeYear) yearScoped += 1
    else yearless += 1
    if (lastMoved === null || Date.parse(r.updatedAtAd) > Date.parse(lastMoved)) lastMoved = r.updatedAtAd
  }

  const kpis: Kpi[] = [
