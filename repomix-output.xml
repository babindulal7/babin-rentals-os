/* ============================================================================
   THEME DESIGN SYSTEM v1.0 — token layer
   Source: 01 Design System/Theme Design System.md

   Every value here is transcribed from that document. Components read these
   tokens and never hardcode a colour (Buttons & Status Colors, Developer Rules:
   "Use design tokens only. Never hardcode colors.").

   Light = clean · professional · enterprise · spacious
   Dark  = cinematic · premium · OLED friendly · long working hours

   ⚠ TYPE SYSTEM DIVERGENCE:
   The marketing page (`src/marketing/MarketingPage.tsx`) uses Tailwind CSS
   (utility classes) while this app uses CSS custom properties + inline styles.
   They share ONLY the brand gold (`#d96518` / `--brand`). All other tokens
   (spacing, type scale, radii, shadows, breakpoints) are duplicated and
   must be kept in sync manually. A future unification should extract
   design tokens to a shared package (e.g., `@babin-rentals/design-tokens`).
   ========================================================================== */

/*
  ---- z-index scale: identical in both themes ----
  A named, documented stacking scale. Existing components mostly still set
  zIndex: with raw literals (values observed in an audit ranged across
  1, 2, 3, 5, 10, 20, 21, 30, 35, 40, 45, 50, 60, 70, 200, 1000, 9000, 9999,
  10000) — those literals are NOT migrated onto this scale as part of this
  change; this only establishes the scale for future/adopted use. Chosen so
  none of the five values collide with any literal already in live use, and
  ordered so each named tier paints above the one before it.

  ENFORCEMENT: Use CSS variables (--z-*) only. Hardcoded z-index literals
  in component styles are a lint error (see eslint.config.js).
  Migration: replace `zIndex: 50` → `zIndex: 'var(--z-dropdown)'`, etc.
*/
:root {
  --z-dropdown: 1100;    /* menus, popovers, comboboxes */
  --z-sticky-nav: 1200;  /* sticky headers / sub-navigation bars */
  --z-overlay: 1300;     /* backdrops, full-screen scrims behind a modal/drawer */
  --z-drawer: 1350;      /* slide-over filter and context drawers */
  --z-modal: 1400;       /* modal dialogs, above their own overlay */
  --z-toast: 9000;       /* toasts, notifications, alerts */
  --z-system: 10500;     /* system-critical: screen lock, system restore */

  /* Global Layout Tokens */
  --app-sidebar-width: 256px;
  --app-sidebar-collapsed-width: 64px;
  --global-header-height: 64px;
  --app-panel-width: 320px;
}

/* ============================================================================
   DESIGN_DIRECTION_SPEC_v4.1 — the seven-hue palette. Ruled 24 Aug 2026.
   docs/DESIGN_DIRECTION_SPEC_v4.1.md is the authority; this file only sets it.

   LIGHT IS THE DEFAULT — DESIGN_DIRECTION_SPEC_v4.2 §2.1 supersedes the 24 Aug
   dark-first ruling. Bare `:root` carries the LIGHT values so a reload cannot
   flash dark before `lib/theme.tsx` stamps `data-theme`; index.html's pre-paint
   script resolves an unset user to light for the same reason.

   Every value here is the MEASURED set. Seven cells moved off the ruling draft
   because they failed the §7.8 gate at 4.5:1 — recorded in §10 of the spec with
   before/after ratios. The rule did not move; the values did.

   TWO TOKENS DID NOT TAKE THE SPEC'S NAME, to avoid silently rebinding live
   code (the trap §8.1 names):
     · v4.1's "Dim" fill is `--dim`, NOT `--muted`. `--muted` is muted TEXT in
       1,211 places across 136 files; repainting it to a #24262C fill would
       black out muted copy on nearly every screen. §2 calls the hue "Dim", so
       `--dim` is the spec's own word.
     · `--warn` IS reclaimed for v4.1's orange, and the six legacy caution-text
       uses were migrated to `--ready-text` first (spec §11).
   ========================================================================== */

:root,
:root[data-theme='light'] {
  /* ---- §3.1 core elevation ladder ---- */
  --bg0: #e2e8f0;
  --bg: #eaeff5;
  --bgglow: #e4eaf2;
  --surface: #ffffff;
  --surface-2: #edf3fa;
  --card: #ffffff;
  --card2: #faf8f4;
  --inset: #f1f5f9;
  --inset2: #e2e8f0;
  --border: #8b9bb2;
  --border2: #a2b0c4;
  --divider: #9aa9bc;

  /* Universal 9-tier translucent alpha border scale (Light mode: slate-based) */
  --w02: rgba(15, 23, 42, 0.02);
  --w04: rgba(15, 23, 42, 0.04);
  --w05: rgba(15, 23, 42, 0.05);
  --w08: rgba(15, 23, 42, 0.08);
  --w10: rgba(15, 23, 42, 0.10);
  --w12: rgba(15, 23, 42, 0.12);
  --w15: rgba(15, 23, 42, 0.15);
  --w20: rgba(15, 23, 42, 0.20);
  --w30: rgba(15, 23, 42, 0.30);
  --w40: rgba(15, 23, 42, 0.40);

  /* Shared cool canvas, matched to the Pickup & Return dashboard. */
  --bg-gradient-1: #eaeff5;
  --bg-gradient-2: #e4eaf2;
  --bg-radial-mesh: none;
  --surface-card: var(--surface);
  --surface-card-hover: var(--surface-2);
  --glass-tint: 0.88;
  --specular-rim: 0 0 0 transparent;
  --bezel-outer-ring: 0 0 0 1px rgba(16, 32, 59, 0.06);
  --bezel-outer-bg: rgba(16, 32, 59, 0.025);

  --text: #0f172a;
  --text2: #334155;
  /*
   * v4.1 shipped #6d7076 here with the comment "measured 4.97:1 on white" —
   * which was true, and was the whole problem. `--muted` is not painted on
   * white; it is painted on the app's own tinted surfaces, and the ratio was
   * only ever measured against the lightest of them. On `#eef4fb` (the Today
   * dashboard's card) #6d7076 measures 4.48:1 and on `--surface-2` #edf3fa
   * 4.45:1 — both UNDER WCAG AA's 4.5:1 for body text. Lighthouse flagged it
   * live on `/dashboard` (`movement-card__project`, `movement-card__items-count`).
   *
   * #63666d is the same hue nudged down until it clears 4.5:1 on the DARKEST
   * light-theme surface (`--inset2` #eae6de, 4.62:1) rather than on white, so
   * every surface in the ladder passes, not just the one that was measured.
   * `check:contrast` now asserts the muted-on-tinted pairs so this cannot
   * regress behind a passing white-only check.
   *
   * 8 Oct 2026 (RULINGS-2026-10-08.md, "looks old and lacks contrast"): text
   * was already AA; the STRUCTURE was not — borders 1.48:1 on cards, cards
   * 1.07:1 on the page, input outlines ~1.8:1 (under WCAG 1.4.11's 3:1).
   * One cool slate family now (the cream insets are gone); muted #526075 is
   * 6.39:1 on white and 5.18:1 on the darkest inset #e2e8f0; text2 #334155
   * 10.35:1; input border #7c8ba1 3.46:1; cards carry a soft shadow.
   */
  --muted: #526075;
  --disabled: #9b9ea4;

  --primary: #2456d6;
  --on-primary: #ffffff;
  /* RULING 2026-10-15: selected/active state is a solid NEUTRAL, not blue — blue is for primary actions. */
  --select-bg: #1e293b;
  --select-fg: #ffffff;
  --primary-text: #1e49b8;

  --success: #1e864a;
  --on-success: #ffffff;
  --success-text: #15683a;

  --danger: #c73a3a;
  --on-danger: #ffffff;
  --danger-text: #a82f2f;

  /* Orange keeps the ruled hue; the INK moved to dark because white measured
     3.61:1 on it (§10). Orange is dark-ink in both themes.

     Desaturated from #d96518, but only to #d46218 and no further: #c45d16
     dropped `--on-warn` (#231a05) to 4.03:1, under AA. Orange's ink is DARK,
     so a *darker* fill is the wrong direction — it eats the ink's contrast.
     #d46218 holds the desaturation and measures 4.55:1. */
  --warn: #d46218;
  --on-warn: #231a05;
  --warn-text: #9a5417;
  /* RULING 2026-10-18: booking dates plain (Babin), superseding 7 Oct "orange everywhere". */
  --booking-date-text: var(--text);

  --ready: #d4a315;       /* Desaturated from #e3b117. */
  --on-ready: #231a05;
  --ready-text: #7f620a;

  --neutral: #72757e;  /* draft #8A8D95 → white was 3.32, now 4.60 */
  --on-neutral: #ffffff;

  --dim: #dddcd6;
  --on-dim: #5a5d63;

  --ext-fg: #1e49b8;
  --ext-line: #2456d6;
  --ext-bg: rgba(36, 86, 214, 0.1);
  --gold: #2456d6;
  --brand-mark: #2456d6;

  --app: #e9eef5;
  --sidebar: #ffffff;
  --card: #ffffff;
  --card2: #edf3fa;
  --modal: #ffffff;
  --dropdown: #ffffff;

  --hover-card: #eef4fb;
  --hover-sidebar: #eef4fb;
  --hover-button: #1e49b8;
  --hover-row: #eef4fb;

  --btn-primary-bg: #2456d6;
  --btn-primary-fg: #ffffff;
  --btn-secondary-bg: transparent;
  --btn-secondary-border: #64748b;
  --btn-danger-bg: #c73a3a;
  --btn-danger-fg: #ffffff;

  --nav-active-accent: #2456d6;
  --nav-active-bg: #e7efff;
  --nav-icon: #6d7076;

  --input-bg: #ffffff;
  --input-border: #7c8ba1;
  --input-placeholder: #5f6e83;
  --input-focus: #2456d6;

  --th-bg: #edf3fa;
  --tr-bg: #ffffff;
  --tr-hover: #eef4fb;
  --tr-alt: #f5f7fb;

  /* DESIGN_DIRECTION_SPEC v4.2 §6 Shadow Scale — tinted to match background hue */
  --shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.07), 0 0 0 1px rgba(15, 23, 42, 0.03);
  --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.09), 0 1px 2px rgba(15, 23, 42, 0.05);
  --shadow: 0 4px 6px -1px rgba(15, 23, 42, 0.05), 0 2px 4px -1px rgba(15, 23, 42, 0.03);
  --shadow-card: 0 1px 3px rgba(15, 23, 42, 0.08), 0 1px 2px rgba(15, 23, 42, 0.04);
  --shadow-kpi: 0 0 0 transparent;
  --shadow-md: 0 8px 20px -3px rgba(15, 23, 42, 0.08);
  --shadow-lg: 0 10px 15px -3px rgba(15, 23, 42, 0.05), 0 4px 6px -2px rgba(15, 23, 42, 0.025);
  --shadow-xl: 0 20px 25px -5px rgba(15, 23, 42, 0.10), 0 10px 10px -5px rgba(15, 23, 42, 0.04);
  --shadow-modal: 0 20px 48px rgba(15, 23, 42, 0.16);
  --shadow-primary-glow: 0 8px 20px -4px rgba(36, 86, 214, 0.25);

  /* DESIGN_DIRECTION_SPEC v4.2 §6 Soft-tint non-status chips */
  --chip-blue-bg: #DBEAFE;
  --chip-blue-fg: #1E40AF;
  --chip-gray-bg: #F3F4F6;
  --chip-gray-fg: #374151;
  --chip-amber-bg: #FEF3C7;
  --chip-amber-fg: #92400E;

  --danger-soft: #fdf6f6;
  --scrim: rgba(15, 23, 42, 0.45);

  --chart-grid: #dbe5f0;
  --cat-1: #0072b2;
  --cat-2: #c87a00;
  --cat-3: #009e73;
  --cat-4: #d55e00;
  --cat-5: #3d5a9e;
  --cat-6: #b23a6b;
  --cat-7: #6b7a00;
  --cat-8: #8b3a0e;
}

:root[data-theme='dark'] {
  /* ---- §3.1 5-Tier Obsidian Dark Elevation Ladder ---- */
  --bg0: #020509;
  --bg: #04080d;
  --bgglow: #0a1826;
  --surface: #0f1b2a;
  --surface-2: #13233a;
  --card: #0f1b2a;
  --card2: #13233a;
  --inset: #081522;
  --inset2: #0b1b2c;
  --sidebar: #050b12;
  --modal: #0d1a29;
  --dropdown: #0d1a29;

  /* Universal 9-tier translucent alpha border scale (Dark mode: pure white) */
  --w02: rgba(255, 255, 255, 0.02);
  --w04: rgba(255, 255, 255, 0.04);
  --w05: rgba(255, 255, 255, 0.05);
  --w08: rgba(255, 255, 255, 0.08);
  --w10: rgba(255, 255, 255, 0.10);
  --w12: rgba(255, 255, 255, 0.12);
  --w15: rgba(255, 255, 255, 0.15);
  --w20: rgba(255, 255, 255, 0.20);
  --w30: rgba(255, 255, 255, 0.30);
  --w40: rgba(255, 255, 255, 0.40);

  --border: rgba(255, 255, 255, 0.22);
  --border2: rgba(255, 255, 255, 0.30);
  --divider: rgba(255, 255, 255, 0.20);

  /* Obsidian Spatial Gradients & Glows */
  --bg-gradient-1: #04080d;
  --bg-gradient-2: #020509;
  --bg-radial-mesh: radial-gradient(ellipse 80% 50% at 50% -20%, #0a1826 0%, #050b12 100%);
  --surface-card: linear-gradient(180deg, var(--card2) 0%, var(--card) 100%);
  --surface-card-hover: var(--card2);
  --glass-tint: 0.88;
  --specular-rim: 0 1px 0 rgba(255, 255, 255, 0.08) inset;
  --bezel-outer-ring: 0 0 0 1px var(--w08);
  --bezel-outer-bg: rgba(255, 255, 255, 0.02);

  --text: #f1f5f9;
  --text2: #b8c4d3;
  --muted: #9eaabb;
  --disabled: #475569;

  --primary: #386af7;      /* WCAG AA 4.59:1 with white on-primary */
  --on-primary: #ffffff;
  --select-bg: #3b475c;
  --select-fg: #ffffff;
  --primary-text: #7ea2ff; /* text-safe blue on --surface */

  /* ---- §3.2 status hues + their on-colours ---- */
  --success: #1e864a;      /* draft #1F8A4C → white was 4.38, now 4.60 */
  --on-success: #ffffff;
  --success-text: #4ade80;

  --danger: #c73a3a;       /* WCAG AA 5.13:1 with white on-danger */
  --on-danger: #ffffff;
  --danger-text: #f08a8a;

  --warn: #d47026;         /* ORANGE — "out with the client". Never a button. Desaturated from #e8762d. */
  --on-warn: #1c1005;
  --warn-text: #e8a06e;
  /* RULING 2026-10-18: booking dates plain (Babin), superseding 7 Oct "orange everywhere". */
  --booking-date-text: var(--text);

  --ready: #d4a824;        /* YELLOW — in-house work / waiting. Never a button. Desaturated from #edbe2a. */
  --on-ready: #1c1405;
  --ready-text: #d4a824;

  --neutral: #3a3e47;      /* GRAY — not started yet */
  --on-neutral: #c9cbd1;

  --dim: #24262c;          /* DIM — finished / inactive. 4.61:1 with on-dim */
  --on-dim: #8b8e96;

  --ext-fg: #85b2ff;
  --ext-line: #386af7;
  --ext-bg: rgba(56, 106, 247, 0.14);
  --gold: #386af7;
  --brand-mark: #85b2ff;

  --app: #04080d;
  --sidebar: #050b12;
  --card: #0f1b2a;
  --card2: #13233a;
  --modal: #0d1a29;
  --dropdown: #0d1a29;

  --hover-card: #0f1e30;
  --hover-sidebar: #0d1a29;
  --hover-button: #2f5ce0;
  --hover-row: rgba(255, 255, 255, 0.035);

  --btn-primary-bg: #386af7;
  --btn-primary-fg: #ffffff;
  --btn-secondary-bg: transparent;
  --btn-secondary-border: rgba(255, 255, 255, 0.44);
  --btn-danger-bg: #c73a3a;
  --btn-danger-fg: #ffffff;

  /*
   * The ACTIVE sidebar item's ink. #386af7 measured 4.30:1 on the dark rail
   * (#050b12) — under AA for 14px text, and the rail is where the current
   * destination is announced, so it is the last place to be illegible.
   * Lightened to #6b95fc, the same hue: 6.9:1 on the rail, 5.0:1 on
   * `--nav-active-bg`, 6.4:1 on `--surface`. Asserted by `check:contrast`.
   */
  --nav-active-accent: #6b95fc;
  --nav-active-bg: #102b48;
  --nav-icon: #94a3b8;

  --input-bg: #081522;
  --input-border: rgba(255, 255, 255, 0.44);
  --input-placeholder: #64748b;
  --input-focus: #386af7;

  --th-bg: #081522;
  --tr-bg: #0b1622;
  --tr-hover: rgba(255, 255, 255, 0.035);
  --tr-alt: #081522;

  --shadow-xs: 0 1px 2px 0 rgba(2, 6, 11, 0.35);
  --shadow-sm: 0 1px 3px 0 rgba(2, 6, 11, 0.4), 0 1px 2px -1px rgba(2, 6, 11, 0.3);
  --shadow: 0 4px 14px -2px rgba(2, 6, 11, 0.5), 0 2px 6px -1px rgba(2, 6, 11, 0.3);
  --shadow-card: 0 0 0 transparent;
  --shadow-kpi: var(--shadow-card);
  --shadow-md: 0 14px 28px -4px rgba(2, 6, 11, 0.6), 0 6px 12px -2px rgba(2, 6, 11, 0.4);
  --shadow-lg: 0 20px 36px -6px rgba(2, 6, 11, 0.65), 0 8px 14px -3px rgba(2, 6, 11, 0.45);
  --shadow-xl: 0 28px 56px -8px rgba(2, 6, 11, 0.75), 0 12px 18px -4px rgba(2, 6, 11, 0.5);
  --shadow-modal: 0 28px 72px -12px rgba(2, 6, 11, 0.85), 0 0 0 1px rgba(255, 255, 255, 0.08);
  --shadow-primary-glow: 0 8px 28px -4px rgba(56, 106, 247, 0.45);

  /* DESIGN_DIRECTION_SPEC v4.2 §6 Soft-tint non-status chips */
  --chip-blue-bg: rgba(59, 130, 246, 0.18);
  --chip-blue-fg: #93C5FD;
  --chip-gray-bg: rgba(156, 163, 175, 0.18);
  --chip-gray-fg: #D1D5DB;
  --chip-amber-bg: rgba(245, 158, 11, 0.18);
  --chip-amber-fg: #FCD34D;

  --danger-soft: #1a1315;
  --scrim: rgba(0, 0, 0, 0.65);

  --chart-grid: #263849;
  --cat-1: #3b82d6;
  --cat-2: #b87a1e;
  --cat-3: #249e76;
  --cat-4: #d9613c;
  --cat-5: #5a76c2;
  --cat-6: #c25588;
  --cat-7: #7a8c3e;
  --cat-8: #5d71b0;
}

/* ── §3.1 High-Contrast Outdoor Profile (Glare Reduction for Warehouse & Loading Bays) ── */
:root[data-theme='high-contrast'] {
  --bg: #0a0a0a;
  --surface: #0a0a0a;
  --surface-2: #141414;
  --border: #facc15;
  --border2: #eab308;
  --divider: #facc15;

  --bg-gradient-1: #000000;
  --bg-gradient-2: #050505;
  --bg-radial-mesh: none;
  --surface-card: #0a0a0a;
  --surface-card-hover: #171717;
  --glass-tint: 1;
  --specular-rim: 0 0 0 transparent;
  --bezel-outer-ring: 0 0 0 2px #facc15;
  --bezel-outer-bg: transparent;

  --text: #ffffff;
  --text2: #f1f5f9;
  --muted: #e2e8f0;
  --disabled: #94a3b8;

  --primary: #facc15;
  --on-primary: #000000;
  --select-bg: var(--primary);
  --select-fg: var(--on-primary);
  --primary-text: #fde047;

  --success: #22c55e;
  --on-success: #000000;
