  { id: 'u18', category: 'Accessory', name: 'Pelican 1610 Case', serial: 'SN-ACC-002', required: true, location: 'G1-05', needsClean: true, needsReset: false, assignedTo: 'Bikash Thapa', waitingMinutes: 5, evidence: 0 },
