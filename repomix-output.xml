}

/** Mirrors Inventory.tsx's `tdFor` — same helper name, same compact/comfortable split. */
const tdFor = (d: Density) => ({
  padding: d === 'compact' ? '5px 12px' : '11px 12px',
  fontSize: 'var(--t-meta)',
  color: 'var(--text)',
