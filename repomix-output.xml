  border-radius: 0.5rem;
  background: var(--dashboard-accent);
  color: #fff;
  font-size: var(--t-th);
  font-weight: 700;
  line-height: 1;
  text-align: center;
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
  transition: background 160ms ease, transform 160ms ease;
}

.movement-panel__action:hover {
  background: var(--dashboard-accent-strong);
  filter: brightness(1.03);
}

.movement-panel__action:active {
  filter: brightness(0.98);
}

.movement-panel__action--secondary {
  background: transparent;
  border-color: var(--border);
  color: var(--text);
}

.movement-panel__action--secondary:hover {
  background: var(--hover-row);
}

/* Phone (<768px): Single column, Pickups top, Returns bottom, compact cards */
@media (max-width: 767px) {
  .movement-panel {
    min-height: 0;
  }

  .movement-panel__header {
    grid-template-columns: auto minmax(0, 1fr);
    min-height: 0;
    padding: 1rem;
  }

  .movement-panel__icon {
    width: 2.7rem;
    height: 2.7rem;
  }

  .movement-panel__heading h2 {
    font-size: var(--t-h3);
  }

  .movement-panel__filter {
    grid-column: 1 / -1;
    justify-self: stretch;
  }

  .dashboard-date-filter__button {
    width: 100%;
    grid-template-columns: 2.75rem 1fr auto;
  }

  .dashboard-calendar {
    position: fixed;
    top: auto;
    right: 0.75rem;
    bottom: 0.75rem;
    left: 0.75rem;
    width: auto;
    max-height: calc(100dvh - 1.5rem);
    overflow: auto;
    border-radius: 0.85rem;
  }

  .movement-panel__table-head {
    display: none;
  }

  .movement-panel__rows {
    min-height: 0;
    padding: 0.75rem;
  }

  /* Compact card layout:
     Line 1: [Status badge] [Client name]
     Line 2: [Booking #] · [Date/Time]
     Line 3: [Item count] · [Action Button]
  */
  .movement-panel__row {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "status client"
      "number date"
      "items action";
    gap: 0.5rem 0.75rem;
    min-height: 0;
    margin-bottom: 0.75rem;
    padding: 0.875rem;
    border: 1px solid var(--border);
    border-radius: 0.55rem;
    background: var(--card2);
    align-items: center;
  }

  .movement-panel__row:last-child {
    margin-bottom: 0;
  }

  .movement-panel__status {
    grid-area: status;
    justify-self: start;
  }

  .movement-panel__client {
    grid-area: client;
    justify-self: start;
    min-width: 0;
  }

  .movement-panel__number {
    grid-area: number;
    justify-self: start;
  }

  .movement-panel__date {
    grid-area: date;
    justify-self: start;
  }

  .movement-panel__items {
    grid-area: items;
    justify-self: start;
  }

  .movement-panel__action {
    grid-area: action;
    justify-self: end;
    min-height: 2.75rem;
    padding-inline: 1rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .dashboard-calendar,
  .movement-panel__action,
  .dashboard-date-filter__button {
    animation: none;
    transition: none;
  }
}

/* ─── Specification v1.0: Modern Operational Cards (Spec §4.4 & §4.5) ─── */
.movement-cards-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  padding: 1rem 1.25rem 1.25rem;
}

.movement-card {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  min-width: 0;
  padding: 1.15rem 1.25rem;
  border-radius: var(--r-card, 12px);
  border: 1px solid var(--w08, var(--border));
  background: var(--card2);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
}

.movement-card:hover {
  filter: brightness(1.03);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  border-color: var(--w20, var(--border2));
  background: color-mix(in srgb, var(--card2) 80%, var(--bgglow));
}

.movement-card:last-child { border-bottom: 1px solid var(--w08, var(--border)); }

.movement-card__booking-link:focus-visible,
.movement-card__cta-btn:focus-visible {
  outline: 2px solid var(--input-focus);
  outline-offset: 2px;
}

.movement-card--overdue {
  border-left: 3px solid var(--danger-text);
  border-color: rgba(255, 107, 107, 0.3) var(--w08, var(--border)) var(--w08, var(--border)) var(--danger-text);
  background: linear-gradient(90deg, rgba(255, 107, 107, 0.07) 0%, var(--card2) 100%);
}

.movement-card__avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: var(--r-badge, 999px);
  background: var(--inset2);
  border: 1px solid var(--w12, var(--border));
  color: var(--text);
  font-size: var(--t-th);
  font-weight: 700;
  font-family: var(--font-id, 'Source Sans 3', sans-serif);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.movement-card__project-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: var(--t-th);
  color: var(--text2);
  padding: 2px 8px;
  border-radius: var(--r-sm, 6px);
  background: var(--inset);
  border: 1px solid var(--w08, var(--border));
}

.movement-card__case-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: var(--t-th);
  font-weight: 600;
