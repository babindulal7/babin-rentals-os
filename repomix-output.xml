                        fontWeight: 600,
                      }}
                    >
                      {deliveryTypeLabel(booking.deliveryType)}
                    </span>
                  </div>
                  {[
                    { label: 'Pickup Location', value: booking.pickupLocation ?? 'Not recorded' },
