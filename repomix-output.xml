  gap: 0.65rem;
  font-size: 1.3rem;
  font-weight: 650;
  letter-spacing: -0.025em;
}

.rental-dashboard__panels .movement-panel__heading h2 > span:first-child {
  color: var(--movement-accent);
}

.rental-dashboard__panels .movement-panel__heading h2 .figure,
.rental-dashboard__panels .movement-panel--outgoing .movement-panel__heading h2 .figure,
.rental-dashboard__panels .movement-panel--incoming .movement-panel__heading h2 .figure {
  color: var(--text);
  font-family: var(--font-id, 'Source Sans 3', sans-serif);
  font-size: 1.65rem;
  font-weight: 600;
  letter-spacing: -0.065em;
  font-variant-numeric: tabular-nums;
}

.rental-dashboard__panels .movement-panel__heading p {
  font-size: var(--t-th);
  color: var(--muted);
}

.rental-dashboard__panels .movement-panel--compact,
.rental-dashboard__panels .movement-panel--compact .movement-panel__header {
  background: color-mix(in srgb, var(--movement-tint) 7%, var(--card));
}

.rental-dashboard__panels .movement-panel--compact .movement-panel__header {
  border-bottom: 0;
}

.rental-dashboard__panels .movement-panel__body {
  container-type: inline-size;
}

.rental-dashboard__panels .movement-panel__empty {
  display: flex;
  align-items: flex-start;
  gap: 1.1rem;
  min-height: 8.5rem;
  padding: 1.5rem;
}

.movement-panel__empty-mark {
  display: grid;
  flex: 0 0 3rem;
  place-items: center;
  width: 3rem;
  height: 3rem;
  border: 1px solid color-mix(in srgb, var(--movement-accent) 25%, var(--border));
  border-radius: 11px;
  background: color-mix(in srgb, var(--movement-tint) 9%, var(--card));
  color: var(--movement-accent);
}

.movement-panel__empty-copy {
  padding-top: 0.15rem;
}

.movement-panel__empty .movement-panel__empty-title {
  font-size: var(--t-ui);
  font-weight: 650;
}

.movement-panel__empty .movement-panel__empty-desc {
  max-width: 38ch;
  margin-top: 0.4rem;
  line-height: 1.5;
}

.movement-panel__empty-reset {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  min-height: 44px;
  margin-top: 0.6rem;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--primary-text);
  font: 650 var(--t-meta)/1 var(--font-body);
  cursor: pointer;
}

.movement-panel__empty-reset:hover {
  text-decoration: underline;
  text-underline-offset: 0.2em;
}

.movement-panel__empty-reset:focus-visible {
  outline: 2px solid var(--input-focus);
  outline-offset: 2px;
}

.dashboard-shift-handover__toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

.dashboard-shift-handover__label {
  white-space: nowrap;
}

.rental-dashboard__panels .dashboard-date-filter__calendar,
.rental-dashboard__panels .movement-panel--outgoing .dashboard-date-filter__calendar,
.rental-dashboard__panels .movement-panel--incoming .dashboard-date-filter__calendar {
  color: var(--muted);
}

.rental-dashboard__panels .dashboard-date-filter__button {
  grid-template-columns: auto auto auto;
  gap: 0.4rem;
  min-height: 44px;
  padding: 0 0.5rem;
  border: 0;
  border-radius: 6px;
  background: transparent;
  box-shadow: none;
  color: var(--text2);
}

.rental-dashboard__panels .dashboard-date-filter__button:hover,
.rental-dashboard__panels .dashboard-date-filter__button[aria-expanded='true'] {
  border: 0;
  background: var(--hover-row);
  box-shadow: none;
  transform: none;
}

.rental-dashboard__panels .dashboard-date-filter__calendar {
  min-height: 44px;
  border-right: 0;
}

.rental-dashboard__panels .dashboard-date-filter__label {
  padding-inline: 0;
}

.rental-dashboard__panels .movement-cards-list,
.rental-dashboard__panels--returns-focus .movement-cards-list,
.rental-dashboard__panels--pickups-focus .movement-cards-list {
  display: block;
  width: 100%;
  padding: 0;
}

.rental-dashboard__panels .movement-card {
  min-height: 0;
  margin: 0;
  padding: 1rem 1.25rem;
  gap: 0.5rem 1rem;
  border: 0;
  border-bottom: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  transform: none;
}

.rental-dashboard__panels .movement-card:last-child {
  border-bottom: 0;
}

.rental-dashboard__panels .movement-card:hover,
.rental-dashboard__panels .movement-card--overdue:hover {
  border-color: color-mix(in srgb, var(--border) 55%, transparent);
  background: var(--hover-row);
  box-shadow: none;
  transform: none;
}

.rental-dashboard__panels .movement-card--overdue {
  background: transparent;
  border-left: 0;
}

.rental-dashboard__panels .movement-card__avatar {
  display: none;
}

.rental-dashboard__panels .movement-card__client {
  font-size: var(--t-ui);
  font-weight: 650;
}

.rental-dashboard__panels .movement-card__project,
.rental-dashboard__panels .movement-card__items-count {
  color: var(--muted);
}

.rental-dashboard__panels .movement-card__number,
.rental-dashboard__panels .movement-card--incoming .movement-card__schedule--return strong,
.rental-dashboard__panels .movement-card--outgoing .movement-card__schedule--pickup strong {
  color: var(--text);
}

.rental-dashboard__panels .movement-card__schedule > span,
.rental-dashboard__panels .movement-card__record-label {
  color: var(--muted);
  font-size: 0.625rem;
  letter-spacing: 0.08em;
}

.rental-dashboard__panels .movement-card__status-action {
  padding-top: 0.5rem;
  border-top: 0;
}

.movement-card__status {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  color: var(--danger-text);
  font-size: var(--t-th);
  font-weight: 650;
  line-height: 1.25;
  white-space: nowrap;
}

.movement-card__status--partial {
  color: var(--warning-text, var(--text2));
}

.rental-dashboard__panels .movement-card__cta-btn,
.rental-dashboard__panels .movement-card__cta-btn.is-dominant,
.rental-dashboard__panels .movement-card__cta-btn.is-prep {
  min-height: 44px;
  padding: 0.25rem 0.5rem;
  border: 0;
  border-radius: 5px;
  background: transparent;
  color: var(--primary-text);
  box-shadow: none;
  font-size: var(--t-meta);
  font-weight: 650;
  transition: background 180ms cubic-bezier(0.32, 0.72, 0, 1), transform 180ms cubic-bezier(0.32, 0.72, 0, 1);
}

.rental-dashboard__panels .movement-card__cta-btn:hover,
.rental-dashboard__panels .movement-card__cta-btn.is-dominant:hover,
.rental-dashboard__panels .movement-card__cta-btn.is-prep:hover {
  background: var(--select-bg);
  color: var(--select-fg);
  box-shadow: none;
  filter: none;
  transform: none;
}

.rental-dashboard__panels .movement-card__cta-btn:focus-visible,
.dashboard-workbar .dashboard-alert__action:focus-visible {
  outline: 2px solid var(--input-focus);
  outline-offset: 2px;
}

@container (min-width: 52rem) {
  .rental-dashboard__panels--returns-focus .movement-cards-list__head,
  .rental-dashboard__panels--pickups-focus .movement-cards-list__head,
  .rental-dashboard__panels--returns-focus .movement-card,
  .rental-dashboard__panels--pickups-focus .movement-card {
    display: grid;
    grid-template-columns: minmax(12rem, 2.1fr) minmax(5rem, 0.65fr) minmax(7rem, 0.9fr) minmax(10rem, 1.15fr) minmax(15rem, 1.8fr);
    grid-template-areas: "client booking pickup return status";
    align-items: center;
    column-gap: 1rem;
  }

  .rental-dashboard__panels--returns-focus .movement-cards-list__head,
  .rental-dashboard__panels--pickups-focus .movement-cards-list__head {
    min-height: 2.75rem;
    padding-inline: 1.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
    background: color-mix(in srgb, var(--card2) 45%, var(--card));
    color: var(--muted);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rental-dashboard__panels--returns-focus .movement-card,
  .rental-dashboard__panels--pickups-focus .movement-card {
    min-height: 4.25rem;
    padding-block: 0.5rem;
  }

  .rental-dashboard__panels--returns-focus .movement-card__record-label,
  .rental-dashboard__panels--pickups-focus .movement-card__record-label,
  .rental-dashboard__panels--returns-focus .movement-card__schedule > span,
  .rental-dashboard__panels--pickups-focus .movement-card__schedule > span {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .rental-dashboard__panels--returns-focus .movement-card__booking-link,
  .rental-dashboard__panels--pickups-focus .movement-card__booking-link,
  .rental-dashboard__panels--returns-focus .movement-card__schedule--return,
  .rental-dashboard__panels--pickups-focus .movement-card__schedule--return {
    align-items: flex-start;
    text-align: left;
  }

  .rental-dashboard__panels--returns-focus .movement-card__status-action,
  .rental-dashboard__panels--pickups-focus .movement-card__status-action {
    padding: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.125rem;
  }

  .rental-dashboard__panels--returns-focus .movement-card__cta-btn,
  .rental-dashboard__panels--pickups-focus .movement-card__cta-btn {
    margin-left: 0;
  }
}

/* Phone: work first (ruled 8 Oct 2026, RULINGS-2026-10-08.md). The page title
   already says Today and the Pickups/Returns switch already names the open list
   with its count, so the workbar intro and the panel heading only pushed the
   first card below the fold. The heading stays for screen readers: it names the
   section the list belongs to. */
@media (max-width: 767px) {
  .dashboard-workbar__intro { justify-content: flex-end; }
  .dashboard-workbar__intro p { display: none; }

  .movement-panel__header {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
}

@media (max-width: 767px) {
  .dashboard-shift-handover__toggle {
    flex-wrap: wrap;
  }

  .dashboard-shift-handover__status {
    margin-left: 1.6rem;
  }

  .dashboard-date-actions, .dashboard-date-actions > span { width: 100%; min-width: 0; }

  .dashboard-master-date-control {
    display: flex;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .dashboard-master-date-control__btn { flex-shrink: 0; }

  .dashboard-master-date-control__date-btn {
    flex: 1 1 0;
    width: 0;
    min-width: 0;
    justify-content: center;
    overflow: hidden;
  }

  .dashboard-master-date-control__primary,
  .dashboard-master-date-control__secondary {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dashboard-workbar {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
  }

  .dashboard-workbar .dashboard-counter-bar {
    width: 100%;
  }

  .dashboard-workbar .dashboard-alert {
    min-height: 2.75rem;
  }

  .rental-dashboard__panels .movement-panel__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    min-height: 5.5rem;
    gap: 0.75rem;
    padding: 1rem;
  }

  .rental-dashboard__panels .movement-panel__filter {
    grid-column: 2;
    grid-row: 1;
    margin-left: 0;
  }

  .rental-dashboard__panels .movement-panel__heading h2 {
    font-size: 1.15rem;
  }

  .rental-dashboard__panels .movement-panel__heading h2 .figure {
    font-size: 1.35rem;
  }

  .rental-dashboard__panels .movement-panel__empty {
    gap: 0.85rem;
    padding: 1.25rem 1rem;
  }

  .rental-dashboard__panels .movement-card {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "client booking"
      "pickup return"
      "status status";
  }

  .rental-dashboard__panels .movement-card__booking-link,
  .rental-dashboard__panels .movement-card__schedule--return {
    align-items: flex-end;
    text-align: right;
  }

  .rental-dashboard__panels .movement-card__status-action {
    flex-wrap: wrap;
  }
}

/* ─── Modern layer (ruled 8 Oct 2026, RULINGS-2026-10-08.md) ───────────────
   One surface per queue instead of cards inside cards: panels lose the 3px
   accent bar and tinted header, rows sit on hairline dividers, labels drop the
   all-caps micro style, avatars become rounded squares and actions get press
   feedback. Category colour survives as a dot and the count chip beside the
   text title, so it is never colour alone. Tokens only — both themes follow.
   Last in the file so it is the layer that wins; earlier rules are unchanged. */
.rental-dashboard .rental-dashboard__panels .movement-panel {
  border: 1px solid var(--border);
  border-radius: var(--r-card, 14px);
  background: var(--card);
  box-shadow: var(--shadow-xs);
  overflow: hidden;
}

.rental-dashboard .rental-dashboard__panels .movement-panel__header {
  min-height: 0;
  padding: 1rem 1.25rem;
  background: transparent;
  border-bottom: 1px solid var(--border);
}

.rental-dashboard .rental-dashboard__panels .movement-panel__heading h2 {
  align-items: center;
  font-size: 1.125rem;
  font-weight: 650;
  letter-spacing: -0.015em;
}

.rental-dashboard .rental-dashboard__panels .movement-panel__heading h2 > span:first-child {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  color: var(--text);
}

.rental-dashboard .rental-dashboard__panels .movement-panel__heading h2 > span:first-child::before {
  content: '';
  width: 0.55rem;
  height: 0.55rem;
  border-radius: 50%;
  background: var(--movement-accent);
}

.rental-dashboard .rental-dashboard__panels .movement-panel__heading h2 .figure {
  display: inline-flex;
  align-items: center;
  padding: 0.05rem 0.55rem;
  border-radius: var(--r-badge, 999px);
  background: color-mix(in srgb, var(--movement-tint) 12%, var(--card));
  color: var(--movement-accent);
  font-size: var(--t-meta);
  font-weight: 700;
  letter-spacing: 0;
}

.rental-dashboard .rental-dashboard__panels .movement-panel__heading p {
  margin-top: 0.15rem;
  color: var(--muted);
  font-size: var(--t-th);
}

.rental-dashboard .movement-cards-list {
  gap: 0;
  padding: 0;
}

.rental-dashboard .movement-card {
  gap: 0.4rem 0.85rem;
  padding: 0.65rem 1.15rem;
  border: 0;
  border-bottom: 1px solid var(--border);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  animation: today-row-in 260ms var(--ease) both;
  animation-delay: calc(var(--row-i, 0) * 28ms);
}

.rental-dashboard .movement-card:last-child {
  border-bottom: 0;
}

.rental-dashboard .movement-card:hover {
  filter: none;
  box-shadow: none;
  background: color-mix(in srgb, var(--movement-tint) 5%, var(--card));
}

.rental-dashboard .movement-card--overdue {
  border-color: var(--border);
  border-left: 0;
  box-shadow: inset 3px 0 0 var(--danger-text);
  background: color-mix(in srgb, var(--danger) 3%, var(--card));
}

.rental-dashboard .movement-card--overdue:hover {
  background: color-mix(in srgb, var(--danger) 6%, var(--card));
}

.rental-dashboard .movement-card__client {
  font-size: 0.95rem;
  font-weight: 650;
}

.rental-dashboard .movement-card__record-label,
.rental-dashboard .movement-card__schedule > span {
  font-size: var(--t-caption, 11px);
  font-weight: 500;
  letter-spacing: 0;
  text-transform: none;
  color: var(--muted);
}

.rental-dashboard .movement-card__number {
  padding: 0.1rem 0.45rem;
  border-radius: var(--r-btn, 8px);
  background: color-mix(in srgb, var(--text) 7%, var(--card));
  color: var(--text);
}

.rental-dashboard .movement-card__booking-link:hover .movement-card__number {
  color: var(--primary-text);
}

.rental-dashboard .movement-card__status-action {
  padding-top: 0.15rem;
  border-top: 0;
}

/* A real button, not a text link (8 Oct 2026): bordered, tinted, 44px, with
   hover and press feedback. Soft rather than solid — a list can show two dozen
   of these, and a wall of solid blue would drown the rows themselves. Three
   classes deep to outrank the older `.rental-dashboard__panels … .is-dominant` link style. */
.rental-dashboard .rental-dashboard__panels .movement-card__cta-btn {
  min-height: 56px;
  padding: 0 0.95rem;
  border: 1px solid var(--select-bg);
  border-radius: var(--r-btn, 8px);
  background: var(--select-bg);
  color: var(--select-fg);
  font-size: var(--t-meta);
  font-weight: 650;
  text-decoration: none;
  transition: background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}

.rental-dashboard .rental-dashboard__panels .movement-card__cta-btn:hover {
  border-color: var(--primary);
  background: var(--btn-primary-bg, var(--primary));
  color: var(--btn-primary-fg, var(--on-primary));
}

.rental-dashboard .rental-dashboard__panels .movement-card__cta-btn:focus-visible {
  outline: 2px solid var(--input-focus);
  outline-offset: 2px;
}

.rental-dashboard .movement-card__cta-btn:active {
  filter: brightness(0.96);
}

/* Meaningful rows (8 Oct 2026): the time column replaces the initials as the
   row's anchor — WHEN it moves, in the booking-date orange, or how late it is
   in the danger ink. Tags name readiness and delivery mode with icon + words. */
.rental-dashboard .movement-card {
  grid-template-columns: 4.75rem minmax(0, 1.25fr) minmax(0, 0.75fr);
  grid-template-areas:
    "when client booking"
    "when pickup return"
    "when status status";
}

.rental-dashboard .movement-card__avatar {
  display: none;
}

.rental-dashboard .movement-card__when {
  grid-area: when;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 0.15rem;
  padding-top: 0.1rem;
  padding-right: 0.85rem;
  border-right: 1px solid var(--border);
}

.rental-dashboard .movement-card__when strong {
  font-family: var(--font-display);
  font-size: 1.2rem;
  font-weight: 650;
  line-height: 1.1;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  color: var(--booking-date-text);
}

.rental-dashboard .movement-card__when span {
  font-size: var(--t-caption, 11px);
  font-weight: 500;
  color: var(--muted);
}

.rental-dashboard .movement-card__when--late strong {
  color: var(--danger-text);
}

.rental-dashboard .movement-card__badge-wrap {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.4rem;
}

.rental-dashboard .movement-card__status--expired {
  color: var(--danger-text);
  background: color-mix(in srgb, var(--danger) 12%, var(--card));
  border: 1px solid color-mix(in srgb, var(--danger) 32%, transparent);
  border-radius: var(--r-btn, 6px);
  padding: 0.15rem 0.5rem;
}

.rental-dashboard .movement-card__tag {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.2rem 0.55rem;
  border: 1px solid var(--tag-edge, var(--border));
  border-radius: var(--r-btn, 8px);
  background: var(--tag-bg, var(--inset));
  color: var(--tag-ink, var(--text2));
  font-size: var(--t-th);
  font-weight: 600;
  line-height: 1.3;
}

.rental-dashboard .movement-card__tag--todo {
  --tag-bg: color-mix(in srgb, var(--warn) 12%, var(--card));
  --tag-edge: color-mix(in srgb, var(--warn) 35%, transparent);
  --tag-ink: var(--warn-text);
}

.rental-dashboard .movement-card__tag--ready {
  --tag-bg: color-mix(in srgb, var(--success) 12%, var(--card));
  --tag-edge: color-mix(in srgb, var(--success) 35%, transparent);
  --tag-ink: var(--success-text);
}

.rental-dashboard .movement-card__tag--due {
  --tag-bg: var(--select-bg);
  --tag-edge: var(--select-bg);
  --tag-ink: var(--select-fg);
}

/* Dispatch date control, smaller (8 Oct 2026): no "Sync dispatch day:" label,
   one picker door (the date), "Today" only when away from today. The date
   reads as a day name over BS · AD so the eye lands on "Today"/"Tomorrow". */
.rental-dashboard .dashboard-master-date-control {
  gap: 0.1rem;
  padding: 2px;
  background: var(--card);
  box-shadow: var(--shadow-xs);
}

.rental-dashboard .dashboard-master-date-control__date-btn {
  gap: 0.55rem;
  padding: 0.2rem 0.75rem;
  text-align: left;
  font-weight: 500;
}

.rental-dashboard .dashboard-master-date-control__cal {
  flex-shrink: 0;
  color: var(--primary-text);
}

.rental-dashboard .dashboard-master-date-control__text {
  display: flex;
  flex-direction: column;
  min-width: 0;
  line-height: 1.2;
}

.rental-dashboard .dashboard-master-date-control__primary {
  font-size: var(--t-meta);
  font-weight: 700;
  color: var(--text);
}

.rental-dashboard .dashboard-master-date-control__date-btn.is-today .dashboard-master-date-control__primary {
  color: var(--primary-text);
}

.rental-dashboard .dashboard-master-date-control__secondary {
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: var(--t-caption, 11px);
  font-weight: 500;
  color: var(--muted);
}

.rental-dashboard .dashboard-day-pager__btn--today {
  padding-inline: 0.75rem;
  font-size: var(--t-meta);
  font-weight: 600;
  color: var(--primary-text);
}

@keyframes today-row-in {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: none; }
}

/* RULING 2026-10-13: full dates and floor actions must remain readable on phone/iPad. */
.rental-dashboard .movement-card__schedule strong {
  max-width: 100%;
  white-space: normal;
  overflow-wrap: anywhere;
}

@media (max-width: 1279px) {
  .rental-dashboard .rental-dashboard__panels {
    grid-template-columns: minmax(0, 1fr);
  }
  .rental-dashboard .rental-dashboard__panels .movement-panel,
  .rental-dashboard .movement-panel--outgoing,
  .rental-dashboard .movement-panel--incoming {
    grid-column: 1;
    width: 100%;
  }
  .rental-dashboard .dashboard-situational-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
  .rental-dashboard .rental-dashboard__panels .movement-card {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "client booking"
      "pickup pickup"
      "return return"
      "status status";
  }
  /* The status below already states overdue duration, without duplicating a narrow rail. */
  .rental-dashboard .movement-card__when { display: none; }
  .rental-dashboard .movement-card__client { white-space: normal; overflow-wrap: anywhere; }
  .rental-dashboard .movement-card__schedule {
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    text-align: left;
  }
  .rental-dashboard .movement-card__schedule strong { text-align: right; }
  .rental-dashboard .movement-card__status-action { flex-direction: column; align-items: stretch; gap: 8px; }
  .rental-dashboard .movement-card__cta-btn { width: 100%; justify-content: center; }
}

@media (max-width: 767px) {
  .rental-dashboard .dashboard-situational-grid {
    grid-template-columns: 1fr !important;
  }
  .rental-dashboard .dashboard-mobile-nav {
    margin-bottom: var(--sp-md, 12px);
  }
  .rental-dashboard .dashboard-master-date-control__date-btn { padding-inline: 4px; gap: 4px; }
  .rental-dashboard .dashboard-master-date-control__cal { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  .rental-dashboard .movement-card { animation: none; }
  .rental-dashboard .movement-card__cta-btn:hover svg,
  .rental-dashboard .movement-card__cta-btn:active { transform: none; }
}

/* RULING 2026-10-15: the dashboard date picker is one compact neutral outline button (same as Operations). */
.rental-dashboard .dashboard-master-date-control {
  display: inline-flex;
  padding: 0;
  gap: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
}
.rental-dashboard .dashboard-master-date-control__date-btn {
  min-width: 0;
  min-height: 44px;
  padding: 0 12px;
  gap: 6px;
  border: 1px solid var(--input-border);
  border-radius: var(--r-btn, 8px);
  background: transparent;
  color: var(--text2);
  font-size: var(--t-meta);
  font-weight: 600;
}
.rental-dashboard .dashboard-master-date-control__date-btn:hover,
.rental-dashboard .dashboard-master-date-control__date-btn[aria-expanded='true'] {
  background: var(--hover-card);
  color: var(--text);
}
.rental-dashboard .dashboard-master-date-control__date-btn .dashboard-master-date-control__primary,
.rental-dashboard .dashboard-master-date-control__date-btn .dashboard-master-date-control__cal {
  color: inherit;
  font-size: var(--t-meta);
  font-weight: 600;
}

/* Situational awareness cards */
.rental-dashboard .dashboard-situational-card {
  transition: transform var(--dur-fast, 120ms) var(--ease), box-shadow var(--dur-fast, 120ms) var(--ease), border-color var(--dur-fast, 120ms) var(--ease);
}
.rental-dashboard .dashboard-situational-card:hover {
  border-color: var(--border2);
  box-shadow: var(--shadow-md), var(--specular-rim);
}
