    importCsv,
  } = useEquipmentContext()

  return (
    <SectionCard
            id="sec-stock"
            n={sectionNumber('sec-stock')}
            title="Stock & Units"
            note={/* One Tracking field — it replaces Equipment Type, Has Serial Number and Tracking Type (§5.1). */ "One Tracking field — it replaces Equipment Type, Has Serial Number and Tracking Type."}
            action={
              serialised ? (
                <>
                  <Button variant="ghost" onClick={() => csvInput.current?.click()} icon="upload">
                    Import CSV
                  </Button>
                  <Button variant="ghost" onClick={generateAssetTags}>
                    Generate Asset Tags
                  </Button>
                  <Button variant="secondary" icon="plus" onClick={addUnit}>
                    Add Unit
                  </Button>
                </>
              ) : undefined
            }
          >
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(210px, 1fr))', gap: 10 }}>
              {TRACKING_MODES.map((t) => {
                const on = tracking === t.mode
                return (
                  <button
                    key={t.mode}
