  border-radius: var(--r-btn, 8px);
  font-size: var(--t-ui);
  font-weight: 700;
  white-space: nowrap;
  cursor: pointer;
  border: 1px solid transparent;
  transition: background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), filter var(--dur-fast) var(--ease);
}

.movement-card__cta-btn.is-dominant {
  background: var(--btn-primary-bg);
  color: var(--btn-primary-fg);
  border: 1px solid transparent;
  box-shadow: 0 2px 6px color-mix(in srgb, var(--primary) 25%, transparent);
}

.movement-card__cta-btn.is-dominant:hover {
