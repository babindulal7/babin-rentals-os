  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.08);
}

.calendar-timeline-bar-btn.is-selected {
  box-shadow: 0 0 0 2px var(--card), 0 0 0 4px var(--nav-active-accent);
  z-index: 10;
}

/* ── Day Job Row (Agenda & Sheet) ───────────────────────────────────────── */
.calendar-agenda-item {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-sm, 10px);
  width: 100%;
  min-height: 44px;
  padding: 10px 12px;
  border-radius: var(--r-sm, 8px);
  border: 1px solid var(--border);
  background: var(--card2);
  text-align: left;
  font-family: inherit;
  transition: all var(--dur-fast, 150ms) var(--ease);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
}

button.calendar-agenda-item {
  cursor: pointer;
}

button.calendar-agenda-item:hover {
  background: var(--card);
  border-color: var(--border2, var(--border));
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
}

/* ── Stepper Buttons (44x44px min tap target) ───────────────────────────── */
.calendar-stepper-btn {
  width: var(--tap, 44px);
  height: var(--tap, 44px);
  min-width: 44px;
  min-height: 44px;
  display: grid;
  place-items: center;
  border-radius: var(--r-btn, 8px);
  border: 1px solid var(--btn-secondary-border, var(--border));
  background: var(--btn-secondary-bg, var(--card));
  color: var(--text);
  cursor: pointer;
  font-family: inherit;
  transition: all var(--dur-fast, 150ms) var(--ease);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
}

.calendar-stepper-btn:hover:not(:disabled) {
  background: var(--hover-card, var(--card2));
  border-color: var(--border2, var(--border));
  color: var(--text);
}

.calendar-stepper-btn:disabled {
  color: var(--disabled);
  border-style: dashed;
  cursor: not-allowed;
  opacity: 0.6;
}

/* ── Mini Month Day Button (Rail) ───────────────────────────────────────── */
.calendar-mini-day {
  position: relative;
  min-height: 44px;
  border-radius: var(--r-badge, 9999px);
  border: none;
  background: transparent;
  color: var(--text);
  font-size: var(--t-th, 11px);
  font-weight: 500;
  font-family: var(--font-id, 'Source Sans 3', sans-serif);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
  cursor: pointer;
  display: grid;
  place-items: center;
  transition: all var(--dur-fast, 120ms) var(--ease);
}

.calendar-mini-day:hover:not(.is-today) {
  background: var(--hover-card, rgba(0, 0, 0, 0.04));
  color: var(--text);
}

.calendar-mini-day.is-today {
  background: var(--nav-active-accent);
  color: var(--app);
  font-weight: 700;
}

.calendar-mini-day.is-weekend {
  color: var(--danger-text);
}
