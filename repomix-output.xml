<file path="src/actions/rentals/releaseBookingLineUnit.ts">
import { createAction, type ActionConfig, type ActionContext } from '../core'
import { EVENT_TYPES } from '../../events/eventBus'
import { safeUpdate } from '../../lib/dataAccess'

/**
 * # RELEASE_BOOKING_LINE_UNIT — the serial chip's ×, §4.39 ruled option (a)
 *
 * A creation-time unit assignment ends by RELEASE, never by delete: 0044's Law
 * 3 backstop rejects DELETE on `booking_line_units` for every role including
 * Owner (verified live 31 Aug 2026), and migration 0076 gives the row the
 * `released_at`/`released_by` pair instead — the row stays, marked ended, the
 * same shape `inventory_reservations` has always used for its holds.
 *
 * ## The capability — `unit.release`, mirrored not invented
 *
 * §4.20's ruled method: the RLS policy on the table this action writes.
 * `booking_line_units_all` (0024, confirmed against pg_policies 31 Aug 2026):
 *
 *     using     (auth_user_role() in ('Owner','Admin','Manager','Coordinator','Warehouse'))
 *     with check(auth_user_role() in ('Owner','Admin','Manager','Coordinator','Warehouse'))
 *
 * — exactly `rbac.canWriteBookingDesk`'s BOOKING_DESK set, the same mapping
 * `note.create` uses for the same five roles.
 *
 * ## The confirm-past-Packed guard is the SCREEN's, on purpose
 *
 * v2.5 §10.4 rules a confirmation when the booking is past Packed. A
 * confirmation is consent UX — it belongs where the operator is, and putting a
 * stage refusal here instead would turn "are you sure" into "you may not",
 * which is a different (unruled) rule. The action stays stage-blind; the
 * database stays the arbiter of what a released row may do next (0076's
 * freeze trigger).
 *
 * ## Failure shapes worth naming
 *
 *  - **Column absent** (0076 not applied yet): the update fails with 42703 —
 *    surfaced verbatim as "not saved", because it wasn't. Mock mode carries
 *    the columns already, so the flow is drivable before the apply.
 *  - **Already released**: 0076's freeze trigger raises; translated to a
 *    sentence naming the earlier release rather than the trigger.
 *  - **Offline**: refused, not queued — same call as `addBookingNote`: a
 *    release the database has not confirmed must not disappear a chip.
 */

export type ReleaseBookingLineUnitInput = {
  /** `booking_line_units.id` — the assignment row, not the physical unit. */
  unitRowId: string
  /** The serial/tag the operator saw — only for the refusal sentences. */
  unitLabel?: string | undefined
  /** **Law 8** — minted where the × was pressed, reused across retries. */
  clientUuid?: string | undefined
}

export type ReleaseBookingLineUnitResult = {
  unitRowId: string
  releasedAt: string
}

export const releaseBookingLineUnitConfig: ActionConfig<ReleaseBookingLineUnitInput, ReleaseBookingLineUnitResult> = {
  name: 'RELEASE_BOOKING_LINE_UNIT',
  permissions: ['unit.release'],

  /** `true` — writes `booking_line_units` through `safeUpdate` and verifies the
   *  row came back carrying the `released_at` Postgres accepted. */
  implemented: true,

  validate: (input) => {
    if (!input.unitRowId || input.unitRowId.trim() === '') {
      throw new Error('Nothing names the unit assignment to release, so nothing was changed.')
    }
    if (!input.clientUuid || input.clientUuid.trim() === '') {
      throw new Error('This release carries no idempotency key, so a retry could not be told from a second press. Nothing was sent.')
    }
  },

  execute: async (input, ctx: ActionContext) => {
    if (typeof navigator !== 'undefined' && navigator.onLine === false) {
      throw new Error(
        'This device is offline. The release was not queued — a chip must not disappear before the database confirms the assignment ended.',
      )
    }

    const label = input.unitLabel?.trim() || 'this unit'
    const releasedAt = new Date().toISOString()

    let updated
    try {
      updated = await safeUpdate(
        /* Absent from the hand-declared types/database.ts Update map for the
         * release pair — same cast, same reason, as addBookingNote's table. */
        'booking_line_units' as never,
        input.unitRowId,
        { released_at: releasedAt, released_by: ctx.userId } as never,
        input.clientUuid,
      )
    } catch (err) {
      const message = err instanceof Error ? err.message : String(err)
      if (message.includes('released at') || message.includes('is history')) {
        // 0076's freeze trigger — a second press, or a colleague got there first.
        throw new Error(`${label} was already released — the chip should clear on the next refresh. Nothing was changed twice.`)
      }
      if (message.includes('released_at') && (message.includes('does not exist') || message.includes('42703'))) {
        throw new Error(
          'The database does not carry the release columns yet (migration 0076 is drafted, not applied), so nothing was saved.',
        )
      }
      throw new Error(message)
    }

    /* Same persistence check as the other implemented actions: `safeUpdate`'s
     * offline/queue branches echo the payload back, so only trust a row that
     * carries what Postgres confirmed. The echoed payload and a real row both
     * carry `released_at` — the queue branch is already refused above by the
     * navigator check, and a mid-flight network failure returns the echo, which
     * is why the error field is checked before the shape. */
    if (updated.error) {
      throw new Error(
        `The release could not be confirmed against the database, so treat ${label} as still assigned: ${
          (updated.error as { message?: string }).message ?? String(updated.error)
        }`,
      )
    }
    const persisted = updated.data as unknown as { id?: string; released_at?: string } | null
    if (!persisted || typeof persisted.id !== 'string' || !persisted.released_at) {
      throw new Error(
        `The release was not confirmed as written, so treat ${label} as still assigned. Check the connection and try again.`,
      )
    }

    return {
      result: { unitRowId: input.unitRowId, releasedAt: persisted.released_at },
      events: [
        {
          type: EVENT_TYPES.UNIT_RELEASED,
          payload: { unitRowId: input.unitRowId, releasedAt: persisted.released_at, userId: ctx.userId },
        },
      ],
    }
  },
}

export const releaseBookingLineUnit = createAction(releaseBookingLineUnitConfig)
</file>

<file path="src/actions/rentals/reviewEvidence.ts">
import { createAction, type ActionContext, type ActionConfig } from '../core';
import { EVENT_TYPES } from '../../events/eventBus';
import { safeUpdate, generateClientUuid } from '../../lib/dataAccess';
import { supabase } from '../../lib/supabase';

export type ReviewEvidenceInput = {
  /** Target evidence_files.id (UUID), client_uuid, or original_filename */
  evidenceId: string;
  /** Action: approve/review or mark removed */
  action: 'review' | 'remove';
  /** Reason for removal or review note */
  reason?: string;
  /** Optional matched product unit ID */
  matchedItemId?: string;
  /** Optional matched serial number */
  matchedSerial?: string;
  /** Optional match state override */
  matchState?: 'Matched' | 'Need Review' | 'Unmatched';
  /** Law 8 client-side idempotency UUID */
  clientUuid?: string;
};

export type ReviewEvidenceResult = {
  success: boolean;
  evidenceId: string;
  action: 'review' | 'remove';
  matchState?: string;
  removedAt?: string | null;
};

export const reviewEvidenceConfig: ActionConfig<ReviewEvidenceInput, ReviewEvidenceResult> = {
  name: 'REVIEW_EVIDENCE',
  permissions: ['evidence.review'],
  implemented: true,

  validate: (input) => {
    if (!input.evidenceId || input.evidenceId.trim().length === 0) {
      throw new Error('Evidence ID is required.');
    }
    if (!input.action || (input.action !== 'review' && input.action !== 'remove')) {
      throw new Error('Action must be "review" or "remove".');
    }
  },

  execute: async (input, ctx: ActionContext) => {
    const rawTarget = input.evidenceId.trim();
    const isUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(rawTarget);

    const query = supabase
      .from('evidence_files')
      .select('id, match_state, original_filename, removed_at');

    const { data: evidence } = isUuid
      ? await query.or(`id.eq.${rawTarget},client_uuid.eq.${rawTarget}`).maybeSingle()
      : await query.eq('original_filename', rawTarget).maybeSingle();

    const evidenceId = evidence?.id || (isUuid ? rawTarget : null);
    if (!evidenceId) {
      throw new Error(`Evidence file "${rawTarget}" not found.`);
    }

    const now = new Date().toISOString();
    const actionUuid = input.clientUuid || generateClientUuid();
    const patch: Record<string, unknown> = {
      updated_at: now,
    };

    if (input.action === 'remove') {
      patch.removed_at = now;
      patch.removed_by = ctx.userId;
      patch.removal_reason = (input.reason && input.reason.trim()) || 'Removed during evidence review';
    } else {
      patch.processing_step = 'Human Review';
      if (input.matchState) {
        patch.match_state = input.matchState;
      } else if (input.matchedItemId || input.matchedSerial) {
        patch.match_state = 'Matched';
      }
      if (input.matchedItemId) {
        patch.matched_item_id = input.matchedItemId;
        patch.match_source = 'Manual match';
      }
      if (input.matchedSerial) {
        patch.matched_serial = input.matchedSerial;
        patch.match_source = 'Manual match';
      }
    }

    await safeUpdate('evidence_files' as never, evidenceId, patch as never, actionUuid, {
      returnRow: false,
    });

    const events = [
      {
        type: EVENT_TYPES.EVIDENCE_REVIEWED,
        payload: {
          evidenceId,
          action: input.action,
          reason: input.reason,
          matchState: patch.match_state,
          removedAt: patch.removed_at,
          timestamp: now,
          userId: ctx.userId,
        },
      },
    ];

    return {
      result: {
        success: true,
        evidenceId,
        action: input.action,
        ...(patch.match_state ? { matchState: patch.match_state as string } : {}),
        ...(patch.removed_at ? { removedAt: patch.removed_at as string } : {}),
      },
      events,
    };
  },
};

export const reviewEvidence = createAction<ReviewEvidenceInput, ReviewEvidenceResult>(reviewEvidenceConfig);
</file>

<file path="src/actions/rentals/saveDraft.ts">
import { createAction, type ActionConfig, type ActionContext } from '../core'
import { EVENT_TYPES } from '../../events/eventBus'
import { newClientUuid, supabase } from '../../lib/supabase'
import { safeUpdate } from '../../lib/dataAccess'

/** Complete, versioned snapshot owned by New Rental. */
export interface RentalDraftData {
  version: 1
  bookingNo?: string | undefined
  selectedClientId: string | null
  clientDbId: string | null
  clientName?: string | undefined
  project: string
  kind: string
  /** Custom project-type description; only meaningful when kind is 'Other'. */
  kindOther: string
  govId: string
  pickup: string
  pickupTime: string
  returnDate: string
  returnTime: string
  deliveryType: 'Client Pickup' | 'Babin Delivery'
  pickupLocation: string
  returnLocation: string
  specialInstructions: string
  lines: Array<{
    id: string
    bookingLineId?: string | undefined
    clientUuid?: string | undefined
    parentClientUuid?: string | null | undefined
    productId?: string | null | undefined
    bundleId?: string | null | undefined
    isIncluded?: boolean | undefined
    lineType?: 'Equipment' | 'Bundle' | 'Accessory' | 'Service' | 'Sub-rental' | 'Manual item' | undefined
    name: string
    serial: string
    category: string
    ratePaisa: number
    days: number
    daysOverridden?: boolean | undefined
    qty: number
    discountPct: number
    location: string
    status?: string | undefined
    committedTo: string
    bundleCode?: string | undefined
    bundleName?: string | undefined
    lineNote?: string | undefined
    serviceBasis?: 'Flat' | 'Per day' | undefined
    supplierCost?: number | undefined
  }>
  crew: Array<{
    crewId: string
    bookingCrewLineId?: string | undefined
    crewMemberId?: string | undefined
    days?: number | undefined
    name: string
    role: string
    phone: string
    dayRatePaisa: number
    overtimePaisa: number
    accommodationPaisa: number
    mealsPaisa: number
  }>
  deliveryChargePaisa: number
  fuelChargePaisa: number
  vehicle: string
  numberPlate: string
  driverContact: string
  returnPickupType?: 'Client Return' | 'Babin Pickup' | undefined
  returnPickupAddress?: string | undefined
  returnPickupTime?: string | undefined
  returnPickupChargePaisa?: number | undefined
  discountPct: number
  vatOn: boolean
  vatRatePercent: number
  advancePaisa: number
}

export interface RentalDraftRecord {
  id: string
  bookingNo: string
  clientUuid: string
  bookingClientUuid: string
  branchId: string
  data: RentalDraftData
  status: 'Active' | 'Converted' | 'Cancelled'
  convertedBookingId: string | null
  updatedAt: string
}

export type SaveDraftInput = {
  /** Existing `rental_drafts.id`; omit to create one. */
  id?: string
  /** Reused after an uncertain create response (Law 8). */
  clientUuid?: string
  /** Stable `create_booking` key retained by this draft through conversion. */
  bookingClientUuid?: string
  data?: RentalDraftData
  /** Existing floor-workspace compatibility: optional booking notes. */
  notes?: string | null
}

export type DurableSaveDraftResult = RentalDraftRecord & {
  success: true
  created: boolean
  savedAt: string
}

export type SaveDraftResult = DurableSaveDraftResult | {
  success: true
  bookingId: string
  bookingNo?: string
  savedAt: string
}

type DraftDbRow = {
  id: string
  client_uuid: string
  booking_client_uuid: string
  branch_id: string
  data: RentalDraftData
  status: RentalDraftRecord['status']
  converted_booking_id: string | null
  updated_at: string
}

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i

function toRecord(row: DraftDbRow): RentalDraftRecord {
  const bookingNo = row.data?.bookingNo ?? row.id.slice(0, 8)
  return {
    id: row.id,
    bookingNo,
    clientUuid: row.client_uuid,
    bookingClientUuid: row.booking_client_uuid,
    branchId: row.branch_id,
    data: {
      ...row.data,
      bookingNo,
    },
    status: row.status,
    convertedBookingId: row.converted_booking_id,
    updatedAt: row.updated_at,
  }
}

async function branchForUser(userId: string): Promise<string> {
  const { data, error } = await supabase.from('users').select('branch_id').eq('id', userId).maybeSingle()
  if (error) throw new Error(`the operating branch could not be read (${error.message})`)
  const branchId = (data as { branch_id?: string | null } | null)?.branch_id
  if (!branchId) throw new Error('your staff record carries no branch. Ask an Owner to set your branch first')
  return branchId
}

export const saveDraftConfig: ActionConfig<SaveDraftInput, SaveDraftResult> = {
  name: 'SAVE_DRAFT',
  permissions: ['rental.draft'],
  implemented: true,
  validate: (input) => {
    if (!input.data) {
      if (!input.id?.trim()) throw new Error('Booking ID is required.')
      return
    }
    if (input.id !== undefined && !UUID_RE.test(input.id)) throw new Error('Draft ID must be a UUID.')
    if (input.clientUuid !== undefined && !UUID_RE.test(input.clientUuid)) throw new Error('Draft idempotency key must be a UUID.')
    if (input.bookingClientUuid !== undefined && !UUID_RE.test(input.bookingClientUuid)) throw new Error('Booking idempotency key must be a UUID.')
    if (input.data.version !== 1) throw new Error('Unsupported rental draft version.')
  },
  execute: async (input, ctx: ActionContext) => {
    const now = new Date().toISOString()

    /* Existing floor workspaces use SAVE_DRAFT to touch an already-created
       booking. Keep that contract separate from New Rental's durable snapshot. */
    if (!input.data) {
      const rawId = input.id!.trim()
      let bookingId = rawId
      let bookingNo: string | undefined
      if (!UUID_RE.test(rawId)) {
        const { data, error } = await supabase.from('bookings').select('id, booking_no').eq('booking_no', rawId).maybeSingle()
        if (error || !data) throw new Error(`Could not resolve booking number ${rawId} to save draft: ${error?.message ?? 'no matching row'}`)
        bookingId = data.id
        bookingNo = data.booking_no
      }
      const patch: { updated_at: string; notes?: string | null } = { updated_at: now }
      if (input.notes !== undefined) patch.notes = input.notes
      await safeUpdate('bookings', bookingId, patch as never, input.clientUuid, { returnRow: false })
      return {
        result: { success: true, bookingId, ...(bookingNo ? { bookingNo } : {}), savedAt: now },
        events: [{ type: EVENT_TYPES.DRAFT_SAVED, payload: { id: bookingId, bookingNo, timestamp: now, userId: ctx.userId } }],
      }
    }

    let row: DraftDbRow | null = null
    let error: { message: string } | null = null
    const created = input.id === undefined

    if (input.id) {
      // Retain existing bookingNo if not provided in input.data
      let draftData = input.data
      if (!draftData.bookingNo) {
        const { data: existingDraft } = await supabase
          .from('rental_drafts')
          .select('data')
          .eq('id', input.id)
          .maybeSingle()
        const existingNo = (existingDraft as { data?: RentalDraftData } | null)?.data?.bookingNo
        if (existingNo) {
          draftData = { ...draftData, bookingNo: existingNo }
        }
      }

      const response = await supabase
        .from('rental_drafts')
        .update({ data: draftData, updated_at: now, updated_by: ctx.userId })
        .eq('id', input.id)
        .eq('status', 'Active')
        .select('id, client_uuid, booking_client_uuid, branch_id, data, status, converted_booking_id, updated_at')
        .maybeSingle()
      row = response.data as DraftDbRow | null
      error = response.error
      if (!error && !row) throw new Error('the draft was not found or is no longer editable')
    } else {
      const branchId = await branchForUser(ctx.userId)
      let bookingNo = input.data.bookingNo
      if (!bookingNo) {
        if (typeof (supabase as unknown as { rpc?: unknown }).rpc === 'function') {
          const { data: mintedNo, error: mintError } = await (supabase as unknown as { rpc: (name: string, args: Record<string, unknown>) => Promise<{ data: unknown; error: { message: string } | null }> }).rpc('next_document_number', {
            p_sequence_key: 'booking',
          })
          if (mintError || !mintedNo) {
            throw new Error(`the database could not allocate a booking number for the draft (${mintError?.message ?? 'no number returned'})`)
          }
          bookingNo = String(mintedNo)
        } else {
          bookingNo = '1052'
        }
      }
      const draftData = { ...input.data, bookingNo }
      const response = await supabase
        .from('rental_drafts')
        .upsert(
          {
            client_uuid: input.clientUuid ?? newClientUuid(),
            booking_client_uuid: input.bookingClientUuid ?? newClientUuid(),
            branch_id: branchId,
            data: draftData,
            status: 'Active',
            created_by: ctx.userId,
            updated_by: ctx.userId,
            updated_at: now,
          },
          { onConflict: 'client_uuid' },
        )
        .select('id, client_uuid, booking_client_uuid, branch_id, data, status, converted_booking_id, updated_at')
        .single()
      row = response.data as DraftDbRow | null
      error = response.error
    }

    if (error) throw new Error(`the database rejected the draft (${error.message})`)
    if (!row || !UUID_RE.test(row.id) || row.status !== 'Active') {
      throw new Error('the database returned no active draft after the write; treat it as not saved')
    }
    const record = toRecord(row)
    return {
      result: { ...record, success: true, created, savedAt: row.updated_at },
      events: [{ type: EVENT_TYPES.DRAFT_SAVED, payload: { id: row.id, bookingNo: record.bookingNo, timestamp: row.updated_at, userId: ctx.userId } }],
    }
  },
}

export const saveDraft = createAction<SaveDraftInput, SaveDraftResult>(saveDraftConfig)

/** Read path used when `?draft=<uuid>` or booking number is opened or refreshed. RLS is authoritative. */
export async function fetchRentalDraft(id: string): Promise<RentalDraftRecord> {
  const rawId = id.trim()
  let query = supabase
    .from('rental_drafts')
    .select('id, client_uuid, booking_client_uuid, branch_id, data, status, converted_booking_id, updated_at')
  if (UUID_RE.test(rawId)) {
    query = query.eq('id', rawId)
  } else {
    query = query.eq('data->>bookingNo', rawId)
  }
  const { data, error } = await query.maybeSingle()
  if (error) throw new Error(`the draft could not be loaded (${error.message})`)
  if (!data) throw new Error('the draft was not found or your role cannot read it')
  return toRecord(data as unknown as DraftDbRow)
}

/** Lists active drafts for display in RentalsList. */
export async function listActiveDrafts(branchId?: string): Promise<RentalDraftRecord[]> {
  let query = supabase
    .from('rental_drafts')
    .select('id, client_uuid, booking_client_uuid, branch_id, data, status, converted_booking_id, updated_at')
    .eq('status', 'Active')
    .order('updated_at', { ascending: false })
  if (branchId) {
    query = query.eq('branch_id', branchId)
  }
  const { data, error } = await query
  if (error) throw new Error(`could not list rental drafts: ${error.message}`)
  return (data as unknown as DraftDbRow[] ?? []).map(toRecord)
}

export type ConvertDraftInput = { id: string; bookingId: string }

export const convertDraftConfig: ActionConfig<ConvertDraftInput, RentalDraftRecord> = {
  name: 'CONVERT_RENTAL_DRAFT',
  permissions: ['rental.create'],
  implemented: true,
  validate: (input) => {
    if (!UUID_RE.test(input.id)) throw new Error('Draft ID must be a UUID.')
    if (!UUID_RE.test(input.bookingId)) throw new Error('Booking ID must be a UUID.')
  },
  execute: async (input, ctx) => {
    const draft = await fetchRentalDraft(input.id)
    if (draft.status === 'Converted' && draft.convertedBookingId === input.bookingId) {
      return { result: draft, events: [] }
    }
    if (draft.status !== 'Active') throw new Error('the draft is no longer active')

    const { data: booking, error: bookingError } = await supabase
      .from('bookings')
      .select('id, client_uuid, stage')
      .eq('id', input.bookingId)
      .maybeSingle()
    if (bookingError) throw new Error(`the confirmed booking could not be checked (${bookingError.message})`)
    if (!booking || booking.stage !== 'Booked') {
      throw new Error('the draft can only be converted after its booking reaches Booked')
    }
    if (booking.client_uuid !== draft.bookingClientUuid) {
      throw new Error('the booking was not created from this draft; the draft was left active')
    }

    const now = new Date().toISOString()
    const { data, error } = await supabase
      .from('rental_drafts')
      .update({ status: 'Converted', converted_booking_id: input.bookingId, updated_at: now, updated_by: ctx.userId })
      .eq('id', input.id)
      .eq('status', 'Active')
      .select('id, client_uuid, booking_client_uuid, branch_id, data, status, converted_booking_id, updated_at')
      .maybeSingle()
    if (error) throw new Error(`the draft-to-booking link failed (${error.message})`)
    if (!data) throw new Error('the draft was not active, so it was not linked to this booking')
    return { result: toRecord(data as unknown as DraftDbRow), events: [] }
  },
}

export const convertDraft = createAction<ConvertDraftInput, RentalDraftRecord>(convertDraftConfig)

export const cancelDraftConfig: ActionConfig<{ id: string; reason: string }, { success: true }> = {
  name: 'CANCEL_RENTAL_DRAFT',
  permissions: ['rental.cancel'],
  implemented: true,
  validate: ({ id, reason }) => {
    if (!UUID_RE.test(id)) throw new Error('Draft ID must be a UUID.')
    if (!reason.trim()) throw new Error('A cancellation reason is required.')
  },
  execute: async ({ id, reason }, ctx) => {
    const now = new Date().toISOString()
    const { data, error } = await supabase
      .from('rental_drafts')
      .update({ status: 'Cancelled', cancelled_at: now, cancelled_by: ctx.userId, cancellation_reason: reason.trim(), updated_at: now, updated_by: ctx.userId })
      .eq('id', id)
      .eq('status', 'Active')
      .select('id')
      .maybeSingle()
    if (error) throw new Error(`the draft could not be cancelled (${error.message})`)
    if (!data) throw new Error('the draft was not found or is no longer active')
    return { result: { success: true }, events: [] }
  },
}

export const cancelDraft = createAction(cancelDraftConfig)
</file>

<file path="src/actions/rentals/startReturn.ts">
import { createAction, type ActionContext, type ActionConfig } from '../core';
import { EVENT_TYPES } from '../../events/eventBus';
import { idempotentInsert, generateClientUuid } from '../../lib/dataAccess';
import { supabase } from '../../lib/supabase';

export type StartReturnInput = {
  /** Target booking ID (UUID) or booking_no */
  id: string;
  /** Optional session notes */
  notes?: string;
  /** Law 8 client-side idempotency UUID */
  clientUuid?: string;
};

export type StartReturnResult = {
  success: boolean;
  sessionId: string;
  bookingId: string;
  bookingNo: string;
  sessionNo: number;
};

export const startReturnConfig: ActionConfig<StartReturnInput, StartReturnResult> = {
  name: 'START_RETURN',
  permissions: ['rental.return'],
  implemented: true,

  validate: (input) => {
    if (!input.id || input.id.trim().length === 0) {
      throw new Error('Booking ID or booking number is required to start return.');
    }
  },

  execute: async (input, ctx: ActionContext) => {
    const rawTarget = input.id.trim();
    const isUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(rawTarget);

    const query = supabase
      .from('bookings')
      .select('id, booking_no, stage');

    const { data: booking } = isUuid
      ? await query.or(`id.eq.${rawTarget},booking_no.eq.${rawTarget}`).maybeSingle()
      : await query.eq('booking_no', rawTarget).maybeSingle();

    if (!booking) {
      throw new Error(`Booking "${rawTarget}" not found.`);
    }

    // Check if an In Progress return session already exists for this booking
    const { data: existingSession } = await supabase
      .from('operation_sessions')
      .select('id, session_no, state')
      .eq('booking_id', booking.id)
      .eq('operation', 'Return')
      .eq('state', 'In Progress')
      .maybeSingle();

    const now = new Date().toISOString();
    let sessionId: string;
    let sessionNo: number;

    if (existingSession) {
      sessionId = existingSession.id;
      sessionNo = existingSession.session_no;
    } else {
      // Find the highest session_no for this booking
      const { data: lastSession } = await supabase
        .from('operation_sessions')
        .select('session_no')
        .eq('booking_id', booking.id)
        .order('session_no', { ascending: false })
        .limit(1)
        .maybeSingle();

      sessionNo = (lastSession?.session_no ?? 0) + 1;
      const actionUuid = input.clientUuid || generateClientUuid();

      const newSession = {
        client_uuid: actionUuid,
        booking_id: booking.id,
        session_no: sessionNo,
        operation: 'Return',
        state: 'In Progress',
        notes: input.notes?.trim() || null,
        started_at: now,
        created_by: ctx.userId,
      };

      const inserted = await idempotentInsert('operation_sessions' as never, newSession as never, {
        returnRow: false,
      });

      sessionId = (inserted as { id?: string })?.id || actionUuid;
    }

    const events = [
      {
        type: EVENT_TYPES.RENTAL_RETURN_STARTED,
        payload: {
          id: booking.id,
          bookingNo: booking.booking_no,
          sessionId,
          sessionNo,
          timestamp: now,
          userId: ctx.userId,
        },
      },
    ];

    return {
      result: {
        success: true,
        sessionId,
        bookingId: booking.id,
        bookingNo: booking.booking_no,
        sessionNo,
      },
      events,
    };
  },
};

export const startReturn = createAction<StartReturnInput, StartReturnResult>(startReturnConfig);
</file>

<file path="src/actions/rentals/updateBookingProject.ts">
import { createAction, type ActionConfig, type ActionContext } from '../core'
import { EVENT_TYPES } from '../../events/eventBus'
import { supabase } from '../../lib/supabase'
import { newClientUuid } from '../../lib/supabase'
import { safeUpdate } from '../../lib/dataAccess'
import { logAuditEvent } from '../../lib/audit'
import { validateProjectType } from '../../lib/projectTypes'
import { parseBookingNoSearch } from '../../lib/format'

export type UpdateBookingProjectInput = {
  /** Booking uuid or `B-` number. */
  id: string
  /** **Law 8.** Minted where the operator pressed Save; reused on retry. */
  clientUuid?: string
  /** Controlled value (`src/lib/projectTypes.ts`); null clears back to unset. */
  projectType: string | null
  /** Custom text; only with 'Other'. */
  projectTypeOther?: string | null
}

export type UpdateBookingProjectResult = {
  success: true
  bookingId: string
  bookingNo: string
  projectType: string | null
  projectTypeOther: string | null
  /** True when nothing differed and no write or audit row was produced. */
  unchanged: boolean
}

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i

/**
 * # UPDATE_BOOKING_PROJECT — the narrow project-type edit
 *
 * The ONLY header-field writer besides `create_booking` (R-43) and the stage
 * engine. BookingDetail's general Edit stays Unavailable-with-reason: this
 * action writes exactly two non-money, non-custodial columns
 * (`project_type`, `project_type_other`) through `safeUpdate`, which every
 * role in `bookings_update` may call at the row — the UI offers the control
 * to Coordinator+ only (floor roles view the type; spec §24), and UI ⊆ DB
 * holds because the UI grants less than the database.
 *
 * Capability `rental.update_project` mirrors `bookings_update` (0018, restated
 * 0018): Owner · Admin · Manager · Coordinator · Warehouse — the desk five via
 * `rbac.canWriteBookingDesk`, same as `rental.extend`. The 0102 money-blind
 * trigger guards numeric money columns only; text project fields pass it.
 *
 * Offline: queueable (non-custodial metadata, like a draft save — R-40's
 * fail-closed rule covers custody transitions, not this). Rollback: the
 * caller renders from the returned row; a throw means nothing changed, so the
 * screen keeps the old value with the inline error (§42).
 */
export const updateBookingProjectConfig: ActionConfig<UpdateBookingProjectInput, UpdateBookingProjectResult> = {
  name: 'UPDATE_BOOKING_PROJECT',
  permissions: ['rental.update_project'],
  implemented: true,

  validate: (input) => {
    if (!input.id || input.id.trim() === '') {
      throw new Error('A booking reference is required — pass the booking uuid or its B- number. Nothing was sent.')
    }
    if (input.clientUuid !== undefined && input.clientUuid.trim() === '') {
      throw new Error(
        'The idempotency key is present but empty. Pass the key minted where the operator pressed Save, ' +
          'or omit it — an empty string is neither. Nothing was sent.',
      )
    }
    const check = validateProjectType(input.projectType, input.projectTypeOther)
    if (!check.valid) {
      throw new Error(`${check.message ?? 'Select a project type from the list.'} Nothing was sent.`)
    }
  },

  execute: async (input, ctx: ActionContext) => {
    const isUuid = UUID_RE.test(input.id)
    const column = isUuid ? 'id' : 'booking_no'
    const target = isUuid ? input.id : parseBookingNoSearch(input.id)
    const { data, error } = await supabase
      .from('bookings')
      .select('id, booking_no, branch_id, project_type, project_type_other')
      .eq(column, target)
      .maybeSingle()
    if (error) throw new Error(`Could not read the booking, so its project type was not changed: ${error.message}`)
    if (!data) throw new Error(`No booking matches ${input.id}. Nothing was changed.`)

    const current = data as unknown as {
      id: string
      booking_no: string
      branch_id: string
      project_type: string | null
      project_type_other: string | null
    }
    const nextType = input.projectType?.trim() ? input.projectType.trim() : null
    const nextOther = nextType === 'Other' && input.projectTypeOther?.trim() ? input.projectTypeOther.trim() : null

    if (current.project_type === nextType && (current.project_type_other ?? null) === nextOther) {
      return {
        result: {
          success: true as const,
          bookingId: current.id,
          bookingNo: current.booking_no,
          projectType: current.project_type,
          projectTypeOther: current.project_type_other,
          unchanged: true,
        },
        /* Nothing changed, so nothing is announced — the createRental replay
           rule applied to edits. */
        events: [],
      }
    }

    const key = input.clientUuid ?? newClientUuid()
    /* `safeUpdate` throws on failure (Law 12's inline error comes from that
       throw) — there is no error return to branch on. */
    const updated = await safeUpdate(
      'bookings',
      current.id,
      { project_type: nextType, project_type_other: nextOther },
      key,
    )

    /* Audit (spec §43) — old and new, who and when. This is a metadata edit;
       'status change' is the closest enum member; engine defaults to it anyway. */
    const audit = await logAuditEvent({
      eventClass: 'status change',
      category: 'Rentals',
      module: 'Rentals',
      action: 'Update',
      severity: 'Informational',
      tableName: 'bookings',
      recordId: current.id,
      actorId: ctx.userId,
      actorRole: ctx.role,
      branchId: current.branch_id,
      oldValues: { project_type: current.project_type, project_type_other: current.project_type_other },
      newValues: { project_type: nextType, project_type_other: nextOther },
      reason: `Project type changed ${current.project_type ?? '—'} → ${nextType ?? '—'}`,
    })
    if (!audit.ok) {
      console.error(`[updateBookingProject] ${current.booking_no} saved with NO audit row.`, audit.error)
    }

    const row = (updated.data ?? {}) as { project_type?: string | null; project_type_other?: string | null }
    const result: UpdateBookingProjectResult = {
      success: true as const,
      bookingId: current.id,
      bookingNo: current.booking_no,
      projectType: row.project_type ?? nextType,
      projectTypeOther: row.project_type_other ?? nextOther,
      unchanged: false,
    }
    return {
      result,
      events: [
        {
          type: EVENT_TYPES.RENTAL_PROJECT_UPDATED,
          payload: {
            bookingId: current.id,
            bookingNo: current.booking_no,
            branchId: current.branch_id,
            from: { project_type: current.project_type, project_type_other: current.project_type_other },
            to: { project_type: result.projectType, project_type_other: result.projectTypeOther },
            clientUuid: key,
            userId: ctx.userId,
          },
        },
      ],
    }
  },
}

export const updateBookingProject = createAction(updateBookingProjectConfig)
</file>

