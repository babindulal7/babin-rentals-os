                      alignItems: 'center',
                      gap: 'var(--sp-sm)',
                      minHeight: 44,
                      padding: '0 14px',
                      borderRadius: 'var(--r-btn)',
                      border: `1px solid ${on ? 'var(--nav-active-accent)' : 'var(--border)'}`,
                      background: on ? 'var(--select-bg)' : 'var(--card)',
