  align-items: center;
  gap: 3px;
  flex-wrap: wrap;
  margin-top: auto;
}

.calendar-dot {
  width: 7px;
  height: 7px;
  border-radius: var(--r-badge, 9999px);
  transition: opacity var(--dur-fast, 150ms) var(--ease);
}

