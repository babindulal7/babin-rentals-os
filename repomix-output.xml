/* ── the draft ─────────────────────────────────────────────────────────── */

/** §6.3 — percentage **or** fixed amount, never both. Switching clears the other. */
export type DiscountKind = 'pct' | 'fixed'

export interface DraftLine {
  key: string
  modelId: string
  /** §8.1 — `requiredQty`. */
  qty: number
  /**
   * §7.4 — *"Original rates are **stored on the line** at creation."* An
   * inventory rate change must never silently restate an advertised saving; it
   * raises the drift banner instead, and the operator chooses to refresh.
   */
  originalRatePaisa: Paisa
  discountKind: DiscountKind
  /** Percent of the original rate. Percentages stay numeric — `lib/money` §2.3. */
  discountPct: number
  discountFixedPaisa: Paisa
  /** §5.3 — model ids priced **inside** this line, at Rs 0 of their own. */
  childIds: string[]
  /** Foundation §9 — a discount above 10% carries a reason and an approver. */
  discountReason: string
  approvedBy: string | null
}

export interface CrewPick {
  role: CrewRole
  headcount: number
}

/**
 * The ten lines the render's Bundle Items table shows — **corrected by §5.3**.
 *
 * The render gives the FX3 line 5 children (Top Handle, Battery, Charger, USB-C,
 * Cage) while Battery and Battery Charger appear *again* as independent lines
 * with their own quantities and rates: *"That battery is in the bundle twice,
 * priced twice, and counted twice in availability."* Here they are promoted —
 * they are lines, so they are no longer children, and the FX3 line reads 3.
 *
 * §7.2's arithmetic against these ten lines: Σ original×qty **Rs 26,100**,
 * Σ discounts **Rs 2,320**, Σ bundle×qty **Rs 23,780**. Every one of the three
 * is now computed by `pricingOf`, so the panel cannot recite Rs 22,500 / 4,500 /
 * 18,000 at them again.
 */
export const INITIAL_LINES: DraftLine[] = [
  line('L1', 'M-FX3-BODY', 1, 'pct', 10, 0, ['M-FX3-HANDLE', 'M-USBC', 'M-SR-CAGE']),
  line('L2', 'M-NISI-35', 1, 'fixed', 0, 400),
  line('L3', 'M-NISI-50', 1, 'fixed', 0, 400),
  line('L4', 'M-NISI-85', 1, 'fixed', 0, 400),
  line('L5', 'M-FZ100', 4, 'pct', 0, 0),
  line('L6', 'M-FZ100-CHG', 1, 'pct', 0, 0),
  line('L7', 'M-MAN-504X', 1, 'pct', 10, 0),
  line('L8', 'M-PK-BM5', 1, 'fixed', 0, 200),
  line('L9', 'M-CASE-1610', 1, 'pct', 0, 0),
  line('L10', 'M-BAG-ACC', 1, 'pct', 0, 0),
]

function line(
  key: string,
  modelId: string,
  qty: number,
  discountKind: DiscountKind,
  pct: number,
  fixedRupees: number,
  childIds: string[] = [],
): DraftLine {
  const m = MODEL_BY_ID.get(modelId)
  return {
    key,
    modelId,
    qty,
    originalRatePaisa: m ? m.unitRatePaisa : (0 as Paisa),
    discountKind,
    discountPct: pct,
    discountFixedPaisa: rupees(fixedRupees),
    childIds,
    discountReason: '',
    approvedBy: null,
  }
}

/** §10 — the render's rail counts 1 crew and 1 vehicle; here they are real picks. */
export const INITIAL_CREW: CrewPick[] = [{ role: 'Camera Assistant', headcount: 1 }]
export const INITIAL_VEHICLE: VehicleType | null = 'Pickup Van'

/* ── derivation — every figure the screen prints comes from here ────────── */

/**
 * §6.3 — one discount or the other, and the result may never fall below Rs 0.
 */
export function bundleRateOf(l: DraftLine): Paisa {
  const cut =
    l.discountKind === 'pct'
      ? roundHalfUp(l.originalRatePaisa * (l.discountPct / 100))
      : l.discountFixedPaisa
  return Math.max(0, l.originalRatePaisa - cut) as Paisa
}

export interface LineTotals {
  originalTotal: Paisa
  bundleRate: Paisa
  /** §6.2 — `Line Total = Bundle Rate × Required Qty`. */
  lineTotal: Paisa
  discountTotal: Paisa
  /** Effective percentage off, whichever way the discount was entered. */
  discountPct: number
}

export function totalsOf(l: DraftLine): LineTotals {
  const bundleRate = bundleRateOf(l)
  const originalTotal = (l.originalRatePaisa * l.qty) as Paisa
  const lineTotal = (bundleRate * l.qty) as Paisa
  const discountTotal = (originalTotal - lineTotal) as Paisa
  const discountPct =
    l.originalRatePaisa === 0 ? 0 : roundHalfUp(((l.originalRatePaisa - bundleRate) / l.originalRatePaisa) * 100)
  return { originalTotal, bundleRate, lineTotal, discountTotal, discountPct }
}

export interface Pricing {
  sumOfPartsPaisa: Paisa
  discountsPaisa: Paisa
  computedRatePaisa: Paisa
  savingPct: number
}

/** §7.1, verbatim. Nothing below is stored. */
export function pricingOf(lines: DraftLine[]): Pricing {
  let sum = 0
  let bundle = 0
  for (const l of lines) {
    const t = totalsOf(l)
    sum += t.originalTotal
    bundle += t.lineTotal
  }
  const discounts = sum - bundle
  return {
    sumOfPartsPaisa: sum as Paisa,
    discountsPaisa: discounts as Paisa,
    computedRatePaisa: bundle as Paisa,
    savingPct: sum === 0 ? 0 : roundHalfUp((discounts / sum) * 100),
  }
}

/** Why a short line is short — drives both the donut and the blocked list. */
export type BlockedBy = 'Reserved' | 'On Rent' | 'On Maintenance'

export interface BlockedLine {
  key: string
  model: InventoryModel
  /** §8.3 — `Short by 1`. */
  short: number
  by: BlockedBy
  freesAd: Date | undefined
}

export interface Availability {
  readyItems: number
  totalItems: number
  blockedItems: number
  blocked: BlockedLine[]
  /** §8.2 — the donut and the summary read this one array. */
  segments: Array<{ label: 'Ready' | 'Reserved' | 'On Rent' | 'On Maintenance'; value: number }>
  /** The latest return date across the blocked lines — `null` when nothing is short. */
  readyAd: Date | null
}

/**
 * §8.1 — *"A line is blocked only when it has fewer available units than it
 * requires."* The build flagged NISI Athena 35mm while it held 2 of 3 units free
 * against a required quantity of 1: it was measuring units *not available*
 * instead of units *short*.
 */
/**
 * The model lookup these derivations resolve a line against.
 *
 * It defaults to `MODEL_BY_ID`, the SEED catalogue, which is what every caller
 * used until 7 Sep. Add Bundle now passes a map built from `products` instead,
 * because `bundle_items.product_id` is a uuid FK and 19 of the 20 seed model
 * names match no row — so a line keyed on a seed id could never be saved.
 *
 * The parameter exists rather than a module swap because a miss here is
 * SILENT: every one of these functions does `lookup.get(...)` and skips the
 * line. Put a real product uuid in `DraftLine.modelId` while these still read
 * the seed map and the screen empties itself — no error, no line, a 0/0 donut
 * and a Create button that goes Unavailable.
 */
export type ModelLookup = ReadonlyMap<string, InventoryModel>

export function availabilityOf(lines: DraftLine[], lookup: ModelLookup = MODEL_BY_ID): Availability {
  let readyItems = 0
  let totalItems = 0
  const blocked: BlockedLine[] = []

  for (const l of lines) {
    const m = lookup.get(l.modelId)
    if (!m) continue
    totalItems += l.qty
    readyItems += Math.min(m.available, l.qty)
    const short = Math.max(0, l.qty - m.available)
    if (short > 0) {
      /* Attribute the shortfall to the largest pool actually holding units. */
      const by: BlockedBy =
        m.onRent >= m.reserved && m.onRent >= m.maintenance
          ? 'On Rent'
          : m.reserved >= m.maintenance
            ? 'Reserved'
            : 'On Maintenance'
      blocked.push({ key: l.key, model: m, short, by, freesAd: m.nextFreeAd })
    }
  }

  const shortBy = (by: BlockedBy) => blocked.reduce((s, b) => (b.by === by ? s + b.short : s), 0)
  const dates = blocked.map((b) => b.freesAd).filter((d): d is Date => d instanceof Date)

  return {
    readyItems,
    totalItems,
    blockedItems: totalItems - readyItems,
    blocked,
    segments: [
      { label: 'Ready', value: readyItems },
      { label: 'Reserved', value: shortBy('Reserved') },
      { label: 'On Rent', value: shortBy('On Rent') },
      { label: 'On Maintenance', value: shortBy('On Maintenance') },
    ],
    readyAd: dates.length === 0 ? null : new Date(Math.max(...dates.map((d) => d.getTime()))),
  }
}

export interface ItemBreakdown {
  equipment: number
  crew: number
  vehicle: number
  boxes: number
  /** §9 — `equipment + crew + vehicle + boxes`, by construction. */
  totalItems: number
  /** §9 — `—` where any line has no weight. Never 0. */
  totalWeightKg: number | null
}

export function breakdownOf(
  lines: DraftLine[],
  crew: CrewPick[],
  vehicle: VehicleType | null,
  lookup: ModelLookup = MODEL_BY_ID,
): ItemBreakdown {
  let equipment = 0
  let boxes = 0
  for (const l of lines) {
    const m = lookup.get(l.modelId)
    if (!m) continue
    if (BOX_CATEGORIES.has(m.category)) boxes += l.qty
    else equipment += l.qty
  }
  const crewCount = crew.reduce((s, c) => s + c.headcount, 0)
  const vehicleCount = vehicle ? 1 : 0

  const models = lines.map((l) => lookup.get(l.modelId)).filter((m): m is InventoryModel => !!m)
  const totalWeightKg = models.every((m) => typeof m.weightKg === 'number')
    ? lines.reduce((s, l) => s + (lookup.get(l.modelId)?.weightKg ?? 0) * l.qty, 0)
    : null

  return {
    equipment,
    crew: crewCount,
    vehicle: vehicleCount,
    boxes,
    totalItems: equipment + crewCount + vehicleCount + boxes,
    totalWeightKg: models.length === 0 ? null : totalWeightKg,
  }
}

/**
 * §7.4 — a line whose stored original no longer matches the model's current
 * rate. Nothing is refreshed silently; the screen offers the choice and states
 * the difference.
 */
export function rateDriftOf(
  lines: DraftLine[],
  lookup: ModelLookup = MODEL_BY_ID,
): Array<{ key: string; model: InventoryModel; from: Paisa; to: Paisa }> {
  const out: Array<{ key: string; model: InventoryModel; from: Paisa; to: Paisa }> = []
  for (const l of lines) {
    const m = lookup.get(l.modelId)
    if (m && m.unitRatePaisa !== l.originalRatePaisa) {
      out.push({ key: l.key, model: m, from: l.originalRatePaisa, to: m.unitRatePaisa })
    }
  }
  return out
}

/** §5.3 — the lines that already hold this model as a child, if any. */
export function parentsHolding(lines: DraftLine[], modelId: string): DraftLine[] {
  return lines.filter((l) => l.childIds.includes(modelId))
}

/* ── §3 · Duplicate Existing ───────────────────────────────────────────── */

const MODEL_BY_NAME: ReadonlyMap<string, InventoryModel> = new Map(INVENTORY_MODELS.map((m) => [m.name, m]))

/** The bundles the header's `Duplicate Existing` control can copy from. */
export const TEMPLATE_BUNDLES: readonly BundleRecord[] = ACTIVE_BUNDLES

export interface DuplicateResult {
  name: string
  category: InventoryCategory | ''
  tags: string[]
  lines: DraftLine[]
  crew: CrewPick[]
  vehicle: VehicleType | null
  /** Models the source bundle holds that this inventory tree does not. Stated, never dropped silently. */
  unmatched: string[]
}

const isCategory = (v: string): v is InventoryCategory =>
  (INVENTORY_CATEGORIES as readonly string[]).includes(v)
const isCrewRole = (v: string): v is CrewRole => (CREW_ROLES as readonly string[]).includes(v)
const isVehicle = (v: string): v is VehicleType => (VEHICLE_TYPES as readonly string[]).includes(v)

/**
 * Copies a saved bundle into a fresh draft. Rates come from **this** tree, not
 * from the source bundle — a duplicate is a new bundle priced today, and §7.4
 * only protects rates already stored on a saved line.
 */
export function duplicateFrom(b: BundleRecord): DuplicateResult {
  const lines: DraftLine[] = []
  const crew: CrewPick[] = []
  const unmatched: string[] = []
  let vehicle: VehicleType | null = null
  let n = 0

  for (const l of b.lines) {
    if (l.kind === 'crew') {
      if (isCrewRole(l.model)) crew.push({ role: l.model, headcount: l.quantity })
      else unmatched.push(`${l.model} (crew role)`)
      continue
    }
    if (l.kind === 'vehicle') {
      if (isVehicle(l.model)) vehicle = l.model
      else unmatched.push(`${l.model} (vehicle)`)
      continue
    }
    const m = MODEL_BY_NAME.get(l.model)
    if (!m) {
      unmatched.push(l.model)
      continue
    }
    n += 1
    lines.push({
      key: `D${b.id}-${n}`,
      modelId: m.id,
      qty: l.quantity,
      originalRatePaisa: m.unitRatePaisa,
      discountKind: 'pct',
      discountPct: 0,
      discountFixedPaisa: rupees(0),
      childIds: [],
      discountReason: '',
      approvedBy: null,
    })
  }

  return {
    name: `Copy of ${b.name}`,
    category: isCategory(b.category) ? b.category : '',
    tags: [...b.tags],
    lines,
    crew,
    vehicle,
    unmatched,
  }
}

/* ── §5.1 · assertions that can fail, and say so ───────────────────────── */

/**
 * ⛔ Reported, never thrown. A module-scope `throw` runs before React mounts, so
 * no boundary catches it and the operator gets a blank screen — `lib/money.ts`
 * hit exactly that and was fixed the same way.
 */
export const SEED_ERRORS: string[] = (() => {
  const errs: string[] = []
  const ids = new Set<string>()
  const skus = new Set<string>()

  for (const m of INVENTORY_MODELS) {
    if (ids.has(m.id)) errs.push(`Duplicate model id ${m.id}.`)
    ids.add(m.id)
    if (skus.has(m.sku)) errs.push(`Duplicate SKU ${m.sku}.`)
    skus.add(m.sku)

    const pools = m.available + m.reserved + m.onRent + m.maintenance
    if (pools !== m.stock) {
      errs.push(
        `§5.1: ${m.sku} — available ${m.available} + reserved ${m.reserved} + on rent ${m.onRent} + ` +
          `maintenance ${m.maintenance} = ${pools}, against a stock of ${m.stock}.`,
      )
    }
    if (m.available < m.stock && !m.nextFreeAd) {
      errs.push(`§8.3: ${m.sku} holds units it cannot say the return date of.`)
    }
    for (const c of m.children ?? []) {
      if (!MODEL_BY_ID.has(c.id)) errs.push(`${m.sku} names a child model ${c.id} that does not exist.`)
    }
  }

  for (const l of INITIAL_LINES) {
    if (!MODEL_BY_ID.has(l.modelId)) errs.push(`Draft line ${l.key} names a model ${l.modelId} that does not exist.`)
    /* §5.3 — a child of one line may never be a line of its own. */
    for (const childId of l.childIds) {
      if (INITIAL_LINES.some((o) => o.modelId === childId)) {
        const m = MODEL_BY_ID.get(childId)
        errs.push(
          `§5.3: ${m?.name ?? childId} is both a child of ${MODEL_BY_ID.get(l.modelId)?.name ?? l.modelId} ` +
            'and a line of its own — it would be priced twice and counted twice in availability.',
        )
      }
    }
  }

  return errs
})()
</file>

<file path="src/data/addEquipment.ts">
import { INVENTORY_MODELS, INVENTORY_CATEGORIES, BOX_CATEGORIES, MODEL_BY_ID } from './addBundle'
import type { InventoryModel } from './addBundle'
import { PARENTS } from './inventory'
import { BUNDLES } from './bundles'
import { UNITS as PACKED_UNITS } from './packing'
import { STORAGE_LOCATIONS } from './warehouse'

/**
 * **Add Equipment** seed — `06 Inventory/Add Equipment.md` v3.0 (Build Locked)
 * reconciled against `Add Equipment.PNG`.
 *
 * Nothing here is a new fact. Every list is *derived* from a module that already
 * owns it — the category list from `addBundle`, the container list from the same
 * catalogue, the existing-serial index from `inventory` + `packing`, the bundle
 * membership from `bundles`, the storage tree from `warehouse`. A second copy of
 * any of them is exactly the drift `Add Equipment.md §0 #10` names: *"a category
 * list that exists in two places with two contents."*
 *
 * Where the spec asks for a figure nobody has supplied — container capacity,
 * depreciation lives — this file supplies the **reason it is absent**, never a
 * number. `Add Equipment.md §16` still has those open with Babin.
 */

/* ── §3 · the category list ────────────────────────────────────────────── */

/**
 * §3's seventeen. `addBundle.INVENTORY_CATEGORIES` is the sixteen the Bundles
 * builder needs and is missing `Consumable`, because a bundle cannot contain
 * one — but §5.1 makes Consumable a **tracking mode**, and an item in that mode
 * still needs a category. So the one extra value is added here rather than the
 * whole list being retyped; `SEED_ERRORS` asserts the other sixteen still match
 * the catalogue exactly, so the two cannot drift apart silently.
 */
export const EQUIPMENT_CATEGORIES = [...INVENTORY_CATEGORIES, 'Consumable'].sort((a, b) =>
  a.localeCompare(b),
) as readonly string[]

/* ── §5.1 · tracking, one field ────────────────────────────────────────── */

export type TrackingMode = 'Serialised' | 'Quantity' | 'Consumable'

/**
 * §5.1 — this replaces `Equipment Type`, `Has Serial Number?` and `Tracking
 * Type`, the three controls the render asks the same question with. Three
 * controls for one fact can be set inconsistently; one cannot.
 */
export const TRACKING_MODES: ReadonlyArray<{ mode: TrackingMode; label: string; blurb: string }> = [
  { mode: 'Serialised', label: 'Serialised', blurb: 'One row per unit, each with the manufacturer serial. Stock is the unit count.' },
  { mode: 'Quantity', label: 'Quantity', blurb: 'No units. Stock is a count — cables, adapters, sandbags.' },
  { mode: 'Consumable', label: 'Consumable', blurb: 'A quantity that is consumed on return and never comes back — tape, gels, fluid.' },
]

/** §5.5 — the units a Quantity or Consumable line is counted in. */
export const QUANTITY_UNITS = ['piece', 'metre', 'roll', 'pack'] as const

/**
 * §5.4 — the intake condition, and it is **the same five Return & Inspection
 * v2.1 owns**. `Repair Required` is not one of them: §5.4 rules it a routing
 * outcome of Damaged, not a condition.
 */
export const INTAKE_CONDITIONS = ['Excellent', 'Good', 'Fair', 'Damaged', 'Lost'] as const
export type IntakeCondition = (typeof INTAKE_CONDITIONS)[number]

/* ── §4 · identifiers ──────────────────────────────────────────────────── */

/**
 * ── This screen does not mint an Asset Code, and must not ──────────────────
 *
 * What stood here:
 *
 *   export const NEXT_ASSET_CODE = `EQ${String(INVENTORY_MODELS.length + 1).padStart(6, '0')}`
 *
 * — the length of a seeded catalogue array plus one, computed once at module
 * scope, then shown to the operator as **the** Asset Code in Section 1, quoted
 * as the barcode and QR payload in the rail, printed into every unit's asset
 * tag, and read back in the validation report.
 *
 * It is the identical defect `finance/modals/CreateInvoiceModal.tsx` (~9-42)
 * documents and refuses to repeat, and that `inventory/AddBundle.tsx` had
 * removed for `BUNDLE_ID` on 12 Aug 2026. That decision is followed here rather
 * than re-litigated:
 *
 *  · **It collides.** Two operators adding equipment at the same moment read
 *    the same array length and are shown the same code. So does one operator in
 *    two tabs. A module-scope constant additionally freezes the value for the
 *    life of the page load.
 *  · **It predicts a figure the database owns.** `next_document_number
 *    (p_sequence_key)` takes a row lock and increments under it — the only way
 *    two concurrent inserts cannot collide — and `recordPayment.ts` /
 *    `createClient.ts` already call it by RPC for `payment_no` / `client_code`.
 *    Whatever eventually writes equipment does the same.
 *  · **It predicts from the wrong source.** `INVENTORY_MODELS` is the Bundles
 *    builder's seeded catalogue, not `number_sequences.current_value` and not
 *    `products`, so its length is unrelated to the counter the ledger issues.
 *    `actions/inventory/createEquipment.ts` says as much in its own
 *    `TODO(decision)`: the three authorities that describe an equipment code
 *    (`data/numbering.ts`, `lib/seed.ts`, `products_asset_code_format`) do not
 *    even agree on its *shape*.
 *
 * So the field says the code is assigned on save. The name `NEXT_ASSET_CODE` is
 * kept only because `AddEquipmentContext.tsx` and `EquipmentShared.tsx` import
 * it and belong to another pass; nothing about it is "next" any more.
 */
export const ASSET_CODE_ON_SAVE = 'Assigned on save'

/** @see ASSET_CODE_ON_SAVE — a placeholder to display, never an identifier. */
export const NEXT_ASSET_CODE = ASSET_CODE_ON_SAVE

/**
 * §4 — the **Asset Tag** is our own printed label, one per unit, and it is the
 * only per-unit identifier that may be generated. The serial is the
 * manufacturer's and is typed or scanned, never minted.
 *
 * It is generated *from the asset code*, so before the code exists the tag does
 * not either: given the placeholder above, this composes a placeholder — the
 * per-unit ordinal is real, the prefix is openly not yet assigned.
 */
export function assetTagFor(assetCode: string, index: number): string {
  return `${assetCode}-${String(index + 1).padStart(2, '0')}`
}

/* ── §5.2 · serials are unique across the whole system ─────────────────── */

/**
 * Every serial the system already holds, upper-cased, mapped to the record that
 * holds it. §5.2: *"Every serial is unique across the whole system, not just
 * this record. Duplicate detection runs on blur and names the existing record."*
 * Naming it is the whole point, so this is a map and not a set.
 *
 * Two sources, because the system genuinely holds two: the inventory master
 * (`PARENTS`) and the units currently on a packing list (`packing.UNITS`).
 */
export const EXISTING_SERIALS: ReadonlyMap<string, string> = (() => {
  const m = new Map<string, string>()
  for (const p of PARENTS) {
    for (const c of p.children ?? []) {
      if (c.serial) m.set(c.serial.toUpperCase(), p.name)
    }
  }
  for (const u of PACKED_UNITS) {
    if (u.serial && !m.has(u.serial.toUpperCase())) m.set(u.serial.toUpperCase(), u.name)
  }
  return m
})()

/** §7 — duplicate detection on name + model, not only on serial. */
export function existingModelMatch(name: string, model: string): InventoryModel | null {
  const n = name.trim().toLowerCase()
  const mdl = model.trim().toLowerCase()
  if (n.length < 3 && mdl.length < 3) return null
  return (
    INVENTORY_MODELS.find(
      (m) => m.name.toLowerCase() === n || (mdl.length >= 3 && m.sku.toLowerCase().includes(mdl)),
    ) ?? null
  )
}

/* ── §6 · the three relationship classes ───────────────────────────────── */

/** §6.1 — containment. Only a Case or a Bag can be a container. */
export const CONTAINER_MODELS: readonly InventoryModel[] = INVENTORY_MODELS.filter((m) =>
  BOX_CATEGORIES.has(m.category),
).sort((a, b) => a.name.localeCompare(b.name))

/** Everything attachable as a contained item, a compatible item or a requirement. */
export const ATTACHABLE_MODELS: readonly InventoryModel[] = [...INVENTORY_MODELS].sort((a, b) =>
  a.name.localeCompare(b.name),
)

export const modelName = (id: string): string => MODEL_BY_ID.get(id)?.name ?? id

/**
 * §6.2 — kit membership, read-only here. Bundles are built in the Bundles tab;
 * this only shows where an item is already used, so a retirement's blast radius
 * is visible before it happens.
 */
export function bundlesUsing(name: string): string[] {
  const n = name.trim().toLowerCase()
  if (n.length < 3) return []
  return BUNDLES.filter((b) => b.lines.some((l) => l.model.toLowerCase() === n)).map((b) => b.name)
}

/**
 * §7 — auto-suggest children. *"Adding a Sony FX3 suggests battery, charger,
 * cable, cage, top handle, case, based on what other units of the same category
 * contain."* Derived from the catalogue's own parent/child edges, so the
 * suggestion is always something the warehouse actually stocks.
 */
export function suggestedChildrenFor(brand: string, category: string): InventoryModel[] {
  const b = brand.trim().toLowerCase()
  const c = category.trim().toLowerCase()
  if (!b && !c) return []
  const ids = new Set<string>()
  for (const m of INVENTORY_MODELS) {
    const brandHit = b.length >= 2 && m.brand.toLowerCase() === b
    const catHit = c.length >= 2 && m.category.toLowerCase() === c
    if (!brandHit && !catHit) continue
    for (const child of m.children ?? []) ids.add(child.id)
  }
  return [...ids].map((id) => MODEL_BY_ID.get(id)).filter((m): m is InventoryModel => Boolean(m))
}

/* ── §11 · the storage tree ────────────────────────────────────────────── */

export interface LocationChoice {
  id: string
  warehouseId: string
  room: string
  zone: string
  rack: string
  shelf: string
  bin: string
  capacity: number
  used: number
}

/** Warehouse › Zone › Rack › Shelf › Bin, straight off the warehouse module. */
export const LOCATIONS: readonly LocationChoice[] = STORAGE_LOCATIONS

export function locationsIn(warehouseId: string): LocationChoice[] {
  return LOCATIONS.filter((l) => l.warehouseId === warehouseId)
}

export function locationLabel(l: LocationChoice): string {
  return `${l.room} › ${l.zone} › ${l.rack} › ${l.shelf} › ${l.bin}`
}

/* ── stated absences — §16 is still open on all of these ───────────────── */

export const SAVE_UNAVAILABLE_REASON =
  'Equipment writes are not built yet — there is no data layer behind this form. Both buttons validate the record and report; nothing is stored.'

export const PREVIEW_UNAVAILABLE_REASON =
  'Preview needs a saved record to open. Nothing is stored yet, so there is nothing to preview.'

export const LABEL_PRINT_UNAVAILABLE_REASON =
  /* Label printing is not built. Asset tags are generated in Section 2 and shown per unit; the print path is Roadmap (§14). */ "Label printing is not available yet. Asset tags are shown for each unit."

export const PACKING_PREVIEW_UNAVAILABLE_REASON =
  'A packing list preview needs a saved record with units. Nothing is stored yet.'

/**
 * §10.1 asks for a depreciation group; §16 ⭐ still asks Babin *"what lives does
 * your accountant use?"*. Seeding a life would be inventing the one fact the
 * question is about, so the control states the gap instead.
 */
export const DEPRECIATION_UNAVAILABLE_REASON =
  /* TODO(decision) — depreciation groups are undefined. Add Equipment §16 asks which asset lives the accountant uses; none may be invented here. */ "Depreciation groups have not been defined. Ask your accountant for the asset lives."

/**
 * §6.1 — *"The container has a capacity; exceeding it warns."* No container in
 * this project's item master carries one, so the warning cannot fire yet.
 */
export const CONTAINER_CAPACITY_REASON =
  /* TODO(decision) — no container in the item master carries a capacity, so §6.1’s over-capacity warning cannot be computed. Storage bins do carry one and are checked in Section 4. */ "Container capacity is not recorded. Storage-bin capacity is checked separately."

/* ── seed invariants — reported, never thrown ──────────────────────────── */

/**
 * A module-scope `throw` runs before React mounts and blanks the app with no
 * message (see the note in `lib/money.ts`). These are reported and the screen
 * renders them.
 */
export const SEED_ERRORS: string[] = (() => {
  const errs: string[] = []

  for (const c of INVENTORY_CATEGORIES) {
    if (!EQUIPMENT_CATEGORIES.includes(c)) {
      errs.push(`§3: category "${c}" is in the Bundles catalogue but missing from the Add Equipment list.`)
    }
  }

  for (const m of INVENTORY_MODELS) {
    if (!EQUIPMENT_CATEGORIES.includes(m.category)) {
      errs.push(`§3: model ${m.sku} has category "${m.category}", which the Add Equipment list does not offer.`)
    }
  }

  /* §5.2 — a serial that names two different records makes "duplicate detection
     names the existing record" a lie, so the index itself is checked. */
  const seen = new Map<string, string>()
  for (const p of PARENTS) {
    for (const c of p.children ?? []) {
      const key = c.serial.toUpperCase()
      const prior = seen.get(key)
      if (prior && prior !== p.name) {
        errs.push(`§5.2: serial ${c.serial} is held by both "${prior}" and "${p.name}".`)
      }
      seen.set(key, p.name)
    }
  }

  /* The old check asserted the *format* of a minted code (`EQ` + six digits).
     Nothing here mints one any more, so the invariant is inverted: the
     placeholder must NOT look like a real Asset Code, or the screen is back to
     showing the operator an identifier the database never issued. */
  if (/^EQ[-\s]?\d+$/i.test(ASSET_CODE_ON_SAVE)) {
    errs.push(
      `§4: "${ASSET_CODE_ON_SAVE}" reads like a real Asset Code. The code is assigned on save by the database; this field may only say so.`,
    )
  }

  for (const l of LOCATIONS) {
    if (l.used > l.capacity) {
      errs.push(`§11: storage bin ${l.bin} reports ${l.used} used against a capacity of ${l.capacity}.`)
    }
  }

  return errs
})()
</file>

