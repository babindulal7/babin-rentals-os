<file path="src/actions/inventory/__tests__/updateServicePlan.test.ts">
import { beforeEach, describe, expect, it, vi } from 'vitest'

/**
 * RULING 2026-09-08 (R-28) — the write half.
 *
 * What this file pins is the part a type cannot: that **null and absent are
 * different**. R-28's whole "null = that trigger is off" rests on it, and the
 * two obvious implementations — a spread of the patch, or a truthiness check —
 * each get it wrong in a different direction. A spread carries an explicit
 * `undefined` into the payload and clears a column nobody touched; a truthiness
 * check drops `null` and makes turning a trigger off impossible.
 *
 * Also pinned: an UPDATE that RLS refused returns zero rows and NO error, and
 * reporting that as a saved plan is the failure mode this action exists to
 * avoid.
 */

const db = vi.hoisted(() => {
  const state = {
    /** The row `select id, name` hands back, or null for "no such product". */
    product: { id: 'prod-1', name: 'NISI Athena 35mm' } as Record<string, unknown> | null,
    readError: null as { message: string } | null,
    /** What `safeUpdate` returns — null data is RLS refusing silently. */
    updated: {
      service_interval_days: 90,
      service_interval_rental_days: null,
      service_interval_meter_hours: null,
      service_grace_days: 7,
    } as Record<string, unknown> | null,
    updateError: null as { message: string } | null,
    /** Every payload `safeUpdate` was handed, in order. */
    writes: [] as Array<{ table: string; id: string; payload: Record<string, unknown> }>,
    selected: [] as string[],
  }
  function reset(): void {
    state.product = { id: 'prod-1', name: 'NISI Athena 35mm' }
    state.readError = null
    state.updated = {
      service_interval_days: 90,
      service_interval_rental_days: null,
      service_interval_meter_hours: null,
      service_grace_days: 7,
    }
    state.updateError = null
    state.writes = []
    state.selected = []
  }
  return { state, reset }
})

vi.mock('../../../lib/supabase', () => ({
  supabase: {
    from: () => {
      const builder: Record<string, unknown> = {
        select(columns: string) {
          db.state.selected.push(columns)
          return builder
        },
        eq() {
          return builder
        },
        maybeSingle: () => Promise.resolve({ data: db.state.product, error: db.state.readError }),
      }
      return builder
    },
  },
  newClientUuid: () => 'test-key',
}))

vi.mock('../../../lib/dataAccess', () => ({
  safeUpdate: async (table: string, id: string, payload: Record<string, unknown>) => {
    db.state.writes.push({ table, id, payload })
    return { data: db.state.updated, error: db.state.updateError }
  },
}))

const { updateServicePlanConfig } = await import('../updateServicePlan')

const MANAGER = { userId: 'usr-manager', role: 'Manager' as const, isOnline: true }

async function save(patch: Record<string, unknown>) {
  const input = { productId: 'prod-1', patch } as Parameters<typeof updateServicePlanConfig.validate>[0]
  await updateServicePlanConfig.validate(input)
  return updateServicePlanConfig.execute(input, MANAGER)
}

beforeEach(() => {
  db.reset()
})

describe('validate — what never reaches the database', () => {
  /* `validate` is synchronous and THROWS — it is not a promise. Asserting with
     `rejects` here passed vacuously on the first draft and had to be corrected;
     the shape of the assertion is part of what this case pins. */
  it('refuses a save with no product', async () => {
    await expect(save({ serviceIntervalDays: 90 })).resolves.toBeDefined()
    const input = { productId: '  ', patch: { serviceIntervalDays: 90 } } as never
    expect(() => updateServicePlanConfig.validate(input)).toThrow(/No product was named/)
  })

  it('refuses an empty patch rather than writing nothing and reporting success', async () => {
    await expect(save({})).rejects.toThrow(/Nothing was changed/)
  })

  it('refuses a key that is not part of a service plan', async () => {
    await expect(save({ dailyRate: 5000 })).rejects.toThrow(/not part of a service plan/)
  })

  /* Also a CHECK in 0103. Refused here first only so the operator gets a
     sentence instead of `products_service_intervals_positive`. */
  it('refuses a zero or negative interval, and says how to turn it off instead', async () => {
    await expect(save({ serviceIntervalDays: 0 })).rejects.toThrow(/clear it instead/)
    await expect(save({ serviceIntervalRentalDays: -1 })).rejects.toThrow(/clear it instead/)
  })

  it('refuses a negative grace, and accepts zero — zero is a real answer', async () => {
    await expect(save({ serviceGraceDays: -1 })).rejects.toThrow(/cannot be negative/)
    await expect(save({ serviceGraceDays: 0 })).resolves.toBeDefined()
  })
})

describe('the payload — null turns a trigger off, absent leaves it alone', () => {
  it('writes only the keys the operator changed', async () => {
    await save({ serviceIntervalDays: 90 })

    expect(db.state.writes).toHaveLength(1)
    expect(db.state.writes[0]?.payload).toEqual({ service_interval_days: 90 })
  })

  /* The whole of R-28's "null = that trigger is off". A truthiness check would
     drop this and make turning a trigger off impossible from the UI. */
  it('carries an explicit null through, because null IS the off switch', async () => {
    await save({ serviceIntervalRentalDays: null })

    expect(db.state.writes[0]?.payload).toEqual({ service_interval_rental_days: null })
  })

  /* And the other direction: an explicitly-undefined key must not clear a
     column nobody touched, which a spread of the patch object would do. */
  it('ignores a key sent as undefined rather than clearing that column', async () => {
    await save({ serviceIntervalDays: 90, serviceIntervalMeterHours: undefined })

    expect(db.state.writes[0]?.payload).toEqual({ service_interval_days: 90 })
  })

  it('maps every field to its snake_case column, and touches no other', async () => {
    await save({
      serviceIntervalDays: 90,
      serviceIntervalRentalDays: 40,
      serviceIntervalMeterHours: 250,
      serviceGraceDays: 14,
    })

    expect(db.state.writes[0]?.payload).toEqual({
      service_interval_days: 90,
      service_interval_rental_days: 40,
      service_interval_meter_hours: 250,
      service_grace_days: 14,
    })
    expect(db.state.writes[0]?.table).toBe('products')
  })
})

describe('Law 6 — a service interval is not money', () => {
  it('names no money column in the read', async () => {
    await save({ serviceIntervalDays: 90 })

    for (const columns of db.state.selected) {
      expect(columns).not.toMatch(/rate|price|cost|amount|deposit/i)
    }
  })

  it('carries no money column in the write', async () => {
    await save({ serviceIntervalDays: 90 })

    for (const key of Object.keys(db.state.writes[0]?.payload ?? {})) {
      expect(key).not.toMatch(/rate|price|cost|amount|deposit/i)
    }
  })
})

describe('the read-back is the only proof the write landed', () => {
  /* An UPDATE refused by RLS returns zero rows and NO error. Without this
     branch a Coordinator would be told their plan was saved. */
  it('refuses to report success when the update changed no row', async () => {
    db.state.updated = null

    await expect(save({ serviceIntervalDays: 90 })).rejects.toThrow(/changed no row/)
  })

  it('reports the plan as set when any interval came back non-null', async () => {
    const { result } = await save({ serviceIntervalDays: 90 })

    expect(result.hasPlan).toBe(true)
    expect(result.changed).toEqual(['serviceIntervalDays'])
    expect(result.productName).toBe('NISI Athena 35mm')
  })

  it('reports the plan as gone when the last interval was cleared', async () => {
    db.state.updated = {
      service_interval_days: null,
      service_interval_rental_days: null,
      service_interval_meter_hours: null,
      service_grace_days: 7,
    }

    const { result } = await save({ serviceIntervalDays: null })

    expect(result.hasPlan).toBe(false)
  })

  it('refuses a product that does not exist, before writing anything', async () => {
    db.state.product = null

    await expect(save({ serviceIntervalDays: 90 })).rejects.toThrow(/No product matches/)
    expect(db.state.writes).toHaveLength(0)
  })

  it('surfaces a write error rather than swallowing it', async () => {
    db.state.updateError = { message: 'permission denied for table products' }

    await expect(save({ serviceIntervalDays: 90 })).rejects.toThrow(/permission denied/)
  })
})

describe('the capability it declares', () => {
  /* Declared AND mapped in the same change. An unmapped capability resolves to
     `undefined`, which the dispatcher reads as a denial for every role
     including Owner — the gap that made `rental.confirm` unreachable. */
  it('names inventory.edit_service_plan, and core.ts answers it', async () => {
    expect(updateServicePlanConfig.permissions).toEqual(['inventory.edit_service_plan'])

    const core = import.meta.glob('../../core.ts', { query: '?raw', import: 'default', eager: true }) as Record<
      string,
      string
    >
    const source = Object.values(core)[0] ?? ''
    expect(source).toContain("case 'inventory.edit_service_plan':")
  })

  it('is implemented, so the dispatcher does not throw ActionNotImplementedError', () => {
    expect(updateServicePlanConfig.implemented).toBe(true)
  })
})
</file>

<file path="src/actions/inventory/adjustStock.ts">
import { createAction, type ActionConfig, type ActionContext } from '../core'
import { EVENT_TYPES } from '../../events/eventBus'
import { newClientUuid, supabase } from '../../lib/supabase'

export type AdjustStockInput = {
  productId: string
  delta: number
  reason: string
  /** Reuse on retry so an interrupted response cannot apply twice. */
  clientUuid?: string
}

export type AdjustStockResult = {
  success: boolean
  productId: string
  quantityBefore: number
  quantityAfter: number
}

export const adjustStockConfig: ActionConfig<AdjustStockInput, AdjustStockResult> = {
  name: 'ADJUST_STOCK',
  permissions: ['inventory.stock_adjust'],
  implemented: true,
  validate: (input) => {
    if (!input.productId) throw new Error('Product is required.')
    if (!Number.isSafeInteger(input.delta) || input.delta === 0) {
      throw new Error('Adjustment must be a non-zero whole number.')
    }
    if (!input.reason || input.reason.trim().length < 10) {
      throw new Error('Adjustment reason of at least ten characters is required.')
    }
  },
  execute: async (input, ctx: ActionContext) => {
    const { data, error } = await supabase.rpc('adjust_stock', {
      p_product_id: input.productId,
      p_delta: input.delta,
      p_reason: input.reason.trim(),
      p_actor_id: ctx.userId,
      p_client_uuid: input.clientUuid ?? newClientUuid(),
    })
    if (error) throw error
    const row = data?.[0]
    if (!row || !Number.isInteger(row.quantity_before) || !Number.isInteger(row.quantity_after)) {
      throw new Error('Stock adjustment was not confirmed by the database. Refresh before retrying.')
    }
    return {
      result: {
        success: true,
        productId: input.productId,
        quantityBefore: row.quantity_before,
        quantityAfter: row.quantity_after,
      },
      events: [{
        type: EVENT_TYPES.STOCK_ADJUSTED,
        payload: { productId: input.productId, delta: input.delta, reason: input.reason.trim(), userId: ctx.userId },
      }],
    }
  },
}

export const adjustStock = createAction<AdjustStockInput, AdjustStockResult>(adjustStockConfig)
</file>

<file path="src/actions/inventory/approvePurchaseRequest.ts">
import { createAction, type ActionConfig, type ActionContext } from '../core'
import { EVENT_TYPES } from '../../events/eventBus'
import { safeUpdate } from '../../lib/dataAccess'
import { supabase } from '../../lib/supabase'
import { logAuditEvent } from '../../lib/audit'
import { captureError } from '../../lib/monitoring'

/**
 * # APPROVE_PURCHASE_REQUEST — the write
 *
 * ## What this replaced
 *
 * ```ts
 * console.log(`[DB TX] Purchase Request ${input.prId} updated to ${input.status}`)
 * return { result: { success: true }, events }
 * ```
 *
 * A `console.log` that "approved" spend without touching a row. This file is
 * now the UPDATE: resolve the PR by its number, check the move is legal, and
 * write `status` (+ `approved_by`) through `lib/dataAccess.safeUpdate` under
 * the caller's Law 8 action key.
 *
 * ## Schema facts this body is built on (0004_inventory.sql:578-604)
 *
 * 1. The natural key is `pr_no` (unique). The screen's rows are a seed array
 *    whose `id`s (`pr-001`) are not uuids and exist in no database, so the
 *    input takes the PR NUMBER and resolves it by SELECT — the same
 *    natural-key-to-uuid rule every implemented action follows. A number the
 *    database does not hold is refused with a sentence saying exactly that;
 *    on today's seed-only screen that refusal IS the honest outcome
 *    (`docs/pages/20_purchase_requests.md` §3: no code reads the real table).
 * 2. Forward-only, from the enum's own comment (0001:633): Approved and
 *    Rejected are reachable from `Submitted`, Rejected also from `Approved`;
 *    Ordered only from `Approved`. The current status is read first and an
 *    illegal move is refused by name — a decision recorded over a stale row
 *    is a different decision than the operator made.
 * 3. `approved_by` is written on Approved — the session's own id, never a
 *    typed name. `rejection_reason` exists (and 0001 carries a
 *    purchase_request_rejection_reason enum) but this screen collects no
 *    reason; the column is left NULL rather than invented. TODO(decision):
 *    a Reject dialog that collects the ruled reasons.
 *
 * ## Permission — the finance/admin five (0064, applied 23 Aug 2026)
 *
 * `purchase.approve` → `rbac.canApprovePurchase` — Owner, Admin, Manager,
 * Coordinator, Accounts — mirroring `purchase_requests_approval_rank`
 * (0064, RESTRICTIVE): any UPDATE whose resulting row is Approved or Rejected
 * requires `auth_is_finance_or_admin()`. The §4.29 breadth (Driver/Technician
 * admitted to a spend-authorising verb via `purchase_requests_all`) is closed;
 * raising, editing, submitting, cancelling, and Ordered/Received legwork stay
 * on the broad policy and are not this action's business.
 *
 * ## Offline
 *
 * Refused, not queued: `safeUpdate`'s offline branch returns an optimistic
 * echo of the payload, and the screen moves the row only on the resolved
 * path — a queued approval would show a decision procurement never received.
 * Money-adjacent approvals refuse offline throughout `lib/rbac`; this verb
 * authorises spend and follows them.
 *
 * ## Audit
 *
 * `purchase_requests` has no audit trigger (0010 covers six tables), so the
 * decision is logged through `lib/audit` with the old and new status; failure
 * is reported and the verb proceeds (§4.36, still open).
 *
 * ## How the write was driven
 *
 * Driven through the exported `approvePurchaseRequestConfig` in vitest with
 * `lib/dataAccess` and `lib/supabase` mocked at the same seams
 * `createClient`'s suite uses (`__tests__/inventoryWrites.test.ts`); the
 * staff/Client denial is pinned separately through the dispatched action.
 * Not driven against live Supabase — this session may not run the dev server
 * or apply migrations, and the live table holds no rows for the seed PR
 * numbers, so a live drive today ends at the named not-found refusal by
 * design.
 */

export type PurchaseRequestDecision = 'Approved' | 'Rejected' | 'Ordered'

export type ApprovePurchaseRequestInput = {
  /** `purchase_requests.pr_no` — the identifier the operator is looking at. */
  prNo: string
  decision: PurchaseRequestDecision
  /** Law 8 — the action key for this one decision, minted where the operator pressed the button. */
  clientUuid: string
}

export type ApprovePurchaseRequestResult = {
  /** `purchase_requests.id` — the row's uuid. */
  prId: string
  prNo: string
  status: PurchaseRequestDecision
}

/** Legal moves, from the `purchase_request_status` enum's own comment (0001:633). */
const ALLOWED_FROM: Record<PurchaseRequestDecision, readonly string[]> = {
  Approved: ['Submitted'],
  Rejected: ['Submitted', 'Approved'],
  Ordered: ['Approved'],
}

export const approvePurchaseRequestConfig: ActionConfig<ApprovePurchaseRequestInput, ApprovePurchaseRequestResult> = {
  name: 'APPROVE_PURCHASE_REQUEST',
  permissions: ['purchase.approve'],

  /** `true` because `execute` updates through `lib/dataAccess.safeUpdate` and
   *  verifies the row came back from the store. See the header for how it was driven. */
  implemented: true,

  validate: (input) => {
    if (!input.prNo || input.prNo.trim() === '') {
      throw new Error('Purchase Request number is required.')
    }
    if (input.decision !== 'Approved' && input.decision !== 'Rejected' && input.decision !== 'Ordered') {
      throw new Error(`"${String(input.decision)}" is not a decision this action records — Approve, Reject or Mark as Ordered.`)
    }
    if (!input.clientUuid || input.clientUuid.trim() === '') {
      throw new Error(
        'This decision carries no idempotency key, so a replay could record it twice under two audit rows. ' +
          'Nothing was sent. (Law 8)',
      )
    }
  },

  execute: async (input, ctx: ActionContext) => {
    /* OFFLINE — refused, not queued. See the header. */
    if (typeof navigator !== 'undefined' && navigator.onLine === false) {
      throw new Error(
        'This device is offline. A purchase decision is not queued for later — the request may have moved ' +
          'by the time the queue drains, and the decision would land on a state nobody looked at. Decide ' +
          'when you are back online.',
      )
    }

    const prNo = input.prNo.trim()
    const { data: prRow, error: prError } = await supabase
      .from('purchase_requests')
      .select('id, pr_no, status')
      .eq('pr_no', prNo)
      .maybeSingle()
    if (prError) {
      throw new Error(`Could not look up ${prNo}, so nothing was decided: ${prError.message}`)
    }
    if (!prRow) {
      throw new Error(
        `${prNo} does not exist in the database, so nothing was decided. This screen's register is seed ` +
          `data (docs/pages/20_purchase_requests.md) — until a PR intake writes real rows, there is nothing ` +
          `here for a decision to land on.`,
      )
    }
    const pr = prRow as { id: string; pr_no: string; status: string }

    const allowedFrom = ALLOWED_FROM[input.decision]
    if (!allowedFrom.includes(pr.status)) {
      throw new Error(
        `${pr.pr_no} is ${pr.status}, and ${input.decision} is only reachable from ${allowedFrom.join(' or ')} ` +
          `(purchase_request_status is forward-only, 0001:633). Nothing was changed — reload the list and ` +
          `decide on the request's real state.`,
      )
    }

    const patch: Record<string, unknown> = {
      status: input.decision,
      updated_by: ctx.userId,
      /* approved_by carries the session that APPROVED — never set on Reject or
         on the later Ordered move, which keeps the approver's identity intact. */
      ...(input.decision === 'Approved' ? { approved_by: ctx.userId } : {}),
      /* rejection_reason stays NULL — this screen collects none. See the header. */
    }

    /* `as never` — the sanctioned cast from createClient.ts:389-405: the
       hand-written `Database` type has no `purchase_requests` entry. */
    const updateResult = await safeUpdate(
      'purchase_requests' as never,
      pr.id,
      patch as never,
      input.clientUuid,
      /* 0130: the two estimated-cost columns are ungranted once Law 6 arms this
         table — a default RETURNING * throws 42501 after the row commits. The
         echo reads identity/state only. */
      { returningColumns: 'id, pr_no, status' },
    )

    /* PERSISTENCE CHECK — safeUpdate's network branch returns the SENT patch
       plus `id`, which carries no `pr_no`; only a row read back from the store
       does. An echo is treated as not-saved, never as success. */
    const persisted = updateResult.data as unknown as { id?: string; pr_no?: string; status?: string } | null
    if (updateResult.error) {
      throw new Error(
        `The decision could not be confirmed against the database, so treat it as not recorded: ${
          (updateResult.error as { message?: string }).message ?? String(updateResult.error)
        }`,
      )
    }
    if (!persisted || typeof persisted.pr_no !== 'string' || persisted.status !== input.decision) {
      throw new Error(
        'The decision was queued rather than written — the database has not confirmed it. Check the ' +
          'connection and decide again; the same decision replayed carries the same key (Law 8).',
      )
    }

    /* No audit trigger on purchase_requests (0010) — a spend authorisation is
       logged here, old state and new. Failure reported, verb proceeds (§4.36). */
    const audit = await logAuditEvent({
      eventClass: 'status change',
      category: 'Inventory',
      module: 'Inventory',
      action: input.decision === 'Approved' ? 'Approve' : input.decision === 'Rejected' ? 'Reject' : 'Update',
      tableName: 'purchase_requests',
      recordId: pr.id,
      actorId: ctx.userId,
      actorRole: ctx.role,
      oldValues: { status: pr.status },
      newValues: { status: input.decision },
    })
    if (!audit.ok) {
      console.error('[APPROVE_PURCHASE_REQUEST] audit write failed (verb proceeded, §4.36):', audit.error)
      captureError(audit.error, { where: 'approvePurchaseRequest.audit', prId: pr.id })
    }

    const events = [
      {
        type: EVENT_TYPES.PURCHASE_REQUEST_UPDATED,
        payload: {
          prId: pr.id,
          prNo: pr.pr_no,
          status: input.decision,
          userId: ctx.userId,
        },
      },
    ]

    return {
      result: {
        prId: pr.id,
        prNo: pr.pr_no,
        status: input.decision,
      },
      events,
    }
  },
}

export const approvePurchaseRequest = createAction(approvePurchaseRequestConfig)
</file>

<file path="src/actions/inventory/createBundle.ts">
import { createAction, type ActionConfig, type ActionContext } from '../core';
import { EVENT_TYPES } from '../../events/eventBus';
import { validateDiscount } from '../../lib/discount';
import { idempotentInsert } from '../../lib/dataAccess';
import { supabase } from '../../lib/supabase';
import { toRupees, type Paisa } from '../../lib/money';

/**
 * # CREATE_BUNDLE — the write, corrected (Phase 2 item 2.6a)
 *
 * ## What this replaced
 *
 * ```ts
 * const generatedId = issue('BND', Number(Date.now().toString().slice(-4)));
 * … idempotentInsert('bundles', { bundle_code: generatedId,
 *                                 category_id: input.category || null,
 *                                 daily_rate: 0, weekly_rate: 0, … });
 * … idempotentInsert('bundle_items', { product_id: item.modelId, … });
 * ```
 *
 * Three separate data corruptions in one body (audit:
 * `docs/pages/22_add_bundle.md` §7 gaps 2, 3, 4, 9):
 *
 *  1. `bundle_items.product_id` is `uuid not null references products (id)`
 *     (0004:411) and was handed the seed-catalogue id `'M-FX3-BODY'` verbatim.
 *  2. `bundles.category_id` is `uuid references inventory_categories (id)`
 *     (0004:386) and was handed the display name `'Camera'`.
 *  3. Every rate the screen computes was written as `daily_rate: 0,
 *     weekly_rate: 0` while the success toast quoted `formatMoney(rate)`
 *     "per day" — a figure the row did not contain.
 *  4. The code came from `issue('BND', Date.now().toString().slice(-4))` —
 *     clock digits recycled every ten seconds, against
 *     `bundles_code_key unique (bundle_code)` (0004:396).
 *
 * All four are fixed on the `createEquipment` pattern (the Phase 1 template):
 * natural keys resolve to uuids by SELECT before the first insert and refuse
 * with a named sentence when unresolvable; money crosses Paisa → rupees
 * exactly once via `toRupees()`; and the code comes from
 * `next_document_number('bundle')` — the `bundle` sequence row exists live
 * (`0056_ruled_sequences_completion.sql:71`, prefix `BND-`, padding 1,
 * year-less), so the database mints `BND-1, BND-2, …` under a row lock.
 * ⚠ MOCK DRIFT: `lib/mock/client.ts:nextDocumentNumber` has no `bundle` entry
 * in `SEQ_PREFIX`/`RULED_FORMAT`, so mock mode mints `BUNDLE-2026-0001` for
 * this key. The mock enforces no CHECK so the insert still lands; fixing the
 * shape is a mock change, outside this file (same caveat createEquipment
 * records for `EQ`).
 *
 * ## The read-back hazard this body routes around
 *
 * `0035_accessory_bundle_and_ledger_masking.sql:67` revokes
 * `select (daily_rate, weekly_rate) on bundles from authenticated` — the
 * column mask behind `bundles_v`. `idempotentInsert`'s default read-back is
 * `.insert().select().single()`, which requests every column and is therefore
 * refused on live for every session, *after* the row commits — the
 * two-permission trap `lib/dataAccess.ts:57-76` documents on `audit_events`.
 * So the insert here passes `{ returnRow: false }` and reads back only
 * `id, bundle_code` by the Law 8 key, columns the mask leaves open. That
 * narrow re-select is also the persistence check: the offline queue is
 * guarded above it, and the `'Failed to fetch'` echo branch writes nothing,
 * so a row the re-select cannot find is a row the database never confirmed.
 *
 * ## Booqable ownership
 *
 * `bundles`/`bundle_items` sit in `BOOQABLE_READ_ONLY_TABLES`, so
 * `insertViaSourceSwitch` would refuse this call. The raw `idempotentInsert`
 * is used deliberately — the same precedent `createEquipment` sets for
 * `products` (also in that set) and `createClient` documents for `clients`:
 * while the bridge is off, the OS is the writer, and the ownership tension is
 * `booqable/sync.ts`'s recorded TODO(decision), not this file's to settle.
 *
 * ## Law 6 — money
 *
 * Rates arrive as Paisa (branded ints) and cross to `numeric(14,2)` rupees
 * exactly once, here. A rate the caller did not send is ABSENT from the
 * payload — the column's own default (0) stands — never zeroed by this file.
 * Add Bundle is fully gated behind `useCanViewMoney`, so a money-blind
 * session can never reach this action with an omitted rate by masking.
 *
 * ## How the write was driven
 *
 * Through the exported `createBundleConfig` in vitest
 * (`__tests__/inventoryWrites.test.ts`), with `lib/dataAccess` and
 * `lib/supabase` mocked at the same seams the createEquipment suite uses:
 * payloads, lookups, the allocator, every refusal branch and the role denial
 * are pinned there. Not driven against live Supabase — this session may not
 * run the dev server or apply migrations.
 */

export type CreateBundleItemInput = {
  /** The seed-catalogue model id (`'M-FX3-BODY'`) — carried so a refusal can
   *  name the line; NEVER written. `bundle_items.product_id` is a uuid FK. */
  modelId: string;
  /**
   * `products.id` — how the screen identifies a line now.
   *
   * It used to send only the NAME, taken from `data/addBundle.ts`'s
   * `INVENTORY_MODELS`, and **19 of those 20 names match no `products` row** (the
   * real catalogue is Booqable-shaped: 'Sony FX3 Full-Frame Camera', not
   * 'Sony FX3 Cinema Camera'). `bundle_items.product_id` is a uuid FK, so every
   * Create Bundle and every Save Draft was refused here.
   */
  productId?: string | undefined;
  /** `products.name` — the fallback when no id is sent. Exact-match only. */
  productName?: string;
  qty: number;
  discountPct?: number;
  discountReason?: string;
  approvedBy?: string | null;
  /** Law 8 — one key per ROW, minted where the operator pressed Save. */
  clientUuid: string;
};

export type CreateBundleInput = {
  /** Law 8 — the `bundles` row key, minted at the call site, stable across retries. */
  clientUuid: string;
  name: string;
  /**
   * `inventory_categories.id`. The picker offered the `product_category` enum's
   * sixteen labels while the table holds SIX rows, so ten of them refused the
   * save. Absent (a draft may lack one) → `category_id` stays NULL.
   */
  categoryId?: string | undefined;
  /** `inventory_categories.name` — the fallback when no id is sent. */
  category?: string;
  description?: string;
  items?: CreateBundleItemInput[];
  itemCount?: number;
  isDraft?: boolean;
  /* Law 6 — Paisa in, rupees at the boundary, exactly once. */
  dailyRatePaisa?: Paisa;
  weeklyRatePaisa?: Paisa;
};

export type CreateBundleResult = {
  /** `bundles.id` — Postgres', never a client-side string. */
  bundleId: string;
  /** `bundles.bundle_code` — allocated by `next_document_number('bundle')`. */
  bundleCode: string;
  itemCount: number;
};

/** The exact `bundles` column set this action writes — typechecked against
 *  0004:380-398, the same defence `createEquipment` keeps against the stale
 *  hand-written `Database` type. */
type BundleInsertPayload = {
  client_uuid: string;
  bundle_code: string;
  name: string;
  description: string | null;
  category_id?: string;
  is_active: boolean;
  daily_rate?: number;
  weekly_rate?: number;
  created_by: string;
};

type BundleItemInsertPayload = {
  client_uuid: string;
  bundle_id: string;
  product_id: string;
  quantity: number;
  /* Law 9 — days is mandatory on every priced line, explicitly `1`, never by
     omission. The column defaults to 1, but stating it here means the insert
     cannot become silent if the default is ever dropped. */
  days: number;
  sort_order: number;
  created_by: string;
};

/** Trimmed, or null — a blank optional column is NULL, never an empty string. */
function orNull(v: string | undefined): string | null {
  const t = v?.trim();
  return t ? t : null;
}

/** Present-and-converted, or absent — `exactOptionalPropertyTypes` is on, and
 *  a rate the caller did not send must be ABSENT from the payload. */
function moneyCol(key: string, paisa: Paisa | null | undefined): Record<string, number> {
  return paisa == null ? {} : { [key]: Number(toRupees(paisa).toFixed(2)) };
}

/** Turn a Postgres failure into a sentence an operator can act on. Constraint
 *  names below are live on the project (0004); unmatched messages pass through. */
function describeBundleInsertFailure(message: string, bundleCode: string): string {
  if (message.includes('bundles_code_key')) {
    return (
      `The database allocated bundle code ${bundleCode} and a bundle already carries it — the 'bundle' ` +
      `number sequence is behind the codes already in the table. Nothing was saved. This needs the ` +
      `sequence corrected, not a retry.`
    );
  }
  if (message.includes('bundles_category_id_fkey') || message.includes('category_id')) {
    return `The chosen category no longer exists in inventory_categories, so nothing was saved.`;
  }
  return message;
}

export const createBundleConfig: ActionConfig<CreateBundleInput, CreateBundleResult> = {
  name: 'CREATE_BUNDLE',
  permissions: ['inventory.create'],

  /**
   * `true` because `execute` inserts through `lib/dataAccess.idempotentInsert`
   * and verifies the row against the store by re-selecting its id. See the
   * header for how the write was driven.
   */
  implemented: true,

  validate: (input) => {
    if (!input.name || input.name.trim() === '') {
      throw new Error('Bundle name is required — bundles.name is NOT NULL.');
    }
    if (!input.clientUuid || input.clientUuid.trim() === '') {
      throw new Error(
        'This bundle carries no idempotency key, so a retry could create a second bundle under a second ' +
          'code. Nothing was sent. (Law 8)',
      );
    }
    if (input.items) {
      for (const [i, item] of input.items.entries()) {
        if (!item.clientUuid || item.clientUuid.trim() === '') {
          throw new Error(
            `Line ${i + 1} carries no idempotency key — Law 8 wants one per row, minted where the operator ` +
              `acted. Nothing was sent.`,
          );
        }
        if (!Number.isFinite(item.qty) || item.qty < 1) {
          throw new Error(
            `Line ${i + 1} has a quantity below 1 — bundle_items_qty_positive refuses it (0004:420).`,
          );
        }
        /* One identifier or the other. `bundle_items.product_id` is a NOT NULL
           uuid FK, so a line naming nothing can only fail at the lookup — and
           it should fail here, before a single row is written. */
        if (!(item.productId?.trim() || item.productName?.trim())) {
          throw new Error(
            `Line ${i + 1} names no product — bundle_items.product_id is a uuid FK to products, so a ` +
              `bundle cannot contain a line that points at nothing. Nothing was sent.`,
          );
        }
        /* ⛔ Was `item.discountPct && item.discountPct > 0` — which SKIPPED
           validation for a negative percent, silently accepting a price rise
           dressed as a discount (the exact R3-1 hole, in a fourth place).
           Found 31 Aug while removing the discount gate; the ungated
           `validateDiscount` still refuses negative and >100%, and now it is
           actually asked. */
        if (item.discountPct !== undefined && item.discountPct !== 0) {
          const v = validateDiscount(item.discountPct);
          if (!v.valid) {
            throw new Error(v.error ?? 'Invalid item discount in bundle.');
          }
        }
      }
    }
  },

  execute: async (input, ctx: ActionContext) => {
    /* OFFLINE — refused, not queued: the bundle code comes from the database's
       allocator and cannot be issued here. Same reasoning, same shape as
       createClient / createEquipment. */
    if (typeof navigator !== 'undefined' && navigator.onLine === false) {
      throw new Error(
        'This device is offline. A new bundle is not queued for later — the bundle code comes from the ' +
          'database and cannot be issued here. Save it when you are back online.',
      );
    }

    /* Natural keys → uuids, all BEFORE the first insert so a resolution
       failure writes nothing at all. */
    let categoryId: string | null = null;
    const categoryKeyId = input.categoryId?.trim() ?? '';
    const categoryName = input.category?.trim() ?? '';
    if (categoryKeyId || categoryName) {
      /* By uuid when the picker supplied one; by exact name otherwise. */
      const base = supabase.from('inventory_categories').select('id, name');
      const { data: categoryRow, error: categoryError } = await (categoryKeyId
        ? base.eq('id', categoryKeyId)
        : base.eq('name', categoryName)
      ).maybeSingle();
      if (categoryError) {
        throw new Error(`Could not look up the category, so nothing was saved: ${categoryError.message}`);
      }
      if (!categoryRow) {
        throw new Error(
          categoryKeyId
            ? `No category has id ${categoryKeyId}, so nothing was saved. The category list changed under ` +
              `the form — reopen it and choose again.`
            : `"${categoryName}" is not a category in inventory_categories, so nothing was saved. ` +
              `bundles.category_id is a uuid FK (0004:386) and the table holds six rows, while the enum ` +
              `product_category has seventeen labels — a label is not a row.`,
        );
      }
      categoryId = (categoryRow as { id: string }).id;
    }

    const items = input.items ?? [];
    const resolvedItems: Array<{ productId: string; qty: number; clientUuid: string }> = [];
    for (const item of items) {
      const productName = item.productName?.trim() ?? '';
      const productId = item.productId?.trim() ?? '';
      /* By uuid when the line was picked from the catalogue; by exact name otherwise. */
      const productBase = supabase.from('products').select('id, name');
      const { data: productRow, error: productError } = await (productId
        ? productBase.eq('id', productId)
        : productBase.eq('name', productName)
      ).maybeSingle();
      if (productError) {
        throw new Error(
          `Could not look up "${productName || productId || item.modelId}" in products, so nothing was saved: ${productError.message}`,
        );
      }
      if (!productRow) {
        throw new Error(
          productId
            ? `No product has id ${productId}, so nothing was saved. The catalogue changed under the form ` +
              `— reopen it and pick the line again.`
            : `"${productName || item.modelId}" (${item.modelId}) is not a product in the products table, ` +
              `so nothing was saved. bundle_items.product_id is a uuid FK to products (0004:411); a typed ` +
              `or seeded model name has to match a products row exactly.`,
        );
      }
      resolvedItems.push({
        productId: (productRow as { id: string }).id,
        qty: item.qty,
        clientUuid: item.clientUuid,
      });
    }

    /* The code from the database's allocator, never from the clock. A retry
       re-enters the RPC before the insert, so a Law 8 replay that conflicts on
       client_uuid has burned a sequence value — gaps are possible and are not
       a defect (same caveat as createClient / createEquipment). */
    const { data: bundleCode, error: numberError } = await supabase.rpc('next_document_number', {
      p_sequence_key: 'bundle',
    });
    if (numberError) {
      throw new Error(`Could not allocate a bundle code, so nothing was saved: ${numberError.message}`);
    }
    if (!bundleCode) {
      throw new Error('next_document_number returned no bundle code, so nothing was saved.');
    }

    const payload: BundleInsertPayload = {
      client_uuid: input.clientUuid,
      bundle_code: bundleCode as string,
      name: input.name.trim(),
      description: orNull(input.description),
      ...(categoryId ? { category_id: categoryId } : {}),
      is_active: !input.isDraft,
      /* Law 6 — the screen-computed rate the operator saw, in rupees, exactly
         once. Absent stays absent; the column default (0) is then the
         database's statement, not this file's fabrication. */
      ...moneyCol('daily_rate', input.dailyRatePaisa),
      ...moneyCol('weekly_rate', input.weeklyRatePaisa),
      created_by: ctx.userId,
    };

    try {
      /* `'bundles' as never` / `payload as never` — the sanctioned cast from
         createClient.ts / createEquipment.ts: `dataAccess` is generic over the
         hand-written `types/database.ts`, and `BundleInsertPayload` above is
         what actually typechecks the payload against 0004.
         `{ returnRow: false }` because 0035:67 revokes select on the two money
         columns and the default read-back requests every column — see the
         header. */
      await idempotentInsert('bundles' as never, payload as never, { returnRow: false });
    } catch (err) {
      const message = err instanceof Error ? err.message : String(err);
      throw new Error(describeBundleInsertFailure(message, bundleCode as string));
    }

    /* ── PERSISTENCE CHECK ──────────────────────────────────────────────────
     * The narrow re-select by the Law 8 key, requesting only columns the 0035
     * mask leaves open. This is the only proof the row committed: with
     * `returnRow: false` the insert reports nothing back, and the network-echo
     * branch of `idempotentInsert` "succeeds" having written nothing. It also
     * makes a Law 8 replay land correctly — the conflict re-resolves to the
     * bundle the first press created. */
    const { data: savedBundle, error: readbackError } = await supabase
      .from('bundles')
      .select('id, bundle_code')
      .eq('client_uuid', input.clientUuid)
      .maybeSingle();
    if (readbackError) {
      throw new Error(
        `The bundle could not be confirmed against the database, so treat it as not saved: ${readbackError.message}`,
      );
    }
    const bundle = savedBundle as { id?: string; bundle_code?: string } | null;
    if (!bundle || typeof bundle.id !== 'string') {
      throw new Error(
        'The bundle was queued rather than written — the database has not confirmed it, so it has no ' +
          'bundle code yet. Check the connection and save it again.',
      );
    }

    const savedCode = bundle.bundle_code ?? (bundleCode as string);

    /* Lines — one row each, each under its own Law 8 key, carrying the
       RESOLVED product uuid. */
    let writtenItems = 0;
    for (const [i, item] of resolvedItems.entries()) {
      const itemPayload: BundleItemInsertPayload = {
        client_uuid: item.clientUuid,
        bundle_id: bundle.id,
        product_id: item.productId,
        quantity: item.qty,
        days: 1,
        sort_order: i,
        created_by: ctx.userId,
      };
      try {
        const itemResult = await idempotentInsert('bundle_items' as never, itemPayload as never);
        const savedItem = itemResult.data as unknown as { id?: string } | null;
        if (itemResult.error || !savedItem || typeof savedItem.id !== 'string') {
          throw new Error('the database did not confirm the row');
        }
      } catch (err) {
        const message = err instanceof Error ? err.message : String(err);
        throw new Error(
          `The bundle WAS created as ${savedCode} (${writtenItems} of ${resolvedItems.length} line${
            resolvedItems.length === 1 ? '' : 's'
          } written), but line ${i + 1} failed: ${message}. Fix the line and save again — the same form ` +
            `resubmitted resolves to the same bundle instead of creating a second one (Law 8).`,
        );
      }
      writtenItems += 1;
    }

    const events = [
      {
        type: EVENT_TYPES.BUNDLE_CREATED,
        payload: {
          bundleId: bundle.id,
          bundleCode: savedCode,
          name: input.name.trim(),
          itemCount: input.itemCount ?? writtenItems,
          isDraft: !!input.isDraft,
          userId: ctx.userId,
        },
      },
    ];

    return {
      result: { bundleId: bundle.id, bundleCode: savedCode, itemCount: writtenItems },
      events,
    };
  },
};

export const createBundle = createAction(createBundleConfig);
</file>

<file path="src/actions/inventory/createEquipment.ts">
import { createAction, type ActionConfig, type ActionContext } from '../core'
import { EVENT_TYPES } from '../../events/eventBus'
import { idempotentInsert } from '../../lib/dataAccess'
import { supabase } from '../../lib/supabase'
import { logAuditEvent } from '../../lib/audit'
import { captureError } from '../../lib/monitoring'
import { toRupees, type Paisa } from '../../lib/money'

/**
 * # CREATE_EQUIPMENT — the write
 *
 * ## What this replaced
 *
 * ```ts
 * const generatedId = `${prefixOf('EQ')}-${Date.now().toString().slice(-4)}`
 * console.log(`[DB TX] Created equipment ${generatedId}: ${input.name} …`)
 * return { result: { success: true, equipmentId: generatedId }, events }
 * ```
 *
 * A `console.log` and an id minted off the wall clock, behind an input of two
 * fields (`name`, `isDraft`) that dropped the other ~40 things the seven-section
 * Add Equipment form collects (audit: `docs/pages/17_add_equipment.md` §7 gap 3).
 * This file is now the insert: one `products` row plus one `product_units` row
 * per serialised unit, both through `lib/dataAccess.idempotentInsert`.
 *
 * ## Schema facts this body is built on (0004_inventory.sql:83-245)
 *
 * 1. `products.asset_code` is NOT NULL, unique, CHECK `^EQ[0-9]{6}$`. The
 *    'equipment' row in `number_sequences` (0012:28, prefix `EQ`, padding 6) is
 *    the allocator, and `next_document_number()` special-cases the `EQ` prefix
 *    to mint `EQ000001` with no year segment (0007:386-390). The old
 *    TODO(decision) — `numbering.ts` says `EQ-CAT-NNNNNN`, the CHECK says
 *    `EQ000234` — is dodged the same way `createClient` dodges the client-code
 *    dispute: ask the database and write whatever it is configured to issue.
 *    ⚠ MOCK DRIFT: `lib/mock/client.ts:nextDocumentNumber` has no `EQ` special
 *    case and mints `EQ-2026-0001` for this key. The mock enforces no CHECK so
 *    the insert still lands, but the identifier shape differs from live.
 *    Fixing that is a mock change, outside this file.
 * 2. `products.category_id` / `brand` / `name` are NOT NULL — so `validate`
 *    requires them even though the page's 12 Aug ruling stopped gating Create
 *    on name/category/brand. The page rule governs its own summary banner; the
 *    database refuses the row regardless, and a named sentence beats a 23502.
 * 3. `product_units.warehouse_id` and `branch_id` are NOT NULL, so serialised
 *    units cannot be written without a resolved warehouse — a draft carrying
 *    serials but no location is refused with the reason, never half-written
 *    with its units silently dropped.
 * 4. `product_units.asset_tag` is NOT NULL unique. Tags are derived HERE from
 *    the allocated asset code (`EQ000123-01`), never taken from the form —
 *    the form composes them from the `'Assigned on save'` placeholder
 *    (audit gap 5), which must not reach the database.
 * 5. `products` has an audit trigger nowhere (0010 covers six tables;
 *    `products` is not one), so this body logs via `lib/audit`.
 *    `product_units` HAS `trg_audit_product_units` (0010:127) — no double log.
 *
 * ## Permission
 *
 * `inventory.create` → `rbac.canCreateBundle` (Owner/Admin/Manager), mapped
 * 15 Aug 2026 (core.ts:166). The live INSERT policy on `products` is
 * `products_insert` = Owner/Admin/Manager/**Warehouse** (0027:29-31) — one
 * seat wider than the capability. The narrower app rule stands until re-ruled:
 * widening it here without a ruling is the invented decision CLAUDE.md
 * forbids, and fail-narrow cannot write a row RLS would refuse.
 *
 * ## What is COLLECTED by the form and still has no schema home
 *
 * Stated so the drop is a decision, not an accident: supplier (free-typed name
 * vs `products.supplier_id` uuid FK with no supplier intake), asset owner,
 * insurance policy number, inspection interval, maintenance cycle, service
 * vendor (no columns), images/documents (no storage layer), and the
 * relationships pickers (`storedIn`/`contains`/`compatible`/`requires` carry
 * seed-catalogue model ids that do not exist in `products` — the two
 * catalogues are different universes, audit gap 16). TODO(decision) on each.
 *
 * ## Money
 *
 * Law 6: money arrives as Paisa (branded ints) and crosses to `numeric(14,2)`
 * rupees exactly once, here, via `toRupees()`. A money-blind session's form
 * omits the Purchase/Pricing sections entirely, so those fields are simply
 * absent from the input — never zeroed.
 *
 * ## How the write was driven
 *
 * Driven through the exported `createEquipmentConfig` in vitest with
 * `lib/dataAccess` and `lib/supabase` mocked at the same seams
 * `createClient`'s suite uses (`__tests__/inventoryWrites.test.ts`): payloads,
 * lookups, allocator, tag derivation, refusal branches and the role denial
 * are all pinned there. Not driven against live Supabase — this session may
 * not run the dev server or apply migrations. In mock mode (`IS_MOCK`, the
 * current source of truth) the store serves every table this body touches,
 * so the write lands end-to-end from the screen.
 */

/** Matches `unit_condition` (0001:541) — also the form's INTAKE_CONDITIONS. */
export type EquipmentUnitCondition = 'Excellent' | 'Good' | 'Fair' | 'Damaged' | 'Lost'

export type EquipmentUnitInput = {
  /** `product_units.serial_no` — the manufacturer's, typed or scanned, never generated. */
  serial: string
  condition: EquipmentUnitCondition
  /** `product_units.purchase_date` (date). */
  purchaseDateIso?: string | undefined
  /** Law 8 — one key per ROW, minted where the operator pressed Save. */
  clientUuid: string
}

export type CreateEquipmentInput = {
  /** Law 8 — the `products` row key, minted at the call site, stable across retries. */
  clientUuid: string
  name: string
  shortName?: string | undefined
  /** `inventory_categories.name` — resolved to `category_id` by SELECT. */
  category: string
  brand: string
  model?: string | undefined
  /** Only when it differs from brand — the form's own rule. */
  manufacturer?: string | undefined
  description?: string | undefined
  tracking: 'Serialised' | 'Quantity' | 'Consumable'
  /** Serialised only. */
  units?: EquipmentUnitInput[] | undefined
  /** Quantity/Consumable only. */
  quantity?: number | undefined
  reorderLevel?: number | undefined
  quantityUnit?: 'piece' | 'metre' | 'roll' | 'pack' | undefined
  /**
   * `warehouses.id`. Required when `units` are sent, unless `warehouseName` is.
   *
   * How the form identifies a facility now, because
   * `product_units.warehouse_id` is a NOT NULL FK and the old name lookup
   * matched nothing: the picker offered four seed labels ('Kathmandu Main Hub
   * (HQ)' and friends) against a table holding 'Central Camera Vault' and
   * 'Lakeside Equipment Hub'. Every serialised save failed here, after the form
   * had reported all gates clear.
   */
  warehouseId?: string | undefined
  /** `warehouses.name`. Retained for callers that still identify a facility by name. */
  warehouseName?: string | undefined
  /** Free-text position of the chosen bin. `storage_zone_id` stays null: the
   *  form's zone labels are seed strings, not `storage_zones` rows. */
  location?: { rack: string; shelf: string; bin: string } | undefined
  /**
   * `products.status` — `'Draft'` on Save Draft; on Create the CALLER passes
   * `'Active'` only when its own Ready-to-Rent gate cleared. That rule already
   * lives on the page (AddEquipmentContext `rentable`); restating it here
   * would fork it.
   */
  status: 'Draft' | 'Active'
  /* ── money — Paisa in, rupees at the boundary; absent for money-blind sessions ── */
  purchaseDateIso?: string | undefined
  purchasePricePaisa?: Paisa | undefined
  replacementValuePaisa?: Paisa | undefined
  dailyRatePaisa?: Paisa | undefined
  weeklyRatePaisa?: Paisa | undefined
  monthlyRatePaisa?: Paisa | undefined
  hourlyRatePaisa?: Paisa | undefined
  weekendRatePaisa?: Paisa | undefined
  depositPercent?: number | undefined
  depositFixedPaisa?: Paisa | undefined
  /** `product_units.warranty_expires_at` = purchase date + months (mechanical derivation, documented). */
  warrantyMonths?: number | undefined
  insuranceExpiryIso?: string | undefined
  /* ── rental & operational rules ── */
  minRentalDays?: number | undefined
  rentalEnabled?: boolean | undefined
  prepMinutes?: number | undefined
  cleaningMinutes?: number | undefined
  inspectionRequired?: boolean | undefined
  packingRequired?: boolean | undefined
  internalNotes?: string | undefined
  warehouseNotes?: string | undefined
}

export type CreateEquipmentResult = {
  /** `products.id` — Postgres', never a client-side string. */
  productId: string
  /** `products.asset_code` — allocated by `next_document_number('equipment')`. */
  assetCode: string
  status: 'Draft' | 'Active'
  unitCount: number
}

/** The exact `products` column set this action writes — typechecked against
 *  0004:83-144, because the hand-written `Database` type's `products` entry
 *  describes columns that do not exist (`slug`, `rental_rate_daily`, …). */
type ProductInsertPayload = {
  client_uuid: string
  asset_code: string
  name: string
  short_name: string | null
  category_id: string
  brand: string
  model: string | null
  manufacturer: string | null
  description: string | null
  tracking_mode: 'Serialised' | 'Quantity' | 'Consumable'
  status: 'Draft' | 'Active'
  total_quantity: number
  reorder_level?: number
  quantity_unit?: string
  purchase_date?: string
  purchase_price?: number
  replacement_value?: number
  daily_rate?: number
  weekly_rate?: number
  monthly_rate?: number
  hourly_rate?: number
  weekend_rate?: number
  deposit_percent?: number
  deposit_fixed?: number
  min_rental_days?: number
  rental_enabled?: boolean
  prep_time_minutes?: number
  cleaning_time_minutes?: number
  inspection_required?: boolean
  packing_required?: boolean
  notes_internal: string | null
  notes_warehouse: string | null
  created_by: string
}

type UnitInsertPayload = {
  client_uuid: string
  product_id: string
  serial_no: string
  asset_tag: string
  condition: EquipmentUnitCondition
  branch_id: string
  warehouse_id: string
  rack?: string
  shelf?: string
  bin?: string
  purchase_date?: string
  warranty_expires_at?: string
  insurance_expires_at?: string
  created_by: string
}

/** Trimmed, or null — a blank optional column is NULL, never an empty string. */
function orNull(v: string | undefined): string | null {
  const t = v?.trim()
  return t ? t : null
}

/** Present-and-converted, or absent — `exactOptionalPropertyTypes` is on, and
 *  a money column the operator left blank must be ABSENT from the payload. */
function moneyCol(key: string, paisa: Paisa | null | undefined): Record<string, number> {
  return paisa == null ? {} : { [key]: Number(toRupees(paisa).toFixed(2)) }
}

/** purchase date + N months, ISO date — the only derivation in this file. */
function addMonthsIso(iso: string, months: number): string {
  const d = new Date(`${iso}T00:00:00Z`)
  d.setUTCMonth(d.getUTCMonth() + months)
  return d.toISOString().slice(0, 10)
}

/** Turn a Postgres failure into a sentence an operator can act on. Constraint
 *  names below are live on the project (0004); unmatched messages pass through. */
function describeProductInsertFailure(message: string, assetCode: string): string {
  if (message.includes('products_asset_code_key')) {
    return (
      `The database allocated asset code ${assetCode} and a product already carries it — the 'equipment' ` +
      `number sequence is behind the codes already in the table. Nothing was saved. This needs the sequence ` +
      `corrected, not a retry.`
    )
  }
  if (message.includes('products_asset_code_format')) {
    return (
      `The database allocated ${assetCode} and its own products_asset_code_format CHECK (^EQ[0-9]{6}$) ` +
      `rejected it — the allocator and the CHECK are out of step. Nothing was saved; this needs a ` +
      `migration, not a retry.`
    )
  }
  if (message.includes('products_category_id_fkey') || message.includes('category_id')) {
    return `The chosen category no longer exists in inventory_categories, so nothing was saved.`
  }
  return message
}

export const createEquipmentConfig: ActionConfig<CreateEquipmentInput, CreateEquipmentResult> = {
  name: 'CREATE_EQUIPMENT',
  permissions: ['inventory.create'],

  /**
   * `true` because `execute` inserts through `lib/dataAccess.idempotentInsert`
   * and verifies a uuid came back from the store. See the header for how the
   * write was driven.
   */
  implemented: true,

  validate: (input) => {
    if (!input.name || input.name.trim() === '') {
      throw new Error('Equipment needs a name — products.name is NOT NULL.')
    }
    if (!input.category || input.category.trim() === '') {
      throw new Error('Equipment needs a category — products.category_id is NOT NULL (0004:89).')
    }
    if (!input.brand || input.brand.trim() === '') {
      throw new Error('Equipment needs a brand — products.brand is NOT NULL (0004:90).')
    }
    if (!input.clientUuid || input.clientUuid.trim() === '') {
      throw new Error(
        'This record carries no idempotency key, so a retry could create a second product under a second ' +
          'asset code. Nothing was sent. (Law 8)',
      )
    }
    if (input.status !== 'Draft' && input.status !== 'Active') {
      throw new Error('Record status must be Draft or Active — product_record_state has no other creatable member.')
    }

    if (input.tracking === 'Serialised') {
      const units = input.units ?? []
      const seen = new Set<string>()
      for (const [i, u] of units.entries()) {
        if (!u.serial || u.serial.trim() === '') {
          throw new Error(`Unit ${i + 1} has no serial. A serialised unit without its manufacturer serial cannot be scanned or told from its siblings.`)
        }
        const key = u.serial.trim().toUpperCase()
        if (seen.has(key)) {
          throw new Error(`Serial ${u.serial.trim()} is entered twice on this record — every serial is unique across the whole system.`)
        }
        seen.add(key)
        if (!u.clientUuid || u.clientUuid.trim() === '') {
          throw new Error(`Unit ${i + 1} carries no idempotency key — Law 8 wants one per row, minted where the operator acted. Nothing was sent.`)
        }
      }
      if (units.length > 0 && (!(input.warehouseId || input.warehouseName) || !input.location)) {
        throw new Error(
          'Serialised units need a warehouse and storage bin — product_units.warehouse_id is NOT NULL ' +
            '(0004:203). Pick the location in Section 4, or remove the serials before saving a draft.',
        )
      }
    } else {
      const qty = input.quantity ?? 0
      if (!Number.isFinite(qty) || qty < 1) {
        throw new Error('Quantity-tracked equipment needs a quantity of at least 1.')
      }
      if (input.reorderLevel !== undefined && input.reorderLevel > qty) {
        throw new Error('Reorder level cannot exceed the total quantity.')
      }
    }

    if (input.depositPercent !== undefined && (input.depositPercent < 0 || input.depositPercent > 100)) {
      throw new Error('A deposit percentage runs from 0 to 100 — products_deposit_pct_range refuses anything else.')
    }
    if (input.minRentalDays !== undefined && input.minRentalDays < 1) {
      throw new Error('Minimum rental days is at least 1 — products_min_rental_days_positive refuses less.')
    }
  },

  execute: async (input, ctx: ActionContext) => {
    /* OFFLINE — refused, not queued: the asset code comes from the database's
       allocator and cannot be issued here, and Add Equipment navigates away on
       success. Same reasoning, same shape as `createClient`. */
    if (typeof navigator !== 'undefined' && navigator.onLine === false) {
      throw new Error(
        'This device is offline. New equipment is not queued for later — the asset code comes from the ' +
          'database and cannot be issued here. Save it when you are back online.',
      )
    }

    /* Natural keys → uuids, all BEFORE the first insert so a resolution
       failure writes nothing at all. */
    const categoryName = input.category.trim()
    const { data: categoryRow, error: categoryError } = await supabase
      .from('inventory_categories')
      .select('id, name')
      .eq('name', categoryName)
      .maybeSingle()
    if (categoryError) {
      throw new Error(`Could not look up the category, so nothing was saved: ${categoryError.message}`)
    }
    if (!categoryRow) {
      throw new Error(
        `"${categoryName}" is not a category in inventory_categories, so nothing was saved. The Add Equipment ` +
          `category list is a seed constant and the database's category table is a different universe ` +
          `(docs/pages/17_add_equipment.md gap 16) — pick a category that exists in the database.`,
      )
    }

    const serialised = input.tracking === 'Serialised'
    const units = serialised ? (input.units ?? []) : []

    let warehouse: { id: string; branch_id: string; name: string } | null = null
    if (units.length > 0) {
      /* By uuid when the caller has one (the form does); by name otherwise. */
      const byId = typeof input.warehouseId === 'string' && input.warehouseId.trim() !== ''
      const base = supabase.from('warehouses').select('id, branch_id, name')
      const { data: warehouseRow, error: warehouseError } = await (byId
        ? base.eq('id', (input.warehouseId as string).trim())
        : base.eq('name', input.warehouseName?.trim() ?? '')
      ).maybeSingle()
      if (warehouseError) {
        throw new Error(`Could not look up the warehouse, so nothing was saved: ${warehouseError.message}`)
      }
      if (!warehouseRow) {
        throw new Error(
          `"${input.warehouseId ?? input.warehouseName ?? ''}" is not a warehouse the database knows, so ` +
            `nothing was saved. A unit must live in a real facility — product_units.warehouse_id is NOT NULL.`,
        )
      }
      warehouse = warehouseRow as { id: string; branch_id: string; name: string }
    }

    /* The code from the database's allocator, never from the clock. A retry
       re-enters the RPC before the insert, so a Law 8 replay that conflicts on
       client_uuid has burned a sequence value — gaps are possible and are not
       a defect (same caveat as createClient / recordPayment). */
    const { data: assetCode, error: numberError } = await supabase.rpc('next_document_number', {
      p_sequence_key: 'equipment',
    })
    if (numberError) {
      throw new Error(`Could not allocate an asset code, so nothing was saved: ${numberError.message}`)
    }
    if (!assetCode) {
      throw new Error('next_document_number returned no asset code, so nothing was saved.')
    }

    const totalQuantity = serialised ? units.length : (input.quantity ?? 0)

    const payload: ProductInsertPayload = {
      client_uuid: input.clientUuid,
      asset_code: assetCode as string,
      name: input.name.trim(),
      short_name: orNull(input.shortName),
      category_id: (categoryRow as { id: string }).id,
      brand: input.brand.trim(),
      model: orNull(input.model),
      manufacturer: orNull(input.manufacturer),
      description: orNull(input.description),
      tracking_mode: input.tracking,
      status: input.status,
      total_quantity: totalQuantity,
      ...(serialised ? {} : { ...(input.reorderLevel !== undefined ? { reorder_level: input.reorderLevel } : {}), ...(input.quantityUnit ? { quantity_unit: input.quantityUnit } : {}) }),
      ...(input.purchaseDateIso ? { purchase_date: input.purchaseDateIso } : {}),
      ...moneyCol('purchase_price', input.purchasePricePaisa),
      ...moneyCol('replacement_value', input.replacementValuePaisa),
      ...moneyCol('daily_rate', input.dailyRatePaisa),
      ...moneyCol('weekly_rate', input.weeklyRatePaisa),
      ...moneyCol('monthly_rate', input.monthlyRatePaisa),
      ...moneyCol('hourly_rate', input.hourlyRatePaisa),
      ...moneyCol('weekend_rate', input.weekendRatePaisa),
      ...(input.depositPercent !== undefined ? { deposit_percent: input.depositPercent } : {}),
      ...moneyCol('deposit_fixed', input.depositFixedPaisa),
      ...(input.minRentalDays !== undefined ? { min_rental_days: input.minRentalDays } : {}),
      ...(input.rentalEnabled !== undefined ? { rental_enabled: input.rentalEnabled } : {}),
      ...(input.prepMinutes !== undefined ? { prep_time_minutes: input.prepMinutes } : {}),
      ...(input.cleaningMinutes !== undefined ? { cleaning_time_minutes: input.cleaningMinutes } : {}),
      ...(input.inspectionRequired !== undefined ? { inspection_required: input.inspectionRequired } : {}),
      ...(input.packingRequired !== undefined ? { packing_required: input.packingRequired } : {}),
      notes_internal: orNull(input.internalNotes),
      notes_warehouse: orNull(input.warehouseNotes),
      created_by: ctx.userId,
    }

    let productResult: Awaited<ReturnType<typeof idempotentInsert>>
    try {
      /* `'products' as never` / `payload as never` — the sanctioned cast from
         createClient.ts:389-405: `dataAccess` is generic over the hand-written
         `types/database.ts`, whose `products` entry describes columns this
         table does not have. `ProductInsertPayload` above is what actually
         typechecks the payload. */
      /* Explicit RETURNING list: products is one of the four tables 0062 locks
         down, and a bare echo is RETURNING * — which names ungranted money
         columns and throws AFTER the row commits (AUDIT_0062.md). This caller
         consumes exactly id + asset_code. */
      productResult = await idempotentInsert('products' as never, payload as never, {
        returningColumns: 'id, asset_code',
      })
    } catch (err) {
      const message = err instanceof Error ? err.message : String(err)
      throw new Error(describeProductInsertFailure(message, assetCode as string))
    }

    /* PERSISTENCE CHECK — same three branches as createClient: the offline
       queue (guarded above) and the network branch both return the SENT
       payload, which has no `id`; only Postgres fills that column. */
    const product = productResult.data as unknown as { id?: string; asset_code?: string } | null
    if (productResult.error) {
      throw new Error(
        `The equipment record could not be confirmed against the database, so treat it as not saved: ${
          (productResult.error as { message?: string }).message ?? String(productResult.error)
        }`,
      )
    }
    if (!product || typeof product.id !== 'string') {
      throw new Error(
        'The equipment record was queued rather than written — the database has not confirmed it, so it has ' +
          'no asset code yet. Check the connection and save it again.',
      )
    }

    const savedCode = product.asset_code ?? (assetCode as string)

    /* `products` has no audit trigger (0010 covers six tables; products is not
       one), so the row is logged here. Failure is reported and the verb
       proceeds — what a caller does about a failed audit write is PLAN.md
       §4.36, still open; every current caller proceeds. */
    const productAudit = await logAuditEvent({
      eventClass: 'status change',
      category: 'Inventory',
      module: 'Inventory',
      action: 'Create',
      tableName: 'products',
      recordId: product.id,
      actorId: ctx.userId,
      actorRole: ctx.role,
      newValues: { asset_code: savedCode, name: payload.name, status: payload.status, tracking_mode: payload.tracking_mode, total_quantity: payload.total_quantity },
    })
    if (!productAudit.ok) {
      console.error('[CREATE_EQUIPMENT] audit write failed (verb proceeded, §4.36):', productAudit.error)
      captureError(productAudit.error, { where: 'createEquipment.audit' })
    }

    /* Units — one row each, each under its own Law 8 key. Asset tags are
       derived from the code the database just issued, so `Assigned on save-01`
       can never reach a row. No app-side audit call: product_units carries
       trg_audit_product_units (0010:127). */
    const writtenUnits: Array<{ serial: string; assetTag: string }> = []
    for (const [i, unit] of units.entries()) {
      const assetTag = `${savedCode}-${String(i + 1).padStart(2, '0')}`
      const w = warehouse as { id: string; branch_id: string; name: string }
      const purchaseIso = unit.purchaseDateIso ?? input.purchaseDateIso
      const unitPayload: UnitInsertPayload = {
        client_uuid: unit.clientUuid,
        product_id: product.id,
        serial_no: unit.serial.trim(),
        asset_tag: assetTag,
        condition: unit.condition,
        /* status is deliberately ABSENT: `inventory_state` is engine-owned and
           the column's own default is 'In Stock' (§5.3 — what creation sets). */
        branch_id: w.branch_id,
        warehouse_id: w.id,
        ...(input.location ? { rack: input.location.rack, shelf: input.location.shelf, bin: input.location.bin } : {}),
        ...(purchaseIso ? { purchase_date: purchaseIso } : {}),
        ...(purchaseIso && input.warrantyMonths ? { warranty_expires_at: addMonthsIso(purchaseIso, input.warrantyMonths) } : {}),
        ...(input.insuranceExpiryIso ? { insurance_expires_at: input.insuranceExpiryIso } : {}),
        created_by: ctx.userId,
      }
      try {
        /* Same 0062 rule as the products insert above: explicit granted list. */
        const unitResult = await idempotentInsert('product_units' as never, unitPayload as never, {
          returningColumns: 'id',
        })
        const savedUnit = unitResult.data as unknown as { id?: string } | null
        if (unitResult.error || !savedUnit || typeof savedUnit.id !== 'string') {
          throw new Error('the database did not confirm the row')
        }
      } catch (err) {
        const message = err instanceof Error ? err.message : String(err)
        const friendly = message.includes('product_units_serial_no_key')
          ? `serial ${unit.serial.trim()} already belongs to another unit in the system`
          : message
        throw new Error(
          `The equipment record WAS created as ${savedCode} (${writtenUnits.length} of ${units.length} unit${
            units.length === 1 ? '' : 's'
          } written), but unit ${i + 1} failed: ${friendly}. Fix the unit and save again — the same form ` +
            `resubmitted resolves to the same record instead of creating a second one (Law 8).`,
        )
      }
      writtenUnits.push({ serial: unit.serial.trim(), assetTag })
    }

    const events = [
      {
        type: EVENT_TYPES.EQUIPMENT_CREATED,
        payload: {
          equipmentId: product.id,
          assetCode: savedCode,
          name: payload.name,
          category: categoryName,
          status: input.status,
          trackingMode: input.tracking,
          quantity: totalQuantity,
          units: writtenUnits,
          userId: ctx.userId,
        },
      },
    ]

    return {
      result: {
        productId: product.id,
        assetCode: savedCode,
        status: input.status,
        unitCount: writtenUnits.length,
      },
      events,
    }
  },
}

export const createEquipment = createAction(createEquipmentConfig)
</file>

