 * stated**. There is no fourth case, so a `href="#"` cannot be written by
 * accident and an unbuilt destination has to say why it is unbuilt.
 */
export type Dest =
  | { kind: 'route'; to: string }
  | { kind: 'tab'; tab: TabKey }
  | { kind: 'none'; why: string }

/**
