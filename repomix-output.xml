          className="operations-v2__queue"
          style={{ ...chipStyle(selected === 'Cases'), textDecoration: 'none' }}
        >
          <Icon name="briefcase" size={15} style={{ color: selected === 'Cases' ? 'var(--select-fg)' : 'var(--text2)', flexShrink: 0 }} />
