                        </p>
                      </>
                    ) : (
                      <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-sm)' }}>
                        <p style={{ margin: 0, fontSize: 'var(--t-meta)', color: 'var(--muted)' }}>
                          No invoice has been raised against this booking yet.
                        </p>
