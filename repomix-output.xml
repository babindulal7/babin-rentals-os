  min-width: 0;
}
.new-rental-stage--setup,
.new-rental-stage--logistics {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 18px;
  align-items: start;
}
/* Optional logistics needs enough room for complete address/crew forms. */
@container rental-canvas (min-width: 920px) { .new-rental-stage--logistics { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.new-rental-canvas #section-1 { container: rental-period / inline-size; }
.new-rental-period-fields { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; align-items: start; }
@container rental-period (min-width: 480px) { .new-rental-period-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.new-rental-date-shortcuts { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin-top: 14px; }
.new-rental-date-shortcuts > [role='group'] { gap: 6px !important; padding: 0 !important; margin: 0 !important; font-size: 12px; }
.new-rental-date-shortcuts button { min-height: 44px !important; padding-inline: 10px !important; border-radius: var(--r-btn) !important; }
.new-rental-client-insights { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 8px; }
.new-rental-client-insights > button { background: var(--surface) !important; border-color: var(--border) !important; color: var(--text2) !important; }

.new-rental-canvas .new-rental-section-card { border: 1px solid var(--border) !important; border-radius: 12px !important; box-shadow: var(--shadow-sm) !important; scroll-margin-top: var(--new-rental-scroll-clearance); }
.new-rental-canvas .new-rental-section-card:hover, .new-rental-canvas .new-rental-section-card.is-active { border-color: var(--border) !important; }
.new-rental-canvas .new-rental-section-heading { min-height: 58px !important; padding: 8px 18px !important; background: var(--surface) !important; }
.new-rental-canvas .new-rental-section-heading h2 { font-size: 16px !important; font-weight: 700 !important; letter-spacing: -.015em; }
.new-rental-canvas .new-rental-section-card > div:nth-child(2) { padding: 18px !important; }
.new-rental-canvas .new-rental-section-card > div[hidden] { display: none; }
.new-rental-canvas .new-rental-section-heading button:hover { background: var(--card2) !important; }
.new-rental-preset-disclosure { margin: 10px 0 0; }
.new-rental-preset-disclosure > summary { width: fit-content; min-height: 44px; display: flex; align-items: center; color: var(--link); font-size: var(--t-meta); font-weight: 600; cursor: pointer; }
.new-rental-preset-disclosure > summary:hover { text-decoration: underline; }
.new-rental-preset-disclosure > summary:focus-visible { outline: 2px solid var(--input-focus); outline-offset: 2px; }
.new-rental-preset-disclosure .new-rental-shoot-presets { margin-top: 8px; }
.new-rental-empty-products { min-height: 88px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; padding: 20px; border-block: 1px solid var(--border); color: var(--text2); text-align: center; }
.new-rental-empty-products h3 { margin: 4px 0 0; color: var(--text); font-size: 15px; font-weight: 600; }
.new-rental-empty-products p { max-width: 40ch; margin: 0; font-size: var(--t-meta); line-height: 1.45; }

.new-rental-summary-rail { position: sticky; top: var(--new-rental-scroll-clearance); align-self: start; width: 100%; max-height: calc(100dvh - var(--new-rental-scroll-clearance) - 16px); overflow-y: auto; scrollbar-width: thin; }
.new-rental-summary-rail > aside { position: static !important; width: 100% !important; max-width: 100% !important; }
.new-rental-summary-rail > aside > div { max-height: none !important; overflow: visible !important; width: 100% !important; }
.new-rental-shell #rail-booking-summary { border-radius: 12px; box-shadow: var(--shadow-sm); scroll-margin-top: var(--new-rental-scroll-clearance); }
.new-rental-inline-summary { min-width: 0; max-width: 100%; }
.new-rental-shell .record-actions { border-radius: 12px; padding: 12px; gap: 12px; box-shadow: var(--shadow-card); }
.new-rental-shell .record-actions > button:last-child { min-height: 56px !important; padding-inline: 24px; }
.new-rental-footer-total { display: flex; flex-direction: column; gap: 2px; padding-inline: 12px; text-align: right; flex-shrink: 0; }
.new-rental-footer-total > span { font-size: 11px; color: var(--text2); }
.new-rental-footer-total > strong { font-size: 19px; color: var(--text); font-variant-numeric: tabular-nums; }

@media (max-width: 1100px) { .new-rental-jumpbar__meta { display: none; } }
@media (max-width: 767px) {
  .new-rental-shell { --new-rental-scroll-clearance: 72px; gap: 14px; animation: none; }
  .new-rental-shell:has(.record-actions)::after { content: ''; display: block; height: 160px; flex-shrink: 0; }
  .new-rental-jumpbar { overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; border-radius: 9px; }
  .new-rental-jumpbar::-webkit-scrollbar { display: none; }
  .new-rental-jumpbar button { padding-inline: 12px; font-size: 12px; }
  .new-rental-jumpbar button > svg { display: none; }
  .new-rental-canvas, .new-rental-stage--setup, .new-rental-stage--logistics { gap: 14px; }
  .new-rental-canvas .new-rental-section-heading { padding-inline: 14px !important; }
  .new-rental-canvas .new-rental-section-card > div:nth-child(2) { padding: 14px !important; }
  .new-rental-shell .catalogue-result-heading { flex-wrap: wrap; }
  .new-rental-shell .catalogue-result-name { flex: 1 1 calc(100% - 32px); min-width: 0; }
  .new-rental-shell #rail-booking-summary { scroll-margin-bottom: 160px; }
  .new-rental-shell .record-actions { position: fixed; left: var(--page-padding); right: var(--page-padding); bottom: calc(58px + env(safe-area-inset-bottom, 0px)); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; padding: 10px; }
  .new-rental-shell .record-actions > button, .new-rental-shell .record-actions > [role='status'] { min-width: 0; justify-content: center; }
  .new-rental-shell .record-actions > [role='status'] { text-align: center; font-size: 11px; grid-column: 2; grid-row: 1; }
  .new-rental-shell .record-actions > button:first-of-type { grid-column: 1; grid-row: 1; }
  .new-rental-shell .record-actions > button[aria-label='Review rental summary'] { grid-column: 3; grid-row: 1; }
  .new-rental-shell .record-actions > button:last-child { grid-column: 2 / -1; grid-row: 2; min-height: 56px; padding-inline: 12px; }
  .new-rental-shell .record-actions > button:nth-last-child(2):not([aria-label]) { grid-column: 1; grid-row: 2; }
  .new-rental-shell .record-actions:has(> button:nth-last-child(2)[aria-label]) > button:last-child { grid-column: 1 / -1; }
  .new-rental-footer-total { display: none; }
}
