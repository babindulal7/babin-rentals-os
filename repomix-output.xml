<file path="src/actions/finance/__tests__/createInvoice.test.ts">
/**
 * CREATE_INVOICE — that it dispatches the transaction rather than sequencing it.
 *
 * ## Why these assertions changed shape
 *
 * The previous suite proved that the action built the right nine lines from the
 * booking, the crew and the transport. It proved it against a mocked Supabase
 * client, and that is precisely why it was green while the action could not run
 * at all:
 *
 *   · **DATA-01** — `0062` revoked table-level SELECT on `booking_lines` and
 *     `booking_transport` and granted back only the non-money columns, so the
 *     projections naming `rate`, `discount_amount`, `delivery_charge` and
 *     `fuel_charge` returned `42501` for *every* signed-in session, Owner
 *     included. The mock has no grants, so the mock never noticed.
 *   · **DB-03** — the header and the lines were separate PostgREST calls, so a
 *     failure between them left a header with some of its lines and totals that
 *     under-bill the job.
 *
 * Both are answered by moving the snapshot and both writes into
 * `create_invoice(jsonb)` (`0096`). The line arithmetic that used to live here
 * now lives in SQL and is asserted by that migration's own post-conditions,
 * which run against a real database and a real grant set — the only place those
 * claims can be tested honestly.
 *
 * So this suite tests what is left in TypeScript, and one thing more: a
 * **source-level guard** that this file never re-acquires a base-table money
 * read. That guard is the DATA-01 regression test; nothing else in the codebase
 * binds an action's projection to the live grant set.
 */
import { describe, it, expect, beforeEach, vi } from 'vitest'

const rpc = vi.hoisted(() => ({
  calls: [] as Array<{ name: string; args: Record<string, unknown> | undefined }>,
  result: { data: null as unknown, error: null as unknown },
}))

/*
 * `lib/dataAccess` is no longer imported by the action. It is mocked to THROW
 * so that a future edit which reaches for `idempotentInsert` again — the
 * multi-call shape DB-03 was filed against — fails here rather than in
 * production.
 */
vi.mock('../../../lib/dataAccess', () => ({
  idempotentInsert: async () => {
    throw new Error('createInvoice must not write tables directly; create_invoice(jsonb) owns the transaction.')
  },
  safeUpdate: async () => {
    throw new Error('createInvoice must not update anything.')
  },
}))

const db = vi.hoisted(() => ({
  tablesTouched: [] as string[],
}))

vi.mock('../../../lib/supabase', () => ({
  supabase: {
    from: (table: string) => {
      db.tablesTouched.push(table)
      throw new Error(`createInvoice must not read ${table} from the browser; create_invoice(jsonb) reads it.`)
    },
    rpc: async (name: string, args?: Record<string, unknown>) => {
      rpc.calls.push({ name, args })
      return rpc.result
    },
  },
  newClientUuid: () => '00000000-0000-4000-8000-00000000000f',
}))

const { createInvoice } = await import('../createInvoice')

const CTX = { userId: 'aaaaaaaa-0000-4000-8000-000000000001', role: 'Owner' as const, isOnline: true }

const INPUT = { bookingNo: '880', vatPercent: 13, clientUuid: 'k-1' }

/** What `0096` returns for a booking with two equipment lines and one transport row. */
const WROTE = {
  invoice_id: '99999999-9999-4999-8999-999999999999',
  invoice_no: null,
  status: 'Draft',
  booking_id: '22222222-2222-4222-8222-222222222222',
  booking_no: '880',
  client_id: '33333333-3333-4333-8333-333333333333',
  due_date: '2026-09-14',
  line_count: 3,
  subtotal: 21000,
  discount_amount: 2100,
  taxable_amount: 18900,
  vat_amount: 2457,
  total: 21357,
  replayed: false,
}

const payloadOf = (i = 0) =>
  (rpc.calls[i]?.args?.['p_payload'] ?? {}) as Record<string, unknown>

beforeEach(() => {
  rpc.calls.length = 0
  db.tablesTouched.length = 0
  rpc.result = { data: WROTE, error: null }
})

describe('createInvoice — one transaction, dispatched not sequenced', () => {
  it('calls create_invoice exactly once and reads no table from the browser', async () => {
    await createInvoice(INPUT, CTX)
    expect(rpc.calls).toHaveLength(1)
    expect(rpc.calls[0]?.name).toBe('create_invoice')
    // DB-03: the header and the lines are no longer separate round trips, so
    // there is no window in which a header can exist without them.
    expect(db.tablesTouched).toEqual([])
  })

  it('sends the Law 8 key, the actor and the booking — and the VAT rate as a FRACTION', async () => {
    await createInvoice({ ...INPUT, vatPercent: 13 }, CTX)
    const payload = payloadOf()
    expect(payload['client_uuid']).toBe('k-1')
    expect(payload['created_by']).toBe(CTX.userId)
    expect(payload['booking_no']).toBe('880')
    // `invoices.vat_rate` is numeric(5,4). 13% is 0.13, never 13.
    expect(payload['vat_rate']).toBeCloseTo(0.13, 10)
  })

  it('sends no line data at all — the invoice bills the booking, not a form (SPEC-P0-1 §3.1)', async () => {
    await createInvoice(INPUT, CTX)
    const payload = payloadOf()
    expect(payload['lines']).toBeUndefined()
    // And no money column travels to the browser on the way to being written.
    const keys = Object.keys(payload)
    for (const forbidden of ['rate', 'discount_amount', 'delivery_charge', 'fuel_charge', 'supplier_cost']) {
      expect(keys).not.toContain(forbidden)
    }
  })

  it('trims the booking number and drops an empty note to null', async () => {
    await createInvoice({ ...INPUT, bookingNo: '  880  ', notes: '   ' }, CTX)
    expect(payloadOf()['booking_no']).toBe('880')
    expect(payloadOf()['notes']).toBeNull()
  })

  it('returns the totals POSTGRES computed, in paisa', async () => {
    const result = await createInvoice(INPUT, CTX)
    expect(result.invoiceId).toBe(WROTE.invoice_id)
    expect(result.bookingId).toBe(WROTE.booking_id)
    expect(result.bookingNo).toBe('880')
    expect(result.clientId).toBe(WROTE.client_id)
    expect(result.status).toBe('Draft')
    expect(result.dueDateAd).toBe('2026-09-14')
    expect(result.linesWritten).toBe(3)
    expect(result.subtotalPaisa).toBe(2_100_000)
    expect(result.discountPaisa).toBe(210_000)
    expect(result.taxablePaisa).toBe(1_890_000)
    expect(result.vatPaisa).toBe(245_700)
    expect(result.totalPaisa).toBe(2_135_700)
  })

  it('accepts the numeric-as-string figures postgrest-js may hand back', async () => {
    rpc.result = { data: { ...WROTE, subtotal: '21000.00', total: '21357.00' }, error: null }
    const result = await createInvoice(INPUT, CTX)
    expect(result.subtotalPaisa).toBe(2_100_000)
    expect(result.totalPaisa).toBe(2_135_700)
  })

  it('R-15 — a Draft carries no number, and the event says so rather than omitting it', async () => {
    const result = await createInvoice(INPUT, CTX)
    expect(result).not.toHaveProperty('invoiceNo')
    expect(result.status).toBe('Draft')
  })
})

describe('createInvoice — Law 8 replay', () => {
  it('passes the replay through: the same id, and nothing was written', async () => {
    rpc.result = { data: { ...WROTE, replayed: true }, error: null }
    const result = await createInvoice(INPUT, CTX)

    expect(result.invoiceId).toBe(WROTE.invoice_id)
    expect(result.replayed).toBe(true)
    // A replay is still exactly one dispatch — the action never retries on its
    // own, because a retry it invented would carry the same key and prove
    // nothing about the one the operator pressed.
    expect(rpc.calls).toHaveLength(1)
  })

  it('two calls with the same key return the same invoice and write nothing twice', async () => {
    const first = await createInvoice(INPUT, CTX)
    rpc.result = { data: { ...WROTE, replayed: true }, error: null }
    const second = await createInvoice(INPUT, CTX)

    expect(second.invoiceId).toBe(first.invoiceId)
    expect(second.replayed).toBe(true)
    expect(first.replayed).toBe(false)
    // Both went to the same function with the same key; the database, not this
    // file, is what makes the second one write nothing.
    expect(rpc.calls.map((c) => c.name)).toEqual(['create_invoice', 'create_invoice'])
    expect(payloadOf(0)['client_uuid']).toBe(payloadOf(1)['client_uuid'])
  })

  it('refuses a replay whose invoice has left Draft — that is Void + Credit Note (R-04)', async () => {
    rpc.result = { data: { ...WROTE, status: 'Sent', invoice_no: 'INV-121', replayed: true }, error: null }
    await expect(createInvoice(INPUT, CTX)).rejects.toThrow(/no longer a Draft/i)
  })
})

describe('createInvoice — refusals name the cause, inline (Law 12)', () => {
  /*
   * Two layers refuse this, and `lib/rbac` gets there first: `invoice.create`
   * resolves through `canIssueInvoice`, which is itself offline-aware, so the
   * dispatcher rejects before `execute` is entered and the sentence the
   * operator sees is the permission one. The action's own guard (naming the
   * totals) is the backstop for a caller that reaches `execute` another way.
   * What matters at both layers is the same: nothing is dispatched.
   */
  it('offline: refuses without dispatching, because a queued invoice has no totals', async () => {
    await expect(createInvoice(INPUT, { ...CTX, isOnline: false })).rejects.toThrow()
    expect(rpc.calls).toHaveLength(0)
  })

  it('validates the Law 8 key before anything leaves the browser', async () => {
    await expect(createInvoice({ ...INPUT, clientUuid: '' }, CTX)).rejects.toThrow(/idempotency key/i)
    expect(rpc.calls).toHaveLength(0)
  })

  it('validates the booking and the VAT rate', async () => {
    await expect(createInvoice({ ...INPUT, bookingNo: '  ' }, CTX)).rejects.toThrow(/must name the booking/i)
    await expect(createInvoice({ ...INPUT, vatPercent: 130 }, CTX)).rejects.toThrow(/between 0 and 100/i)
    expect(rpc.calls).toHaveLength(0)
  })

  it('42883 — names 0096 rather than repeating "function does not exist"', async () => {
    rpc.result = { data: null, error: { code: '42883', message: 'function create_invoice(jsonb) does not exist' } }
    await expect(createInvoice(INPUT, CTX)).rejects.toThrow(/0096_create_invoice_rpc\.sql/)
  })

  it('23502 on invoice_no — names 0086 and R-15, not the column', async () => {
    rpc.result = { data: null, error: { code: '23502', message: 'null value in column "invoice_no" violates not-null constraint' } }
    await expect(createInvoice(INPUT, CTX)).rejects.toThrow(/0086_invoice_write_rights_and_draft_without_number/)
  })

  it('42501 — passes the role refusal through and points at 0086 for the RLS case', async () => {
    rpc.result = {
      data: null,
      error: { code: '42501', message: 'create_invoice: this session (Coordinator) may not raise an invoice.' },
    }
    await expect(createInvoice(INPUT, CTX)).rejects.toThrow(/may not raise an invoice/)
  })

  it('any other failure is reported as NOT raised, never as a partial success', async () => {
    rpc.result = { data: null, error: { code: '23505', message: 'duplicate key value violates unique constraint' } }
    await expect(createInvoice(INPUT, CTX)).rejects.toThrow(/treat it as not raised/i)
  })

  it('a success that returned no invoice_id is treated as NOT created', async () => {
    rpc.result = { data: { replayed: false }, error: null }
    await expect(createInvoice(INPUT, CTX)).rejects.toThrow(/treat this as NOT created/i)
  })

  it('a null body from a backend that reported success is treated as NOT created', async () => {
    rpc.result = { data: null, error: null }
    await expect(createInvoice(INPUT, CTX)).rejects.toThrow(/treat this as NOT created/i)
  })
})

/**
 * The DATA-01 regression guard.
 *
 * Nothing else binds an action's SELECT projection to the live grant set: the
 * query layer carries the discipline by convention (`booking_lines_v`,
 * `booking_transport_v`) and `src/actions` has no rule, no lint and no type
 * that says a base-table projection may name only granted columns. A mocked
 * client normally cannot catch that, because a mock has no grants — so this
 * mock refuses `.from()` outright. Any re-acquired table read, on any path
 * exercised here, fails with the name of the table it reached for.
 *
 * ⚠ It can only speak for the paths these tests take. It is a floor, not a
 * proof; the proof is `0096`'s post-conditions, which run against a real grant
 * set. The stronger static check — reading this file's source and asserting it
 * names no revoked column — is not available: `tsconfig.json` carries no Node
 * types, so a suite under `src/` cannot import `node:fs`.
 */
describe('createInvoice — DATA-01 cannot come back', () => {
  it('reaches for no table on the happy path', async () => {
    await createInvoice(INPUT, CTX)
    expect(db.tablesTouched).toEqual([])
  })

  it('reaches for no table on a refusal either — not even to explain itself', async () => {
    rpc.result = { data: null, error: { code: '42501', message: 'refused' } }
    await expect(createInvoice(INPUT, CTX)).rejects.toThrow()
    expect(db.tablesTouched).toEqual([])
  })

  it('dispatches create_invoice and no other function', async () => {
    await createInvoice(INPUT, CTX)
    expect(rpc.calls.map((c) => c.name)).toEqual(['create_invoice'])
  })
})
</file>

<file path="src/actions/finance/__tests__/recordPayment.test.ts">
/**
 * RECORD_PAYMENT — the write, and the six ways it must refuse.
 *
 * Every assertion here exists because the failure it pins is INVISIBLE on the
 * screen. A payment that was never written, a payment written 100× too large,
 * and a payment written correctly all look identical to the operator: the modal
 * closes and a toast says "Payment Recorded". Only a test can tell them apart.
 *
 * The boundaries mocked are `lib/dataAccess` (the write) and `lib/supabase`
 * (the invoice lookup and the number allocator) — the same two seams
 * `lib/queries/__tests__/finance.test.ts` mocks. Nothing about the action's own
 * logic is stubbed.
 */
import { describe, it, expect, beforeEach, vi } from 'vitest'

const access = vi.hoisted(() => ({
  inserts: [] as Array<{ table: string; payload: Record<string, unknown> }>,
  updateCalls: [] as unknown[][],
  /** What `idempotentInsert` hands back. Overridden per test to model its odd branches. */
  insertResult: { data: {} as unknown, error: null as unknown },
}))

vi.mock('../../../lib/dataAccess', () => ({
  idempotentInsert: async (table: string, payload: Record<string, unknown>) => {
    access.inserts.push({ table, payload })
    return access.insertResult
  },
  /*
   * Law 4. Present only so that a future edit which reaches for it fails loudly
   * here instead of at the database. `payments` is on `dataAccess`'s own
   * immutable list and `trg_payments_reject_update` (0046) is live, but a test
   * that says so is cheaper than a 500 an operator has to report.
   */
  safeUpdate: async (...args: unknown[]) => {
    access.updateCalls.push(args)
    throw new Error('safeUpdate must never be reached from a payment write — Law 4')
  },
}))

const db = vi.hoisted(() => {
  const state = {
    invoiceRow: null as Record<string, unknown> | null,
    invoiceError: null as { message: string } | null,
    rpc: { data: 'PAY-2026-0001' as unknown, error: null as { message: string } | null },
    tablesRead: [] as string[],
    invoiceNosQueried: [] as string[],
    rpcCalls: [] as Array<{ fn: string; args: unknown }>,
  }

  const builder: Record<string, unknown> = {}
  builder['select'] = () => builder
  builder['eq'] = (column: string, value: string) => {
    if (column === 'invoice_no') state.invoiceNosQueried.push(value)
    return builder
  }
  builder['maybeSingle'] = async () => ({ data: state.invoiceRow, error: state.invoiceError })

  return {
    state,
    supabase: {
      from: (table: string) => {
        state.tablesRead.push(table)
        return builder
      },
      rpc: async (fn: string, args: unknown) => {
        state.rpcCalls.push({ fn, args })
        return state.rpc
      },
    },
  }
})

vi.mock('../../../lib/supabase', () => ({
  supabase: db.supabase,
  newClientUuid: () => '00000000-0000-4000-8000-000000000000',
}))

const { recordPayment } = await import('../recordPayment')

/** Owner is one of the three roles `rbac.canRecordPayment` admits. */
const CTX = { userId: 'aaaaaaaa-0000-4000-8000-000000000001', role: 'Owner' as const, isOnline: true }

const LIVE_INVOICE = {
  id: '11111111-1111-4111-8111-111111111111',
  invoice_no: 'INV-492',
  booking_id: '22222222-2222-4222-8222-222222222222',
  client_id: '33333333-3333-4333-8333-333333333333',
  branch_id: '44444444-4444-4444-8444-444444444444',
  voided_at: null,
}

/** A well-formed submit. Rs 1,500 typed in the modal becomes 150 000 paisa. */
const INPUT = {
  invoiceNo: 'INV-492',
  amountPaisa: 150_000,
  paymentMethod: 'eSewa',
  reference: 'TXN-9948123',
  notes: 'Advance for the Pokhara shoot',
  clientUuid: '55555555-5555-4555-8555-555555555555',
}

beforeEach(() => {
  access.inserts.length = 0
  access.updateCalls.length = 0
  access.insertResult = {
    data: { id: '66666666-6666-4666-8666-666666666666', payment_no: 'PAY-2026-0001' },
    error: null,
  }
  db.state.invoiceRow = { ...LIVE_INVOICE }
  db.state.invoiceError = null
  db.state.rpc = { data: 'PAY-2026-0001', error: null }
  db.state.tablesRead.length = 0
  db.state.invoiceNosQueried.length = 0
  db.state.rpcCalls.length = 0
})

describe('recordPayment — the row it writes', () => {
  it('writes ONE row, into `payments`, and nothing else', async () => {
    await recordPayment(INPUT, CTX)
    expect(access.inserts).toHaveLength(1)
    expect(access.inserts[0]!.table).toBe('payments')
    // Law 1: the invoice's paid/outstanding/status are moved by
    // sync_payment_to_invoice() (0010:245-283), never by this action.
    expect(access.updateCalls).toHaveLength(0)
  })

  it('converts paisa → RUPEES exactly once — the 100× bug that still looks plausible', async () => {
    await recordPayment(INPUT, CTX)
    // `payments.amount` is numeric(14,2) in rupees. 150 000 paisa is Rs 1,500 —
    // NOT 150000, and NOT 15.
    expect(access.inserts[0]!.payload['amount']).toBe(1500)
  })

  it('takes `payment_no` from next_document_number(), never from the clock', async () => {
    await recordPayment(INPUT, CTX)
    expect(db.state.rpcCalls).toEqual([{ fn: 'next_document_number', args: { p_sequence_key: 'payment' } }])
    expect(access.inserts[0]!.payload['payment_no']).toBe('PAY-2026-0001')
  })

  it('carries the caller`s Law 8 key unchanged, so a replay dedups instead of double-charging', async () => {
    await recordPayment(INPUT, CTX)
    expect(access.inserts[0]!.payload['client_uuid']).toBe(INPUT.clientUuid)
  })

  it('fills every NOT NULL FK from the invoice, not from the caller', async () => {
    await recordPayment(INPUT, CTX)
    const payload = access.inserts[0]!.payload
    expect(db.state.invoiceNosQueried).toEqual(['INV-492'])
    expect(payload['invoice_id']).toBe(LIVE_INVOICE.id)
    expect(payload['booking_id']).toBe(LIVE_INVOICE.booking_id)
    expect(payload['client_id']).toBe(LIVE_INVOICE.client_id)
    expect(payload['branch_id']).toBe(LIVE_INVOICE.branch_id)
    expect(payload['received_by']).toBe(CTX.userId)
  })

  it('records an Advance Payment in status Received — Law 5 forbids the deposit type outright', async () => {
    await recordPayment(INPUT, CTX)
    const payload = access.inserts[0]!.payload
    expect(payload['payment_type']).toBe('Advance Payment')
    expect(payload['payment_type']).not.toBe('Security Deposit')
    // sync_payment_to_invoice() sums only 'Received' rows; any other status
    // writes a payment that never moves the invoice.
    expect(payload['status']).toBe('Received')
  })

  it('leaves the server to stamp payment_date and to choose no bank account', async () => {
    await recordPayment(INPUT, CTX)
    const payload = access.inserts[0]!.payload
    // Law 7 — the DB default is `now()` in UTC and cannot be skewed by the
    // operator's device clock.
    expect(payload).not.toHaveProperty('payment_date')
    // No account chosen means NO bank_account_id at all — never one inferred
    // from the method label, which would credit an account nobody chose. See
    // METHOD: the label→account mapping remains forbidden.
    expect(payload).not.toHaveProperty('bank_account_id')
  })

  it('writes the CHOSEN account id to bank_account_id — the structured half of "how was this paid"', async () => {
    const accountId = '77777777-7777-4777-8777-777777777777'
    await recordPayment({ ...INPUT, bankAccountId: accountId }, CTX)
    const payload = access.inserts[0]!.payload
    expect(payload['bank_account_id']).toBe(accountId)
    // The method label still lands in notes either way — the account id is in
    // addition to the operator's word, not a replacement for it.
    expect(payload['notes']).toBe('Method: eSewa\nAdvance for the Pokhara shoot')
  })

  it('refuses a bank account that is not a row id — a label where a uuid belongs', async () => {
    await expect(recordPayment({ ...INPUT, bankAccountId: 'eSewa' }, CTX)).rejects.toThrow(/account list/)
    expect(access.inserts).toHaveLength(0)
  })

  it('puts the reference in transaction_ref and keeps the method visible in notes', async () => {
    await recordPayment(INPUT, CTX)
    const payload = access.inserts[0]!.payload
    expect(payload['transaction_ref']).toBe('TXN-9948123')
    expect(payload['notes']).toBe('Method: eSewa\nAdvance for the Pokhara shoot')
  })

  it('writes notes as NULL rather than an empty string when there is nothing to say', async () => {
    await recordPayment({ ...INPUT, paymentMethod: undefined, notes: '   ', reference: '  ' }, CTX)
    const payload = access.inserts[0]!.payload
    expect(payload['notes']).toBeNull()
    expect(payload['transaction_ref']).toBeNull()
  })

  it('returns the DB-generated row id, not a client-side string', async () => {
    const result = await recordPayment(INPUT, CTX)
    expect(result.paymentId).toBe('66666666-6666-4666-8666-666666666666')
    expect(result.paymentNo).toBe('PAY-2026-0001')
    expect(result.invoiceId).toBe(LIVE_INVOICE.id)
    expect(result.amountPaisa).toBe(150_000)
  })
})

describe('recordPayment — the refusals, each of which must write nothing', () => {
  it('refuses an invoice number that does not exist, and names it', async () => {
    db.state.invoiceRow = null
    await expect(recordPayment({ ...INPUT, invoiceNo: 'B-715' }, CTX)).rejects.toThrow(/No invoice numbered B-715/)
    expect(access.inserts).toHaveLength(0)
  })

  it('refuses a VOIDED invoice — a payment here would silently un-void it', async () => {
    db.state.invoiceRow = { ...LIVE_INVOICE, voided_at: '2026-08-01T00:00:00.000Z' }
    await expect(recordPayment(INPUT, CTX)).rejects.toThrow(/voided/i)
    expect(access.inserts).toHaveLength(0)
  })

  it('refuses when the number allocator fails, rather than inventing a payment_no', async () => {
    db.state.rpc = { data: null, error: { message: 'sequence locked' } }
    await expect(recordPayment(INPUT, CTX)).rejects.toThrow(/payment number/)
    expect(access.inserts).toHaveLength(0)
  })

  it('refuses a queued write — an optimistic payload is not a recorded payment', async () => {
    /*
     * `idempotentInsert` returns `{ data: <the payload it sent>, error: null }`
     * on its offline and 'Failed to fetch' branches (dataAccess.ts:39-53). That
     * object has no `id`, because only Postgres fills `gen_random_uuid()`. If
     * this action ever accepted it, the modal would close and a toast would
     * announce a payment the ledger had never seen — the exact defect the
     * dispatcher was built to kill, re-created one layer down.
     */
    access.insertResult = { data: { payment_no: 'PAY-2026-0001', amount: 1500 }, error: null }
    await expect(recordPayment(INPUT, CTX)).rejects.toThrow(/queued rather than written/)
  })

  it('refuses when the duplicate-replay re-select comes back with an error', async () => {
    // dataAccess.ts:56-58 is the one branch that returns a populated `error`.
    access.insertResult = { data: null, error: { message: 'permission denied for table payments' } }
    await expect(recordPayment(INPUT, CTX)).rejects.toThrow(/not recorded/)
  })

  it('refuses offline before touching dataAccess, whatever ctx claims', async () => {
    vi.stubGlobal('navigator', { onLine: false })
    try {
      await expect(recordPayment(INPUT, CTX)).rejects.toThrow(/offline/i)
      expect(access.inserts).toHaveLength(0)
      // The lookup must not have run either — nothing at all reached the network.
      expect(db.state.rpcCalls).toHaveLength(0)
    } finally {
      vi.unstubAllGlobals()
    }
  })

  it('refuses a zero, negative, non-finite or fractional-paisa amount', async () => {
    for (const bad of [0, -1, Number.NaN, Number.POSITIVE_INFINITY]) {
      await expect(recordPayment({ ...INPUT, amountPaisa: bad }, CTX)).rejects.toThrow(/greater than zero/)
    }
    await expect(recordPayment({ ...INPUT, amountPaisa: 150.5 }, CTX)).rejects.toThrow(/whole number of paisa/)
    expect(access.inserts).toHaveLength(0)
  })

  it('refuses a submit with no Law 8 key rather than minting one at send time', async () => {
    await expect(recordPayment({ ...INPUT, clientUuid: '' }, CTX)).rejects.toThrow(/idempotency key/)
    expect(access.inserts).toHaveLength(0)
  })

  it('refuses a submit that names no invoice', async () => {
    await expect(recordPayment({ ...INPUT, invoiceNo: '  ' }, CTX)).rejects.toThrow(/name the invoice/)
    expect(access.inserts).toHaveLength(0)
  })

  it('refuses Warehouse — Law 6, through lib/rbac, before validate or execute', async () => {
    await expect(
      recordPayment(INPUT, { userId: 'u-2', role: 'Warehouse', isOnline: true }),
    ).rejects.toThrow(/payment\.create/)
    expect(access.inserts).toHaveLength(0)
  })

  it('refuses a caller with no session context — a payment has an actor or it is not recorded', async () => {
    await expect(recordPayment(INPUT)).rejects.toThrow(/session context/)
    expect(access.inserts).toHaveLength(0)
  })
})
