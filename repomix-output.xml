}

.new-rental-equipment-selection .data-table-shell {
  border: 1px solid var(--border);
  border-radius: var(--r-input);
}

.new-rental-equipment-extras {
  container: equipment-extras / inline-size;
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px solid var(--border);
}

.new-rental-equipment-extras-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8px 16px;
}

.new-rental-equipment-extras-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.new-rental-equipment-line-form {
  scroll-margin-top: var(--new-rental-scroll-clearance, 16px);
  margin-top: 12px;
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: var(--r-card);
  background: var(--surface);
}

.new-rental-equipment-line-fields {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
