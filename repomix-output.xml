  clientPreview?: ClientPreview | undefined
  canViewFinance: boolean
  stage?: BookingStage | undefined
  packingStatus?: PackingStatus | undefined
  restricted?: boolean | undefined
  sheet?: boolean
  onClose: () => void
  onAction: (id: HoverActionId) => void
}) {
  const [stack, setStack] = useState<HoverCardStackEntry[]>([{ entityType, preview, clientPreview }])
  const top = stack[stack.length - 1]
  const current = useMemo(
    () => (top === undefined ? { entityType, preview } : top),
    [top, entityType, preview],
  )
  const large = current.entityType === 'rental'

  const actions = useMemo(
    () =>
      getHoverActions({
        entityType: current.entityType,
        context,
        role,
        stage: current.entityType === 'rental' ? stage : undefined,
        packingStatus: packingStatus,
        restricted,
      }),
    [context, current.entityType, packingStatus, restricted, role, stage],
  )

  const openClient = useMemo(() => {
    const cp = current.entityType === 'rental' ? (current as { clientPreview?: ClientPreview | undefined }).clientPreview : undefined
    if (current.entityType !== 'rental' || cp === undefined) return null
    return () => setStack((s) => [...s, { entityType: 'client', preview: cp }])
  }, [current])

  const goBack = (): void => setStack((s) => (s.length > 1 ? s.slice(0, -1) : s))

  const handleAction = (id: HoverActionId): void => {
    onAction(id)
  }

  const defaultTab = defaultTabForContext(current.entityType, context)
  const innerAction = (id: string): void => {
    const known = id as HoverActionId
    handleAction(known)
  }

  return (
    <SmartHoverShell
      labelledBy="smart-hover-title"
      large={large}
      sheet={sheet}
      onClose={() => {
        if (stack.length > 1) goBack()
        else onClose()
      }}
      header={
        <div style={{ display: 'flex', alignItems: 'center', gap: 8, padding: stack.length > 1 ? '8px 14px 0' : '0 14px' }}>
          {stack.length > 1 ? (
            <button type="button" onClick={goBack} aria-label="Back to previous preview" style={{ minHeight: 'var(--tap)', background: 'none', border: 'none', color: 'var(--link)', cursor: 'pointer', display: 'inline-flex', gap: 4, alignItems: 'center' }}>
              <Icon name="chevron_left" size={16} /> Back
            </button>
          ) : null}
        </div>
      }
      footer={
        <SmartHoverFooter
          primary={actions.primary ? <ActionButton id={actions.primary} primary onAction={handleAction} /> : null}
          secondary={actions.secondary && actions.secondary !== actions.primary ? <ActionButton id={actions.secondary} onAction={handleAction} /> : null}
          overflow={actions.overflow.length > 0 ? <OverflowMenu ids={actions.overflow} onAction={handleAction} /> : null}
        />
      }
    >
      {current.entityType === 'client' ? (
        <ClientHoverCard preview={current.preview as ClientPreview} canViewFinance={canViewFinance} defaultTab={defaultTab} onAction={innerAction} />
      ) : null}
      {current.entityType === 'equipment' ? (
        <EquipmentHoverCard preview={current.preview as EquipmentPreview} canViewFinance={canViewFinance} defaultTab={defaultTab} onAction={innerAction} />
      ) : null}
      {current.entityType === 'rental' ? (
        <RentalHoverCard
          preview={current.preview as RentalPreview}
          canViewFinance={canViewFinance}
          defaultTab={defaultTab}
          onAction={innerAction}
          onOpenClient={openClient ?? (() => undefined)}
        />
      ) : null}
      {current.entityType === 'invoice' || current.entityType === 'document' || current.entityType === 'payment' ? (
        <DocumentHoverCard preview={current.preview as InvoicePreview} canViewFinance={canViewFinance} />
      ) : null}
    </SmartHoverShell>
  )
}

function ActionButton({ id, primary = false, onAction }: { id: HoverActionId; primary?: boolean; onAction: (id: HoverActionId) => void }) {
  const meta = ACTION_LABEL[id]
  return <HoverActionButton label={meta.label} primary={primary} onAction={() => onAction(id)} icon={<Icon name={meta.icon} size={15} />} />
}

function OverflowMenu({ ids, onAction }: { ids: HoverActionId[]; onAction: (id: HoverActionId) => void }) {
  const [open, setOpen] = useState(false)
  return (
    <span style={{ position: 'relative' }}>
      <button
        type="button"
        aria-label="More actions"
        aria-expanded={open}
        aria-haspopup="menu"
        onClick={() => setOpen((v) => !v)}
        style={{ minWidth: 'var(--tap)', minHeight: 'var(--tap)', borderRadius: 999, border: '1px solid var(--btn-secondary-border)', background: 'transparent', color: 'var(--text)', cursor: 'pointer' }}
      >
        <Icon name="more_vert" size={18} />
      </button>
      {open ? (
        <span role="menu" style={{ position: 'absolute', right: 0, bottom: 'calc(100% + 8px)', minWidth: 200, background: 'var(--dropdown)', border: '1px solid var(--border)', borderRadius: 'var(--r-modal)', boxShadow: 'var(--shadow-modal)', padding: 4, zIndex: 'var(--z-dropdown)' }}>
          {ids.map((id) => (
            <button
              key={id}
              role="menuitem"
              type="button"
              onClick={() => {
                setOpen(false)
                onAction(id)
              }}
              style={{ display: 'flex', width: '100%', gap: 8, alignItems: 'center', minHeight: 'var(--tap)', padding: '8px 10px', background: 'none', border: 'none', color: 'var(--text)', fontSize: 13, cursor: 'pointer', textAlign: 'left' }}
            >
              <Icon name={ACTION_LABEL[id].icon} size={15} />
              {ACTION_LABEL[id].label}
            </button>
          ))}
        </span>
      ) : null}
    </span>
  )
}
</file>

<file path="src/components/smart-hover/SmartHoverShell.tsx">
/**
 * SmartHoverShell — one shared card frame for every entity (§3, §5).
 *
 * Sticky header + sticky tabs + scrollable body + sticky footer.
 * Desktop hover card (360 / 380 large) and mobile bottom sheet (≤70vh)
 * share this frame so the information architecture never forks (§10, §17).
 *
 * Babin tokens only. Radius 14 per spec §4. Animation is opacity +
 * scale .985 over ≤150ms (§85) — no bounce, no spring overshoot on
 * frequent table interactions. Blur lives on the fixed sheet backdrop
 * only, never on scrolling content.
 */

import { type CSSProperties, type ReactNode } from 'react'
import { HOVER_DIMS, HOVER_TIMING } from '../../lib/smartHover'
import './smart-intel.css'

interface ShellProps {
  labelledBy: string
  large?: boolean
  sheet?: boolean
  header: ReactNode
  tabs?: ReactNode
  footer: ReactNode
  children: ReactNode
  onClose: () => void
}

const frame: CSSProperties = {
  display: 'flex',
  flexDirection: 'column',
  background: 'var(--surface-card, var(--card))',
  color: 'var(--text)',
  border: '1px solid var(--border)',
  borderRadius: `${HOVER_DIMS.radius}px`,
  boxShadow: 'var(--shadow-modal)',
  overflow: 'hidden',
  minWidth: 0,
  boxSizing: 'border-box',
  overflowWrap: 'anywhere',
  animation: `smart-hover-in ${HOVER_TIMING.animMs}ms cubic-bezier(0.16, 1, 0.3, 1)`,
}

export function SmartHoverShell({ labelledBy, large = false, sheet = false, header, tabs, footer, children, onClose }: ShellProps) {
  const width = large === true ? HOVER_DIMS.widthLarge : HOVER_DIMS.width
  const style: CSSProperties = sheet
    ? {
        ...frame,
        width: 'min(calc(100vw - 32px), 480px)',
        maxHeight: '70vh',
        borderRadius: '16px 16px 0 0',
      }
    : {
        ...frame,
        width: `${width}px`,
        minWidth: `min(${HOVER_DIMS.minWidth}px, calc(100vw - 32px))`,
        maxWidth: `min(${HOVER_DIMS.maxWidth}px, calc(100vw - 32px))`,
        maxHeight: `min(${HOVER_DIMS.maxHeight}px, calc(100vh - 32px))`,
      }

  return (
    <div role="dialog" aria-modal={sheet} aria-labelledby={labelledBy} data-testid="smart-hover-card" style={style}>
      <style>{`@keyframes smart-hover-in { from { opacity: 0; transform: scale(0.985); } to { opacity: 1; transform: scale(1); } }`}</style>
      <div style={{ flex: '0 0 auto', borderBottom: '1px solid var(--border)', background: 'var(--card)' }}>
        {sheet ? (
          <div style={{ display: 'flex', justifyContent: 'center', paddingTop: 8 }} aria-hidden="true">
            <span style={{ width: 40, height: 4, borderRadius: 999, background: 'var(--border2)' }} />
          </div>
        ) : null}
        {header}
        {tabs}
      </div>
      <div style={{ flex: '1 1 auto', overflowY: 'auto', minHeight: 0, padding: '12px 14px' }}>{children}</div>
      <div style={{ flex: '0 0 auto', borderTop: '1px solid var(--border)', padding: '10px 12px', background: 'var(--card)' }}>
        {footer}
        <span style={{ position: 'absolute', width: 1, height: 1, overflow: 'hidden', clip: 'rect(0 0 0 0)' }}>
          <button type="button" onClick={onClose} aria-label="Close preview (Esc)" tabIndex={-1} />
        </span>
      </div>
    </div>
  )
}

export function SmartHoverTabs({
  tabs,
  active,
  onChange,
}: {
  tabs: ReadonlyArray<{ id: string; label: string; count?: number }>
  active: string
  onChange: (id: string) => void
}) {
  return (
    <div role="tablist" aria-label="Preview sections" className="smart-intel-tabs">
      {tabs.map((t) => {
        const selected = t.id === active
        return (
          <button
            key={t.id}
            role="tab"
            type="button"
            className="smart-intel-tab"
            aria-selected={selected}
            aria-label={typeof t.count === 'number' ? `${t.label} (${t.count})` : t.label}
            onClick={() => onChange(t.id)}
          >
            {t.label}
            {typeof t.count === 'number' ? <span className="smart-intel-count" aria-hidden="true">{t.count}</span> : null}
          </button>
        )
      })}
    </div>
  )
}

export function SmartHoverFooter({
  primary,
  secondary,
  overflow,
}: {
  primary: ReactNode | null
  secondary: ReactNode | null
  overflow: ReactNode | null
}) {
  return (
    <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
      {primary}
      {secondary}
      <span style={{ flex: 1 }} />
      {overflow}
    </div>
  )
}

export function HoverActionButton({
  label,
  icon,
  primary = false,
  onAction,
}: {
  label: string
  icon?: ReactNode
  primary?: boolean
  onAction: () => void
}) {
  return (
    <button
      type="button"
      onClick={onAction}
      data-primary-verb={primary ? true : undefined}
      style={{
        display: 'inline-flex',
        alignItems: 'center',
        gap: 8,
        minHeight: 'var(--tap)',
        padding: '10px 14px',
        borderRadius: 999,
        border: primary ? 'none' : '1px solid var(--btn-secondary-border)',
        background: primary ? 'var(--btn-primary-bg)' : 'var(--btn-secondary-bg)',
        color: primary ? 'var(--btn-primary-fg)' : 'var(--text)',
        fontFamily: 'var(--font-display)',
        fontSize: '13px',
        fontWeight: 600,
        cursor: 'pointer',
      }}
    >
      <span>{label}</span>
      {icon ? (
        <span
          style={{
            display: 'inline-flex',
            alignItems: 'center',
            justifyContent: 'center',
            width: 28,
            height: 28,
            borderRadius: '50%',
            background: primary ? 'rgba(255,255,255,0.18)' : 'var(--w08)',
          }}
          aria-hidden="true"
        >
          {icon}
        </span>
      ) : null}
    </button>
  )
}
