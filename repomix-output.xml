<file path="src/lib/queries/__tests__/facetCounts.test.ts">
/**
 * §10's option counts.
 *
 * One rule carries the whole feature and it is the one that is easy to get
 * wrong, so it is asserted twice from two directions: an option is counted with
 * its OWN group's selection dropped, and with every other group still applied.
 */
import { describe, it, expect } from 'vitest'
import { countFacet } from '../facetCounts'
import type { ListFilters } from '../listQuery'

/** Records what was asked, and answers with the number of predicates it saw. */
function recorder(answer: (filters: ListFilters) => number | null = () => 1) {
  const calls: ListFilters[] = []
  return {
    calls,
    countRows: async (filters: ListFilters) => {
      calls.push(filters)
      return answer(filters)
    },
  }
}

describe('countFacet', () => {
  it('asks once per option', async () => {
    const r = recorder()
    const counts = await countFacet(r.countRows, {}, 'stage', ['Booked', 'Packed', 'Out'])
    expect(r.calls).toHaveLength(3)
    expect(counts).toEqual({ Booked: 1, Packed: 1, Out: 1 })
  })

  it('drops the group it is counting, so ticking one option does not zero its siblings', async () => {
    const r = recorder()
    await countFacet(r.countRows, { chips: { stage: ['Booked'] } }, 'stage', ['Booked', 'Packed'])
    // Every call carries exactly the one value it is counting — never the
    // existing Booked selection, which would make `Packed` come back 0 and the
    // group impossible to widen.
    expect(r.calls.map((c) => c.chips?.stage)).toEqual([['Booked'], ['Packed']])
  })

  it('KEEPS every other group, so the number is specific to where the user is', async () => {
    const r = recorder()
    await countFacet(
      r.countRows,
      { chips: { stage: ['Booked'], category: ['Camera'] }, search: 'fx3', presence: { cancelled_at: false } },
      'stage',
      ['Packed'],
    )
    const only = r.calls[0]!
    expect(only.chips?.category).toEqual(['Camera'])
    expect(only.search).toBe('fx3')
    expect(only.presence).toEqual({ cancelled_at: false })
  })

  it('never counts a single page or an ordering', async () => {
    const r = recorder()
    await countFacet(r.countRows, { page: { index: 3, size: 20 }, sort: { column: 'pickup_at' } }, 'stage', ['Packed'])
    // A count of page 4 is not a count.
    expect(r.calls[0]!.page).toBeUndefined()
    expect(r.calls[0]!.sort).toBeUndefined()
  })

  it('reports a failed count as null, never as 0', async () => {
    // 0 tells the operator that clicking this option empties the list. That is
    // a lie in the one direction that stops them looking.
    const countRows = async (filters: ListFilters) => {
      if (filters.chips?.['stage']?.[0] === 'Packed') throw new Error('JWT expired')
      return 7
    }
    const counts = await countFacet(countRows, {}, 'stage', ['Booked', 'Packed'])
    expect(counts).toEqual({ Booked: 7, Packed: null })
  })
})
</file>

<file path="src/lib/queries/__tests__/filterParams.test.ts">
/**
 * Filters ⇄ the query string, §18.
 *
 * The claims worth pinning here are the ones that make a URL trustworthy: a set
 * that survives a round trip unchanged, a removed filter that does not come
 * back, and params belonging to someone else that are still there afterwards.
 */
import { describe, it, expect } from 'vitest'
import {
  conflictingColumns,
  parseExtras,
  parseFilterParams,
  writeFilterParams,
  RESERVED_PARAMS,
  type FilterParamSchema,
} from '../filterParams'
import type { ListFilters } from '../listQuery'

const SCHEMA: FilterParamSchema = {
  chips: ['stage', 'category'],
  presence: ['cancelled_at'],
  dateColumn: 'pickup_at',
  sortColumns: ['pickup_at', 'return_at'],
  pageSize: 20,
}

const write = (filters: ListFilters, from = '') =>
  writeFilterParams(new URLSearchParams(from), filters, SCHEMA).toString()

const read = (search: string) => parseFilterParams(new URLSearchParams(search), SCHEMA)

describe('writeFilterParams', () => {
  it('writes nothing for an empty filter set', () => {
    expect(write({})).toBe('')
  })

  it('writes each chip value as its own repeated param, not a comma list', () => {
    // Repeated keys have no delimiter to collide with — see the module header.
    expect(write({ chips: { stage: ['Booked', 'Packed'] } })).toBe('stage=Booked&stage=Packed')
  })

  it('leaves params it does not own exactly where they were', () => {
    const out = write({ chips: { stage: ['Booked'] } }, 'tab=money&ref=email')
    expect(out).toContain('tab=money')
    expect(out).toContain('ref=email')
  })

  it('DROPS a param whose filter has gone', () => {
    // The failure this prevents: ?stage=Booked left on a URL whose Stage group
    // is empty silently reapplies itself on the next refresh.
    expect(write({}, 'stage=Booked&q=fx3')).toBe('')
  })

  it('omits the sort direction when it is the default', () => {
    expect(write({ sort: { column: 'pickup_at', ascending: true } })).toBe('sort=pickup_at')
    expect(write({ sort: { column: 'pickup_at', ascending: false } })).toBe('dir=desc&sort=pickup_at')
  })

  it('refuses to write a sort column the page did not declare', () => {
    expect(write({ sort: { column: 'secret_cost', ascending: true } })).toBe('')
  })

  it('writes the page 1-based, and omits page 1', () => {
    expect(write({ page: { index: 0, size: 20 } })).toBe('')
    expect(write({ page: { index: 3, size: 20 } })).toBe('page=4')
  })

  it('is stable — the same filters always produce the same string', () => {
    const a = write({ chips: { stage: ['Booked'], category: ['Camera'] }, search: 'fx3' })
    const b = write({ search: 'fx3', chips: { category: ['Camera'], stage: ['Booked'] } })
    expect(a).toBe(b)
  })
})

describe('parseFilterParams', () => {
  it('ignores params the page did not declare', () => {
    // A filter layer that swallowed ?tab= would send tab IN ('money') to Postgres.
    expect(read('tab=money&utm_source=email')).toEqual({})
  })

  it('reads repeated chip params into one group', () => {
    expect(read('stage=Booked&stage=Packed').chips?.stage).toEqual(['Booked', 'Packed'])
  })

  it('de-duplicates a doubled value', () => {
    // Two identical chips with one removal between them is not a state anyone asked for.
    expect(read('stage=Booked&stage=Booked').chips?.stage).toEqual(['Booked'])
  })

  it('reads presence as a tri-state, and treats anything else as absent', () => {
    expect(read('has_cancelled_at=0').presence?.cancelled_at).toBe(false)
    expect(read('has_cancelled_at=1').presence?.cancelled_at).toBe(true)
    expect(read('has_cancelled_at=maybe').presence).toBeUndefined()
  })

  it('reads a one-ended date range', () => {
    expect(read('from=2026-08-01')).toEqual({ dateRange: { column: 'pickup_at', fromAd: '2026-08-01' } })
  })

  it('ignores a sort column the page did not declare', () => {
    expect(read('sort=secret_cost').sort).toBeUndefined()
  })

  it('treats a hand-edited page of 0 or -3 as page 1 rather than an error', () => {
    expect(read('page=0').page).toBeUndefined()
    expect(read('page=-3').page).toBeUndefined()
    expect(read('page=nonsense').page).toBeUndefined()
    expect(read('page=4').page).toEqual({ index: 3, size: 20 })
  })

  it('round-trips a full filter set unchanged', () => {
    const filters: ListFilters = {
      search: 'fx3',
      chips: { stage: ['Booked', 'Packed'], category: ['Camera'] },
      presence: { cancelled_at: false },
      dateRange: { column: 'pickup_at', fromAd: '2026-08-01', toAd: '2026-08-07' },
      sort: { column: 'return_at', ascending: false },
      page: { index: 2, size: 20 },
    }
    expect(read(write(filters))).toEqual(filters)
  })

  it('round-trips a search term containing a comma', () => {
    // `Karki, Rupesh` is the term that forced listQuery's sanitiser to exist.
    // A comma-delimited param list would split it into two filters here.
    expect(read(write({ search: 'Karki, Rupesh' })).search).toBe('Karki, Rupesh')
  })
})

describe('parseExtras — non-column params', () => {
  const SCHEMA_X: FilterParamSchema = { chips: ['stage'], extras: ['quick', 'ref'] }

  it('reads a declared extra and ignores an undeclared one', () => {
    expect(parseExtras(new URLSearchParams('quick=Overdue&tab=money'), SCHEMA_X)).toEqual({ quick: 'Overdue' })
  })

  it('never puts an extra into the filters', () => {
    // `?quick=Overdue` must not become `view IN ('Overdue')` against a column
    // that does not exist.
    expect(parseFilterParams(new URLSearchParams('quick=Overdue'), SCHEMA_X)).toEqual({})
  })
})

describe('allow — a query string is user input', () => {
  const GUARDED: FilterParamSchema = {
    chips: ['stage'],
    extras: ['quick'],
    allow: { stage: ['Booked', 'Packed'], quick: ['Overdue'] },
  }

  it('drops a chip value outside the declared vocabulary', () => {
    const out = parseFilterParams(new URLSearchParams('stage=Booked&stage=Nonsense'), GUARDED)
    expect(out.chips?.stage).toEqual(['Booked'])
  })

  it('drops the group entirely when nothing survives', () => {
    // Not an empty array: `applyListFilters` reads `[]` as "no constraint".
    expect(parseFilterParams(new URLSearchParams('stage=DropTable'), GUARDED).chips).toBeUndefined()
  })

  it('drops an extra outside its vocabulary', () => {
    expect(parseExtras(new URLSearchParams('quick=DropTable'), GUARDED)).toEqual({})
    expect(parseExtras(new URLSearchParams('quick=Overdue'), GUARDED)).toEqual({ quick: 'Overdue' })
  })

  it('accepts anything for a param with no list, which is right for free text', () => {
    expect(parseFilterParams(new URLSearchParams('q=whatever the user typed'), GUARDED).search).toBe(
      'whatever the user typed',
    )
  })
})

describe('conflictingColumns', () => {
  it('names a chip column that would be eaten by a reserved param', () => {
    expect(conflictingColumns({ chips: ['stage', 'sort', 'q'] })).toEqual(['sort', 'q'])
  })

  it('names a chip column that would collide with the presence prefix', () => {
    expect(conflictingColumns({ chips: ['has_deposit'] })).toEqual(['has_deposit'])
  })

  it('passes a schema with no collisions', () => {
    expect(conflictingColumns(SCHEMA)).toEqual([])
    expect(RESERVED_PARAMS).toContain('page')
  })
})
</file>

<file path="src/lib/queries/__tests__/finance.test.ts">
import { beforeEach, describe, expect, it, vi } from 'vitest'

import {
  EXPENSE_STATUSES,
  FINANCE_MONEY_ROLES,
  FINANCE_REQUIRED_ROLE,
  FINANCE_RESTRICTED_REASON,
  STORED_INVOICE_STATUSES,
  expensesAwaitingApproval,
  expensesByReceipt,
  expensesByStatus,
  expensesForBooking,
  expensesForBranch,
  expensesForCategory,
  expensesInPeriod,
  financeRestriction,
  invoicesForBooking,
  invoicesForClient,
  listExpenses,
  listInvoices,
  listPayments,
  liveInvoices,
  outstandingInvoices,
  overdueInvoices,
  paymentsForBooking,
  paymentsForClient,
  paymentsForInvoice,
  paymentsInPeriod,
  receivedPayments,
  voidedInvoices,
  type ExpenseListRow,
  type InvoiceListRow,
  type PaymentListRow,
} from '../finance'
import { applyListFilters, type ListFilters } from '../listQuery'
import { NPT_OFFSET_MIN } from '../../bs'
import { toRupees } from '../../money'

/**
 * # What this suite pins
 *
 * `finance.ts` reads the three whole-row money-gated tables, so the failures it
 * can produce are quiet ones:
 *
 *  1. **A dropped column.** PostgREST does not error on a column missing from
 *     the SELECT string — the field arrives `undefined` and renders blank. The
 *     select string is asserted as text, which is the only place a wrong or
 *     absent column name is still visible.
 *  2. **Rupees vs paisa the wrong way round.** A 100× error that still looks
 *     like a plausible rupee figure. Every money field is asserted through
 *     `toRupees` against the raw input.
 *  3. **A filter that cannot match.** 'Overdue' is a declared `invoice_status`
 *     that is never stored; 'Security Deposit' is a declared `payment_type` a
 *     table CHECK forbids. Either one in a chip returns zero rows and renders a
 *     confident, false empty state. Both are pinned as absent.
 *  4. **Restricted mistaken for empty.** A money-blind session gets `[]` from
 *     RLS, not an error, so the screen must be told `restricted` out of band.
 *     `financeRestriction` is what carries that, and it is pinned.
 *
 * The `supabase` module is replaced wholesale, exactly as `bookings.test.ts`
 * does. Nothing here reaches a database.
 */

const db = vi.hoisted(() => {
  interface State {
    /** The table `from()` was called with. */
    table: string
    /** The literal string handed to `.select()` — the thing a dropped column disappears from. */
    columns: string
    /** `.select()`'s second argument: `{ count: 'exact' }` or `undefined`. */
    selectOptions: unknown
    /** Every filter call, in order, exactly as `applyListFilters` made it. */
    calls: Array<[string, ...unknown[]]>
    rows: unknown[]
    count: number | null
    error: { message: string } | null
  }

  const state: State = {
    table: '',
    columns: '',
    selectOptions: undefined,
    calls: [],
    rows: [],
    count: null,
    error: null,
  }

  function reset(): void {
    state.table = ''
    state.columns = ''
    state.selectOptions = undefined
    state.calls = []
    state.rows = []
    state.count = null
    state.error = null
  }

  /** A recording stand-in for the postgrest builder. Thenable, because the query modules `await query`. */
  const builder = {
    select(columns: string, options?: unknown) {
      state.columns = columns
      state.selectOptions = options
      return builder
    },
    or(filters: string) {
      state.calls.push(['or', filters])
      return builder
    },
    in(column: string, values: readonly unknown[]) {
      state.calls.push(['in', column, [...values]])
      return builder
    },
    gte(column: string, value: unknown) {
      state.calls.push(['gte', column, value])
      return builder
    },
    lte(column: string, value: unknown) {
      state.calls.push(['lte', column, value])
      return builder
    },
    is(column: string, value: unknown) {
      state.calls.push(['is', column, value])
      return builder
    },
    not(column: string, operator: string, value: unknown) {
      state.calls.push(['not', column, operator, value])
      return builder
    },
    order(column: string, options?: unknown) {
      state.calls.push(['order', column, options])
      return builder
    },
    range(from: number, to: number) {
      state.calls.push(['range', from, to])
      return builder
    },
    then(
      onFulfilled: (value: {
        data: unknown[] | null
        error: { message: string } | null
        count: number | null
      }) => unknown,
    ): void {
      onFulfilled({ data: state.rows, error: state.error, count: state.count })
    },
  }

  const supabase = {
    from(table: string) {
      state.table = table
      return builder
    },
  }

  return { state, reset, supabase }
})

vi.mock('../../supabase', () => ({
  supabase: db.supabase,
  newClientUuid: () => '00000000-0000-4000-8000-000000000000',
}))

beforeEach(() => {
  db.reset()
})

/** Split the select string into its top-level tokens. Embeds keep their own commas; none of them is a bare column name. */
function selectTokens(): string[] {
  return db.state.columns.split(',').map((t) => t.trim())
}

function occurrences(column: string): number {
  return selectTokens().filter((t) => t === column).length
}

/** Every `in(column, values)` the filter set produced, as a lookup. */
function chipCalls(): Record<string, unknown[]> {
  const out: Record<string, unknown[]> = {}
  for (const call of db.state.calls) {
    if (call[0] === 'in') out[String(call[1])] = call[2] as unknown[]
  }
  return out
}

function callsOfKind(kind: string): Array<[string, ...unknown[]]> {
  return db.state.calls.filter((c) => c[0] === kind)
}

/**
 * Runs a named filter set through the very same `applyListFilters` the query
 * modules use, against the recording builder — so a set is asserted on the SQL
 * it actually produces, not on the object literal it returns.
 */
function record(filters: ListFilters): void {
  db.reset()
  applyListFilters(db.supabase.from('probe').select(''), filters)
}

