/* ── KPI card with a destination ───────────────────────────────────────── */

export interface KpiSpec {
  label: string
  value: string
  icon: IconName
  accent: BrandKey
  note: string
  linkLabel: string
  /** Either a destination or an in-page action — never neither, never both. */
  dest?: Dest
  onAction?: () => void
  delta?: { direction: 'up' | 'down'; text: string }
}

export function KpiCard({ k }: { k: KpiSpec }) {
  return (
    <article className="lift" style={{ ...cardStyle, padding: '13px 14px', minWidth: 0, display: 'flex', flexDirection: 'column' }}>
      <div style={{ display: 'flex', alignItems: 'center', gap: 9 }}>
        <span
          style={{
            width: 30,
            height: 30,
            borderRadius: 'var(--r-sm)',
            background: BRAND[k.accent],
            color: BRAND_ON[k.accent],
            display: 'grid',
            placeItems: 'center',
            flexShrink: 0,
          }}
        >
          <Icon name={k.icon} size={16} fill />
        </span>
        <div
          style={{
            fontSize: 'var(--t-meta)',
            fontWeight: 600,
            color: 'var(--text2)',
            minWidth: 0,
            whiteSpace: 'nowrap',
            overflow: 'hidden',
            textOverflow: 'ellipsis',
          }}
        >
          {k.label}
        </div>
        {k.note && <InfoTooltip content={k.note} label={`About ${k.label}`} size={16} style={{ marginLeft: 'auto', flexShrink: 0 }} />}
      </div>

      <div
        className="kpi-value"
        style={{
          marginTop: 9,
          fontSize: k.value.length > 8 ? 'clamp(15px, 1.0vw, 19px)' : 'clamp(16px, 1.4vw, 22px)',
          fontWeight: 700,
          color: 'var(--text)',
          lineHeight: 1.15,
          letterSpacing: '-0.02em',
          whiteSpace: 'nowrap',
          overflow: 'hidden',
          textOverflow: 'ellipsis',
        }}
      >
        {k.value}
      </div>

      <div style={{ marginTop: 6, fontSize: 'var(--t-th)', display: 'flex', alignItems: 'center', gap: 5, flexWrap: 'wrap' }}>
        {k.delta && (
          <span
            style={{
              display: 'inline-flex',
              alignItems: 'center',
              gap: 3,
              fontWeight: 700,
              color: k.delta.direction === 'up' ? 'var(--success-text)' : 'var(--danger-text)',
            }}
          >
            <Icon name={k.delta.direction === 'up' ? 'arrow_up' : 'arrow_down'} size={11} fill />
            {k.delta.text}
          </span>
        )}
