              style={{
                display: 'flex',
                alignItems: 'center',
                gap: 6,
                border: 'none',
                background: inBundle ? 'transparent' : 'transparent',
                padding: 0,
                font: 'inherit',
                textAlign: 'left',
                cursor: 'pointer',
                color: inBundle ? 'var(--text)' : hasAvailable ? 'var(--text)' : 'var(--text2)',
                minWidth: 0,
