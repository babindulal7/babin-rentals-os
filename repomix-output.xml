/* ============================================================================
   MODULE PAGE SHELL — Unified 4-Zone Operational Module Layout & Consistency
   Source: Today Screen Surface & Button Anatomy (Babin Rentals OS)
   ========================================================================== */

/* ── Container ─────────────────────────────────────────────────────────── */
.module-page-shell {
  display: flex;
  flex-direction: column;
  gap: var(--sp-md, 16px);
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/* ── Zone 1: Sub-Header & Primary Action Bar ────────────────────────────── */
.module-sub-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--sp-md, 16px);
  min-height: 48px;
  padding: 4px 0;
}

.module-sub-header__left {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  min-width: 0;
}

.module-sub-header__counter {
  margin: 0;
  font-size: var(--t-ui, 14px);
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
  white-space: nowrap;
}

.module-sub-header__right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: nowrap;
  margin-left: auto;
}

.module-sub-header__primary-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 0 18px;
  border: 1px solid var(--btn-primary-border, transparent);
  border-radius: var(--r-btn, 8px);
  background: var(--primary, #2563eb);
  color: var(--btn-primary-fg, #ffffff);
  font-family: var(--font-body);
  font-size: var(--t-ui, 14px);
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  white-space: nowrap;
  box-shadow: var(--shadow-sm);
  transition: filter var(--dur-fast, 120ms) var(--ease), transform var(--dur-fast, 120ms) var(--ease);
}

.module-sub-header__primary-cta:hover {
  filter: brightness(1.08);
}

.module-sub-header__primary-cta:active {
  transform: translateY(1px);
  filter: brightness(0.96);
}

.module-sub-header__secondary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 44px;
  padding: 0 14px;
  border: 1px solid var(--border);
  border-radius: var(--r-btn, 8px);
  background: var(--card);
  color: var(--text2);
  font-family: var(--font-body);
  font-size: var(--t-meta, 13px);
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: background var(--dur-fast, 120ms) var(--ease), color var(--dur-fast, 120ms) var(--ease), border-color var(--dur-fast, 120ms) var(--ease);
}

.module-sub-header__secondary-btn:hover {
  background: var(--card2);
  color: var(--text);
  border-color: var(--border2, var(--border));
}

.module-sub-header__secondary-btn:active {
  filter: brightness(0.97);
}

/* ── Zone 2: 3-Card KPI Strip ───────────────────────────────────────────── */
.module-kpi-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--sp-md, 16px);
  margin-top: 2px;
  margin-bottom: 4px;
}

@media (max-width: 860px) {
  .module-kpi-grid {
    grid-template-columns: 1fr;
  }
}

.module-kpi-card {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 10px;
  padding: 16px 20px;
  border: 1px solid var(--border);
  border-radius: var(--r-card, 14px);
  background: var(--surface-card, var(--card));
  box-shadow: var(--shadow-sm);
  cursor: pointer;
  text-align: left;
  user-select: none;
  transition: border-color var(--dur-fast, 120ms) var(--ease), box-shadow var(--dur-fast, 120ms) var(--ease), transform var(--dur-fast, 120ms) var(--ease);
}

.module-kpi-card:hover {
  border-color: var(--primary);
  box-shadow: var(--shadow-card, 0 4px 14px rgba(0, 0, 0, 0.08));
}

.module-kpi-card:active {
  transform: translateY(1px);
}

.module-kpi-card.is-active {
  border-color: var(--primary);
  background: color-mix(in srgb, var(--primary) 5%, var(--card));
  box-shadow: 0 0 0 1.5px var(--primary);
}

.module-kpi-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.module-kpi-card__label {
  font-size: var(--t-meta, 13px);
  font-weight: 600;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.module-kpi-card__icon {
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border-radius: var(--r-xs, 4px);
  flex-shrink: 0;
}

.module-kpi-card__icon--primary {
  color: var(--primary);
}

.module-kpi-card__icon--warn {
  color: var(--warn, #ea580c);
}

.module-kpi-card__icon--danger {
  color: var(--danger, #dc2626);
}

.module-kpi-card__icon--success {
  color: var(--success, #16a34a);
}

.module-kpi-card__count {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 700;
  line-height: 1.2;
  color: var(--text);
  letter-spacing: -0.02em;
  margin-top: 2px;
}

.module-kpi-card__subtitle {
  margin: 0;
  font-size: var(--t-meta, 13px);
  color: var(--text2);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── Zone 3: Unified Filter & Tab Bar ───────────────────────────────────── */
.module-filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  min-height: 48px;
  padding: 4px 0;
}

.module-filter-bar__left {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: var(--card2);
  padding: 3px 4px;
  border-radius: var(--r-btn, 8px);
  border: 1px solid var(--border);
  overflow-x: auto;
  max-width: 100%;
}

.module-filter-bar__tab {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 44px;
  padding: 0 14px;
  border: 0;
  border-radius: calc(var(--r-btn, 8px) - 2px);
  background: transparent;
  color: var(--text2);
  font-family: var(--font-body);
  font-size: var(--t-meta, 13px);
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  transition: background var(--dur-fast, 120ms) var(--ease), color var(--dur-fast, 120ms) var(--ease);
}

.module-filter-bar__tab:hover {
  background: var(--card);
  color: var(--text);
}

.module-filter-bar__tab.is-active {
  background: var(--primary);
  color: #ffffff;
  font-weight: 600;
  box-shadow: var(--shadow-sm);
}

.module-filter-bar__tab-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 1px 6px;
  border-radius: var(--r-badge, 999px);
  font-family: var(--font-id, monospace);
  font-size: 11px;
  font-weight: 700;
  line-height: 1.2;
}

.module-filter-bar__tab.is-active .module-filter-bar__tab-count {
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
}

.module-filter-bar__tab:not(.is-active) .module-filter-bar__tab-count {
  background: color-mix(in srgb, var(--border) 40%, transparent);
  color: var(--text2);
}

.module-filter-bar__right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-left: auto;
}

.module-filter-bar__select {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding: 0 12px;
  border: 1px solid var(--border);
  border-radius: var(--r-btn, 8px);
  background: var(--card);
  color: var(--text);
  font-family: var(--font-body);
  font-size: var(--t-meta, 13px);
  font-weight: 600;
  cursor: pointer;
}

.module-filter-bar__search {
  min-width: 200px;
  max-width: 280px;
}

@media (max-width: 640px) {
  .module-filter-bar__search {
    min-width: 100%;
    max-width: 100%;
  }
}

/* ── Zone 4: Standard Data Table ────────────────────────────────────────── */
.module-table-container {
  width: 100%;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: var(--r-card, 14px);
  background: var(--surface-card, var(--card));
  box-shadow: var(--shadow-sm);
}

.module-table-scroll {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.module-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.module-table th {
  padding: 12px 16px;
  background: color-mix(in srgb, var(--card2) 65%, var(--card));
  border-bottom: 1px solid var(--border);
  color: var(--text2);
  font-size: var(--t-meta, 13px);
  font-weight: 600;
  letter-spacing: 0.02em;
  white-space: nowrap;
}

.module-table td {
  padding: 12px 16px;
  border-bottom: 1px solid color-mix(in srgb, var(--border) 45%, transparent);
  color: var(--text);
  font-size: var(--t-ui, 14px);
  vertical-align: middle;
}

.module-table tr:last-child td {
  border-bottom: none;
}

.module-table tr.is-clickable {
  cursor: pointer;
  transition: background var(--dur-fast, 120ms) var(--ease);
}

.module-table tr.is-clickable:hover td {
  background: color-mix(in srgb, var(--primary) 3%, var(--card2));
}

/* Column 1: Monospace Code / ID Badge */
.module-table__code-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-family: var(--font-id, monospace);
  font-size: var(--t-meta, 13px);
  font-weight: 600;
  color: var(--primary);
  background: color-mix(in srgb, var(--primary) 8%, var(--card));
  border: 1px solid color-mix(in srgb, var(--primary) 28%, transparent);
  padding: 3px 8px;
  border-radius: var(--r-xs, 4px);
  white-space: nowrap;
}

/* Column 2: Primary Entity (Bold Title + Secondary Subtitle) */
.module-table__entity {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 180px;
}

.module-table__entity-title {
  font-weight: 700;
  color: var(--text);
  line-height: 1.3;
}

.module-table__entity-sub {
  font-size: var(--t-meta, 13px);
  color: var(--muted);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Column 3: Context / Dates / Specs */
.module-table__context {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 150px;
  font-size: var(--t-meta, 13px);
  color: var(--text2);
}

.module-table__context-primary {
  font-weight: 600;
  color: var(--text);
}

.module-table__context-secondary {
  color: var(--muted);
}

/* Column 5: Financial / Metric Value */
.module-table__metric {
  text-align: right;
  font-family: var(--font-id, monospace);
  font-size: var(--t-ui, 14px);
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
}

/* Column 6: Pinned Action Button + Overflow */
.module-table__actions {
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  white-space: nowrap;
}

.module-table__row-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 44px;
  padding: 0 14px;
  border: 1px solid var(--btn-primary-border, transparent);
  border-radius: var(--r-btn, 8px);
  background: var(--primary, #2563eb);
  color: #ffffff;
  font-family: var(--font-body);
  font-size: var(--t-meta, 13px);
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  box-shadow: var(--shadow-sm);
  transition: filter var(--dur-fast, 120ms) var(--ease), transform var(--dur-fast, 120ms) var(--ease);
}

.module-table__row-cta:hover {
  filter: brightness(1.1);
}

.module-table__row-cta:active {
  transform: translateY(1px);
}

.module-table__row-cta--prep {
  background: var(--card2);
  color: var(--text);
  border-color: var(--border);
}

.module-table__row-cta--prep:hover {
  background: var(--card);
  border-color: var(--primary);
  color: var(--primary);
}

/* ── Unified Status Pill Badge ──────────────────────────────────────────── */
.module-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: var(--r-badge, 999px);
  font-size: 12px;
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
  border: 1px solid transparent;
  user-select: none;
}

/* Emerald (Active / Paid / Available) */
.module-status-pill--emerald {
  background: color-mix(in srgb, var(--success, #16a34a) 12%, var(--card));
  color: var(--success-text, #15803d);
  border-color: color-mix(in srgb, var(--success, #16a34a) 35%, transparent);
}

/* Amber (Pending / Prep / Partial) */
.module-status-pill--amber {
  background: color-mix(in srgb, var(--warn, #ea580c) 12%, var(--card));
  color: var(--warn-text, #c2410c);
  border-color: color-mix(in srgb, var(--warn, #ea580c) 35%, transparent);
}

/* Red (Overdue / Hold / Unpaid / Blocked) */
.module-status-pill--red {
  background: color-mix(in srgb, var(--danger, #dc2626) 12%, var(--card));
  color: var(--danger-text, #b91c1c);
  border-color: color-mix(in srgb, var(--danger, #dc2626) 35%, transparent);
}

/* Slate (Completed / Draft / Closed) */
.module-status-pill--slate {
  background: color-mix(in srgb, var(--muted, #64748b) 12%, var(--card));
  color: var(--text2, #334155);
  border-color: color-mix(in srgb, var(--border, #cbd5e1) 60%, transparent);
}

/* Blue (On Set / Scheduled / Confirmed) */
.module-status-pill--blue {
  background: color-mix(in srgb, var(--primary, #2563eb) 12%, var(--card));
  color: var(--primary-text, #1d4ed8);
  border-color: color-mix(in srgb, var(--primary, #2563eb) 35%, transparent);
}
</file>

<file path="src/components/ui/module-shell/ModulePageShell.tsx">
import React from 'react'
import './module-shell.css'

export interface ModulePageShellProps {
  subHeader?: React.ReactNode
  kpiStrip?: React.ReactNode
  filterBar?: React.ReactNode
  children: React.ReactNode
  footer?: React.ReactNode
  className?: string
  style?: React.CSSProperties
}

/**
 * Standardized Module Page Shell
 * Enforces the strict 4-zone vertical operational layout:
 * - Zone 1: Sub-Header & Primary Action Bar
 * - Zone 2: 3-Card KPI Strip
 * - Zone 3: Unified Filter & Tab Bar
 * - Zone 4: Standard Data Table (or custom operational view)
 */
export const ModulePageShell: React.FC<ModulePageShellProps> = ({
  subHeader,
  kpiStrip,
  filterBar,
  children,
  footer,
  className = '',
  style,
}) => {
  return (
    <div className={`module-page-shell animate-entrance ${className}`.trim()} style={style}>
      {subHeader}
      {kpiStrip}
      {filterBar}
      <div className="module-page-shell__content" style={{ display: 'flex', flexDirection: 'column', gap: 12, minWidth: 0, width: '100%' }}>
        {children}
      </div>
      {footer}
    </div>
  )
}
</file>

<file path="src/components/ui/Badge.tsx">
import React from 'react'
import {
  IconFileText,
  IconCheck,
  IconPackage,
  IconArrowUpRight,
  IconArrowDownLeft,
  IconLock,
  IconAlertTriangle,
  IconAlertOctagon,
  IconClock,
  IconStar,
  IconBan,
  IconExternalLink,
  IconCoin,
  IconRefresh,
} from '@tabler/icons-react'
import type { BookingStatus, Flag } from '../../lib/workflow'
import { BOOKING_STATUS, FLAGS } from '../../lib/workflow'
import { STATUS, STATUS_BLOCK, EXT_MARK } from '../../lib/status'
import type { StatusKey } from '../../lib/status'

/**
 * The ONE place a status is painted — DESIGN_DIRECTION_SPEC_v4.1 §8 step 2:
 * "one component rendering the §4 map from lib/status; every screen inherits.
 * No screen colours a status itself."
 *
 * ## What v4.1 changed here
 *
 * **Every status is a SOLID block.** The pre-v4.1 build painted a 999-radius
 * pill at weight 500 and carried a special case — `background: tone === 'out'
 * ? tokens.fg : tokens.bg` — that inverted fg/bg for On Rent, because "solid
 * green" was faked by using the foreground token as a fill while every other
 * status used a soft wash. v4.1 makes the token pairs themselves solid, so
 * that inversion became actively wrong: it painted On Rent with `--on-warn`,
 * a near-black, as the background. Both the special case and the pill are
 * gone; the block now reads its pair straight and takes its geometry from
 * `STATUS_BLOCK`, so the anatomy lives in one place rather than in this file.
 *
 * `--r-badge` (999) is NOT used here. v4.1 §3.3 reserves it for numeric count
 * badges; status blocks are `--r-chip` (6).
 *
 * ## The gold mark is deliberately not a block
 *
 * Sub-Rented renders from `EXT_MARK`: weight 600, not uppercase, 1px solid
 * gold outline. §2 keeps it outline-only precisely so it can never be read as
 * a yellow status at a glance — which is also why the old `1px dashed` is now
 * solid, matching the spec's one outline on screen.
 *
 * ## `tone="warning"`
 *
 * Still accepted for manual callers and still resolves to `progress` (yellow).
 * v4.1 renamed the hue's *meaning* to "being worked in-house / waiting", which
 * is what a warning badge wants; the key itself stays `progress` per §7.5
 * ("recolours them, it does not rename them").
 */

/** `tone` without the optional `undefined` — what the resolver actually holds. */
type Tone = NonNullable<BadgeProps['tone']>

export interface BadgeProps {
  status?: BookingStatus
  flag?: Flag
  label?: string
  tone?: 'neutral' | 'primary' | 'progress' | 'out' | 'in' | 'danger' | 'dim' | 'ext' | 'warning'
  icon?: React.ReactNode
  size?: 'sm' | 'md'
  variant?: 'pill' | 'square' | 'flag'
  className?: string
}

export const Badge: React.FC<BadgeProps> = ({
  status,
  flag,
  label,
  tone,
  icon,
  size = 'md',
  variant = 'pill',
  className = '',
}) => {
  // Resolve tone, label, icon from status / flag if provided
  let effectiveLabel = label || ''
  let effectiveTone: Tone = tone || 'neutral'
  let effectiveIcon = icon

  if (status && BOOKING_STATUS[status]) {
    const meta = BOOKING_STATUS[status]
    effectiveLabel = status
    effectiveTone = meta.token as Tone

    switch (status) {
      case 'Quote':
        effectiveIcon = effectiveIcon || <IconFileText size={14} />
        break
      case 'Booked':
        effectiveIcon = effectiveIcon || <IconCheck size={14} />
        break
      case 'Packed':
        effectiveIcon = effectiveIcon || <IconPackage size={14} />
        break
      case 'On Rent':
        effectiveIcon = effectiveIcon || <IconArrowUpRight size={14} />
        break
      case 'Returned':
        effectiveIcon = effectiveIcon || <IconArrowDownLeft size={14} />
        break
      case 'Closed':
        effectiveIcon = effectiveIcon || <IconLock size={14} />
        break
    }
  } else if ((status as string) === 'Draft') {
    effectiveLabel = 'Draft'
    effectiveTone = 'neutral'
    effectiveIcon = effectiveIcon || <IconFileText size={14} />
  } else if ((status as string) === 'Reset' || label === 'Reset') {
    effectiveLabel = label || 'Reset'
    effectiveTone = 'progress'
    effectiveIcon = effectiveIcon || <IconRefresh size={14} />
  } else if ((status as string) === 'QC' || label === 'QC') {
    effectiveLabel = label || 'QC'
    effectiveTone = 'progress'
    effectiveIcon = effectiveIcon || <IconCheck size={14} />
  } else if (flag && FLAGS[flag]) {
    const meta = FLAGS[flag]
    effectiveLabel = flag
    effectiveTone = meta.token as Tone

    switch (flag) {
      case 'Due Soon':
        effectiveIcon = effectiveIcon || <IconClock size={14} />
        break
      case 'Overdue':
      case 'Missing':
      case 'Damaged':
      case 'Cancelled':
        effectiveIcon = effectiveIcon || <IconAlertOctagon size={14} />
        break
      case 'Deposit Pending':
      case 'Payment Due':
        effectiveIcon = effectiveIcon || <IconCoin size={14} />
        break
      case 'VIP':
        effectiveIcon = effectiveIcon || <IconStar size={14} />
        break
      case 'Blocked':
        effectiveIcon = effectiveIcon || <IconBan size={14} />
        break
      case 'Sub-Rented':
        effectiveIcon = effectiveIcon || <IconExternalLink size={14} />
        break
      default:
        effectiveIcon = effectiveIcon || <IconAlertTriangle size={14} />
    }
  }

  const statusKey: StatusKey = effectiveTone === 'warning' ? 'progress' : (effectiveTone as StatusKey)
  const tokens = STATUS[statusKey] ?? STATUS.neutral
  const isExt = statusKey === 'ext'

  /*
   * §4 block anatomy, straight from lib/status so a second component cannot
   * drift from it. `size="sm"` scales the block down for dense table cells
   * without changing what it IS — the weight, the casing and the tracking are
   * the identity of a status block and do not scale away.
   */
  const shape = isExt ? EXT_MARK : STATUS_BLOCK
  const compact = size === 'sm'
  const isLiveActive = status === 'On Rent' || flag === 'Overdue' || flag === 'Due Soon'

  // Variant-specific geometry
  const variantRadius = variant === 'pill' ? 'var(--r-badge)' : variant === 'square' ? 'var(--r-sm)' : 'var(--r-xs)'
  const variantPadding = variant === 'flag' ? '4px 8px' : compact ? '4px 8px' : shape.padding
  const variantGap = variant === 'flag' ? 'var(--sp-xs)' : compact ? 'var(--sp-xs)' : 6
  const variantFontWeight = variant === 'flag' ? 600 : shape.fontWeight
  const variantTextTransform = variant === 'flag' ? 'none' : (isExt ? 'none' : STATUS_BLOCK.textTransform)
  const variantLetterSpacing = variant === 'flag' ? '0.02em' : shape.letterSpacing
  const variantFontSize = compact ? '10.5px' : shape.fontSize

  return (
    <span
      className={className || undefined}
      style={{
        display: 'inline-flex',
        alignItems: 'center',
        flexShrink: 0,
        userSelect: 'none',
        background: tokens.bg,
        color: tokens.fg,
        border: `1.5px solid ${tokens.border || (isExt ? 'var(--ext-line)' : 'color-mix(in srgb, currentColor 45%, transparent)')}`,
        borderRadius: isExt ? shape.borderRadius : variantRadius,
        fontWeight: variantFontWeight,
        letterSpacing: variantLetterSpacing,
        ...(isExt ? {} : { textTransform: variantTextTransform }),
        fontSize: variantFontSize,
        padding: variantPadding,
        gap: variantGap,
        lineHeight: 1.1,
      }}
    >
      {/* Perpetual live micro-indicator for active operations */}
      {isLiveActive && (
        <span
          className="status-live-dot"
          aria-hidden="true"
          style={{ width: compact ? 5 : 6, height: compact ? 5 : 6 }}
        />
      )}
      {/* §7.4 — never colour alone: the icon and the word both always render. */}
      {effectiveIcon && <span style={{ display: 'inline-flex', flexShrink: 0 }}>{effectiveIcon}</span>}
      <span>{effectiveLabel}</span>
    </span>
  )
}
</file>

<file path="src/components/ui/BsAdDate.tsx">
import React from 'react'
import { toBs, formatBs } from '../../lib/bs'

export interface BsAdDateProps {
  date: Date | string | number | null | undefined
  layout?: 'stacked' | 'inline' | 'bs-only' | 'ad-only'
  showTime?: boolean
  className?: string
  /** Booking schedule dates share the theme's orange in every layout. */
  tone?: 'default' | 'booking'
}

export const BsAdDate: React.FC<BsAdDateProps> = ({
  date,
  layout = 'stacked',
  showTime = false,
  className = '',
  tone: _tone = 'default',
}) => {
  if (!date) {
    return <span style={{ color: 'var(--muted)', fontFamily: 'var(--font-id, sans-serif)', fontVariantNumeric: 'tabular-nums', fontSize: 'var(--t-ui)' }}>—</span>
  }

  const d = typeof date === 'string' || typeof date === 'number' ? new Date(date) : date
  if (isNaN(d.getTime())) {
    return <span style={{ color: 'var(--muted)', fontFamily: 'var(--font-id, sans-serif)', fontVariantNumeric: 'tabular-nums', fontSize: 'var(--t-ui)' }}>—</span>
  }

  const bs = toBs(d)
  const bsFormatted = bs ? `${formatBs(bs)} ${bs.year}` : null
  const adFormatted = d.toLocaleDateString('en-GB', { timeZone: 'Asia/Kathmandu', day: 'numeric', month: 'short', year: 'numeric' })

  /*
   * ⛔ WHEN THERE IS NO BS DATE, SAY SO. Do not silently substitute the AD one.
   *
   * `toBs` returns null for any date outside the single month `lib/bs.ts` can
   * vouch for (Shrawan 2083 — 16 Jul to 16 Aug 2026). From 17 Aug 2026 that is
   * EVERY date; see PLAN.md §4.34.
   *
   * Every branch below used to read `bsFormatted || adFormatted`, which put the
   * Gregorian date into the BS slot with nothing marking it — including in
   * `bs-only`, where the caller has explicitly asked for Bikram Sambat and a
   * Nepali reader has every reason to read what appears there AS Bikram Sambat.
   * "17 Aug 2026" presented as the BS answer is not a degraded answer, it is a
   * wrong one, and it was the only place this codebase lied about a date rather
   * than refusing.
   *
   * `bs.ts:46-49` already chose the honest posture — *"an honest gap beats a
   * wrong date"* — and returns null precisely so callers can degrade truthfully.
   * This component was throwing that away. It now labels the fallback `AD`, so
   * the figure stays useful and cannot be mistaken for the other calendar.
   *
   * Marked by TEXT, never by colour alone (Law 11), and carrying a `title` so
   * the reason is one hover away rather than a mystery.
   */
  const UNAVAILABLE =
    'Bikram Sambat is unavailable for this date. Showing AD.'
  const primary = bsFormatted ?? `${adFormatted} AD`
  const primaryTitle = bsFormatted ? undefined : UNAVAILABLE
  const primaryColor = 'var(--text)'
  const secondaryColor = 'var(--text2)'

  const timeFormatted = showTime
    ? d.toLocaleTimeString('en-US', {
        timeZone: 'Asia/Kathmandu',
        hour: '2-digit',
        minute: '2-digit',
        hour12: true,
      })
    : null

  if (layout === 'bs-only') {
    return (
      <span className={className || undefined} style={{ color: primaryColor, fontSize: 'var(--t-ui)', fontWeight: 500 }} title={primaryTitle}>
        {primary} {timeFormatted && <span style={{ color: secondaryColor, fontSize: 'var(--t-meta)', marginLeft: 4 }}>({timeFormatted})</span>}
      </span>
    )
  }

  if (layout === 'ad-only') {
    return (
      <span className={className || undefined} style={{ color: primaryColor, fontSize: 'var(--t-ui)', fontWeight: 500 }}>
        {adFormatted} {timeFormatted && <span style={{ color: secondaryColor, fontSize: 'var(--t-meta)', marginLeft: 4 }}>({timeFormatted})</span>}
      </span>
    )
  }

  if (layout === 'inline') {
    return (
      <span className={className || undefined} style={{ display: 'inline-flex', alignItems: 'center', gap: 6, fontSize: 'var(--t-ui)' }}>
        <span style={{ fontWeight: 500, color: primaryColor }} title={primaryTitle}>
          {primary}
        </span>
        {/* No parenthetical when BS is unavailable — the primary IS the AD date,
            and repeating it would read as two different dates. */}
        {bsFormatted && <span style={{ fontSize: 'var(--t-meta)', color: 'var(--muted)' }}>({adFormatted})</span>}
        {timeFormatted && <span style={{ fontSize: 'var(--t-meta)', color: secondaryColor, fontFamily: 'var(--font-id, sans-serif)', fontVariantNumeric: 'tabular-nums' }}>{timeFormatted}</span>}
      </span>
    )
  }

  // Default stacked layout: 2 lines (Line 1: BS date bold, Line 2: AD date + time)
  return (
    <div className={className || undefined} style={{ display: 'flex', flexDirection: 'column', lineHeight: 1.25 }}>
      <span style={{ fontSize: 'var(--t-ui)', fontWeight: 700, color: primaryColor, whiteSpace: 'nowrap' }} title={primaryTitle}>
        {primary}
      </span>
      <span
        style={{
          fontSize: 'var(--t-meta)',
          color: secondaryColor,
          whiteSpace: 'nowrap',
        }}
      >
        {/* The second line carries the AD date only when the first carries BS.
            When BS is unavailable the first line already IS the AD date, so this
            line states WHY rather than repeating it. */}
        <span>{bsFormatted ? adFormatted : 'BS unavailable'}</span>
        {timeFormatted && <> <span style={{ fontVariantNumeric: 'tabular-nums' }}>{timeFormatted}</span></>}
      </span>
    </div>
  )
}
</file>

<file path="src/components/ui/Button.tsx">
import { forwardRef } from 'react'
import type { ButtonHTMLAttributes, CSSProperties, ReactNode } from 'react'
import Icon, { type IconName } from './Icon'

/**
 * Rewritten from Tailwind utility classNames — `bg-blue-600 hover:bg-blue-700...` —
 * to the app's real inline-style + CSS-variable system. Tailwind's Vite plugin is
 * registered but no CSS file imports `tailwindcss`, so every one of those classes
 * compiled to nothing and this component rendered fully unstyled wherever it was
 * used. Same prop/API shape as before, so every existing call site is unaffected.
 */

export interface ButtonProps extends ButtonHTMLAttributes<HTMLButtonElement> {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'danger' | 'link' | 'tertiary' | undefined
  size?: 'sm' | 'md' | 'lg' | undefined
  loading?: boolean | undefined
  icon?: ReactNode | IconName | undefined
  iconRight?: ReactNode | IconName | undefined
}

const SIZE_STYLES: Record<
  NonNullable<ButtonProps['size']>,
  { minHeight: number; padding: string; fontSize: string; gap: number | string; iconSize: number }
> = {
  // Law 15: minimum 44px touch target on every device — never relaxed, even for `sm`.
  sm: { minHeight: 44, padding: '0 12px', fontSize: 'var(--t-meta)', gap: 6, iconSize: 14 },
  md: { minHeight: 44, padding: '0 16px', fontSize: 'var(--t-ui)', gap: 'var(--sp-sm)', iconSize: 16 },
  lg: { minHeight: 48, padding: '0 24px', fontSize: 'var(--t-body)', gap: 10, iconSize: 18 },
}

/*
 * No orange variant, deliberately. DESIGN_DIRECTION_SPEC_v4.2 §2.3: orange is a
 * status hue only (the On Rent family) — "never on buttons". Blue is the one
 * action colour; a Miraz-style `brand`/`action` orange button is a defect here.
 */
function variantStyle(variant: NonNullable<ButtonProps['variant']>): CSSProperties {
  switch (variant) {
    case 'primary':
      return {
        background: 'var(--btn-primary-bg)',
        color: 'var(--btn-primary-fg)',
        border: '1.5px solid transparent',
        boxShadow: 'var(--shadow-card), inset 0 1px 0 rgba(255, 255, 255, 0.25)',
      }
    case 'secondary':
      return {
        background: 'var(--btn-secondary-bg)',
        color: 'var(--text)',
        border: '1.5px solid var(--btn-secondary-border)',
      }
    case 'outline':
      return {
        background: 'transparent',
        color: 'var(--text2)',
        border: '1.5px solid var(--input-border)',
      }
    case 'ghost':
      return {
        background: 'transparent',
        color: 'var(--text2)',
        border: '1.5px solid transparent',
      }
    case 'link':
      return {
        background: 'transparent',
        color: 'var(--link)',
        border: 'none',
        padding: 0,
        minWidth: 'auto',
      }
    case 'tertiary':
      return {
        background: 'var(--card2)',
        color: 'var(--text)',
        border: '1.5px solid var(--input-border)',
      }
    case 'danger':
      return {
        background: 'var(--btn-danger-bg)',
        color: 'var(--btn-danger-fg)',
        border: '1.5px solid transparent',
        boxShadow: 'var(--shadow-card)',
      }
  }
}

export const Button = forwardRef<HTMLButtonElement, ButtonProps>(function Button({
  children,
  variant = 'secondary',
  size = 'sm',
  loading = false,
  disabled,
  icon,
  iconRight,
  style,
  className,
  ...props
}, ref) {
  const sizing = SIZE_STYLES[size]
  const isDisabled = disabled || loading
  const isLink = variant === 'link'
  const resolvedIcon = typeof icon === 'string' ? <Icon name={icon as IconName} size={sizing.iconSize} /> : icon
  const resolvedIconRight = typeof iconRight === 'string' ? <Icon name={iconRight as IconName} size={sizing.iconSize} /> : iconRight

  return (
    <button
      ref={ref}
      disabled={isDisabled}
      aria-busy={loading || undefined}
      className={['ui-button', `ui-button--${variant}`, `ui-button--${size}`, 'press', className].filter(Boolean).join(' ')}
      style={{
        display: 'inline-flex',
        alignItems: 'center',
        justifyContent: 'center',
        fontWeight: isLink ? 500 : 600,
        fontFamily: 'inherit',
        whiteSpace: 'nowrap',
        userSelect: 'none',
        borderRadius: isLink ? 0 : 'var(--r-btn)',
        transition: 'background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease)',
        cursor: isDisabled ? 'not-allowed' : 'pointer',
        position: 'relative',
        opacity: isDisabled ? 0.45 : 1,
        minHeight: sizing.minHeight,
        minWidth: 'var(--control-height, 44px)',
        padding: isLink ? 0 : sizing.padding,
        fontSize: sizing.fontSize,
        gap: sizing.gap,
        ...variantStyle(variant),
        ...style,
      }}
      {...props}
    >
      {/*
        §5 — "loading keeps the button's width (label transparent, spinner
        overlays) so layout never jumps."

        This previously swapped the ICON SLOT for the spinner while leaving
        `children` rendered, so a text-only button — the common case — GAINED a
        spinner and grew wider the moment it started loading, shifting whatever
        sat beside it. Now the label keeps its box and turns transparent, and
        the spinner is absolutely positioned over it: the button occupies the
        exact same rectangle loading or not.

        Opacity retains the accessible name. Both icon slots keep their boxes
        during loading, including icon-only buttons with an aria-label.
      */}
      {loading && (
        <Icon
          name="refresh"
          size={sizing.iconSize}
          style={{
            animation: 'spin 0.8s linear infinite',
            position: 'absolute',
            left: '50%',
            top: '50%',
            transform: 'translate(-50%, -50%)',
          }}
        />
      )}
      {resolvedIcon && <span className="ui-button__slot" style={{ display: 'inline-flex', flexShrink: 0, opacity: loading ? 0 : 1 }}>{resolvedIcon}</span>}
      {children !== undefined && <span className="ui-button__label" style={{ opacity: loading ? 0 : 1 }}>{children}</span>}
      {resolvedIconRight && <span className="ui-button__slot" style={{ display: 'inline-flex', flexShrink: 0, opacity: loading ? 0 : 1 }}>{resolvedIconRight}</span>}
    </button>
  )
})

Button.displayName = 'Button'
</file>

<file path="src/components/ui/CollapsibleAside.tsx">
import type { ReactNode, CSSProperties } from 'react'
import { useLocation } from 'react-router-dom'
import Icon from './Icon'
import type { IconName } from './Icon'
import { useCollapsed } from '../../lib/collapse'
import { useViewport } from '../../lib/device'

/**
 * A page-side panel that remembers its own open/closed state per route
 * (localStorage, keyed by `id` or the current pathname). `SideRail` in
 * `Page.tsx` uses this for left filters. Right summaries use InformationDrawer under the user's 20 Oct 2026 ruling.
 */
export function CollapsibleAside({
  children,
  id,
  side,
  width = 288,
  label = 'Panel',
}: {
  children: ReactNode
  id?: string
  side: 'left' | 'right'
  width?: number
  label?: string
}) {
  const location = useLocation()
  const viewport = useViewport()
  const key = `${side}:${id ?? location.pathname}`
  // Phone *and* tablet width have no room for a 210–300px rail sitting beside
  // `minmax(0,1fr)` content — it squeezes the content column to nothing. This
  // product's actual target device is the 768–1279px warehouse tablet (see
  // device.ts's docstring), so the collapse-by-default has to cover that band
  // too, not just phone. Default collapsed on both; `useCollapsed` still lets
  // an explicit user toggle override it.
  const [collapsed, toggle] = useCollapsed(key, viewport === 'phone' || viewport === 'tablet')
  const collapseIcon: IconName = side === 'right' ? 'chevron_right' : 'chevron_left'
  const expandIcon: IconName = side === 'right' ? 'chevron_left' : 'chevron_right'

  if (collapsed) {
    return (
      <div
        style={{
          display: 'flex',
          alignItems: 'flex-start',
          justifyContent: 'center',
          // The collapsed rail is exactly one tap wide — it holds nothing but the
          // handle. `var(--tap)`, never a literal, per §3.3.
          width: 'var(--tap)',
          // Sticky for the same reason the expanded panel is (see below): the
          // handle that reopens the rail has to still be on screen when someone
          // has scrolled down far enough to want it back.
          position: 'sticky',
          top: 'calc(var(--header-h) + var(--sp-md))',
          alignSelf: 'flex-start',
        }}
      >
        {/*
          Law 15 — 44×44 at every width, desktop included. Because line 37
          collapses every rail by default at BOTH tablet and phone, this handle
          is the *only* route back to the rail's content on the two bands the
          rule is written for. The button box is therefore a full 44×44 and the
          28px card is drawn inside it, so the visual stays compact without the
          target shrinking with it.
        */}
        <button
          type="button"
          onClick={toggle}
          aria-label={`Expand ${label}`}
          title={`Expand ${label}`}
          style={{
            minWidth: 'var(--tap)',
            minHeight: 'var(--tap)',
            padding: 0,
            border: 'none',
            background: 'transparent',
            color: 'var(--text2)',
            display: 'grid',
            placeItems: 'center',
            cursor: 'pointer',
            flexShrink: 0,
          }}
        >
          <span
            aria-hidden
            style={{
              width: 28,
              height: 28,
              borderRadius: 'var(--r-sm)',
              border: '1px solid var(--border)',
              background: 'var(--card)',
              display: 'grid',
              placeItems: 'center',
            }}
          >
            <Icon name={expandIcon} size={14} />
          </span>
        </button>
      </div>
    )
  }

  /**
   * Same Law 15 treatment as the expand handle: a transparent 44×44 button box
   * carrying a 24px circle. The box is offset by half its own width so the
   * circle still straddles the rail's border exactly where it did before.
   */
  const handleStyle: CSSProperties = {
    position: 'absolute',
    top: -10,
    minWidth: 'var(--tap)',
    minHeight: 'var(--tap)',
    padding: 0,
    border: 'none',
    background: 'transparent',
    color: 'var(--text2)',
    display: 'grid',
    placeItems: 'center',
    cursor: 'pointer',
    zIndex: 2,
    ...(side === 'right' ? { left: -22 } : { right: -22 }),
  }

  /*
   * Law 14 is already satisfied for this one and it is worth saying why, because
   * a 24px circle looks like a violation at a glance and is not.
   *
   * This is an `aria-hidden` `<span>` — pure paint. The *control* is
   * `handleStyle`'s `<button>` wrapping it, which carries the full `--tap` box.
   * That is the hit-area-not-paint rule taken the direct way: rather than
   * pinning an invisible pseudo-element onto a small button, the button IS the
   * 44 and the circle is drawn inside it. Nothing to add here; do not shrink the
   * button to fit the circle.
   */
  const handleDotStyle: CSSProperties = {
    width: 24,
    height: 24,
    borderRadius: '50%',
    border: '1px solid var(--border)',
    background: 'var(--card)',
    display: 'grid',
    placeItems: 'center',
    boxShadow: 'var(--shadow-card)',
  }

  /**
   * Sticky, with its own contained scroll.
   *
   * This was `position: relative`, so both rails scrolled away with the page —
   * on a long booking the Quick Actions card and its Receive Payment button
   * ended up above the viewport exactly when someone scrolled down to the
   * payment history to use them.
   *
   * `overscroll-behavior: contain` is the half that makes it behave: reaching
   * the end of this panel does NOT start scrolling the page behind it. Hover
   * the panel, the panel scrolls; hover the list, the list scrolls.
   *
   * ## Why the scroll is on an INNER box
   *
   * The collapse handle sits at `right: -12` — deliberately outside this
   * element's box, straddling the border. `overflow-y: auto` on the same
   * element would compute `overflow-x` to `auto` as well (CSS overflow §3: a
   * `visible` axis becomes `auto` when the other is not visible), and the handle
   * would be clipped at the edge it hangs over. So the sticky box keeps
   * `overflow: visible` and holds the handle, and a child owns the scroll.
   */
  return (
    <div
      style={{
        position: 'sticky',
        top: 'calc(var(--header-h) + var(--sp-md))',
        alignSelf: 'flex-start',
        minWidth: 0,
        width,
      }}
    >
      <button type="button" onClick={toggle} aria-label={`Collapse ${label}`} title={`Collapse ${label}`} style={handleStyle}>
        <span aria-hidden style={handleDotStyle}>
          <Icon name={collapseIcon} size={12} />
        </span>
      </button>
      <div
        style={{
          display: 'flex',
          flexDirection: 'column',
          gap: 'var(--sp-md)',
          minWidth: 0,
          maxHeight: 'calc(100dvh - var(--header-h) - var(--sp-md) * 2)',
          overflowY: 'auto',
          overscrollBehavior: 'contain',
        }}
      >
        {children}
      </div>
    </div>
  )
}
</file>

<file path="src/components/ui/FilterDatePicker.tsx">
import { useState } from 'react'
import { CalendarPopover } from './DateField'
import { getBusinessToday } from '../../lib/bs'

export interface FilterDatePreset {
  key: string
  label: string
  active: boolean
  onSelect: () => void
}

/**
 * The date range block for filter drawers: quick presets over the app's own
 * calendar (the same `CalendarPopover` the dashboard picker uses). Tap one day
 * for that day, or tap a start and then an end day for a range.
 */
export function FilterDatePicker({
  from,
  to,
  presets,
  onRange,
}: {
  from: string
  to: string
  presets: readonly FilterDatePreset[]
  onRange: (range: { from: string; to: string }) => void
}) {
  const [start, setStart] = useState<string | null>(null)
  const [draft, setDraft] = useState<{ from: string; to: string }>({ from: from || '', to: to || '' })
  const d = getBusinessToday()
  const today = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}-${String(d.getUTCDate()).padStart(2, '0')}`
  const shown = start ? draft : { from: from || '', to: to || '' }

  return (
    <div style={{ display: 'grid', gridTemplateColumns: 'minmax(0, 1fr)', gap: 'var(--sp-sm)', minWidth: 0 }}>
      <div role="group" aria-label="Quick date ranges" style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(64px, 1fr))', gap: 6 }}>
        {presets.map((p) => (
          <button
            key={p.key}
            type="button"
            className="tap filter-chip"
            aria-pressed={p.active}
            onClick={() => { setStart(null); p.onSelect() }}
          >
            {p.label}
          </button>
        ))}
      </div>
      <CalendarPopover
        embedded
        showHeader={false}
        title="Date range"
        value={shown.from}
        range={shown}
        todayDate={today}
        shadePastDates={false}
        onSelectRange={({ from: f, to: t }) => {
          if (start) {
            setStart(null)
            onRange({ from: f, to: t })
          } else {
            setStart(f)
            setDraft({ from: f, to: t })
          }
        }}
        onDismiss={() => {
          if (start) { onRange({ from: start, to: start }); setStart(null) }
        }}
      />
      <p aria-live="polite" style={{ margin: 0, fontSize: 'var(--t-meta)', color: 'var(--muted)' }}>
        {start ? 'Now choose the end day (or tap away for one day).' : 'Tap a day, or a start and an end day.'}
      </p>
    </div>
  )
}
</file>

