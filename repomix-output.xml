          </div>
        </div>

        <div style={{ display: 'grid', gridTemplateColumns: money ? '1fr 1fr' : '1fr', gap: 'var(--sp-md)' }}>
          {money && (
          <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
            <label style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
              Estimated Cost (Rs)
            </label>
            <input
              type="number"
              min={0}
