              <div
                style={{
                  display: 'grid',
                  gridTemplateColumns: `repeat(${
                    viewport === 'phone'
                      ? 1
                      : viewport === 'tablet'
                        ? Math.min(2, group.cards.length)
                        : Math.min(group.desktopColumns, group.cards.length)
                  }, minmax(0, 1fr))`,
                  gap: 'var(--sp-md)',
                }}
              >
                {group.cards.map((card) => (
                  <Link
                    key={card.tab}
                    to={card.to}
                    onClick={(e) => {
                      e.preventDefault()
                      setTab(card.tab)
                    }}
                    style={{
                      ...cardStyle,
                      display: 'flex',
                      alignItems: 'flex-start',
                      gap: 12,
                      minHeight: 88,
                      padding: 14,
                      textAlign: 'left',
                      fontFamily: 'inherit',
                      cursor: 'pointer',
                      border: '1px solid var(--border)',
                      background: 'var(--card)',
                      textDecoration: 'none',
                    }}
                  >
                    <span
                      aria-hidden
                      style={{
                        width: 34,
                        height: 34,
                        borderRadius: 'var(--r-sm)',
                        display: 'grid',
                        placeItems: 'center',
                        background: 'var(--select-bg)',
                        color: 'var(--select-fg)',
                        flexShrink: 0,
                      }}
                    >
                      <Icon name={card.icon} size={18} />
                    </span>
                    <span style={{ minWidth: 0, flex: 1, display: 'flex', flexDirection: 'column', gap: 3 }}>
                      <span style={{ display: 'flex', alignItems: 'center', gap: 6, flexWrap: 'wrap' }}>
                        <span style={{ fontSize: 'var(--t-ui)', fontWeight: 700, color: 'var(--text)' }}>
                          {card.label}
                        </span>
                      </span>
                      <span style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', lineHeight: 1.45 }}>
                        {card.hint}
                      </span>
                    </span>
                  </Link>
                ))}
              </div>
            </section>
          ))}
        </div>
      )}

      {activeTab === 'depreciation' && money && <DepreciationCalculator embedded />}
      {activeTab === 'pricing' && money && <PricingCalculator embedded />}
      {/* RULING 2026-10-13: guarded like the two above — the tab strip hid Late
          Fee, but a typed `?tab=latefee` still rendered it for the floor. */}
      {activeTab === 'latefee' && money && <LateFeeCalculator />}
      {activeTab === 'cinematography' && <CineTools embedded />}

      <FooterNote extra={['All calculators run locally within Tools without navigating away']} />
    </PageShell>
  )
}
