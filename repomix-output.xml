<file path="src/lib/seedCompact.ts">
import { toRupees } from './money.ts'
import type { Paisa } from './money.ts'
import {
  INVOICE_ISSUED_STATUS,
  recordNo,
  SEQUENCES,
  VAT_PERCENT,
  type SeedCorpus,
} from './seed.ts'

/**
 * # The same corpus, as terse as SQL allows
 *
 * `seed.ts`'s `emitSql` is written to be **read**: one statement per row, the
 * provenance of every figure in a comment beside it, an assertion block per
 * booking. That is the right shape for a file a human reviews before it touches
 * a database — and for 120 bookings it costs 1.8 MB.
 *
 * This emitter exists because that file also has to be **transported**. Getting
 * it into a database through a tool call meant moving those 1.8 MB one chunk at
 * a time, twelve round trips of mostly commentary.
 *
 * ## Neither file is the source of truth — `buildCorpus()` is
 *
 * Both emitters render the same engine-derived corpus and **neither decides a
 * figure**. Every subtotal, discount, VAT amount, rental total, day count and
 * stage path below came out of `money.ts`, `validation.ts`, `discount.ts` and
 * `workflow.ts` before either emitter saw it. If the two ever disagree about a
 * number, that is a bug in one of them, not a second opinion.
 *
 * ## Two things make it small
 *
 * **1 · One `values` list per table, joined to reference data by natural key.**
 * The readable emitter repeats `(select id from bookings where booking_no =
 * 'B-800')` on every child row — about 150 characters of subquery per booking
 * line. Here the booking number appears once in a tuple and the join resolves
 * it for all of them.
 *
 * **2 · The database derives what is mechanically derivable.** Product units,
 * invoice lines and stage transitions are not shipped at all — they are
 * `generate_series`, a join, and a walk over the stage array. That is only
 * possible because `seedUuid` is MD5-based: `md5('…/seed/' || key)::uuid` in
 * SQL and `seedUuid(key)` in TypeScript produce the same `client_uuid`, so a
 * row invented by `generate_series` carries the identity the migration would
 * have given it and Law 8's idempotency survives either route.
 *
 * ## What it deliberately drops
 *
 * `booking_discounts` and `audit_events`. The discount is already on the
 * invoice — percent, amount, reason and approver — which is what every screen
 * reads; `booking_discounts.audit_event_id` would drag the audit table in
 * behind it for a row nothing renders. Recorded here rather than left to be
 * discovered as a difference between the two files.
 */
export function compactSeedSql(corpus: SeedCorpus): readonly string[] {
  const parts: string[] = []
  const q = (v: string): string => `'${v.replace(/'/g, "''")}'`
  const n = (v: number): string => v.toFixed(2)
  const money = (v: Paisa): string => toRupees(v).toFixed(2)
  const iso = (d: Date): string => `'${d.toISOString()}'`
  /** The uuid Postgres will compute for a key — identical to `seedUuid`. */
  const key = (expr: string): string => `md5('babin-rentals-os/seed/' || ${expr})::uuid`

  const USER = (email: string): string => `(select id from users where email = ${q(email)})`
  const BILLING = USER('billing@babinrentals.com')
  const STORE = USER('warehouse@babinrentals.com')
  const OWNER = USER('owner@babinrentals.com')
  const BR = `(select id from branches where branch_code = 'BR-KTM-01')`
  const WH = `(select id from warehouses where warehouse_code = 'WH-KTM-MAIN')`
  const BANK = `(select id from bank_accounts where account_number = '01201017500001')`

  /* 1 · clients */
  parts.push(`insert into clients (client_uuid, client_code, type_parent, org_subtype, name, phone,
  email, address_line, city, district, country, payment_terms, client_since, segments,
  preferred_contact_channels, status, created_by)
select ${key("'client:' || v.code")}, v.code, v.tp::client_type_parent,
  nullif(v.sub, '')::client_organisation_subtype, v.name, v.phone, v.email, v.addr, v.city,
  v.district, 'Nepal', v.terms::payment_terms, v.since::date,
  string_to_array(v.segments, '|')::client_segment[],
  array['Email','WhatsApp']::preferred_contact_channel[], 'Active', ${BILLING}
from (values
${corpus.clients
    .map((c) => {
      const code = recordNo(SEQUENCES.client, c.seq)
      return `(${q(code)},${q(c.typeParent)},${q(c.orgSubtype ?? '')},${q(c.name)},${q(c.phone)},${q(c.email)},${q(c.addressLine)},${q(c.city)},${q(c.district)},${q(c.paymentTerms)},${q(c.since)},${q(c.segments.join('|'))})`
    })
    .join(',\n')}
) as v(code,tp,sub,name,phone,email,addr,city,district,terms,since,segments)
on conflict (client_code) do nothing;`)

  /* 2 · products */
  parts.push(`insert into products (client_uuid, asset_code, name, category_id, brand, model,
  tracking_mode, status, total_quantity, daily_rate, replacement_value, min_rental_days,
  rental_enabled, is_active, created_by)
select ${key("'product:' || v.code")}, v.code, v.name, c.id, v.brand, v.model, 'Serialised',
  'Active', v.units::int, v.rate::numeric, v.repl::numeric, 1, true, true, ${STORE}
from (values
${corpus.products
    .map((p) => {
      const code = recordNo(SEQUENCES.equipment, p.seq)
      return `(${q(code)},${q(p.name)},${q(p.categoryCode)},${q(p.brand)},${q(p.model)},${n(p.dailyRateRupees)},${n(p.replacementValueRupees)},${p.units})`
    })
    .join(',\n')}
) as v(code,name,cat,brand,model,rate,repl,units)
join inventory_categories c on c.code = v.cat
on conflict (asset_code) do nothing;`)

  /* 3 · product units — expanded by the database from one row per PRODUCT.
     A unit is a property of the product, so every product gets its units
     whether or not anybody has booked it; Inventory counts units, and a
     catalogue of names with nothing behind them is not a catalogue. */
  const packedTags = [...new Set(corpus.bookings.flatMap((b) => b.units.map((u) => u.assetTag)))]
  parts.push(`insert into product_units (client_uuid, product_id, serial_no, asset_tag, status,
  condition, branch_id, warehouse_id, storage_zone_id, replacement_value, created_by)
select ${key("'product_unit:' || v.code || '-U' || lpad(g::text, 2, '0')")}, p.id,
  'SN-' || v.tag || '-' || lpad((v.serial_from + g - 1)::text, 4, '0'),
  v.code || '-U' || lpad(g::text, 2, '0'),
  case when (v.code || '-U' || lpad(g::text, 2, '0')) = any(${
    packedTags.length === 0 ? 'array[]::text[]' : `array[${packedTags.map(q).join(',')}]`
  })
    then 'Packed' else 'In Stock' end::inventory_state,
  'Good', ${BR}, ${WH}, z.id, p.replacement_value, ${STORE}
from (values
${corpus.products
    .map((p) => {
      const code = recordNo(SEQUENCES.equipment, p.seq)
      return `(${q(code)},${q(p.serialTag)},${p.serialFrom},${p.units},${q(p.zoneCode)})`
    })
    .join(',\n')}
) as v(code,tag,serial_from,units,zone)
cross join lateral generate_series(1, v.units) g
join products p on p.asset_code = v.code
join storage_zones z on z.code = v.zone
on conflict (asset_tag) do nothing;`)

  /* 4 · bookings */
  parts.push(`insert into bookings (client_uuid, booking_no, branch_id, client_id, project,
  pickup_at, return_at, delivery_type, deposit_required, created_by, updated_by)
select ${key("'booking:' || v.no")}, v.no, ${BR}, c.id, v.project, v.pickup::timestamptz,
  v.ret::timestamptz, 'Client Pickup', v.dep::numeric, ${BILLING}, ${BILLING}
from (values
${corpus.bookings
    .map(
      (b) =>
        `(${q(b.bookingNo)},${q(b.clientCode)},${q(b.spec.project)},${iso(b.spec.pickupAt)},${iso(b.spec.returnAt)},${n(b.spec.depositRequiredRupees)})`,
    )
    .join(',\n')}
) as v(no,client_code,project,pickup,ret,dep)
join clients c on c.client_code = v.client_code
on conflict (booking_no) do nothing;`)

  /* 5 · booking lines — Law 9: days is written explicitly, never by omission */
  parts.push(`insert into booking_lines (client_uuid, booking_id, line_type, product_id,
  description, qty, days, rate, sort_order, created_by)
select ${key("'booking_line:' || v.no || ':' || v.code")}, b.id, 'Equipment', p.id, p.name,
  v.qty::int, v.days::int, v.rate::numeric, v.sort::int, ${BILLING}
from (values
${corpus.bookings
    .flatMap((b) =>
      b.lines.map(
        (l) => `(${q(b.bookingNo)},${q(l.assetCode)},${l.qty},${l.days},${n(l.rateRupees)},${l.sortOrder})`,
      ),
    )
    .join(',\n')}
) as v(no,code,qty,days,rate,sort)
join bookings b on b.booking_no = v.no
join products p on p.asset_code = v.code
on conflict (client_uuid) do nothing;`)

  /* 6 · the physical units that actually went out, where the corpus knows them */
  const unitRows = corpus.bookings.flatMap((b) => {
    const packedAt = b.transitions.find((t) => t.to === 'Packed')?.occurredAt ?? b.spec.pickupAt
    return b.units.map((u) => `(${q(b.bookingNo)},${q(u.assetCode)},${q(u.assetTag)},${iso(packedAt)})`)
  })
  if (unitRows.length > 0) {
    parts.push(`insert into booking_line_units (client_uuid, booking_line_id, asset_id, qty,
  unit_state, is_required, packed, packed_at, packed_by, created_by)
select ${key("'booking_line_unit:' || v.no || ':' || v.tag")}, bl.id, pu.id, 1, 'Ready', true, true,
  v.packed_at::timestamptz, ${STORE}, ${STORE}
from (values
${unitRows.join(',\n')}
) as v(no,code,tag,packed_at)
join bookings b on b.booking_no = v.no
join products p on p.asset_code = v.code
join booking_lines bl on bl.booking_id = b.id and bl.product_id = p.id
join product_units pu on pu.asset_tag = v.tag
on conflict (client_uuid) do nothing;`)
  }

  /* 7 · crew */
  const crewRows = corpus.bookings.flatMap((b) =>
    b.crew.map((c) => `(${q(b.bookingNo)},${q(c.name)},${q(c.role)},${n(c.dayRateRupees)},${c.days})`),
  )
  if (crewRows.length > 0) {
    parts.push(`insert into booking_crew_lines (client_uuid, booking_id, name, crew_role, day_rate,
  days, created_by)
select ${key("'booking_crew_line:' || v.no || ':' || v.name")}, b.id, v.name, v.role::crew_role,
  v.rate::numeric, v.days::int, ${BILLING}
from (values
${crewRows.join(',\n')}
) as v(no,name,role,rate,days)
join bookings b on b.booking_no = v.no
on conflict (client_uuid) do nothing;`)
  }

  /* 8 · invoices, Draft — the only window in which the lines below and the
     restate after them may touch these columns at all (0006). */
  parts.push(`insert into invoices (client_uuid, invoice_no, booking_id, client_id, branch_id,
  status, issue_date, due_date, subtotal, discount_amount, discount_percent, discount_reason,
  discount_approved_by, taxable_amount, vat_rate, vat_amount, total_amount, paid_amount,
  outstanding_amount, created_by, updated_by)
select ${key("'invoice:' || v.no")}, v.no, b.id, c.id, ${BR}, 'Draft', v.issue::date, v.due::date,
  v.subtotal::numeric, v.discount::numeric, v.pct::numeric, nullif(v.reason, ''),
  case when v.approver = '' then null else (select id from users where email = v.approver) end,
  v.taxable::numeric, ${(VAT_PERCENT / 100).toFixed(4)}, v.vat::numeric, v.total::numeric, 0.00,
  v.total::numeric, ${BILLING}, ${BILLING}
from (values
${corpus.bookings
    .map((b) => {
      const s = b.spec
      const due = new Date(s.returnAt.getTime() + 7 * 24 * 60 * 60_000)
      return `(${q(b.invoiceNo)},${q(b.bookingNo)},${q(b.clientCode)},${q(s.pickupAt.toISOString().slice(0, 10))},${q(due.toISOString().slice(0, 10))},${money(b.breakdown.subtotal)},${money(b.breakdown.discount)},${n(s.discountPercent)},${q(s.discountReason ?? '')},${q(s.discountApproverEmail ?? '')},${money(b.breakdown.taxable)},${money(b.breakdown.vat)},${money(b.breakdown.rentalTotal)})`
    })
    .join(',\n')}
) as v(no,booking_no,client_code,issue,due,subtotal,discount,pct,reason,approver,taxable,vat,total)
join bookings b on b.booking_no = v.booking_no
join clients c on c.client_code = v.client_code
on conflict (invoice_no) do nothing;`)

  /* 9 · invoice lines, derived from the booking lines already loaded */
  parts.push(`insert into invoice_lines (client_uuid, invoice_id, line_kind, description, quantity,
  days, unit_rate, line_total, sort_order)
select ${key("'invoice_line:' || i.invoice_no || ':' || p.asset_code")}, i.id, 'Equipment Rental',
  bl.description, bl.qty, bl.days, bl.rate, bl.qty * bl.rate * bl.days, bl.sort_order
from booking_lines bl
join bookings b on b.id = bl.booking_id
join invoices i on i.booking_id = b.id
join products p on p.id = bl.product_id
on conflict (client_uuid) do nothing;`)

  parts.push(`insert into invoice_lines (client_uuid, invoice_id, line_kind, description, quantity,
  days, unit_rate, line_total, sort_order)
select ${key("'invoice_line:' || i.invoice_no || ':crew'")}, i.id, 'Crew Charges',
  'Crew — ' || string_agg(distinct cl.crew_role::text, ', '),
  count(*)::int, max(cl.days), avg(cl.day_rate), sum(cl.day_rate * cl.days), 900
from booking_crew_lines cl
join bookings b on b.id = cl.booking_id
join invoices i on i.booking_id = b.id
group by i.id, i.invoice_no
on conflict (client_uuid) do nothing;`)

  /* 10 · restate, then issue. The line inserts fired recalculate_invoice_totals();
     this puts the engine's figures back while the invoice is still Draft. */
  parts.push(`update invoices i set subtotal = v.subtotal::numeric,
  discount_amount = v.discount::numeric, taxable_amount = v.taxable::numeric,
  vat_amount = v.vat::numeric, total_amount = v.total::numeric,
  outstanding_amount = v.total::numeric - i.paid_amount
from (values
${corpus.bookings
    .map(
      (b) =>
        `(${q(b.invoiceNo)},${money(b.breakdown.subtotal)},${money(b.breakdown.discount)},${money(b.breakdown.taxable)},${money(b.breakdown.vat)},${money(b.breakdown.rentalTotal)})`,
    )
    .join(',\n')}
) as v(no,subtotal,discount,taxable,vat,total)
where i.invoice_no = v.no;`)

  parts.push(`update invoices set status = '${INVOICE_ISSUED_STATUS}'
where invoice_no in (${corpus.bookings.map((b) => q(b.invoiceNo)).join(',')});`)

  /* 11 · Law 5 — deposits are liabilities, in an account of their own that
     never touches total_amount or outstanding_amount. */
  const deposits = corpus.bookings.filter((b) => b.depositNo !== null)
  if (deposits.length > 0) {
    parts.push(`insert into security_deposits (client_uuid, deposit_no, booking_id, client_id,
  branch_id, required_amount, created_by, updated_by)
select ${key("'security_deposit:' || v.no")}, v.no, b.id, c.id, ${BR}, v.amount::numeric,
  ${BILLING}, ${BILLING}
from (values
${deposits
      .map(
        (b) => `(${q(b.depositNo ?? '')},${q(b.bookingNo)},${q(b.clientCode)},${n(b.spec.depositRequiredRupees)})`,
      )
      .join(',\n')}
) as v(no,booking_no,client_code,amount)
join bookings b on b.booking_no = v.booking_no
join clients c on c.client_code = v.client_code
on conflict (deposit_no) do nothing;`)

    const movements = deposits.filter((b) => b.spec.depositReceivedRupees > 0)
    if (movements.length > 0) {
      parts.push(`insert into deposit_movements (client_uuid, movement_no, security_deposit_id,
  movement_type, amount, bank_account_id, handled_by)
select ${key("'deposit_movement:' || v.no")}, v.no, d.id, 'Received', v.amount::numeric, ${BANK},
  ${BILLING}
from (values
${movements
        .map((b) => `(${q(`${b.depositNo ?? ''}-M1`)},${q(b.depositNo ?? '')},${n(b.spec.depositReceivedRupees)})`)
        .join(',\n')}
) as v(no,deposit_no,amount)
join security_deposits d on d.deposit_no = v.deposit_no
on conflict (movement_no) do nothing;`)
    }
  }

  /* 12 · Law 4 — payments are ledger rows, immutable once written */
  const payments = corpus.bookings.filter((b) => b.paymentNo !== null)
  if (payments.length > 0) {
    parts.push(`insert into payments (client_uuid, payment_no, booking_id, invoice_id, client_id,
  branch_id, amount, payment_type, status, payment_date, bank_account_id, received_by)
select ${key("'payment:' || v.no")}, v.no, b.id, i.id, c.id, ${BR}, v.amount::numeric,
  'Advance Payment', 'Received', v.paid_at::timestamptz, ${BANK}, ${BILLING}
from (values
${payments
      .map(
        (b) =>
          `(${q(b.paymentNo ?? '')},${q(b.bookingNo)},${q(b.invoiceNo)},${q(b.clientCode)},${money(b.breakdown.payments)},${iso(new Date(b.spec.pickupAt.getTime() - 48 * 60 * 60_000))})`,
      )
      .join(',\n')}
) as v(no,booking_no,invoice_no,client_code,amount,paid_at)
join bookings b on b.booking_no = v.booking_no
join invoices i on i.invoice_no = v.invoice_no
join clients c on c.client_code = v.client_code
on conflict (payment_no) do nothing;`)
  }

  /* 13 · the stage machine.
     booking_stage_transitions is the sole writer of bookings.stage (0021), and
     the DB re-validates every step. One row per booking is shipped — the target
     stage `workflow.ts` already proved reachable — and the walk up to it is the
     database's, over the same canonical six. */
  parts.push(`insert into booking_stage_transitions (client_uuid, booking_id, branch_id, from_stage,
  to_stage, occurred_at, actor_id, actor_role, source)
select ${key("'booking_stage_transition:' || v.no || ':' || s.name")}, b.id, ${BR},
  case when s.ord = 1 then null
       else lag(s.name) over (partition by v.no order by s.ord) end::booking_stage,
  s.name::booking_stage,
  b.pickup_at - make_interval(hours => 72 - (s.ord - 1)::int),
  ${OWNER}, 'Coordinator', 'seed'
from (values
${corpus.bookings.map((b) => `(${q(b.bookingNo)},${q(b.spec.stage)})`).join(',\n')}
) as v(no,target)
join bookings b on b.booking_no = v.no
join lateral (
  select name, ord
  from unnest(array['Quote','Booked','Packed','On Rent','Returned','Closed'])
    with ordinality as t(name, ord)
) s on s.ord <= (
  select ord
  from unnest(array['Quote','Booked','Packed','On Rent','Returned','Closed'])
    with ordinality as t2(name, ord)
  where t2.name = v.target
)
order by v.no, s.ord
on conflict (client_uuid) do nothing;`)

  /* 14 · sequence high-water, so the next number the app mints is not one of these */
  parts.push(
    [...corpus.sequenceHighWater]
      .sort((a, b) => a[0].localeCompare(b[0]))
      .map(
        ([k, value]) =>
          `update number_sequences set current_value = greatest(current_value, ${value}) where sequence_key = ${q(k)};`,
      )
      .join('\n'),
  )

  return parts
}
</file>

<file path="src/lib/serviceDue.ts">
import { formatBsOrAd, formatAd } from './bs'

/**
 * # Preventive service — the RULE
 *
 * RULING 2026-09-08 (R-28). Babin ruled three things and this module holds the
 * reading half of all three:
 *
 *   1. a unit is due when EITHER its elapsed-time interval OR its usage interval
 *      since the last completed preventive job is reached, whichever first;
 *   2. being due **warns only** — the unit stays bookable;
 *   3. the interval lives on the product MODEL.
 *
 * ## Law 1: this module decides, `queries/serviceDue.ts` fetches
 *
 * Nothing here touches a database, so every sentence a screen shows is testable
 * by execution. And nothing here re-derives due-ness: `due_reason` is computed
 * by `product_units_service_v` (migration `0103`) and read, not recomputed. A
 * second implementation of "is this due" in TypeScript is precisely the drift
 * this repo keeps paying for — the VAT rate has three sources and none of them
 * is authoritative. There is one source for this, and it is the view.
 *
 * What IS decided here is how the answer is SAID: which token, which words,
 * which date. That is presentation, it has no other home, and it is the part a
 * test can pin without a Postgres.
 *
 * ## Never colour alone
 *
 * Every state below carries a label AND an icon. `tone` is the third channel,
 * not the only one — CLAUDE.md's "never colour alone", which is an
 * accessibility rule before it is a style one.
 */

/** One row of `product_units_service_v`, as the view spells it. */
export interface ServiceRow {
  readonly unitId: string
  readonly productId: string
  /** When the last completed `Preventive Service` job finished, or intake. */
  readonly lastServiceAt: string
  readonly daysSinceService: number
  readonly rentalDaysSinceService: number
  readonly meterHoursSinceService: number
  /** Rental cycles (completed returns) since last preventive service (Pillar 1). */
  readonly rentalCyclesSinceService?: number
  /** The TIME due date. Null when the model sets no day interval — see `0103`. */
  readonly dueAt: string | null
  /** `'time'` · `'usage'` · null when the model has no plan, or nothing is due. */
  readonly dueReason: 'time' | 'usage' | null
  /** Days past `due_at` + grace. Null for a usage-only reason — see `0103`. */
  readonly overdueDays: number | null
  readonly serviceIntervalDays: number | null
  readonly serviceIntervalRentalDays: number | null
  readonly serviceIntervalMeterHours: number | null
  /** Model interval in rental cycles (e.g. 15 rentals for bulb/dust cleaning, 25 for cables). */
  readonly serviceIntervalRentalCycles?: number | null
  readonly serviceGraceDays: number
}

/** What a screen renders. `null` from `serviceStatus` means: show nothing. */
export interface ServiceStatus {
  /** `'due'` while inside the grace window, `'overdue'` past it. */
  readonly level: 'due' | 'overdue'
  /** The badge's words. Never the only signal — see the module note. */
  readonly label: string
  /** A design token name, resolved by `Badge`. Never the only signal either. */
  readonly tone: 'neutral' | 'danger'
  /** The tooltip: why it is due, and against what. */
  readonly detail: string
}

/**
 * Is this unit due, and how should that be said?
 *
 * `null` when nothing is due — which is the normal answer for every unit of
 * every model that has no preventive plan, and that is most of the catalogue.
 * Callers render nothing rather than an "OK" badge: a row that says nothing is
 * a row with nothing to say, and a fleet of green ticks trains the eye to skip
 * the one amber one.
 */
export function serviceStatus(row: ServiceRow): ServiceStatus | null {
  if (row.dueReason === null) return null

  const overdue = row.overdueDays !== null && row.overdueDays > 0

  return {
    level: overdue ? 'overdue' : 'due',
    label: overdue ? `Overdue by ${String(row.overdueDays ?? 0)} days` : 'Service due',
    /* R-28: the badge is a NEUTRAL token while it is merely due, and danger only
       once it is past grace. Due is information; overdue is a problem. Painting
       "due" in danger from day one is how a warning becomes wallpaper. */
    tone: overdue ? 'danger' : 'neutral',
    detail: serviceDetail(row),
  }
}

/**
 * The tooltip R-28 specifies, in its own words:
 *
 *     Due 14 Bhadra 2083 · 30 Aug 2026 — time
 *     — usage (42 of 40 rental days)
 *
 * The usage sentence names the counter that crossed and what it crossed, because
 * "due" with no number is a fact an operator cannot check. Where BOTH usage
 * counters have crossed, rental days are named first: they are the ones a
 * coordinator can reconcile against a booking list without opening the unit.
 */
export function serviceDetail(row: ServiceRow): string {
  if (row.dueReason === 'time') {
    const due = row.dueAt === null ? null : new Date(row.dueAt)
    const when =
      due === null || Number.isNaN(due.getTime())
        ? `${String(row.daysSinceService)} days since the last service`
        : `Due ${formatBsOrAd(due)} · ${formatAd(due)}`
    return `${when} — time (${String(row.daysSinceService)} of ${String(row.serviceIntervalDays ?? 0)} days)`
  }

  if (
    row.serviceIntervalRentalDays !== null &&
    row.rentalDaysSinceService >= row.serviceIntervalRentalDays
  ) {
    return `Due — usage (${String(row.rentalDaysSinceService)} of ${String(row.serviceIntervalRentalDays)} rental days)`
  }

  if (
    row.serviceIntervalMeterHours !== null &&
    row.meterHoursSinceService >= row.serviceIntervalMeterHours
  ) {
    return `Due — usage (${formatHours(row.meterHoursSinceService)} of ${formatHours(row.serviceIntervalMeterHours)} meter hours)`
  }

  if (
    row.serviceIntervalRentalCycles !== undefined &&
    row.serviceIntervalRentalCycles !== null &&
    (row.rentalCyclesSinceService ?? 0) >= row.serviceIntervalRentalCycles
  ) {
    return `Due — usage (${String(row.rentalCyclesSinceService ?? 0)} of ${String(row.serviceIntervalRentalCycles)} rental cycles)`
  }

  /* Unreachable while the view and this module agree on what `'usage'` means.
     Stated rather than thrown: a tooltip is not worth an exception, and a
     sentence that says the reason is unreadable is more useful to whoever has to
     fix the disagreement than a blank one. */
  return 'Due — usage, but the counter that crossed could not be identified.'
}

/** One decimal, and no trailing `.0` — a meter reads 42 hours, not 42.0. */
function formatHours(hours: number): string {
  return Number.isInteger(hours) ? String(hours) : hours.toFixed(1)
}

/**
 * Does this model have a preventive plan at all?
 *
 * The empty state R-28 asks the model page for (`No preventive plan`) and the
 * answer to "why does nothing on this model ever badge". All intervals
 * null means every trigger is off, which is deliberate and is the default for
 * every model in the catalogue.
 */
export function hasServicePlan(model: {
  serviceIntervalDays: number | null
  serviceIntervalRentalDays: number | null
  serviceIntervalMeterHours: number | null
  serviceIntervalRentalCycles?: number | null
}): boolean {
  return (
    model.serviceIntervalDays !== null ||
    model.serviceIntervalRentalDays !== null ||
    model.serviceIntervalMeterHours !== null ||
    (model.serviceIntervalRentalCycles !== undefined && model.serviceIntervalRentalCycles !== null)
  )
}
</file>

<file path="src/lib/settingsStore.ts">
/**
 * # The settings registry
 *
 * `lib/bookingRules.ts` said it plainly: *"no settings-persistence layer exists
 * in this build"* — every `Switch` on `Settings.tsx` held its own `useState`,
 * 59 values rendered as spans dressed up as selects, and the whole 2,544-line
 * screen had four real inputs. So VAT, payment terms and the session timeout
 * could be read and not changed, and the modules that consume them read a
 * literal instead.
 *
 * This is that layer, built the way `bookingRules.ts` and `lib/collapse.ts`
 * already do it — `localStorage`, one namespaced key per setting, no invented
 * database column and no migration. Real enough that a changed VAT rate
 * survives a reload and the next screen to read it gets the new number;
 * honest about being local until a `settings` table exists.
 *
 * ## What is a setting, and what only looks like one
 *
 * Not every value on that screen belongs here. "Calendar mode: BS + AD",
 * "Number format: Lakh / crore" and "Default currency: NPR" are **product
 * laws** — Foundation fixes them, no other branch is implemented, and a select
 * offering the alternative would be a control that lies. Those keep rendering
 * as values, with the reason attached, and never gain an input.
 *
 * A key here means: the value is genuinely variable, and something reads it.
 */

import { toRupees } from './money'
import { captureError } from './monitoring'
import { FEE_PER_CREW_DAY_PAISA } from '../data/crew'

import { readLocal, writeLocal, removeLocal } from './safeStorage'

export type SettingKey =
  | 'organisationName'
  | 'businessDescription'
  | 'vatNumber'
  | 'vatRatePercent'
  | 'crewCoordinationFeeRupees'
  | 'paymentTermsDays'
  | 'overdueStopDays'
  | 'latePaymentPercentPerMonth'
  | 'allowDepositSkipOnClose'
  | 'sessionTimeoutMinutes'
  | 'passwordPolicy'
  | 'density'
  | 'dateFormat'
  | 'decimalPlaces'
  | 'weekStarts'
  | 'language'
  | 'operationalDayStart'
  /* ── Operations rules, added 16 Aug 2026 ──────────────────────────────────
   * Each of these was a hardcoded constant carrying a PLAN.md ruling. They are
   * here because they are genuinely variable business rules rather than
   * arithmetic — the ruled answer becomes the `default`, so nothing changes
   * behaviour on the day this shipped, and the owner can change it without a
   * developer. See the doc comment on each spec for which ruling it carries. */
  | 'unitAvailabilityRule'
  | 'rentalTurnaround'
  | 'packingTreeGrouping'
  | 'packingPhotosRequired'
  | 'evidenceRetentionDays'
  /* ── WhatsApp deep links, added 1 Sep 2026 ───────────────────────────────
   * `docs/WHATSAPP_LINKS_SPEC_v1.0.md` §6.1 lists these as the spec's own OPEN
   * items. They are added here as FIELDS, not as answers: every default below
   * is empty, so this change asserts no pickup time, no business phone and no
   * owner number. Until the owner fills one in, the templates that need it are
   * offered disabled with the reason — which is the honest state, and is what
   * stops a session inventing "10:00 AM" to unblock itself (CLAUDE.md).
   */
  | 'businessPhone'
  | 'ownerWhatsappNumber'
  | 'defaultPickupTime'
  | 'defaultReturnTime'

export type SettingValue = string | number

export interface SettingSpec {
  default: SettingValue
  kind: 'text' | 'number' | 'select'
  /** `select` only. The whole allowed set; anything else is refused on save. */
  options?: readonly string[]
  /** Rendered after the value in read mode — `%`, ` days`. Never stored. */
  suffix?: string
  /** Returns an error string, or null. Runs before the value is written. */
  validate?: (v: SettingValue) => string | null
}

/** A percentage that a tax engine multiplies by cannot be a free-text field. */
function percent(v: SettingValue, label: string): string | null {
  const n = Number(v)
  if (!Number.isFinite(n)) return `${label} must be a number.`
  if (n < 0) return `${label} cannot be negative.`
  if (n > 100) return `${label} cannot exceed 100%.`
  return null
}

export const SETTING_SPECS: Record<SettingKey, SettingSpec> = {
  organisationName: {
    default: 'Babin Rentals',
    kind: 'text',
    validate: (v) => (String(v).trim() ? null : 'The organisation name appears on every document — it cannot be blank.'),
  },
  businessDescription: { default: 'Film & Production Equipment Rental', kind: 'text' },
  vatNumber: {
    default: '623587106',
    kind: 'text',
    /* Nepali PAN/VAT is nine digits. Refusing the shape here is the difference
       between a wrong number on one invoice and a wrong number on all of them. */
    validate: (v) => {
      const s = String(v).trim()
      if (!s) return null
      return /^\d{9}$/.test(s) ? null : 'A Nepali VAT/PAN is nine digits.'
    },
  },

  /* `lib/seed.ts:83` hard-codes `VAT_PERCENT = 13` and `bookingQuery.ts:1017`
     says the figure is "A PERCENTAGE (13, not 0.13) from Settings ▸ Finance".
     This is the Settings ▸ Finance that comment was pointing at. */
  vatRatePercent: { default: 13, kind: 'number', suffix: '%', validate: (v) => percent(v, 'VAT rate') },
  crewCoordinationFeeRupees: {
    /* Derived from `data/crew.ts`'s constant rather than retyped, so the
       default here and the figure the crew engine uses cannot disagree. Still
       a proposed default (§2.2), not a confirmed figure — PLAN.md §4. */
    default: toRupees(FEE_PER_CREW_DAY_PAISA),
    kind: 'number',
    validate: (v) => {
      const n = Number(v)
      if (!Number.isFinite(n) || n < 0) return 'A fee cannot be negative.'
      return null
    },
  },
  paymentTermsDays: {
    default: 14,
    kind: 'number',
    suffix: ' days',
    validate: (v) => {
      const n = Number(v)
      if (!Number.isInteger(n) || n < 0) return 'Credit terms are a whole number of days.'
      if (n > 365) return 'Credit terms beyond a year need a written agreement, not a default.'
      return null
    },
  },
  /**
   * **Rulings §11.2 — the On Stop threshold.**
   *
   * "On Stop" is not a `client_flag_type` and never will be: a client is on
   * stop when their outstanding exceeds their credit limit, **or** when they
   * hold an invoice more than this many days past its due date. The ruling puts
   * the number here, beside the payment terms, precisely so that no module
   * writes `30` into itself — §11.4: *"Every value here is read by a screen.
   * None is hardcoded."*
   *
   * Read by `data/clients.ts:readOverdueStopDays()`, which is the only reader;
   * the directory chip and the client record's credit box both go through the
   * one predicate that takes it.
   *
   * Deliberately NOT derived from `paymentTermsDays` (14). They answer
   * different questions — when an invoice falls due, versus how long a business
   * carries a late one before it stops trading with that client — and tying
   * them would move the second every time somebody edited the first.
   */
  overdueStopDays: {
    default: 30,
    kind: 'number',
    suffix: ' days',
    validate: (v) => {
      const n = Number(v)
      if (!Number.isInteger(n) || n < 1) return 'A client goes on stop after a whole number of days — at least one.'
      if (n > 365) return 'Past a year this is a write-off decision, not a stop threshold.'
      return null
    },
  },
  latePaymentPercentPerMonth: {
    default: 1.5,
    kind: 'number',
    suffix: '% / month',
    validate: (v) => percent(v, 'Late payment interest'),
  },
  /**
   * **RULING 2026-10-06 (migration 0155)** — whether Close offers "Skip deposit
   * with a reason" to Manager and above. `Off` is the default: until an owner
   * turns it on, an unresolved deposit blocks Close exactly as before.
   *
   * ⚠ This only decides whether the BUTTON is offered, on this device. It is
   * not the enforcement — `apply_booking_stage_transition` accepts a skip only
   * with a reason of at least 10 characters from Manager or above, whatever
   * this says. Revert = delete this key; nothing else reads it but `closeRental`
   * and the Close control.
   */
  allowDepositSkipOnClose: { default: 'Off', kind: 'select', options: ['Off', 'On'] },
  /**
   * The idle screen lock, in minutes. **`0` means off, and off is the default**
   * (ruled by the owner 25 Aug 2026).
   *
   * It was `default: 30` with a `n < 1` refusal, which made "off" unrepresentable
   * — every session got a 30-minute idle timer whether or not anyone asked for
   * one. Zero is admitted as a value rather than added as a second boolean
   * setting, so there is one number to read and no way for a flag and a duration
   * to disagree.
   *
   * `lib/auth.tsx` locks the screen when this elapses **and a PIN exists**; it
   * never signs anyone out. Read the ruling on that effect before widening this.
   */
  sessionTimeoutMinutes: {
    default: 0,
    kind: 'number',
    suffix: ' minutes (0 = off)',
    validate: (v) => {
      const n = Number(v)
      if (!Number.isInteger(n) || n < 0) return 'Use 0 to switch the idle lock off, or a whole number of minutes.'
      if (n > 0 && n < 1) return 'A timeout is at least one minute.'
      if (n > 480) return 'A timeout beyond eight hours is not a timeout.'
      return null
    },
  },
  passwordPolicy: { default: 'Strict', kind: 'select', options: ['Strict', 'Standard'] },
  density: { default: 'Comfortable', kind: 'select', options: ['Comfortable', 'Compact'] },
  dateFormat: { default: 'D MMM YYYY', kind: 'select', options: ['D MMM YYYY', 'DD/MM/YYYY', 'YYYY-MM-DD'] },
  decimalPlaces: {
    default: '0 (2 when paise exist)',
    kind: 'select',
    options: ['0 (2 when paise exist)', '2 always'],
  },
  weekStarts: { default: 'Sunday', kind: 'select', options: ['Sunday', 'Monday'] },

  /**
   * Ruled 12 Aug 2026 — the EN/NE toggle is live.
   *
   * Options are the endonyms, which is what a language picker shows: a user
   * looking for Nepali is looking for "नेपाली", not for the English word for it.
   * `lib/i18n.ts` owns the coverage gate; this only stores the choice.
   */
  language: { default: 'English', kind: 'select', options: ['English', 'नेपाली'] },

  /**
   * **D4, ruled 30 Aug 2026** (`docs/booqable/REFERENCE_SPEC_v2.5.md`
   * Appendix A0) — the operational day runs 06:00 → 06:00, **as a setting**.
   *
   * The clock time (Kathmandu) at which the rental day begins. "Today's
   * pickups" and "today's returns" run from this time today to this time
   * tomorrow, so a 05:30 return belongs to yesterday's operational day when
   * this reads 06:00 — which is what stops the Dashboard disagreeing with the
   * floor at 5am. `00:00` is a legal value and restores plain calendar days.
   *
   * Read by `queries/bookings.ts`'s day-boundary helpers (per call, like every
   * other consumer), which every named filter set — Dashboard panels, the
   * Operations day scope, the pickups drill-down — builds on. The pure
   * arithmetic lives in `lib/operationalDay.ts`; this key only stores the
   * choice (Law 1).
   *
   * Deliberately NOT applied to finance, audit or BS-calendar day boundaries —
   * see the header of `lib/operationalDay.ts` for why those stay calendar days.
   */
  operationalDayStart: {
    default: '06:00',
    kind: 'text',
    suffix: ' (HH:mm)',
    validate: (v) => {
      return /^([01]\d|2[0-3]):[0-5]\d$/.test(String(v).trim())
        ? null
        : 'The operational day starts at a clock time, written HH:mm — e.g. 06:00. Use 00:00 for plain calendar days.'
    },
  },

  /* ── Operations rules ──────────────────────────────────────────────────────
   *
   * Five rulings that used to be constants. The rule each one carries is stated
   * on its spec; the *mapping* from the label to what the engine does lives in
   * `lib/availability.ts` (Law 1 — a page, and a settings registry, may not
   * hold business logic). This file stores a choice; it does not interpret one.
   *
   * Every default is the answer that was ruled on 16 Aug 2026, so introducing
   * these changed no behaviour on the day they shipped. That is deliberate: a
   * setting whose default differs from the ruling would silently re-rule it.
   */

  /**
   * **PLAN.md §4.30(c), closing §4.14** — which units are out of the pool.
   *
   * Offered as three named presets rather than ten tick-boxes over
   * `inventory_state`, because the question an owner is actually answering is
   * "how cautious should assignment be", not "is Returning a disqualifying
   * state". The three are the three that were reasoned about when it was ruled;
   * `lib/availability.ts` holds what each maps to.
   *
   * ⚠ The lifecycle states (Reserved / Packed / On Rent / Returning) are absent
   * from every preset by design — they are facts about *today*, and the
   * date-overlap check already answers per-window. A preset that disqualified
   * them would make a camera out on rent this week unassignable for a shoot
   * three months away.
   */
  unitAvailabilityRule: {
    default: 'Condition only',
    kind: 'select',
    options: ['Condition only', 'Condition and turnaround', 'Only In Stock'],
  },

  /**
   * **PLAN.md §4.30(b)** — whether a booking ending at 18:00 frees its unit for
   * one starting at 18:00.
   *
   * Labelled in warehouse terms rather than as `half-open` / `closed`, because
   * the person setting it is deciding whether gear needs time between jobs, not
   * picking a range convention. `lib/availability.ts` maps it back.
   *
   * Ruled *"Same-instant handover allowed"* against a recommendation for the
   * other one — which is exactly why it is a setting now: if same-instant
   * turnaround proves wrong on the floor, it is one dropdown rather than a
   * release.
   */
  rentalTurnaround: {
    default: 'Same-instant handover allowed',
    kind: 'select',
    options: ['Same-instant handover allowed', 'Turnaround required'],
  },

  /** **PLAN.md §4.31(2)** — how the packing tree is grouped on the bench. */
  packingTreeGrouping: {
    default: 'Bundle, then category',
    kind: 'select',
    options: ['Bundle, then category', 'Category only'],
  },

  /**
   * **PLAN.md §4.31(1)** — Complete Packing's evidence gate.
   *
   * The ruling dissolved the per-case model: the gate is photos per BOOKING.
   * The count is a setting because "one" was ruled as a floor, not as a law —
   * a business wanting front-and-back of a loaded van sets two.
   *
   * Zero is allowed and means the gate is off. That is a real configuration
   * (a business that does not photograph packing), so it is permitted rather
   * than validated away — but it removes the evidence trail, which is why it
   * is not the default.
   */
  packingPhotosRequired: {
    default: 1,
    kind: 'number',
    suffix: ' per booking',
    validate: (v) => {
      const n = Number(v)
      if (!Number.isInteger(n) || n < 0) return 'A photo count is a whole number, zero or more.'
      if (n > 20) return 'More than twenty photos per booking is a workflow problem, not a setting.'
      return null
    },
  },

  /**
   * **PLAN.md §4.31(1b)** — how long a packing/evidence photo's IMAGE FILE is
   * kept after a booking completes. The `evidence_files` row is kept either
   * way; that is what keeps the ruling inside Law 0.
   *
   * **Zero means never expire, and is the default deliberately.** The ruling
   * said retention exists but *nobody stated a period*, and this is where a
   * period gets stated. Defaulting to any positive number would be inventing
   * the one part of that ruling that was never given — and it would start
   * destroying evidence on a schedule nobody chose.
   */
  evidenceRetentionDays: {
    default: 0,
    kind: 'number',
    suffix: ' days after completion (0 = keep)',
    validate: (v) => {
      const n = Number(v)
      if (!Number.isInteger(n) || n < 0) return 'A retention period is a whole number of days, or 0 to keep them.'
      if (n > 0 && n < 30) {
        return 'Under 30 days risks deleting a photo before a damage dispute is raised. Use 0 to keep them.'
      }
      if (n > 3650) return 'Beyond ten years, use 0 (keep) rather than a number nobody will revisit.'
      return null
    },
  },

  /**
   * **WHATSAPP_LINKS_SPEC v1.0 §6.1** — the number a client is told to ring in
   * the `overdue` template, and nowhere else.
   *
   * Empty by default and deliberately so: an overdue notice that names a wrong
   * number is worse than one the staff member cannot send, so while this is
   * blank the overdue template is offered DISABLED with that reason rather
   * than sent with a placeholder.
   */
  businessPhone: {
    default: '',
    kind: 'text',
    validate: (v) => {
      const s = String(v).trim()
      if (s === '') return null
      return s.replace(/\D/g, '').length >= 6
        ? null
        : 'A contact number clients can ring, or leave blank. Digits, spaces and dashes.'
    },
  },

  /**
   * **WHATSAPP_LINKS_SPEC v1.0 §2, §6.1** — the owner's OWN WhatsApp number,
   * the only recipient of the daily digest. It is not a client-facing field:
   * the digest carries takings and receivables (Law 6), so it goes to one
   * number the owner sets, never to a number derived from a booking.
   */
  ownerWhatsappNumber: {
    default: '',
    kind: 'text',
    validate: (v) => {
      const s = String(v).trim()
      if (s === '') return null
      return s.replace(/\D/g, '').length >= 8
        ? null
        : 'The full WhatsApp number, with or without +977. Leave blank to disable the digest.'
    },
  },

  /**
   * **WHATSAPP_LINKS_SPEC v1.0 §6.1** — the counter's usual pickup and return
   * times, written in the same `HH:mm` clock vocabulary as
   * `operationalDayStart`, which is what §6.1 means by *"read the D4
   * operationalDayStart world, not new literals"*.
   *
   * These are NOT derived from `operationalDayStart`: 06:00 is when the rental
   * DAY rolls over, not when a counter opens, and printing "Pickup from 06:00"
   * to a client because the two share a clock would be a fabricated fact. They
   * are separate, owner-set, and blank until then.
   */
  defaultPickupTime: { default: '', kind: 'text', suffix: ' (HH:mm)', validate: hhmmOrBlank },
  defaultReturnTime: { default: '', kind: 'text', suffix: ' (HH:mm)', validate: hhmmOrBlank },
}

/** `HH:mm`, or blank for "not set". Shared by the two WhatsApp time fields. */
function hhmmOrBlank(v: SettingValue): string | null {
  const s = String(v).trim()
  if (s === '') return null
  return /^([01]\d|2[0-3]):[0-5]\d$/.test(s)
    ? null
    : 'A clock time written HH:mm — e.g. 10:00. Leave blank if there is no usual time.'
}

/** Maps the stored label to the code `lib/i18n.ts` works in. */
export function languageCodeOf(value: SettingValue): 'en' | 'ne' {
  return String(value) === 'नेपाली' ? 'ne' : 'en'
}

export type SettingsRecord = Record<SettingKey, SettingValue>

export const SETTINGS_DEFAULTS: SettingsRecord = Object.fromEntries(
  (Object.keys(SETTING_SPECS) as SettingKey[]).map((k) => [k, SETTING_SPECS[k].default]),
) as SettingsRecord

const PREFIX = 'br.settings.'

/**
 * Validates a value against its own spec. Exported because the screen runs it
 * before writing and the store runs it again on read — a value that stopped
 * being valid (a spec tightened, a hand-edited localStorage) falls back to the
 * default rather than propagating into an invoice.
 */
export function validateSetting(key: SettingKey, value: SettingValue): string | null {
  const spec = SETTING_SPECS[key]
  if (spec.kind === 'select' && spec.options && !spec.options.includes(String(value))) {
    return `Must be one of: ${spec.options.join(', ')}.`
  }
  return spec.validate?.(value) ?? null
}

/**
 * RULING 2026-10-07 (G1): settings are shared across devices through the `settings` table (0158).
 * Only these two stay per-device — they are how THIS screen looks and reads, not business rules.
 */
export const DEVICE_LOCAL_KEYS: readonly SettingKey[] = ['density', 'language']
export function isDeviceLocalKey(key: SettingKey): boolean {
  return DEVICE_LOCAL_KEYS.includes(key)
}

/* The last values read from the database. `org` is the business-wide value; `byLocation` carries
   per-branch overrides (only operationalDayStart may have one — enforced by set_setting()). */
let remoteOrg: Partial<Record<SettingKey, SettingValue>> = {}
let remoteByLocation: Record<string, Partial<Record<SettingKey, SettingValue>>> = {}
const listeners = new Set<() => void>()

export interface RemoteSettingRow {
  key: string
  value: unknown
  scope: 'org' | 'location'
  location_id: string | null
}

function coerce(key: SettingKey, raw: unknown): SettingValue | null {
  const spec = SETTING_SPECS[key]
  const v: SettingValue | null =
    spec.kind === 'number' ? (typeof raw === 'number' || typeof raw === 'string' ? Number(raw) : null) : raw == null ? null : String(raw)
  if (v === null || (typeof v === 'number' && !Number.isFinite(v))) return null
  return validateSetting(key, v) === null ? v : null
}

/** Replace the in-memory copy with what the database returned. A row that no longer validates is ignored. */
export function applyRemoteSettings(rows: readonly RemoteSettingRow[]): void {
  const org: Partial<Record<SettingKey, SettingValue>> = {}
  const loc: Record<string, Partial<Record<SettingKey, SettingValue>>> = {}
  for (const r of rows) {
    if (!(r.key in SETTING_SPECS) || isDeviceLocalKey(r.key as SettingKey)) continue
    const key = r.key as SettingKey
    const v = coerce(key, r.value)
    if (v === null) continue
    if (r.scope === 'location' && r.location_id) (loc[r.location_id] ??= {})[key] = v
    else if (r.scope === 'org') org[key] = v
  }
  remoteOrg = org
  remoteByLocation = loc
  listeners.forEach((fn) => fn())
}

/** Optimistic update after a successful set_setting(). */
export function applyRemoteSettingPatch(patch: Partial<SettingsRecord>): void {
  remoteOrg = { ...remoteOrg, ...patch }
  listeners.forEach((fn) => fn())
}

export function subscribeSettings(fn: () => void): () => void {
  listeners.add(fn)
  return () => listeners.delete(fn)
}

/** Test seam. */
export function clearRemoteSettings(): void {
  remoteOrg = {}
  remoteByLocation = {}
}

/**
 * location → org → default. A branch override (D-1: operationalDayStart only) wins for that branch;
 * everything else is the business-wide value.
 */
export function getSettingForLocation(key: SettingKey, locationId: string | null | undefined): SettingValue {
  const override = locationId ? remoteByLocation[locationId]?.[key] : undefined
  return override ?? getSetting(key)
}

export function readSettings(): SettingsRecord {
  if (typeof window === 'undefined') return { ...SETTINGS_DEFAULTS, ...remoteOrg }
  const out = { ...SETTINGS_DEFAULTS }
  for (const key of Object.keys(SETTING_SPECS) as SettingKey[]) {
    /* A shared value wins over this device's old localStorage copy. A key the database has no row for
       yet falls through to the local value, so nothing reverts the day this ships. */
    const shared = isDeviceLocalKey(key) ? undefined : remoteOrg[key]
    if (shared !== undefined) {
      out[key] = shared
      continue
    }
    /* Guarded — this sweep runs on the load path and WebKit can throw. */
    const raw = readLocal(PREFIX + key)
    if (raw === null) continue
    // 7 Oct owner audit: correct the former built-in company PAN only.
    // Preserve every other explicit organisation override.
    if (key === 'vatNumber' && raw === '601928473') continue
    const spec = SETTING_SPECS[key]
    const parsed: SettingValue = spec.kind === 'number' ? Number(raw) : raw
    /*
     * ⚠ A stored value that no longer validates is DISCARDED and the default
     * substituted. That is the right call — a hand-edited localStorage must not
     * reach an invoice — but until 16 Aug 2026 it happened in total silence,
     * and the operations rules made that dangerous rather than merely untidy.
     *
     * The case: an owner sets `unitAvailabilityRule` to 'Only In Stock'; a
     * later build renames that option; the stored value stops validating and
     * this loop quietly restores 'Condition only'. Availability LOOSENS, gear
     * that was being held back becomes bookable again, and nothing anywhere
     * says so. A VAT rate reverting is visible on the next invoice; a
     * disqualifying-state set reverting is visible nowhere.
     *
     * Warning rather than throwing, because refusing to load settings at all
     * would take the app down over one bad key. This does not make it safe — it
     * makes it observable, which is the difference between a bug someone can
     * find and one nobody can.
     */
    const invalid = spec.kind === 'number' && !Number.isFinite(parsed as number) ? 'not a number' : validateSetting(key, parsed)
    if (invalid !== null) {
      console.warn(
        `[settings] Stored value for "${key}" was rejected (${invalid}) and the default ` +
          `${JSON.stringify(spec.default)} is being used instead. Stored: ${JSON.stringify(raw)}. ` +
          'If this is an operations rule, the behaviour it governs has just reverted to its default.',
      )
      captureError(new Error('Stored setting rejected'), { where: 'settingsStore.load', key, reason: invalid })
      continue
    }
    out[key] = parsed
  }
  return out
}

/** Writes only the keys in the patch. Refuses an invalid value rather than storing it. */
export function writeSettings(patch: Partial<SettingsRecord>): void {
  if (typeof window === 'undefined') return
  for (const [k, v] of Object.entries(patch) as Array<[SettingKey, SettingValue]>) {
    const problem = validateSetting(k, v)
    if (problem) throw new Error(problem)
    writeLocal(PREFIX + k, String(v))
  }
}

/** One setting, read fresh. For modules that need a value without the whole record. */
export function getSetting(key: SettingKey): SettingValue {
  return readSettings()[key]
}

/** Read-mode rendering: the stored value plus its spec's suffix. */
export function formatSetting(key: SettingKey, value: SettingValue): string {
  return `${value}${SETTING_SPECS[key].suffix ?? ''}`
}

/** Clears every stored override. Used by the screen's Reset and by tests. */
export function resetSettings(): void {
  if (typeof window === 'undefined') return
  for (const key of Object.keys(SETTING_SPECS) as SettingKey[]) {
    removeLocal(PREFIX + key)
  }
}
</file>

<file path="src/lib/settingsSync.ts">
import { newClientUuid, supabase } from './supabase'
import { captureError } from './monitoring'
import {
  SETTING_SPECS,
  SETTINGS_DEFAULTS,
  applyRemoteSettingPatch,
  applyRemoteSettings,
  getSetting,
  isDeviceLocalKey,
  writeSettings,
  type RemoteSettingRow,
  type SettingKey,
  type SettingValue,
  type SettingsRecord,
} from './settingsStore'

/**
 * Database side of the settings store (0158, G1). Kept apart from `settingsStore.ts` so the many modules
 * and tests that only READ a setting never import the Supabase client.
 *
 * RULING 2026-10-07: reads are best-effort — if the network is down the device keeps the last values it
 * had and its old local copy. Writes are NOT best-effort: a failed or refused `set_setting` throws, so the
 * screen never shows "saved" for a value no other device will see (P3).
 */
export async function hydrateSharedSettings(): Promise<void> {
  const { data, error } = await supabase.from('settings').select('key, value, scope, location_id')
  if (error) {
    captureError(error, { where: 'settingsSync.hydrate' })
    return
  }
  applyRemoteSettings((data ?? []) as unknown as RemoteSettingRow[])
}

async function setShared(key: SettingKey, value: SettingValue): Promise<void> {
  const { error } = await supabase.rpc('set_setting' as never, {
    p_client_uuid: newClientUuid(),
    p_key: key,
    p_value: value,
    p_scope: 'org',
    p_location_id: null,
  } as never)
  if (error) throw new Error(error.message.replace(/^GATE:[^|]*\|/, ''))
}

/** Saves a patch: shared keys go to the database, device-local keys stay on this device. */
export async function saveSettings(patch: Partial<SettingsRecord>): Promise<void> {
  const shared: Partial<SettingsRecord> = {}
  const local: Partial<SettingsRecord> = {}
  for (const [k, v] of Object.entries(patch) as Array<[SettingKey, SettingValue]>) {
    ;(isDeviceLocalKey(k) ? local : shared)[k] = v
  }
  if (Object.keys(local).length) writeSettings(local)
  for (const [k, v] of Object.entries(shared) as Array<[SettingKey, SettingValue]>) {
    await setShared(k, v)
    applyRemoteSettingPatch({ [k]: v })
  }
}

/** "Reset to defaults": writes each differing shared value back to its default — history keeps the old one. */
export async function resetSharedSettings(): Promise<void> {
  const back: Partial<SettingsRecord> = {}
  for (const k of Object.keys(SETTING_SPECS) as SettingKey[]) {
    if (!isDeviceLocalKey(k) && getSetting(k) !== SETTINGS_DEFAULTS[k]) back[k] = SETTINGS_DEFAULTS[k]
  }
  await saveSettings(back)
}
</file>

