<file path="src/modules/operations/DriverHandoverModal.tsx">
import { useState, useRef, useEffect, useCallback } from 'react'
import { Modal } from '../../components/ui/Modal'
import { Button } from '../../components/ui/Page'
import Icon from '../../components/ui/Icon'
import { Badge } from '../../components/ui/Badge'
import { newClientUuid } from '../../lib/supabase'
import { useAuth } from '../../lib/auth'
import { useToast } from '../../components/ui/Toast'

export interface DriverHandoverModalProps {
  isOpen: boolean
  onClose: () => void
  bookingNo: string
  bookingId: string
  clientName: string
  deliveryAddress?: string | null
  itemCount: number
  onSuccess?: () => void
}

interface GpsCoords {
  lat: number
  lng: number
  accuracy: number
  capturedAt: string
}

/**
 * Driver Delivery Handover Modal (Pillar 2).
 *
 * Designed for mobile drivers on the field in Nepal with spotty cellular coverage.
 * Features:
 *  - Thumb-friendly touch targets (min 48-52px)
 *  - Client digital signature canvas
 *  - GPS location stamping
 *  - Photo evidence capture
 *  - Online-only custody confirmation (R-40)
 *  - Law 6: Zero money displayed
 *  - Law 17: Client, never customer
 */
export function DriverHandoverModal({
  isOpen,
  onClose,
  bookingNo,
  bookingId,
  clientName,
  deliveryAddress,
  itemCount,
  onSuccess,
}: DriverHandoverModalProps) {
  const { user } = useAuth()
  const { showSuccessToast } = useToast()
  const [recipientName, setRecipientName] = useState(clientName)
  const [notes, setNotes] = useState('')
  const [isOnline, setIsOnline] = useState(() => (typeof navigator !== 'undefined' ? navigator.onLine : true))
  const [gps, setGps] = useState<GpsCoords | null>(null)
  const [gpsLoading, setGpsLoading] = useState(false)
  const [gpsError, setGpsError] = useState<string | null>(null)
  const [hasSignature, setHasSignature] = useState(false)
  const [photoData, setPhotoData] = useState<string | null>(null)
  const [submitting, setSubmitting] = useState(false)
  const [submitError, setSubmitError] = useState<string | null>(null)
  const submissionId = useRef<string | null>(null)

  const canvasRef = useRef<HTMLCanvasElement | null>(null)
  const isDrawing = useRef(false)
  const lastPoint = useRef<{ x: number; y: number } | null>(null)

  // Online / Offline listener
  useEffect(() => {
    const handleOnline = () => setIsOnline(true)
    const handleOffline = () => setIsOnline(false)
    window.addEventListener('online', handleOnline)
    window.addEventListener('offline', handleOffline)
    return () => {
      window.removeEventListener('online', handleOnline)
      window.removeEventListener('offline', handleOffline)
    }
  }, [])

  // Setup canvas high-DPI scaling
  const setupCanvas = useCallback(() => {
    const canvas = canvasRef.current
    if (!canvas) return
    const ctx = canvas.getContext('2d')
    if (!ctx) return

    const rect = canvas.getBoundingClientRect()
    const dpr = window.devicePixelRatio || 1
    canvas.width = rect.width * dpr
    canvas.height = rect.height * dpr
    ctx.scale(dpr, dpr)
    ctx.strokeStyle = '#0f172a'
    ctx.lineWidth = 2.5
    ctx.lineCap = 'round'
    ctx.lineJoin = 'round'
  }, [])

  useEffect(() => {
    if (isOpen) {
      // Allow DOM to layout
      const timer = setTimeout(setupCanvas, 100)
      return () => clearTimeout(timer)
    }
  }, [isOpen, setupCanvas])

  // Canvas drawing handlers
  const getCanvasCoords = (e: React.MouseEvent<HTMLCanvasElement> | React.TouchEvent<HTMLCanvasElement>) => {
    const canvas = canvasRef.current
    if (!canvas) return { x: 0, y: 0 }
    const rect = canvas.getBoundingClientRect()
    if ('touches' in e && e.touches[0]) {
      return {
        x: e.touches[0].clientX - rect.left,
        y: e.touches[0].clientY - rect.top,
      }
    }
    const me = e as React.MouseEvent<HTMLCanvasElement>
    return {
      x: me.clientX - rect.left,
      y: me.clientY - rect.top,
    }
  }

  const startDrawing = (e: React.MouseEvent<HTMLCanvasElement> | React.TouchEvent<HTMLCanvasElement>) => {
    isDrawing.current = true
    const pt = getCanvasCoords(e)
    lastPoint.current = pt
    const ctx = canvasRef.current?.getContext('2d')
    if (ctx) {
      ctx.beginPath()
      ctx.moveTo(pt.x, pt.y)
    }
  }

  const draw = (e: React.MouseEvent<HTMLCanvasElement> | React.TouchEvent<HTMLCanvasElement>) => {
    if (!isDrawing.current || !canvasRef.current) return
    const ctx = canvasRef.current.getContext('2d')
    if (!ctx) return
    const pt = getCanvasCoords(e)
    ctx.lineTo(pt.x, pt.y)
    ctx.stroke()
    setHasSignature(true)
    lastPoint.current = pt
  }

  const stopDrawing = () => {
    isDrawing.current = false
    lastPoint.current = null
  }

  const clearSignature = () => {
    const canvas = canvasRef.current
    if (!canvas) return
    const ctx = canvas.getContext('2d')
    if (!ctx) return
    ctx.clearRect(0, 0, canvas.width, canvas.height)
    setHasSignature(false)
  }

  // GPS coordinates capture
  const captureGps = () => {
    if (!navigator.geolocation) {
      setGpsError('Geolocation is not supported by your browser')
      return
    }
    setGpsLoading(true)
    setGpsError(null)
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        setGps({
          lat: pos.coords.latitude,
          lng: pos.coords.longitude,
          accuracy: Math.round(pos.coords.accuracy),
          capturedAt: new Date().toISOString(),
        })
        setGpsLoading(false)
      },
      (err) => {
        setGpsError(err.message || 'Unable to retrieve location')
        setGpsLoading(false)
      },
      { timeout: 10000, enableHighAccuracy: true },
    )
  }

  // Photo handling
  const handlePhotoUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0]
    if (!file) return
    const reader = new FileReader()
    reader.onload = (event) => {
      setPhotoData(event.target?.result as string)
    }
    reader.readAsDataURL(file)
  }

  // Submit delivery handover
  const handleSubmit = async () => {
    if (!isOnline || !navigator.onLine) {
      setSubmitError('Reconnect before confirming handover. No custody change was queued.');
      return;
    }
    if (!user?.id) {
      setSubmitError('Sign in before confirming handover.');
      return;
    }
    if (!recipientName.trim()) {
      setSubmitError('Receiver name is required.')
      return
    }
    if (!hasSignature) {
      setSubmitError('Client signature is required for delivery handover.')
      return
    }

    setSubmitting(true)
    setSubmitError(null)

    const clientUuid = submissionId.current ??= newClientUuid()
    const occurredAt = new Date().toISOString()
    // Online delivery dispatch
    try {
      const { handoverRental } = await import('../../actions/rentals/index')
      await handoverRental(
        {
          bookingId,
          lines: [],
          clientUuid,
          occurredAt,
          notes: [
            `Field delivery handover signed by ${recipientName.trim()}`,
            gps ? `GPS: ${gps.lat.toFixed(5)}, ${gps.lng.toFixed(5)} (±${gps.accuracy}m)` : null,
            notes.trim() ? `Notes: ${notes.trim()}` : null,
          ]
            .filter((n): n is string => n !== null)
            .join('\n'),
          signatures: [
            {
              role: 'Receiver',
              signerName: recipientName.trim(),
              signedAt: occurredAt,
              isRequired: true,
            },
          ],
        },
        { userId: user.id, role: user.role },
      )

      showSuccessToast('Handover Completed', `Delivery for ${bookingNo} handed over to ${recipientName.trim()}`)
      onSuccess?.()
      onClose()
    } catch (err) {
      setSubmitError(`Handover could not be confirmed. Keep this form open and retry when connected. ${err instanceof Error ? err.message : String(err)}`)
    } finally {
      setSubmitting(false)
    }
  }

  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      title="Driver Field Delivery Handover"
      subtitle={`Booking #${bookingNo} · ${itemCount} ${itemCount === 1 ? 'item' : 'items'}`}
      size="md"
    >
      <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
        {/* Network status indicator */}
        <div
          style={{
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            padding: '8px 12px',
            background: isOnline ? 'var(--st-in-bg)' : 'var(--st-out-bg)',
            borderRadius: 'var(--radius-sm)',
            border: `1px solid ${isOnline ? 'var(--st-in-border)' : 'var(--st-out-border)'}`,
          }}
        >
          <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
            <span
              style={{
                width: 8,
                height: 8,
                borderRadius: '50%',
                background: isOnline ? 'var(--st-in-fg)' : 'var(--st-out-fg)',
              }}
              aria-hidden="true"
            />
            <span style={{ fontSize: 'var(--t-caption)', fontWeight: 600 }}>
              {isOnline ? 'Online (confirmation available)' : 'Offline — connection required for handover'}
            </span>
          </div>
          <Badge
            tone={isOnline ? 'in' : 'warning'}
            label={isOnline ? 'Connected' : 'Cannot Confirm'}
            size="sm"
          />
        </div>

        {/* Error Banner */}
        {submitError && (
          <div
            style={{
              padding: '10px 12px',
              background: 'var(--st-danger-bg)',
              color: 'var(--st-danger-fg)',
              borderRadius: 'var(--radius-sm)',
              border: '1px solid var(--st-danger-border)',
              fontSize: 'var(--t-caption)',
            }}
            role="alert"
          >
            {submitError}
          </div>
        )}

        {/* Recipient Details */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
          <label style={{ fontSize: 'var(--t-caption)', fontWeight: 600, color: 'var(--text)' }}>
            Client Receiver Name *
          </label>
          <input
            type="text"
            value={recipientName}
            onChange={(e) => setRecipientName(e.target.value)}
            placeholder="Full name of person receiving equipment"
            style={{
              height: 48,
              padding: '0 12px',
              borderRadius: 'var(--radius-sm)',
              border: '1px solid var(--border)',
              background: 'var(--surface)',
              color: 'var(--text)',
              fontSize: 'var(--t-body)',
            }}
          />
          {deliveryAddress && (
            <span style={{ fontSize: 'var(--t-micro)', color: 'var(--text2)' }}>
              Venue/Destination: {deliveryAddress}
            </span>
          )}
        </div>

        {/* GPS Coordinate Stamping */}
        <div
          style={{
            display: 'flex',
            flexDirection: 'column',
            gap: 6,
            padding: '10px 12px',
            background: 'var(--card2)',
            borderRadius: 'var(--radius-sm)',
            border: '1px solid var(--border)',
          }}
        >
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
            <span style={{ fontSize: 'var(--t-caption)', fontWeight: 600 }}>GPS Delivery Stamp</span>
            <Button
              variant="secondary"
              size="sm"
              onClick={captureGps}
              disabled={gpsLoading}
              style={{ minHeight: 44 }}
            >
              <Icon name="flag" size={13} style={{ marginRight: 4 }} />
              {gpsLoading ? 'Locating...' : gps ? 'Update GPS' : 'Tag GPS Location'}
            </Button>
          </div>
          {gps && (
            <div style={{ fontSize: 'var(--t-micro)', color: 'var(--st-in-fg)', fontWeight: 500 }}>
              📍 {gps.lat.toFixed(5)}° N, {gps.lng.toFixed(5)}° E (accuracy ±{gps.accuracy}m)
            </div>
          )}
          {gpsError && (
            <div style={{ fontSize: 'var(--t-micro)', color: 'var(--st-danger-fg)' }}>
              ⚠️ {gpsError}
            </div>
          )}
        </div>

        {/* Digital Signature Canvas */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
            <label style={{ fontSize: 'var(--t-caption)', fontWeight: 600, color: 'var(--text)' }}>
              Client Digital Signature *
            </label>
            {hasSignature && (
              <button
                type="button"
                onClick={clearSignature}
                style={{
                  background: 'none',
                  border: 'none',
                  color: 'var(--text2)',
                  fontSize: 'var(--t-caption, 12px)',
                  cursor: 'pointer',
                  textDecoration: 'underline',
                  padding: '6px 10px',
                  minHeight: 44,
                  display: 'inline-flex',
                  alignItems: 'center',
                }}
              >
                Clear signature
              </button>
            )}
          </div>
          <div
            style={{
              border: '2px dashed var(--border)',
              borderRadius: 'var(--radius-sm)',
              background: '#ffffff',
              height: 160,
              position: 'relative',
              touchAction: 'none',
            }}
          >
            <canvas
              ref={canvasRef}
              onMouseDown={startDrawing}
              onMouseMove={draw}
              onMouseUp={stopDrawing}
              onMouseLeave={stopDrawing}
              onTouchStart={startDrawing}
              onTouchMove={draw}
              onTouchEnd={stopDrawing}
              style={{ width: '100%', height: '100%', cursor: 'crosshair', display: 'block' }}
            />
            {!hasSignature && (
              <div
                style={{
                  position: 'absolute',
                  inset: 0,
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'center',
                  pointerEvents: 'none',
                  color: '#94a3b8',
                  fontSize: 'var(--t-caption)',
                }}
              >
                Sign here with finger or stylus
              </div>
            )}
          </div>
        </div>

        {/* Photo Evidence Capture */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
          <label style={{ fontSize: 'var(--t-caption)', fontWeight: 600, color: 'var(--text)' }}>
            Delivery Drop-off Photo Evidence (Optional)
          </label>
          <div style={{ display: 'flex', alignItems: 'center', gap: 12 }}>
            <label
              style={{
                display: 'inline-flex',
                alignItems: 'center',
                gap: 6,
                minHeight: 44,
                padding: '0 14px',
                borderRadius: 'var(--radius-sm)',
                border: '1px solid var(--border)',
                background: 'var(--card2)',
                color: 'var(--text)',
                cursor: 'pointer',
                fontSize: 'var(--t-caption)',
                fontWeight: 500,
              }}
            >
              <Icon name="camera" size={16} />
              <span>{photoData ? 'Replace Photo' : 'Capture Photo'}</span>
              <input
                type="file"
                aria-label="Capture delivery drop-off photo"
                accept="image/*"
                capture="environment"
                onChange={handlePhotoUpload}
                style={{ display: 'none' }}
              />
            </label>
            {photoData && (
              <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                <img
                  src={photoData}
                  alt="Delivery drop-off preview"
                  style={{ width: 44, height: 44, objectFit: 'cover', borderRadius: 'var(--radius-sm)' }}
                />
                <button
                  type="button"
                  onClick={() => setPhotoData(null)}
                  style={{
                    width: 44,
                    height: 44,
                    minWidth: 44,
                    minHeight: 44,
                    display: 'grid',
                    placeItems: 'center',
                    background: 'none',
                    border: 'none',
                    color: 'var(--text2)',
                    fontSize: '18px',
                    cursor: 'pointer',
                    borderRadius: 'var(--radius-sm)',
                  }}
                  aria-label="Remove photo"
                  title="Remove photo"
                >
                  ✕
                </button>
              </div>
            )}
          </div>
        </div>

        {/* Delivery Notes */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
          <label style={{ fontSize: 'var(--t-caption)', fontWeight: 600, color: 'var(--text)' }}>
            Handover Notes
          </label>
          <textarea
            value={notes}
            onChange={(e) => setNotes(e.target.value)}
            rows={2}
            placeholder="e.g., Handed over at loading bay, cases sealed."
            style={{
              padding: '8px 12px',
              borderRadius: 'var(--radius-sm)',
              border: '1px solid var(--border)',
              background: 'var(--surface)',
              color: 'var(--text)',
              fontSize: 'var(--t-body)',
              resize: 'vertical',
            }}
          />
        </div>

        {/* Action Controls */}
        <div style={{ display: 'flex', gap: 10, marginTop: 8 }}>
          <Button
            variant="secondary"
            onClick={onClose}
            disabled={submitting}
            style={{ flex: 1, minHeight: 52 }}
          >
            Cancel
          </Button>
          <Button
            variant="primary"
            onClick={handleSubmit}
            disabled={submitting || !isOnline}
            style={{
              flex: 2,
              minHeight: 52,
              fontSize: 'var(--t-body)',
              fontWeight: 600,
            }}
          >
            {submitting ? 'Confirming...' : !isOnline ? 'Reconnect to Confirm' : 'Confirm Delivery Handover'}
          </Button>
        </div>
      </div>
    </Modal>
  )
}
</file>

<file path="src/modules/operations/LiveTransportPlans.tsx">
import { useEffect, useState, useMemo, useCallback } from 'react'
import { Link } from 'react-router-dom'
import { PageHeader, cardStyle, Button } from '../../components/ui/Page'
import { PageShell } from '../../components/ui/PageShell'
import { PageBody } from '../../components/ui/PageBody'
import { DataTableShell } from '../../components/ui/DataTable'
import { SearchInput } from '../../components/ui/SearchInput'
import { EmptyState } from '../../components/ui/StateViews'
import Icon from '../../components/ui/Icon'
import { useViewport } from '../../lib/device'
import { useAuth } from '../../lib/auth'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import { formatMoney, rupees } from '../../lib/money'
import { useDomainEvent } from '../../events/useDomainEvent'
import { EVENT_TYPES } from '../../events/eventBus'
import { useToast } from '../../components/ui/Toast'
import { DriverHandoverModal } from './DriverHandoverModal'
import {
  getLiveTransportPlans,
  liveTransportReadRefusal,
  type LiveTransportPlan,
} from '../../lib/queries/liveTransportPlans'

export default function LiveTransportPlans() {
  const { user } = useAuth()
  const viewport = useViewport()
  const onPhone = viewport === 'phone'
  const money = useCanViewMoney()
  const role = user?.role ?? null
  const refusal = liveTransportReadRefusal(role)
  const [data, setData] = useState<LiveTransportPlan[] | null>(null)
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [search, setSearch] = useState('')
  const [methodFilter, setMethodFilter] = useState<'All' | string>('All')
  const [handoverTarget, setHandoverTarget] = useState<LiveTransportPlan | null>(null)
  const { showSuccessToast } = useToast()

  const loadData = useCallback(() => {
    if (refusal) return
    setLoading(true)
    setError(null)
    void getLiveTransportPlans(role)
      .then((rows) => {
        setData(rows)
        setLoading(false)
      })
      .catch((err: unknown) => {
        setError(err instanceof Error ? err.message : 'Transport plans unavailable.')
        setLoading(false)
      })
  }, [role, refusal])

  useEffect(() => {
    loadData()
  }, [loadData])

  // Realtime updates when bookings change or handovers complete
  useDomainEvent(EVENT_TYPES.RENTAL_HANDED_OVER, loadData)
  useDomainEvent(EVENT_TYPES.RENTAL_CONFIRMED, loadData)
  useDomainEvent(EVENT_TYPES.RENTAL_PICKED_UP, loadData)

  const filteredData = useMemo(() => {
    if (!data) return []
    const term = search.trim().toLowerCase()
    return data.filter((item) => {
      if (methodFilter !== 'All' && item.deliveryType !== methodFilter) return false
      if (!term) return true
      return (
        item.bookingNo.toLowerCase().includes(term) ||
        item.clientName.toLowerCase().includes(term) ||
        (item.handoverLocation && item.handoverLocation.toLowerCase().includes(term)) ||
        (item.vehicle && item.vehicle.toLowerCase().includes(term)) ||
        (item.numberPlate && item.numberPlate.toLowerCase().includes(term)) ||
        (item.driverContact && item.driverContact.toLowerCase().includes(term))
      )
    })
  }, [data, search, methodFilter])

  const deliveryMethods = useMemo(() => {
    if (!data) return []
    return Array.from(new Set(data.map((d) => d.deliveryType))).filter(Boolean)
  }, [data])

  return (
    <PageShell
      title="Delivery & Logistics"
      header={
        <PageHeader
          title="Delivery & Logistics"
          description="Live transport plans and driver dispatch. Real-time database synced."
          actions={
            <Button
              icon="refresh"
              variant="outline"
              onClick={loadData}
              disabled={loading}
              aria-label="Refresh transport plans"
            >
              {loading ? 'Refreshing…' : 'Refresh'}
            </Button>
          }
        />
      }
    >
      <PageBody error={refusal}>
        <div style={{ ...cardStyle, padding: '14px 18px', marginBottom: 'var(--sp-md)' }}>
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 12, flexWrap: 'wrap' }}>
            <div>
              <strong style={{ fontSize: 'var(--t-h3, 16px)' }}>Live Dispatch & Handover Queue</strong>
              <p style={{ margin: '4px 0 0', color: 'var(--text2)', fontSize: 'var(--t-meta, 13px)' }}>
                Saved transport plans from confirmed bookings. Tap <strong>Deliver & Sign</strong> to record proof of delivery with digital client signature and GPS location.
              </p>
            </div>
          </div>
        </div>

        {/* Toolbar: Search & Delivery Method Filters */}
        <div
          style={{
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            gap: 12,
            marginBottom: 'var(--sp-md)',
            flexWrap: 'wrap',
          }}
        >
          <div style={{ flex: '1 1 260px', maxWidth: 360 }}>
            <SearchInput
              value={search}
              onChange={setSearch}
              onClear={() => setSearch('')}
              placeholder="Search booking, client, vehicle, location…"
              aria-label="Search delivery transport plans"
            />
          </div>

          {deliveryMethods.length > 0 && (
            <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap' }}>
              <button
                type="button"
                onClick={() => setMethodFilter('All')}
                style={{
                  minHeight: 44,
                  padding: '0 14px',
                  borderRadius: 'var(--r-btn, 8px)',
                  border: `1px solid ${methodFilter === 'All' ? 'var(--primary)' : 'var(--border)'}`,
                  background: methodFilter === 'All' ? 'var(--nav-active-bg)' : 'var(--card)',
                  color: methodFilter === 'All' ? 'var(--primary-text)' : 'var(--text)',
                  fontSize: 'var(--t-meta, 13px)',
                  fontWeight: methodFilter === 'All' ? 700 : 500,
                  cursor: 'pointer',
                  transition: 'all var(--dur-fast) ease',
                }}
              >
                All Methods ({data?.length ?? 0})
              </button>
              {deliveryMethods.map((m) => {
                const count = data?.filter((d) => d.deliveryType === m).length ?? 0
                const active = methodFilter === m
                return (
                  <button
                    key={m}
                    type="button"
                    onClick={() => setMethodFilter(m)}
                    style={{
                      minHeight: 44,
                      padding: '0 14px',
                      borderRadius: 'var(--r-btn, 8px)',
                      border: `1px solid ${active ? 'var(--primary)' : 'var(--border)'}`,
                      background: active ? 'var(--nav-active-bg)' : 'var(--card)',
                      color: active ? 'var(--primary-text)' : 'var(--text)',
                      fontSize: 'var(--t-meta, 13px)',
                      fontWeight: active ? 700 : 500,
                      cursor: 'pointer',
                      transition: 'all var(--dur-fast) ease',
                    }}
                  >
                    {m} ({count})
                  </button>
                )
              })}
            </div>
          )}
        </div>

        {!refusal && error && (
          <div role="alert" style={{ ...cardStyle, color: 'var(--danger-text)', padding: 16 }}>
            Unable to load live transport plans: {error}
          </div>
        )}

        {!refusal && !error && loading && !data && (
          <div role="status" style={{ ...cardStyle, padding: 24, textAlign: 'center', color: 'var(--muted)' }}>
            Loading live transport plans from database…
          </div>
        )}

        {!refusal && !error && data && data.length === 0 && (
          <div role="status" style={{ ...cardStyle, padding: 32, textAlign: 'center' }}>
            <strong style={{ display: 'block', fontSize: 'var(--t-h3, 16px)', marginBottom: 6 }}>No transport plans found</strong>
            <p style={{ color: 'var(--text2)', margin: 0 }}>
              Confirmed bookings requiring Babin Delivery or Courier transport will appear here.
            </p>
          </div>
        )}

        {!refusal && !error && data && data.length > 0 && filteredData.length === 0 && (
          <EmptyState
            kind="no-results"
            title="No transport plans match your filter"
            description={`No plans match "${search}". Try clearing your search query.`}
            actionLabel="Clear filter"
            onAction={() => {
              setSearch('')
              setMethodFilter('All')
            }}
          />
        )}

        {!refusal && !error && filteredData.length > 0 && (
          onPhone ? (
            <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-sm)' }}>
              <div style={{ padding: '4px 2px 8px', display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
                <h3 style={{ margin: 0, fontSize: 'var(--t-h3, 15px)', fontWeight: 700 }}>
                  Active Transport Plans ({filteredData.length})
                </h3>
              </div>
              {filteredData.map((item) => (
                <article
                  key={item.id}
                  style={{
                    ...cardStyle,
                    padding: '16px',
                    display: 'flex',
                    flexDirection: 'column',
                    gap: 12,
                    position: 'relative',
                  }}
                >
                  {/* Top row: Booking Number & Delivery Type Badge */}
                  <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 8, flexWrap: 'wrap' }}>
                    <Link
                      to={`/rentals/${encodeURIComponent(item.bookingNo)}`}
                      style={{
                        fontSize: 'var(--t-h3, 16px)',
                        fontWeight: 700,
                        color: 'var(--primary-text)',
                        textDecoration: 'none',
                        display: 'inline-flex',
                        alignItems: 'center',
                        gap: 6,
                      }}
                    >
                      <Icon name="truck" size={16} />
                      <span>{item.bookingNo}</span>
                    </Link>
                    <span
                      style={{
                        padding: '3px 8px',
                        borderRadius: 'var(--r-badge, 4px)',
                        background: item.deliveryType === 'Babin Delivery' ? 'var(--nav-active-bg)' : 'var(--surface-2)',
                        color: item.deliveryType === 'Babin Delivery' ? 'var(--primary-text)' : 'var(--text2)',
                        fontSize: '12px',
                        fontWeight: 600,
                      }}
                    >
                      {item.deliveryType}
                    </span>
                  </div>

                  {/* Client & Destination */}
                  <div style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
                    <div style={{ fontSize: 'var(--t-ui, 15px)', fontWeight: 600, color: 'var(--text)' }}>
                      {item.clientName}
                    </div>
                    {item.handoverLocation && (
                      <div style={{ fontSize: 'var(--t-meta, 13px)', color: 'var(--text2)', display: 'flex', alignItems: 'flex-start', gap: 6 }}>
                        <Icon name="truck" size={14} style={{ flexShrink: 0, marginTop: 2, color: 'var(--muted)' }} />
                        <span style={{ wordBreak: 'break-word' }}>{item.handoverLocation}</span>
                      </div>
                    )}
                  </div>

                  {/* Scheduled & Vehicle/Driver Info Box */}
                  <div
                    style={{
                      padding: '10px 12px',
                      background: 'var(--card2)',
                      borderRadius: 'var(--r-sm, 6px)',
                      border: '1px solid var(--border)',
                      display: 'grid',
                      gridTemplateColumns: 'repeat(2, minmax(0, 1fr))',
                      gap: 8,
                      fontSize: 'var(--t-meta, 13px)',
                    }}
                  >
                    <div>
                      <div style={{ fontSize: '11px', color: 'var(--text3)', textTransform: 'uppercase', fontWeight: 600, letterSpacing: '0.04em' }}>
                        Scheduled Pickup
                      </div>
                      <div style={{ fontWeight: 600, color: 'var(--text)', marginTop: 2 }}>
                        {item.pickupAtAd}
                      </div>
                    </div>
                    <div>
                      <div style={{ fontSize: '11px', color: 'var(--text3)', textTransform: 'uppercase', fontWeight: 600, letterSpacing: '0.04em' }}>
                        Vehicle
                      </div>
                      <div style={{ fontWeight: 600, color: 'var(--text)', marginTop: 2 }}>
                        {[item.vehicle, item.numberPlate].filter(Boolean).join(' · ') || 'Unassigned'}
                      </div>
                    </div>
                    {item.driverContact && (
                      <div style={{ gridColumn: 'span 2', borderTop: '1px dashed var(--border)', paddingTop: 6, marginTop: 2 }}>
                        <div style={{ fontSize: '11px', color: 'var(--text3)', textTransform: 'uppercase', fontWeight: 600, letterSpacing: '0.04em' }}>
                          Driver Contact
                        </div>
                        <a
                          href={`tel:${item.driverContact}`}
                          style={{
                            display: 'inline-flex',
                            alignItems: 'center',
                            gap: 4,
                            color: 'var(--info)',
                            fontWeight: 600,
                            textDecoration: 'none',
                            marginTop: 2,
                            minHeight: 28,
                          }}
                        >
                          <Icon name="phone" size={12} /> {item.driverContact}
                        </a>
                      </div>
                    )}
                  </div>

                  {/* Delivery Fee if permitted */}
                  {money && item.quotedDeliveryFeeNpr !== null && (
                    <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', fontSize: 'var(--t-meta, 13px)' }}>
                      <span style={{ color: 'var(--text2)' }}>Delivery Fee:</span>
                      <span style={{ fontFamily: 'var(--font-mono)', fontWeight: 700, color: 'var(--text)' }}>
                        {formatMoney(rupees(item.quotedDeliveryFeeNpr))}
                      </span>
                    </div>
                  )}

                  {/* Action CTA */}
                  <Button
                    variant="primary"
                    icon="truck"
                    onClick={() => setHandoverTarget(item)}
                    aria-label={`Deliver and sign for booking ${item.bookingNo}`}
                    style={{
                      minHeight: 48,
                      width: '100%',
                      fontSize: 'var(--t-ui, 14px)',
                      fontWeight: 600,
                      justifyContent: 'center',
                    }}
                  >
                    Deliver & Sign
                  </Button>
                </article>
              ))}
            </div>
          ) : (
            <div style={cardStyle}>
              <div style={{ padding: '14px 18px 8px', display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
                <h3 style={{ margin: 0, fontSize: 'var(--t-h3, 15px)' }}>
                  Active Transport Plans ({filteredData.length})
                </h3>
              </div>
              <DataTableShell ariaLabel="Saved transport plans">
                <table style={{ borderCollapse: 'collapse', minWidth: 920, width: '100%' }}>
                  <thead>
                    <tr>
                      {[
                        'Booking',
                        'Client',
                        'Scheduled pickup (AD)',
                        'Location',
                        'Method',
                        'Vehicle',
                        'Driver contact',
                        ...(money ? ['Delivery fee'] : []),
                        'Action',
                      ].map((h) => (
                        <th
                          key={h}
                          scope="col"
                          style={{
                            textAlign: 'left',
                            padding: '12px 14px',
                            borderBottom: '1px solid var(--border)',
                            fontSize: 'var(--t-th, 12px)',
                            color: 'var(--text2)',
                            fontWeight: 600,
                          }}
                        >
                          {h}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {filteredData.map((item) => (
                      <tr key={item.id} style={{ transition: 'background-color var(--dur-fast) ease' }}>
                        <td style={{ padding: '12px 14px', borderBottom: '1px solid var(--border)', fontWeight: 600 }}>
                          <Link
                            to={`/rentals/${encodeURIComponent(item.bookingNo)}`}
                            style={{ color: 'var(--primary-text)', textDecoration: 'none' }}
                          >
                            {item.bookingNo}
                          </Link>
                        </td>
                        <td style={{ padding: '12px 14px', borderBottom: '1px solid var(--border)', fontWeight: 500 }}>
                          {item.clientName}
                        </td>
                        <td style={{ padding: '12px 14px', borderBottom: '1px solid var(--border)', color: 'var(--text2)', fontSize: 'var(--t-meta, 13px)' }}>
                          {item.pickupAtAd}
                        </td>
                        <td style={{ padding: '12px 14px', borderBottom: '1px solid var(--border)', maxWidth: 200, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                          {item.handoverLocation ?? '—'}
                        </td>
                        <td style={{ padding: '12px 14px', borderBottom: '1px solid var(--border)' }}>
                          <span
                            style={{
                              padding: '3px 8px',
                              borderRadius: 'var(--r-badge, 4px)',
                              background: item.deliveryType === 'Babin Delivery' ? 'var(--nav-active-bg)' : 'var(--surface-2)',
                              color: item.deliveryType === 'Babin Delivery' ? 'var(--primary-text)' : 'var(--text2)',
                              fontSize: '12px',
                              fontWeight: 600,
                            }}
                          >
                            {item.deliveryType}
                          </span>
                        </td>
                        <td style={{ padding: '12px 14px', borderBottom: '1px solid var(--border)' }}>
                          {[item.vehicle, item.numberPlate].filter(Boolean).join(' · ') || '—'}
                        </td>
                        <td style={{ padding: '12px 14px', borderBottom: '1px solid var(--border)', color: 'var(--text2)', fontSize: 'var(--t-meta, 13px)' }}>
                          {item.driverContact ?? '—'}
                        </td>
                        {money && (
                          <td style={{ padding: '12px 14px', borderBottom: '1px solid var(--border)', fontFamily: 'var(--font-mono)', fontWeight: 600 }}>
                            {item.quotedDeliveryFeeNpr === null ? '—' : formatMoney(rupees(item.quotedDeliveryFeeNpr))}
                          </td>
                        )}
                        <td style={{ padding: '10px 14px', borderBottom: '1px solid var(--border)', whiteSpace: 'nowrap' }}>
                          <Button
                            variant="primary"
                            icon="truck"
                            onClick={() => setHandoverTarget(item)}
                            aria-label={`Deliver and sign for booking ${item.bookingNo}`}
                            style={{ minHeight: 44, padding: '0 12px' }}
                          >
                            Deliver & Sign
                          </Button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </DataTableShell>
            </div>
          )
        )}

        {/* Handover & Proof of Delivery Modal */}
        {handoverTarget && (
          <DriverHandoverModal
            isOpen={true}
            onClose={() => setHandoverTarget(null)}
            bookingNo={handoverTarget.bookingNo}
            bookingId={handoverTarget.bookingId}
            clientName={handoverTarget.clientName}
            deliveryAddress={handoverTarget.handoverLocation}
            itemCount={1}
            onSuccess={() => {
              showSuccessToast(`Delivery handover confirmed for ${handoverTarget.bookingNo}`)
              setHandoverTarget(null)
              loadData()
            }}
          />
        )}
      </PageBody>
    </PageShell>
  )
}
