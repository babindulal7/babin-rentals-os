<file path="src/modules/inventory/components/SectionLocation.tsx">
import Icon from '../../../components/ui/Icon'
import { Field, SectionCard, inputStyle, fieldRow } from './EquipmentShared'
import { useEquipmentContext } from './AddEquipmentContext'
import { locationLabel } from '../../../lib/queries/addEquipment'
import { useWarehouses } from '../../../lib/queries/warehouses'

export function SectionLocation() {
  /*
   * The warehouse list is READ FROM THE DATABASE, and must be.
   * `product_units.warehouse_id` is NOT NULL and `createEquipment` resolves the
   * choice against `warehouses`, so a picker built from `data/warehouse.ts`'s
   * four seed names offered nothing that existed: every serialised save failed
   * after this form had already reported "Ready to Rent — all gates clear".
   *
   * The BIN list below stays seed, deliberately. `storage_zones` has no room,
   * rack, shelf or bin column, so there is nothing to read; the chosen bin is
   * stored as free text on the unit with `storage_zone_id` left null, which is
   * what `createEquipment` already documents.
   */
  const { rows: warehouses, loading: warehousesLoading } = useWarehouses()

  const {
    warehouseId,
    setWarehouseId,
    locationId,
    setLocationId,
    warehouseLocations,
    chosenLocation,
    freeSlots,
    overCapacity,
    stockCount,
    errors,
    sectionNumber,
  } = useEquipmentContext()

  return (
    <SectionCard
            id="sec-location"
            n={sectionNumber('sec-location')}
            title="Location"
            note="Warehouse › Zone › Rack › Shelf › Bin. The container comes from Section 3, never typed here."
          >
            <div style={fieldRow}>
              <Field label="Warehouse" required error={errors.location}>
                <select
                  value={warehouseId}
                  onChange={(e) => {
                    setWarehouseId(e.target.value)
                    setLocationId('')
                  }}
                  style={inputStyle(Boolean(errors.location))}
                >
                  <option value="">
                    {warehousesLoading
                      ? 'Loading warehouses…'
                      : warehouses.length === 0
                        ? 'No active warehouse exists'
                        : 'Select a warehouse'}
                  </option>
                  {warehouses.map((w) => (
                    <option key={w.id} value={w.id}>
                      {w.code ? `${w.name} (${w.code})` : w.name}
                    </option>
                  ))}
                </select>
              </Field>
              <Field
                label="Storage bin"
                required
                span={2}
                hint={
                  warehouseId
                    ? 'Bin labels are a seed list — storage_zones has no rack, shelf or bin column, so the choice is stored as text on the unit.'
                    : 'Choose a warehouse first.'
                }
              >
                <select
                  value={locationId}
                  onChange={(e) => {
                    setLocationId(e.target.value)
                  }}
                  disabled={!warehouseId}
                  style={{ ...inputStyle(Boolean(errors.location)), opacity: warehouseId ? 1 : 0.6 }}
                >
                  <option value="">{warehouseId ? 'Select a bin' : 'No warehouse selected'}</option>
                  {warehouseLocations.map((l) => (
                    <option key={l.id} value={l.id}>
                      {locationLabel(l)} — {l.capacity - l.used} of {l.capacity} free
                    </option>
                  ))}
                </select>
              </Field>
            </div>

            {chosenLocation && (
              <div
                style={{
                  display: 'flex',
                  alignItems: 'flex-start',
                  gap: 'var(--sp-sm)',
                  padding: '9px 11px',
                  borderRadius: 'var(--r-sm)',
                  border: `1px solid ${overCapacity ? 'var(--danger)' : 'var(--border)'}`,
                  background: 'var(--card2)',
                }}
              >
                <Icon
                  name={overCapacity ? 'alert_triangle' : 'check'}
                  size={14}
                  style={{ color: overCapacity ? 'var(--danger-text)' : 'var(--success-text)', flexShrink: 0, marginTop: 2 }}
                />
                <span style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', lineHeight: 1.45 }}>
                  {locationLabel(chosenLocation)} holds <span className="figure">{chosenLocation.used}</span> of{' '}
                  <span className="figure">{chosenLocation.capacity}</span> slots.{' '}
                  {overCapacity
                    ? `${stockCount} units will not fit in the ${freeSlots} free slots — split the stock or pick another bin.`
                    : `${freeSlots} free, enough for the ${stockCount} being added.`}
                </span>
              </div>
            )}
          </SectionCard>
  )
}
</file>

<file path="src/modules/inventory/components/SectionMaintenance.tsx">
import Icon from '../../../components/ui/Icon'
import { Button } from '../../../components/ui/Page'
import { Field, SectionCard, inputStyle, fieldRow, formatBytes } from './EquipmentShared'
import { useEquipmentContext } from './AddEquipmentContext'
import { useCanViewMoney } from '../../../lib/moneyVisibility'

export function SectionMaintenance() {
  /* §11 — documents are money-adjacent (invoice, warranty, insurance), so the
     money gate stands in until lib/rbac grows a document capability. */
  const money = useCanViewMoney()
  const {
    inspectionIntervalDays,
    setInspectionIntervalDays,
    maintenanceCycleRentals,
    setMaintenanceCycleRentals,
    serviceVendor,
    setServiceVendor,
    documents,
    setDocuments,
    docError,
    docInput,
    addDocuments,
    internalNotes,
    setInternalNotes,
    warehouseNotes,
    setWarehouseNotes,
    sectionNumber,
  } = useEquipmentContext()

  return (
    <SectionCard
            id="sec-maintenance"
            n={sectionNumber('sec-maintenance')}
            title="Maintenance & Documents"
            note="Due dates feed the Maintenance queue. Internal notes never print."
          >
            <div style={fieldRow}>
              <Field label="Inspection interval (days)">
                <input
                  type="number"
                  inputMode="numeric"
                  min={0}
                  value={inspectionIntervalDays}
                  onChange={(e) => setInspectionIntervalDays(e.target.value)}
                  placeholder="e.g. 30"
                  className="figure"
                  style={inputStyle()}
                />
              </Field>
              <Field label="Maintenance cycle (rentals)">
                <input
                  type="number"
                  inputMode="numeric"
                  min={0}
                  value={maintenanceCycleRentals}
                  onChange={(e) => setMaintenanceCycleRentals(e.target.value)}
                  placeholder="e.g. 20"
                  className="figure"
                  style={inputStyle()}
                />
              </Field>
              <Field label="Service vendor">
                <input value={serviceVendor} onChange={(e) => setServiceVendor(e.target.value)} placeholder="Who services this" style={inputStyle()} />
              </Field>
            </div>

            <span style={{ display: 'flex', alignItems: 'flex-start', gap: 5, fontSize: 'var(--t-th)', color: 'var(--muted)', lineHeight: 1.45 }}>
              <Icon name="info" size={12} style={{ flexShrink: 0, marginTop: 2 }} />
              Running hours and expected life are not offered: no meter reading exists for a record being created, and
              seeding one would be inventing a figure nobody supplied.
            </span>

            {/* §11 — documents are restricted. `lib/rbac` has no document capability
                yet, so the money-visible set stands in; see the report for the gap. */}
            {money ? (
              <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-sm)', paddingTop: 'var(--sp-md)', borderTop: '1px solid var(--border)' }}>
                <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 10, flexWrap: 'wrap' }}>
                  <strong style={{ fontSize: 'var(--t-meta)', color: 'var(--text)' }}>Documents — invoice, warranty, insurance, manual, certificates</strong>
                  <Button variant="secondary" icon="upload" onClick={() => docInput.current?.click()}>
                    Attach
                  </Button>
                </div>
                <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>PDF, JPG or PNG · 50 MB each.</span>
                <input
                  ref={docInput}
                  type="file"
                  aria-label="Attach maintenance documents"
                  multiple
                  accept=".pdf,.jpg,.jpeg,.png"
                  onChange={(e) => {
                    addDocuments(e.target.files)
                    e.target.value = ''
                  }}
                  style={{ display: 'none' }}
                />
                {docError && (
                  <span style={{ display: 'flex', alignItems: 'center', gap: 5, fontSize: 'var(--t-th)', color: 'var(--danger-text)' }}>
                    <Icon name="error" size={12} />
                    {docError}
                  </span>
                )}
                {documents.map((d) => (
                  <div
                    key={d.id}
                    style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '7px 10px', borderRadius: 7, background: 'var(--card2)', border: '1px solid var(--border)' }}
                  >
                    <Icon name="file" size={15} style={{ color: 'var(--text2)', flexShrink: 0 }} />
                    <span style={{ flex: 1, minWidth: 0, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', fontSize: 'var(--t-meta)' }}>
                      {d.file.name}
                    </span>
                    <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>{formatBytes(d.file.size)}</span>
                    <button
                      type="button"
                      onClick={() => {
                        URL.revokeObjectURL(d.url)
                        setDocuments((prev) => prev.filter((x) => x.id !== d.id))
                      }}
                      aria-label={`Remove ${d.file.name}`}
                      style={{ border: 'none', background: 'transparent', color: 'var(--muted)', cursor: 'pointer' }}
                    >
                      <Icon name="close" size={13} />
                    </button>
                  </div>
                ))}
              </div>
            ) : (
              <div style={{ paddingTop: 'var(--sp-md)', borderTop: '1px solid var(--border)', display: 'flex', alignItems: 'flex-start', gap: 'var(--sp-sm)' }}>
                <Icon name="info" size={14} style={{ color: 'var(--muted)', flexShrink: 0, marginTop: 2 }} />
                <span style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', lineHeight: 1.45 }}>
                  Documents — invoice, warranty and insurance — are not part of this role’s form. Attach them from an
                  Owner, Admin or Accounts session.
                </span>
              </div>
            )}

            <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)', paddingTop: 'var(--sp-md)', borderTop: '1px solid var(--border)' }}>
              <Field label="Warehouse notes" hint="Printed on packing lists.">
                <textarea
                  value={warehouseNotes}
                  onChange={(e) => setWarehouseNotes(e.target.value)}
                  rows={2}
                  placeholder="e.g. Check the sensor glass under the inspection light before packing."
                  style={{ ...inputStyle(), height: 'auto', padding: 10, resize: 'vertical' }}
                />
              </Field>
              <Field label="Internal notes" hint="Never printed, never shown to a client.">
                <textarea
                  value={internalNotes}
                  onChange={(e) => setInternalNotes(e.target.value)}
                  rows={2}
                  placeholder="Anything the floor should know that a client should not read."
                  style={{ ...inputStyle(), height: 'auto', padding: 10, resize: 'vertical' }}
                />
              </Field>
            </div>
          </SectionCard>
  )
}
</file>

<file path="src/modules/inventory/components/SectionPurchase.tsx">
import { Field, SectionCard, inputStyle, fieldRow, BsAbove } from './EquipmentShared'
import { useEquipmentContext } from './AddEquipmentContext'
import { Unavailable } from '../../../components/ui/Unavailable'
import { DEPRECIATION_UNAVAILABLE_REASON } from '../../../lib/queries/addEquipment'
import { formatMoney, parseMoney } from '../../../lib/money'
import type { Paisa } from '../../../lib/money'
import { DateField } from '../../../components/ui/DateField'

export function SectionPurchase() {
  const {
    purchaseIso,
    setPurchaseIso,
    supplier,
    setSupplier,
    assetOwner,
    setAssetOwner,
    purchasePrice,
    setPurchasePrice,
    replacementValue,
    setReplacementValue,
    replacementPaisa,
    warrantyMonths,
    setWarrantyMonths,
    insurancePolicy,
    setInsurancePolicy,
    insuranceExpiryIso,
    setInsuranceExpiryIso,
    errors,
    sectionNumber,
  } = useEquipmentContext()

  return (
    <SectionCard
              id="sec-purchase"
              n={sectionNumber('sec-purchase')}
              title="Purchase"
              note="Replacement value is what damage charges and insurance claims are computed from."
            >
              <div style={fieldRow}>
                <Field label="Purchase date">
                  <BsAbove iso={purchaseIso} />
                  <DateField ariaLabel="Purchase date" value={purchaseIso} onChange={setPurchaseIso} clearable style={inputStyle()} />
                </Field>
                <Field label="Supplier">
                  <input value={supplier} onChange={(e) => setSupplier(e.target.value)} placeholder="e.g. Camera Zone Nepal" style={inputStyle()} />
                </Field>
                <Field label="Asset owner">
                  <input value={assetOwner} onChange={(e) => setAssetOwner(e.target.value)} style={inputStyle()} />
                </Field>
              </div>

              <div style={fieldRow}>
                <Field
                  label="Purchase price (NPR)"
                  error={errors.purchasePrice}
                  hint={parseMoney(purchasePrice) ? formatMoney(parseMoney(purchasePrice) as Paisa) : undefined}
                >
                  <input
                    value={purchasePrice}
                    onChange={(e) => {
                      setPurchasePrice(e.target.value)
                    }}
                    placeholder="e.g. 4,65,000"
                    className="figure"
                    style={inputStyle(Boolean(errors.purchasePrice))}
                  />
                </Field>
                <Field
                  label="Replacement value (NPR)"
                  error={errors.replacementValue}
                  hint={replacementPaisa ? formatMoney(replacementPaisa) : 'Needed before the item can be rented.'}
                >
                  <input
                    value={replacementValue}
                    onChange={(e) => {
                      setReplacementValue(e.target.value)
                    }}
                    placeholder="e.g. 4,65,000"
                    className="figure"
                    style={inputStyle(Boolean(errors.replacementValue))}
                  />
                </Field>
                <Field label="Warranty (months)">
                  <input
                    type="number"
                    min={0}
                    value={warrantyMonths}
                    onChange={(e) => setWarrantyMonths(e.target.value)}
                    placeholder="e.g. 24"
                    className="figure"
                    style={inputStyle()}
                  />
                </Field>
              </div>

              <div style={fieldRow}>
                <Field label="Insurance policy">
                  <input value={insurancePolicy} onChange={(e) => setInsurancePolicy(e.target.value)} placeholder="Policy number" style={inputStyle()} />
                </Field>
                <Field label="Insurance expiry">
                  <BsAbove iso={insuranceExpiryIso} />
                  <DateField ariaLabel="Insurance expiry" value={insuranceExpiryIso} onChange={setInsuranceExpiryIso} clearable style={inputStyle()} />
                </Field>
                <Field label="Depreciation group">
                  <Unavailable reason={DEPRECIATION_UNAVAILABLE_REASON} style={{ width: '100%' }}>
                    <select disabled style={{ ...inputStyle(), opacity: 0.55, width: '100%' }}>
                      <option>{/* §16 */}Not defined yet</option>
                    </select>
                  </Unavailable>
                </Field>
              </div>
            </SectionCard>
  )
}
</file>

<file path="src/modules/inventory/components/SectionRelationships.tsx">
import Icon from '../../../components/ui/Icon'
import { Button } from '../../../components/ui/Page'
import { Field, SectionCard, inputStyle, fieldRow, Chip } from './EquipmentShared'
import { useEquipmentContext } from './AddEquipmentContext'
import { CONTAINER_MODELS, ATTACHABLE_MODELS, modelName, CONTAINER_CAPACITY_REASON } from '../../../lib/queries/addEquipment'

export function SectionRelationships() {
  const {
    category,
    brand,
    storedIn,
    setStoredIn,
    contains,
    setContains,
    containPick,
    setContainPick,
    compatible,
    setCompatible,
    compatiblePick,
    setCompatiblePick,
    requires,
    setRequires,
    requiresPick,
    setRequiresPick,
    suggestions,
    usedInBundles,
    addContained,
    errors,
    sectionNumber,
  } = useEquipmentContext()

  return (
    <SectionCard
            id="sec-relationships"
            n={sectionNumber('sec-relationships')}
            title="Relationships"
            note="Three classes, three cardinalities — containment is one, membership is many, compatibility is many-to-many."
          >
            {errors.relationships && (
              <span style={{ display: 'flex', alignItems: 'center', gap: 5, fontSize: 'var(--t-th)', color: 'var(--danger-text)' }}>
                <Icon name="error" size={12} />
                {errors.relationships}
              </span>
            )}

            {/* §6.1 — containment, physical, one parent. */}
            <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
              <strong style={{ fontSize: 'var(--t-meta)', color: 'var(--text)' }}>Containment — one container at a time</strong>
              <div style={fieldRow}>
                <Field label="Stored In" hint="Moving the container moves everything inside it.">
                  <select
                    value={storedIn}
                    onChange={(e) => {
                      setStoredIn(e.target.value)
                    }}
                    style={inputStyle(Boolean(errors.relationships))}
                  >
                    <option value="">None — direct shelf</option>
                    {CONTAINER_MODELS.map((m) => (
                      <option key={m.id} value={m.id}>
                        {m.name} ({m.sku})
                      </option>
                    ))}
                  </select>
                </Field>
                <Field label="Contains" hint="Existing inventory is attached, never duplicated.">
                  <div style={{ display: 'flex', gap: 6 }}>
                    <select value={containPick} onChange={(e) => setContainPick(e.target.value)} style={inputStyle()}>
                      <option value="">Select an item to attach</option>
                      {ATTACHABLE_MODELS.map((m) => (
                        <option key={m.id} value={m.id}>
                          {m.name}
                        </option>
                      ))}
                    </select>
                    <Button
                      variant="secondary"
                      onClick={() => {
                        addContained(containPick)
                        setContainPick('')
                      }}
                    >
                      Attach
                    </Button>
                  </div>
                </Field>
              </div>

              {contains.length > 0 && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
                  {contains.map((c) => (
                    <div
                      key={c.id}
                      style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '6px 10px', borderRadius: 7, background: 'var(--card2)', border: '1px solid var(--border)' }}
                    >
                      <Icon name="package" size={14} style={{ color: 'var(--link)', flexShrink: 0 }} />
                      <span style={{ flex: 1, minWidth: 0, fontSize: 'var(--t-meta)', color: 'var(--text)' }}>{modelName(c.modelId)}</span>
                      <label style={{ display: 'flex', alignItems: 'center', gap: 5, fontSize: 'var(--t-th)', color: 'var(--text2)' }}>
                        Qty
                        <input
                          type="number"
                          min={1}
                          value={c.quantity}
                          onChange={(e) =>
                            setContains((prev) => prev.map((x) => (x.id === c.id ? { ...x, quantity: Math.max(1, Number(e.target.value)) } : x)))
                          }
                          className="figure"
                          /* Law 15 — the `height: 28` override defeated inputStyle's
                             `minHeight: 44` touch floor on the one control in this row
                             that takes typing. Width stays 62: the floor is 44 and a
                             quantity is at most a few digits. */
                          style={{ ...inputStyle(), width: 62 }}
                        />
                      </label>
                      <button
                        type="button"
                        onClick={() => setContains((prev) => prev.filter((x) => x.id !== c.id))}
                        aria-label={`Detach ${modelName(c.modelId)}`}
                        style={{ border: 'none', background: 'transparent', color: 'var(--muted)', cursor: 'pointer' }}
                      >
                        <Icon name="close" size={13} />
                      </button>
                    </div>
                  ))}
                  <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>
                    {/* Detaching removes only the relationship — the child stays an independent asset (§6.1). */}Detaching removes only the relationship — the child stays an independent asset. </span>
                </div>
              )}

              {/* §7 — auto-suggested children from what comparable units contain. */}
              {suggestions.length > 0 && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
                  <span style={{ fontSize: 'var(--t-th)', color: 'var(--text2)' }}>
                    Suggested from what other {category || brand} units contain — click to attach:
                  </span>
                  <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6 }}>
                    {suggestions.map((s) => (
                      <button
                        key={s.id}
                        type="button"
                        onClick={() => addContained(s.id)}
                        style={{
                          display: 'inline-flex',
                          alignItems: 'center',
                          gap: 5,
                          padding: '4px 9px',
                          borderRadius: 'var(--r-badge)',
                          border: '1px dashed var(--border2)',
                          background: 'transparent',
                          color: 'var(--link)',
                          fontSize: 'var(--t-meta)',
                          fontFamily: 'inherit',
                          fontWeight: 600,
                          cursor: 'pointer',
                        }}
                      >
                        <Icon name="plus" size={11} />
                        {s.name}
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <span style={{ display: 'flex', alignItems: 'flex-start', gap: 5, fontSize: 'var(--t-th)', color: 'var(--muted)', lineHeight: 1.45 }}>
                <Icon name="info" size={12} style={{ flexShrink: 0, marginTop: 2 }} />
                {CONTAINER_CAPACITY_REASON}
              </span>
            </div>

            {/* §6.2 — kit membership, read-only. */}
            <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-sm)', paddingTop: 'var(--sp-md)', borderTop: '1px solid var(--border)' }}>
              <strong style={{ fontSize: 'var(--t-meta)', color: 'var(--text)' }}>Kit membership — read-only here</strong>
              {usedInBundles.length > 0 ? (
                <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6 }}>
                  {usedInBundles.map((b) => (
                    <Chip key={b} icon="queues">
                      {b}
                    </Chip>
                  ))}
                </div>
              ) : (
                <span style={{ fontSize: 'var(--t-meta)', color: 'var(--muted)' }}>
                  Not used in any bundle. Bundles are built in Inventory ▸ Bundles; this panel only shows where the item is
                  already used, so a retirement’s blast radius is visible.
                </span>
              )}
            </div>

            {/* §6.3 — compatibility, informational, many-to-many. */}
            <div style={{ display: 'flex', flexDirection: 'column', gap: 10, paddingTop: 'var(--sp-md)', borderTop: '1px solid var(--border)' }}>
              <strong style={{ fontSize: 'var(--t-meta)', color: 'var(--text)' }}>Compatibility — never affects availability or price</strong>
              <div style={fieldRow}>
                <Field label="Compatible with">
                  <div style={{ display: 'flex', gap: 6 }}>
                    <select value={compatiblePick} onChange={(e) => setCompatiblePick(e.target.value)} style={inputStyle()}>
                      <option value="">Select an item</option>
                      {ATTACHABLE_MODELS.map((m) => (
                        <option key={m.id} value={m.id}>
                          {m.name}
                        </option>
                      ))}
                    </select>
                    <Button
                      variant="secondary"
                      onClick={() => {
                        if (compatiblePick && !compatible.includes(compatiblePick)) setCompatible((prev) => [...prev, compatiblePick])
                        setCompatiblePick('')
                      }}
                    >
                      Add
                    </Button>
                  </div>
                </Field>
                <Field label="Requires" hint="Powers the missing-accessory warning at packing.">
                  <div style={{ display: 'flex', gap: 6 }}>
                    <select value={requiresPick} onChange={(e) => setRequiresPick(e.target.value)} style={inputStyle()}>
                      <option value="">Select an item</option>
                      {ATTACHABLE_MODELS.map((m) => (
                        <option key={m.id} value={m.id}>
                          {m.name}
                        </option>
                      ))}
                    </select>
                    <Button
                      variant="secondary"
                      onClick={() => {
                        if (requiresPick && !requires.includes(requiresPick)) setRequires((prev) => [...prev, requiresPick])
                        setRequiresPick('')
                      }}
                    >
                      Add
                    </Button>
                  </div>
                </Field>
              </div>

              {(compatible.length > 0 || requires.length > 0) && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-sm)' }}>
                  {compatible.length > 0 && (
                    <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6, alignItems: 'center' }}>
                      <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)', width: 74 }}>Compatible</span>
                      {compatible.map((id) => (
                        <Chip key={id} icon="external_link" onRemove={() => setCompatible((prev) => prev.filter((x) => x !== id))}>
                          {modelName(id)}
                        </Chip>
                      ))}
                    </div>
                  )}
                  {requires.length > 0 && (
                    <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6, alignItems: 'center' }}>
                      <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)', width: 74 }}>Requires</span>
                      {requires.map((id) => (
                        <Chip key={id} icon="plug" onRemove={() => setRequires((prev) => prev.filter((x) => x !== id))}>
                          {modelName(id)}
                        </Chip>
                      ))}
                    </div>
                  )}
                </div>
              )}
            </div>
          </SectionCard>
  )
}
</file>

<file path="src/modules/inventory/modals/CreatePurchaseRequestModal.tsx">
import { useState } from 'react'
import { Modal } from '../../../components/ui/Modal'
import { Button } from '../../../components/ui/Page'
import { rupees, formatMoney } from '../../../lib/money'
import type { Paisa } from '../../../lib/money'
import { getBusinessToday, toBs, formatBs } from '../../../lib/bs'
import { DomainEvents, EVENT_TYPES } from '../../../events/eventBus'
import { useAuth } from '../../../lib/auth'
import type { PRPriority, PurchaseRequest } from '../../../lib/queries/purchaseRequests'

export interface CreatePurchaseRequestModalProps {
  isOpen: boolean
  onClose: () => void
  onSuccess: (pr: PurchaseRequest) => void
}

export function CreatePurchaseRequestModal({
  isOpen,
  onClose,
  onSuccess,
}: CreatePurchaseRequestModalProps) {
  const { user } = useAuth()
  const [equipmentTitle, setEquipmentTitle] = useState('')
  const [category, setCategory] = useState('Camera Body')
  const [quantity, setQuantity] = useState<number>(1)
  const [unitCostRupees, setUnitCostRupees] = useState<number>(0)
  const [priority, setPriority] = useState<PRPriority>('Medium')
  const [turnaways, setTurnaways] = useState<number>(0)
  const [justification, setJustification] = useState('')
  const [submitting, setSubmitting] = useState(false)
  const [error, setError] = useState<string | null>(null)

  const totalCostRs = quantity * unitCostRupees

  const handleSubmit = async (e?: React.FormEvent) => {
    if (e) e.preventDefault()
    if (!equipmentTitle.trim()) {
      setError('Please provide an equipment model or title.')
      return
    }
    if (justification.trim().length < 5) {
      setError('Please document the business justification / utilization need for this purchase.')
      return
    }

    setSubmitting(true)
    setError(null)

    try {
      const prNo = `PR-2026-${Math.floor(1000 + Math.random() * 9000)}`
      const payload: PurchaseRequest = {
        id: prNo,
        prNo,
        fleetItemId: `EQ-${Math.floor(100 + Math.random() * 900)}`,
        fleetItemName: equipmentTitle.trim(),
        category,
        requestedQty: Math.max(1, quantity),
        reason: 'Demand exceeded',
        estimatedUnitCost: rupees(unitCostRupees),
        totalEstimatedCost: rupees(totalCostRs),
        totalSubRentPaid: 0 as Paisa,
        refusedCount: turnaways,
        subRentCount: 0,
        priorityScore: priority === 'High' ? 85 : priority === 'Medium' ? 60 : 40,
        priority,
        status: 'Draft',
        requestedBy: user?.name ?? 'Warehouse Lead',
        dateCreatedAD: getBusinessToday().toISOString().slice(0, 10),
        dateCreatedBS: (() => {
          const bs = toBs(getBusinessToday())
          return bs ? formatBs(bs) : ''
        })(),
        notes: justification.trim(),
        refusedBookings: [],
        subRentals: [],
      }

      await DomainEvents.emit(EVENT_TYPES.PURCHASE_REQUEST_UPDATED, payload)
      onSuccess(payload)
      onClose()
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Failed to create purchase request')
    } finally {
      setSubmitting(false)
    }
  }

  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      title="Create Equipment Purchase Request"
      subtitle="Draft a capital expenditure request backed by rental turnaways and sub-rental evidence."
      size="md"
      footer={
        <>
          <Button variant="secondary" onClick={onClose} disabled={submitting}>
            Cancel
          </Button>
          <Button variant="primary" onClick={() => handleSubmit()} disabled={submitting}>
            {submitting ? 'Submitting PR…' : 'Submit Purchase Request'}
          </Button>
        </>
      }
    >
