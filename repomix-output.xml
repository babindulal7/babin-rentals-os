            </div>
            <div style={{ ...cardStyle, padding: '14px 18px' }}>
              <div style={{ fontSize: '10px', color: 'var(--muted)', fontWeight: 700, textTransform: 'uppercase', letterSpacing: '0.06em' }}>REPAIRS TO DATE</div>
