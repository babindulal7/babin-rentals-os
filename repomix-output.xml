.report-row-btn {
  display: flex;
  align-items: center;
  gap: var(--sp-sm, 8px);
  flex: 1;
  min-width: 0;
  min-height: 44px;
  padding: 10px 14px;
  border: none;
  background: transparent;
  color: var(--text);
  font-family: inherit;
  font-size: var(--t-meta, 13px);
  text-align: left;
  cursor: pointer;
  text-decoration: none;
}

.report-tab-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
  padding: 3px 8px;
  border-radius: var(--r-badge, 6px);
  border: 1px solid var(--border);
  background: var(--card2);
  color: var(--link);
  font-size: var(--t-meta, 12px);
  font-weight: 600;
}

.report-untracked-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
  padding: 3px 8px;
  border-radius: var(--r-badge, 6px);
  border: 1px solid var(--border);
  background: var(--card2);
  color: var(--text2);
  font-size: var(--t-meta, 12px);
  font-weight: 500;
}

/* ── Report Table Shell & Presentation ──────────────────────────────────── */
.report-table-shell {
  border-radius: var(--r-card, 10px);
  border: 1px solid var(--border);
  background: var(--card);
  overflow: hidden;
}

.report-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: var(--t-meta, 13px);
}

.report-table th {
  padding: 10px 12px;
  font-size: var(--t-th, 11px);
  font-weight: 600;
  color: var(--text2);
  white-space: nowrap;
  background: var(--th-bg, var(--card2));
  border-bottom: 1px solid var(--border);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.report-table td {
  padding: 11px 12px;
  font-size: var(--t-meta, 13px);
  color: var(--text);
  border-bottom: 1px solid var(--border);
  min-height: 48px;
}

.report-table tr:hover {
  background: var(--hover-card, var(--card2));
}

.report-table-num {
  font-family: var(--font-id, 'Source Sans 3', sans-serif);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
  text-align: right;
  font-weight: 600;
}
