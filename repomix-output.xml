              borderRadius: 'var(--r-badge)',
              background: (selected === null && group === null && exception === null) ? 'var(--select-fg)' : 'var(--border)',
              color: (selected === null && group === null && exception === null) ? 'var(--select-bg)' : 'var(--text2)',
              fontSize: 'var(--t-meta)',
              fontWeight: 700,
