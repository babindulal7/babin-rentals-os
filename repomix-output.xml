                          <td style={td} />
                          <td className="figure" style={{ ...td, textAlign: 'right', fontWeight: 700 }}>
                            {formatMoney(pricing.computedRatePaisa)}
                          </td>
                          <td style={td} />
                          <td className="figure" style={{ ...td, color: 'var(--text2)' }}>
                            {availability.readyItems} / {availability.totalItems} ready
                          </td>
                          <td style={td} />
                        </tr>
                      </tfoot>
                    </table>
                  </DataTableShell>
