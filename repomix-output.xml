<file path="src/modules/today/ShiftHandoverPanel.tsx">
/**
 * Shift Handover Panel — collapsible section for the Today dashboard.
 *
 * Ported from the standalone's shifthandover screen. Shows a 5-item checklist,
 * a "Complete Handover" action, and an expandable log of past handovers with KPIs.
 */
import { useState, useMemo, useCallback, useEffect } from 'react'
import { Card, KpiStrip } from '../../components/ui/Page'
import type { Kpi } from '../../components/ui/Page'
import { Button } from '../../components/ui/Button'
import Icon from '../../components/ui/Icon'
import { Badge } from '../../components/ui/Badge'
import { useToast } from '../../components/ui/Toast'
import { useViewport } from '../../lib/device'
import { useAuth } from '../../lib/auth'
import { IS_MOCK } from '../../lib/supabase'
import {
  SHIFT_CHECKLIST,
  getHandoverRecords,
  completeHandover,
  getHandoverStats,
  type HandoverRecord,
} from '../../lib/queries/shiftHandover'
import {
  listInternalNotes,
  addInternalNote,
  toggleResolveNote,
  type InternalNote,
} from '../../lib/queries/internalNotes'

// ── Styles ───────────────────────────────────────────────────────────

const sectionStyle: React.CSSProperties = {
  display: 'flex',
  flexDirection: 'column',
  gap: 'var(--sp-md)',
  marginTop: 'var(--sp-lg)',
}

const headerBarStyle: React.CSSProperties = {
  cursor: 'pointer',
  padding: '12px 16px',
  borderRadius: 'var(--radius)',
  background: 'var(--surface)',
  border: '1px solid var(--border)',
}

const checklistStyle: React.CSSProperties = {
  display: 'flex',
  flexDirection: 'column',
  gap: '8px',
  padding: '16px',
}

const checkItemStyle: React.CSSProperties = {
  display: 'flex',
  alignItems: 'center',
  gap: '12px',
  cursor: 'pointer',
  padding: '10px 12px',
  borderRadius: '10px',
  border: '1px solid var(--border)',
  transition: 'background 0.15s',
  minHeight: 'var(--tap, 44px)',
}

const logRowStyle: React.CSSProperties = {
  padding: '12px 16px',
  borderBottom: '1px solid var(--border)',
  cursor: 'pointer',
}

const logRowHeaderStyle: React.CSSProperties = {
  display: 'flex',
  alignItems: 'center',
  justifyContent: 'space-between',
  gap: '8px',
}

const logRowMetaStyle: React.CSSProperties = {
  display: 'flex',
  gap: '16px',
  flexWrap: 'wrap',
  fontSize: 'var(--t-meta)',
  color: 'var(--text2)',
}

const noteBoxStyle: React.CSSProperties = {
  marginTop: '8px',
  padding: '10px 12px',
  borderRadius: '8px',
  background: 'var(--surface)',
  fontSize: 'var(--t-meta)',
  color: 'var(--text2)',
  lineHeight: 1.5,
}

// ── Component ────────────────────────────────────────────────────────

export default function ShiftHandoverPanel() {
  if (IS_MOCK) return <ShiftHandoverPreview />
  return (
    <Card><section role="status" aria-label="Staff shift handover" style={{ padding: 'var(--sp-md)' }}>
      <h2>Staff shift handover unavailable</h2>
      <p>Shared staff shift records are not available yet. Existing entries on this device have been kept.</p>
    </section></Card>
  )
}

function ShiftHandoverPreview() {
  const { showSuccessToast } = useToast()
  const viewport = useViewport()
  const isPhone = viewport === 'phone'
  const { user } = useAuth()

  const [expanded, setExpanded] = useState(false)
  const [logExpanded, setLogExpanded] = useState(false)
  const [checks, setChecks] = useState<Record<string, boolean>>({})
  const [records, setRecords] = useState<HandoverRecord[]>(getHandoverRecords)
  const [openLogId, setOpenLogId] = useState<number | null>(null)

  const [noteInput, setNoteInput] = useState('')
  const [internalNotes, setInternalNotes] = useState<InternalNote[]>(() => listInternalNotes())

  useEffect(() => {
    const handleUpdate = () => {
      setInternalNotes(listInternalNotes())
    }
    window.addEventListener('babin:notes-updated', handleUpdate)
    return () => window.removeEventListener('babin:notes-updated', handleUpdate)
  }, [])

  const shiftNotes = useMemo(() => {
    return internalNotes.filter((n) => n.category === 'Shift Handover' || n.category === 'Gear Alert')
  }, [internalNotes])

  const openShiftNotes = useMemo(() => {
    return shiftNotes.filter((n) => n.status !== 'resolved')
  }, [shiftNotes])

  const handleAddNote = useCallback(() => {
    const trimmed = noteInput.trim()
    if (!trimmed) return
    addInternalNote({
      author: user?.name || 'Shift Crew',
      authorRole: user?.role || 'Operations Staff',
      text: trimmed,
      category: 'Shift Handover',
      priority: 'high',
    })
    setNoteInput('')
    setInternalNotes(listInternalNotes())
    showSuccessToast('Shift note logged')
  }, [noteInput, user, showSuccessToast])

  const todayRecord = records.find((r) => r.status === 'Pending')
  const handoverDone = !todayRecord

  const allChecked = SHIFT_CHECKLIST.every((item) => handoverDone || checks[item.key])

  const toggleCheck = useCallback((key: string) => {
    if (handoverDone) return
    setChecks((prev) => ({ ...prev, [key]: !prev[key] }))
  }, [handoverDone])

  const handleCompleteHandover = useCallback(() => {
    if (!allChecked || handoverDone || !todayRecord) return
    const updated = completeHandover(
      todayRecord.id,
      'All pickups staged, drawer counted, no discrepancies.',
    )
    setRecords(updated)
    setChecks({})
    const minute = Math.floor(Math.random() * 10)
    showSuccessToast(`Shift handover recorded · ${todayRecord.from} → ${todayRecord.to} · 14:0${minute}`)
  }, [allChecked, handoverDone, todayRecord, showSuccessToast])

  const handleRecountCash = useCallback(() => {
    showSuccessToast('Cash count opened — count the drawer, then enter the amount')
  }, [showSuccessToast])

  const stats = useMemo(() => getHandoverStats(records), [records])

  const kpis: Kpi[] = useMemo(() => [
    { label: 'Handovers (7D)', value: String(stats.handovers7d), icon: 'checklist', accent: 'primary' },
    { label: 'On-Time Rate', value: stats.onTimeRate, icon: 'check', accent: 'success' },
    { label: 'Cash Variance Flags', value: String(stats.cashFlags), icon: 'alert_triangle', accent: 'warn' },
    { label: 'Checklist Misses', value: String(stats.checklistMisses), icon: 'alert_triangle', accent: 'warn' },
  ], [stats])

  const checkedCount = SHIFT_CHECKLIST.filter((item) => handoverDone || checks[item.key]).length

  return (
    <div style={sectionStyle}>
      {/* ── Section header ─────────────────────────────────────────── */}
      <div
        className="dashboard-shift-handover__toggle"
        style={{ ...headerBarStyle, display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: 10 }}
        onClick={() => setExpanded((prev) => !prev)}
        role="button"
        tabIndex={0}
        aria-expanded={expanded}
        aria-label="Shift Handover"
        onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setExpanded((p) => !p) } }}
      >
        <div className="dashboard-shift-handover__label" style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
          <Icon name={expanded ? 'chevron_down' : 'chevron_right'} size={16} />
          <span style={{ fontWeight: 600, fontSize: 'var(--t-body)' }}>Shift Handover</span>
          {openShiftNotes.length > 0 && (
            <span
              style={{
                fontSize: '12px',
                padding: '2px 8px',
                borderRadius: '10px',
                background: 'var(--select-bg)',
                color: 'var(--select-fg)',
                fontWeight: 600,
              }}
            >
              <span className="font-mono tabular-nums">{openShiftNotes.length}</span> open {openShiftNotes.length === 1 ? 'note' : 'notes'}
            </span>
          )}
        </div>
        <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
          <Badge
            className="dashboard-shift-handover__status"
            tone={handoverDone ? 'in' : 'warning'}
            label={handoverDone ? 'Handover complete' : 'Overlap window open · 14:00–15:00'}
          />
        </div>
      </div>

      {/* ── Expanded content ───────────────────────────────────────── */}
      {expanded && (
        <Card>
          {/* Quick Handover Note Logger */}
          <div style={{ padding: '16px 16px 12px', borderBottom: '1px solid var(--border)' }}>
            <div style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text2)', marginBottom: '8px', textTransform: 'uppercase', letterSpacing: '0.04em' }}>
              Log Shift Handover Note
            </div>
            <form
              onSubmit={(e) => {
                e.preventDefault()
                handleAddNote()
              }}
              style={{ display: 'flex', gap: 8, flexWrap: isPhone ? 'wrap' : 'nowrap' }}
            >
              <input
                type="text"
                value={noteInput}
                onChange={(e) => setNoteInput(e.target.value)}
                placeholder="Write a handover note for the next shift… (e.g. FX3 #2 battery charging, Komodo at 7 AM)"
                style={{
                  flex: 1,
                  minWidth: isPhone ? '100%' : 260,
                  minHeight: 'var(--tap, 44px)',
                  padding: '0 12px',
                  borderRadius: 'var(--r-btn, 8px)',
                  border: '1px solid var(--border)',
                  background: 'var(--card2)',
                  color: 'var(--text)',
                  fontSize: 'var(--t-meta, 13px)',
                }}
              />
              <button
                type="submit"
                disabled={!noteInput.trim()}
                className="ui-button ui-button--sm ui-button--primary press tap"
                style={{
                  minHeight: 'var(--tap, 44px)',
                  padding: '0 14px',
                  whiteSpace: 'nowrap',
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: 6,
                }}
              >
                <Icon name="plus" size={14} /> Log Shift Note
              </button>
            </form>

            {/* List open shift notes */}
            {openShiftNotes.length > 0 && (
              <div style={{ display: 'flex', flexDirection: 'column', gap: 6, marginTop: 12 }}>
                {openShiftNotes.map((note) => (
                  <div
                    key={note.id}
                    style={{
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'space-between',
                      gap: 12,
                      padding: '8px 12px',
                      borderRadius: 'var(--r-xs, 6px)',
                      background: 'var(--surface)',
                      border: '1px solid var(--border)',
                      fontSize: 'var(--t-meta, 13px)',
                    }}
                  >
                    <div style={{ display: 'flex', alignItems: 'center', gap: 8, minWidth: 0, overflow: 'hidden' }}>
                      <span
                        style={{
                          width: 8,
                          height: 8,
                          borderRadius: '50%',
                          background: note.priority === 'urgent' ? 'var(--danger-text)' : 'var(--warn)',
                          flexShrink: 0,
                        }}
                      />
                      <span style={{ color: 'var(--text)', fontWeight: 500, overflow: 'hidden', textOverflow: 'ellipsis' }}>
                        {note.text}
                      </span>
                      <span style={{ color: 'var(--muted)', fontSize: '11px', whiteSpace: 'nowrap', flexShrink: 0 }}>
                        — {note.author} · {note.at}
                      </span>
                    </div>
                    <button
                      type="button"
                      className="ui-button ui-button--sm ui-button--ghost press tap"
                      onClick={(e) => {
                        e.stopPropagation()
                        toggleResolveNote(note.id, user?.name)
                        setInternalNotes(listInternalNotes())
                        showSuccessToast('Note marked resolved')
                      }}
                      title="Mark resolved"
                      style={{
                        minHeight: 32,
                        padding: '0 10px',
                        fontSize: '12px',
                        flexShrink: 0,
                        display: 'inline-flex',
                        alignItems: 'center',
                        gap: 4,
                      }}
                    >
                      <Icon name="check" size={13} style={{ color: 'var(--success-text)' }} /> Resolve
                    </button>
                  </div>
                ))}
              </div>
            )}
          </div>

          {/* Checklist */}
          <div style={checklistStyle}>
            <div style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text2)', marginBottom: '4px', textTransform: 'uppercase', letterSpacing: '0.04em' }}>
              Handover Checklist
            </div>

            {SHIFT_CHECKLIST.map((item) => {
              const isChecked = handoverDone || !!checks[item.key]
              return (
                <div
                  key={item.key}
                  style={{
                    ...checkItemStyle,
                    background: isChecked ? 'color-mix(in srgb, var(--success) 8%, transparent)' : 'transparent',
                  }}
                  onClick={() => toggleCheck(item.key)}
                  role="checkbox"
                  aria-checked={isChecked}
                  tabIndex={0}
                  onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleCheck(item.key) } }}
                >
                  {/* Checkbox */}
                  <div
                    style={{
                      width: 22,
                      height: 22,
                      borderRadius: 'var(--r-xs, 6px)',
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      fontSize: 13,
                      flexShrink: 0,
                      background: isChecked ? 'color-mix(in srgb, var(--success) 16%, var(--surface))' : 'var(--surface)',
                      border: isChecked ? '1.5px solid color-mix(in srgb, var(--success) 60%, transparent)' : '1.5px solid var(--border)',
                      color: 'var(--success-text)',
                      transition: 'all 0.15s ease',
                    }}
                  >
                    {isChecked ? <Icon name="check" size={14} style={{ color: 'var(--success-text)' }} /> : null}
                  </div>

                  {/* Label + hint */}
                  <div style={{ flex: 1, minWidth: 0 }}>
                    <div style={{ fontWeight: 500, fontSize: 'var(--t-body)', color: 'var(--text)' }}>
                      {item.label}
                    </div>
                    <div style={{ fontSize: 'var(--t-meta)', color: 'var(--muted)', marginTop: '2px' }}>
                      {item.hint}
                    </div>
                  </div>
                </div>
              )
            })}

            {/* Action buttons */}
            <div style={{ display: 'flex', gap: '8px', marginTop: '4px', flexDirection: isPhone ? 'column' : 'row' }}>
              <Button
                variant={handoverDone ? undefined : allChecked ? 'primary' : undefined}
                disabled={handoverDone || !allChecked}
                onClick={handleCompleteHandover}
                className="tap"
                style={{
                  flex: 1,
                  minHeight: 'var(--tap, 44px)',
                  background: handoverDone
                    ? 'var(--surface)'
                    : allChecked
                      ? 'var(--success)'
                      : 'var(--surface)',
                  border: handoverDone || !allChecked ? '1px solid var(--border)' : 'none',
                  color: handoverDone
                    ? 'var(--success-text)'
                    : allChecked
                      ? 'var(--on-success)'
                      : 'var(--muted)',
                  fontWeight: 700,
                  display: 'inline-flex',
                  alignItems: 'center',
                  justifyContent: 'center',
                  gap: 6,
                }}
              >
                {handoverDone ? (
                  <>
                    <Icon name="check" size={16} /> Handover Complete
                  </>
                ) : (
                  <>
                    Complete Handover (<span className="font-mono tabular-nums">{checkedCount}</span> / <span className="font-mono tabular-nums">{SHIFT_CHECKLIST.length}</span>)
                  </>
                )}
              </Button>

              <Button
                onClick={handleRecountCash}
                className="tap"
                style={{ minHeight: 'var(--tap, 44px)' }}
              >
                Recount Cash
              </Button>
            </div>
          </div>
        </Card>
      )}

      {/* ── Handover log ───────────────────────────────────────────── */}
      {expanded && (
        <Card>
          <div
            style={{
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
              padding: '12px 16px',
              cursor: 'pointer',
              borderBottom: logExpanded ? '1px solid var(--border)' : 'none',
            }}
            onClick={() => setLogExpanded((p) => !p)}
            role="button"
            tabIndex={0}
            onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setLogExpanded((p) => !p) } }}
          >
            <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
              <Icon name={logExpanded ? 'chevron_down' : 'chevron_right'} size={14} />
              <span style={{ fontWeight: 600, fontSize: 'var(--t-body)' }}>
                Handover Log · <span className="font-mono tabular-nums">{records.length}</span> records
              </span>
            </div>
          </div>

          {logExpanded && (
            <>
              {/* KPI strip */}
              <div style={{ padding: '12px 16px 0' }}>
                <KpiStrip items={kpis} columns={isPhone ? 2 : 4} />
              </div>

              {/* Log rows */}
              {records.map((record) => {
                const isOpen = openLogId === record.id
                return (
                  <div key={record.id} style={logRowStyle}>
                    <div
                      style={logRowHeaderStyle}
                      onClick={() => setOpenLogId(isOpen ? null : record.id)}
                      role="button"
                      tabIndex={0}
                      onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setOpenLogId(isOpen ? null : record.id) } }}
                    >
                      <div style={{ display: 'flex', alignItems: 'center', gap: '8px', minWidth: 0 }}>
                        <Icon name={isOpen ? 'chevron_down' : 'chevron_right'} size={12} />
                        <span style={{ fontWeight: 500, whiteSpace: 'nowrap' }}>{record.date}</span>
                      </div>
                      <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
                        <Badge
                          tone={record.status === 'Complete' ? 'in' : 'warning'}
                          label={record.status}
                        />
                      </div>
                    </div>

                    <div style={{ ...logRowMetaStyle, marginTop: '6px' }}>
                      <span>{record.from} → {record.to}</span>
                      <span className="font-mono tabular-nums">{record.cashDisplay}</span>
                      <span>Checks: <span className="font-mono tabular-nums">{record.checksCompleted}</span></span>
                    </div>

                    {isOpen && (
                      <div style={noteBoxStyle}>
                        {record.notes}
                      </div>
                    )}
                  </div>
                )
              })}
            </>
          )}
        </Card>
      )}
    </div>
  )
}
</file>

<file path="src/modules/settings/Settings.tsx">
import { useCallback, useMemo, useState } from 'react'
import { Link, useNavigate, useSearchParams } from 'react-router-dom'
import './settings.css'
import Icon from '../../components/ui/Icon'
import type { IconName } from '../../components/ui/Icon'
import { Card, PageHeader, Button, FooterNote, SummaryRows } from '../../components/ui/Page'
import { PageShell } from '../../components/ui/PageShell'
import { PageActions } from '../../components/ui/PageActions'
import { EmptyState, ErrorBanner, LoadingSkeleton } from '../../components/ui/StateViews'
import { toBs, formatBs, formatAd, getBusinessToday } from '../../lib/bs'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import { useViewport } from '../../lib/device'
import { useCompactHeader } from '../../lib/headerRoom'
import { useEditMode } from '../../lib/edit/useEditMode'
import type { FieldSpec } from '../../lib/edit/useEditMode'
import {
  SETTING_SPECS,
  SETTINGS_DEFAULTS,
  validateSetting,
  resetSettings,
  languageCodeOf,
} from '../../lib/settingsStore'
import type { SettingKey, SettingValue, SettingsRecord } from '../../lib/settingsStore'
import { saveSettings, resetSharedSettings } from '../../lib/settingsSync'
import { applyLanguage } from '../../lib/i18n'
import { canManageSettings } from '../../lib/rbac'
import { useAuth } from '../../lib/auth'
import { useTheme } from '../../lib/theme'
import {
  TABS,
  LEGACY_TAB,
  DEFAULT_TAB,
  TAB_SHORT_LABEL,
  TAB_SUMMARY,
  isTabKey,
  BRANCHES,
  BRANCH,
  SYSTEM_SUMMARY,
  SEED_ERRORS,
} from '../../lib/queries/settings'
import type { Branch, TabKey } from '../../lib/queries/settings'
import { useSettingsLoad } from './useSettingsLoad'
import {
  DestControl,
  EditCtx,
  GoTab,
  SectionCards,
  VisibleTabs,
  controlStyle,
  downloadCsv,
  fieldValue,
} from './sections/shared'
import {
  FIELD_SECTIONS,
  FINANCIAL_SECTIONS,
  ORGANISATION_SECTIONS,
  BranchesPane,
  BranchesRail,
  FinancialPane,
  UsersPane,
  branchCsvRows,
} from './sections'

/*
 * Operating day in Kathmandu (BS + AD).
 */
const TODAY = getBusinessToday()

const TAB_CONFIG: Record<TabKey, { icon: IconName; subtitle: string }> = {
  business: {
    icon: 'briefcase',
    subtitle: 'Identity, VAT & financial policies',
  },
  people: {
    icon: 'users',
    subtitle: 'Staff directory & 9-role matrix',
  },
  branches: {
    icon: 'box',
    subtitle: 'Branches, warehouses & fleet',
  },
  system: {
    icon: 'settings',
    subtitle: 'Preferences, security & audit',
  },
}

export default function Settings() {
  const money = useCanViewMoney()
  const viewport = useViewport()
  const phone = viewport === 'phone'
  const desktop = viewport === 'desktop'

  const [params, setParams] = useSearchParams()
  const navigate = useNavigate()
  const [addOpen, setAddOpen] = useState(false)
  const [branches, setBranches] = useState<Branch[]>(BRANCHES)

  const { user } = useAuth()
  const { theme, glass, choose } = useTheme()
  const mayEdit = canManageSettings(user?.role ?? 'Client')
  const [leaveError, setLeaveError] = useState<string | null>(null)

  const { load, reload, patch } = useSettingsLoad()
  const settings: SettingsRecord = load.status === 'ready' ? load.settings : SETTINGS_DEFAULTS

  const onSaveSetting = useCallback(
    async (p: Record<string, unknown>) => {
      await saveSettings(p as Partial<SettingsRecord>)
      patch(p as Partial<SettingsRecord>)
      if ('language' in p) {
        await applyLanguage(languageCodeOf(p.language as SettingValue))
      }
    },
    [patch],
  )

  const settingFields: FieldSpec[] = useMemo(
    () =>
      (Object.keys(SETTING_SPECS) as SettingKey[]).map((k) => ({
        key: k,
        validate: (v) => validateSetting(k, v as SettingValue),
      })),
    [],
  )

  const edit = useEditMode({ record: settings, fields: settingFields, onSave: onSaveSetting })

  const [searchQuery, setSearchQuery] = useState('')

  /* Law 6 — money-only tab is removed from the strip, not disabled. */
  const tabs = useMemo(() => {
    const base = TABS.filter((t) => money || !t.money)
    if (!searchQuery.trim()) return base
    const q = searchQuery.toLowerCase().trim()
    return base.filter((t) => {
      const conf = TAB_CONFIG[t.key]
      return (
        t.label.toLowerCase().includes(q) ||
        (conf && conf.subtitle.toLowerCase().includes(q)) ||
        TAB_SUMMARY[t.key]?.toLowerCase().includes(q)
      )
    })
  }, [money, searchQuery])

  const raw = params.get('tab')
  const requested: TabKey = isTabKey(raw) ? raw : (raw !== null && LEGACY_TAB[raw]) || DEFAULT_TAB
  const active: TabKey = tabs.some((t) => t.key === requested) ? requested : DEFAULT_TAB
  const onPhoneList = phone && (raw === null || !tabs.some((t) => t.key === raw))

  const go = (tab: TabKey) => {
    const next = new URLSearchParams(params)
    if (tab === DEFAULT_TAB && !phone) next.delete('tab')
    else next.set('tab', tab)
    setParams(next)
    window.scrollTo({ top: 0 })
  }

  const toList = () => {
    const next = new URLSearchParams(params)
    next.delete('tab')
    setParams(next)
    window.scrollTo({ top: 0 })
  }

  const bs = toBs(TODAY)
  const asOf = `${bs ? formatBs(bs) : 'BS date unavailable'} · ${formatAd(TODAY)}`

  const initials = useMemo(() => {
    const name = user?.name?.trim() || 'Babin Shrestha'
    const parts = name.split(/\s+/).filter(Boolean)
    if (parts.length >= 2) {
      const p0 = parts[0] || 'B'
      const p1 = parts[parts.length - 1] || 'S'
      return `${p0[0] || 'B'}${p1[0] || 'S'}`.toUpperCase()
    }
    return (name.slice(0, 2) || 'BR').toUpperCase()
  }, [user?.name])

  const exportConfig = () => {
    const rows: string[][] = [['Section', 'Setting', 'Value']]
    const walk = (tabLabel: string, sections: readonly (typeof FINANCIAL_SECTIONS)[number][]) => {
      for (const s of sections) {
        for (const f of s.fields) {
          rows.push([`${tabLabel} · ${s.title}`, f.label, fieldValue(f, settings)])
        }
      }
    }
    for (const t of tabs) {
      const sections = FIELD_SECTIONS[t.key]
      if (sections) walk(t.label, sections)
    }
    if (money) walk('Business', FINANCIAL_SECTIONS)
    downloadCsv('babin-settings.csv', rows)
  }

  const exportBranches = () => downloadCsv('babin-branches.csv', branchCsvRows(branches, money))

  const finishEditing = () => {
    const outcome = edit.stopEditing()
    setLeaveError(
      outcome.ok
        ? null
        : `Unsaved: ${outcome.unsaved.join(', ')}. Save or cancel each before leaving edit mode.`,
    )
  }
  const discardEdits = () => {
    edit.cancelAll()
    setLeaveError(null)
  }
  const resetToDefaults = () => {
    void (async () => {
      resetSettings()
      try {
        await resetSharedSettings()
        setLeaveError(null)
      } catch (e) {
        setLeaveError(e instanceof Error ? e.message : 'Reset was refused.')
      }
      reload()
      edit.cancelAll()
    })()
  }
  const startEditing = () => { setLeaveError(null); edit.startEditing() }

  /* RULING 2026-10-15: below desktop only the one primary verb stays beside the title;
     Export, the audit log and the edit-mode extras move into More (BLOCKER-02 — the
     title measured 0px wide at both 375px and 768px, the audit link 34px tall). A phone
     also shortens the verb. Revert = drop the `compactHeader` branch below.
     RULING 2026-10-15 (zoom audit): decided by the header's own width (sidebar open at
     1280px left the title 55px). */
  const compactHeader = useCompactHeader()
  const compactHeaderActions =
    active === 'branches' && !onPhoneList ? (
      <PageActions
        primary={<Button icon="plus" variant="primary" aria-label="Add Branch" onClick={() => setAddOpen(true)}>{phone ? 'Add' : 'Add Branch'}</Button>}
        overflow={[{ label: 'Export branches', icon: 'download', onClick: exportBranches }]}
      />
    ) : (
      <PageActions
        primary={mayEdit && !onPhoneList ? (
          edit.editing
            ? <Button icon="check" variant="primary" onClick={finishEditing}>Done</Button>
            : <Button icon="tool" aria-label="Edit settings" onClick={startEditing}>{phone ? 'Edit' : 'Edit settings'}</Button>
        ) : undefined}
        overflow={[
          ...(mayEdit && !onPhoneList && edit.editing ? [
            { label: 'Discard changes', icon: 'close' as const, onClick: discardEdits },
            { label: 'Reset to defaults', icon: 'refresh' as const, onClick: resetToDefaults },
          ] : []),
          { label: 'Export config', icon: 'download', onClick: exportConfig },
          { label: 'View audit log', icon: 'checklist', onClick: () => navigate('/admin/audit') },
        ]}
      />
    )

  const headerActions =
    load.status !== 'ready' ? null : compactHeader ? compactHeaderActions : active === 'branches' && !onPhoneList ? (
      <>
        <Button icon="download" onClick={exportBranches}>
          Export
        </Button>
        <Button icon="plus" variant="primary" onClick={() => setAddOpen(true)}>
          Add Branch
        </Button>
      </>
    ) : (
      <>
        {mayEdit &&
          !onPhoneList &&
          (edit.editing ? (
            <>
              <Button icon="check" variant="primary" onClick={finishEditing}>
                Done
              </Button>
              <Button icon="close" variant="ghost" onClick={discardEdits}>
                Discard
              </Button>
              <Button icon="refresh" variant="ghost" onClick={resetToDefaults}>
                Reset to defaults
              </Button>
            </>
          ) : (
            <Button icon="tool" onClick={startEditing}>
              Edit settings
            </Button>
          ))}
        <Button icon="download" onClick={exportConfig}>
          Export config
        </Button>
        <Link to="/admin/audit" className="tap" style={{ ...controlStyle, minHeight: 44 }}>
          <Icon name="checklist" size={14} />
          View audit log
        </Link>
      </>
    )

  const activeTab = tabs.find((t) => t.key === active)

  /* ── the panel ───────────────────────────────────────────────────────── */

  const panel = (() => {
    if (active === 'branches') {
      return (
        <BranchesPane money={money} rows={branches} setRows={setBranches} addOpen={addOpen} setAddOpen={setAddOpen} />
      )
    }
    if (active === 'people') {
      return (
        <>
          <UsersPane />
          {FIELD_SECTIONS.people ? <SectionCards sections={FIELD_SECTIONS.people} /> : null}
        </>
      )
    }
    if (active === 'business') {
      return (
        <>
          <SectionCards sections={ORGANISATION_SECTIONS} />
          {money ? <FinancialPane /> : null}
        </>
      )
    }
    const sections = FIELD_SECTIONS[active]
    return sections ? <SectionCards sections={sections} /> : null
  })()

  const rail =
    active === 'branches' ? (
      <BranchesRail money={money} branches={branches} onAdd={() => setAddOpen(true)} onExport={exportBranches} />
    ) : null

  /* ── body, by state then by width ────────────────────────────────────── */

  const body = (() => {
    if (load.status === 'loading') {
      return (
        <LoadingSkeleton
          type="card"
          label="Loading settings — the stored values, not the defaults. Nothing on this page is shown until they arrive."
        />
      )
    }

    if (load.status === 'error') {
      return (
        <ErrorBanner
          title="Settings could not be read."
          message={
            <>
              {load.message} Until they load, this page would show the built-in defaults rather than your saved values — and a
              stale VAT rate is a wrong invoice, so nothing is rendered instead.
            </>
          }
          onRetry={reload}
        />
      )
    }

    /* Phase 6 — no RESULTS, not "nothing yet": every section exists, the search
       matched none of them. Before this the section list emptied while the
       pane went on showing the default section's fields, which read as if
       those fields were the match. */
    if (tabs.length === 0) {
      return (
        <EmptyState
          kind="no-results"
          title="No settings match this search"
          description={`No section (${TABS.filter((t) => money || !t.money).map((t) => t.label).join(', ')}) mentions “${searchQuery.trim()}”.`}
          actionLabel="Clear search"
          onAction={() => setSearchQuery('')}
        />
      )
    }

    /* PHONE — §11.1: a list of sections, each tapping through to its own screen. */
    if (onPhoneList) {
      return (
        <div className="app-settings-mobile-list">
          <div className="app-settings-mobile-section-header">APP SETTINGS</div>
          <div className="app-settings-mobile-group">
            {tabs.map((t) => {
              const conf = TAB_CONFIG[t.key]
              return (
                <button
                  key={t.key}
                  type="button"
                  onClick={() => go(t.key)}
                  className="app-settings-mobile-row"
                >
                  <div
                    className="app-settings-mobile-icon"
                    style={{ backgroundColor: 'var(--surface-2)', color: 'var(--primary)' }}
                  >
                    <Icon name={conf.icon} size={20} />
                  </div>
                  <div className="app-settings-mobile-text">
                    <span className="app-settings-mobile-title">{t.label}</span>
                    <span className="app-settings-mobile-desc">{TAB_SUMMARY[t.key]}</span>
                  </div>
                  <Icon name="chevron_right" size={16} className="app-settings-chevron-muted" />
                </button>
              )
            })}
          </div>
        </div>
      )
    }

    /* PHONE — one section, full screen. */
    if (phone) {
      return (
        <div className="app-settings-mobile-subpage">
          <div className="app-settings-pane">
            {panel}
            {active === 'branches' && rail && (
              <div className="app-settings-branches-rail-wrap">{rail}</div>
            )}
            {active === 'system' && (
              <Card title="System Summary">
                <SummaryRows rows={SYSTEM_SUMMARY.map((r) => ({ label: r.label, value: r.value }))} />
              </Card>
            )}
          </div>
        </div>
      )
    }

    /* DESKTOP & TABLET */
    return (
      <div className={desktop ? 'app-settings-layout' : 'app-settings-tablet-wrapper'}>
        {desktop ? (
          <nav aria-label="Settings sections" className="app-settings-sidebar settings-nav-col">
            <div className="app-settings-sidebar-header">PREFERENCES & POLICIES</div>
            {tabs.map((t) => {
              const on = t.key === active
              const conf = TAB_CONFIG[t.key]
              return (
                <button
                  key={t.key}
                  type="button"
                  aria-current={on ? 'page' : undefined}
                  onClick={() => go(t.key)}
                  className={`app-settings-nav-item settings-tab-btn ${on ? 'is-active' : ''}`}
                >
                  <div
                    className="app-settings-nav-icon-box"
                    style={{
                      backgroundColor: on ? 'var(--primary)' : 'var(--surface-2)',
                      color: on ? 'var(--btn-primary-fg, #ffffff)' : 'var(--text2)',
                    }}
                  >
                    <Icon name={conf.icon} size={16} />
                  </div>
                  <div className="app-settings-nav-text">
                    <div className="app-settings-nav-label">{t.label}</div>
                    <div className="app-settings-nav-subtitle">{conf.subtitle}</div>
                  </div>
                  <Icon name="chevron_right" size={14} className="app-settings-nav-chevron" />
                </button>
              )
            })}
          </nav>
        ) : (
          <div
            role="tablist"
            aria-label="Settings sections"
            className="app-settings-tablet-tabs settings-tab-scroll"
          >
            {tabs.map((t) => {
              const on = t.key === active
              const conf = TAB_CONFIG[t.key]
              return (
                <button
                  key={t.key}
