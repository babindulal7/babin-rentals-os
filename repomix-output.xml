}

/** An open product decision, stated on the screen it blocks rather than only in a comment. */
export function OpenDecision({ text }: { text: string }) {
  return (
    <p
      style={{
        margin: 0,
        display: 'flex',
        alignItems: 'flex-start',
        gap: 6,
        fontSize: 'var(--t-th)',
