/**
 * §31 — name, "Bundle · Category · N Items", price/day, availability, the
 * component summary line, and the two actions.
 */
function BundleRow({
  id,
  result,
  active,
  showPrices,
  onHover,
  onAdd,
  onView,
}: {
  id: string
  result: BundleResult
  active: boolean
  showPrices: boolean
  onHover: () => void
  onAdd: () => void
  onView: () => void
}) {
