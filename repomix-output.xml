import type { RefObject, MutableRefObject } from 'react'
import type { NavigateFunction } from 'react-router-dom'
import Icon from '../../../components/ui/Icon'
import { Input, Select } from '../../../components/ui'
import { Field, Section, AddClientButton, inputStyle } from './BookingFormWidgets'
import { ClientCombobox } from './ClientCombobox'
import { ClientHealthEye } from './ClientHealthChip'
import { IntelCard } from '../../../components/ui/IntelCard'
import { clientGlance, clientDetailGroups } from '../../../data/clientIntel'
import { PROJECT_TYPES, validateProjectType } from '../../../lib/projectTypes'
import { formatMoney } from '../../../lib/money'
import type { ClientRecord } from '../../../lib/queries/clients'
import type { ClientHealthVerdict } from './clientHealth'
import type { GateContext } from '../../../lib/fieldGating'
import type { AuthUser } from '../../../lib/auth'

export interface BookingClientSectionProps {
  open: boolean
  onToggle: () => void
  client: ClientRecord | undefined
  clientPool: readonly ClientRecord[]
  selectedClientId: string | null
  clientFieldTouched: boolean
  setClientFieldTouched: (touched: boolean) => void
  addClientOpen: boolean
  selectClient: (c: ClientRecord) => void
  openAddClient: () => void
  quickViewOpen: boolean
  setQuickViewOpen: (fn: (o: boolean) => boolean) => void
  health: ClientHealthVerdict | null
  days: number
  dayWord: string
  canClientBalance: boolean
  canBookingMoney: boolean
  gctx: GateContext
  user: AuthUser | null
  onOpenHistory: () => void
  suppressClientListOnFocus: MutableRefObject<boolean>
  clientFieldRef: RefObject<HTMLDivElement | null>
  navigate: NavigateFunction
  isPhone: boolean
  project: string
  setProject: (p: string) => void
  kind: string
  setKind: (k: string) => void
  kindOther: string
  setKindOther: (o: string) => void
  govId: string
  setGovId: (id: string) => void
  title?: string
}

export function BookingClientSection({
  open,
  onToggle,
  client,
  clientPool,
  selectedClientId,
  clientFieldTouched,
  setClientFieldTouched,
  addClientOpen,
  selectClient,
  openAddClient,
  quickViewOpen,
  setQuickViewOpen,
  health,
  days,
  dayWord,
  canClientBalance,
  canBookingMoney,
  gctx,
  user,
  onOpenHistory,
  suppressClientListOnFocus,
  clientFieldRef,
  navigate,
  isPhone,
  project,
  setProject,
  kind,
  setKind,
  kindOther,
  setKindOther,
  title = 'Client & Schedule',
}: BookingClientSectionProps) {
  return (
    <Section
      id="section-0"
      collapsible={false}
      title={title}
      badge={
        client ? (
          <span
            style={{
              display: 'inline-flex',
              alignItems: 'center',
              gap: 4,
              padding: '2px 8px',
              borderRadius: 'var(--r-badge)',
              background: 'var(--st-success-bg)',
              color: 'var(--st-success-fg)',
              fontSize: 11,
              fontWeight: 600,
            }}
          >
            <Icon name="check" size={11} /> {client.name}
          </span>
        ) : null
      }
      open={open}
      onToggle={onToggle}
      summary={client ? `${client.name} · ${days} ${dayWord}` : 'No client selected'}
    >
      {/* User accepted required-field clarity, 7 Oct: match confirmation gates. */}
      <Field label="Client *" labelId="new-rental-client-label">
        <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)', flexWrap: 'wrap' }}>
          <div
            ref={clientFieldRef as RefObject<HTMLDivElement>}
            onBlur={(e) => {
              if (addClientOpen) return
              if (!e.currentTarget.contains(e.relatedTarget as Node | null)) setClientFieldTouched(true)
            }}
            style={{ flex: '1 1 260px', minWidth: 0 }}
          >
            <ClientCombobox
              clients={clientPool}
              selectedClientId={selectedClientId}
              onSelect={selectClient}
              onCreateNew={openAddClient}
              onViewAll={() => navigate('/clients')}
              inputStyle={inputStyle}
              labelledBy="new-rental-client-label"
              required
              showOutstanding={canClientBalance}
              suppressNextFocusOpen={suppressClientListOnFocus}
              // User ruling, 7 Oct: history is an icon inside client search.
              inputAction={client ? (
                <button
                  type="button"
                  className="press"
                  aria-label="Client History"
                  title="Client History"
                  onClick={onOpenHistory}
                  style={{ width: 44, minHeight: 44, display: 'grid', placeItems: 'center', padding: 0, border: 'none', borderRadius: 'var(--r-btn)', background: 'transparent', color: 'var(--text2)', cursor: 'pointer' }}
                >
                  <Icon name="activity" size={18} />
                </button>
              ) : undefined}
              {...(client || !clientFieldTouched
                ? {}
                : { error: 'Select a client before confirming this booking.' })}
              trailing={
                !client ? (
                  <AddClientButton onClick={openAddClient} />
                ) : undefined
              }
            />
            {client && <div className="new-rental-client-insights">
              {health && <ClientHealthEye
                verdict={health}
                clientName={client.name}
                open={quickViewOpen}
                controls="new-rental-client-quick-view"
                onClick={() => setQuickViewOpen((o) => !o)}
              />}
            {client.dbId && (
                <IntelCard
                  glance={clientGlance(client, gctx)}
                  detail={clientDetailGroups(client, gctx)}
                  detailTitle={client.name}
                  entityType="client"
                  entityId={client.dbId}
                  context="new-rental"
                  gateContext={gctx}
                  actionContext={user ? { userId: user.id, role: user.role } : null}
                >
                  <span className="identifier" style={{ color: 'var(--link)', fontWeight: 600 }}>Client details</span>
                </IntelCard>
            )}
            </div>}
          </div>
        </div>

        {client && (client.isBlocked || client.onStop || (canBookingMoney && client.outstandingPaisa > 0) || health?.level === 'attention') && (
          <div
            role="alert"
            data-testid="client-credit-warning"
            style={{
              marginTop: 10,
              padding: '10px 14px',
              borderRadius: 'var(--radius-md, 8px)',
              display: 'flex',
              alignItems: 'flex-start',
              gap: 10,
              background: (client.isBlocked || client.onStop) ? 'var(--danger-bg, #fef2f2)' : 'var(--warning-bg, #fffbeb)',
              border: `1px solid ${(client.isBlocked || client.onStop) ? 'var(--danger-border, #fca5a5)' : 'var(--warning-border, #fcd34d)'}`,
              color: (client.isBlocked || client.onStop) ? 'var(--danger-text, #991b1b)' : 'var(--warning-text, #92400e)',
              fontSize: 13,
              lineHeight: 1.4,
            }}
          >
            <Icon
              name={(client.isBlocked || client.onStop) ? 'alert_circle' : 'alert_triangle'}
              size={18}
              style={{ flexShrink: 0, marginTop: 1 }}
            />
            <div style={{ flex: 1 }}>
              <div style={{ fontWeight: 600 }}>
                {(client.isBlocked || client.onStop) ? 'Client Account Blocked' : 'Client Credit Warning'}
              </div>
              <div>
                {(client.isBlocked || client.onStop)
                  ? (client.blockReason || client.onStop?.reason || 'This client is currently blocked from equipment rentals. Quotation and booking confirmation cannot proceed without manager override.')
                  : (health?.reasons?.map((r) => r.text).join(' · ') || `Client has outstanding balance of ${formatMoney(client.outstandingPaisa)}.`)}
              </div>
            </div>
          </div>
        )}
      </Field>

      <div style={{ display: 'grid', gridTemplateColumns: isPhone ? '1fr' : 'repeat(2, minmax(0,1fr))', gap: 11, marginTop: 11 }}>
        <Field label="Project">
          <Input value={project} onChange={(e) => setProject(e.target.value)} style={inputStyle} />
        </Field>
        <Field
          label="Project Type *"
          error={
            kind.trim() !== ''
              ? (validateProjectType(kind, kindOther).message ?? undefined)
              : undefined
          }
        >
          <Select
            aria-label="Project type"
            required
            value={kind}
            placeholder="Select project type"
            options={PROJECT_TYPES.map((t) => ({ value: t, label: t }))}
            onChange={(e) => {
              const next = e.target.value
              setKind(next)
              if (next !== 'Other') setKindOther('')
            }}
            style={inputStyle}
          />
        </Field>
        {kind === 'Other' && (
          <div style={{ gridColumn: isPhone ? 'auto' : '1 / -1' }}>
            <Field label="Specify Project Type *">
              <Input
                value={kindOther}
                aria-required="true"
                onChange={(e) => setKindOther(e.target.value)}
                placeholder="e.g. Live Theatre Production"
                style={inputStyle}
              />
            </Field>
          </div>
        )}
      </div>
    </Section>
  )
}
</file>

<file path="src/modules/rentals/booking/BookingEquipmentSection.tsx">
import { useCallback, useEffect, useRef, useState } from 'react'
import { Button } from '../../../components/ui/Button'
import { Input, Select } from '../../../components/ui'
import Icon, { type IconName } from '../../../components/ui/Icon'
import { Section, Field, inputStyle } from './BookingFormWidgets'
import { AddItemPanel, type AddItemSource } from './AddItemPanel'
import { RentalLineItemsTree, type Line } from './RentalLineItemsTree'
import {
  type EquipmentResult,
  type EquipmentAvailabilitySource,
  type EquipmentConflictSummary,
  type BookingWindow,
  type BookingLineDraft,
  type BundleResult,
  equipmentLineDraft,
  defaultTransportOptions,
} from './itemCatalogue'
import { crewPool, type CrewMember } from '../../../lib/queries/crew'
import type { PricingPipelineResult } from '../../../lib/pricingPipeline'
import type { GateContext } from '../../../lib/fieldGating'
import type { AuthUser } from '../../../lib/auth'
import { supabase, newClientUuid } from '../../../lib/supabase'
import { rupees, type Paisa } from '../../../lib/money'
import './booking-equipment-section.css'

const inlineInfoStyle = {
  margin: 0,
  display: 'flex',
  alignItems: 'flex-start',
  gap: 7,
  fontSize: 'var(--t-meta)',
  fontWeight: 500,
  color: 'var(--text2)',
  lineHeight: 1.4,
} as const

export interface BookingEquipmentSectionProps {
  open: boolean
  onToggle: () => void
  title?: string
  lines: Line[]
  setLines: React.Dispatch<React.SetStateAction<Line[]>>
  totalUnits: number
  bundleCount: number
  days: number
  liveEquipment: readonly EquipmentResult[] | null
  availabilitySource: EquipmentAvailabilitySource
  liveBundleResults: readonly BundleResult[]
  liveCrew: readonly CrewMember[] | null
  existingCrewIds: readonly string[]
  bookingWindow: BookingWindow
  poolError: string | null
  conflictSummary: EquipmentConflictSummary
  deliveryType: 'Client Pickup' | 'Babin Delivery'
  /** The delivery charge on the form, shown on the Babin Delivery search row. */
  deliveryChargePaisa: Paisa
  onSelectTransport: (type: 'Client Pickup' | 'Babin Delivery') => void
  onAddCrew: (crewId: string) => void
  canBookingMoney: boolean
  gateContext: GateContext
  user: AuthUser | null
  navigate: (path: string) => void
  pricing: PricingPipelineResult
  isPhone?: boolean
}

export function BookingEquipmentSection({
  open,
  onToggle,
  title = 'Equipment, Bundles & Services',
  lines,
  setLines,
  totalUnits,
  bundleCount,
  days,
  liveEquipment,
  availabilitySource,
  liveBundleResults,
  liveCrew,
  existingCrewIds,
  bookingWindow,
  poolError,
  conflictSummary,
  deliveryType,
  deliveryChargePaisa,
  onSelectTransport,
  onAddCrew,
  canBookingMoney,
  gateContext,
  user,
  navigate,
  pricing,
}: BookingEquipmentSectionProps) {
  const [collapsedBundles, setCollapsedBundles] = useState<Record<string, boolean>>({})

  const [bundleNotice, setBundleNotice] = useState<{
    name: string
    notes: readonly string[]
    skipped: ReadonlyArray<{ model: string; reason: string }>
  } | null>(null)

  const [customLineOpen, setCustomLineOpen] = useState(false)
  const [customLineType, setCustomLineType] = useState<'Service' | 'Manual item' | 'Sub-rental'>('Service')
  const [customLineName, setCustomLineName] = useState('')
  const [customLineVendor, setCustomLineVendor] = useState('')
  const [customLineRate, setCustomLineRate] = useState('')
  const [customLineQty, setCustomLineQty] = useState(1)
  const [customLineError, setCustomLineError] = useState<string | null>(null)
  const customLineFormRef = useRef<HTMLDivElement>(null)

  useEffect(() => {
    if (!customLineOpen) return
    const form = customLineFormRef.current
    form?.scrollIntoView?.({ block: 'start', behavior: 'auto' })
    form?.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true })
  }, [customLineOpen])

  const addDrafts = useCallback(
    (drafts: readonly BookingLineDraft[], source: AddItemSource) => {
      setBundleNotice(
        source.kind === 'bundle' && source.bundle
          ? { name: source.name, notes: source.bundle.notes, skipped: source.bundle.skipped }
          : null,
      )
      setLines((prev) => {
        const have = new Set(prev.map((l) => l.id))
        const fresh = drafts
          .filter((d) => !have.has(d.id))
          .map<Line>((d) => ({
            ...d,
            ...(source.kind === 'bundle' ? { bundleCode: source.id, bundleName: source.name } : {}),
          }))
        return fresh.length === 0 ? prev : [...prev, ...fresh]
      })
    },
    [setLines],
  )

  const addCustomLine = useCallback(() => {
    const name = customLineName.trim()
    const rate = Number(customLineRate)
    const vendor = customLineVendor.trim()
    if (!name) {
      setCustomLineError('Enter a description for this line.')
      return
    }
    if (!Number.isFinite(rate) || rate < 0) {
      setCustomLineError('Enter a rate of Rs 0 or more.')
      return
    }
    const isSub = customLineType === 'Sub-rental'
    setLines((prev) => [
      ...prev,
      {
        id: newClientUuid(),
        lineType: customLineType,
        name: isSub && vendor ? `${name} (${vendor})` : name,
        serial: '—',
        category: isSub ? 'Sub-rental' : customLineType === 'Service' ? 'Service' : 'Manual charge',
        ratePaisa: rupees(rate) as Paisa,
        days: Math.max(1, days || 1),
        qty: Math.max(1, Math.round(customLineQty) || 1),
        discountPct: 0,
        location: isSub ? (vendor ? `Vendor: ${vendor}` : 'Sub-rented') : 'Not inventory-tracked',
        committedTo: '—',
      },
    ])
    setCustomLineError(null)
    setCustomLineName('')
    setCustomLineVendor('')
    setCustomLineRate('')
    setCustomLineQty(1)
    setCustomLineOpen(false)
  }, [customLineName, customLineRate, customLineQty, customLineType, customLineVendor, days, setLines])

  const addScannedEquipment = useCallback(
    async (rawCode: string): Promise<string | null> => {
      const code = rawCode.trim()
      if (!code) return null
      if (!liveEquipment) {
        return null
      }
      type ScannedUnit = { product?: { id?: string | null } | null }
      let unit: ScannedUnit | null = null
      try {
        const { data, error } = await supabase
          .from('product_units_v')
          .select('product:products_v (id)')
          .or(`barcode.eq.${code},serial_no.eq.${code},asset_tag.eq.${code}`)
          .limit(1)
          .maybeSingle()
        if (error) throw error
        if (data) {
          unit = data as ScannedUnit
        }
      } catch {
        return null
      }

      const productId = unit?.product?.id ?? null
      const match = productId ? liveEquipment.find((item) => item.id === productId) : undefined
      if (!match) {
        return null
      }
      if (lines.some((line) => line.id === match.id)) {
        return null
      }
      if (match.availability.level === 'unavailable') {
        return null
      }
      addDrafts([equipmentLineDraft(match, days || 1)], { kind: match.kind, id: match.id, name: match.name })
      return match.id
    },
    [liveEquipment, lines, addDrafts, days],
  )

  // RULING 2026-10-08: catalogue, selected items, then optional charges follow the rental workflow.
  return (
    <Section
      id="section-2"
      title={title}
      badge={
        lines.length > 0 ? (
          <span
            style={{
              display: 'inline-flex',
              alignItems: 'center',
              gap: 4,
              padding: '2px 8px',
              borderRadius: 'var(--r-badge)',
              background: 'var(--st-primary-bg)',
              color: 'var(--st-primary-fg)',
              fontSize: 11,
              fontWeight: 600,
            }}
          >
            {lines.length} {lines.length === 1 ? 'line' : 'lines'} · {totalUnits} {totalUnits === 1 ? 'unit' : 'units'}
          </span>
        ) : null
      }
      open={open}
      onToggle={onToggle}
      collapsible={false}
      summary={`${lines.length} lines · ${conflictSummary.conflicts.length} conflicts`}
    >
      <div className="new-rental-equipment-picker" role="group" aria-label="Find equipment and bundles">
        {!liveEquipment && (
          <p style={{ margin: '0 0 var(--sp-sm)', fontSize: 'var(--t-meta)', color: 'var(--warn-text)', lineHeight: 1.5 }}>
            This panel is still listing <strong>sample equipment</strong> — the live catalogue has not loaded, so
            items added here cannot be saved and Confirm will say so rather than writing a booking with products
            that do not exist.
          </p>
        )}
        {poolError && (
          <p role="alert" style={{ margin: '0 0 var(--sp-sm)', fontSize: 'var(--t-meta)', color: 'var(--st-danger-fg)', lineHeight: 1.5 }}>
            The live catalogue and client list could not be read: {poolError}
          </p>
        )}

        <AddItemPanel
          inline
          window={bookingWindow}
          {...(liveEquipment ? { equipment: liveEquipment, availability: availabilitySource } : {})}
          bundles={liveBundleResults}
          crew={crewPool(liveCrew)}
          transport={defaultTransportOptions(bookingWindow, deliveryChargePaisa)}
          existingCrewIds={existingCrewIds}
          selectedTransportType={deliveryType}
          days={days || 1}
          existingLineIds={lines.map((l) => l.id)}
          onAdd={addDrafts}
          onAddCrew={onAddCrew}
          onSelectTransport={onSelectTransport}
          showPrices={canBookingMoney}
          inputStyle={inputStyle}
          onScan={addScannedEquipment}
        />
      </div>

      {lines.length > 0 && (() => {
        const conflicted = conflictSummary.conflicts.length > 0
        const answered = conflictSummary.state === 'ready'
        const tone = conflicted
          ? { bg: 'var(--st-danger-bg)', fg: 'var(--st-danger-fg)', icon: 'error' as IconName }
          : answered
            ? { bg: 'var(--st-in-bg)', fg: 'var(--st-in-fg)', icon: 'check' as IconName }
            : { bg: 'var(--st-neutral-bg)', fg: 'var(--st-neutral-fg)', icon: 'timer' as IconName }
        return (
          <div
            style={{
              display: 'flex',
              gap: 7,
              alignItems: 'center',
              padding: '7px 10px',
              borderRadius: 'var(--r-btn)',
              marginBottom: 10,
              background: tone.bg,
              color: tone.fg,
              fontSize: 'var(--t-meta)',
              fontWeight: 600,
            }}
          >
            <Icon name={tone.icon} size={13} style={{ flexShrink: 0 }} />
            {conflictSummary.text}
          </div>
        )
      })()}

      {bundleNotice && (
        <div
          role="status"
          aria-live="polite"
          style={{
            display: 'flex',
            flexDirection: 'column',
            gap: 4,
            padding: '8px 10px',
            marginBottom: 8,
            borderRadius: 'var(--r-card)',
            background: 'var(--surface)',
            border: '1px solid var(--border)',
          }}
        >
          <p style={{ ...inlineInfoStyle, fontWeight: 600, color: 'var(--text)' }}>
            <Icon name="info" size={13} style={{ flexShrink: 0, marginTop: 2 }} />
            <span>{bundleNotice.name}</span>
          </p>
          {bundleNotice.notes.map((n) => (
            <p key={n} style={inlineInfoStyle}>
              <span aria-hidden="true" style={{ flexShrink: 0 }}>
                ·
              </span>
              <span>{n}</span>
            </p>
          ))}
          {Array.from(
            bundleNotice.skipped.reduce((m, x) => {
              m.set(x.reason, [...(m.get(x.reason) ?? []), x.model])
              return m
            }, new Map<string, string[]>()),
          ).map(([reason, models]) => (
            <p key={reason} style={inlineInfoStyle}>
              <span aria-hidden="true" style={{ flexShrink: 0 }}>
                ·
              </span>
              <span>
                Not added — {models.join(', ')}: {reason}
              </span>
            </p>
          ))}
          <div style={{ marginTop: 2 }}>
            <Button variant="ghost" onClick={() => setBundleNotice(null)}>
              Dismiss
            </Button>
          </div>
        </div>
      )}

      <div className="new-rental-equipment-selection">
        {lines.length > 0 && <h3 className="new-rental-equipment-label">Selected items</h3>}
        <RentalLineItemsTree
          lines={lines}
          setLines={setLines}
          collapsedBundles={collapsedBundles}
          setCollapsedBundles={setCollapsedBundles}
          canBookingMoney={canBookingMoney}
          conflictSummary={conflictSummary}
          liveEquipment={liveEquipment}
          gateContext={gateContext}
          user={user}
          navigate={navigate}
          totalUnits={totalUnits}
          bundleCount={bundleCount}
          days={days}
          pricing={pricing}
        />
      </div>

      {canBookingMoney && (
        <div className="new-rental-equipment-extras">
          <div className="new-rental-equipment-extras-bar">
            <h3 className="new-rental-equipment-label">Services &amp; other charges</h3>
            <div className="new-rental-equipment-extras-actions">
              <Button
                icon="box"
                variant="outline"
                size="sm"
                aria-controls="new-rental-custom-line"
                aria-expanded={customLineOpen && customLineType === 'Sub-rental'}
                onClick={() => {
                  setCustomLineType('Sub-rental')
                  setCustomLineOpen(true)
                }}
              >
                Add sub-rental
              </Button>
              <Button
                icon={customLineOpen ? 'close' : 'plus'}
                variant="outline"
                size="sm"
                aria-controls="new-rental-custom-line"
                aria-expanded={customLineOpen}
                onClick={() => setCustomLineOpen((prev) => !prev)}
              >
                {customLineOpen ? 'Close line form' : 'Add custom line'}
              </Button>
            </div>
          </div>

          {customLineOpen && (
            <div ref={customLineFormRef} id="new-rental-custom-line" className="new-rental-equipment-line-form">
              <div className="new-rental-equipment-line-fields">
                <div className="new-rental-equipment-line-description">
                  <Field label={customLineType === 'Sub-rental' ? 'Equipment name' : 'Description'}>
                    <Input
                      value={customLineName}
                      onChange={(e) => setCustomLineName(e.target.value)}
                      placeholder={customLineType === 'Sub-rental' ? 'e.g. Master Prime 50mm' : 'e.g. Operator overtime'}
                      style={inputStyle}
                    />
                  </Field>
                </div>
                <div className={`new-rental-equipment-line-details ${customLineType === 'Sub-rental' ? 'has-supplier' : ''}`}>
                  <Field label="Line type">
                    <Select value={customLineType} onChange={(e) => setCustomLineType(e.target.value as typeof customLineType)} style={inputStyle}>
                      <option value="Service">Service</option>
                      <option value="Manual item">Manual charge</option>
                      <option value="Sub-rental">Sub-rental (Partner equipment)</option>
                    </Select>
                  </Field>
                  {customLineType === 'Sub-rental' && (
                    <Field label="Partner / Supplier">
                      <Input value={customLineVendor} onChange={(e) => setCustomLineVendor(e.target.value)} placeholder="e.g. GearHouse KTM" style={inputStyle} />
                    </Field>
                  )}
                </div>
                <div className="new-rental-equipment-line-amounts">
                  <Field label="Quantity">
                    <Input type="number" min={1} value={customLineQty} onChange={(e) => setCustomLineQty(Math.max(1, Number(e.target.value) || 1))} style={inputStyle} />
                  </Field>
                  <Field label="Rate / day (Rs)">
                    <Input type="number" min={0} value={customLineRate} onChange={(e) => setCustomLineRate(e.target.value)} placeholder="0" style={inputStyle} />
                  </Field>
                </div>
              </div>
              {customLineError && (
                <p role="alert" style={{ margin: '8px 0 0', fontSize: 'var(--t-meta)', color: 'var(--st-danger-fg)' }}>
                  {customLineError}
                </p>
              )}
              <div className="new-rental-equipment-line-actions">
                <Button
                  variant="ghost"
                  onClick={() => {
                    setCustomLineOpen(false)
                    setCustomLineError(null)
                  }}
                >
                  Cancel
                </Button>
                <Button icon="plus" onClick={addCustomLine}>
                  {customLineType === 'Sub-rental' ? 'Add sub-rental' : 'Add line'}
                </Button>
              </div>
            </div>
          )}
        </div>
      )}
    </Section>
  )
}
</file>

<file path="src/modules/rentals/booking/BookingFormWidgets.tsx">
import React, { cloneElement, isValidElement, useEffect, useId, useRef, useState } from 'react'
import Icon from '../../../components/ui/Icon'
import type { IconName } from '../../../components/ui/Icon'
import { cardStyle } from '../../../components/ui/Page'

/**
 * A transparent 44×44 hit area centred on a control that is visually smaller.
 * The touch minimum applies on desktop too, and inflating a table's remove
 * glyph or a section chevron to 44px tall would wreck density — so the *target*
 * grows and the glyph does not. The parent must be `position: relative`.
 */
export function TouchInset() {
  return (
    <span
      aria-hidden="true"
      style={{
        position: 'absolute',
        left: '50%',
        top: '50%',
        transform: 'translate(-50%, -50%)',
        width: 'max(100%, var(--tap))',
        height: 'var(--tap)',
      }}
    />
  )
}

/**
 * Common input styling conforming to Law 15 touch minimums and theme tokens.
 */
export const inputStyle = {
  width: '100%',
  minHeight: 'var(--tap)',
  padding: '0 9px',
  borderRadius: 'var(--r-input)',
  border: '1px solid var(--input-border)',
  background: 'var(--input-bg)',
  color: 'var(--text)',
  fontSize: 'var(--t-meta)',
  fontFamily: 'inherit',
} as const

/**
 * Off-screen but in the accessibility tree — no global `.sr-only` exists in this build.
 */
export const srOnly = {
  position: 'absolute' as const,
  width: 1,
  height: 1,
  padding: 0,
  margin: -1,
  overflow: 'hidden',
  clip: 'rect(0 0 0 0)',
  whiteSpace: 'nowrap' as const,
  border: 0,
}

/**
 * redesign v1 §7.4 — qty and days as steppers rather than boxed number
 * inputs, so the equipment table reads as a table again instead of a form
 * embedded in one. Each glyph button keeps the 44×44 hit area via
 * `TouchInset` while staying visually compact for table density.
 */
export function NumberStepper({
  value,
  min = 1,
  onChange,
  disabled,
  label,
}: {
  value: number
  min?: number
  onChange: (n: number) => void
  disabled?: boolean
  label: string
}) {
  const isMin = value <= min
  return (
    <div className="new-rental-stepper-pill">
      <button
        type="button"
        className="press new-rental-stepper-btn"
        aria-label={`Decrease ${label}`}
        disabled={disabled || isMin}
        onClick={() => onChange(Math.max(min, value - 1))}
      >
        <TouchInset />
        <Icon name="minus" size={11} />
      </button>
      <span className="figure new-rental-stepper-val" style={{ color: disabled ? 'var(--muted)' : 'var(--text)' }}>
        {value}
      </span>
      <button
        type="button"
        className="press new-rental-stepper-btn"
        aria-label={`Increase ${label}`}
        disabled={disabled}
        onClick={() => onChange(value + 1)}
      >
        <TouchInset />
        <Icon name="plus" size={11} />
      </button>
    </div>
  )
}

export function Field({
  label,
  children,
  error,
  helper,
  labelId,
  id,
}: {
  label: string
  children: React.ReactNode
  /** When set, renders below children in the danger tone. Field can't reach into
   *  arbitrary children to stamp aria-invalid/aria-describedby on the input itself
   *  (children are caller-supplied), so callers that want full a11y wiring should
   *  point their input's aria-describedby at this span's id themselves.
   *  `| undefined` is explicit because tsconfig sets exactOptionalPropertyTypes:
   *  callers pass ternaries like `cond ? '...' : undefined`. */
  error?: string | undefined
  /** Muted helper text shown below children when there is no error. */
  helper?: string | undefined
  /**
   * When set the wrapper becomes a `<div>` with an `id`-carrying label span
   * instead of a `<label>`. A `<label>` around a composite widget (the client
   * combobox is an input *plus* a listbox *plus* the health eye) steals clicks
   * meant for the eye, so those callers wire `aria-labelledby` instead.
   */
  labelId?: string | undefined
  id?: string | undefined
}) {
  const generatedId = useId()
  const fieldId = id || `field-${generatedId}`
  const errorId = error ? `field-error-${label.replace(/\s+/g, '-').toLowerCase()}` : undefined

  const childElem = isValidElement<Record<string, unknown>>(children) ? children : null
  const enhancedChildren = childElem
    ? cloneElement(childElem, {
        id: (childElem.props['id'] as string | undefined) || fieldId,
        'aria-label': (childElem.props['aria-label'] as string | undefined) || label,
      })
    : children

  const body = (
    <>
      <span id={labelId} style={{ display: 'block', fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--muted)', marginBottom: 3 }}>{label}</span>
      {enhancedChildren}
      {error ? (
        <span id={errorId} role="alert" style={{ display: 'block', fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--danger-text)', marginTop: 3 }}>
          {error}
        </span>
      ) : helper ? (
        <span style={{ display: 'block', fontSize: 'var(--t-meta)', color: 'var(--muted)', marginTop: 3 }}>{helper}</span>
      ) : null}
    </>
  )
  if (labelId) return <div style={{ display: 'block', minWidth: 0 }}>{body}</div>
  return <label htmlFor={fieldId} style={{ display: 'block', minWidth: 0 }}>{body}</label>
}

/**
 * §59 — the section header. All sections render through this one
 * component; there is no second heading style anywhere on the page, which is
 * what stops Section 4 slowly drifting away from Section 1.
 *
 * redesign v1 §7.1 — plain heading and its collapse chevron only, no numbered
 * pill. A numbered circle reads as step one of a wizard, and the footer says
 * explicitly "Sections are not a wizard" — the pills contradicted the note.
 */
export function Section({
  id,
  title,
  open,
  onToggle,
  action,
  summary,
  badge,
  children,
  collapsible = true,
}: {
  /** Scroll target for the rail's Review card — see `jumpToSection`. */
  id?: string
  title: string
  open: boolean
  onToggle: () => void
  action?: React.ReactNode
  /** Shown in the header when collapsed, so collapsing never hides the facts. */
  summary?: string
  badge?: React.ReactNode
  children: React.ReactNode
  collapsible?: boolean
}) {
  // RULING 2026-10-08: essential fields stay visible; optional sections keep
  // their mounted content and one visible, keyboard-accessible disclosure.
  const expanded = !collapsible || open
  return (
    <section id={id} className={`new-rental-section-card ${expanded ? 'is-active' : ''}`} style={{ ...cardStyle, minWidth: 0, padding: 0 }}>
      <div
        className="new-rental-section-heading"
        onClick={collapsible ? onToggle : undefined}
        style={{
          display: 'flex',
          alignItems: 'center',
          gap: 10,
          padding: '12px 16px',
          borderBottom: expanded ? '1px solid var(--border)' : 'none',
          background: 'var(--surface)',
          cursor: collapsible ? 'pointer' : undefined,
          userSelect: 'none',
          minHeight: 48,
          transition: 'background var(--dur-fast) var(--ease)',
        }}
      >
        <h2 style={{ margin: 0, fontSize: 'var(--t-ui)', fontWeight: 700, color: 'var(--text)' }}>
          {title}
        </h2>
        {badge}
        {!expanded && summary && (
          <span
            style={{
              fontSize: 'var(--t-meta)',
              color: 'var(--text2)',
              minWidth: 0,
              overflow: 'hidden',
              textOverflow: 'ellipsis',
              whiteSpace: 'nowrap',
              background: 'var(--surface)',
              padding: '2px 8px',
              borderRadius: 'var(--r-xs)',
              marginLeft: 4,
              border: '1px solid color-mix(in srgb, var(--border) 60%, transparent)',
            }}
          >
            {summary}
          </span>
        )}
        {expanded && action && (
          <span
            onClick={(e) => e.stopPropagation()}
            style={{ marginLeft: 'auto', display: 'flex', alignItems: 'center', gap: 6, flexWrap: 'wrap' }}
          >
            {action}
          </span>
        )}
        {collapsible && <button
          type="button"
          onClick={(e) => {
            e.stopPropagation()
            onToggle()
          }}
          aria-expanded={open}
          aria-controls={id ? `${id}-body` : undefined}
          aria-label={`${open ? 'Collapse' : 'Expand'} ${title}`}
          style={{ marginLeft: 'auto', flexShrink: 0, width: 44, height: 44, display: 'grid', placeItems: 'center', padding: 0, border: 0, borderRadius: 'var(--r-btn)', color: 'var(--text2)', background: 'transparent', cursor: 'pointer' }}
        >
          <Icon name={open ? 'chevron_up' : 'chevron_down'} size={18} />
        </button>}
      </div>
      <div id={id ? `${id}-body` : undefined} hidden={!expanded} style={{ padding: 'var(--sp-md) var(--sp-lg)' }}>{children}</div>
    </section>
  )
}

/** §37 / §52 — a money row. Label left, figure right, aligned on the same right edge everywhere. */
export function MoneyRow({
  label,
  value,
  tone,
  strong,
  big,
}: {
  label: string
  value: string
  tone?: string
  strong?: boolean
  big?: boolean
}) {
  return (
    <div style={{ display: 'flex', alignItems: 'baseline', gap: 9, padding: big ? '6px 0 2px' : '3px 0' }}>
      <span style={{ flex: 1, minWidth: 0, fontSize: big ? 'var(--t-meta)' : 'var(--t-meta)', fontWeight: big ? 700 : 400, color: big ? 'var(--text)' : 'var(--text2)' }}>{label}</span>
      <span
        className="figure"
        style={{
          fontSize: big ? 'var(--t-h3)' : 'var(--t-meta)',
          fontWeight: big || strong ? 700 : 600,
          letterSpacing: big ? '-0.02em' : undefined,
          color: tone ?? 'var(--text)',
          whiteSpace: 'nowrap',
        }}
      >
        {value}
      </span>
    </div>
  )
}

/**
 * The `⋮` menu on parent rows.
 */
export function RowMenu({
  label,
  items,
}: {
  label: string
  items: Array<{ label: string; icon: IconName; onClick: () => void }>
}) {
  const [open, setOpen] = useState(false)
  const rootRef = useRef<HTMLDivElement | null>(null)

  useEffect(() => {
    if (!open) return
    const onDown = (e: MouseEvent) => {
      if (!rootRef.current?.contains(e.target as Node | null)) setOpen(false)
    }
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') setOpen(false)
    }
    document.addEventListener('mousedown', onDown)
    window.addEventListener('keydown', onKey)
    return () => {
      document.removeEventListener('mousedown', onDown)
      window.removeEventListener('keydown', onKey)
    }
  }, [open])

  return (
    <div ref={rootRef} style={{ position: 'relative', display: 'inline-block' }}>
      <button
        type="button"
        className="press"
        aria-haspopup="menu"
        aria-expanded={open}
        aria-label={label}
        onClick={() => setOpen((o) => !o)}
        style={{ position: 'relative', width: 26, height: 26, display: 'grid', placeItems: 'center', borderRadius: 'var(--r-xs)', border: 'none', background: 'transparent', color: 'var(--muted)', cursor: 'pointer' }}
      >
        <TouchInset />
        <Icon name="more_vert" size={15} />
      </button>
      {open && (
        <div
          role="menu"
          aria-label={label}
          style={{ position: 'absolute', zIndex: 40, top: 'calc(100% + 4px)', right: 0, minWidth: 210, padding: 5, background: 'var(--dropdown)', border: '1px solid var(--border)', borderRadius: 'var(--r-card)', boxShadow: 'var(--shadow-modal)' }}
        >
          {items.map((it) => (
            <button
              key={it.label}
              type="button"
              role="menuitem"
              className="press"
              onClick={() => {
                it.onClick()
                setOpen(false)
              }}
              style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)', width: '100%', minHeight: 44, padding: '0 9px', borderRadius: 'var(--r-btn)', border: 'none', background: 'transparent', color: 'var(--text)', fontFamily: 'inherit', fontSize: 'var(--t-meta)', fontWeight: 600, textAlign: 'left', cursor: 'pointer' }}
            >
              <Icon name={it.icon} size={15} style={{ color: 'var(--text2)' }} />
              {it.label}
            </button>
          ))}
        </div>
      )}
    </div>
  )
}

/**
 * The add-client control, living inside the client field's trailing slot.
 */
export function AddClientButton({ onClick }: { onClick: () => void }) {
  return (
    <button
      type="button"
      className="press"
      onClick={onClick}
      aria-label="New client"
      title="New client"
      style={{
        display: 'inline-flex',
        alignItems: 'center',
        justifyContent: 'center',
        width: 'auto',
        height: 'var(--tap)',
        minWidth: 'var(--tap)',
        minHeight: 'var(--tap)',
        flexShrink: 0,
        padding: '0 10px',
        borderRadius: 'var(--r-btn)',
        background: 'var(--btn-secondary-bg)',
        color: 'var(--text)',
        border: '1px solid var(--btn-secondary-border)',
        lineHeight: 1,
        cursor: 'pointer',
      }}
    >
      <Icon name="plus" size={20} /><span style={{ marginLeft: 6 }}>New client</span>
    </button>
  )
}
