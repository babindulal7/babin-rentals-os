/* HEADER POSITION CONTRACT — one row, one location for each action family.
 * Desktop positions are right-anchored, not content-anchored: secondary labels
 * may change but cannot move Filters / Add / More / Save along the header.
 * Do not add a second header or change --header-h to solve crowding.
 */
.app-global-header__action-slot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 0;
