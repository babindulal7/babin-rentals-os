<file path="src/modules/clients/__tests__/clientFacets.test.ts">
import { describe, it, expect } from 'vitest'
import { rupees } from '../../../lib/money'
import type { ClientRecord } from '../../../data/clients'
import {
  CLIENT_FACETS,
  clientFacetsFor,
  applyFacets,
  optionsOf,
  facetCountsOf,
  selectionCount,
} from '../clientFacets'

/**
 * The rule these tests exist to defend is the one an operator notices
 * immediately when it is wrong: **a facet is counted with every OTHER facet
 * applied, but not its own.** Get it backwards and picking one membership
 * collapses every other membership to 0, which reads as "there are no Creator
 * clients" rather than "and 12 if you picked Creator instead".
 */

function client(over: Partial<ClientRecord> = {}): ClientRecord {
  return {
    id: 'C-1',
    name: 'Ram Thapa',
    clientType: 'Individual',
    membership: 'Creator',
    phone: '9800000000',
    email: 'ram@example.com',
    currentRentalsCount: 0,
    activeBookings: [],
    outstandingPaisa: rupees(0),
    depositHeldPaisa: rupees(0),
    creditLimitPaisa: rupees(0),
    creditUsedPaisa: rupees(0),
    lastRentalAd: '18 Jul 2026',
    lastRentalBs: '2083/04/03',
    address: 'Boudha',
    ...over,
  } as ClientRecord
}

const ELITE_KTM = client({ id: 'C-1', membership: 'Elite', district: 'Kathmandu' })
const ELITE_PKR = client({ id: 'C-2', membership: 'Elite', district: 'Pokhara' })
const CREATOR_KTM = client({ id: 'C-3', membership: 'Creator', district: 'Kathmandu' })
const ROWS = [ELITE_KTM, ELITE_PKR, CREATOR_KTM]

const membership = CLIENT_FACETS.find((f) => f.key === 'membership')!
const district = CLIENT_FACETS.find((f) => f.key === 'district')!

describe('applyFacets', () => {
  it('ORs within a facet and ANDs across facets', () => {
    // Elite OR Creator = all three.
    expect(applyFacets(ROWS, CLIENT_FACETS, { membership: ['Elite', 'Creator'] })).toHaveLength(3)
    // Elite AND Kathmandu = one.
    const both = applyFacets(ROWS, CLIENT_FACETS, { membership: ['Elite'], district: ['Kathmandu'] })
    expect(both.map((c) => c.id)).toEqual(['C-1'])
  })

  it('returns the rows untouched when nothing is selected', () => {
    expect(applyFacets(ROWS, CLIENT_FACETS, {})).toHaveLength(3)
  })

  it('ignores a facet whose selection is empty', () => {
    expect(applyFacets(ROWS, CLIENT_FACETS, { membership: [] })).toHaveLength(3)
  })

  it('skipKey excludes exactly one facet', () => {
    const sel = { membership: ['Elite'], district: ['Kathmandu'] }
    expect(applyFacets(ROWS, CLIENT_FACETS, sel, 'membership').map((c) => c.id)).toEqual(['C-1', 'C-3'])
    expect(applyFacets(ROWS, CLIENT_FACETS, sel, 'district').map((c) => c.id)).toEqual(['C-1', 'C-2'])
  })
})

describe('facetCountsOf — a facet does not count itself', () => {
  it('keeps sibling options answering "how many instead?" when one is picked', () => {
    const counts = facetCountsOf(membership, ROWS, { membership: ['Elite'] })
    // Elite is selected, but Creator must still report its own 1 — not 0.
    expect(counts['Elite']).toBe(2)
    expect(counts['Creator']).toBe(1)
  })

  it('still narrows by every OTHER facet', () => {
    // Kathmandu selected: Elite has 1 there, Creator has 1, Academy none.
    const counts = facetCountsOf(membership, ROWS, { district: ['Kathmandu'] })
    expect(counts['Elite']).toBe(1)
    expect(counts['Creator']).toBe(1)
    expect(counts['Academy']).toBe(0)
  })

  it('a count never exceeds what the other facets allow', () => {
    const counts = facetCountsOf(district, ROWS, { membership: ['Elite'] })
    expect(counts['Kathmandu']).toBe(1)
    expect(counts['Pokhara']).toBe(1)
    const total = Object.values(counts).reduce((a, b) => a + b, 0)
    expect(total).toBeLessThanOrEqual(ROWS.length)
  })
})

describe('derived options come from the rows', () => {
  it('offers only districts some client actually has — no dead controls', () => {
    expect(optionsOf(district, ROWS).map((o) => o.value)).toEqual(['Kathmandu', 'Pokhara'])
  })

  it('falls back to city when district is absent', () => {
    /* `district` is simply absent, not present-and-undefined —
       `exactOptionalPropertyTypes` makes those two different types, and the
       absent one is what a client with no district actually looks like. */
    const rows = [client({ city: 'Biratnagar' })]
    expect(optionsOf(district, rows).map((o) => o.value)).toEqual(['Biratnagar'])
  })

  it('declared options stay declared even at zero — "no Elite yet" is a fact', () => {
    expect(optionsOf(membership, [CREATOR_KTM]).map((o) => o.value)).toContain('Elite')
  })
})

describe('Law 6 — money facets never reach a money-blind role', () => {
  it('drops every money-shaped facet', () => {
    const blind = clientFacetsFor(false)
    expect(blind.some((f) => f.money)).toBe(false)
    expect(blind.find((f) => f.key === 'outstanding')).toBeUndefined()
    expect(blind.find((f) => f.key === 'deposit')).toBeUndefined()
  })

  it('keeps them for a money-visible role', () => {
    expect(clientFacetsFor(true).find((f) => f.key === 'outstanding')).toBeDefined()
  })

  it('every money-reading facet is flagged, so none can leak by omission', () => {
    // A facet whose predicate touches a paisa field MUST carry money: true.
    for (const f of CLIENT_FACETS) {
      const src = f.match.toString()
      if (/outstandingPaisa|depositHeldPaisa|creditLimitPaisa|creditUsedPaisa/.test(src)) {
        expect(f.money, `${f.key} reads money but is not flagged`).toBe(true)
      }
    }
  })
})

describe('outstanding buckets partition the range', () => {
  const outstanding = CLIENT_FACETS.find((f) => f.key === 'outstanding')!
  const rows = [
    client({ id: 'a', outstandingPaisa: rupees(0) }),
    client({ id: 'b', outstandingPaisa: rupees(49_999) }),
    client({ id: 'c', outstandingPaisa: rupees(120_000) }),
    client({ id: 'd', outstandingPaisa: rupees(500_000) }),
  ]

  it('puts every row in exactly one bucket', () => {
    for (const row of rows) {
      const hits = optionsOf(outstanding, rows).filter((o) => outstanding.match(row, o.value))
      expect(hits, `${row.id} landed in ${hits.length} buckets`).toHaveLength(1)
    }
  })

  it('counts add up to the row total', () => {
    const counts = facetCountsOf(outstanding, rows, {})
    expect(Object.values(counts).reduce((a, b) => a + b, 0)).toBe(rows.length)
  })
})

describe('selectionCount', () => {
  it('counts values, not facets', () => {
    expect(selectionCount({})).toBe(0)
    expect(selectionCount({ membership: ['Elite', 'Creator'], district: ['Kathmandu'] })).toBe(3)
  })
})
</file>

<file path="src/modules/clients/__tests__/clientsCopy.test.ts">
/**
 * **Clients — the copy guards.**
 *
 * Four of the five defects this suite pins were the same defect: a sentence on
 * a Clients screen that was true once, or never, and that nothing compared
 * against the thing it described. A label outran its query; a cap that had been
 * rescinded stayed in the prose in five places; a reason was invented to fill a
 * field that is always empty; a column header promised data the view does not
 * carry.
 *
 * Type-checking cannot catch any of that — every one of them compiled — so the
 * guard has to read the source as TEXT. That is the same technique
 * `lib/__tests__/breakpoints.test.ts` uses for the three files that cannot
 * import each other, and for the same reason: the alternative is hoping.
 *
 * `?raw` rather than `node:fs`: this project ships no `@types/node`, so
 * `readFileSync` fails `npm run typecheck`, which is a gate here. `?raw` is
 * typed by `vite/client` (src/vite-env.d.ts) and behaves identically under
 * vitest.
 */
import { describe, it, expect } from 'vitest'
import directorySrc from '../ClientsDirectory.tsx?raw'
import clientsSrc from '../Clients.tsx?raw'
import membershipSrc from '../Membership.tsx?raw'
import membershipData from '../../../data/membership.ts?raw'
import { PLANS, COMPARISON_ROWS, STACK_NOTE } from '../../../data/membership'

/**
 * A source file minus its comments. Every assertion below is about what the
 * SCREEN says, and the comments deliberately quote the wording they replaced —
 * without this, each fix would trip its own guard.
 */
function code(src: string): string {
  return src
    .replace(/\/\*[\s\S]*?\*\//g, '')
    .replace(/^[ \t]*\/\/.*$/gm, '')
}

const SCREENS: Array<[string, string]> = [
  ['ClientsDirectory.tsx', directorySrc],
  ['Clients.tsx', clientsSrc],
  ['Membership.tsx', membershipSrc],
  ['data/membership.ts', membershipData],
]

describe('CL-04 — the directory KPI is labelled with what it counts', () => {
  /*
   * `active_bookings_count` is
   *   count(*) filter (where b.stage <> 'Closed' and b.cancelled_at is null)
   * (0054_rls_backstops_and_directory_block_flag.sql:321), so it counts Quote,
   * Booked, Packed, On Rent AND Returned. "On Rent" was a claim about one of
   * those five.
   */
  it('renders no "On Rent" label over active_bookings_count', () => {
    const src = code(directorySrc)
    expect(src).not.toMatch(/label: 'On Rent'/)
    expect(src).not.toMatch(/label="On Rent"/)
    // The card and table cells both read `{client.currentRentalsCount} on rent`.
    expect(src).not.toMatch(/\bon rent\b/i)
  })

  it('states Open rentals on the KPI, chip and saved view', () => {
    const src = code(directorySrc)
    expect(src).toContain(`label: 'Open rentals',`)
    expect(src).toContain(`{ label: 'Open rentals', key: 'active', count: metrics.onRent }`)
    expect(src).toContain(`{ label: 'Open rentals', filter: 'active'`)
  })

  /*
   * The rule is that nothing MINTS `on-rent`, not that the string is absent.
   * A wire value outlives the build — it sits in bookmarks and pasted links —
   * so `LEGACY_FILTER_PARAM` still READS it and maps it to `active`. The first
   * version of this test asserted the string was gone from the file, which
   * would have been satisfied by silently unfiltering every old link: exactly
   * the quiet lie CL-04 was raised about.
   */
  it('no longer mints `on-rent`, but still understands a link that carries it', () => {
    const src = code(directorySrc)
    // FILTER_PARAM is the mint side: the chip must never produce it again.
    const mint = src.slice(src.indexOf('const FILTER_PARAM'), src.indexOf('const LEGACY_FILTER_PARAM'))
    expect(mint).not.toContain(`'on-rent'`)
    // The read side must keep it, pointed at the renamed filter.
    const legacy = src.slice(src.indexOf('const LEGACY_FILTER_PARAM'))
    expect(legacy).toContain(`'on-rent': 'active'`)
  })

  it('does not call the same figure "Current Rentals" in a header or an export', () => {
    expect(code(directorySrc)).not.toContain('Current Rentals')
    expect(code(clientsSrc)).not.toContain('Current Rentals')
  })
})

describe('CL-07 — the rescinded discount cap is gone from every surface', () => {
  /*
   * D3, Babin's final word 31 Aug 2026: "don't put any gate on discount."
   * Confirmed against the live schema, not the migration headers:
   * booking_discounts / invoices / invoice_lines each carry a 0..100
   * `*_percent_sane` CHECK and nothing narrower, and the deployed
   * `enforce_booking_discount_stacking()` raises only past a stacked 100.
   */
  it.each(SCREENS)('%s states no cap, ceiling or stacking limit', (_name, src) => {
    const body = code(src)
    expect(body).not.toMatch(/max cap/i)
    expect(body).not.toMatch(/capped at/i)
    expect(body).not.toMatch(/25\s*%/)
  })

  it('leaves the tier discount strings intact apart from the cap', () => {
    expect(PLANS.map((p) => p.discounts[0])).toEqual([
      '10% Individual discount',
      '15% Individual discount',
      '20% Individual discount',
      '20% Individual discount',
      '20% Individual discount',
    ])
  })

  it('keeps the comparison table reading a percentage out of those strings', () => {
    // `pick` splits on ' Individual'. Trimming the suffix must not have
    // orphaned the row into em dashes.
    const row = COMPARISON_ROWS.find((r) => r.label === 'Individual Discount')
    expect(row).toBeDefined()
    expect(PLANS.map((p) => row!.pick(p))).toEqual(['10%', '15%', '20%', '20%', '20%'])
  })

  it('replaces the cap with the exclusive-source rule that actually survives', () => {
    // 0074 KEPT the 0002 stacking matrix: Student / College / Named-client
    // rates stack with nothing. That is a rule, not a cap.
    expect(STACK_NOTE).toContain('Student')
    expect(STACK_NOTE).toContain('College')
    expect(STACK_NOTE).toContain('Named-client')
    expect(STACK_NOTE).not.toMatch(/cap/i)
    expect(STACK_NOTE).not.toMatch(/25/)
  })
})

describe('CL-11 — no invented block reason', () => {
  /*
   * `client_flags.reason` is a real column, but `client_directory_v` publishes
   * only `is_blocked` (31 columns, confirmed live), so `toClientRecord` leaves
   * `blockReason` absent — `clientsQuery.test.ts` asserts that separately.
   */
  it('never substitutes a sentence for a reason nobody recorded', () => {
    expect(code(directorySrc)).not.toContain('account under review')
  })

  it('reuses ClientDetail\'s wording rather than inventing a third', () => {
    expect(code(directorySrc)).toContain(
      'The reason is recorded on the flag but is not carried by this view.',
    )
  })
})

describe('CL-12 — nothing promises a company field the view has no column for', () => {
  it('does not advertise company in the search placeholder', () => {
    expect(code(directorySrc)).not.toMatch(/placeholder="[^"]*company/i)
  })

  it('emits no always-empty Company column in either CSV', () => {
    expect(code(directorySrc)).not.toContain(`'Company',`)
    expect(code(clientsSrc)).not.toContain(`'Company',`)
  })
})
</file>

<file path="src/modules/clients/__tests__/clientsQuery.test.ts">
/**
 * `lib/queries/clients.ts` — the three things this conversion added.
 *
 * ## Why this suite lives here and not in `src/lib/queries/__tests__/`
 *
 * That is where it belongs and where it should move. It is here because a
 * concurrent session is adding suites to that directory this session and a
 * `clients.test.ts` collision would have one of us silently overwrite the other.
 * `src/modules/clients/__tests__/` is this change's own assigned ground.
 *
 * ## What is pinned
 *
 * 1. **`is_blocked` reaches `ClientRecord.isBlocked`.** Migration 0054 added the
 *    column and 0054's own closing note asked for exactly this wiring. Until it
 *    landed, a blacklisted client rendered in the directory as an ordinary one —
 *    a false negative on a credit-control signal — and the "Blocked Balance" KPI
 *    counted nothing on every real record. The mapping is asserted in all three
 *    directions (true / false / null) because the FALSE case is the one that
 *    matters for `exactOptionalPropertyTypes`: an un-blocked client must have the
 *    key ABSENT, not present-and-false.
 *
 * 2. **`getClientRecord` addresses a client the way the app links to it.**
 *    Every `/clients/:id` link carries `client_code`, so a lookup by uuid could
 *    never resolve one. It must also return the uuid, because
 *    `invoicesForClient` and `bookings.client_id` take that and silently return
 *    zero rows for a code.
 *
 * 3. **`listMembershipPlans` reads the view, not the table, and keeps `null`.**
 *    `membership_plans_v` NULLs money for a money-blind session; a mapper that
 *    coalesced to 0 would state that the Elite tier extends no credit.
 *
 * The `supabase` module is replaced wholesale, exactly as `queries/__tests__/
 * finance.test.ts` and `bookings.test.ts` do. Nothing here reaches a database.
 */
import { beforeEach, describe, expect, it, vi } from 'vitest'

const db = vi.hoisted(() => {
  interface State {
    table: string
    columns: string
    calls: Array<[string, ...unknown[]]>
    rows: unknown[]
    single: unknown
    error: { message: string } | null
  }

  const state: State = { table: '', columns: '', calls: [], rows: [], single: null, error: null }

  function reset(): void {
    state.table = ''
    state.columns = ''
    state.calls = []
    state.rows = []
    state.single = null
    state.error = null
  }

  /** A recording stand-in for the postgrest builder. Thenable, because the query module `await`s the chain. */
  const builder = {
    select(columns: string) {
      state.columns = columns
      return builder
    },
    eq(column: string, value: unknown) {
      state.calls.push(['eq', column, value])
      return builder
    },
    is(column: string, value: unknown) {
      state.calls.push(['is', column, value])
      return builder
    },
    or(filters: string) {
      state.calls.push(['or', filters])
      return builder
    },
    order(column: string, options?: unknown) {
      state.calls.push(['order', column, options])
      return builder
    },
    limit(n: number) {
      state.calls.push(['limit', n])
      return builder
    },
    async maybeSingle() {
      state.calls.push(['maybeSingle'])
      return { data: state.single, error: state.error }
    },
    then(onFulfilled: (value: { data: unknown[] | null; error: { message: string } | null }) => unknown): void {
      onFulfilled({ data: state.rows, error: state.error })
    },
  }

  const supabase = {
    from(table: string) {
      state.table = table
      return builder
    },
  }

  return { state, reset, supabase }
})

vi.mock('../../../lib/supabase', () => ({
  supabase: db.supabase,
  newClientUuid: () => '00000000-0000-4000-8000-000000000000',
}))

const {
  toClientRecord,
  listClients,
  listClientRecords,
  getClientRecord,
  listMembershipPlans,
  UNJOINED_MEMBERSHIP_PLACEHOLDER,
} = await import('../../../lib/queries/clients')

/**
 * The health engine is imported here on purpose. The dangerous property of
 * `toClientRecord`'s credit-used placeholder is not visible inside this module —
 * it only becomes a defect where a safety check divides by it. Asserting the
 * mapper's output against the real engine is the only way to pin that the two
 * cannot drift back into agreement.
 */
const { clientHealth } = await import('../../rentals/booking/clientHealth')

beforeEach(() => {
  db.reset()
})

/** A complete `client_directory_v` row. Every field is overridable; nothing is optional in the view. */
function row(overrides: Record<string, unknown> = {}): Record<string, unknown> {
  return {
    id: '11111111-1111-4111-8111-111111111111',
    client_code: 'CL-2026-0001',
    name: 'Kathmandu Cinema Works',
    phone: '+977 9801234567',
    email: 'hello@kcw.example',
    address_line: 'Jhamsikhel',
    city: 'Lalitpur',
    district: 'Lalitpur',
    country: 'Nepal',
    status: 'Active',
    client_since: '2026-01-04',
    type_parent: 'Organisation',
    pan_vat: '123456789',
    approved_credit_limit: 500000,
    outstanding_amount: 124506,
    deposit_held_amount: 50000,
    total_paid_amount: 900000,
    active_bookings_count: 2,
    total_bookings_count: 14,
    last_pickup_at: null,
    contact_name: 'Sujan Rai',
    contact_designation: 'Producer',
    contact_phone: '+977 9807654321',
    membership_level: 'Elite',
    kyc_docs_count: 3,
    kyc_verified_count: 3,
    deactivated_at: null,
    is_blocked: false,
    ...overrides,
  }
}

const asRow = (o: Record<string, unknown>) => o as any

describe('toClientRecord — the block flag (migration 0054)', () => {
  it('sets isBlocked for a client carrying a live Blocked flag', () => {
    const record = toClientRecord(asRow(row({ is_blocked: true })))
    expect(record.isBlocked).toBe(true)
  })

  it('leaves the key ABSENT for an un-blocked client, never present-and-false', () => {
    const record = toClientRecord(asRow(row({ is_blocked: false })))
    expect('isBlocked' in record).toBe(false)
  })

  it('leaves the key absent when the view returns null', () => {
    const record = toClientRecord(asRow(row({ is_blocked: null })))
    expect('isBlocked' in record).toBe(false)
  })

  it('never invents a block reason — the view carries the boolean only', () => {
    const record = toClientRecord(asRow(row({ is_blocked: true })))
    expect('blockReason' in record).toBe(false)
  })

  it('still refuses to guess credit used — no column, no formula', () => {
    // Guards the field the Credit tab's removed "Utilised" KPI came from: if
    // this ever becomes `outstanding_amount`, that is a ruling, not a fix.
    const record = toClientRecord(asRow(row({ outstanding_amount: 124506 })))
    expect(record.creditUsedPaisa).toBe(0)
  })

  it('and that placeholder can no longer be read as "within the credit limit"', () => {
    // The pairing that made the 0 above dangerous. This record is a real client
    // with a Rs 500,000 approved limit; the 0 beside it is `ClientRecord`'s type
    // obligation, not a measurement. The old `clientHealth` divided one by the
    // other, got 0%, and returned Good — so converting New Booking from
    // `CLIENTS_DATA` to `listClientRecords` would have silently retired the
    // "Credit limit exceeded" blocker with no visible symptom.
    //
    // The check now reports itself unavailable and withholds the verdict.
    const record = toClientRecord(asRow(row({ approved_credit_limit: 500000 })))
    const verdict = clientHealth(record)
    expect(verdict.level).not.toBe('good')
    expect(verdict.reasons.map((r) => r.code)).toContain('credit-check-unavailable')
  })
})

describe('toClientRecord — membership, where the last fabricated value still lives', () => {
  it('passes a real tier through untouched', () => {
    expect(toClientRecord(asRow(row({ membership_level: 'Elite' }))).membership).toBe('Elite')
  })

  it('marks the substituted tier as a placeholder, not a client fact', () => {
    // ⚠ TODO(decision) — `MembershipTier` has no 'None', so a client with no
    // membership row still renders a tier badge they never bought. The value is
    // pinned by NAME rather than by the literal 'Academy': whichever member the
    // placeholder is, the point of this test is that it is the placeholder and
    // not something the database said. Delete this test when the ruling lands
    // and `membership` can be 'None'.
    const record = toClientRecord(asRow(row({ membership_level: null })))
    expect(record.membership).toBe(UNJOINED_MEMBERSHIP_PLACEHOLDER)
  })

  it('carries the truthful answer on ClientProfile, where the type can hold it', async () => {
    db.state.single = row({ membership_level: null })
    await expect(getClientRecord('CL-2026-0001')).resolves.toMatchObject({
      membershipKnown: false,
    })

    db.state.single = row({ membership_level: 'Elite' })
    await expect(getClientRecord('CL-2026-0001')).resolves.toMatchObject({
      membershipKnown: true,
    })
  })

  it('and on the narrow list row, as null rather than a substituted tier', async () => {
    db.state.rows = [row({ membership_level: null }), row({ membership_level: 'Elite' })]
    const items = await listClients()
    expect(items.map((i) => i.membershipLevel)).toEqual([null, 'Elite'])
  })
})

describe('listClientRecords — the select list', () => {
  it('asks the view for is_blocked exactly once', async () => {
    await listClientRecords()
    const tokens = db.state.columns.split(',').map((t) => t.trim())
    expect(tokens.filter((t) => t === 'is_blocked')).toHaveLength(1)
  })

  it('reads client_directory_v, never the clients table', async () => {
    await listClientRecords()
    expect(db.state.table).toBe('client_directory_v')
  })

  it('excludes deactivated clients rather than deleting them (Law 3)', async () => {
    await listClientRecords()
    expect(db.state.calls).toContainEqual(['is', 'deactivated_at', null])
  })
})

describe('getClientRecord', () => {
  it('looks a client_code up on client_code — the shape links from inside Clients carry', async () => {
    db.state.single = row()
    await getClientRecord('CL-2026-0001')
    expect(db.state.table).toBe('client_directory_v')
    expect(db.state.calls).toContainEqual(['eq', 'client_code', 'CL-2026-0001'])
  })

  /*
   * The regression this pair guards, fixed 4 Sep 2026.
   *
   * Eight links from OUTSIDE the clients module build `/clients/:id` from the
   * uuid FK they already hold (`RentalsList.tsx:1834`, `Payments.tsx:854`,
   * `OperationsQueues.tsx:791`, …), because `bookings.ts:341` and
   * `finance.ts:404` map `clientId: r.client_id`. Filtering those on
   * `client_code` could never match — `0055:136` pins the column to
   * `^C-[0-9]+$` — so every one of them rendered "Client not found".
   *
   * The old test asserted the code path and called it "the id every
   * /clients/:id link carries", which is why a P0 sat behind a green suite.
   */
  it('looks a uuid up on id — the shape links from outside Clients carry', async () => {
    db.state.single = row()
    await getClientRecord('11111111-1111-4111-8111-111111111111')
    expect(db.state.table).toBe('client_directory_v')
    expect(db.state.calls).toContainEqual(['eq', 'id', '11111111-1111-4111-8111-111111111111'])
    expect(db.state.calls.some((c) => c[1] === 'client_code')).toBe(false)
  })

  it('resolves a uuid to the same record a code resolves to', async () => {
    db.state.single = row()
    const byUuid = await getClientRecord('11111111-1111-4111-8111-111111111111')
    expect(byUuid?.record.id).toBe('CL-2026-0001')
  })

  it('returns the uuid alongside the record — per-client queries key on it, not on the code', async () => {
    db.state.single = row()
    const profile = await getClientRecord('CL-2026-0001')
    expect(profile?.id).toBe('11111111-1111-4111-8111-111111111111')
    // The record's own `id` stays the code, which is what the screen renders
    // and what every link is built from.
    expect(profile?.record.id).toBe('CL-2026-0001')
  })

  it('opens a closed account and reports the closure (Law 3 — retained and marked)', async () => {
    db.state.single = row({ deactivated_at: '2026-06-01T00:00:00Z' })
    const profile = await getClientRecord('CL-2026-0001')
    expect(profile?.deactivatedAtAd).toBe('2026-06-01T00:00:00Z')
    // Not filtered out: a link to a retained account must still resolve.
    expect(db.state.calls.some((c) => c[0] === 'is' && c[1] === 'deactivated_at')).toBe(false)
  })

  it('returns null for a code that matches nothing — a missing client is not an error', async () => {
    db.state.single = null
    await expect(getClientRecord('CL-2026-9999')).resolves.toBeNull()
  })

  it('throws a named failure when the read itself fails', async () => {
    db.state.error = { message: 'JWT expired' }
    await expect(getClientRecord('CL-2026-0001')).rejects.toThrow(/getClientRecord failed: JWT expired/)
  })
})

describe('listMembershipPlans', () => {
  const plan = (overrides: Record<string, unknown> = {}) => ({
    level: 'Elite',
    label: 'Elite',
    default_credit_limit: 500000,
    individual_discount_pct: 20,
    display_order: 5,
    status: 'Active',
    ...overrides,
  })

  it('reads membership_plans_v, never the base table — money is masked by the view', async () => {
    await listMembershipPlans()
    expect(db.state.table).toBe('membership_plans_v')
  })

  it('excludes retired plans and orders by the plan display order', async () => {
    await listMembershipPlans()
    expect(db.state.calls).toContainEqual(['eq', 'status', 'Active'])
    expect(db.state.calls).toContainEqual(['order', 'display_order', { ascending: true }])
  })

  it('converts the default credit limit from rupees to paisa', async () => {
    db.state.rows = [plan({ default_credit_limit: 2500 })]
    const [first] = await listMembershipPlans()
    expect(first?.defaultCreditLimit).toBe(250000)
  })

  it('keeps a withheld money figure as null rather than collapsing it to zero', async () => {
    db.state.rows = [plan({ default_credit_limit: null, individual_discount_pct: null })]
    const [first] = await listMembershipPlans()
    expect(first?.defaultCreditLimit).toBeNull()
    expect(first?.individualDiscountPct).toBeNull()
  })

  it('drops a row with no level rather than rendering an unnamed tier', async () => {
    db.state.rows = [plan(), plan({ level: null })]
    await expect(listMembershipPlans()).resolves.toHaveLength(1)
  })

  it('falls back to the level when the view returns no label', async () => {
    db.state.rows = [plan({ label: null })]
    const [first] = await listMembershipPlans()
    expect(first?.label).toBe('Elite')
  })

  it('throws a named failure when the read fails', async () => {
    db.state.error = { message: 'permission denied' }
    await expect(listMembershipPlans()).rejects.toThrow(/listMembershipPlans failed: permission denied/)
  })
})
