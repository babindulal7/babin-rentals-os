            yPercent: -4,
            opacity: 0.35,
            filter: 'blur(2px)',
            transformOrigin: 'top center',
            ease: 'none',
            scrollTrigger: { trigger: card, start: 'top 10%', end: '+=480', scrub: true },
          })
        })
      })

      return () => mm.revert()
    },
    { scope: root },
  )

