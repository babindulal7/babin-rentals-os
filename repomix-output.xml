.operations-v2__table tbody tr.operations-v2__row--cursor { outline: 2px solid var(--focus-ring, var(--primary)); outline-offset: -2px; }

/* Why Confirm is disabled, in the footer beside it rather than far down the page. */
.operations-shell__blocked { margin: 0; font-size: var(--t-meta); color: var(--text2); overflow-wrap: anywhere; }

/* RULING 2026-10-14 (R14-10). Phone: the four stage steps share ONE row (icon over name over state) instead of a 2×2 grid of
   three-line buttons, and the Booking / Client cells — already in the sheet title — drop out, so the
   first screen reaches the equipment instead of ending in chrome. State stays as text + icon. */
.operations-shell__stage-name { font-weight: 600; }
@media (max-width: 767px) {
  .operations-shell__stages { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .operations-shell__stages .ui-button { flex-direction: column; justify-content: flex-start; gap: 2px; padding: 6px 2px !important; min-height: 44px; }
  .operations-shell__stages .ui-button__label { text-align: center; line-height: 1.15; max-width: 100%; overflow: hidden; }
  .operations-shell__stage-name { display: block; font-size: 11.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .operations-shell__stage-sep { display: none; }
  .operations-shell__stage-state { display: block; font-size: 10.5px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .operations-shell__strip-dup { display: none; }
}
@media (max-width: 359px) {
  .operations-shell__stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

/* RULING 2026-10-14 (R14-11). Tablet and up, full-screen sheet: the "still needed" hint sits BETWEEN the two buttons on one
   row instead of above them — a whole line of height back for the checklist. The dock keeps its
   stacked footer (it is too narrow for three things in a row). Phones keep the stacked footer. */
@media (min-width: 768px) {
  .app-modal .operations-shell__footer { flex-direction: row !important; align-items: center; gap: 12px !important; }
  .app-modal .operations-shell__actions { display: contents; }
  .app-modal .operations-shell__actions > :first-child { order: 0; }
  .app-modal .operations-shell__blocked { order: 1; flex: 1 1 0; min-width: 0; text-align: center; }
  .app-modal .operations-shell__actions > :last-child { order: 2; }
}

/* Short tablets (landscape): the four stage steps are one line each, so they do not need the
   padding that keeps them comfortable when their labels wrap. They stay ≥ 44px. */
@media (min-width: 768px) and (max-height: 860px) {
  .operations-shell__stages .ui-button { padding-top: 4px !important; padding-bottom: 4px !important; }
}


/* RULING 2026-10-16: one consistent four-step navigator for every rental operation. */
.operations-shell__stages {
  padding: 8px;
  gap: 8px;
  border: 1px solid var(--border);
  border-radius: var(--r-card);
  background: var(--surface);
}

.operations-shell__stages .operations-shell__stage {
  min-height: 64px;
  border-radius: var(--r-input);
}

.operations-shell__stage .ui-button__label {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 3px;
}

.operations-shell__stage-sep { display: none; }
.operations-shell__stage-name { font-size: var(--t-ui); }
.operations-shell__stage-state { font-size: var(--t-th); font-weight: 500; }

@media (max-width: 767px) {
  .operations-shell__stages { padding: 6px; gap: 4px; }
  .operations-shell__stage .ui-button__label { align-items: center; }
  .operations-shell__stage-name { font-size: var(--t-th); }
}
