      label: 'Registered Sequences',
      value: known && list.total !== null ? String(list.total) : known ? String(list.rows.length) : '—',
      icon: 'file',
      accent: 'primary',
      note: 'One per document kind',
    },
    {
      label: 'Year-less',
      value: known ? String(yearless) : '—',
      icon: 'check',
      accent: 'success',
      note: 'Continuous counter — never resets',
    },
