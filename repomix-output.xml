    --color-ready: #d4a824;
    --color-ready-text: #d4a824;
    --color-on-ready: #1c1405;

    --color-neutral: #3a3e47;
    --color-neutral-text: #c9cbd1;
    --color-on-neutral: #c9cbd1;

    --color-dim: #24262c;
    --color-dim-text: #8b8e96;
    --color-on-dim: #8b8e96;

    --color-text: #f1f5f9;
    --color-text-2: #94a3b8;
    --color-muted: #8b8e96;
    --color-disabled: #475569;
  }
}

/* High contrast theme */
@media (prefers-contrast: more) {
  :root {
    --color-bg: #0a0a0a;
    --color-surface: #0a0a0a;
    --color-border: #facc15;
    --color-text: #ffffff;
    --color-primary: #facc15;
    --color-on-primary: #000000;
