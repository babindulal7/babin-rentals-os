                          </th>
                          <th style={{ ...th, textAlign: 'right' }} scope="col">
                            Original Rate
                            <span style={{ display: 'block', ...subtle, fontWeight: 400 }}>per day</span>
                          </th>
                          <th style={th} scope="col">
                            Discount
                          </th>
                          <th style={{ ...th, textAlign: 'right' }} scope="col">
                            Bundle Rate
                            <span style={{ display: 'block', ...subtle, fontWeight: 400 }}>per day</span>
                          </th>
                          {/* §6.2 — new, and the reason the summary could not be checked by eye. */}
