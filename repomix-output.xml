        <h2 style={{ margin: 0, fontSize: 'var(--t-ui)', fontWeight: 700, color: 'var(--text)', letterSpacing: '-0.01em' }}>{title}</h2>
        {action && <span style={{ marginLeft: 'auto', display: 'flex', gap: 8, alignItems: 'center' }}>{action}</span>}
      </div>
