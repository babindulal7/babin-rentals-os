                    <span style={{ fontSize: 'var(--t-meta)', fontWeight: 700, color: on ? 'var(--nav-active-accent)' : 'var(--text)' }}>{t.label}</span>
                    <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)', lineHeight: 1.4 }}>{t.blurb}</span>
