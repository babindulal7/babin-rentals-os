/**
 * BundleQuickBuilder — Fast equipment package & discount calculator.
 *
 * Ported from the standalone's bundle builder (script_1.js:6886-6906).
 * Selects gear, applies a package bundle discount %, and computes
 * combined daily rental rates for quotation.
 */
import { useState, useMemo } from 'react'
import { Card } from '../../components/ui/Page'
import { Button } from '../../components/ui/Button'
import { formatMoney, rupees } from '../../lib/money'
import { useToast } from '../../components/ui/Toast'

interface CatalogItem {
  key: string
  name: string
  cat: string
  rate: number
}

const CATALOG: CatalogItem[] = [
  { key: 'fx3', name: 'Sony FX3 Body', cat: 'Cameras', rate: 6500 },
  { key: 'fx6', name: 'Sony FX6 Cinema', cat: 'Cameras', rate: 9500 },
  { key: 'nisi', name: 'NiSi Athena Prime 5-Lens Set', cat: 'Lenses', rate: 12000 },
  { key: 'sigma', name: 'Sigma 18-35 T2 Cine', cat: 'Lenses', rate: 2500 },
  { key: 'ap600', name: 'Aputure 600x Pro Light', cat: 'Lighting', rate: 4500 },
  { key: 'mc', name: 'Aputure MC Pro 4-Kit', cat: 'Lighting', rate: 1500 },
  { key: 'rs4', name: 'DJI RS4 Pro Gimbal', cat: 'Grip', rate: 2500 },
  { key: 'mkh', name: 'Sennheiser MKH 416 Boom', cat: 'Audio', rate: 1800 },
  { key: 'batt', name: '99Wh V-Mount Battery Set (x2)', cat: 'Power', rate: 1200 },
  { key: 'atomos', name: 'Atomos Ninja V+ Recorder', cat: 'Monitoring', rate: 2200 },
]

export default function BundleQuickBuilder() {
  const { showSuccessToast } = useToast()
  const [bundleName, setBundleName] = useState('Documentary Shoot Kit')
  const [selectedKeys, setSelectedKeys] = useState<Record<string, boolean>>({
    fx3: true,
    nisi: true,
    rs4: true,
  })
  const [discountPct, setDiscountPct] = useState(15)

  const chosenItems = useMemo(() => {
    return CATALOG.filter((item) => selectedKeys[item.key])
  }, [selectedKeys])

  const totals = useMemo(() => {
    const sum = chosenItems.reduce((acc, it) => acc + it.rate, 0)
    const disc = Math.round((sum * discountPct) / 100)
    const rate = sum - disc
    return { sum, disc, rate }
  }, [chosenItems, discountPct])

  const toggleItem = (k: string) => {
    setSelectedKeys((prev) => ({ ...prev, [k]: !prev[k] }))
  }

  const handleSave = () => {
    if (chosenItems.length === 0) return
    showSuccessToast(`“${bundleName}” bundle configured — ${chosenItems.length} items at ${formatMoney(rupees(totals.rate))}/day`)
  }

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
      <div style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
        Build custom equipment packages with combined package discounts.
        Bundling simplifies check-out, protects profit margins, and provides clients with predictable per-day shoot costs.
      </div>

      {/* Bundle Name & Discount */}
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))', gap: '16px' }}>
        <div>
          <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text2)' }}>Kit / Bundle Name</label>
          <input
            type="text"
            value={bundleName}
            onChange={(e) => setBundleName(e.target.value)}
            style={{
              width: '100%',
              padding: '8px 12px',
              borderRadius: '8px',
              border: '1px solid var(--border)',
              background: 'var(--surface)',
              color: 'var(--text)',
              marginTop: '4px',
              fontSize: '14px',
            }}
          />
        </div>

        <div>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
            <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text2)' }}>
              Package Discount: {discountPct}%
            </label>
          </div>
          <input
            type="range"
            min="0"
            max="40"
            step="5"
            value={discountPct}
            onChange={(e) => setDiscountPct(Number(e.target.value))}
            style={{ width: '100%', marginTop: '12px' }}
          />
        </div>
      </div>

      {/* Equipment Selector */}
      <div>
        <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: '8px' }}>
          Select Equipment for this Bundle
        </label>
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(240px, 1fr))', gap: '8px' }}>
          {CATALOG.map((item) => {
            const isSelected = !!selectedKeys[item.key]
            return (
              <div
                key={item.key}
                onClick={() => toggleItem(item.key)}
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  padding: '10px 12px',
                  borderRadius: '8px',
                  border: `1px solid ${isSelected ? 'var(--info)' : 'var(--border)'}`,
                  boxShadow: isSelected ? '0 0 0 1px var(--info)' : 'none',
                  background: isSelected ? 'rgba(47, 125, 255, 0.08)' : 'var(--surface)',
                  cursor: 'pointer',
                  transition: 'all 0.15s',
                }}
              >
                <div>
                  <div style={{ fontWeight: 600, fontSize: '13px', color: 'var(--text)' }}>{item.name}</div>
                  <div style={{ fontSize: '11px', color: 'var(--text3)' }}>{item.cat}</div>
                </div>
                <div style={{ textAlign: 'right' }}>
                  <div style={{ fontWeight: 600, fontSize: '13px', color: 'var(--text)' }}>
                    {formatMoney(rupees(item.rate))}
                  </div>
                  <div style={{ fontSize: '10px', color: 'var(--text3)' }}>/day</div>
                </div>
              </div>
            )
          })}
        </div>
      </div>

      {/* Summary Card */}
      <Card>
        <div style={{ padding: '16px', display: 'flex', flexDirection: 'column', gap: '10px' }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 'var(--t-meta)' }}>
            <span style={{ color: 'var(--text2)' }}>Individual Items Sum ({chosenItems.length} items):</span>
            <span style={{ fontWeight: 600 }}>{formatMoney(rupees(totals.sum))}</span>
          </div>

          <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 'var(--t-meta)', color: 'var(--green)' }}>
            <span>Bundle Package Savings ({discountPct}%):</span>
            <span style={{ fontWeight: 600 }}>-{formatMoney(rupees(totals.disc))}</span>
          </div>

          <div style={{ borderTop: '1px solid var(--border)', paddingTop: '10px', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
            <div>
              <div style={{ fontSize: '15px', fontWeight: 700, color: 'var(--text)' }}>Package Day-Rate:</div>
              <div style={{ fontSize: '11px', color: 'var(--text3)' }}>Inclusive of all selected package equipment</div>
            </div>
            <span style={{ fontSize: '22px', fontWeight: 700, color: 'var(--green)' }}>
              {formatMoney(rupees(totals.rate))}<span style={{ fontSize: '12px', fontWeight: 500, color: 'var(--text3)' }}>/day</span>
            </span>
          </div>

          <div style={{ display: 'flex', justifyContent: 'flex-end', marginTop: '6px' }}>
            <Button variant="primary" onClick={handleSave} disabled={chosenItems.length === 0}>
              Save Bundle Configuration
            </Button>
          </div>
        </div>
      </Card>
    </div>
  )
}
</file>

<file path="src/styles/responsive.css">
/* ============================================================================
   RESPONSIVE LAYER — DESIGN_DIRECTION_SPEC_v4.1 §7.7
   "No screen carries its own responsive code; BP 768/1280."

   This file is the ONLY place a layout @media query may live. A screen that
   needs to change shape at a breakpoint uses a class from here; it does not
   write its own query, and it does not invent a third threshold.

   ── The numbers are duplicated on purpose, and guarded ──────────────────────
   CSS cannot import TypeScript. `lib/breakpoints.ts` holds 768/1280 for the
   JS side and this file mirrors them for the CSS side. That duplication is
   unavoidable, so it is TESTED rather than trusted:
   `lib/__tests__/breakpoints.test.ts` parses this file and fails if the two
   ever disagree. Change a number here and the test tells you what else moves.

   ── Why not utility classes for everything ─────────────────────────────────
   These are LAYOUT primitives, not a utility framework. The app styles with
   inline `style={{}}` + CSS variables (see theme.css); Tailwind classes in
   this codebase historically compiled to nothing, which is why Badge/Input
   were rewritten. So this file stays small and structural: the handful of
   shape changes the spec actually names, and nothing that a token already does.
   ========================================================================== */

/* ── The band attribute ──────────────────────────────────────────────────────
   `index.html` stamps `data-vp="phone|tablet|desktop"` on <html> BEFORE first
   paint, from the same 768/1280 pair. That lets a rule branch on the band
   without a media query — useful where a component must know the band in a
   selector that also depends on state — and, more importantly, means the
   correct layout paints on load instead of flashing desktop first.

   The media queries below remain authoritative for pure-layout rules, because
   they keep working if JS never runs. The attribute is an enhancement, not the
   mechanism. */

/* ── Escape hatch, deliberately narrow ───────────────────────────────────────
   `.no-shrink` opts an element out of every stacking rule below. It exists so
   a genuine exception (a signature pad, a barcode canvas) has a sanctioned way
   to say so instead of a screen writing its own @media. If you reach for this
   more than a couple of times, the rule below is wrong — fix the rule. */
.no-shrink {
  --rsp-opt-out: 1;
}

/* ══ PHONE — below 768 ══════════════════════════════════════════════════════
   §16 of CLAUDE.md: do not simply shrink the desktop interface. Below 768 the
   decisions are what disappears, what stacks, and what becomes a sheet. */
@media (max-width: 767px) {
  .page-header__copy,
  .page-header__actions {
    flex-basis: 100%;
  }

  .page-header__actions {
    justify-content: flex-start;
    margin-left: 0;
  }

  .surface-card__header {
    align-items: flex-start !important;
    flex-wrap: wrap;
  }

  .kpi-tile__label {
    display: -webkit-box !important;
    min-height: 2.7em;
    white-space: normal !important;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .footer-note {
    align-items: flex-start !important;
    gap: 6px 10px !important;
  }

  .footer-note > span {
    flex-basis: calc(100% - 24px);
  }

  .footer-note > span:last-child {
    margin-left: 24px !important;
  }

  .data-table {
    min-width: max(100%, 42rem);
  }

  /* A wide table below 768 is not a table — it is a horizontal scrollbar
     hiding the columns that matter. `useTabularLayout()` already returns false
     here so screens can render card rows instead; this is the CSS backstop for
     any table that slips through, so it scrolls inside its own box rather than
     pushing the whole page sideways. §7.7's "the page body must never scroll
     horizontally". */
  .rsp-table-scroll:not(.no-shrink) {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
  }

  /* Multi-column content collapses to one column. */
  .rsp-cols:not(.no-shrink) {
    display: block;
  }
  .rsp-cols:not(.no-shrink) > * + * {
    margin-top: var(--sp-lg);
  }

  /* A row of actions becomes a full-width stack — a 3-up button row at 390px
     produces three targets under 44px wide, which §7.3 forbids. */
  .rsp-actions:not(.no-shrink) {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--sp-sm);
  }
  .rsp-actions:not(.no-shrink) > * {
    width: 100%;
    min-height: var(--tap);
  }

  /* Things that carry no information the row does not already repeat. */
  .rsp-hide-phone {
    display: none !important;
  }

  /* Side rails become part of the flow rather than a column. */
  .rsp-aside:not(.no-shrink) {
    position: static;
    width: 100%;
    max-width: none;
  }

  /* Prevent iOS WebKit involuntary viewport zoom on input focus.
     Inputs with font-size < 16px cause iOS Safari to zoom the whole layout. */
  input:not([type='checkbox']):not([type='radio']),
  select,
  textarea {
    font-size: 16px !important;
  }

  /* Smooth touch horizontal chip bar scrolling without desktop scrollbar clutter */
  .rsp-chip-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .rsp-chip-scroll::-webkit-scrollbar {
    display: none;
  }
}

/* ══ TABLET — 768 to 1279 ══════════════════════════════════════════════════
   The band that matters most here: a rental floor runs on tablets, and 1194
   (iPad Pro 11" landscape) lives in this band ONLY because v4.1 moved the
   desktop threshold to 1280. Under the old 1180 it fell into desktop and got
   hover-dependent, mouse-sized UI. */
@media (min-width: 768px) and (max-width: 1279px) {
  .rsp-hide-tablet {
    display: none !important;
  }

  /* Three-up grids fit two across at this width; forcing three produces
     columns too narrow to read a client name in. */
  .rsp-cols-3:not(.no-shrink) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* ══ BELOW DESKTOP — anything under 1280 ═══════════════════════════════════ */
@media (max-width: 1279px) {
  :root { --page-padding: clamp(12px, 1.4vw, 16px); --app-panel-width: 300px; }

  .page-toolbar__actions { margin-left: 0; }
  .app-page-toolbar__end { margin-left: 0; }

  .rsp-hide-below-desktop {
    display: none !important;
  }

  /* Table horizontal scroll wrapper on tablet and phone to prevent clipping */
  .rsp-table-scroll:not(.no-shrink) {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
  }
}

@media (max-width: 767px) {
  :root { --page-padding: var(--space-3); --global-header-height: 64px; }
}

/* ══ DESKTOP — 1280 and up ═════════════════════════════════════════════════ */
@media (min-width: 1280px) {
  .rsp-only-phone,
  .rsp-only-tablet {
    display: none !important;
  }
}

/* ══ COARSE POINTER — capability, not size ═════════════════════════════════
   A 24" touchscreen at the packing bench is desktop-SIZED but finger-DRIVEN.
   §7.3's 44px is a rule about thumbs, so it keys off the pointer, not the
   width. This is exactly the size-vs-capability split `device.ts` documents. */
@media (pointer: coarse) {
  /* `.rsp-tap` lived here and was wrong twice — see `.tap` in theme.css, which
     replaces it. It was scoped to (pointer: coarse) when §5/§7.3 say 44px on
     EVERY device including desktop, and it carried `pointer-events: none`,
     which makes a pseudo-element decorative: clicks pass straight through it,
     so the "grown" hit area was never clickable. The law is not a responsive
     concern, so it does not belong in this file at all. */

  /* Hover-only affordances must not be the only way to reach something when
     there is no hover to give. Screens pair this with a long-press or an
     always-visible control; the class only stops the hover-reveal from being
     the mechanism. */
  .rsp-hover-only {
    opacity: 1 !important;
    visibility: visible !important;
  }
}

/* ══ NO HOVER ══════════════════════════════════════════════════════════════ */
@media (hover: none) {
  .rsp-hover-lift:hover {
    transform: none;
  }
}
</file>

