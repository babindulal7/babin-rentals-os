/**
 * **Settings — the atoms every section is built from.**
 *
 * `11_SETTINGS.md`'s closing note: *"Settings is currently one 2,502-line file;
 * these eight sections are the split."* This is the part of that file that is
 * genuinely shared — the row, the destination control, the KPI card, the edit
 * plumbing — extracted once so eight section files can be read on their own.
 *
 * Nothing here is new behaviour. The `Dest` three-case rule, the `Not built`
 * marker, the read-only reason on a product law and the money-blind removals
 * are all carried across unchanged from the single file.
 */

/* ── style atoms ───────────────────────────────────────────────────────── */

/*
 * §7.3's row floor ("rows >= 56px") for every Settings section table, written
 * with the token rather than as padding arithmetic: `height` on a `<td>`
 * behaves as a MINIMUM, so short rows rise to the floor while the two-line
 * cells and the nested expander rows keep the height they compute.
 *
 * This is the fix `BranchesWarehouses.tsx` flagged and deliberately declined to
 * force from inside itself — see the note on its branch-disclosure control,
 * which reads: "These rows pitch at about 39px, short of the §7.3 'rows >= 56'
 * floor, so this target and the one in the row below overlap in a band of
 * roughly 5px and the lower row wins it. Raising the row height is the fix and
 * it belongs to `td`, which several screens share." This is that `td`, so the
 * fix lands here.
 *
 * It is a data-integrity line, not a density preference: below 56 a 44px hit
 * area cannot fit inside its own row, so it spills over the boundary, and an
 * absolutely-positioned target wins the hit test — meaning the row LATER in the
 * DOM answers a tap aimed at the row above it. On a branch list whose row
 * controls open, edit and deactivate a branch, that is the wrong branch acted
 * on, not a cosmetic wobble.
 */
export const td: CSSProperties = {
  height: 'var(--row-min-h)',
  padding: '10px',
  fontSize: 'var(--t-meta)',
  color: 'var(--text)',
  verticalAlign: 'middle',
  borderBottom: '1px solid var(--border)',
}

export const controlStyle: CSSProperties = {
  display: 'inline-flex',
  alignItems: 'center',
  gap: 5,
  /* ⚠ Law 15 / v4.1 §5 — NOT SATISFIED BY THIS OBJECT ALONE.

     This comment used to read "the tap area is grown with padding rather than
     the border box". It is not: `padding: '0 12px'` is HORIZONTAL only, so the
     vertical tap area is exactly the 32px below. The technique described was
     real, but was never applied on the axis that mattered — the comment
     asserted a compliance the code did not deliver, which is worse than no
     comment, because an audit reading it moves on.

     The paint genuinely should stay ~32: these are pagination arrows, section
     nav chips and "See all" links in dense settings strips, and most call sites
     already override this height downward anyway. So the fix is the one §5
     names — grow the HIT AREA, not the box — which an inline style object
     cannot express, because it needs a pseudo-element.

     Every consumer must therefore also carry `className="tap"` (theme.css).
     Where a consumer already composes a className, append it. */
  minHeight: 32,
  padding: '0 12px',
  borderRadius: 'var(--r-btn)',
  border: '1px solid var(--border)',
  background: 'var(--card)',
  color: 'var(--text)',
  fontSize: 'var(--t-meta)',
  fontWeight: 600,
  textDecoration: 'none',
  fontFamily: 'inherit',
  cursor: 'pointer',
  flexShrink: 0,
}

export const linkStyle: CSSProperties = {
  marginTop: 9,
  alignSelf: 'flex-start',
  display: 'inline-flex',
  alignItems: 'center',
  gap: 'var(--sp-xs)',
  border: 'none',
  background: 'transparent',
  padding: 0,
  fontFamily: 'inherit',
  fontSize: 'var(--t-th)',
  fontWeight: 700,
  color: 'var(--link)',
  textDecoration: 'none',
  cursor: 'pointer',
}

/** The rail's shortcut tiles. Same shape as the Overview's Quick Access. */
export const quickTileStyle: CSSProperties = {
  display: 'flex',
  flexDirection: 'column',
  alignItems: 'center',
  justifyContent: 'center',
  gap: 6,
  minHeight: 70,
  padding: '10px 6px',
  borderRadius: 'var(--r-card)',
  border: '1px solid var(--border)',
  background: 'var(--card2)',
  color: 'var(--text)',
  fontSize: 'var(--t-th)',
  fontWeight: 600,
  textAlign: 'center',
  textDecoration: 'none',
  fontFamily: 'inherit',
  cursor: 'pointer',
}

export function ToneChip({ tone, icon, children }: { tone: StatusKey; icon: IconName; children: ReactNode }) {
  const t = STATUS[tone]
  return (
    <span
      style={{
        display: 'inline-flex',
        alignItems: 'center',
        gap: 'var(--sp-xs)',
        padding: '2px 8px',
        borderRadius: 'var(--r-badge)',
        background: t.bg,
        color: t.fg,
        border: t.border ? `1px solid ${t.border}` : '1px solid transparent',
        fontSize: 'var(--t-th)',
        fontWeight: 700,
        whiteSpace: 'nowrap',
      }}
    >
      {/* Law 11 — colour is never the sole carrier. Icon + label, always. */}
      <Icon name={icon} size={12} fill />
      {children}
    </span>
  )
}

/** Single-hue progress bar. Length encodes the figure; colour encodes nothing. */
export function Meter({ percent, tone = 'success' }: { percent: number; tone?: BrandKey }) {
  const width = Math.max(0, Math.min(100, percent))
  return (
    <span
      role="img"
      aria-label={`${width}% utilization`}
      style={{ display: 'block', height: 6, borderRadius: 'var(--r-badge)', background: 'var(--divider)', overflow: 'hidden' }}
    >
      <span style={{ display: 'block', width: `${width}%`, height: '100%', background: BRAND[tone] }} />
    </span>
  )
}

/* ── navigation between sections ───────────────────────────────────────── */

export const GoTab = createContext<(tab: TabKey) => void>(() => {})

/** The tab set this session can actually reach — Law 6 removes, never disables. */
export const VisibleTabs = createContext<readonly TabDef[]>([])

/**
 * PLAN.md §0 — *no dead controls*. One component renders all three cases a
 * `Dest` can be, so an unbuilt destination is physically unable to render as a
 * live-looking control: it comes out visibly inert with its reason attached.
 */
export function DestControl({
  dest,
  children,
  style,
  className,
  ariaLabel,
}: {
  dest: Dest
  children: ReactNode
  style: CSSProperties
  /**
   * Forwarded to the two LIVE cases only. It exists because of `tap`
   * (theme.css): a caller handing us `controlStyle` is handing us a 32px paint,
   * and Law 15 wants a 44px hit area under it — which no inline style object
   * can express, because the technique is a pseudo-element.
   *
   * The `none` case deliberately refuses it. That branch is an inert
   * `aria-disabled` span: there is nothing to hit, so a 44px invisible region
   * around it buys the operator nothing and costs something real — it reaches
   * across the gap and shadows whichever live control happens to sit beside it.
   */
  className?: string
  ariaLabel?: string
}) {
  const go = useContext(GoTab)

  if (dest.kind === 'route') {
    return (
      <Link
        to={dest.to}
        style={style}
        {...(className ? { className } : {})}
        {...(ariaLabel ? { 'aria-label': ariaLabel } : {})}
      >
        {children}
      </Link>
    )
  }
  if (dest.kind === 'tab') {
    return (
      <button
        type="button"
        onClick={() => go(dest.tab)}
        style={style}
        {...(className ? { className } : {})}
        {...(ariaLabel ? { 'aria-label': ariaLabel } : {})}
      >
        {children}
      </button>
    )
  }
  return (
    <span
      aria-disabled="true"
      title={dest.why}
      style={{ ...style, cursor: 'not-allowed', color: 'var(--muted)', background: 'transparent', borderStyle: 'dashed' }}
    >
      {children}
    </span>
  )
}

/**
 * Drops rows whose destination this session cannot reach.
 *
 * Law 6 removes the Financial tab for a money-blind session; every row still
 * pointing at it would then be a control that lands the operator back on
 * Overview. Removed for the same reason the tab is: a disabled money control is
 * still a money control.
 */
export function useVisible<T extends { dest: Dest }>(rows: readonly T[]): T[] {
  const tabs = useContext(VisibleTabs)
  return rows.filter((r) => isDestVisible(r.dest, tabs))
}

/** The trailing marker on an inert row — states *that* it is unbuilt; `title` states why. */
export function NotBuilt({ why }: { why: string }) {
  return (
    <span
      title={why}
      style={{
        fontSize: 'var(--t-th)',
        fontWeight: 600,
        color: 'var(--muted)',
        border: '1px dashed var(--border)',
        borderRadius: 'var(--r-badge)',
        padding: '1px 6px',
        whiteSpace: 'nowrap',
      }}
    >
      Not built
    </span>
  )
}

/**
 * A panel with no source behind it. **Never a zero, never a plausible
 * default** — Rulings §8: *"A report with no data source shows 'not tracked
 * yet', never zeros."* The reason is on the page, not in a tooltip.
 */
export function NotTrackedYet({ title, why }: { title: string; why: string }) {
  return (
    <div
      style={{
        display: 'flex',
        alignItems: 'flex-start',
        gap: 'var(--sp-sm)',
        padding: 'var(--sp-md)',
        borderRadius: 'var(--r-card)',
        border: '1px dashed var(--border)',
        background: 'var(--card2)',
      }}
    >
      <Icon name="info" size={15} style={{ color: 'var(--muted)', flexShrink: 0, marginTop: 2 }} />
      <span style={{ minWidth: 0 }}>
        <span style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)', flexWrap: 'wrap' }}>
          <span style={{ fontSize: 'var(--t-meta)', fontWeight: 700, color: 'var(--text)' }}>{title}</span>
          <ToneChip tone="neutral" icon="timer">
            Not tracked yet
          </ToneChip>
