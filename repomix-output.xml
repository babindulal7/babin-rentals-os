  { id: 'u14', category: 'Rig', name: 'Top Handle', serial: 'SN-RIG-002', required: false, location: 'E1-01', needsClean: true, needsReset: false, assignedTo: 'Bikash Thapa', waitingMinutes: 10, evidence: 0 },
