              <LabelledInput
                label="Security deposit"
                value={deposit}
                onChange={setDeposit}
                numeric
                placeholder="Rs"
                hint={/* Law 5 — a liability. It is shown separately below and never enters the rental total. */ "— a liability. It is shown separately below and never enters the rental total."}
              />
            </div>
          </Card>
        </div>

        {/* ── the ladder ─────────────────────────────────────────────────── */}
        <div
          style={{
