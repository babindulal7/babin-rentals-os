            </div>
            <div style={{ fontSize: '20px', fontWeight: 700, color: stats.urgentCount > 0 ? 'var(--warn-text)' : 'var(--text)', fontFamily: 'var(--font-mono, monospace)', fontVariantNumeric: 'tabular-nums' }}>
              {stats.urgentCount}
