                      <span>
                        <span style={{ color: 'var(--muted)', display: 'block' }}>PAN</span>
                        <span className="figure" style={{ color: 'var(--text)' }}>{selectedClient.pan ?? 'Not on file'}</span>
                      </span>
                    </>
                  )}
