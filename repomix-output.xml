<file path="src/actions/maintenance/completeMaintenance.ts">
import { createAction, type ActionContext, type ActionConfig } from '../core';
import { EVENT_TYPES } from '../../events/eventBus';
import { safeUpdate, generateClientUuid } from '../../lib/dataAccess';
import { supabase } from '../../lib/supabase';

export type CompleteMaintenanceInput = {
  /** `maintenance_records.id` (UUID) or `record_no` (e.g. 'MNT-2026-0001'). */
  id: string;
  clientUuid?: string;
  findings?: string;
  actionsTaken?: string;
  cost?: number;
  completedAt?: string;
  status?: 'Completed' | 'Cancelled';
};

export type CompleteMaintenanceResult = {
  success: boolean;
  id: string;
  recordNo: string;
  status: string;
};

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

export const completeMaintenanceConfig: ActionConfig<CompleteMaintenanceInput, CompleteMaintenanceResult> = {
  name: 'COMPLETE_MAINTENANCE',
  permissions: ['maintenance.complete'],
  implemented: true,

  validate: (input) => {
    if (!input.id || !input.id.trim()) {
      throw new Error('ID is required to complete maintenance.');
    }
    if (input.cost !== undefined && input.cost < 0) {
      throw new Error('Cost cannot be negative.');
    }
  },

  execute: async (input, ctx: ActionContext) => {
    const rawId = input.id.trim();
    let resolvedId = rawId;
    let recordNo = rawId;

    if (UUID_RE.test(rawId)) {
      const { data, error } = await supabase
        .from('maintenance_records_v')
        .select('id, record_no, status')
        .eq('id', rawId)
        .maybeSingle();

      if (error || !data) {
        throw new Error(`Could not find maintenance record with ID: ${rawId}`);
      }
      resolvedId = data.id;
      recordNo = data.record_no;
    } else {
      const { data, error } = await supabase
        .from('maintenance_records_v')
        .select('id, record_no, status')
        .eq('record_no', rawId)
        .maybeSingle();

      if (error || !data) {
        throw new Error(`Could not find maintenance record with record number: ${rawId}`);
      }
      resolvedId = data.id;
      recordNo = data.record_no;
    }

    const actionUuid = input.clientUuid || generateClientUuid();
    const finalStatus = input.status || 'Completed';
    const completedAt = input.completedAt || new Date().toISOString();

    const patch: Record<string, unknown> = {
      status: finalStatus,
      completed_at: completedAt,
      updated_at: new Date().toISOString(),
      updated_by: ctx.userId,
    };

    if (input.findings !== undefined) {
      patch.findings = input.findings.trim() || null;
    }
    if (input.actionsTaken !== undefined) {
      patch.actions_taken = input.actionsTaken.trim() || null;
    }
    if (input.cost !== undefined) {
      patch.cost = Number(input.cost);
    }

    // Law 6: returnRow: false prevents 42501 permission error on revoked money column 'cost'
    await safeUpdate('maintenance_records' as never, resolvedId, patch as never, actionUuid, {
      returnRow: false,
    });

    const events = [
      {
        type: EVENT_TYPES.MAINTENANCE_COMPLETED,
        payload: {
          id: resolvedId,
          recordNo,
          status: finalStatus,
          completedAt,
          timestamp: new Date().toISOString(),
          userId: ctx.userId,
        },
      },
    ];

    return {
      result: {
        success: true,
        id: resolvedId,
        recordNo,
        status: finalStatus,
      },
      events,
    };
  },
};

export const completeMaintenance = createAction<CompleteMaintenanceInput, CompleteMaintenanceResult>(completeMaintenanceConfig);
</file>

<file path="src/actions/maintenance/createMaintenanceJob.ts">
import { createAction, type ActionContext, type ActionConfig } from '../core';
import { EVENT_TYPES } from '../../events/eventBus';
import { idempotentInsert, generateClientUuid } from '../../lib/dataAccess';
import { supabase } from '../../lib/supabase';
import { getBusinessToday } from '../../lib/bs';

export type CreateMaintenanceJobInput = {
  /** Optional client-side idempotency UUID (Law 8). */
  clientUuid?: string | undefined;
  /** `product_units.id` (UUID). */
  productUnitId?: string | undefined;
  /** Or serial number (e.g. 'SN-001') to resolve to product_unit_id */
  serialNo?: string | undefined;
  /** 'Preventive Service' | 'Repair' | 'Calibration' | 'Routine Inspection' (default: 'Preventive Service') */
  maintenanceType?: string | undefined;
  /** 'Normal' | 'Urgent' | 'Low' (default: 'Normal') */
  priority?: string | undefined;
  /** 'Scheduled' | 'In Progress' (default: 'Scheduled') */
  status?: string | undefined;
  /** Detailed description of required work */
  description: string;
  /** Scheduled date in YYYY-MM-DD (defaults to current_date) */
  scheduledDate?: string | undefined;
  /** Optional vendor or service partner name */
  vendorName?: string | undefined;
  /** Estimated or actual cost in rupees (numeric(14,2)) */
  cost?: number | undefined;
  /** User UUID of technician assigned */
  performedBy?: string | undefined;
  /** Custom record number (e.g. 'MNT-2026-0001') */
  recordNo?: string | undefined;
};

export type CreateMaintenanceJobResult = {
  success: boolean;
  id: string;
  recordNo: string;
};

export const createMaintenanceJobConfig: ActionConfig<CreateMaintenanceJobInput, CreateMaintenanceJobResult> = {
  name: 'CREATE_MAINTENANCE_JOB',
  permissions: ['maintenance.create'],
  implemented: true,

  validate: (input) => {
    if (!input.description || !input.description.trim()) {
      throw new Error('Description is required for maintenance job.');
    }
    if (!input.productUnitId && !input.serialNo) {
      throw new Error('Either productUnitId or serialNo is required to identify the equipment unit.');
    }
    if (input.cost !== undefined && input.cost < 0) {
      throw new Error('Cost cannot be negative.');
    }
  },

  execute: async (input, ctx: ActionContext) => {
    let resolvedUnitId = input.productUnitId;
    let serialNumber = input.serialNo;

    // Resolve productUnitId if only serialNo was passed
    if (!resolvedUnitId && input.serialNo) {
      const { data: unit, error: unitError } = await supabase
        .from('product_units')
        .select('id, serial_number')
        .or(`serial_number.eq.${input.serialNo},unit_code.eq.${input.serialNo}`)
        .maybeSingle();

      if (unitError || !unit) {
        throw new Error(`Could not find equipment unit with serial/code: ${input.serialNo}`);
      }
      resolvedUnitId = unit.id;
      serialNumber = unit.serial_number ?? input.serialNo;
    }

    if (!resolvedUnitId) {
      throw new Error('Equipment unit id could not be resolved.');
    }

    // Generate record_no if not provided
    let recordNo = input.recordNo?.trim();
    if (!recordNo) {
      const today = getBusinessToday();
      const year = today.getFullYear();
      const { count } = await supabase
        .from('maintenance_records')
        .select('*', { count: 'exact', head: true });
      const nextSeq = (count ?? 0) + 1;
      recordNo = `MNT-${year}-${String(nextSeq).padStart(4, '0')}`;
    }

    const clientUuid = input.clientUuid || generateClientUuid();
    const maintenanceType = input.maintenanceType || 'Preventive Service';
    const priority = input.priority || 'Normal';
    const status = input.status || 'Scheduled';
    const scheduledDate = input.scheduledDate || getBusinessToday().toISOString().slice(0, 10);

    const row = {
      client_uuid: clientUuid,
      record_no: recordNo,
      product_unit_id: resolvedUnitId,
      maintenance_type: maintenanceType,
      priority,
      status,
      description: input.description.trim(),
      scheduled_date: scheduledDate,
      vendor_name: input.vendorName ? input.vendorName.trim() : null,
      cost: input.cost !== undefined ? Number(input.cost) : 0,
      performed_by: input.performedBy || null,
      created_by: ctx.userId,
    };

    // Law 6: return explicit granted columns, avoiding revoked 'cost' echo
    const inserted = await idempotentInsert('maintenance_records' as never, row as never, {
      returningColumns: 'id, record_no, status, product_unit_id',
    });

    const insertedId = (inserted as { id?: string })?.id || clientUuid;

    const events = [
      {
        type: EVENT_TYPES.MAINTENANCE_STARTED,
        payload: {
          id: insertedId,
          recordNo,
          productUnitId: resolvedUnitId,
          serialNo: serialNumber,
          type: maintenanceType,
          priority,
          status,
          timestamp: new Date().toISOString(),
          userId: ctx.userId,
        },
      },
    ];

    return {
      result: {
        success: true,
        id: insertedId,
        recordNo,
      },
      events,
    };
  },
};

export const createMaintenanceJob = createAction<CreateMaintenanceJobInput, CreateMaintenanceJobResult>(createMaintenanceJobConfig);
</file>

<file path="src/actions/notes/__tests__/addBookingNote.test.ts">
/**
 * ADD_BOOKING_NOTE — what this suite pins.
 *
 * `booking_notes` shipped in 0002 and sat writer-less until the Booking
 * Detail rework; this action is its first writer, so the pins are the seams
 * a later edit would most plausibly break:
 *
 *  1. **The write lands in `booking_notes`** with exactly the columns the
 *     table wants — `client_uuid` (Law 8), `booking_id` (the uuid, never the
 *     booking number), `note_type`, trimmed `body`, `created_by` = the actor.
 *  2. **The gate is `note.create` → `canWriteBookingDesk`** — the §4.20
 *     mirror of `booking_notes_all`. Warehouse writes; Accounts is refused
 *     BEFORE anything observable happens.
 *  3. **`'History'` is refused by name** — the enum's system-written member,
 *     never an operator's to type.
 *  4. **Law 8 is enforced, not decorative** — no key, no send; a duplicate
 *     key comes back as "nothing was written twice", not a second row.
 *  5. **A queued write is not a success** — a payload echoed back without a
 *     database-issued `id` must be reported as unconfirmed.
 *
 * Seam mocked: `lib/dataAccess` only. The dispatcher (permissions, validate,
 * event emission) runs for real.
 */
import { describe, it, expect, beforeEach, vi } from 'vitest'
import { ActionPermissionError } from '../../core'
import type { AddBookingNoteInput } from '../addBookingNote'

const access = vi.hoisted(() => ({
  inserts: [] as Array<{ table: string; payload: Record<string, unknown> }>,
  insertResult: { data: {} as unknown, error: null as unknown },
  insertThrows: null as string | null,
}))

vi.mock('../../../lib/dataAccess', () => ({
  idempotentInsert: async (table: string, payload: Record<string, unknown>) => {
    access.inserts.push({ table, payload })
    if (access.insertThrows) throw new Error(access.insertThrows)
    return access.insertResult
  },
}))

const { addBookingNote } = await import('../addBookingNote')

const WAREHOUSE = { userId: 'usr-warehouse', role: 'Warehouse' as const }
const ACCOUNTS = { userId: 'usr-accounts', role: 'Accounts' as const }

const BOOKING_ID = '11111111-2222-4333-8444-555555555555'
const KEY = 'aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee'

const input = (over: Partial<AddBookingNoteInput> = {}): AddBookingNoteInput => ({
  bookingId: BOOKING_ID,
  noteType: 'Booking',
  body: 'Client will collect from the side entrance.',
  clientUuid: KEY,
  ...over,
})

beforeEach(() => {
  access.inserts = []
  access.insertResult = { data: { id: 'note-uuid-1' }, error: null }
  access.insertThrows = null
})

describe('the write', () => {
  it('lands in booking_notes with the columns the table wants, and reports the row Postgres issued', async () => {
    const res = await addBookingNote(input({ body: '  Client will collect early.  ' }), WAREHOUSE)

    expect(access.inserts).toHaveLength(1)
    const sent = access.inserts[0]!
    expect(sent.table).toBe('booking_notes')
    expect(sent.payload).toEqual({
      client_uuid: KEY,
      booking_id: BOOKING_ID,
      note_type: 'Booking',
      body: 'Client will collect early.',
      created_by: 'usr-warehouse',
    })
    expect(res.noteId).toBe('note-uuid-1')
    expect(res.noteType).toBe('Booking')
  })

  it('writes Internal when asked — the print exclusion is the view’s job, not a reason to refuse the row', async () => {
    await addBookingNote(input({ noteType: 'Internal' }), WAREHOUSE)
    expect(access.inserts[0]!.payload['note_type']).toBe('Internal')
  })
})

describe('the gate — §4.20 mirror of booking_notes_all', () => {
  it('refuses Accounts before anything observable happens', async () => {
    await expect(addBookingNote(input(), ACCOUNTS)).rejects.toBeInstanceOf(ActionPermissionError)
    expect(access.inserts).toHaveLength(0)
  })

  it('refuses a call without a session context', async () => {
    await expect(addBookingNote(input())).rejects.toThrow(/session context/)
    expect(access.inserts).toHaveLength(0)
  })
})

describe('what may be written', () => {
  it('refuses History by name — a hand-typed trail entry is a fabricated trail', async () => {
    await expect(
      addBookingNote(input({ noteType: 'History' as unknown as 'Booking' }), WAREHOUSE),
    ).rejects.toThrow(/History/)
    expect(access.inserts).toHaveLength(0)
  })

  it('refuses an empty note', async () => {
    await expect(addBookingNote(input({ body: '   ' }), WAREHOUSE)).rejects.toThrow(/empty note/)
    expect(access.inserts).toHaveLength(0)
  })
})

describe('Law 8', () => {
  it('refuses to send without an idempotency key', async () => {
    await expect(addBookingNote(input({ clientUuid: undefined }), WAREHOUSE)).rejects.toThrow(/idempotency/)
    expect(access.inserts).toHaveLength(0)
  })

  it('a replay resolves as SUCCESS with the first press’s noteId — the real seam never throws the 23505', async () => {
    /* `idempotentInsert` intercepts the client_uuid 23505 internally and
       returns the row the FIRST press committed (dataAccess.ts:134-144) —
       this models that contract: same key in, same row back, no error. */
    access.insertResult = { data: { id: 'note-uuid-1' }, error: null }
    const first = await addBookingNote(input(), WAREHOUSE)
    const replay = await addBookingNote(input(), WAREHOUSE)
    expect(replay.noteId).toBe(first.noteId)
    expect(access.inserts).toHaveLength(2) // both sends carry the SAME key…
    expect(access.inserts[0]!.payload['client_uuid']).toBe(KEY)
    expect(access.inserts[1]!.payload['client_uuid']).toBe(KEY) // …and dataAccess dedupes on it
  })

  it('surfaces the errors dataAccess DOES re-throw (an FK, here) with the named sentence', async () => {
    access.insertThrows =
      '[DataAccess] Insert failed on booking_notes: insert or update violates foreign key constraint "booking_notes_created_by_fkey"'
    await expect(addBookingNote(input(), WAREHOUSE)).rejects.toThrow(/no row in the users table/)
  })
})

describe('a queued write is not a success', () => {
  it('reports unconfirmed when the payload comes back without a database id', async () => {
    /* dataAccess's queue branches echo the SENT payload, which has no id. */
    access.insertResult = { data: { client_uuid: KEY, booking_id: BOOKING_ID }, error: null }
    await expect(addBookingNote(input(), WAREHOUSE)).rejects.toThrow(/queued rather than written/)
  })

  it('reports the database error rather than pretending', async () => {
    access.insertResult = { data: null, error: { message: 'permission denied for table booking_notes' } }
    await expect(addBookingNote(input(), WAREHOUSE)).rejects.toThrow(/treat it as not saved/)
  })
})
</file>

