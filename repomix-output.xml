const CATALOGUES: Record<Language, Partial<Record<StringKey, string>>> = { en: EN, ne: NE }

/**
 * Looks up a string, falling back to English.
 *
 * The fallback is silent by design: a half-translated screen should read as
 * English where the translation is missing, not as `[[missing:nav.today]]`. The
 * measurement of how much is missing belongs to `coverage()`, not to the text
 * an operator is trying to work with.
 */
export function t(key: StringKey, lang: Language): string {
  return CATALOGUES[lang][key] ?? EN[key]
}

export interface Coverage {
  translated: number
  total: number
  percent: number
  missing: StringKey[]
}

/** How much of the app a language actually covers. The gap, measured. */
export function coverage(lang: Language): Coverage {
  const keys = Object.keys(EN) as StringKey[]
  const cat = CATALOGUES[lang]
  const missing = keys.filter((k) => cat[k] === undefined)
  const translated = keys.length - missing.length
  return {
    translated,
    total: keys.length,
    percent: keys.length === 0 ? 100 : Math.round((translated / keys.length) * 100),
    missing,
  }
}

/**
 * Whether a language may be offered to users at all.
 *
 * A toggle that produces a screen half in each language is worse than a toggle
 * that is honestly absent — the operator cannot tell a missing translation from
 * a deliberate English term, and the Settings row already says so out loud.
 *
 * English is always enabled. Everything else has to earn it.
 */
export const COVERAGE_THRESHOLD = 100

export function canEnable(lang: Language): boolean {
  if (lang === 'en') return true
  return coverage(lang).percent >= COVERAGE_THRESHOLD
}

/**
 * The Devanagari faces the NE toggle needs, and which of them exist.
 *
 * `main.tsx` §4.3.7 keeps Asar and Hind out of the eager bundle because each
 * Hind weight is 1,146 glyphs an English-only user must never download, and
 * says "they load on the NE toggle". This is the other half of that decision —
 * except that **neither package is installed**, so there is nothing to lazy-load
 * yet.
 *
 * This deliberately does not `import('@fontsource/hind/400.css')`. Vite
 * resolves dynamic imports at build time, so importing a package that is not a
 * dependency breaks the build for everyone in order to half-support a language
 * that is at 0% coverage. Naming the requirement is more useful than a broken
 * import wrapped in a `.catch`.
 */
export const NEPALI_FONT_PACKAGES = ['@fontsource/asar', '@fontsource/hind'] as const

export interface FontAvailability {
  available: boolean
  missing: readonly string[]
  reason: string
}

export function nepaliFontStatus(): FontAvailability {
  return {
    available: true,
    missing: [],
    reason: /* Asar 400 and Hind 400/600 load on the NE toggle — never eagerly, per §4.3.7. */ "Asar 400 and Hind 400/600 load on the NE toggle — never eagerly, per",
  }
}

let nepaliFontsLoaded = false

/**
 * Loads the Devanagari faces, once, on the toggle.
 *
 * §4.3.7 is the constraint: each Hind weight carries 1,146 glyphs, mostly
 * Devanagari conjuncts, and an English-only user must never download them. So
 * this imports the **per-subset** files rather than the barrel — `400.css`
 * would pull latin, latin-ext and devanagari together.
 *
 * Only the weights the app can actually ask for are fetched: Asar has one, and
 * `safeWeight` clamps body text to 400/600 in practice, so pulling all five
 * Hind weights would be downloading three nobody renders.
 */
export async function loadNepaliFonts(): Promise<void> {
  if (nepaliFontsLoaded) return
  nepaliFontsLoaded = true
  await Promise.all([
    import('@fontsource/asar/devanagari-400.css'),
    import('@fontsource/asar/latin-400.css'),
    import('@fontsource/hind/devanagari-400.css'),
    import('@fontsource/hind/latin-400.css'),
    import('@fontsource/hind/devanagari-600.css'),
    import('@fontsource/hind/latin-600.css'),
  ])
}

/** Test seam — resets the once-only latch. */
export function resetFontLoadingForTest(): void {
  nepaliFontsLoaded = false
}

/**
 * Puts a language into effect on the document.
 *
 * `theme.css` already declares `--font-ne-display` (Asar) and `--font-ne-body`
 * (Hind) beside the English pair, so this **swaps the two variables every
 * component already reads** rather than introducing a parallel font system.
 * `FONT_STACK` above stays as the typed description of the same fact.
 *
 * Sets `<html lang>` too, which is not decoration: it is what a screen reader
 * switches voice on, and what the browser uses to pick a fallback face when
 * Hind has not arrived yet.
 */
export async function applyLanguage(lang: Language): Promise<void> {
  if (typeof document === 'undefined') return
  const root = document.documentElement
  root.setAttribute('lang', lang === 'ne' ? 'ne' : 'en')

  if (lang === 'ne') {
    /* Fonts first, then the swap — setting the family before the face has
       arrived flashes a fallback that is usually the wrong script entirely. */
    await loadNepaliFonts()
    root.style.setProperty('--font-display', 'var(--font-ne-display)')
    root.style.setProperty('--font-body', 'var(--font-ne-body)')
  } else {
    /* Removing the override restores whatever the theme declares, which is
       what a later theme change should be free to move. */
    root.style.removeProperty('--font-display')
    root.style.removeProperty('--font-body')
  }
  if (typeof window !== 'undefined') {
    window.dispatchEvent(new CustomEvent('languagechange', { detail: { lang } }))
  }
}

import { useState, useEffect } from 'react'

/** Synchronously checks active document language. */
export function getCurrentLanguage(): Language {
  if (typeof document !== 'undefined') {
    const docLang = document.documentElement.getAttribute('lang')
    if (docLang === 'ne') return 'ne'
  }
  if (typeof window !== 'undefined') {
    const stored = window.localStorage.getItem('br.settings.language')
    if (stored === 'नेपाली') return 'ne'
  }
  return 'en'
}

/** Reactive hook for components that adapt their typography or preset labels to the active language. */
export function useCurrentLanguage(): Language {
  const [lang, setLang] = useState<Language>(() => getCurrentLanguage())

  useEffect(() => {
    const handler = () => {
      setLang(getCurrentLanguage())
    }
    window.addEventListener('languagechange', handler)
    window.addEventListener('storage', handler)
    return () => {
      window.removeEventListener('languagechange', handler)
      window.removeEventListener('storage', handler)
    }
  }, [])

  return lang
}

/** Toggles between English and Nepali, persisting to settings and applying fonts immediately. */
export async function toggleLanguage(): Promise<Language> {
  const current = getCurrentLanguage()
  const next: Language = current === 'en' ? 'ne' : 'en'
  const nextLabel = next === 'ne' ? 'नेपाली' : 'English'
  if (typeof window !== 'undefined') {
    try {
      window.localStorage.setItem('br.settings.language', nextLabel)
    } catch {
      /* ignore */
    }
  }
  await applyLanguage(next)
  return next
}
</file>

<file path="src/lib/kitBuildVerification.ts">
/**
 * # Kit-Build Verification Engine — Outbound Cinema Checklist & Dependency Guard
 *
 * Law 1: Pages never implement business logic. Ten engines own it (`src/lib/`).
 *
 * Implements cinema kit completeness verification before dispatch.
 * Prevents missing cables, unverified media, uncertified power, and missing
 * gimbal plates from leaving the warehouse and causing field shoot failure.
 */

export type KitCategory =
  | 'cinema_camera'
  | 'gimbal'
  | 'wireless_video'
  | 'lighting'
  | 'audio'
  | 'general'

export interface KitDependencyCheck {
  id: string
  label: string
  description: string
  critical: boolean
}

export function detectKitCategory(productName: string): KitCategory {
  const lower = productName.toLowerCase()
  if (
    lower.includes('alexa') ||
    lower.includes('komodo') ||
    lower.includes('raptor') ||
    lower.includes('fx3') ||
    lower.includes('fx6') ||
    lower.includes('fx9') ||
    lower.includes('burano') ||
    lower.includes('red ') ||
    lower.includes('cinema camera') ||
    lower.includes('c70') ||
    lower.includes('c300')
  ) {
    return 'cinema_camera'
  }
  if (lower.includes('ronin') || lower.includes('rs3') || lower.includes('rs4') || lower.includes('gimbal')) {
    return 'gimbal'
  }
  if (
    lower.includes('teradek') ||
    lower.includes('accsoon') ||
    lower.includes('hollyland') ||
    lower.includes('mars ') ||
    lower.includes('wireless video') ||
    lower.includes('transmitter') ||
    lower.includes('receiver')
  ) {
    return 'wireless_video'
  }
  if (
    lower.includes('aputure') ||
    lower.includes('nanlite') ||
    lower.includes('600x') ||
    lower.includes('300d') ||
    lower.includes('light dome')
  ) {
    return 'lighting'
  }
  if (
    lower.includes('mic') ||
    lower.includes('sound devices') ||
    lower.includes('zoom h') ||
    lower.includes('wireless go') ||
    lower.includes('sennheiser')
  ) {
    return 'audio'
  }
  return 'general'
}

export function getCinemaKitDependencies(productName: string): KitDependencyCheck[] {
  const cat = detectKitCategory(productName)
  switch (cat) {
    case 'cinema_camera':
      return [
        {
          id: 'media',
          label: 'Media Card & Reader',
          description: 'CFexpress Type B / CFast 2.0 / SD V90 card + USB-C card reader',
          critical: true,
        },
        {
          id: 'power',
          label: 'Power Solution & V-Mount',
          description: 'V-Mount plate / BP-U batteries + D-Tap power cable & charger',
          critical: true,
        },
        {
          id: 'mount',
          label: 'Mount Adapter / Body Cap',
          description: 'PL/EF/E mount adapter, front sensor body cap & 15mm baseplate',
          critical: true,
        },
        {
          id: 'cables',
          label: 'Monitor & Video Cables',
          description: 'Right-angle 12G-SDI / Micro-HDMI to Full HDMI braided cable',
          critical: false,
        },
      ]
    case 'gimbal':
      return [
        {
          id: 'plate',
          label: 'Quick Release Plate & Screws',
          description: 'Arca-Swiss / Manfrotto quick release plate + 1/4" & 3/8" screws',
          critical: true,
        },
        {
          id: 'focus_motor',
          label: 'Focus Motor & Rod Mount',
          description: 'DJI Focus motor, 12mm/15mm rod, gear strip & USB-C control cable',
          critical: false,
        },
        {
          id: 'briefcase',
          label: 'Handle & Counterweights',
          description: 'Briefcase handle, tripod feet & roll axis counterweight set',
          critical: false,
        },
      ]
    case 'wireless_video':
      return [
        {
          id: 'antennas',
          label: 'TX & RX Antennas (Pair)',
          description: 'Check antenna threads. Never power TX without antennas attached',
          critical: true,
        },
        {
          id: 'patch_cables',
          label: 'SDI & HDMI Patch Cables',
          description: 'Thin high-flex SDI / HDMI patch leads tested on bench monitor',
          critical: true,
        },
        {
          id: 'power_cable',
          label: 'D-Tap / LEMO Power Lead',
          description: 'D-Tap to 2-pin LEMO or NP-F battery plate with locking barrel',
          critical: false,
        },
      ]
    case 'lighting':
      return [
        {
          id: 'cstand_sandbag',
          label: 'C-Stand + Sandbag (Safety)',
          description: 'Heavy duty C-stand with grip head + 10kg sandbag counterweight',
          critical: true,
        },
        {
          id: 'ballast_power',
          label: 'Control Box & Head Cable',
          description: 'High-voltage head cable, Neutrik powerCON cable & clamp',
          critical: true,
        },
      ]
    case 'audio':
      return [
        {
          id: 'adapters',
          label: '3.5mm TRS / XLR Patch Cable',
          description: 'Camera audio patch lead + locking 3.5mm screw-in connectors',
          critical: true,
        },
        {
          id: 'wind_protection',
          label: 'Deadcat / Windshield',
          description: 'Acoustic furry wind muff + magnetic clip mounts',
          critical: false,
        },
      ]
    default:
      return []
  }
}

export interface KitEvaluationItem {
  key: string
  name: string
  category: KitCategory
  dependencies: KitDependencyCheck[]
  verifiedDependencyIds: string[]
}

export interface KitEvaluationResult {
  hasCinemaGear: boolean
  totalDependencies: number
  verifiedCount: number
  allCriticalPassed: boolean
  unverifiedCriticalItems: Array<{ itemName: string; dependencyLabel: string }>
}

export function evaluateKitCompleteness(
  items: Array<{
    key: string
    name: string
    verifiedDependencyIds?: string[] | undefined
  }>,
): KitEvaluationResult {
  const evaluated: KitEvaluationItem[] = items.map((item) => {
    const category = detectKitCategory(item.name)
    const dependencies = getCinemaKitDependencies(item.name)
    return {
      key: item.key,
      name: item.name,
      category,
      dependencies,
      verifiedDependencyIds: item.verifiedDependencyIds ?? [],
    }
  })

  const cinemaItems = evaluated.filter((i) => i.dependencies.length > 0)
  const hasCinemaGear = cinemaItems.length > 0

  let totalDependencies = 0
  let verifiedCount = 0
  const unverifiedCriticalItems: Array<{ itemName: string; dependencyLabel: string }> = []

  for (const item of cinemaItems) {
    for (const dep of item.dependencies) {
      totalDependencies += 1
      const isVerified = item.verifiedDependencyIds.includes(dep.id)
      if (isVerified) {
        verifiedCount += 1
      } else if (dep.critical) {
        unverifiedCriticalItems.push({
          itemName: item.name,
          dependencyLabel: dep.label,
        })
      }
    }
  }

  return {
    hasCinemaGear,
    totalDependencies,
    verifiedCount,
    allCriticalPassed: unverifiedCriticalItems.length === 0,
    unverifiedCriticalItems,
  }
}
