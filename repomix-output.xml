import { cloneElement, isValidElement, useId, type CSSProperties, type ReactElement, type ReactNode } from 'react';
import Icon from '../../../components/ui/Icon';
import type { IconName } from '../../../components/ui/Icon';
import { cardStyle } from '../../../components/ui/Page';
import { Badge } from '../../../components/ui/Badge';
import { InfoTooltip } from '../../../components/ui/InfoTooltip';
import type { StatusKey } from '../../../lib/status';
import { CONDITION_TONE } from '../../../lib/queries/inventory';
import { toBs, formatBs, formatAd } from '../../../lib/bs';
import { NEXT_ASSET_CODE, type IntakeCondition } from '../../../lib/queries/addEquipment';

export const inputStyle = (hasError?: boolean): CSSProperties => ({
  width: '100%',
  minHeight: 44,
  padding: '0 10px',
  borderRadius: 'var(--r-input)',
  border: `1px solid ${hasError ? 'var(--danger-text)' : 'var(--input-border)'}`,
  background: 'var(--input-bg)',
  color: 'var(--text)',
  fontSize: 'var(--t-meta)',
  fontFamily: 'inherit',
})

export const fieldRow: CSSProperties = {
  display: 'grid',
  gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))',
  gap: 14,
}

export function Field({
  label,
  id: propId,
  required,
  error,
  hint,
  children,
  span,
}: {
  label: string
  id?: string | undefined
  required?: boolean
  error?: string | null | undefined
  hint?: string | undefined
  children: ReactNode
  span?: number | undefined
}) {
  const autoId = useId()
  const fieldId = propId || autoId

  let content = children
  if (isValidElement(children)) {
    const childProps = children.props as Record<string, unknown>
    if (!childProps.id && !childProps['aria-label'] && !childProps.label) {
      content = cloneElement(children as ReactElement<Record<string, unknown>>, {
        id: fieldId,
        'aria-label': label,
      })
    }
  }

  return (
    <div
      style={{
        display: 'flex',
        flexDirection: 'column',
        gap: 5,
        minWidth: 0,
        ...(span ? { gridColumn: `span ${span}` } : {}),
      }}
    >
      <div style={{ display: 'flex', alignItems: 'center', gap: 4 }}>
        <label htmlFor={fieldId} style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text2)' }}>
          {label} {required && <span style={{ color: 'var(--danger-text)' }}>*</span>}
        </label>
        {hint && <InfoTooltip content={hint} />}
      </div>
      {content}
      {error ? (
        <span style={{ display: 'flex', alignItems: 'flex-start', gap: 'var(--sp-xs)', fontSize: 'var(--t-th)', color: 'var(--danger-text)' }}>
          <Icon name="error" size={12} style={{ flexShrink: 0, marginTop: 1 }} />
          {error}
        </span>
      ) : null}
    </div>
  )
}

export function SectionCard({
  id,
  n,
  title,
  note,
  action,
  children,
}: {
  id: string
  n: number
  title: string
  note?: string
  action?: ReactNode
  children: ReactNode
}) {
  return (
    <section id={id} style={{ ...cardStyle, display: 'flex', flexDirection: 'column', minWidth: 0, scrollMarginTop: 84 }}>
      <div style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '12px 14px', borderBottom: '1px solid var(--border)', flexWrap: 'wrap' }}>
        <span
          style={{
            width: 22,
            height: 22,
            borderRadius: '50%',
            background: 'var(--btn-primary-bg)',
            color: 'var(--btn-primary-fg)',
            display: 'grid',
            placeItems: 'center',
            fontSize: 'var(--t-th)',
            fontWeight: 700,
            flexShrink: 0,
          }}
        >
          {n}
        </span>
        <div style={{ minWidth: 0, display: 'flex', alignItems: 'center', gap: 6 }}>
          <h2 style={{ margin: 0, fontSize: 'var(--t-ui)', fontWeight: 700, color: 'var(--text)' }}>{title}</h2>
          {note && <InfoTooltip content={note} />}
        </div>
        {action && <div style={{ marginLeft: 'auto', display: 'flex', alignItems: 'center', gap: 6, flexWrap: 'wrap' }}>{action}</div>}
      </div>
      <div style={{ padding: 14, display: 'flex', flexDirection: 'column', gap: 14 }}>{children}</div>
    </section>
  )
}

/**
 * §5.4 — the intake condition, badged with the tone Inventory already uses.
 *
 * Delegates to `<Badge>` — DESIGN_DIRECTION_SPEC_v4.1 §8 step 2: "one
 * component rendering the §4 map from lib/status; every screen inherits. No
 * screen colours a status itself."
 *
 * This was the third hand-rolled copy of the same chip (the other two are in
 * `Inventory.tsx`), and like them it reached for `--r-badge` — the 999 pill
 * §3.3 reserves for numeric COUNT badges — at weight 600 in sentence case.
 * It also carried `border: 1px solid ${c.border ?? 'transparent'}`, a branch
 * that exists so the ONE tone with a border (`ext`, the gold mark) can draw
 * it; no condition maps to `ext`, so the branch could only ever emit
 * `transparent`. `<Badge>` owns that decision now.
 *
 * The wrapper is kept because the two files disagree on their input type —
 * this one takes `IntakeCondition` (Add Equipment's intake vocabulary) where
 * Inventory's takes `Condition | null` — and that is exactly the kind of local
 * fact a shared component should not have to know.
 */
export function ConditionBadge({ condition }: { condition: IntakeCondition }) {
  return <Badge tone={CONDITION_TONE[condition] as StatusKey} label={condition} size="sm" />
}

/**
 * §5.3 — status renders as a badge, never a control, and while the record is a
 * Draft the units have no status at all. So the cell states that instead of
 * inventing `Available` the way the render does.
 *
 * Gray is the right hue for it under §4 and `lib/status` both: `neutral` means
 * "not started yet", which is precisely a Draft's units. Same delegation as
 * above; what stays here is the sentence — the label and the tooltip that
 * explains WHY there is no status, which is the only reason this component
 * exists rather than a `<Badge tone="neutral">` at each call site.
 *
 * The `title` needs an element of its own because `<Badge>` takes no `title`:
 * a status block renders its word and nothing else, and a tooltip is not part
 * of §4's block anatomy. Wrapping is the honest way to add one.
 */
export function DraftStatusBadge() {
  return (
    <span
      title="Status is engine-owned. Units take In Stock at creation; a Draft's units have no status."
      style={{ display: 'inline-flex' }}
    >
      <Badge tone="neutral" label="No status · Draft" icon={<Icon name="dot" size={9} />} size="sm" />
    </span>
  )
}

export function Chip({ children, onRemove, icon }: { children: ReactNode; onRemove?: () => void; icon?: IconName }) {
  return (
    <span
      style={{
        display: 'inline-flex',
        alignItems: 'center',
        gap: 6,
        padding: '4px 9px',
        borderRadius: 'var(--r-badge)',
        background: 'var(--card2)',
        border: '1px solid var(--border)',
        fontSize: 'var(--t-meta)',
        color: 'var(--text)',
      }}
    >
      {icon && <Icon name={icon} size={12} style={{ color: 'var(--link)' }} />}
      {children}
      {onRemove && (
        <button
          type="button"
          onClick={onRemove}
          aria-label="Remove"
          style={{ border: 'none', background: 'transparent', color: 'var(--muted)', cursor: 'pointer', padding: 0, display: 'grid', placeItems: 'center' }}
        >
          <Icon name="close" size={12} />
        </button>
      )}
    </span>
  )
}

/** Foundation v1.3 date form — BS above AD, both rendered from one AD instant. */
export function BsAbove({ iso }: { iso: string }) {
  if (!iso) return <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>No date set</span>
  const d = new Date(`${iso}T00:00:00Z`)
  if (Number.isNaN(d.getTime())) return <span style={{ fontSize: 'var(--t-th)', color: 'var(--danger-text)' }}>Not a date</span>
  const bs = toBs(d)
  return (
    <span style={{ fontSize: 'var(--t-th)', color: bs ? 'var(--text2)' : 'var(--muted)' }}>
      {bs ? `${formatBs(bs)} · ${formatAd(d)}` : `${formatAd(d)} — BS unavailable outside Shrawan 2083`}
    </span>
  )
}

export const th: CSSProperties = {
  textAlign: 'left',
  padding: '7px 8px',
  fontSize: 'var(--t-th)',
  fontWeight: 600,
  color: 'var(--text2)',
  whiteSpace: 'nowrap',
  borderBottom: '1px solid var(--border)',
}

/*
 * `height` on a `<td>` behaves as a MINIMUM, so this hands every table built
 * on these cells §7.3's row floor ("rows >= 56px") from the token instead of
 * from padding arithmetic. Horizontal padding is unchanged.
 *
 * Its one consumer today is the Stock Units grid in `SectionStockUnits`, which
 * is exactly where the floor earns itself: each row holds a 44px serial input,
 * a 44px condition select and a "Remove unit" button, and at 7 + content + 7
 * those targets overhang the row. They then overlap the neighbouring row, where
 * the later row in the DOM wins the tap — so a tap near a boundary can remove
 * the unit BELOW the one aimed at, or send a scanned serial into another unit's
 * field. Both are data errors that leave no trace on screen. Rows already
 * taller than the floor are unaffected.
 */
export const td: CSSProperties = { height: 'var(--row-min-h)', padding: '7px 8px', fontSize: 'var(--t-meta)', color: 'var(--text)', verticalAlign: 'top' }

export interface UnitDraft {
  id: string
  serial: string
  assetTag: string
  condition: IntakeCondition
  purchaseIso: string
}

export interface ContainedDraft {
  id: string
  modelId: string
  quantity: number
}

export interface FileDraft {
  id: string
  file: File
  url: string
}

/**
 * What the unit's printed label carries. The render's Barcode column reads
 * `EQ000234-SN102`, so the payload is the Asset Code joined to the serial — and
 * where no serial exists yet (§4's whole reason for asset tags: cables, cases,
 * worn plates) it falls back to the asset tag. The QR carries the same string.
 */
export function barcodePayload(u: { serial: string; assetTag: string }): string {
  const s = u.serial.trim()
  return s ? `${NEXT_ASSET_CODE}-${s}` : u.assetTag
}

/** `3 pieces`, `1 unit` — the count and its noun, agreeing. */
export function countOf(n: number, noun: string): string {
  return `${n} ${noun}${n === 1 ? '' : 's'}`
}

export function formatBytes(n: number): string {
  return n < 1024 * 1024 ? `${Math.max(1, Math.round(n / 1024))} KB` : `${(n / 1024 / 1024).toFixed(1)} MB`
}
</file>

<file path="src/modules/inventory/components/SectionIdentity.tsx">
import Icon from '../../../components/ui/Icon'
import { Field, SectionCard, inputStyle, fieldRow } from './EquipmentShared'
import { useEquipmentContext } from './AddEquipmentContext'
import { useInventoryCategories } from '../../../lib/queries/inventory'

export function SectionIdentity() {
  /*
   * The categories that EXIST, read from `inventory_categories`.
   *
   * This offered `data/addEquipment.ts`'s `EQUIPMENT_CATEGORIES` — the
   * seventeen members of the `product_category` ENUM. The TABLE holds six rows
   * (Camera, Lens, Lighting, Audio, Grip, Support, seeded by
   * `0012_seed_data.sql:115-123`, the only insert into it in any migration), and
   * `products.category_id` is NOT NULL against it. `createEquipment` resolves the
   * chosen label by name, so **eleven of the seventeen refused the save** after
   * this form had reported every gate clear — the same shape as the warehouse
   * picker below it, and the action's own error already named the gap.
   *
   * The NAME is still what the action resolves; only the list changed. Reading
   * the table also means that if the other eleven enum members are ever seeded,
   * they appear here with no code change.
   */
  const { rows: categories, loading: categoriesLoading } = useInventoryCategories()

  const {
    assetCode,
    name,
    setName,
    shortName,
    setShortName,
    category,
    setCategory,
    brand,
    setBrand,
    modelNo,
    setModelNo,
    manufacturerDiffers,
    setManufacturerDiffers,
    manufacturer,
    setManufacturer,
    description,
    setDescription,
    thumbnail,
    gallery,
    setGallery,
    imageError,
    thumbInput,
    galleryInput,
    addImages,
    errors,
    sectionNumber,
  } = useEquipmentContext()

  return (
    <SectionCard id="sec-identity" n={sectionNumber('sec-identity')} title="Identity">
            <div style={fieldRow}>
              <Field label="Equipment Name" required error={errors.name} span={2}>
                <input
                  value={name}
                  onChange={(e) => {
                    setName(e.target.value)
                  }}
                  placeholder="e.g. Sony FX3 Camera Body"
                  style={inputStyle(Boolean(errors.name))}
                />
              </Field>
              <Field label="Short Name" hint="Used on labels and packing lists.">
                <input
                  value={shortName}
                  onChange={(e) => setShortName(e.target.value)}
                  placeholder="e.g. FX3 Body"
                  style={inputStyle()}
                />
              </Field>
            </div>

            <div style={fieldRow}>
              <Field label="Asset Code" hint={/* Auto, read-only. This is also the SKU — §4. */ "Auto, read-only. This is also the SKU —"}>
                <input value={assetCode} readOnly className="identifier" style={{ ...inputStyle(), background: 'var(--card)', color: 'var(--nav-active-accent)' }} />
              </Field>
              <Field label="Category" required error={errors.category}>
                <select
                  value={category}
                  onChange={(e) => {
                    setCategory(e.target.value)
                  }}
                  style={inputStyle(Boolean(errors.category))}
                >
                  <option value="">
                    {categoriesLoading
                      ? 'Loading categories…'
                      : categories.length === 0
                        ? 'No category exists to file this under'
                        : 'Select a category'}
                  </option>
                  {categories.map((c) => (
                    <option key={c.id} value={c.name}>
                      {c.name}
                    </option>
                  ))}
                </select>
              </Field>
              <Field label="Brand" required error={errors.brand}>
                <input
                  value={brand}
                  onChange={(e) => {
                    setBrand(e.target.value)
                  }}
                  placeholder="e.g. Sony"
                  style={inputStyle(Boolean(errors.brand))}
                />
              </Field>
              <Field label="Model">
                <input value={modelNo} onChange={(e) => setModelNo(e.target.value)} placeholder="e.g. ILME-FX3" style={inputStyle()} />
              </Field>
            </div>

            {/* §3 — Manufacturer appears only when it differs from Brand. */}
            <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-sm)' }}>
              {/* The tick stays 15px. Blowing a native checkbox up to 44 looks
                  like a rendering fault, and §5 is clear that the law is the hit
                  area and not the paint. A <label> forwards every click to the
                  control it wraps, so the label IS the target: give it
                  min-height 44 and the whole sentence — box, wording and the
                  grey aside — becomes one comfortable thumb-sized row. Same
                  wrapper Handover, Packing and Reset already use for their line
                  checkboxes, and it uses their plain number rather than
                  --tap so the three read identically side by side. */}
              <label style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)', minHeight: 44, fontSize: 'var(--t-meta)', color: 'var(--text2)', cursor: 'pointer' }}>
                <input
                  type="checkbox"
                  checked={manufacturerDiffers}
                  onChange={(e) => {
                    setManufacturerDiffers(e.target.checked)
                    if (!e.target.checked) {
                      setManufacturer('')
                    }
                  }}
                  style={{ width: 15, height: 15, accentColor: 'var(--nav-active-accent)' }}
                />
                Manufacturer differs from Brand
                <span style={{ color: 'var(--muted)', fontSize: 'var(--t-th)' }}>
                  — a Zeiss lens made by Cosina, a rebadged light. Rare, so the field is hidden until it is true.
                </span>
              </label>
              {manufacturerDiffers && (
                <div style={fieldRow}>
                  <Field label="Manufacturer" required error={errors.manufacturer}>
                    <input
                      value={manufacturer}
                      onChange={(e) => {
                        setManufacturer(e.target.value)
                      }}
                      placeholder="e.g. Cosina"
                      style={inputStyle(Boolean(errors.manufacturer))}
                    />
                  </Field>
                </div>
              )}
            </div>

            <Field label="Description">
              <textarea
                value={description}
                maxLength={1000}
                onChange={(e) => setDescription(e.target.value)}
                rows={3}
                placeholder="Full-frame Cinema Line camera, S-Cinetone, 4K 120p, 10-bit 4:2:2 internal…"
                style={{ ...inputStyle(), height: 'auto', padding: 10, resize: 'vertical' }}
              />
            </Field>
            <div style={{ marginTop: -8, display: 'flex', justifyContent: 'space-between', fontSize: 'var(--t-th)', color: 'var(--muted)' }}>
              <span>Plain text. No rich-text engine exists, so no formatting toolbar is drawn.</span>
              <span className="figure">{description.length} / 1000</span>
            </div>

            {/* Thumbnail + gallery — §3. */}
            <div style={{ display: 'grid', gridTemplateColumns: 'auto minmax(0,1fr)', gap: 14, alignItems: 'start' }}>
              <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
                <span style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text2)' }}>Thumbnail</span>
                <button
                  type="button"
                  onClick={() => thumbInput.current?.click()}
                  style={{
                    width: 132,
                    height: 100,
                    borderRadius: 'var(--r-sm)',
                    border: `1.5px dashed ${thumbnail ? 'var(--border)' : 'var(--border2)'}`,
                    background: 'var(--card2)',
                    display: 'grid',
                    placeItems: 'center',
                    cursor: 'pointer',
                    overflow: 'hidden',
                    padding: 0,
                  }}
                >
                  {thumbnail ? (
                    <img src={thumbnail.url} alt={thumbnail.file.name} style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
                  ) : (
                    <span style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 5, color: 'var(--muted)', fontSize: 'var(--t-th)' }}>
                      <Icon name="photo" size={20} />
                      Add thumbnail
                    </span>
                  )}
                </button>
                <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>JPG, PNG or WebP · 5 MB</span>
                <input
                  ref={thumbInput}
                  type="file"
                  aria-label="Upload thumbnail image"
                  accept="image/jpeg,image/png,image/webp"
                  onChange={(e) => {
                    addImages(e.target.files, 'thumb')
                    e.target.value = ''
                  }}
                  style={{ display: 'none' }}
                />
              </div>

              <div style={{ display: 'flex', flexDirection: 'column', gap: 6, minWidth: 0 }}>
                <span style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text2)' }}>Images</span>
                {/* The gap was --sp-sm (8). Each remove glyph now carries a 44px
                    hit area that reaches ~11px past the top-right corner of its
                    own thumbnail, so at 8px two chips' targets would have met in
                    the gutter — and the one later in the DOM would have quietly
                    eaten the edge of its neighbour, including "Add More". --sp-lg
                    (16) leaves 5px of clear air on both axes. Spacing problem,
                    spacing fix. */}
                <div style={{ display: 'flex', flexWrap: 'wrap', gap: 'var(--sp-lg)' }}>
                  {gallery.map((g) => (
                    /* Two spans where there used to be one. The old single span
                       carried the rounding, the border, the clip AND the remove
                       button, and `overflow: hidden` clips hit-testing as hard
                       as it clips paint — a 44px pseudo-element on a button
                       pinned to the corner would have been sliced back to about
                       33px and we would have shipped a target that only looked
                       compliant. So the clip now wraps the image alone and the
                       button is a sibling outside it, free to grow. Same 74x60
                       box on screen: border-box is global, so the inner span at
                       inset 0 paints exactly where the outer one used to. */
                    <span key={g.id} style={{ position: 'relative', width: 74, height: 60 }}>
                      <span style={{ position: 'absolute', inset: 0, borderRadius: 'var(--r-xs)', overflow: 'hidden', border: '1px solid var(--border)' }}>
                        <img src={g.url} alt={g.file.name} style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
                      </span>
                      <button
                        type="button"
                        className="tap"
                        onClick={() => {
                          URL.revokeObjectURL(g.url)
                          setGallery((prev) => prev.filter((x) => x.id !== g.id))
                        }}
                        aria-label={`Remove ${g.file.name}`}
                        style={{
                          position: 'absolute',
                          top: 2,
                          right: 2,
                          width: 18,
                          height: 18,
                          borderRadius: 5,
                          border: 'none',
                          background: 'var(--card)',
                          color: 'var(--text)',
                          cursor: 'pointer',
                          display: 'grid',
                          placeItems: 'center',
                          padding: 0,
                        }}
                      >
                        {/* 18px of paint is deliberate: a 44px badge would bury
                            the thumbnail it is meant to sit on. `.tap` extends
                            the hit area instead and leaves the glyph alone —
                            §5's "the law is the HIT AREA, not the paint". */}
                        <Icon name="close" size={11} />
                      </button>
                    </span>
                  ))}
                  <button
                    type="button"
                    onClick={() => galleryInput.current?.click()}
                    style={{
                      width: 74,
                      height: 60,
                      borderRadius: 'var(--r-xs)',
                      border: '1.5px dashed var(--border2)',
                      background: 'transparent',
                      color: 'var(--link)',
                      cursor: 'pointer',
                      display: 'flex',
                      flexDirection: 'column',
                      alignItems: 'center',
                      justifyContent: 'center',
                      gap: 3,
                      fontSize: 'var(--t-th)',
                      fontFamily: 'inherit',
                      fontWeight: 600,
                    }}
                  >
                    <Icon name="plus" size={14} />
                    Add More
                  </button>
                </div>
                <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>50 MB per file (Evidence v1.1).</span>
                <input
                  ref={galleryInput}
                  type="file"
                  aria-label="Upload gallery images"
                  multiple
                  accept="image/jpeg,image/png,image/webp"
                  onChange={(e) => {
                    addImages(e.target.files, 'gallery')
                    e.target.value = ''
                  }}
                  style={{ display: 'none' }}
                />
              </div>
            </div>

            {imageError && (
              <span style={{ display: 'flex', alignItems: 'center', gap: 5, fontSize: 'var(--t-th)', color: 'var(--danger-text)' }}>
                <Icon name="error" size={12} />
                {imageError}
              </span>
            )}
          </SectionCard>
  )
}
