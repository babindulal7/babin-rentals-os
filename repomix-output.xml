import { useEffect, useState } from 'react'
import { listBookingCrew, type BookingCrewRow } from '../../lib/queries/bookingCrew'
import { formatAdDateTime } from '../../lib/bs'
import { formatMoney, rupees } from '../../lib/money'
import { Button } from '../../components/ui/Button'
import { formatGateError } from '../../lib/gates'

export function BookingCrewList({ bookingId, includeMoney, version }: { bookingId: string; includeMoney: boolean; version: number }) {
  const [rows, setRows] = useState<BookingCrewRow[]>([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)
  const [retry, setRetry] = useState(0)
  useEffect(() => {
    let cancelled = false
    setLoading(true); setError(null); setRows([])
    listBookingCrew(bookingId, includeMoney).then((result) => {
      if (!cancelled) { setRows(result); setLoading(false) }
    }).catch((err: unknown) => {
      if (!cancelled) { setError(formatGateError(err)); setLoading(false) }
    })
    return () => { cancelled = true }
  }, [bookingId, includeMoney, version, retry])
  if (loading) return <p role="status">Loading assigned crew…</p>
  if (error) return <div role="alert"><p>{error}</p><Button onClick={() => setRetry((v) => v + 1)}>Retry crew</Button></div>
  if (!rows.length) return <p>No crew assigned to this booking yet.</p>
  return <ul aria-label="Assigned crew" style={{ listStyle: 'none', padding: 0, margin: 0, display: 'grid', gap: 'var(--sp-md)' }}>
    {rows.map((row) => <li key={row.id} style={{ borderBottom: '1px solid var(--border)', paddingBottom: 'var(--sp-sm)', overflowWrap: 'anywhere' }}>
      <strong>{row.name ?? 'Crew name unavailable'}</strong><div>{row.role}</div>
      <div style={{ color: 'var(--text2)', fontSize: 'var(--t-meta)' }}>Call: {row.callTime ? formatAdDateTime(row.callTime) : 'Not recorded'}</div>
      <div style={{ color: 'var(--text2)', fontSize: 'var(--t-meta)' }}>Wrap: {row.wrapTime ? formatAdDateTime(row.wrapTime) : 'Not recorded'}</div>
      <div>{row.days} {row.days === 1 ? 'day' : 'days'}</div>
      {includeMoney && <div>Daily rate: {row.dailyRate === null ? 'Not available' : formatMoney(rupees(row.dailyRate))} · Total pay: {row.lineTotal === null ? 'Not available' : formatMoney(rupees(row.lineTotal))}</div>}
    </li>)}
  </ul>
}
</file>

<file path="src/modules/rentals/LateFeePanel.tsx">
import { useState } from 'react'
import Icon from '../../components/ui/Icon'
import { cardStyle } from '../../components/ui/Page'
import { Button } from '../../components/ui/Button'
import { formatMoney } from '../../lib/money'
import type { Paisa } from '../../lib/money'
import { settleLateFee, validateWaiver, formatOverage, bandExplanation, WAIVER_REASON_MIN } from '../../lib/lateFee'
import type { LateFeeResult, LateFeeOutcome } from '../../lib/lateFee'
import { useAuth } from '../../lib/auth'
import { canApproveLateFeeWaiver } from '../../lib/rbac'

/**
 * # The late-fee decision
 *
 * ## Why this is not on the Return workspace
 *
 * The 12 Aug spec draws this panel on "Return". `ReturnWorkspace.tsx` is the
 * Warehouse's screen and its own header says so: *"No money, anywhere.
 * Foundation §8.3 … `lib/money.ts` is not imported; no Rs figure appears."*
 * Putting `Suggested late fee Rs 6,000` there would break the law CLAUDE.md
 * lists among the ones most easily broken, and Foundation wins over a later
 * spec by that file's own rule.
 *
 * So the split is by *what the information is*, not by which screen it was
 * drawn on:
 *
 * - **Return** gets the overage and the band — "4h 15m late · a full day is
 *   chargeable". That is operational: it tells the floor to flag the booking.
 *   A band name is a unit of rental time, not a monetary value.
 * - **This panel** gets the rupees and the decision, and lives where money
 *   already lives behind `canBookingMoney`.
 *
 * ## Suggested, never applied
 *
 * Nothing renders as already-charged. The operator applies or waives, and until
 * they do, the figure is a suggestion — `lib/lateFee.ts` carries the rule.
 */

export function LateFeePanel({
  result,
  dayRateBasis,
  staffName,
  outcome,
  onSettle,
}: {
  result: LateFeeResult
  /**
   * What the day rate was taken from, shown verbatim. The scope is unruled —
   * `money.ts`'s own `LateFeeInput` note says no function anywhere aggregates a
   * booking's rate into one "one day" figure, and whether that scope includes
   * crew and transport has no answer. The caller states its basis rather than
   * this panel implying a settled one.
   */
  dayRateBasis: string
  staffName: string
  outcome: LateFeeOutcome | null
  onSettle: (o: LateFeeOutcome) => void
}) {
  const [waiving, setWaiving] = useState(false)
  const [reason, setReason] = useState('')
  const [error, setError] = useState<string | null>(null)
  /*
   * Ruled 12 Aug (PLAN.md §4.23) — a waiver needs a Manager or Owner, the same
   * as a discount above 10%. Both give money away.
   *
   * Ruled again 12 Aug: that approver is the SESSION, not a typed name. This was
   * `useState('')` behind a free-text input; it is now read from `useAuth()` and
   * cannot be authored. `rbac.canApproveLateFeeWaiver` gates the rank on this
   * screen and migration 0058 enforces both the rank and
   * `approved_by = the acting session` at the row, so a name typed here could
   * not have reached the database as an approver anyway.
   */
  const { user } = useAuth()
  const approverName = user?.name?.trim() ?? ''
  const mayApprove = user ? canApproveLateFeeWaiver(user.role) : false

  /* Inside the grace period there is nothing to decide, and a panel offering a
     choice about Rs 0 is noise on a screen that already has a lot on it. */
  if (result.band === 'None') {
    return (
      <div style={{ ...cardStyle, padding: 14, display: 'flex', alignItems: 'flex-start', gap: 'var(--sp-sm)' }}>
        <Icon name="check" size={14} style={{ flexShrink: 0, marginTop: 2, color: 'var(--success-text)' }} />
        <span style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
          Returned within the 30-minute grace period — no late fee.
        </span>
      </div>
    )
  }

  if (outcome) {
    const waived = outcome.decision === 'Waive'
    return (
      <div style={{ ...cardStyle, padding: 14, display: 'flex', flexDirection: 'column', gap: 6 }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)' }}>
          <Icon name={waived ? 'flag' : 'check'} size={14} style={{ color: waived ? 'var(--progress-text)' : 'var(--success-text)' }} />
          <strong style={{ fontSize: 'var(--t-ui)' }}>
            {waived ? 'Late fee waived' : `Late fee applied — ${formatMoney(outcome.chargedPaisa)}`}
          </strong>
        </div>
        {waived && (
          <>
            {/* The figure survives the waiver: a waived Rs 6,000 is not the
                same event as a Rs 0 fee, and the record has to show which. */}
            <span className="figure" style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
              {formatMoney(outcome.suggestedPaisa)} was suggested and not charged.
            </span>
            <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>
              Waived by {outcome.waiver?.staffName}, approved by {outcome.waiver?.approverName} — “{outcome.waiver?.reason}”
            </span>
          </>
        )}
      </div>
    )
  }

  return (
    <div style={{ ...cardStyle, padding: 14, display: 'flex', flexDirection: 'column', gap: 10 }}>
      <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)' }}>
        <Icon name="alert_triangle" size={15} style={{ color: 'var(--progress-text)', flexShrink: 0 }} />
        <strong style={{ fontSize: 'var(--t-ui)' }}>Returned {formatOverage(result.overageMinutes)} late</strong>
      </div>

      <div style={{ display: 'flex', alignItems: 'baseline', justifyContent: 'space-between', gap: 'var(--sp-md)' }}>
        <span style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>Suggested late fee</span>
        <span className="figure" style={{ fontSize: 'var(--t-h3)', fontWeight: 700, color: 'var(--text)' }}>
          {formatMoney(result.feePaisa)}
        </span>
      </div>

      <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>{bandExplanation(result)}</span>

      {/* The basis is stated, not implied. `money.ts` says the scope of "one
          day's rate" is unruled; the operator should see which reading produced
          the number before they approve it. */}
      <span style={{ display: 'flex', alignItems: 'flex-start', gap: 5, fontSize: 'var(--t-th)', color: 'var(--muted)' }}>
        <Icon name="info" size={11} style={{ flexShrink: 0, marginTop: 2 }} />
        Day rate basis: {dayRateBasis}
      </span>

      {!waiving ? (
        <div style={{ display: 'flex', gap: 'var(--sp-sm)', flexWrap: 'wrap' }}>
          <Button
            variant="primary"
            icon="check"
            onClick={() => onSettle(settleLateFee(result, 'Apply'))}
          >
            Apply {formatMoney(result.feePaisa)}
          </Button>
          <Button icon="flag" onClick={() => setWaiving(true)}>
            Waive…
          </Button>
        </div>
      ) : (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 7 }}>
          <label htmlFor="late-fee-waiver-reason" style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text2)' }}>
            Why is this fee being waived? (minimum {WAIVER_REASON_MIN} characters)
          </label>
          <textarea
            id="late-fee-waiver-reason"
            value={reason}
            rows={3}
            onChange={(e) => {
              setReason(e.target.value)
              setError(null)
            }}
            placeholder="e.g. Client held up by the Kalanki road closure, called ahead"
            style={{
              padding: 10,
              borderRadius: 'var(--r-input)',
              border: `1px solid ${error ? 'var(--danger)' : 'var(--border)'}`,
              background: 'var(--card2)',
              color: 'var(--text)',
              fontSize: 'var(--t-meta)',
              fontFamily: 'inherit',
              resize: 'vertical',
            }}
          />

          {/*
            RULED 12 Aug 2026: the approver IS the signed-in session, not a typed
            name. This was a free-text input whose only validation was
            "non-empty" — so a waiver could be recorded as approved by anyone an
            operator chose to type, including someone who never agreed to it.
            That is the fabricated-identity defect this pass removed everywhere
            else, sitting on a control that gives money away.

            Migration 0058 enforces the same thing at the row: a RESTRICTIVE
            policy requires the session hold Owner or Manager, and
            `enforce_approver_is_actor` refuses an approval whose `approved_by`
            is not the acting session. The screen and the database now agree, and
            neither trusts a string.

            The label stays visible so the operator can see WHO the waiver will
            be recorded against before they commit to it.
          */}
          <span style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text2)' }}>
            Approved by
          </span>
          <span
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: 6,
              minHeight: 32,
              fontSize: 'var(--t-meta)',
              color: approverName ? 'var(--text)' : 'var(--danger-text)',
              fontWeight: 600,
            }}
          >
            <Icon name={approverName ? 'check' : 'alert_triangle'} size={12} style={{ flexShrink: 0 }} />
            {approverName
              ? `${approverName} — this session`
              : 'Not signed in. A waiver is recorded against the person approving it, so it cannot be signed from here.'}
          </span>

          {/* Ruled 12 Aug (PLAN.md §4.23): a waiver and a discount above 10%
              both give money away, so both carry a named approver. No
              threshold — Law 10's gate is a percentage and a waiver has no base
              to take one of. */}
          <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>
            Raised by {staffName}. Any staff member may raise a waiver; a Manager or Owner approves it, and both
            names go to the audit log with the reason.
          </span>

          {error && (
            <span role="alert" style={{ display: 'flex', alignItems: 'flex-start', gap: 5, fontSize: 'var(--t-th)', color: 'var(--danger-text)' }}>
              <Icon name="alert_triangle" size={11} style={{ flexShrink: 0, marginTop: 2 }} />
              {error}
            </span>
          )}

          <div style={{ display: 'flex', gap: 'var(--sp-sm)' }}>
            <Button
              variant="primary"
              onClick={() => {
                /*
                 * The rank gate, ahead of `validateWaiver`. That engine checks the
                 * waiver is well-formed — a name, a reason, an approver — but it
                 * never sees a ROLE, so it cannot tell a Manager's signature from
                 * a Coordinator's. `lib/lateFee.ts:26` rules the rank and
                 * `rbac.canApproveLateFeeWaiver` is where it now lives.
                 */
                if (!user) {
                  setError('You are not signed in, so this waiver cannot be recorded against anyone. Nothing was waived.')
                  return
                }
                if (!mayApprove) {
                  setError(`A waiver is approved by a Manager or Owner. Your role (${user.role}) may raise one, but not approve it.`)
                  return
                }
                const check = validateWaiver({ staffName, reason, approverName })
                if (!check.valid) {
                  setError(check.error)
                  return
                }
                onSettle(settleLateFee(result, 'Waive', { staffName, reason, approverName }))
              }}
            >
              Confirm waiver
            </Button>
            <Button
              variant="ghost"
              onClick={() => {
                setWaiving(false)
                setReason('')
                setError(null)
              }}
            >
              Back
            </Button>
          </div>
        </div>
      )}
    </div>
  )
}

export type { Paisa }
</file>

<file path="src/modules/rentals/LineItemTree.tsx">
import { useState, useMemo } from 'react'
import { Link } from 'react-router-dom'
import Icon from '../../components/ui/Icon'
import { TouchTarget } from '../../components/ui/TouchTarget'
import type { FloorLine, FloorUnit } from '../../lib/queries/bookings'
import { isSubRentedLine } from '../../lib/queries/bookings'

export interface LineItemTreeProps {
  lines: FloorLine[]
  canReleaseUnits?: boolean | undefined
  onReleaseUnit?: ((unitId: string, label: string) => void) | undefined
  releasingUnitId?: string | null | undefined
  pastPacked?: boolean | undefined
  subRentedRowStyle?: ((line: { lineType?: string }) => React.CSSProperties) | undefined
  isSubRented?: ((line: { lineType?: string }) => boolean) | undefined
  bookingStage?: string | undefined
}

/** No per-unit QC source is recorded in this projection. */
function getQcStatus(_name: string | null): { label: string; passed: boolean } | null { return null }

/** Asset tags identify equipment; they are not evidence of a flight-case tag. */
function getCaseTag(_parentLine: FloorLine, _index: number): string { return 'No case tag recorded' }

/** Availability must come from the windowed inventory query, never equipment names. */
function getStockAvailability(_line: FloorLine, _index: number): { count: null; tone: 'warning' | 'success' | 'neutral' } { return { count: null, tone: 'neutral' } }

// Ruling 7 Oct: a stage transition is not evidence of a per-unit scan or QC.
function assignmentLabel(line: FloorLine, stage: string) {
  if (line.trackingMode === 'Quantity' || line.trackingMode === 'Consumable') return 'Quantity tracked'
  if (line.lineType !== 'Equipment' && line.lineType !== 'Bundle') return 'No serial required'
  return stage === 'Returned' || stage === 'Closed' ? 'No unit record' : 'Assign during packing'
}

export function LineItemTree({
  lines,
  canReleaseUnits = false,
  onReleaseUnit,
  releasingUnitId = null,
  pastPacked: _pastPacked = false,
  subRentedRowStyle,
  isSubRented = isSubRentedLine,
  bookingStage = 'Booked',
}: LineItemTreeProps) {
  const [collapsedCases, setCollapsedCases] = useState<Record<string, boolean>>({})
  const [searchQuery, setSearchQuery] = useState('')
  const [activeFilter, setActiveFilter] = useState<'all' | 'cases' | 'loose'>('all')

  // Group lines into Cases / Packages and Loose Equipment
  const { cases, looseLines } = useMemo(() => {
    // 1. Find explicit parent-child mappings
    const parentIds = new Set<string>()
    lines.forEach((l) => {
      if (l.parentLineId) parentIds.add(l.parentLineId)
    })

    // 2. Identify parent lines: explicit parentLineId targets OR lines marked Bundle/Kit/Package/Pelican/Case
    const packageParents: FloorLine[] = []
    const childrenByParentId: Record<string, FloorLine[]> = {}
    const loose: FloorLine[] = []

    lines.forEach((line) => {
      const name = (line.productName || line.description || '').toLowerCase()
      const isPackage =
        parentIds.has(line.id) ||
        line.lineType === 'Bundle' ||
        line.lineType === 'Package' ||
        ((name.includes('kit') || name.includes('package') || name.includes('pelican') || name.includes('case')) && lines.length > 1)

      if (isPackage && !line.parentLineId) {
        packageParents.push(line)
        if (!childrenByParentId[line.id]) {
          childrenByParentId[line.id] = []
        }
      }
    })

    // Map children to identified parents
    lines.forEach((line) => {
      if (packageParents.some((p) => p.id === line.id)) {
        return // is parent itself
      }
      if (line.parentLineId && childrenByParentId[line.parentLineId]) {
        childrenByParentId[line.parentLineId]?.push(line)
      } else {
        loose.push(line)
      }
    })

    return {
      cases: packageParents.map((parent, idx) => ({
        parent,
        caseTag: getCaseTag(parent, idx),
        children: childrenByParentId[parent.id] || [],
      })),
      looseLines: loose,
    }
  }, [lines])

  const toggleCase = (caseId: string) => {
    setCollapsedCases((prev) => ({
      ...prev,
      [caseId]: !prev[caseId],
    }))
  }

  const collapseAll = () => {
    const all: Record<string, boolean> = {}
    cases.forEach((c) => {
      all[c.parent.id] = true
    })
    setCollapsedCases(all)
  }

  const expandAll = () => {
    setCollapsedCases({})
  }

  // Filter items based on user search query
  const query = searchQuery.trim().toLowerCase()
  const filterMatches = (text: string | null) => {
    if (!query) return true
    return (text || '').toLowerCase().includes(query)
  }

  return (
    <div className="line-item-tree-workspace" style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md, 16px)' }}>
      {/* ── Filter & Action Toolbar ── */}
      <div
        className="line-item-tree-toolbar"
        style={{
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between',
          flexWrap: 'wrap',
          gap: 10,
          padding: '8px 12px',
          background: 'var(--card2, #f8fafc)',
          border: '1px solid var(--border)',
          borderRadius: 'var(--r-btn, 8px)',
        }}
      >
        <div style={{ display: 'flex', alignItems: 'center', gap: 8, flex: 1, minWidth: 220 }}>
          <Icon name="search" size={15} style={{ color: 'var(--muted, #71717a)' }} />
          <input
            type="search"
            aria-label="Filter equipment, barcode serial, or flight case"
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            placeholder="Filter equipment, barcode serial, flight case..."
            style={{
              width: '100%',
              background: 'transparent',
              border: 'none',
              outline: 'none',
              fontSize: '0.85rem',
              color: 'var(--text)',
            }}
          />
          {searchQuery && (
            <button
              type="button"
              onClick={() => setSearchQuery('')}
              style={{ position: 'relative', background: 'none', border: 'none', cursor: 'pointer', padding: 2, color: 'var(--muted)' }}
              title="Clear search"
              aria-label="Clear search"
            >
              <TouchTarget />
              <Icon name="close" size={14} />
            </button>
          )}
        </div>

        <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
          <div
            className="filter-segment-group"
            style={{
              display: 'inline-flex',
              padding: 2,
              background: 'var(--surface, rgba(0,0,0,0.05))',
              borderRadius: 'var(--r-btn, 8px)',
              border: '1px solid var(--border)',
            }}
          >
            {(['all', 'cases', 'loose'] as const).map((mode) => (
              <button
                key={mode}
                type="button"
                onClick={() => setActiveFilter(mode)}
                style={{
                  padding: '3px 10px',
                  fontSize: '0.775rem',
                  fontWeight: activeFilter === mode ? 600 : 500,
                  borderRadius: 6,
                  border: 'none',
                  background: activeFilter === mode ? 'var(--card, #fff)' : 'transparent',
                  color: activeFilter === mode ? 'var(--text)' : 'var(--text2)',
                  boxShadow: activeFilter === mode ? '0 1px 2px rgba(0,0,0,0.06)' : 'none',
                  cursor: 'pointer',
                  textTransform: 'capitalize',
                }}
              >
                {mode === 'all' ? 'All Lines' : mode === 'cases' ? `Flight Cases (${cases.length})` : `Loose Equipment (${looseLines.length})`}
              </button>
            ))}
          </div>

          {cases.length > 0 && (
            <div style={{ display: 'flex', gap: 4 }}>
              <button
                type="button"
                onClick={expandAll}
                className="btn btn--sm tap"
                style={{
                  minHeight: 44,
                  padding: '0 10px',
                  fontSize: '0.75rem',
                  background: 'var(--card)',
                  border: '1px solid var(--border)',
                  borderRadius: 6,
                  cursor: 'pointer',
                }}
                title="Expand All Flight Cases"
              >
                Expand All
              </button>
              <button
                type="button"
                onClick={collapseAll}
                className="btn btn--sm tap"
                style={{
                  minHeight: 44,
                  padding: '0 10px',
                  fontSize: '0.75rem',
                  background: 'var(--card)',
                  border: '1px solid var(--border)',
                  borderRadius: 6,
                  cursor: 'pointer',
                }}
                title="Collapse All Flight Cases"
              >
                Collapse
              </button>
            </div>
          )}
        </div>
      </div>

      {/* ── 1. Nested Flight Cases ── */}
      {(activeFilter === 'all' || activeFilter === 'cases') &&
        cases.map(({ parent, caseTag, children }, caseIdx) => {
          const isCollapsed = Boolean(collapsedCases[parent.id])
          const allUnits = [
            ...parent.units,
            ...children.flatMap((c) => c.units),
          ]
          const totalUnitsCount = allUnits.length
          const packedUnitsCount = allUnits.filter((u) => u.packed).length
          const isCasePacked = totalUnitsCount > 0 && packedUnitsCount === totalUnitsCount

          // Check if matches search
          const matchesParent = filterMatches(parent.productName) || filterMatches(parent.description) || filterMatches(caseTag)
          const matchingChildren = children.filter(
            (c) =>
              filterMatches(c.productName) ||
              filterMatches(c.description) ||
              c.units.some((u) => filterMatches(u.serial) || filterMatches(u.assetTag))
          )

          if (query && !matchesParent && matchingChildren.length === 0) {
            return null
          }

          const renderedChildren = query ? matchingChildren : children
          const stock = getStockAvailability(parent, caseIdx)

          return (
            <div
              key={parent.id}
              className="flight-case-container"
              style={{
                border: '1px solid var(--border)',
                borderRadius: 'var(--r-card, 12px)',
                background: 'var(--card)',
                overflow: 'hidden',
                boxShadow: '0 1px 3px rgba(0,0,0,0.03)',
              }}
            >
              {/* Flight Case Sturdy Header */}
              <div
                className="flight-case-header"
                onClick={() => toggleCase(parent.id)}
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  padding: '12px 16px',
                  background: 'color-mix(in srgb, var(--card2, #f8fafc) 90%, var(--surface))',
                  borderBottom: isCollapsed ? 'none' : '1px solid var(--border)',
                  cursor: 'pointer',
                  userSelect: 'none',
                }}
              >
                <div style={{ display: 'flex', alignItems: 'center', gap: 10, minWidth: 0 }}>
                  <span
                    style={{
                      display: 'inline-flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      width: 22,
                      height: 22,
                      color: 'var(--muted)',
                      transition: 'transform var(--dur-fast, 120ms)',
                      transform: isCollapsed ? 'rotate(-90deg)' : 'rotate(0deg)',
                    }}
                  >
                    <Icon name="chevron_down" size={16} />
                  </span>

                  {/* Pelican / Flight Case Glyph */}
                  <span
                    style={{
                      display: 'inline-flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      width: 32,
                      height: 32,
                      borderRadius: 6,
                      background: 'color-mix(in srgb, var(--text) 8%, var(--card))',
                      color: 'var(--text)',
                      border: '1px solid var(--border)',
                      flexShrink: 0,
                    }}
                    title="Flight Case Container (Pelican 1510 / Hard Case)"
                  >
                    <Icon name="package" size={18} />
                  </span>

                  <div style={{ minWidth: 0 }}>
                    <div style={{ display: 'flex', alignItems: 'center', gap: 8, flexWrap: 'wrap' }}>
                      <strong style={{ fontSize: '0.95rem', fontWeight: 700, color: 'var(--text)' }}>
                        {parent.productName || parent.description || 'Cinema Flight Case Package'}
                      </strong>

                      {/* Parent Barcode Tag */}
                      <span
                        className="flight-case-tag"
                        style={{
                          display: 'inline-flex',
                          alignItems: 'center',
                          gap: 4,
                          fontFamily: 'var(--font-id, sans-serif)',
                          fontVariantNumeric: 'tabular-nums',
                          fontSize: '0.725rem',
                          fontWeight: 700,
                          padding: '1px 7px',
