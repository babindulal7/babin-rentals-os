    supabase: {
      from: () => chain,
      rpc: async () => ({ data: 'REV-2026-0001', error: null }),
    },
    idempotentInsert: async (table: string, row: Record<string, unknown>, options?: unknown) => {
      state.inserts.push({ table, row, options })
      return { data: { id: 'rev-row-uuid-1', ...row }, error: null }
    },
