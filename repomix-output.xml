.app-pagination { container: pagination / inline-size; flex: 1 1 100%; width: 100%; min-width: 0; font-size: var(--t-meta); color: var(--text2); font-variant-numeric: tabular-nums; }
/* Contained pagers have no intrinsic width. Give their toolbar host a real
   basis instead of allowing shrink-to-fit sizing to collapse the controls. */
.app-page-toolbar__end:has(> .app-pagination) { flex: 1 1 580px; width: 100%; }
.app-pagination__range, .app-pagination__size { white-space: nowrap; }
.app-pagination__controls > button { flex-shrink: 0; }
.app-pagination__layout { display: flex; align-items: center; justify-content: space-between; gap: 8px 16px; flex-wrap: wrap; }
.app-pagination__controls, .app-pagination__numbers, .app-pagination__size { display: flex; align-items: center; gap: 4px; }
.app-pagination button { display: inline-flex; align-items: center; justify-content: center; gap: 4px; min-width: 44px; min-height: 44px; padding: 4px 8px; border: 1.5px solid transparent; border-radius: var(--r-sm); background: transparent; color: var(--text2); font: inherit; cursor: pointer; }
.app-pagination button:hover:not(:disabled) { background: var(--surface-hover, var(--nav-active-bg)); }
.app-pagination button[aria-current=page] { color: var(--select-fg); background: var(--select-bg); font-weight: 700; }
.app-pagination button:disabled { color: var(--muted); opacity: .5; cursor: not-allowed; }
.app-pagination button:focus-visible, .app-pagination select:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
.app-pagination__ellipsis { min-width: 24px; text-align: center; }
.app-pagination__size { gap: 8px; }
.app-pagination select { min-height: 44px; padding: 0 8px; border: 1.5px solid var(--border); border-radius: var(--r-sm); background: var(--input-bg); color: var(--text); font: inherit; cursor: pointer; }
.app-pagination__compact { display: none; }
@container pagination (max-width: 580px) {
  .app-pagination__numbers, .app-pagination .app-pagination__edge { display: none; }
  .app-pagination__compact { display: inline; }
  .app-pagination__position { white-space: nowrap; text-align: center; }
  .app-pagination__controls { width: 100%; justify-content: space-between; order: 3; }
}
@media (max-width: 639px) {
  .app-pagination__numbers, .app-pagination .app-pagination__edge { display: none; }
  .app-pagination__compact { display: inline; }
  .app-pagination__position { white-space: nowrap; text-align: center; }
