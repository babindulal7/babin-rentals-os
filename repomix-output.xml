            return (
              <button
                key={tab}
                type="button"
                className="tap"
                onClick={() => setActiveTab(tab)}
                aria-pressed={active}
                style={{
                  minHeight: 44,
                  padding: '0 14px',
                  fontSize: 'var(--t-meta)',
                  fontWeight: active ? 600 : 400,
                  border: '1px solid var(--border)',
                  background: active ? 'var(--select-bg)' : 'transparent',
