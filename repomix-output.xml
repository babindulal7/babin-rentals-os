import type { ReactNode } from 'react'
import { IntelCard, type IntelGlance, type IntelGroup } from '../ui/IntelCard'
import type { FloorBooking } from '../../lib/queries/bookings'
import type { IntelContext } from '../../lib/intel/context'
import type { SystemRole } from '../../types/database'
import { gateContext } from '../../lib/fieldGating'
import { formatAdDateTime } from '../../lib/bs'

/** Identifier adapter for floor workspaces. It carries only facts returned by
 * the floor read; the tabbed body fetches its own role-filtered data on Peek. */
export function RentalIntelFromFloor({ floor, context, role, children }: {
  floor: FloorBooking
  context: Extract<IntelContext, 'packing' | 'handover' | 'return' | 'inspection'>
  role: SystemRole
  children: ReactNode
}) {
  const glance: IntelGlance = {
    avatarLabel: 'BK',
    avatarIcon: 'calendar',
    title: floor.bookingNo,
    subtitle: `${floor.stage}${floor.clientName ? ` · ${floor.clientName}` : ''}`,
    lines: [
      floor.pickupAtAd ? `Pickup ${formatAdDateTime(floor.pickupAtAd)}` : 'Pickup not scheduled',
      floor.returnAtAd ? `Return ${formatAdDateTime(floor.returnAtAd)}` : 'Return not scheduled',
      `${floor.lines.length} line${floor.lines.length === 1 ? '' : 's'}${floor.linesPresence === 'absent' ? ' · line read unavailable' : ''}`,
    ],
    primaryAction: { label: 'Open booking', to: `/rentals/${encodeURIComponent(floor.bookingNo)}` },
  }
  const detail: IntelGroup[] = [{ title: 'Booking', fields: [
    { label: 'Booking', value: floor.bookingNo },
    { label: 'Client', value: floor.clientName ?? 'Not joined' },
    { label: 'Stage', value: floor.stage },
    { label: 'Pickup', value: floor.pickupAtAd ? formatAdDateTime(floor.pickupAtAd) : 'Not scheduled', ...(floor.pickupAtAd ? { tone: 'booking-date' as const } : {}) },
    { label: 'Return', value: floor.returnAtAd ? formatAdDateTime(floor.returnAtAd) : 'Not scheduled', ...(floor.returnAtAd ? { tone: 'booking-date' as const } : {}) },
  ] }]
  return <IntelCard glance={glance} detail={detail} detailTitle={floor.bookingNo} {...(floor.clientName ? { detailSubtitle: floor.clientName } : {})} entityType="rental" entityId={floor.id} context={context} gateContext={gateContext(role, { surface: 'floor' })}>{children}</IntelCard>
}
</file>

<file path="src/components/intel/SmartIntelCard.tsx">
/**
 * Smart Intel Cards v1 — unified entry point (spec §1).
 *
 * ONE shared architecture: the shell is always `IntelCard`; this component
 * only binds the entity/context/mode contract to already-gated glance/detail
 * payloads built by `src/data/*Intel.ts`. It introduces no page-specific
 * card fork — context changes emphasis and the primary action, never the
 * component (spec §47).
 */

import type { ReactNode } from 'react'
import { IntelCard } from '../ui/IntelCard'
import type { IntelGlance, IntelGroup } from '../ui/IntelCard'
import type { IntelContext, IntelEntityType, IntelMode } from '../../lib/intel/context'
import type { GateContext } from '../../lib/fieldGating'
import type { ActionContext } from '../../actions/core'

export interface SmartIntelCardProps {
  entityType: IntelEntityType
  entityId: string
  context: IntelContext
  mode?: IntelMode
  glance: IntelGlance
  detail: IntelGroup[]
  detailTitle: string
  detailSubtitle?: string
  children: ReactNode
  className?: string
  gateContext?: GateContext
  actionContext?: ActionContext | null
}

export function SmartIntelCard({
  entityType,
  entityId,
  context,
  mode,
  glance,
  detail,
  detailTitle,
  detailSubtitle,
  children,
  className,
  gateContext,
  actionContext,
}: SmartIntelCardProps) {
  void mode
  return (
    <IntelCard
      glance={glance}
      detail={mode === 'glance' ? [] : detail}
      detailTitle={detailTitle}
      {...(detailSubtitle !== undefined ? { detailSubtitle } : {})}
      {...(className !== undefined ? { className } : {})}
      context={context}
      entityType={entityType}
      entityId={entityId}
      {...(gateContext ? { gateContext } : {})}
      {...(actionContext !== undefined ? { actionContext } : {})}
    >
      {children}
    </IntelCard>
  )
}
</file>

