  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.movement-card__project {
  font-size: var(--t-th);
  color: var(--text2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.movement-card__items-count {
  font-size: var(--t-caption, 11px);
  color: var(--text3);
