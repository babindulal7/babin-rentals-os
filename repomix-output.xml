<file path="src/lib/device.ts">
import { useEffect, useState } from 'react'
import { BP, MQ, viewportFor, type Viewport } from './breakpoints'
import { onMediaChange } from './safeStorage'

/**
 * **Device capability and viewport — the primitive Law 13 requires.**
 *
 * Law 13: *"No platform branch in a layout component. Branch on capability."*
 * Until now nothing in the app could obey that, because nothing measured
 * capability: `matchMedia` appeared once, for colour scheme, and the only two
 * `@media` rules in the stylesheet are a 1560px nudge and reduced-motion. Every
 * screen is therefore effectively desktop-only, and tables carry `minWidth: 900`
 * to `1180`, which on a phone produces a horizontal scrollbar rather than a
 * layout.
 *
 * This module is the one place that asks the browser what it can do. Components
 * consume the answers; they never sniff a user agent, and they never ask "is
 * this an iPad" — a question that has been wrong more often than right for a
 * decade.
 *
 * ## Width decides, never orientation
 *
 * v4.1 §7.7 locks the breakpoints at **768** and **1280** and specifies width
 * as the discriminator — they live in `lib/breakpoints.ts`, not here. A
 * warehouse tablet rotated to portrait is still a tablet; a phone in landscape
 * is still a phone. Orientation changes the shape of the viewport, not the
 * size of the thumb using it.
 *
 * ## Capability is separate from size
 *
 * They are genuinely different questions and conflating them is the usual bug:
 *
 *  - A 24-inch touchscreen at the packing bench is **desktop-sized** but
 *    **coarse-pointered**: it needs 44px targets and long-press, not hover.
 *  - A phone mirrored to a monitor is **desktop-sized** with **no hover**.
 *  - A laptop with a touchscreen has **both** fine pointer and touch.
 *
 * So `useViewport()` answers *how much room is there* and `useCapability()`
 * answers *what can the person do with it*. Ask whichever the decision needs;
 * asking both to mean one thing is how hover menus end up on tablets.
 */

export type { Viewport }

/**
 * **v2.1 — the numbers moved to `lib/breakpoints.ts`.**
 *
 * This file used to declare `BREAKPOINT = { phone: 768, desktop: 1180 }`
 * itself. Two things were wrong with that:
 *
 *  1. `1180` is superseded. v4.1 §7.7 rules 768/1280, and the spec's own test
 *     width 1194 (iPad Pro 11" landscape) sat on the WRONG side of 1180 — the
 *     likeliest device on a rental floor was classified `desktop` and served
 *     hover affordances and mouse-sized targets.
 *  2. A breakpoint declared here could not be shared with `responsive.css` or
 *     the `index.html` pre-paint script, so the same threshold existed three
 *     times and could drift silently.
 *
 * `BREAKPOINT` is re-exported for the existing call sites, but it now points at
 * the shared constant. New code should import `BP` from `lib/breakpoints`.
 */
export const BREAKPOINT = BP

function readViewport(): Viewport {
  if (typeof window === 'undefined') return 'desktop'
  return viewportFor(window.innerWidth)
}

/**
 * Current viewport band. Re-evaluates on resize, so a tablet rotating or a
 * window being dragged narrower changes the answer.
 */
export function useViewport(): Viewport {
  const [vp, setVp] = useState<Viewport>(readViewport)

  useEffect(() => {
    // Driven by matchMedia rather than a resize listener: the browser fires
    // these only when a threshold is actually crossed, instead of on every
    // pixel of a drag.
    const sync = () => setVp(readViewport())

    /* `onMediaChange`, not `addEventListener` — `MediaQueryList` did not inherit
       `EventTarget` in WebKit until Safari 14, so on 13 and earlier this throws
       a TypeError. It runs in a mount effect ABOVE the app's only ErrorBoundary
       (App.tsx wraps the routed page only), so React 18 tears down the whole
       root and the device shows a blank white page. `safeStorage.ts` carries
       the two-branch bind. */
    const offPhone = onMediaChange(MQ.phone, sync)
    const offDesktop = onMediaChange(MQ.desktop, sync)
    sync()

    return () => {
      offPhone()
      offDesktop()
    }
  }, [])

  return vp
}

export interface Capability {
  /** A finger or a glove, not a mouse. Demands 44px targets and no hover-only affordance. */
  coarsePointer: boolean
  /** True hover exists. When false, hover intel must become long-press. */
  hasHover: boolean
  /** Installed as a PWA rather than running in a browser tab. */
  standalone: boolean
  /** The user asked for less motion. Respect it in every transition. */
  reducedMotion: boolean
}

function readCapability(): Capability {
  if (typeof window === 'undefined' || !window.matchMedia) {
    return { coarsePointer: false, hasHover: true, standalone: false, reducedMotion: false }
  }
  return {
    coarsePointer: window.matchMedia('(pointer: coarse)').matches,
    hasHover: window.matchMedia('(hover: hover)').matches,
    standalone:
      window.matchMedia('(display-mode: standalone)').matches ||
      // iOS Safari reports installation here rather than through display-mode.
      (window.navigator as unknown as { standalone?: boolean }).standalone === true,
    reducedMotion: window.matchMedia('(prefers-reduced-motion: reduce)').matches,
  }
}

/**
 * What the device can do. A docked tablet gaining a mouse, or a user changing
 * their motion preference, updates without a reload.
 */
export function useCapability(): Capability {
  const [cap, setCap] = useState<Capability>(readCapability)

  useEffect(() => {
    const sync = () => setCap(readCapability())
    /* Same Safari-14 reason as useViewport above. */
    const offs = [
      '(pointer: coarse)',
      '(hover: hover)',
      '(display-mode: standalone)',
      '(prefers-reduced-motion: reduce)',
    ].map((q) => onMediaChange(q, sync))
    sync()

    return () => offs.forEach((off) => off())
  }, [])

  return cap
}

/**
 * Whether a table should render as a table at all.
 *
 * Below 768 a wide table is not a table — it is a horizontal scrollbar hiding
 * the columns that matter. Card rows, each with one primary action, are the
 * locked alternative.
 */
export function useTabularLayout(): boolean {
  return useViewport() !== 'phone'
}

/**
 * Floor screens (Pack · Handover · Return · Reset · Scanner) run one step
 * larger than the rest of the app, regardless of viewport — they are read at
 * arm's length, often through a case, sometimes in daylight.
 *
 * This is a *floor* rule, not a *tablet* rule: the same screen on a desktop at
 * the packing bench is read from the same distance.
 */
export const FLOOR_UI_SCALE = 1.1
</file>

<file path="src/lib/devicePurge.ts">
import { localStore, isIndexedDbAvailable } from './localStore'
import { db as outbox } from './offlineQueue'
import { captureError } from './monitoring'

/**
 * # Purging the device's READ caches when an identity leaves it
 *
 * ## The defect this closes
 *
 * `logout()` used to call `supabase.auth.signOut()` and nothing else. Nothing
 * anywhere in `src/` called `caches.delete`, and nothing cleared the Dexie
 * domain store — a repo-wide grep for either returned zero hits.
 *
 * That is a **Law 6 breach on a shared warehouse tablet**, and RLS cannot reach
 * it, because the response never leaves the device:
 *
 *  - `vite.config.ts` registers two Workbox runtime caches — a
 *    `StaleWhileRevalidate` on `/rest/v1/(equipment|clients|bundles)` and a
 *    `NetworkFirst` on `/rest/v1/(bookings|booking_items)`. Workbox keys those
 *    entries on **URL only**; the JWT rides in the `Authorization` header and is
 *    not part of the key.
 *  - So an Owner's cached `/rest/v1/bookings?...` response — carrying
 *    `deposit_paisa` and `total_paisa` — is a plain Cache Storage entry on the
 *    device. When the Owner signs out and a Warehouse, Technician or Driver user
 *    signs in on the same tablet, `NetworkFirst` serves that Owner-shaped body to
 *    the money-blind session the moment the network is slow or absent.
 *  - The same applies to `localStore`, whose row shapes declare
 *    `daily_rate_paisa`, `outstanding_paisa`, `deposit_paisa` and `total_paisa`.
 *    It has no readers today, so this half is latent rather than live — but it
 *    becomes live the day a read path is added, which is exactly the work now
 *    starting.
 *
 * ## What this deliberately does NOT clear: the outbox
 *
 * `offlineQueue`'s Dexie database holds **work that has not reached the server
 * yet**. A warehouse tablet in a dead zone can accumulate a full shift of packs,
 * handovers and returns in it. Clearing it on sign-out would silently destroy a
 * day of real work at exactly the moment an operator does the most ordinary
 * thing in the world — hand the tablet to the next shift.
 *
 * So the outbox is spared, and `pendingLeft` reports what is still in it, for the
 * caller to surface. That leaves a real, **unresolved** question:
 *
 * > ⚠ TODO(decision) — queued mutations are not scoped to the user who made
 * > them. A pending write created by the Owner will replay under whichever
 * > session happens to be signed in when the network returns, and the server
 * > will attribute it to that user. The fix is a `userId` column on
 * > `QueuedMutation` plus a drain filter, but "whose write is it, and may it
 * > replay under a different operator?" is an audit and accountability question,
 * > not an engineering one. Raised for PLAN.md §4; not invented here.
 *
 * ## Why an allowlist rather than "delete every cache"
 *
 * `caches.keys()` also returns Workbox's **precache** (`workbox-precache-v2-…`),
 * which holds the application shell — the HTML, JS and CSS that let the app open
 * at all with no signal. Deleting that would trade a money leak for a tablet that
 * cannot boot in the warehouse, which is the one thing this build exists to
 * prevent. Only the two named data caches go.
 */

/** The Workbox runtime caches that hold PostgREST response bodies. Must match
 *  `vite.config.ts`'s `runtimeCaching[].options.cacheName` exactly. */
const DATA_CACHE_NAMES = ['supabase-reference-data', 'supabase-operational-data'] as const

export interface PurgeReport {
  /** Workbox data caches actually deleted on this device. */
  cachesDeleted: string[]
  /** Dexie domain tables emptied. */
  tablesCleared: string[]
  /** Unsynced mutations left in the outbox on purpose — see the note above. */
  pendingLeft: number
  /** Anything that failed. A purge is best-effort: a partial purge is still
   *  better than none, so failures are collected rather than thrown. */
  failures: string[]
}

/**
 * Empty every device-local cache that holds another identity's rows, keeping the
 * offline outbox and the application shell.
 *
 * Best-effort and never throws: it is called from `logout()`, and a sign-out that
 * fails because a cache API misbehaved would strand the operator in a session
 * they asked to leave.
 */
export async function purgeDeviceReadCaches(): Promise<PurgeReport> {
  const report: PurgeReport = { cachesDeleted: [], tablesCleared: [], pendingLeft: 0, failures: [] }

  /* 1 — Workbox runtime data caches. `caches` is absent on the dev server (no
     service worker is registered there, `devOptions` is unset) and in a
     non-secure context, so its absence is normal, not a failure. */
  if (typeof caches !== 'undefined') {
    for (const name of DATA_CACHE_NAMES) {
      try {
        if (await caches.delete(name)) report.cachesDeleted.push(name)
      } catch (cause) {
        report.failures.push(`cache ${name}: ${cause instanceof Error ? cause.message : String(cause)}`)
      }
    }
  }

  /* 2 — the Dexie domain cache. `syncMeta` goes too: it holds per-table sync
     cursors, and a cursor inherited from the previous identity would make the
     next user's first pull resume from a high-water mark set against rows they
     may not even be allowed to see, silently skipping their own. */
  if (isIndexedDbAvailable()) {
    for (const table of [localStore.products, localStore.clients, localStore.bookings, localStore.settings, localStore.syncMeta]) {
      try {
        await table.clear()
        report.tablesCleared.push(table.name)
      } catch (cause) {
        report.failures.push(`table ${table.name}: ${cause instanceof Error ? cause.message : String(cause)}`)
      }
    }

    /* 3 — count, never clear. See the header. */
    try {
      report.pendingLeft = await outbox.mutations.where('status').anyOf('pending', 'syncing').count()
    } catch (cause) {
      report.failures.push(`outbox count: ${cause instanceof Error ? cause.message : String(cause)}`)
    }
  }

  if (report.failures.length > 0) {
    captureError(new Error(`purgeDeviceReadCaches: ${report.failures.join(' · ')}`), {
      where: 'devicePurge',
      cachesDeleted: report.cachesDeleted.length,
      tablesCleared: report.tablesCleared.length,
    })
  }

  return report
}
</file>

