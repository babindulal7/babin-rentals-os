  left: 0.75rem;
  color: var(--muted);
  pointer-events: none;
  transition: color var(--dur-fast) var(--ease);
}

.movement-panel__search-box:focus-within .movement-panel__search-icon {
  color: var(--dashboard-accent-strong);
}

.movement-panel__search-input {
  width: 100%;
  height: 2.75rem;
  min-height: 2.75rem;
  padding: 0 2.25rem 0 2.25rem;
