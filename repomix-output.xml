  justify-content: flex-end;
  margin-top: 0;
}

.movement-card__cta-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  min-height: 44px;
  padding: 0 1.25rem;
  font-size: var(--t-ui);
  font-weight: 600;
  border-radius: var(--r-btn, 8px);
