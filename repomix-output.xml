import { Pagination } from '../../components/ui/Pagination'
import { useMemo, useState } from 'react'
import { Link } from 'react-router-dom'
import Icon from '../../components/ui/Icon'
import type { IconName } from '../../components/ui/Icon'
import { Card, PageHeader, Button, ReflowRail, FooterNote, cardStyle, useRailGridColumns, useBandColumns } from '../../components/ui/Page'
import { SearchInput } from '../../components/ui/SearchInput'
import { DataTableShell } from '../../components/ui/DataTable'
import { Donut, Legend } from '../../components/ui/Charts'
import { EmptyState, ErrorBanner } from '../../components/ui/StateViews'
import { PageBody } from '../../components/ui/PageBody'
import { Unavailable } from '../../components/ui/Unavailable'
import { ReportToolbar, reportDateRange, withinReportRange } from '../../components/ui/ReportToolbar'
import type { ReportCsvRow, ReportFilters } from '../../components/ui/ReportToolbar'
import { BRAND, BRAND_ON, STATUS } from '../../lib/status'
import type { BrandKey } from '../../lib/status'
import { formatMoney } from '../../lib/money'
import type { Paisa } from '../../lib/money'
import { toBs, formatBs, formatAd } from '../../lib/bs'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import { useViewport } from '../../lib/device'
import { useLoad } from '../../lib/queries/useLoad'
import {
  CATEGORIES,
  EXPENSE_STATUSES,
  PAYMENT_METHODS,
  BRANCHES,
  STATUS_TOKEN,
  PERIOD,
  RECURRING,
  SEED_ERRORS,
  QUICK_ACTIONS,
  QUICK_ACTIONS_MORE,
  totalsOf,
  budgetOf,
  byCategory,
  toSlices,
  getExpenseReportsSummary,
} from '../../lib/queries/expenseReports'
import type { ExpenseRow } from '../../lib/queries/expenseReports'

/**
 * **Finance ▸ Expenses** — built against `03 Core Modules/Expenses.PNG` and its
 * spec `Expenses.md` v2.2.
 *
 * Everything on this page is derived from `data/expenseReports`'s one
 * `EXPENSES` array — the KPI values, the chip counts, the donut, the rail
 * summary and the pagination footer all recompute from the filtered rows. The
 * render states three different budget figures across its cards and its rail;
 * that cannot be expressed here because there is only one source.
 *
 * **Deviations from the render, each one a locked rule (never copy these back):**
 *  · the render's sidebar is the old 13-item numbered one — Foundation §5.1
 *    locks 8 unnumbered sections + Settings, and the shell owns it regardless.
 *  · the render prices in `NPR 5,82,500`; §2.1 says `Rs` on the value, and every
 *    figure here goes through `lib/money`'s `formatMoney`.
 *  · the render's Budget Remaining tile and one donut slice are **purple**,
 *    which Foundation §4.2 bans outright. Allowed families only; the donut takes
 *    the validated categorical palette from `components/ui/Charts`.
 *  · the render's second column reads `INV-3456` under each expense ID. `INV-`
 *    is our *sales-invoice* prefix — §2.3 — so the vendor's own number renders
 *    as `Bill 3456`.
 *  · the render tabs `Taxes`; §4.2 replaces it with `Government & Licences`,
 *    because VAT and TDS are liabilities and never expense categories.
 */

const th = {
  textAlign: 'left' as const,
  padding: '9px 10px',
  fontSize: 'var(--t-th)',
  fontWeight: 600,
  color: 'var(--text2)',
  whiteSpace: 'nowrap' as const,
  borderBottom: '1px solid var(--border)',
}
/*
 * `height` on a `<td>` behaves as a MINIMUM, so this is the §7.3 row floor
 * ("rows >= 56px") expressed with the token rather than with padding
 * arithmetic. Horizontal padding and the top alignment are untouched — a row
 * that grows to the floor should still hang its text from the top.
 *
 * Each expense row ends in a link back to the booking, case or asset the money
 * was spent against, and a link is a tap target. Under 56px a 44px target
 * overhangs the rows either side, and the later row in the DOM wins the tap in
 * the overlap band, which opens the wrong booking. What the floor buys is the
 * tap landing on the row it was aimed at, not a roomier-looking table.
 */
const td = { height: 'var(--row-min-h)', padding: '10px', fontSize: 'var(--t-meta)', color: 'var(--text)', verticalAlign: 'top' as const }

/** Every glyph here is a real key in `components/ui/Icon`'s registry. */
const CATEGORY_ICON: Record<string, IconName> = {
  Office: 'briefcase',
  Equipment: 'box',
  Maintenance: 'tool',
  Staff: 'users',
  Transport: 'truck',
  Utilities: 'battery',
  'Software & AI': 'sparkles',
  Marketing: 'activity',
  Finance: 'card',
  'Government & Licences': 'file',
  Miscellaneous: 'dot',
}

const METHOD_ICON: Record<string, IconName> = {
  'Bank Transfer': 'briefcase',
  Cash: 'dollar',
  Cheque: 'file',
  eSewa: 'receipt',
  Khalti: 'receipt',
  Card: 'card',
}

const ROWS_PER_PAGE = [10, 25, 50] as const

/**
 * The ledger's own range, as `ReportToolbar` would emit it.
 *
 * This is the screen's BASELINE in `useList`'s sense — a structural predicate,
 * not something the operator chose — so "did anyone narrow this list" compares
 * against it rather than against no range at all. Without that, the empty state
 * would offer Clear filters on an untouched page.
 */
const SEEDED_RANGE = reportDateRange('expense_date', PERIOD.from, PERIOD.to)

/** A KPI tile with the render's drill-down link. `KpiStrip` has no link slot. */
function KpiCard({
  label,
  value,
  icon,
  accent,
  note,
  to,
  linkLabel,
}: {
  label: string
  value: string
  icon: IconName
  accent: BrandKey
  note?: { text: string; tone: BrandKey }
  to: string
  linkLabel: string
}) {
  return (
    <article className="lift" style={{ ...cardStyle, padding: '13px 14px', minWidth: 0, display: 'flex', flexDirection: 'column' }}>
      <div style={{ display: 'flex', alignItems: 'center', gap: 9 }}>
        <span
          style={{
            width: 30,
            height: 30,
            borderRadius: 'var(--r-sm)',
            background: BRAND[accent],
            color: BRAND_ON[accent],
            display: 'grid',
            placeItems: 'center',
            flexShrink: 0,
          }}
        >
          <Icon name={icon} size={16} fill />
        </span>
        <div style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text2)', minWidth: 0, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>
          {label}
        </div>
      </div>
      <div className="figure" style={{ fontSize: 'var(--t-h2)', fontWeight: 700, color: 'var(--text)', marginTop: 9, letterSpacing: '-0.02em' }}>
        {value}
      </div>
      {note && (
        <div style={{ marginTop: 3, fontSize: 'var(--t-meta)', fontWeight: 600, color: STATUS[note.tone === 'danger' ? 'danger' : note.tone === 'success' ? 'in' : 'progress'].fg }}>
          {note.text}
        </div>
      )}
      <Link
        to={to}
        style={{
          marginTop: 'auto',
          paddingTop: 9,
          display: 'inline-flex',
          alignItems: 'center',
          gap: 'var(--sp-xs)',
          fontSize: 'var(--t-meta)',
          fontWeight: 600,
          color: 'var(--link)',
          textDecoration: 'none',
        }}
      >
        {linkLabel}
        <Icon name="arrow_right" size={12} />
      </Link>
    </article>
  )
}

export default function ExpenseReports() {
  /* KpiStrip's clamp, applied to this screen's hand-rolled key-figure grid:
     four or six cards side by side is unreadable below 1280. */
  const bandCols = useBandColumns()
  /* Rulings §7 — the rail track goes away below 1280 so `ReflowRail`'s
     inline column is not squeezed by a rail column that is still there. */
  const railGridColumns = useRailGridColumns()
  const money = useCanViewMoney()
  const viewport = useViewport()
  const phone = viewport === 'phone'

  const [category, setCategory] = useState<string>('All')
  const [status, setStatus] = useState<string>('All')
  const [method, setMethod] = useState<string>('All')
  const [vendor, setVendor] = useState<string>('All')
  const [query, setQuery] = useState('')
  const [page, setPage] = useState(1)
  const [perPage, setPerPage] = useState<number>(25)

  /*
   * The shared toolbar's half of the filter set — `ListFilters`-shaped, so when
   * this ledger moves off `data/expenseReports` onto Postgres it is handed
   * straight to `useList` as `{ ...base, ...report }` with no reshaping.
   *
   * It STARTS on the seeded ledger's own range rather than on All dates,
   * because that range is what the page used to print as a fixed label. Built
   * through `reportDateRange` so the opening window is the identical
   * Nepal-day-boundary window the control produces — a hand-written
   * `PERIOD.from.toISOString()` would be a bare UTC instant and would shift by
   * 5h45m the first time anyone touched the picker.
   */
  const [report, setReport] = useState<ReportFilters>({ dateRange: SEEDED_RANGE })
  const branch = report.chips?.branch?.[0] ?? ''

  /* Phase 6 — the read is `useLoad`'s: skeleton while in flight, the failure
     as an inline banner with Retry (offline-worded when it is). It used to be a
     bare `.then` whose query turned any failure into zero rows, which this page
     then drew as "No expenses recorded" under Rs 0 totals. Skipped entirely for
     a money-blind session, which is refused below without the rows being read. */
  const load = useLoad(getExpenseReportsSummary, { enabled: money })
  const expenseList = useMemo<ExpenseRow[]>(() => load.data?.rows ?? [], [load.data])

  const vendors = useMemo(() => [...new Set(expenseList.map((r) => r.vendor))].sort(), [expenseList])

  /*
   * Every predicate EXCEPT the category chips.
   *
   * The split matters because the chip row carries a count on each chip, and
   * this page's rule for it is that "a chip can never advertise rows that are
   * not there". Counting over the whole ledger broke that rule the moment the
   * toolbar could narrow the date range or the branch — Office would say 4 over
   * a window holding 2. Counting over the fully-filtered rows would break it the
   * other way, since every chip but the selected one would read 0.
   *
   * So the chips count over exactly this: everything the operator has chosen
   * apart from the category they are about to choose.
   */
  const scoped = useMemo(() => {
    const q = query.trim().toLowerCase()
    return expenseList.filter((r) => {
      if (status !== 'All' && r.status !== status) return false
      if (method !== 'All' && r.method !== method) return false
      if (vendor !== 'All' && r.vendor !== vendor) return false
      if (branch && r.branch !== branch) return false
      if (!withinReportRange(r.date, report.dateRange)) return false
      if (!q) return true
      return (
        r.id.toLowerCase().includes(q) ||
        r.vendor.toLowerCase().includes(q) ||
        r.description.toLowerCase().includes(q) ||
        r.category.toLowerCase().includes(q) ||
        (r.billNo ?? '').toLowerCase().includes(q)
      )
    })
  }, [expenseList, status, method, vendor, branch, query, report.dateRange])

  const rows = useMemo(
    () => (category === 'All' ? scoped : scoped.filter((r) => r.category === category)),
    [scoped, category],
  )

  const totals = useMemo(() => totalsOf(rows), [rows])
  const budget = useMemo(() => budgetOf(rows), [rows])
  const slices = useMemo(() => toSlices(byCategory(rows)), [rows])
  const largestExpense = useMemo(() => {
    if (rows.length === 0) return null
    return rows.reduce((max, r) => (r.amount > max.amount ? r : max))
  }, [rows])

  const pageCount = Math.max(1, Math.ceil(rows.length / perPage))
  const current = Math.min(page, pageCount)
  const shown = rows.slice((current - 1) * perPage, current * perPage)

  const rangeNarrowed =
    report.dateRange?.fromAd !== SEEDED_RANGE?.fromAd || report.dateRange?.toAd !== SEEDED_RANGE?.toAd
  const filtered =
    category !== 'All' || status !== 'All' || method !== 'All' || vendor !== 'All' || branch !== '' || query !== '' || rangeNarrowed
  const clearAll = () => {
    setCategory('All')
    setStatus('All')
    setMethod('All')
    setVendor('All')
    setQuery('')
    setReport({ dateRange: SEEDED_RANGE })
    setPage(1)
  }

  /*
   * §8.3 — this screen is money end to end: every KPI, the whole Amount column,
   * the donut and the rail. There is no money-free version of it to show, so a
   * money-blind session is told plainly rather than handed an empty husk that
   * looks broken. The rows are never fetched into the DOM at all.
   */
  if (!money) {
    return (
      <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
        <PageHeader icon="card" title="Expenses" description="Track operating costs, control spending, and monitor company expenses." />
        {/* This screen hand-wrote the restricted → error → empty ladder, and
            `PageBody` was written to generalise exactly that. Same
            `RestrictedState` underneath — the ladder is now the shared one, and
            no toolbar is drawn above it either. */}
        <PageBody
          restricted
          restrictedReason="Expenses is not available for your role. Every figure on this page is a monetary amount, so there is no version of it your role can see. Ask an Owner, Admin, Coordinator or Accounts user if you need an expense recorded."
          restrictedRequiredRole="Owner, Admin, Coordinator or Accounts"
        >
          {null}
        </PageBody>
        <FooterNote />
      </div>
    )
  }

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
      <PageHeader
        icon="card"
        title="Expenses"
        description="Track operating costs, control spending, and monitor company expenses."
        actions={
          <>
            {/* The Export button that used to sit here had no handler. The
                toolbar below owns CSV now, and it exports the rows currently
                on screen rather than a fixed dump.

                BUG-006 — and directly beneath that note, `Import` and `New
                Expense` were still dead: enabled, one of them styled `primary`,
                neither carrying an `onClick`. The comment recorded the lesson
                and the two buttons under it went on telling the same lie.

                Both are unbuilt one layer deeper than the handler. This screen
                renders `data/expenseReports.ts` — a seed fixture — and
                `src/actions/finance/` holds exactly two actions (`recordPayment`,
                `approveDailyClosing`). **Nothing in the codebase writes an
                expense row.** `lib/queries/finance.ts` reads `expenses` in four
                places and never inserts. So there is no write path for either
                button to call, and inventing one — deciding an expense's
                required fields, its approval path, its import file format —
                is a product decision, not a missing wire.

                Disabled with the reason rather than removed: expenses are the
                screen's subject and this is where creating one will live. */}
            <Unavailable reason={EXPENSE_UNAVAILABLE.Import}>
              <Button icon="upload" disabled>Import</Button>
            </Unavailable>
            <Unavailable reason={EXPENSE_UNAVAILABLE['New Expense']}>
              <Button icon="plus" variant="primary" disabled>
                New Expense
              </Button>
            </Unavailable>
          </>
        }
      />

      <PageBody
        noun="expenses"
        loading={load.loading}
        error={load.error}
        onRetry={load.reload}
        hasRows={load.data !== null}
        skeleton="kpi"
      >
      {/* A seed that stops reconciling is shown, not thrown — a module-scope
          throw runs before React mounts and blanks the app with no message. */}
      {SEED_ERRORS.length > 0 && (
        <ErrorBanner
          title="Seed data does not reconcile"
          message={
            <ul style={{ margin: 0, paddingLeft: 16 }}>
              {SEED_ERRORS.map((e) => (
                <li key={e}>{e}</li>
              ))}
            </ul>
          }
        />
      )}

      <section aria-label="Key figures" style={{ display: 'grid', gridTemplateColumns: `repeat(${bandCols(4)}, minmax(0,1fr))`, gap: 'var(--sp-md)' }}>
        <KpiCard
          label="Total Expenses"
          value={formatMoney(totals.total as Paisa)}
          icon="card"
          accent="primary"
          note={{ text: `${totals.count} recorded this period`, tone: 'neutral' }}
          to="/reports/expenses"
          linkLabel="View Detailed Report"
        />
        <KpiCard
          label={budget.over ? 'Over Budget' : 'Budget Remaining'}
          value={formatMoney(Math.abs(budget.over ? budget.overspend : budget.remaining) as Paisa)}
          icon="chart"
          accent={budget.over ? 'danger' : 'success'}
          note={
            budget.percent === null
              ? { text: 'No monthly budget set', tone: 'neutral' }
              : { text: `${budget.percent.toFixed(0)}% of ${formatMoney(budget.budget as Paisa)} used`, tone: budget.over ? 'danger' : 'neutral' }
          }
          to="/reports/expenses"
          linkLabel="View Budget"
        />
        <KpiCard
          label="Pending Approval"
          value={String(totals.pendingCount)}
          icon="timer"
          accent="progress"
          note={{ text: formatMoney(totals.pending as Paisa), tone: 'progress' }}
          to="/reports/expenses"
          linkLabel="View Pending"
        />
        <KpiCard
          label="Largest Expense"
          value={largestExpense ? formatMoney(largestExpense.amount as Paisa) : '—'}
          icon="arrow_up"
          accent="neutral"
          note={{ text: largestExpense ? largestExpense.vendor : 'No expenses recorded', tone: 'neutral' }}
          to="/reports/expenses"
          linkLabel="View Expense"
        />
      </section>

      {/* Category chips. Each carries its own count, derived from the same
          array the table reads — every other filter applied, this one not — so
          a chip can never advertise rows that are not there. */}
      <div
        className="rsp-chip-scroll"
        style={{
          display: 'flex',
          gap: 6,
          flexWrap: phone ? 'nowrap' : 'wrap',
          overflowX: phone ? 'auto' : 'visible',
          paddingBottom: phone ? 4 : 0,
        }}
      >
        {['All', ...CATEGORIES].map((c) => {
          const on = category === c
          const count = c === 'All' ? scoped.length : scoped.filter((r) => r.category === c).length
          return (
            <button
              key={c}
              type="button"
              onClick={() => {
                setCategory(c)
                setPage(1)
              }}
              aria-pressed={on}
              style={{
                display: 'inline-flex',
                alignItems: 'center',
                gap: 6,
                minHeight: 44,
                padding: '0 14px',
                borderRadius: 'var(--r-btn)',
                /*
                 * Selected = the PRIMARY, not a status hue.
                 *
                 * This painted its selected state `--st-progress-*` — solid
                 * YELLOW — which breaks two v4.1 laws at once. §2/§5: "orange
                 * and yellow never appear on a button", because the moment a
                 * control wears a status hue the eye reads it as a status.
                 * And §2's entity/state split: this filters by expense
                 * CATEGORY, which is an entity, so it has no business wearing
                 * the status vocabulary at all.
                 *
                 * §6's carve-out ("status FILTER chips … on = the solid block
                 * itself") is narrow and deliberate: it covers filters whose
                 * options ARE statuses. A category filter is not one.
                 *
                 * The primary treatment is what the sibling filters on the
                 * Dashboard (`modules/today`) already use, so this now
                 * matches them.
                 * Radius moves off `--r-badge` too — §3.3 reserves 999 for
                 * numeric count badges, and this is a control.
                 */
                border: `1px solid ${on ? 'var(--primary)' : 'var(--border)'}`,
                background: on ? 'var(--primary)' : 'var(--card)',
                color: on ? 'var(--on-primary)' : 'var(--text2)',
                fontSize: 'var(--t-meta)',
                fontWeight: 600,
                fontFamily: 'inherit',
                cursor: 'pointer',
                whiteSpace: 'nowrap',
                flexShrink: 0,
              }}
            >
              {c !== 'All' && <Icon name={CATEGORY_ICON[c] ?? 'dot'} size={13} />}
              {c}
              {/* Inside a selected (primary-filled) chip --muted is unreadable;
                  inherit the button's own ink instead. */}
              <span className="figure" style={{ color: on ? 'inherit' : 'var(--muted)', fontWeight: 700, opacity: on ? 0.85 : 1 }}>
                {count}
              </span>
            </button>
          )
        })}
      </div>

      <div style={{ display: 'grid', gridTemplateColumns: railGridColumns, gap: 'var(--sp-md)', alignItems: 'start' }}>
        <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)', minWidth: 0 }}>
          {/*
            The shared toolbar owns the date range, the branch and the export;
            the four selects and the search box below are this ledger's own and
            ride along as its children. The period pill it draws is the same
            BS-above-AD pair this bar used to print as fixed text — except it is
            now a control, so the range it names is the range the rows obey.
          */}
          <ReportToolbar
            title="Expenses"
            value={report}
            onChange={(next) => {
              setReport(next)
              setPage(1)
            }}
            dateColumn="expense_date"
            branches={BRANCHES}
            csv={{ filename: 'expenses', build: () => expensesCsv(rows) }}
          >
            <Sel value={status} onChange={setStatus} all="All Status" options={EXPENSE_STATUSES as readonly string[]} onPick={() => setPage(1)} />
            <Sel value={method} onChange={setMethod} all="All Payment Method" options={PAYMENT_METHODS as readonly string[]} onPick={() => setPage(1)} />
            <Sel value={vendor} onChange={setVendor} all="All Vendors" options={vendors} onPick={() => setPage(1)} />

            <div style={{ flex: 1, minWidth: 200 }}>
              <SearchInput
                value={query}
                onChange={(val) => {
                  setQuery(val)
                  setPage(1)
                }}
                onClear={() => {
                  setQuery('')
                  setPage(1)
                }}
                placeholder="Search expense, vendor, bill no…"
                aria-label="Search expenses"
              />
            </div>

            {filtered && <Button onClick={clearAll}>Clear</Button>}
          </ReportToolbar>

          <Card title={`${rows.length} ${rows.length === 1 ? 'expense' : 'expenses'}`} bodyStyle={{ padding: 0 }}>
            {/* The empty state used to offer the words "Clear a filter" and no
                button to do it with. `PageBody` asks the filtered and unfiltered
                questions separately and wires the one that has an answer. */}
            <PageBody
              noun="expenses"
              empty={rows.length === 0}
              emptyIsFiltered={filtered}
              onClearFilters={clearAll}
              emptyTitle={filtered ? 'No expenses match these filters' : 'No expenses recorded'}
              emptyMessage={filtered ? 'Clear a filter or widen the range to see records again.' : 'Nothing has been booked to this ledger yet.'}
            >
              <DataTableShell ariaLabel="Expenses report">
                <table style={{ width: '100%', borderCollapse: 'collapse', minWidth: 940 }}>
                  <thead>
                    <tr style={{ background: 'var(--th-bg)' }}>
                      {['Expense ID', 'Date', 'Category', 'Vendor', 'Description', 'Amount', 'Payment Method', 'Status', 'Paid By', 'Actions'].map((h) => (
                        <th key={h} style={{ ...th, textAlign: h === 'Amount' ? 'right' : 'left' }}>
                          {h}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {shown.map((r) => (
                      <Row key={r.id} r={r} />
                    ))}
                  </tbody>
                </table>
              </DataTableShell>
            </PageBody>

            {rows.length > 0 && (
              <div style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '10px 12px', borderTop: '1px solid var(--border)', flexWrap: 'wrap' }}>
                <Pagination page={current} total={rows.length} pageSize={perPage} onPageChange={setPage} pageSizeOptions={ROWS_PER_PAGE} onPageSizeChange={(size) => { setPerPage(size); setPage(1) }} />
              </div>
            )}
          </Card>
        </div>

        <ReflowRail width={300}>
          <Card title="Expense Summary">
            <div style={{ display: 'flex', flexDirection: 'column', gap: 9 }}>
              <SumRow label="Total Expenses" value={formatMoney(totals.total as Paisa)} />
              <SumRow label="Paid Amount" value={formatMoney(totals.paid as Paisa)} tone="in" />
              <SumRow label="Pending Amount" value={formatMoney(totals.pending as Paisa)} tone="progress" />
              <SumRow label="Recurring" value={formatMoney(totals.recurring as Paisa)} />
              <SumRow label="Reclaimable VAT" value={formatMoney(totals.inputVat as Paisa)} />
              <div>
                <div style={{ display: 'flex', alignItems: 'baseline', gap: 7, fontSize: 'var(--t-meta)' }}>
                  <span style={{ flex: 1, color: 'var(--text2)' }}>Budget Used</span>
                  <span className="figure" style={{ fontWeight: 700, color: budget.over ? 'var(--danger-text)' : 'var(--text)' }}>
                    {budget.percent === null ? '—' : `${budget.percent.toFixed(0)}%`}
                  </span>
                </div>
                <div aria-hidden style={{ height: 5, borderRadius: 'var(--r-badge)', background: 'var(--card2)', marginTop: 5, overflow: 'hidden' }}>
                  <div
                    style={{
                      width: `${Math.min(budget.percent ?? 0, 100)}%`,
                      height: '100%',
                      background: budget.over ? BRAND.danger : BRAND.progress,
                      borderRadius: 'var(--r-badge)',
                    }}
                  />
                </div>
              </div>
            </div>
          </Card>

          <Card title="Top Categories">
            {slices.length === 0 ? (
              <EmptyState icon={<Icon name="chart" size={26} />} title="Nothing to chart" description="No recorded expense matches these filters." />
            ) : (
              <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 10 }}>
                <Donut slices={slices} centreLabel="Total" centreValue={formatMoney(totals.total as Paisa)} />
                <Legend slices={slices} />
              </div>
            )}
          </Card>

          <Card
            title="Upcoming Payments"
            action={
              <Unavailable reason="Recurring expenses and automation center are not built yet.">
                <span style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--muted)', cursor: 'not-allowed' }}>
                  View All
                </span>
              </Unavailable>
            }
          >
            <div style={{ display: 'flex', flexDirection: 'column', gap: 9 }}>
              {RECURRING.map((s) => {
                const bs = toBs(s.dueAd)
                return (
                  <div key={s.name} style={{ display: 'flex', gap: 'var(--sp-sm)', alignItems: 'flex-start' }}>
                    <Icon name="refresh" size={13} style={{ marginTop: 2, flexShrink: 0, color: 'var(--muted)' }} />
                    <div style={{ minWidth: 0, flex: 1 }}>
                      <div style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>{s.name}</div>
                      <div style={{ fontSize: 'var(--t-meta)', color: 'var(--muted)' }}>
                        {bs ? `${formatBs(bs)} · ` : ''}
                        {formatAd(s.dueAd)}
                      </div>
                    </div>
                    <span className="figure" style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)', whiteSpace: 'nowrap' }}>
                      {formatMoney(s.expected)}
                    </span>
                  </div>
                )
              })}
            </div>
          </Card>

          <Card title="Quick Actions">
            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 'var(--sp-sm)' }}>
              {/*
                These two tiles are the SAME two actions as the page header's
                `Import` / `New Expense`, and they were dead in the same way —
                found by probing the rendered page rather than reading it, which
                is why the audit's file-level pass caught the header pair and
                missed this one. Fixing only the header would have left the
                screen contradicting itself: one copy of "New Expense" greyed
                with a reason, an identical one two rails over still inviting a
                press.

                Same reasons, from the same constant, for exactly that: the two
                sites cannot drift into two different explanations of one gap.
              */}
              {QUICK_ACTIONS.map((a) => (
                <Unavailable key={a.label} reason={EXPENSE_UNAVAILABLE[a.label]} style={{ display: 'block' }}>
                  <button
                    type="button"
                    disabled
                    style={{ ...quickStyle, width: '100%', cursor: 'not-allowed', opacity: 0.6 }}
                  >
                    <Icon name={a.icon as IconName} size={17} />
                    {a.label}
                  </button>
                </Unavailable>
              ))}
            </div>
            <div style={{ marginTop: 8, display: 'flex', flexDirection: 'column', gap: 'var(--sp-xs)' }}>
              {QUICK_ACTIONS_MORE.map((label) =>
                label === 'Recurring Expenses' ? (
                  <Unavailable key={label} reason="Recurring expenses scheduler is not built yet.">
                    <span style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--muted)', cursor: 'not-allowed' }}>
                      {label} →
                    </span>
                  </Unavailable>
                ) : (
                  <Link
                    key={label}
                    to="/documents"
                    style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--link)', textDecoration: 'none' }}
                  >
                    {label} →
                  </Link>
                ),
              )}
            </div>
          </Card>
        </ReflowRail>
      </div>
      </PageBody>

      <FooterNote extra={['Capital purchases become assets in Inventory, never expenses']} />
    </div>
  )
}

/* Law 15 — the hit area is the law and `--tap` is the token for it. Two
   consumers, both period/branch Selects in the report toolbar. */
const selStyle = {
  minHeight: 'var(--tap)',
  padding: '0 8px',
  borderRadius: 'var(--r-input)',
  border: '1px solid var(--border)',
  background: 'var(--card2)',
  color: 'var(--text)',
  fontSize: 'var(--t-meta)',
  fontFamily: 'inherit',
}

function Sel({
  value,
  onChange,
  all,
  options,
  onPick,
}: {
  value: string
  onChange: (v: string) => void
  all: string
  options: readonly string[]
  onPick: () => void
}) {
  return (
    <select
      value={value}
      aria-label={all}
      onChange={(e) => {
        onChange(e.target.value)
        onPick()
      }}
      style={selStyle}
    >
      <option value="All">{all}</option>
      {options.map((o) => (
        <option key={o} value={o}>
          {o}
        </option>
      ))}
    </select>
  )
}

function SumRow({ label, value, tone }: { label: string; value: string; tone?: 'in' | 'progress' }) {
  return (
    <div style={{ display: 'flex', alignItems: 'baseline', gap: 7, fontSize: 'var(--t-meta)' }}>
      <span style={{ flex: 1, color: 'var(--text2)' }}>{label}</span>
      <span className="figure" style={{ fontWeight: 700, color: tone ? STATUS[tone].fg : 'var(--text)' }}>
        {value}
      </span>
    </div>
  )
}

function Row({ r }: { r: ExpenseRow }) {
  const bs = toBs(r.date)
  const tok = STATUS[STATUS_TOKEN[r.status]]
  return (
    <tr style={{ borderBottom: '1px solid var(--border)' }}>
      <td style={td}>
        <div className="identifier" style={{ fontWeight: 700 }}>{r.id}</div>
        {/* §2.3 — the vendor's number, never our INV- sales prefix. */}
        {r.billNo && <div style={{ fontSize: 'var(--t-meta)', color: 'var(--muted)' }}>Bill {r.billNo}</div>}
      </td>
      <td style={td}>
        <div>{formatAd(r.date)}</div>
        <div style={{ fontSize: 'var(--t-meta)', color: 'var(--muted)' }}>{bs ? formatBs(bs) : '—'}</div>
      </td>
      <td style={td}>
        <span
          style={{
            display: 'inline-flex',
            alignItems: 'center',
            gap: 5,
            height: 20,
            padding: '0 7px',
            borderRadius: 'var(--r-badge)',
            background: 'var(--card2)',
            color: 'var(--text2)',
            fontSize: 'var(--t-meta)',
            fontWeight: 600,
            whiteSpace: 'nowrap',
          }}
        >
          <Icon name={CATEGORY_ICON[r.category] ?? 'dot'} size={12} />
          {r.category}
        </span>
        <div style={{ fontSize: 'var(--t-meta)', color: 'var(--muted)', marginTop: 3 }}>{r.subCategory}</div>
      </td>
      <td style={{ ...td, color: 'var(--text2)' }}>{r.vendor}</td>
      <td style={{ ...td, color: 'var(--text2)', maxWidth: 210 }}>{r.description}</td>
      <td className="figure" style={{ ...td, textAlign: 'right', fontWeight: 700, whiteSpace: 'nowrap' }}>
        {formatMoney(r.amount)}
        {r.vat !== null && (
          <div style={{ fontSize: 'var(--t-meta)', fontWeight: 400, color: 'var(--muted)' }}>incl. VAT {formatMoney(r.vat)}</div>
        )}
      </td>
      <td style={td}>
        <span style={{ display: 'inline-flex', alignItems: 'center', gap: 5, whiteSpace: 'nowrap' }}>
          <Icon name={METHOD_ICON[r.method] ?? 'card'} size={13} />
          {r.method}
        </span>
        <div style={{ fontSize: 'var(--t-meta)', color: 'var(--muted)' }}>{r.methodDetail}</div>
      </td>
      <td style={td}>
        <span
          style={{
            display: 'inline-flex',
            alignItems: 'center',
            height: 20,
            padding: '0 8px',
            borderRadius: 'var(--r-badge)',
            background: tok.bg,
            color: tok.fg,
            fontSize: 'var(--t-meta)',
            fontWeight: 600,
            whiteSpace: 'nowrap',
          }}
        >
          {r.status}
        </span>
      </td>
      <td style={{ ...td, color: 'var(--text2)', whiteSpace: 'nowrap' }}>{r.paidBy ?? '—'}</td>
      <td style={td}>
        {/* §11.1 — an operational cost is traceable both ways. Rows without a
            link have nothing to open, so no control is drawn rather than a
            dead one. */}
        {r.link ? (
          <Link
            to={r.link.kind === 'Booking' ? `/rentals/${r.link.id}` : r.link.kind === 'Case' ? '/operations?queue=cases' : '/inventory'}
            style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--link)', textDecoration: 'none', whiteSpace: 'nowrap' }}
          >
            {r.link.id}
          </Link>
        ) : (
          <span style={{ color: 'var(--muted)', fontSize: 'var(--t-meta)' }}>—</span>
        )}
      </td>
    </tr>
  )
}

/**
 * The CSV body — the rows the filters currently select, not the whole ledger.
 *
 * Exporting everything regardless of the filter bar is the version of this
 * button people quietly assume they got; it is also the version that makes an
 * export disagree with the total printed above it. `ReportToolbar` writes the
 * period and branch into the file's header, so the file says which rows these
 * are.
 *
 * Money is written the way the screen shows it, through `formatMoney` — same
 * figure in the file as on the page. Note the cost: `Rs 85,000` is text to a
 * spreadsheet, not a number to sum. `Pulse`'s export made the same trade; a
 * second raw-paisa column is the fix and it is a decision about what these
 * files are for, so it is not made here.
 */
function expensesCsv(rows: ExpenseRow[]): ReportCsvRow[] {
  const header: ReportCsvRow = [
    'Expense ID',
    'Bill No',
    'Date (AD)',
    'Date (BS)',
    'Category',
    'Sub-category',
    'Vendor',
    'Description',
    'Amount',
    'Reclaimable VAT',
    'Payment Method',
    'Status',
    'Paid By',
    'Submitted By',
    'Branch',
    'Recurring',
    'Linked to',
  ]
  return [
    header,
    ...rows.map((r): ReportCsvRow => {
      const bs = toBs(r.date)
      return [
        r.id,
        r.billNo ?? '',
        formatAd(r.date),
        bs ? formatBs(bs) : '',
        r.category,
        r.subCategory,
        r.vendor,
        r.description,
        formatMoney(r.amount),
        // §4.3 — null is "no tax invoice", which is not the same as zero credit.
        r.vat === null ? '' : formatMoney(r.vat),
        r.method,
        r.status,
        r.paidBy ?? '',
        r.submittedBy,
        r.branch,
        r.recurring ? 'Yes' : 'No',
        r.link ? `${r.link.kind} ${r.link.id}` : '',
      ]
    }),
  ]
}

/**
 * BUG-006 — why `Import` and `New Expense` cannot act, stated once and read by
 * both places they render (the page header and the Quick Actions rail).
 *
 * Keyed by the label so `QUICK_ACTIONS.map` can look its own reason up: adding
 * a third quick action without a reason for it is then a compile error, not a
 * third dead button. That is the same trick the `STATUS_ICON` retype used for
 * BUG-001 — make the honesty the type's job rather than a reviewer's.
 */
const EXPENSE_UNAVAILABLE: Record<(typeof QUICK_ACTIONS)[number]['label'], string> = {
  Import:
    'Importing expenses is not built yet — no file format is settled, and nothing in the app writes an expense row for an import to land in.',
  'New Expense':
    'Recording an expense is not built yet — this screen reads a seed fixture, and no action writes to the expenses table. Record expenses in your books until it ships.',
}

const quickStyle = {
  ...cardStyle,
  padding: '11px 8px',
  display: 'flex',
  flexDirection: 'column' as const,
  alignItems: 'center',
  gap: 6,
  fontSize: 'var(--t-meta)',
  fontWeight: 600,
  color: 'var(--text2)',
  fontFamily: 'inherit',
  cursor: 'pointer',
  textAlign: 'center' as const,
}
</file>

<file path="src/modules/reports/InventoryReports.tsx">
import { Link } from 'react-router-dom'
import { PageHeader, KpiStrip, cardStyle } from '../../components/ui/Page'
import { DataTableShell } from '../../components/ui/DataTable'
import { ReportToolbar } from '../../components/ui/ReportToolbar'
import { PageBody } from '../../components/ui/PageBody'
import { useLoad } from '../../lib/queries/useLoad'
import type { ReportCsvRow } from '../../components/ui/ReportToolbar'
import { getInventoryReportSummary, sharePercent, type InventoryReportSummary } from '../../lib/queries/inventoryReports'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import { useViewport } from '../../lib/device'
import ShortageSection from './ShortageSection'

const NOT_MEASURED = 'not measured'
const NOT_TRACKED = 'not tracked yet'

/**
 * The export body — the same figures the page shows, no more.
 *
 * Counts come from `product_units_v.status` (no money). Utilization and
 * inventory accuracy have no source and export as "not measured"; category
 * value has none and, being money, is only named for roles that may see money
 * (Law 6) — a money-blind role's file carries no trace of it.
 * RULING 2026-10-06: Law 16 — the seeded figures are gone.
 */
export function inventoryCsv(summary: InventoryReportSummary | null, money: boolean): ReportCsvRow[] {
  const count = (n: number | undefined): string | number => (summary && n !== undefined ? n : NOT_MEASURED)
  return [
    ['Figure', 'Value'],
    ['Total units (incl. Retired)', count(summary?.totalUnits)],
    ['Active units (excl. Retired)', count(summary?.activeUnits)],
    ['In stock', count(summary?.inStock)],
    ['Utilization', NOT_MEASURED],
    ['Inventory accuracy', NOT_MEASURED],
    [],
    ['Units by status'],
    ['Status', 'Count', 'Share of all units'],
    ...(summary?.byStatus ?? []).map((r): ReportCsvRow => {
      const pct = sharePercent(r.count, summary?.totalUnits ?? 0)
      return [r.status, r.count, pct === null ? NOT_MEASURED : `${pct}%`]
    }),
    ...(money ? ([[], ['Top categories by value', NOT_TRACKED]] as ReportCsvRow[]) : []),
  ]
}

export default function InventoryReports() {
  const money = useCanViewMoney()
  const viewport = useViewport()
  /* Phase 6 — one read, one ladder. A failed count used to print "Could not
     load unit counts" with no Retry, and the KPIs read "…" then "Unavailable";
     both now come from `PageBody` (skeleton · banner with Retry · nothing-yet). */
  const load = useLoad<InventoryReportSummary>(getInventoryReportSummary)
  const summary = load.data

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
      <PageHeader
        icon="box"
        title="Inventory Reports"
        description="Unit counts by lifecycle state. Figures with no source yet say so."
      />

      {/* Export only — a status snapshot has no date or warehouse axis to narrow. */}
      <ReportToolbar title="Inventory Reports" csv={{ filename: 'inventory-reports', build: () => inventoryCsv(summary, money) }} />

      {/* §4.41(a): until 6fb1c62 this route rendered ProductReports; the
          restructure swapped screens without rehoming the old one. Now that it
          lives at /reports/products, this line is the way back — the register
          cannot carry it (43-count pinned by rulings §11.3). */}
      <div style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
        Product sales, turnover, dead stock and supplier performance moved to{' '}
        <Link to="/reports/products" style={{ color: 'var(--link)', fontWeight: 600, textDecoration: 'none' }}>
          Product Reports
        </Link>
      </div>

      <PageBody
        noun="unit counts"
        loading={load.loading}
        error={load.error}
        onRetry={load.reload}
        hasRows={summary !== null}
        skeleton="kpi"
        empty={summary !== null && summary.totalUnits === 0}
        emptyTitle="No units recorded yet"
        emptyMessage="Unit counts appear here once the first piece of equipment is added to Inventory."
      >
      {summary && (
        <>
      {/* Real counts only (Law 16). A figure with no source reads "Not measured",
          never 0 or a plausible default. */}
      <KpiStrip
        columns={viewport === 'phone' ? 1 : viewport === 'tablet' ? 2 : 4}
        items={[
          { label: 'Total Assets', value: String(summary.activeUnits), icon: 'box', accent: 'primary', note: 'Units not retired' },
          { label: 'Utilization', value: 'Not measured', icon: 'activity', accent: 'progress', note: 'No rate-over-time source yet' },
          { label: 'Available', value: String(summary.inStock), icon: 'check', accent: 'success', note: 'Units In Stock right now' },
          { label: 'Inventory Accuracy', value: 'Not measured', icon: 'checklist', accent: 'success', note: 'Needs audit variance data' },
        ]}
      />

      <section aria-label="Units by status" style={cardStyle}>
        <div style={{ fontSize: 'var(--t-body)', fontWeight: 600, padding: 'var(--sp-md)', borderBottom: '1px solid var(--border)' }}>Units by Status</div>
          <DataTableShell ariaLabel="Units by Status">
            <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: 'var(--t-meta)' }}>
              <thead>
                <tr style={{ color: 'var(--text2)' }}>
                  <th style={{ padding: 'var(--sp-sm) var(--sp-md)' }}>Status</th>
                  <th style={{ padding: 'var(--sp-sm) var(--sp-md)' }}>Count</th>
                  <th style={{ padding: 'var(--sp-sm) var(--sp-md)' }}>Share of all units</th>
                </tr>
              </thead>
              <tbody>
                {summary.byStatus.map((r) => {
                  const pct = sharePercent(r.count, summary.totalUnits)
                  return (
                    <tr key={r.status} style={{ borderTop: '1px solid var(--border)' }}>
                      <td style={{ padding: 'var(--sp-sm) var(--sp-md)', fontWeight: 600 }}>{r.status}</td>
                      <td style={{ padding: 'var(--sp-sm) var(--sp-md)' }}>{r.count}</td>
                      <td style={{ padding: 'var(--sp-sm) var(--sp-md)' }}>{pct === null ? 'Not measured' : `${pct}%`}</td>
                    </tr>
                  )
                })}
              </tbody>
            </table>
          </DataTableShell>
      </section>
        </>
      )}
      </PageBody>

      {/* C7 — the one list of over-committed products for a period. Real holds and
          real stock. Outside the ladder above: it has its own read and its own
          states, and a failed unit count must not hide it. */}
      <ShortageSection />

      {money && (
        <section aria-label="Top Categories by Value" style={cardStyle}>
          <div style={{ fontSize: 'var(--t-body)', fontWeight: 600, padding: 'var(--sp-md)', borderBottom: '1px solid var(--border)' }}>Top Categories by Value</div>
          {/* TODO(decision): category valuation (purchase_price vs replacement_value) is unruled. */}
          <div style={{ padding: 'var(--sp-md)', fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>Not tracked yet.</div>
        </section>
      )}
    </div>
  )
}
</file>

<file path="src/modules/reports/OperationsReports.tsx">
import { formatAd, formatAdDateTime } from '../../lib/bs'
import { useMemo, useState } from 'react'
import { Link } from 'react-router-dom'
import { PageHeader, KpiStrip, cardStyle } from '../../components/ui/Page'
import type { Kpi } from '../../components/ui/Page'
import { DataTableShell } from '../../components/ui/DataTable'
import { PageBody } from '../../components/ui/PageBody'
import { useLoad } from '../../lib/queries/useLoad'
import { NOT_TRACKED } from '../../lib/queries/reportSupport'
import { reportFilterOptions, hasReportFilters, NoMatchRow } from './reportStates'
import { ReportToolbar } from '../../components/ui/ReportToolbar'
import type { ReportCsvRow, ReportFilters } from '../../components/ui/ReportToolbar'
import { Donut, Legend, type Slice } from '../../components/ui/Charts'
import Icon from '../../components/ui/Icon'
import { useViewport } from '../../lib/device'
import { getOperationsReport } from '../../lib/queries/operationReports'

/** A rate the read could not measure reads "Not tracked yet", never a plausible percentage (Law 16). */
const rate = (n: number | null): string => (n === null ? NOT_TRACKED : `${n}%`)

type OpTab = 'pickups' | 'returns' | 'overdue' | 'packing'

const th = {
  textAlign: 'left' as const,
  padding: '10px 12px',
  fontSize: 'var(--t-th)',
  fontWeight: 600,
  color: 'var(--text2)',
  whiteSpace: 'nowrap' as const,
  borderBottom: '1px solid var(--border)',
}

const td = {
  height: 'var(--row-min-h)',
  padding: '10px 12px',
  fontSize: 'var(--t-meta)',
  color: 'var(--text)',
  borderBottom: '1px solid var(--border)',
}

export default function OperationsReports() {
  const viewport = useViewport()
  const [activeTab, setActiveTab] = useState<OpTab>('pickups')
  const [filters, setFilters] = useState<ReportFilters>({})
  /* Phase 6 — the read used to return seed figures on failure, on an empty
     database, and per figure (`|| MOCK`); it now throws, and `PageBody` draws
     loading · Error + Retry · nothing-yet vs "nothing in this period". */
  const filtered = hasReportFilters(filters)
  const load = useLoad(() => getOperationsReport(reportFilterOptions(filters)), { key: JSON.stringify(filters) })
  const data = load.data
  const nothing =
    data !== null && data.deliveryMethods.length === 0 && data.pickups.length === 0 && data.returns.length === 0

  // Pickups KPI Strip
  const pickupKpis = useMemo<Kpi[]>(() => {
    if (!data) return []
    const m = data.metrics
    return [
      {
        label: 'Total Dispatches',
        value: String(m.totalPickups),
        icon: 'truck',
        accent: 'primary',
        note: 'Completed handover sessions',
      },
      {
        label: 'On-Time Handover',
        value: rate(m.onTimePickupRate),
        icon: 'timer',
        accent: 'neutral',
        note: 'No scheduled handover time is recorded to measure against',
      },
      {
        label: 'ID Verified',
        value: m.idVerificationRate === null ? '—' : `${m.idVerificationRate}%`,
        icon: 'check',
        accent: m.idVerificationRate === null ? 'neutral' : m.idVerificationRate >= 95 ? 'success' : 'warn',
        note: m.idVerificationRate === null ? 'No completed handover in this period' : 'Completed handovers with government ID verified',
      },
      {
        label: 'Pending Dispatches',
        value: String(data.packingJobs.filter((p) => p.state === 'packed').length),
        icon: 'box',
        accent: 'neutral',
        note: 'Staged and ready for client pickup',
      },
    ]
  }, [data])

  // Returns KPI Strip
  const returnKpis = useMemo<Kpi[]>(() => {
    if (!data) return []
    const m = data.metrics
    const countOf = (...conds: string[]) =>
      data.returnConditions.filter((c) => conds.includes(c.condition)).reduce((acc, c) => acc + c.count, 0)
    const cleanReturns = countOf('Excellent', 'Good')
    const damageReturns = countOf('Damaged', 'Lost')
    return [
      {
        label: 'Total Returns',
        value: String(m.totalReturns),
        icon: 'return_arrow',
        accent: 'primary',
        note: 'Return sessions in this period',
      },
      {
        label: 'On-Time Returns',
        value: m.onTimeReturnRate === null ? '—' : `${m.onTimeReturnRate}%`,
        icon: 'timer',
        accent: 'neutral',
        note: m.onTimeReturnRate === null ? 'No booking returned in this period' : 'Returned by the scheduled return time',
      },
      {
        label: 'Good or Better',
        value: m.totalReturns > 0 ? `${cleanReturns} (${Math.round((cleanReturns / m.totalReturns) * 100)}%)` : '0',
        icon: 'sparkles',
        accent: 'success',
        note: 'Worst inspected item Excellent or Good',
      },
      {
        label: 'Damaged or Lost',
        value: String(damageReturns),
        icon: 'alert_triangle',
        accent: damageReturns > 0 ? 'danger' : 'neutral',
        note: 'Sessions with a damaged or lost item',
      },
    ]
  }, [data])

  // Overdue KPI Strip
  const overdueKpis = useMemo<Kpi[]>(() => {
    if (!data) return []
    const m = data.metrics
    const severeCount = data.overdueList.filter((o) => o.severity === 'severe').length
    return [
      {
        label: 'Currently Overdue',
        value: String(m.currentlyOverdue),
        icon: 'alert_triangle',
        accent: m.currentlyOverdue > 0 ? 'danger' : 'neutral',
        note: 'Active rentals past return date',
      },
      {
        label: 'Critical (6+ Days)',
        value: String(severeCount),
        icon: 'alert_triangle',
        accent: severeCount > 0 ? 'danger' : 'neutral',
        note: 'Requires immediate case escalation',
      },
      {
        label: 'Grace Period (1–2 Days)',
        value: String(data.overdueList.filter((o) => o.severity === 'moderate').length),
        icon: 'timer',
        accent: 'warn',
        note: 'Late extension follow-up',
      },
      {
        label: 'Fleet At Risk',
        value: `${data.overdueList.length} Hires`,
        icon: 'box',
        accent: 'neutral',
        note: 'Unreturned equipment packages',
      },
    ]
  }, [data])

  // Packing KPI Strip
  const packingKpis = useMemo<Kpi[]>(() => {
    if (!data) return []
    const m = data.metrics
    const packedCount = data.packingJobs.filter((p) => p.state === 'packed').length
    const pendingCount = data.packingJobs.filter((p) => p.state === 'pending').length
    return [
      {
        label: 'Packing Jobs',
        value: String(m.totalPackingJobs),
        icon: 'box',
        accent: 'primary',
        note: 'Booked or Packed, not yet handed over',
      },
      {
        label: 'Fulfillment Rate',
        value: rate(m.packingFulfillmentRate),
        icon: 'chart',
        accent: 'neutral',
        note: 'Packing does not record verified-vs-expected lines yet',
      },
      {
        label: 'Staged & Ready',
        value: String(packedCount),
        icon: 'sparkles',
        accent: 'success',
        note: 'Packed awaiting handover',
      },
      {
        label: 'Pending Staging',
        value: String(pendingCount),
        icon: 'timer',
        accent: pendingCount > 0 ? 'warn' : 'neutral',
        note: 'Requires warehouse technician prep',
      },
    ]
  }, [data])

  // CSV rows generator
  const getCsvRows = (): ReportCsvRow[] => {
    if (activeTab === 'pickups') {
      return [
        ['Operations - Pickups & Handover Report'],
        ['Metric', 'Value'],
        ['Total Dispatches', data?.metrics.totalPickups ?? 0],
        ['On-Time Handover Rate', rate(data?.metrics.onTimePickupRate ?? null)],
        ['Government ID Verification Rate', data?.metrics.idVerificationRate == null ? '—' : `${data.metrics.idVerificationRate}%`],
        [],
        ['Delivery Methods Breakdown'],
        ['Method', 'Count', 'Share %'],
        ...(data?.deliveryMethods.map((dm): ReportCsvRow => [dm.method, dm.count, `${dm.percent}%`]) ?? []),
        [],
        ['Handover Sessions Log'],
        ['Booking No', 'Client', 'Pickup Time', 'Delivery Method', 'Receiver', 'ID Verified', 'Status'],
        ...(data?.pickups.map((p): ReportCsvRow => [
          p.bookingNo,
          p.clientName,
          p.pickupAt,
          p.deliveryType,
          p.receiverName,
          p.idVerified ? 'Yes' : 'No',
          p.status,
        ]) ?? []),
      ]
    } else if (activeTab === 'returns') {
      return [
        ['Operations - Returns & Check-in Inspections Report'],
        ['Metric', 'Value'],
        ['Total Returns', data?.metrics.totalReturns ?? 0],
        ['On-Time Return Rate', data?.metrics.onTimeReturnRate == null ? '—' : `${data.metrics.onTimeReturnRate}%`],
        [],
        ['Return Condition Breakdown'],
        ['Condition', 'Count', 'Share %'],
        ...(data?.returnConditions.map((rc): ReportCsvRow => [rc.condition, rc.count, `${rc.percent}%`]) ?? []),
        [],
        ['Return Sessions Log'],
        ['Booking No', 'Client', 'Return Time', 'Returning Person', 'Condition', 'Damaged or Lost'],
        ...(data?.returns.map((r): ReportCsvRow => [
          r.bookingNo,
          r.clientName,
          r.returnAt,
          r.returningPerson,
          r.condition,
          r.damageSuspected ? 'Yes' : 'No',
        ]) ?? []),
      ]
    } else if (activeTab === 'overdue') {
      return [
        ['Operations - Overdue Fleet Tracking Report'],
        ['Metric', 'Value'],
        ['Currently Overdue Bookings', data?.metrics.currentlyOverdue ?? 0],
        [],
        ['Overdue Bookings Log'],
        ['Booking No', 'Client', 'Project', 'Scheduled Return', 'Days Overdue', 'Severity', 'Delivery Method'],
        ...(data?.overdueList.map((o): ReportCsvRow => [
          o.bookingNo,
          o.clientName,
          o.project,
          o.scheduledReturn,
          o.daysOverdue,
          o.severity,
          o.deliveryType,
        ]) ?? []),
      ]
    } else {
      return [
        ['Operations - Packing & Prep Fulfillment Report'],
        ['Metric', 'Value'],
        ['Total Packing Jobs', data?.metrics.totalPackingJobs ?? 0],
        ['Packing Fulfillment Rate', rate(data?.metrics.packingFulfillmentRate ?? null)],
        [],
        ['Packing Jobs List'],
        ['Booking No', 'Client', 'Project', 'Pickup Scheduled', 'Item Count', 'State'],
        ...(data?.packingJobs.map((p): ReportCsvRow => [
          p.bookingNo,
          p.clientName,
          p.project,
          p.pickupScheduled,
          p.itemCount,
          p.state,
        ]) ?? []),
      ]
    }
  }

  // Slices for Donut charts
  const deliverySlices: Slice[] = useMemo(() => {
    if (!data) return []
    return data.deliveryMethods.map((dm) => ({
      label: dm.method,
      value: dm.count,
      display: `${dm.count} (${dm.percent}%)`,
      percent: `${dm.percent}%`,
    }))
  }, [data])

  const returnSlices: Slice[] = useMemo(() => {
    if (!data) return []
    return data.returnConditions.map((rc) => ({
      label: rc.condition,
      value: rc.count,
      display: `${rc.count} (${rc.percent}%)`,
      percent: `${rc.percent}%`,
    }))
  }, [data])

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
      <PageHeader
        icon="truck"
        title="Operations Reports"
        description="Dispatch handover fulfillment, return check-in inspections, overdue fleet tracking, and pre-flight packing jobs."
      />

      {/* Shared Toolbar */}
      <ReportToolbar
        title="Operations Reports"
        value={filters}
        onChange={setFilters}
        dateColumn="pickup_at"
        csv={{
          filename: `operations-${activeTab}`,
          build: getCsvRows,
        }}
      >
        <div
          role="group"
          aria-label="Operations report views"
          className="report-view-toggle"
          style={{ display: 'inline-flex' }}
        >
          {([
            ['Pickups & Handover', 'pickups'],
            ['Returns & Inspections', 'returns'],
            ['Overdue Fleet', 'overdue'],
            ['Packing Fulfillment', 'packing'],
          ] as const).map(([label, key]) => {
            const on = activeTab === key
            return (
              <button
                key={key}
                type="button"
                aria-pressed={on}
                onClick={() => setActiveTab(key)}
                className={`report-toggle-btn ${on ? 'is-active' : ''}`}
                style={{ minHeight: 44 }}
              >
                {label}
              </button>
            )
          })}
        </div>
      </ReportToolbar>

      <PageBody
        noun="operations figures"
        loading={load.loading}
        error={load.error}
        onRetry={load.reload}
        hasRows={data !== null}
        skeleton="kpi"
        empty={nothing}
        emptyIsFiltered={filtered}
        onClearFilters={() => setFilters({})}
        emptyTitle={filtered ? 'No operations in this period' : 'No operations yet'}
        emptyMessage={
          filtered
            ? 'Nothing was picked up in the selected period or branch. Clear the filters to see everything.'
            : 'Handovers, returns and packing appear here once the first booking is created.'
        }
      >
      {/* TAB 1: PICKUPS & HANDOVER */}
      {activeTab === 'pickups' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
          <KpiStrip items={pickupKpis} columns={viewport === 'phone' ? 1 : viewport === 'tablet' ? 2 : 4} />

          <div
            style={{
              display: 'grid',
              gridTemplateColumns: viewport === 'desktop' ? '1fr 1fr' : '1fr',
              gap: 'var(--sp-md)',
            }}
          >
            {/* Delivery Methods Chart */}
            <div style={cardStyle}>
              <h3 style={{ fontSize: 'var(--t-h3)', fontWeight: 600, marginBottom: 'var(--sp-sm)' }}>
                Handover Fulfillment Method
              </h3>
              <p style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', marginBottom: 'var(--sp-md)' }}>
                Client collection vs Babin vehicle delivery logistics.
              </p>
              {deliverySlices.length > 0 && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)', alignItems: 'center' }}>
                  <Donut slices={deliverySlices} size={180} />
                  <Legend slices={deliverySlices} />
                </div>
              )}
            </div>

          </div>

          {/* Pickups Table */}
          <div style={cardStyle}>
