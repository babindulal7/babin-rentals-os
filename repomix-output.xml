<file path="src/modules/reports/CasesReport.tsx">
import { formatAd } from '../../lib/bs'
import { useMemo, useState } from 'react'
import { Link } from 'react-router-dom'
import { PageHeader, KpiStrip, cardStyle } from '../../components/ui/Page'
import type { Kpi } from '../../components/ui/Page'
import { DataTableShell } from '../../components/ui/DataTable'
import { ReportToolbar, withinReportRange } from '../../components/ui/ReportToolbar'
import { PageBody } from '../../components/ui/PageBody'
import type { ReportCsvRow, ReportFilters } from '../../components/ui/ReportToolbar'
import { Donut, Legend, type Slice } from '../../components/ui/Charts'
import { ReportFamiliesNav } from '../../components/ui/ReportFamiliesNav'
import Icon from '../../components/ui/Icon'
import { formatMoney, rupees } from '../../lib/money'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import { useViewport } from '../../lib/device'
import { useLoad } from '../../lib/queries/useLoad'
import {
  listCases,
  type Case,
  CASE_TYPE_ICON,
  CASE_PRIORITY_META,
  CASE_STATUS_META,
} from '../../lib/queries/cases'

type CasesTab = 'overview' | 'financial' | 'types' | 'register'

const th = {
  textAlign: 'left' as const,
  padding: '10px 12px',
  fontSize: 'var(--t-th)',
  fontWeight: 600,
  color: 'var(--text2)',
  whiteSpace: 'nowrap' as const,
  borderBottom: '1px solid var(--border)',
}

const td = {
  height: 'var(--row-min-h)',
  padding: '10px 12px',
  fontSize: 'var(--t-meta)',
  color: 'var(--text)',
  borderBottom: '1px solid var(--border)',
}

export default function CasesReport() {
  const money = useCanViewMoney()
  const viewport = useViewport()
  const [activeTab, setActiveTab] = useState<CasesTab>('overview')
  const [filters, setFilters] = useState<ReportFilters>({})
  /*
   * Phase 6. The read used to be `void listCases().then(...)` with no catch:
   * `listCases` throws on a failed read (as it should), so a failure left the
   * page "Loading…" forever behind KPIs that read 0. `useLoad` turns the throw
   * into the Error state with Retry (worded as offline when it is).
   *
   * The toolbar's date range never narrowed anything — `listCases` was called
   * without it and does not apply `dateRange`. It is applied here, on the
   * client, with the toolbar's own comparison, so "no cases in this range" is
   * a real no-results state rather than the full register under a range that
   * says otherwise.
   */
  const load = useLoad(() => listCases())
  const allCases = useMemo<Case[]>(() => load.data?.rows ?? [], [load.data])
  const cases = useMemo(
    () => allCases.filter((c) => withinReportRange(c.openedAd, filters.dateRange)),
    [allCases, filters.dateRange],
  )

  // KPIs
  const kpis = useMemo<Kpi[]>(() => {
    const openCount = cases.filter((c) => !['Resolved', 'Closed'].includes(c.status)).length
    const totalAssessed = rupees(cases.reduce((sum, c) => sum + (c.assessedPaisa as number), 0))
    const totalRecovered = rupees(
      cases.reduce(
        (sum, c) =>
          sum +
          (c.chargedToClientPaisa as number) +
          (c.depositAppliedPaisa as number) +
          (c.insuranceClaimedPaisa as number) +
          (c.recoveredFromPartnerPaisa as number),
        0,
      ),
    )
    const totalAbsorbed = rupees(cases.reduce((sum, c) => sum + (c.absorbedPaisa as number), 0))
    const resolutionRate = cases.length > 0
      ? Math.round(((cases.length - openCount) / cases.length) * 100)
      : 0

    return [
      {
        label: 'Open Incident Cases',
        value: String(openCount),
        icon: 'alert_triangle',
        accent: openCount > 0 ? 'warn' : 'neutral',
        note: `${cases.length} total recorded cases`,
      },
      {
        label: 'Assessed Exposure',
        value: money ? formatMoney(totalAssessed) : '—',
        icon: 'dollar',
        accent: 'danger',
        note: money ? 'Total hardware risk evaluated' : /* Restricted (Law 6) */ "Restricted",
      },
      {
        label: 'Recovered Claims',
        value: money ? formatMoney(totalRecovered) : '—',
        icon: 'check',
        accent: 'success',
        note: money ? `${resolutionRate}% resolution rate` : /* Restricted (Law 6) */ "Restricted",
      },
      {
        label: 'Absorbed Loss',
        value: money ? formatMoney(totalAbsorbed) : '—',
        icon: 'arrow_down',
        accent: (totalAbsorbed as number) > 0 ? 'danger' : 'neutral',
        note: money ? 'Losses absorbed by Babin Rentals' : /* Restricted (Law 6) */ "Restricted",
      },
    ]
  }, [cases, money])

  // Priority Donut slices
  const prioritySlices: Slice[] = useMemo(() => {
    const counts: Record<string, number> = { Critical: 0, High: 0, Medium: 0, Low: 0 }
    cases.forEach((c) => {
      counts[c.priority] = (counts[c.priority] ?? 0) + 1
    })
    return Object.entries(counts).map(([pri, cnt]) => ({
      label: pri,
      value: cnt,
      display: `${cnt} cases`,
      percent: cases.length > 0 ? `${Math.round((cnt / cases.length) * 100)}%` : '0%',
    }))
  }, [cases])

  // Type Donut slices
  const typeSlices: Slice[] = useMemo(() => {
    const counts: Record<string, number> = {}
    cases.forEach((c) => {
      counts[c.type] = (counts[c.type] ?? 0) + 1
    })
    return Object.entries(counts).map(([type, cnt]) => ({
      label: type,
      value: cnt,
      display: `${cnt} cases`,
      percent: cases.length > 0 ? `${Math.round((cnt / cases.length) * 100)}%` : '0%',
    }))
  }, [cases])

  // Status breakdown
  const statusBreakdown = useMemo(() => {
    const counts: Record<string, number> = {}
    cases.forEach((c) => {
      counts[c.status] = (counts[c.status] ?? 0) + 1
    })
    return Object.entries(counts).map(([status, cnt]) => ({
      status,
      count: cnt,
      share: cases.length > 0 ? Math.round((cnt / cases.length) * 100) : 0,
    }))
  }, [cases])

  // CSV rows
  function getCsvRows(): ReportCsvRow[] {
    if (activeTab === 'financial') {
      return [
        ['Incident Cases Financial Impact Report'],
        ['Case No', 'Title', 'Assessed Cost', 'Charged Client', 'Deposit Applied', 'Insurance', 'Warranty', 'Absorbed'],
        ...cases.map((c): ReportCsvRow => [
          c.id,
          c.title,
          money ? formatMoney(c.assessedPaisa) : 'Restricted',
          money ? formatMoney(c.chargedToClientPaisa) : 'Restricted',
          money ? formatMoney(c.depositAppliedPaisa) : 'Restricted',
          money ? formatMoney(c.insuranceClaimedPaisa) : 'Restricted',
          money ? formatMoney(c.warrantyCoveredPaisa) : 'Restricted',
          money ? formatMoney(c.absorbedPaisa) : 'Restricted',
        ]),
      ]
    } else {
      return [
        ['Incident Cases Register'],
        ['Case No', 'Type', 'Title', 'Counterparty', 'Priority', 'Status', 'Opened Date', 'Assessed', 'Absorbed'],
        ...cases.map((c): ReportCsvRow => [
          c.id,
          c.type,
          c.title,
          c.counterpartyName,
          c.priority,
          c.status,
          formatAd(c.openedAd),
          money ? formatMoney(c.assessedPaisa) : 'Restricted',
          money ? formatMoney(c.absorbedPaisa) : 'Restricted',
        ]),
      ]
    }
  }

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
      <PageHeader
        icon="alert_triangle"
        title="Cases & Incident Reports"
        description="Incident logs, damage assessments, repair quotes, warranty claims, and client loss recovery."
      />

      <ReportFamiliesNav current="Cases" />

      <ReportToolbar
        title="Cases & Incident Reports"
        value={filters}
        onChange={setFilters}
        dateColumn="opened_at"
        csv={{
          filename: `cases-${activeTab}`,
          build: getCsvRows,
        }}
      >
        <div
          role="group"
          aria-label="Cases report views"
          className="report-view-toggle"
          style={{ display: 'inline-flex' }}
        >
          {([
            ['Incident Overview', 'overview'],
            ['Financial Impact', 'financial'],
            ['Incident Types', 'types'],
            ['Cases Register', 'register'],
          ] as const).map(([label, tab]) => {
            const active = activeTab === tab
            return (
              <button
                key={tab}
                type="button"
                className="tap"
                onClick={() => setActiveTab(tab)}
                aria-pressed={active}
                style={{
                  minHeight: 44,
                  padding: '0 14px',
                  fontSize: 'var(--t-meta)',
                  fontWeight: active ? 600 : 400,
                  border: '1px solid var(--border)',
                  background: active ? 'var(--select-bg)' : 'transparent',
                  color: active ? 'var(--select-fg)' : 'var(--text2)',
                  borderRadius:
                    tab === 'overview'
                      ? 'var(--rad-sm) 0 0 var(--rad-sm)'
                      : tab === 'register'
                        ? '0 var(--rad-sm) var(--rad-sm) 0'
                        : 0,
                  cursor: 'pointer',
                }}
              >
                {label}
              </button>
            )
          })}
        </div>
      </ReportToolbar>

      <PageBody
        noun="cases"
        loading={load.loading}
        error={load.error}
        onRetry={load.reload}
        hasRows={allCases.length > 0}
        skeleton="kpi"
        empty={load.data !== null && cases.length === 0}
        emptyIsFiltered={allCases.length > 0}
        onClearFilters={() => setFilters({})}
        {...(allCases.length === 0
          ? {
              emptyTitle: 'No incident cases yet',
              emptyMessage: 'Cases are opened from a return, a damage finding or the Cases queue. None has been opened.',
            }
          : { emptyTitle: 'No cases opened in this range' })}
      >
      {/* KPI Strip */}
      <KpiStrip items={kpis} columns={viewport === 'phone' ? 1 : viewport === 'tablet' ? 2 : 4} />

      {activeTab === 'overview' && (
        <div style={{ display: 'grid', gridTemplateColumns: viewport === 'phone' ? '1fr' : '320px 1fr', gap: 'var(--sp-md)', alignItems: 'start' }}>
          <div style={{ ...cardStyle, padding: 'var(--sp-md)', display: 'flex', flexDirection: 'column', alignItems: 'center' }}>
            <h4 style={{ margin: '0 0 var(--sp-md)', alignSelf: 'flex-start', fontSize: 'var(--t-h4)', color: 'var(--text)' }}>
              Priority Distribution
            </h4>
            <Donut slices={prioritySlices} size={180} />
            <div style={{ marginTop: 'var(--sp-md)', width: '100%' }}>
              <Legend slices={prioritySlices} />
            </div>
          </div>

          <DataTableShell ariaLabel="Active cases status distribution and workflow stage">
            <table style={{ width: '100%', borderCollapse: 'collapse' }}>
              <thead>
                <tr>
                  <th style={th}>Status</th>
                  <th style={th}>Case Count</th>
                  <th style={th}>Share of Total</th>
                  <th style={th}>Resolution State</th>
                </tr>
              </thead>
              <tbody>
                {statusBreakdown.map((s) => (
                  <tr key={s.status}>
                    <td style={td}>
                      <span
                        style={{
                          display: 'inline-flex',
                          alignItems: 'center',
                          padding: '2px 8px',
                          borderRadius: 'var(--rad-sm)',
                          fontSize: 'var(--t-micro)',
                          fontWeight: 600,
                          background:
                            s.status === 'Resolved' || s.status === 'Closed'
                              ? 'var(--success-surface)'
                              : s.status === 'Under Review' || s.status === 'Awaiting Decision'
                                ? 'var(--warn-surface)'
                                : 'var(--danger-surface)',
                          color:
                            s.status === 'Resolved' || s.status === 'Closed'
                              ? 'var(--success)'
                              : s.status === 'Under Review' || s.status === 'Awaiting Decision'
                                ? 'var(--warn)'
                                : 'var(--danger)',
                        }}
                      >
                        {s.status}
                      </span>
                    </td>
                    <td style={td} className="figure">{s.count}</td>
                    <td style={td} className="figure">{s.share}%</td>
                    <td style={td}>
                      {['Resolved', 'Closed'].includes(s.status) ? (
                        <span style={{ color: 'var(--success)' }}>Resolved</span>
                      ) : (
                        <span style={{ color: 'var(--warn)' }}>Pending Action</span>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </DataTableShell>
        </div>
      )}

      {activeTab === 'financial' && (
        <DataTableShell ariaLabel="Financial settlement, client billing, deposit coverage, and loss absorption">
          <table style={{ width: '100%', borderCollapse: 'collapse' }}>
            <thead>
              <tr>
                <th style={th}>Case No</th>
                <th style={th}>Incident Title</th>
                <th style={th}>Assessed Cost</th>
                <th style={th}>Billed to Client</th>
                <th style={th}>Deposit Applied</th>
                <th style={th}>Insurance / Partner</th>
                <th style={th}>Absorbed Loss</th>
              </tr>
            </thead>
            <tbody>
              {cases.map((c) => (
                <tr key={c.id}>
                  <td style={td}><strong>{c.id}</strong></td>
                  <td style={td}>{c.title}</td>
                  <td style={td} className="figure">{money ? formatMoney(c.assessedPaisa) : 'Restricted'}</td>
                  <td style={{ ...td, color: 'var(--success)' }} className="figure">
                    {money ? formatMoney(c.chargedToClientPaisa) : 'Restricted'}
                  </td>
                  <td style={td} className="figure">
                    {money ? formatMoney(c.depositAppliedPaisa) : 'Restricted'}
                  </td>
                  <td style={td} className="figure">
                    {money
                      ? formatMoney(rupees((c.insuranceClaimedPaisa as number) + (c.recoveredFromPartnerPaisa as number)))
                      : 'Restricted'}
                  </td>
                  <td
                    style={{ ...td, color: (c.absorbedPaisa as number) > 0 ? 'var(--danger)' : 'var(--text2)' }}
                    className="figure"
                  >
                    {money ? formatMoney(c.absorbedPaisa) : 'Restricted'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </DataTableShell>
      )}

      {activeTab === 'types' && (
        <div style={{ display: 'grid', gridTemplateColumns: viewport === 'phone' ? '1fr' : '320px 1fr', gap: 'var(--sp-md)', alignItems: 'start' }}>
          <div style={{ ...cardStyle, padding: 'var(--sp-md)', display: 'flex', flexDirection: 'column', alignItems: 'center' }}>
            <h4 style={{ margin: '0 0 var(--sp-md)', alignSelf: 'flex-start', fontSize: 'var(--t-h4)', color: 'var(--text)' }}>
              Incident Types
            </h4>
            <Donut slices={typeSlices} size={180} />
            <div style={{ marginTop: 'var(--sp-md)', width: '100%' }}>
              <Legend slices={typeSlices} />
            </div>
          </div>

          <DataTableShell ariaLabel="Breakdown of incident categories and occurrence volume">
            <table style={{ width: '100%', borderCollapse: 'collapse' }}>
              <thead>
                <tr>
                  <th style={th}>Incident Category</th>
                  <th style={th}>Total Incidents</th>
                  <th style={th}>Share of Total</th>
                  <th style={th}>Severity Profile</th>
                </tr>
              </thead>
              <tbody>
                {typeSlices.map((t) => (
                  <tr key={t.label}>
                    <td style={td}>
                      <span style={{ display: 'inline-flex', alignItems: 'center', gap: 6 }}>
                        <Icon name={CASE_TYPE_ICON[t.label as keyof typeof CASE_TYPE_ICON] ?? 'alert_triangle'} size={15} />
                        <strong>{t.label}</strong>
                      </span>
                    </td>
                    <td style={td} className="figure">{t.value}</td>
                    <td style={td} className="figure">{t.percent}</td>
                    <td style={td}>{t.label === 'Damage' ? 'Hardware Repairs' : t.label === 'Theft' ? 'Asset Replacement' : 'Operational Triage'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </DataTableShell>
        </div>
      )}

      {activeTab === 'register' && (
        <DataTableShell ariaLabel="Exhaustive register of all incident cases and claim settlements">
          {/* Loading and empty are drawn once, by the PageBody above. */}
            <table style={{ width: '100%', borderCollapse: 'collapse' }}>
              <thead>
                <tr>
                  <th style={th}>Case No</th>
                  <th style={th}>Type</th>
                  <th style={th}>Title</th>
                  <th style={th}>Counterparty</th>
                  <th style={th}>Priority</th>
                  <th style={th}>Status</th>
                  <th style={th}>Opened Date</th>
                  <th style={th}>Assessed Cost</th>
                  <th style={th}>Action</th>
                </tr>
              </thead>
              <tbody>
                {cases.map((c) => (
                  <tr key={c.id}>
                    <td style={td}><strong>{c.id}</strong></td>
                    <td style={td}>
                      <span style={{ display: 'inline-flex', alignItems: 'center', gap: 5 }}>
                        <Icon name={CASE_TYPE_ICON[c.type] ?? 'alert_triangle'} size={14} />
                        {c.type}
                      </span>
                    </td>
                    <td style={td}>{c.title}</td>
                    <td style={td}>{c.counterpartyName}</td>
                    <td style={td}>
                      <span style={{ color: `var(--${CASE_PRIORITY_META[c.priority]?.token ?? 'neutral'})` }}>
                        {c.priority}
                      </span>
                    </td>
                    <td style={td}>
                      <span
                        style={{
                          display: 'inline-flex',
                          alignItems: 'center',
                          gap: 4,
                          padding: '2px 8px',
                          borderRadius: 'var(--rad-sm)',
                          fontSize: 'var(--t-micro)',
                          fontWeight: 600,
                          background: 'var(--card-subtle)',
                        }}
                      >
                        <Icon name={CASE_STATUS_META[c.status]?.icon ?? 'flag'} size={12} />
                        {c.status}
                      </span>
                    </td>
                    <td style={td}>{formatAd(c.openedAd)}</td>
                    <td style={td} className="figure">{money ? formatMoney(c.assessedPaisa) : 'Restricted'}</td>
                    <td style={td}>
                      {c.linked?.linkedRecordId ? (
                        <Link
                          to={`/rentals/${c.linked.linkedRecordId}`}
                          style={{ color: 'var(--link)', fontWeight: 600, textDecoration: 'none' }}
                        >
                          View Booking
                        </Link>
                      ) : (
                        '—'
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
        </DataTableShell>
      )}
      </PageBody>
    </div>
  )
}
</file>

<file path="src/modules/reports/CashFlowReport.tsx">
import { useState } from 'react'
import { PageHeader, KpiStrip, cardStyle } from '../../components/ui/Page'
import type { Kpi } from '../../components/ui/Page'
import { DataTableShell } from '../../components/ui/DataTable'
import { PageBody } from '../../components/ui/PageBody'
import { ReportToolbar } from '../../components/ui/ReportToolbar'
import type { ReportCsvRow, ReportFilters } from '../../components/ui/ReportToolbar'
import { formatMoney, type Paisa } from '../../lib/money'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import { useViewport } from '../../lib/device'
import { useLoad } from '../../lib/queries/useLoad'
import { NOT_TRACKED } from '../../lib/queries/reportSupport'
import { getCashFlowSummary, type CashFlowSummary } from '../../lib/queries/liquidity'
import { reportFilterOptions, hasReportFilters, NoMatchRow } from './reportStates'

const cell = { padding: 'var(--sp-sm) var(--sp-md)' } as const
const right = { ...cell, textAlign: 'right' as const, fontVariantNumeric: 'tabular-nums' as const }
const signed = (p: Paisa) => (p < 0 ? `− ${formatMoney(Math.abs(p) as Paisa)}` : formatMoney(p))

interface StatementLine {
  label: string
  amount: Paisa | null
  note?: string
}

function statement(s: CashFlowSummary): StatementLine[] {
  return [
    { label: 'Opening cash', amount: null, note: 'No bank balance is recorded' },
    { label: 'Cash in — rental collections', amount: s.collected },
    { label: 'Cash out — refunds', amount: -s.refunds as Paisa },
    { label: 'Cash out — expenses paid', amount: -s.expensesPaid as Paisa },
    { label: 'Net operating cash', amount: s.netOperatingCash },
    { label: 'Cash out — equipment purchase', amount: null, note: 'Capital spend is not recorded' },
    { label: 'Closing cash', amount: null, note: 'Needs the opening balance' },
  ]
}

/** The export body — the statement, deposits and expense lines, as drawn. */
function cashFlowCsv(s: CashFlowSummary | null): ReportCsvRow[] {
  if (!s) return []
  return [
    ['Line', 'Amount'],
    ...statement(s).map((l): ReportCsvRow => [l.label, l.amount === null ? NOT_TRACKED : signed(l.amount)]),
    [],
    ['Deposits received (held in trust)', formatMoney(s.depositsReceived)],
    ['Deposits released', formatMoney(s.depositsReleased)],
    ['Invoiced in period', formatMoney(s.invoiced)],
    ['Collection rate', s.collectionRatePct === null ? '—' : `${s.collectionRatePct}%`],
    [],
    ['Expense category', 'Paid'],
    ...s.expensesByCategory.map((c): ReportCsvRow => [c.category, formatMoney(c.amount)]),
  ]
}

/**
 * Cash Flow.
 *
 * Phase 6 + Law 16: this page rendered one invented closed month from
 * `data/liquidityReports` whatever the read returned (and the read itself
 * could not succeed — see `liquidity.ts`). It now draws the period's real
 * collections, refunds, paid expenses and deposit movements through `useLoad`
 * + `PageBody`; opening/closing cash, capital spend and runway say "Not
 * tracked yet". Deposits are shown apart from own cash (Law 4).
 */
export default function CashFlowReport() {
  const canSeeMoney = useCanViewMoney()
  const viewport = useViewport()
  const [filters, setFilters] = useState<ReportFilters>({})
  const filtered = hasReportFilters(filters)
  // Law 6 — a money-blind role never sends the read.
  const load = useLoad(() => getCashFlowSummary(reportFilterOptions(filters)), {
    key: JSON.stringify(filters),
    enabled: canSeeMoney,
  })
  const s = load.data

  if (!canSeeMoney) {
    return (
      <>
        <PageHeader title="Cash Flow" description="Finance ▸ Reports" />
        <PageBody
          restricted
          restrictedReason="Cash reporting is money end to end — every line of the statement and every figure."
          restrictedRequiredRole="Owner, Admin, Coordinator or Accounts"
        >
          {null}
        </PageBody>
      </>
    )
  }

  const nothing =
    s !== null && s.collected === 0 && s.refunds === 0 && s.expensesPaid === 0 && s.depositsReceived === 0 && s.depositsReleased === 0 && s.invoiced === 0

  const kpis: Kpi[] = s
    ? [
        { label: 'Net operating cash', value: signed(s.netOperatingCash), icon: 'chart', accent: s.netOperatingCash >= 0 ? 'success' : 'danger', note: 'Collections − refunds − expenses paid' },
        {
          label: 'Cash collected',
          value: formatMoney(s.collected),
          icon: 'dollar',
          accent: 'primary',
          note: s.collectionRatePct === null ? 'Nothing invoiced in this period' : `${s.collectionRatePct}% of ${formatMoney(s.invoiced)} invoiced`,
          definition: 'Payments received against invoices issued in the period.',
        },
        { label: 'Deposits received', value: formatMoney(s.depositsReceived), icon: 'card', accent: 'neutral', note: `Held in trust, not own cash · ${formatMoney(s.depositsReleased)} released` },
        { label: 'Closing cash', value: NOT_TRACKED, icon: 'activity', accent: 'neutral', note: 'No bank balance is recorded', definition: 'Own funds on hand at period end; excludes client deposits held in trust.' },
      ]
    : []

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
      <PageHeader title="Cash Flow" description="Cash basis · NPR · collections, refunds and paid expenses for the period" />

      <ReportToolbar
        title="Cash Flow"
        value={filters}
        onChange={setFilters}
        dateColumn="payment_date"
        csv={{ filename: 'cash-flow', build: () => cashFlowCsv(s) }}
      />

      <PageBody
        noun="cash figures"
        loading={load.loading}
        error={load.error}
        onRetry={load.reload}
        hasRows={s !== null}
        skeleton="kpi"
        empty={nothing}
        emptyIsFiltered={filtered}
        onClearFilters={() => setFilters({})}
        emptyTitle={filtered ? 'No cash movement in this period' : 'No cash movement recorded yet'}
        emptyMessage={
          filtered
            ? 'No payment, refund, paid expense, deposit or invoice falls in the selected period.'
            : 'Cash figures appear here once payments, expenses or deposits are recorded.'
        }
      >
        {s && (
          <>
            <KpiStrip columns={viewport === 'phone' ? 1 : viewport === 'tablet' ? 2 : 4} items={kpis} />

            <section aria-label="Cash movement" style={cardStyle}>
              <div style={{ fontSize: 'var(--t-body)', fontWeight: 600, padding: 'var(--sp-md)', borderBottom: '1px solid var(--border)' }}>Cash movement</div>
              <DataTableShell ariaLabel="Cash movement">
                <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: 'var(--t-meta)' }}>
                  <tbody>
                    {statement(s).map((l) => (
                      <tr key={l.label} style={{ borderTop: '1px solid var(--border)' }}>
                        <td style={{ ...cell, fontWeight: l.label.startsWith('Net') ? 600 : 400 }}>
                          {l.label}
                          {l.note && <div style={{ fontSize: 'var(--t-micro)', color: 'var(--text2)' }}>{l.note}</div>}
                        </td>
                        <td style={{ ...right, color: l.amount === null ? 'var(--text2)' : 'var(--text)' }}>
                          {l.amount === null ? NOT_TRACKED : signed(l.amount)}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </DataTableShell>
            </section>

            <section aria-label="Expenses paid by category" style={cardStyle}>
              <div style={{ fontSize: 'var(--t-body)', fontWeight: 600, padding: 'var(--sp-md)', borderBottom: '1px solid var(--border)' }}>Expenses paid by category</div>
              <DataTableShell ariaLabel="Expenses paid by category">
                <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: 'var(--t-meta)' }}>
                  <tbody>
                    {s.expensesByCategory.length === 0 && <NoMatchRow colSpan={2} noun="paid expenses" />}
                    {s.expensesByCategory.map((c) => (
                      <tr key={c.category} style={{ borderTop: '1px solid var(--border)' }}>
                        <td style={{ ...cell, fontWeight: 600 }}>{c.category}</td>
                        <td style={right}>{formatMoney(c.amount)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </DataTableShell>
            </section>
          </>
        )}
      </PageBody>
    </div>
  )
}
</file>

<file path="src/modules/reports/RentalReports.tsx">
import { formatAd } from '../../lib/bs'
import { useMemo, useState } from 'react'
import { Link } from 'react-router-dom'
import { PageHeader, Button, KpiStrip, cardStyle } from '../../components/ui/Page'
import type { Kpi } from '../../components/ui/Page'
import { DataTableShell } from '../../components/ui/DataTable'
import { PageBody } from '../../components/ui/PageBody'
import { useLoad } from '../../lib/queries/useLoad'
import { NOT_TRACKED } from '../../lib/queries/reportSupport'
import { reportFilterOptions, hasReportFilters, NoMatchRow } from './reportStates'
import { ReportToolbar } from '../../components/ui/ReportToolbar'
import type { ReportCsvRow, ReportFilters } from '../../components/ui/ReportToolbar'
import { Donut, Legend, HBars, type Slice } from '../../components/ui/Charts'
import Icon from '../../components/ui/Icon'
import { formatMoney, type Paisa } from '../../lib/money'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import { useViewport } from '../../lib/device'
import {
  getRentalPerformanceReport,
  getRentalDurationReport,
  getCancellationsReport,
} from '../../lib/queries/rentalReports'

type RentalTab = 'performance' | 'duration' | 'cancellations'

const th = {
  textAlign: 'left' as const,
  padding: '10px 12px',
  fontSize: 'var(--t-th)',
  fontWeight: 600,
  color: 'var(--text2)',
  whiteSpace: 'nowrap' as const,
  borderBottom: '1px solid var(--border)',
}

const td = {
  height: 'var(--row-min-h)',
  padding: '10px 12px',
  fontSize: 'var(--t-meta)',
  color: 'var(--text)',
  borderBottom: '1px solid var(--border)',
}

export default function RentalReports() {
  const money = useCanViewMoney()
  const viewport = useViewport()
  const [activeTab, setActiveTab] = useState<RentalTab>('performance')
  const [filters, setFilters] = useState<ReportFilters>({})
  const [searchQuery, setSearchQuery] = useState('')

  /* Phase 6 — one read for the three tabs, one ladder. These queries used to
     return seed figures on failure and on an empty period (Law 16); they now
     throw, and `PageBody` draws loading · Error + Retry · nothing-yet vs
     "nothing in this period". */
  const filtered = hasReportFilters(filters)
  const load = useLoad(
    () => {
      const opts = reportFilterOptions(filters)
      return Promise.all([getRentalPerformanceReport(opts), getRentalDurationReport(opts), getCancellationsReport(opts)])
    },
    { key: JSON.stringify(filters) },
  )
  const [perfData, durationData, cancelData] = load.data ?? [null, null, null]

  // Performance KPI strip
  const performanceKpis = useMemo<Kpi[]>(() => {
    if (!perfData) return []
    const m = perfData.metrics
    return [
      {
        label: 'Total Bookings',
        value: String(m.totalBookings),
        icon: 'box',
        accent: 'primary',
        note: `${m.completedRentals} completed · ${m.activeRentals} active`,
      },
      {
        label: 'Rental Revenue',
        value: money ? formatMoney(m.totalRevenue) : '—',
        icon: 'dollar',
        accent: 'success',
        note: money ? `Avg ${formatMoney(m.averageBookingValue)} / booking` : /* Restricted (Law 6) */ "Restricted",
        definition: 'Rental revenue from confirmed bookings in the period, excluding deposits (liabilities).',
      },
      {
        label: 'Rental Days',
        value: String(m.totalRentalDays),
        icon: 'calendar',
        accent: 'neutral',
        note: `Avg ${m.averageDurationDays} days / rental`,
      },
      {
        label: 'Cancellations',
        value: String(m.cancelledRentals),
        icon: 'alert_triangle',
        accent: m.cancelledRentals > 0 ? 'danger' : 'neutral',
        note: `${((m.cancelledRentals / (m.totalBookings || 1)) * 100).toFixed(1)}% cancellation rate`,
      },
    ]
  }, [perfData, money])

  // Duration KPI strip
  const durationKpis = useMemo<Kpi[]>(() => {
    if (!durationData) return []
    return [
      {
        label: 'Average Duration',
        value: `${durationData.averageDuration} Days`,
        icon: 'timer',
        accent: 'primary',
        note: `Median ${durationData.medianDuration} days`,
      },
      {
        label: 'Shortest Rental',
        value: `${durationData.shortestDuration} Day`,
        icon: 'calendar',
        accent: 'neutral',
        note: 'Shortest non-cancelled booking',
      },
      {
        label: 'Longest Rental',
        value: `${durationData.longestDuration} Days`,
        icon: 'calendar',
        accent: 'progress',
        note: 'Longest non-cancelled booking',
      },
      {
        label: 'Total Analyzed',
        value: String(durationData.totalRentals),
        icon: 'box',
        accent: 'neutral',
        note: 'Non-cancelled bookings',
      },
    ]
  }, [durationData])

  // Cancellations KPI strip
  const cancellationKpis = useMemo<Kpi[]>(() => {
    if (!cancelData) return []
    return [
      {
        label: 'Total Cancellations',
        value: String(cancelData.totalCancellations),
        icon: 'alert_triangle',
        accent: 'danger',
        note: 'Terminal booking dropouts',
      },
      {
        label: 'Cancellation Rate',
        value: `${cancelData.cancellationRate}%`,
        icon: 'chart',
        accent: cancelData.cancellationRate > 10 ? 'danger' : 'warn',
        note: 'Against total booking volume',
      },
      {
        label: 'Lost Revenue',
        value: money ? formatMoney(cancelData.totalLostRevenue) : '—',
        icon: 'dollar',
        accent: 'danger',
        note: money ? 'Unrealized quote & booking total' : /* Restricted (Law 6) */ "Restricted",
        definition: 'Revenue lost from cancelled bookings; sum of their rental totals.',
      },
      {
        label: 'Average Notice',
        value: cancelData.averageNoticeDays === null ? '—' : `${cancelData.averageNoticeDays} Days`,
        icon: 'timer',
        accent: 'neutral',
        note: cancelData.averageNoticeDays === null ? 'No cancellation in this period' : 'Lead time before pickup',
      },
    ]
  }, [cancelData, money])

  // CSV export generator across tabs
  const getCsvRows = (): ReportCsvRow[] => {
    if (activeTab === 'performance') {
      const rows: ReportCsvRow[] = [
        ['Rental Performance Report'],
        ['Metric', 'Value'],
        ['Total Bookings', perfData?.metrics.totalBookings ?? 0],
        ['Active Rentals', perfData?.metrics.activeRentals ?? 0],
        ['Completed Rentals', perfData?.metrics.completedRentals ?? 0],
        ['Cancelled Rentals', perfData?.metrics.cancelledRentals ?? 0],
        ['Total Revenue', money ? formatMoney(perfData?.metrics.totalRevenue ?? (0 as Paisa)) : 'Restricted'],
        ['Avg Booking Value', money ? formatMoney(perfData?.metrics.averageBookingValue ?? (0 as Paisa)) : 'Restricted'],
        ['Total Rental Days', perfData?.metrics.totalRentalDays ?? 0],
        ['Avg Duration Days', perfData?.metrics.averageDurationDays ?? 0],
        [],
        ['Stage Breakdown'],
        ['Stage', 'Count', 'Revenue', 'Share %'],
        ...(perfData?.stages.map((st): ReportCsvRow => [
          st.stage,
          st.count,
          money ? formatMoney(st.revenue) : 'Restricted',
          `${st.percent}%`,
        ]) ?? []),
        [],
        ['Project Types Breakdown'],
        ['Project Type', 'Count', 'Revenue', 'Share %'],
        ...(perfData?.projectTypes === null ? [[NOT_TRACKED] as ReportCsvRow] : []),
        ...(perfData?.projectTypes?.map((pt): ReportCsvRow => [
          pt.projectType,
          pt.count,
          money ? formatMoney(pt.revenue) : 'Restricted',
          `${pt.percent}%`,
        ]) ?? []),
        [],
        ['Top Bookings'],
        ['Booking No', 'Client', 'Project', 'Days', 'Stage', 'Value'],
        ...(perfData?.topBookings.map((b): ReportCsvRow => [
          b.bookingNo,
          b.clientName,
          b.project,
          b.days,
          b.stage,
          money ? formatMoney(b.value) : 'Restricted',
        ]) ?? []),
      ]
      return rows
    } else if (activeTab === 'duration') {
      const rows: ReportCsvRow[] = [
        ['Rental Duration Distribution Report'],
        ['Metric', 'Value'],
        ['Total Rentals', durationData?.totalRentals ?? 0],
        ['Average Duration', `${durationData?.averageDuration ?? 0} Days`],
        ['Median Duration', `${durationData?.medianDuration ?? 0} Days`],
        [],
        ['Duration Buckets'],
        ['Bucket', 'Bookings Count', 'Share %', 'Total Equipment Days', 'Revenue', 'Avg Daily Rate'],
        ...(durationData?.buckets.map((b): ReportCsvRow => [
          b.label,
          b.count,
          `${b.sharePercent}%`,
          b.totalDays,
          money ? formatMoney(b.revenue) : 'Restricted',
          money ? formatMoney(b.avgDailyRate) : 'Restricted',
        ]) ?? []),
      ]
      return rows
    } else {
      const rows: ReportCsvRow[] = [
        ['Cancellations & Lost Quotes Report'],
        ['Metric', 'Value'],
        ['Total Cancellations', cancelData?.totalCancellations ?? 0],
        ['Cancellation Rate', `${cancelData?.cancellationRate ?? 0}%`],
        ['Total Lost Revenue', money ? formatMoney(cancelData?.totalLostRevenue ?? (0 as Paisa)) : 'Restricted'],
        ['Avg Notice Days', cancelData?.averageNoticeDays == null ? '—' : `${cancelData.averageNoticeDays} Days`],
        [],
        ['Cancellation Reasons'],
        ['Reason', 'Count', 'Share %', 'Lost Revenue'],
        ...(cancelData?.reasons.map((r): ReportCsvRow => [
          r.reason,
          r.count,
          `${r.percent}%`,
          money ? formatMoney(r.lostRevenue) : 'Restricted',
        ]) ?? []),
        [],
        ['Cancelled Bookings Log'],
        ['Booking No', 'Client', 'Project', 'Cancelled Date', 'Scheduled Pickup', 'Lost Revenue', 'Reason'],
        ...(cancelData?.cancelledBookings.map((cb): ReportCsvRow => [
          cb.bookingNo,
          cb.clientName,
          cb.project,
          cb.cancelledAt,
          cb.scheduledPickup,
          money ? formatMoney(cb.lostRevenue) : 'Restricted',
          cb.reason,
        ]) ?? []),
      ]
      return rows
    }
  }

  // Slices for Donut charts
  const stageSlices: Slice[] = useMemo(() => {
    if (!perfData) return []
    return perfData.stages.map((st) => ({
      label: st.stage,
      value: st.count,
      display: `${st.count} bookings`,
      percent: `${st.percent}%`,
    }))
  }, [perfData])

  const reasonSlices: Slice[] = useMemo(() => {
    if (!cancelData) return []
    return cancelData.reasons.map((r) => ({
      label: r.reason,
      value: r.count,
      display: `${r.count} (${r.percent}%)`,
      percent: `${r.percent}%`,
    }))
  }, [cancelData])

  const durationBars = useMemo(() => {
    if (!durationData) return []
    return durationData.buckets.map((b) => ({
      label: b.label,
      value: b.count,
      display: `${b.count} bookings (${b.sharePercent}%)`,
    }))
  }, [durationData])

  const filteredTopBookings = useMemo(() => {
    if (!perfData?.topBookings) return []
    if (!searchQuery.trim()) return perfData.topBookings
    const q = searchQuery.toLowerCase().trim()
    return perfData.topBookings.filter(
      (b) =>
        b.bookingNo.toLowerCase().includes(q) ||
        b.clientName.toLowerCase().includes(q) ||
        b.project.toLowerCase().includes(q),
    )
  }, [perfData?.topBookings, searchQuery])

  const filteredCancelledBookings = useMemo(() => {
    if (!cancelData?.cancelledBookings) return []
    if (!searchQuery.trim()) return cancelData.cancelledBookings
    const q = searchQuery.toLowerCase().trim()
    return cancelData.cancelledBookings.filter(
      (b) =>
        b.bookingNo.toLowerCase().includes(q) ||
        b.clientName.toLowerCase().includes(q) ||
        b.project.toLowerCase().includes(q) ||
        b.reason.toLowerCase().includes(q),
    )
  }, [cancelData?.cancelledBookings, searchQuery])

  const handleExportCsv = () => {
    const rows = getCsvRows()
    const cell = (v: string | number) => `"${String(v).replace(/"/g, '""')}"`
    const body = rows.map((r) => r.map(cell).join(',')).join('\r\n')
    const blob = new Blob([body], { type: 'text/csv;charset=utf-8' })
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url
    a.download = `rentals-${activeTab}.csv`
    a.click()
    URL.revokeObjectURL(url)
  }

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
      <PageHeader
        icon="calendar"
        title="Rentals Reports"
        description="Comprehensive analysis of rental turnover, duration distribution, and lost quote cancellations."
        status={
          <span className="badge badge-neutral" style={{ textTransform: 'capitalize', fontWeight: 600 }}>
            {activeTab}
          </span>
        }
        search={{
          value: searchQuery,
          onChange: setSearchQuery,
          onClear: () => setSearchQuery(''),
          placeholder: 'Search report data…',
          ariaLabel: 'Search report bookings and projects',
        }}
        actions={
          <Button icon="download" onClick={handleExportCsv} aria-label="Export CSV report">
            Export CSV
          </Button>
        }
      />

      {/* Shared Toolbar */}
      <ReportToolbar
        title="Rentals Reports"
        value={filters}
        onChange={setFilters}
        dateColumn="pickup_at"
        csv={{
          filename: `rentals-${activeTab}`,
          build: getCsvRows,
        }}
      >
        <div
          role="group"
          aria-label="Rental report views"
          className="report-view-toggle"
          style={{ display: 'inline-flex' }}
        >
          {([
            ['Performance', 'performance'],
            ['Duration', 'duration'],
            ['Cancellations', 'cancellations'],
          ] as const).map(([label, key]) => {
            const on = activeTab === key
            return (
              <button
                key={key}
                type="button"
                aria-pressed={on}
                onClick={() => setActiveTab(key)}
                className={`report-toggle-btn ${on ? 'is-active' : ''}`}
                style={{ minHeight: 44 }}
              >
                {label}
              </button>
            )
          })}
        </div>
      </ReportToolbar>

      <PageBody
        noun="rental figures"
        loading={load.loading}
        error={load.error}
        onRetry={load.reload}
        hasRows={perfData !== null}
        skeleton="kpi"
        empty={perfData !== null && perfData.metrics.totalBookings === 0}
        emptyIsFiltered={filtered}
        onClearFilters={() => setFilters({})}
        emptyTitle={filtered ? 'No bookings in this period' : 'No bookings yet'}
        emptyMessage={
          filtered
            ? 'Nothing was picked up in the selected period or branch. Clear the filters to see every booking.'
            : 'Rental figures appear here once the first booking is created.'
        }
      >
      {/* TAB 1: PERFORMANCE */}
      {activeTab === 'performance' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
          <KpiStrip items={performanceKpis} columns={viewport === 'phone' ? 1 : viewport === 'tablet' ? 2 : 4} />

          <div
            style={{
              display: 'grid',
              gridTemplateColumns: viewport === 'desktop' ? '1fr 1fr' : '1fr',
              gap: 'var(--sp-md)',
            }}
          >
            {/* Stage breakdown card */}
            <div style={cardStyle}>
              <h3 style={{ fontSize: 'var(--t-h3)', fontWeight: 600, marginBottom: 'var(--sp-sm)' }}>
                Bookings by Operational Stage
              </h3>
              <p style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', marginBottom: 'var(--sp-md)' }}>
                Fulfillment workflow distribution from quote to completed return.
              </p>
              {stageSlices.length > 0 && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)', alignItems: 'center' }}>
                  <Donut slices={stageSlices} size={180} />
                  <Legend slices={stageSlices} />
                </div>
              )}
            </div>

            {/* Project Types card */}
            <div style={cardStyle}>
              <h3 style={{ fontSize: 'var(--t-h3)', fontWeight: 600, marginBottom: 'var(--sp-sm)' }}>
                Production Types Breakdown
              </h3>
              <p style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', marginBottom: 'var(--sp-md)' }}>
                Bookings by the project type recorded on each rental.
              </p>
              <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-sm)' }}>
                {perfData?.projectTypes === null && (
                  <div style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
                    {NOT_TRACKED} — project type is not readable for this session.
                  </div>
                )}
                {perfData?.projectTypes?.map((pt) => (
                  <div
                    key={pt.projectType}
                    style={{
                      display: 'flex',
                      justifyContent: 'space-between',
                      alignItems: 'center',
                      padding: '10px 14px',
                      background: 'var(--surface-hover)',
                      borderRadius: 'var(--r-sm)',
                    }}
                  >
                    <div>
                      <div style={{ fontWeight: 600, fontSize: 'var(--t-body)' }}>{pt.projectType}</div>
                      <div style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
                        {pt.count} bookings ({pt.percent}% of fleet hires)
                      </div>
                    </div>
                    {money && (
                      <div style={{ textAlign: 'right', fontWeight: 600, fontSize: 'var(--t-body)' }}>
                        {formatMoney(pt.revenue)}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>

          {/* Top bookings table */}
          <div style={cardStyle}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 'var(--sp-sm)' }}>
              <div>
                <h3 style={{ fontSize: 'var(--t-h3)', fontWeight: 600 }}>High-Value Rental Contracts</h3>
                <p style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
                  Top equipment hires driving turnover in this period.
                </p>
              </div>
              <Link
                to="/rentals"
                style={{
                  fontSize: 'var(--t-meta)',
                  color: 'var(--primary)',
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: 4,
                  textDecoration: 'none',
                }}
              >
                View all rentals <Icon name="chevron_right" size={12} />
              </Link>
            </div>

            <DataTableShell ariaLabel="High-Value Rental Contracts">
              <table style={{ width: '100%', borderCollapse: 'collapse' }}>
                <thead>
                  <tr>
                    <th style={th}>Booking No</th>
                    <th style={th}>Client</th>
                    <th style={th}>Production / Project</th>
                    <th style={th}>Duration</th>
                    <th style={th}>Stage</th>
                    {money && <th style={{ ...th, textAlign: 'right' }}>Rental Value</th>}
                  </tr>
                </thead>
                <tbody>
                  {filteredTopBookings.length === 0 && <NoMatchRow colSpan={money ? 6 : 5} query={searchQuery} noun="bookings" />}
                  {filteredTopBookings.map((b) => (
                    <tr key={b.id}>
                      <td style={td}>
                        <Link
                          to={`/rentals/${b.bookingNo}`}
                          style={{ color: 'var(--primary)', fontWeight: 600, textDecoration: 'none' }}
                        >
                          {b.bookingNo}
                        </Link>
                      </td>
                      <td style={td}>{b.clientName}</td>
                      <td style={td}>{b.project}</td>
                      <td style={td}>{b.days} days</td>
                      <td style={td}>
                        <span
                          style={{
                            display: 'inline-block',
                            padding: '2px 8px',
                            borderRadius: 'var(--r-sm)',
                            fontSize: 'var(--t-meta)',
                            background: b.stage === 'On Rent' ? 'var(--status-info-bg)' : 'var(--surface-hover)',
                            color: b.stage === 'On Rent' ? 'var(--status-info-text)' : 'var(--text)',
                          }}
                        >
                          {b.stage}
                        </span>
                      </td>
                      {money && (
                        <td style={{ ...td, textAlign: 'right', fontWeight: 600 }}>
                          {formatMoney(b.value)}
                        </td>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </DataTableShell>
          </div>
        </div>
      )}

      {/* TAB 2: DURATION */}
      {activeTab === 'duration' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
          <KpiStrip items={durationKpis} columns={viewport === 'phone' ? 1 : viewport === 'tablet' ? 2 : 4} />

          <div
            style={{
              display: 'grid',
              gridTemplateColumns: viewport === 'desktop' ? '1fr 1fr' : '1fr',
              gap: 'var(--sp-md)',
            }}
          >
            {/* Horizontal bars distribution */}
            <div style={cardStyle}>
              <h3 style={{ fontSize: 'var(--t-h3)', fontWeight: 600, marginBottom: 'var(--sp-sm)' }}>
                Rental Duration Histogram
              </h3>
              <p style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', marginBottom: 'var(--sp-md)' }}>
                Proportion of bookings across operational rental day spans.
              </p>
              {durationBars.length > 0 && <HBars rows={durationBars} axisTicks={['0', '10', '20', '30', '40+']} />}
            </div>

          </div>

          {/* Duration buckets table */}
          <div style={cardStyle}>
            <h3 style={{ fontSize: 'var(--t-h3)', fontWeight: 600, marginBottom: 'var(--sp-sm)' }}>
              Rental Duration Buckets Summary
            </h3>
            <DataTableShell ariaLabel="Rental Duration Buckets Summary">
              <table style={{ width: '100%', borderCollapse: 'collapse' }}>
                <thead>
                  <tr>
                    <th style={th}>Span</th>
                    <th style={th}>Bookings</th>
                    <th style={th}>Volume Share</th>
                    <th style={th}>Total Equipment Days</th>
                    {money && <th style={{ ...th, textAlign: 'right' }}>Total Revenue</th>}
                    {money && <th style={{ ...th, textAlign: 'right' }}>Avg Daily Rate</th>}
                  </tr>
                </thead>
                <tbody>
                  {durationData?.buckets.map((b) => (
                    <tr key={b.key}>
                      <td style={{ ...td, fontWeight: 600 }}>{b.label}</td>
                      <td style={td}>{b.count} hires</td>
                      <td style={td}>{b.sharePercent}%</td>
                      <td style={td}>{b.totalDays} unit days</td>
                      {money && (
                        <td style={{ ...td, textAlign: 'right', fontWeight: 600 }}>
                          {formatMoney(b.revenue)}
                        </td>
                      )}
                      {money && (
                        <td style={{ ...td, textAlign: 'right', color: 'var(--text2)' }}>
                          {formatMoney(b.avgDailyRate)} / day
                        </td>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </DataTableShell>
          </div>
        </div>
      )}

      {/* TAB 3: CANCELLATIONS */}
      {activeTab === 'cancellations' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
          <KpiStrip items={cancellationKpis} columns={viewport === 'phone' ? 1 : viewport === 'tablet' ? 2 : 4} />

          <div
            style={{
              display: 'grid',
              gridTemplateColumns: viewport === 'desktop' ? '1fr 1fr' : '1fr',
              gap: 'var(--sp-md)',
            }}
          >
            {/* Cancellation reasons Donut */}
            <div style={cardStyle}>
              <h3 style={{ fontSize: 'var(--t-h3)', fontWeight: 600, marginBottom: 'var(--sp-sm)' }}>
                Primary Cancellation Causes
              </h3>
              <p style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', marginBottom: 'var(--sp-md)' }}>
                Categorization of lost quotes and dropped reservations.
              </p>
              {reasonSlices.length > 0 && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)', alignItems: 'center' }}>
                  <Donut slices={reasonSlices} size={180} />
                  <Legend slices={reasonSlices} />
                </div>
              )}
            </div>

          </div>

          {/* Cancelled bookings table */}
          <div style={cardStyle}>
            <h3 style={{ fontSize: 'var(--t-h3)', fontWeight: 600, marginBottom: 'var(--sp-sm)' }}>
              Cancelled Bookings Register
            </h3>
            <p style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', marginBottom: 'var(--sp-md)' }}>
              Audit trail of terminal cancellation transitions and client cited reasons.
            </p>
            <DataTableShell ariaLabel="Cancelled Bookings Register">
              <table style={{ width: '100%', borderCollapse: 'collapse' }}>
                <thead>
                  <tr>
                    <th style={th}>Booking No</th>
                    <th style={th}>Client</th>
                    <th style={th}>Production / Project</th>
                    <th style={th}>Scheduled Pickup</th>
                    {money && <th style={{ ...th, textAlign: 'right' }}>Lost Value</th>}
                    <th style={th}>Cancellation Reason</th>
                  </tr>
                </thead>
                <tbody>
                  {filteredCancelledBookings.length === 0 && <NoMatchRow colSpan={money ? 6 : 5} query={searchQuery} noun="cancelled bookings" />}
                  {filteredCancelledBookings.map((cb) => (
                    <tr key={cb.id}>
                      <td style={td}>
                        <Link
                          to={`/rentals/${cb.bookingNo}`}
                          style={{ color: 'var(--primary)', fontWeight: 600, textDecoration: 'none' }}
                        >
                          {cb.bookingNo}
                        </Link>
                      </td>
                      <td style={td}>{cb.clientName}</td>
                      <td style={td}>{cb.project}</td>
                      <td style={td}>{formatAd(new Date(cb.scheduledPickup))}</td>
                      {money && (
                        <td style={{ ...td, textAlign: 'right', fontWeight: 600, color: 'var(--status-danger-text)' }}>
                          {formatMoney(cb.lostRevenue)}
                        </td>
                      )}
                      <td style={td}>{cb.reason}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </DataTableShell>
          </div>
        </div>
      )}
      </PageBody>
    </div>
  )
}
