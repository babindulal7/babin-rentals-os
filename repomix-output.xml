<file path="src/lib/intel/revenueTrend.ts">
import { parseMoney, type Paisa } from '../money'

/**
 * An issued-invoice measure, NOT cash collected or accounting profit.
 * Date buckets are Gregorian calendar months (invoices.issue_date is AD DATE).
 * No hardcoded fallback values or demo totals are permitted.
 */
export interface IssuedInvoiceSource {
  id: string
  issue_date: string
  status: string
  taxable_amount: string | number
  currency: string
  voided_at: string | null
}

export interface RevenueMonth {
  periodStartUtc: string
  label: string
  amountPaisa: Paisa
  invoiceCount: number
}

export interface RevenueTrend {
  months: RevenueMonth[]
  totalPaisa: Paisa
  issuedCount: number
  fromAd: string
  toAd: string
}

const DATE_RE = /^\d{4}-\d{2}-\d{2}$/
const MONEY_RE = /^(?:0|[1-9]\d*)(?:\.\d{1,2})?$/
const ISSUED = new Set(['Sent', 'Partially Paid', 'Paid'])

function asDate(s: string): Date {
  if (!DATE_RE.test(s)) throw new Error('Report dates must use YYYY-MM-DD')
  const value = new Date(s + 'T00:00:00.000Z')
  if (!Number.isFinite(value.getTime()) || value.toISOString().slice(0, 10) !== s) {
    throw new Error('Invalid report date')
  }
  return value
}

function sourcePaisa(source: string | number): Paisa {
  const text = String(source)
  if (!MONEY_RE.test(text)) throw new Error('Unusable taxable invoice amount')
  const parsed = parseMoney(text)
  if (parsed === null || !Number.isSafeInteger(parsed) || parsed < 0) {
    throw new Error('Invoice amount cannot be reconciled safely')
  }
  return parsed
}

/**
 * Requires the caller to have fetched a COMPLETE, deduplicated period.
 * An incomplete page is not an actual trend.
 */
export function aggregateIssuedRevenue(
  invoices: readonly IssuedInvoiceSource[],
  fromAd: string,
  toAd: string,
): RevenueTrend {
  const start = asDate(fromAd)
  const end = asDate(toAd)
  if (start.getTime() > end.getTime()) throw new Error('Report start is after end')
  const firstMonth = new Date(Date.UTC(start.getUTCFullYear(), start.getUTCMonth(), 1))
  const lastMonth = new Date(Date.UTC(end.getUTCFullYear(), end.getUTCMonth(), 1))
  const months: RevenueMonth[] = []
  for (let cursor = firstMonth; cursor <= lastMonth; cursor = new Date(Date.UTC(cursor.getUTCFullYear(), cursor.getUTCMonth() + 1, 1))) {
    if (months.length >= 24) throw new Error('Choose a report window of 24 months or less')
    months.push({
      periodStartUtc: cursor.toISOString(),
      label: cursor.toLocaleString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }),
      amountPaisa: 0 as Paisa,
      invoiceCount: 0,
    })
  }
  const byMonth = new Map(months.map((m) => [m.periodStartUtc.slice(0, 7), m]))
  const seen = new Set<string>()
  let total = 0
  let issuedCount = 0
  for (const invoice of invoices) {
    if (seen.has(invoice.id)) throw new Error('Duplicate invoice in report source')
    seen.add(invoice.id)
    asDate(invoice.issue_date)
    if (invoice.issue_date < fromAd || invoice.issue_date > toAd) {
      throw new Error('Invoice outside requested reporting window')
    }
    if (invoice.voided_at !== null || invoice.status === 'Void' || invoice.status === 'Draft') continue
    if (!ISSUED.has(invoice.status)) throw new Error('Unrecognized invoice status in reporting source')
    if (invoice.currency !== 'NPR') throw new Error('Mixed-currency invoices require a separate report')
    const amount = sourcePaisa(invoice.taxable_amount)
    const month = byMonth.get(invoice.issue_date.slice(0, 7))
    if (!month) throw new Error('Invoice month missing from report window')
    const nextMonth = month.amountPaisa + amount
    const nextTotal = total + amount
    if (!Number.isSafeInteger(nextMonth) || !Number.isSafeInteger(nextTotal)) {
      throw new Error('Revenue total exceeds safe integer paisa')
    }
    month.amountPaisa = nextMonth as Paisa
    month.invoiceCount++
    issuedCount++
    total = nextTotal
  }
  if (months.reduce((sum, month) => sum + month.amountPaisa, 0) !== total) {
    throw new Error('Revenue buckets failed reconciliation')
  }
  return { months, totalPaisa: total as Paisa, issuedCount, fromAd, toAd }
}


/**
 * Credit notes currently record the paid/refunded rupee amount (migration 0117,
 * void_invoice in 0150), not a VAT-exclusive sales adjustment. Do not subtract
 * credit_notes.amount from taxable revenue or label it net sales.
 *
 * This audit joins notes to ALL invoices issued in the selected AD window,
 * including voided invoices excluded from the revenue chart. Credit notes on
 * invoices issued outside the window belong to a different audit population.
 */
export interface IssuedInvoiceWithPayment extends IssuedInvoiceSource {
  paid_amount: string | number
}

export interface InvoiceCreditNoteSource {
  id: string
  invoice_id: string
  amount: string | number
}

export interface RevenueCreditReconciliation {
  voidedInvoiceCount: number
  voidedTaxablePaisa: Paisa
  creditNoteCount: number
  creditNoteAmountPaisa: Paisa
  paidVoidMismatchCount: number
  activeInvoiceCreditNoteCount: number
}

/** No fallback or estimated values: missing/malformed source records fail closed. */
export function reconcileInvoiceCredits(
  invoices: readonly IssuedInvoiceWithPayment[],
  notes: readonly InvoiceCreditNoteSource[],
): RevenueCreditReconciliation {
  const byId = new Map<string, IssuedInvoiceWithPayment>()
  const noteAmounts = new Map<string, number>()
  const seenNotes = new Set<string>()
  let creditNoteAmount = 0
  let voidedTaxable = 0
  let voidedInvoiceCount = 0
  let activeInvoiceCreditNoteCount = 0

  for (const invoice of invoices) {
    if (byId.has(invoice.id)) throw new Error('Duplicate invoice in credit reconciliation')
    asDate(invoice.issue_date)
    byId.set(invoice.id, invoice)
    if (invoice.voided_at !== null || invoice.status === 'Void') {
      // Credit notes have no currency column: only an NPR parent establishes
      // that settlement and taxable amounts can be displayed as NPR.
      if (invoice.currency !== 'NPR') throw new Error('Mixed-currency voided invoices require separate reconciliation')
      voidedInvoiceCount++
      const taxable = sourcePaisa(invoice.taxable_amount)
      voidedTaxable += taxable
      if (!Number.isSafeInteger(voidedTaxable)) throw new Error('Voided taxable amount exceeds safe paisa')
    }
  }

  for (const note of notes) {
    if (seenNotes.has(note.id)) throw new Error('Duplicate credit note in report source')
    seenNotes.add(note.id)
    const invoice = byId.get(note.invoice_id)
    if (!invoice) throw new Error('Credit note has no invoice in the report source')
    if (invoice.currency !== 'NPR') throw new Error('Mixed-currency credit notes require separate reconciliation')
    const amount = sourcePaisa(note.amount)
    if (amount <= 0) throw new Error('Credit note must carry a positive amount')
    creditNoteAmount += amount
    const combined = (noteAmounts.get(note.invoice_id) ?? 0) + amount
    if (!Number.isSafeInteger(combined) || !Number.isSafeInteger(creditNoteAmount)) {
      throw new Error('Credit note totals exceed safe paisa')
    }
    noteAmounts.set(note.invoice_id, combined)
    if (invoice.voided_at === null && invoice.status !== 'Void') activeInvoiceCreditNoteCount++
  }

  let paidVoidMismatchCount = 0
  for (const invoice of invoices) {
    if (invoice.voided_at === null && invoice.status !== 'Void') continue
    const paid = sourcePaisa(invoice.paid_amount)
    if (paid > 0 && (noteAmounts.get(invoice.id) ?? 0) !== paid) paidVoidMismatchCount++
  }

  return {
    voidedInvoiceCount,
    voidedTaxablePaisa: voidedTaxable as Paisa,
    creditNoteCount: notes.length,
    creditNoteAmountPaisa: creditNoteAmount as Paisa,
    paidVoidMismatchCount,
    activeInvoiceCreditNoteCount,
  }
}
</file>

<file path="src/lib/intel/safeTriangle.ts">
/**
 * Smart Intel Cards v1 — safe-triangle hover intent (spec §D).
 *
 * Amazon/Ben Kamens pattern: while the pointer travels from the trigger into
 * the card, keep the card open even if it briefly leaves both, as long as it
 * stays inside the triangle formed by the pointer position and the two near
 * card corners.
 *
 * Pure geometry (Law 1) — no DOM here; the component wires rects to it.
 */

export interface Point {
  x: number
  y: number
}

export interface Rect {
  left: number
  top: number
  right: number
  bottom: number
}

function sign(a: Point, b: Point, c: Point): number {
  return (a.x - c.x) * (b.y - c.y) - (b.x - c.x) * (a.y - c.y)
}

/** Barycentric point-in-triangle. Points on an edge count as inside. */
export function pointInTriangle(p: Point, a: Point, b: Point, c: Point): boolean {
  const d1 = sign(p, a, b)
  const d2 = sign(p, b, c)
  const d3 = sign(p, c, a)
  const hasNeg = d1 < 0 || d2 < 0 || d3 < 0
  const hasPos = d1 > 0 || d2 > 0 || d3 > 0
  return !(hasNeg && hasPos)
}

/**
 * Build the travel triangle from the pointer at mouse-leave time to the two
 * nearest corners of the open card rect, then test the current pointer.
 * Returns false when either rect is missing (caller falls back to the plain
 * 300ms close timer).
 */
export function inTravelTriangle(pointer: Point, from: Point, card: Rect): boolean {
  const corners: Point[] = [
    { x: card.left, y: card.top },
    { x: card.right, y: card.top },
    { x: card.left, y: card.bottom },
    { x: card.right, y: card.bottom },
  ]
  const byDist = [...corners].sort(
    (m, n) => (m.x - from.x) ** 2 + (m.y - from.y) ** 2 - ((n.x - from.x) ** 2 + (n.y - from.y) ** 2),
  )
  const first = byDist[0]
  const second = byDist[1]
  if (!first || !second) return false
  return pointInTriangle(pointer, from, first, second)
}
</file>

<file path="src/lib/intel/selectors.ts">
/**
 * Smart Intel Cards v1 — deterministic local intelligence selectors (spec §E).
 *
 * Law 1: pure functions over already-available rental history. No network, no
 * ML, and nothing here may be labelled "AI" — statistics only. All money
 * results are integer paisa; callers omit (never CSS-hide) finance output for
 * money-blind roles via `lib/fieldGating.ts`.
 */

/** Days rented ÷ days available × 100. Null when there is no basis. */
export function timeUtilization(rentedDays: number, availableDays: number): number | null {
  if (!Number.isFinite(rentedDays) || !Number.isFinite(availableDays)) return null
  if (availableDays <= 0 || rentedDays < 0) return null
  return Math.round((rentedDays / availableDays) * 100)
}

/** Annual rental revenue ÷ acquisition cost × 100. */
export function dollarUtilization(annualRevenuePaisa: number, acquisitionPaisa: number): number | null {
  if (!Number.isFinite(annualRevenuePaisa) || !Number.isFinite(acquisitionPaisa)) return null
  if (acquisitionPaisa <= 0 || annualRevenuePaisa < 0) return null
  return Math.round((annualRevenuePaisa / acquisitionPaisa) * 100)
}

/** Cumulative revenue ÷ acquisition cost × 100 (break-even at 100). */
export function breakEvenPercent(cumulativeRevenuePaisa: number, acquisitionPaisa: number): number | null {
  return dollarUtilization(cumulativeRevenuePaisa, acquisitionPaisa)
}

/** Revenue ÷ rental-days, rounded half-up to whole paisa. */
export function profitPerRentalDay(revenuePaisa: number, rentalDays: number): number | null {
  if (!Number.isFinite(revenuePaisa) || !Number.isFinite(rentalDays)) return null
  if (rentalDays <= 0 || revenuePaisa < 0) return null
  const q = revenuePaisa / rentalDays
  return (q < 0 ? -Math.round(-q) : Math.round(q))
}

/** Maintenance cost ÷ revenue × 100. */
export function maintenanceCostRatio(maintenancePaisa: number, revenuePaisa: number): number | null {
  if (!Number.isFinite(maintenancePaisa) || !Number.isFinite(revenuePaisa)) return null
  if (revenuePaisa <= 0 || maintenancePaisa < 0) return null
  return Math.round((maintenancePaisa / revenuePaisa) * 100)
}

/** Whole days since the last on-rent day, from a day-precision epoch. */
export function idleDaysSince(lastOnRentDayEpochMs: number | null, nowEpochMs: number): number | null {
  if (lastOnRentDayEpochMs === null) return null
  if (!Number.isFinite(lastOnRentDayEpochMs) || !Number.isFinite(nowEpochMs)) return null
  const diff = nowEpochMs - lastOnRentDayEpochMs
  if (diff < 0) return null
  return Math.floor(diff / 86_400_000)
}

export interface CoOccurrenceInput {
  /** Product id to explain. */
  productId: string
  /** Completed rental product-id sets. */
  completedRentals: string[][]
  /** Minimum co-rental count before a pairing is reported. */
  minSample: number
}

export interface CoOccurrenceRow {
  productId: string
  /** Share of the target's rentals that also contained this product, 0–100. */
  percent: number
  count: number
}

/**
 * "Often rented with" from co-occurrence on completed rentals only (spec
 * §25). Deterministic counting — not a recommender, never labelled AI.
 */
export function oftenRentedWith(input: CoOccurrenceInput): CoOccurrenceRow[] {
  const withTarget = input.completedRentals.filter((r) => r.includes(input.productId))
  if (withTarget.length < input.minSample) return []
  const counts = new Map<string, number>()
  for (const rental of withTarget) {
    for (const pid of new Set(rental)) {
      if (pid === input.productId) continue
      counts.set(pid, (counts.get(pid) ?? 0) + 1)
    }
  }
  return [...counts.entries()]
    .filter(([, c]) => c >= input.minSample)
    .map(([productId, count]): CoOccurrenceRow => ({
      productId,
      count,
      percent: Math.round((count / withTarget.length) * 100),
    }))
    .sort((a, b) => b.count - a.count || a.productId.localeCompare(b.productId))
}

export interface BookingRange {
  id: string
  /** Half-open [start, end) epoch ms. */
  startMs: number
  endMs: number
}

/** Overlap check for the conflict warning (spec §E) — half-open intervals. */
export function conflictsFor(range: BookingRange, existing: BookingRange[]): BookingRange[] {
  return existing.filter(
    (e) => e.id !== range.id && range.startMs < e.endMs && e.startMs < range.endMs,
  )
}

export interface ReadinessInput {
  equipmentReserved: boolean
  serialsAssigned: boolean
  packed: number
  packedTotal: number
  contractSigned: boolean
  depositPending: boolean
}

export interface ReadinessLine {
  label: string
  done: boolean
}

/** Compact booking readiness strip (spec §17) — connected state, not badges. */
export function readinessLines(input: ReadinessInput): ReadinessLine[] {
  return [
    { label: 'Equipment reserved', done: input.equipmentReserved },
    { label: 'Serial numbers assigned', done: input.serialsAssigned },
    {
      label: `Packed ${input.packed} / ${input.packedTotal}`,
      done: input.packedTotal > 0 && input.packed >= input.packedTotal,
    },
    { label: 'Contract signed', done: input.contractSigned },
    { label: 'Deposit cleared', done: !input.depositPending },
  ]
}
</file>

<file path="src/lib/intel/store.ts">
/**
 * Smart Intel Cards v1 — global session store (spec §34).
 *
 * One card open at a time; once one card has opened, adjacent scans switch
 * with ~0ms delay until every card closes (spec §21). A module-level store
 * (not React context) so any trigger can join the session without a
 * provider, and timers are not duplicated per page.
 */

import { useSyncExternalStore } from 'react'
import type { IntelContext, IntelEntityType } from './context'

export type IntelSessionMode = 'closed' | 'hover' | 'pinned' | 'side-peek' | 'bottom-sheet'

export interface IntelNavigationEntry {
  entityType: IntelEntityType
  entityId: string
  context: IntelContext
}

interface IntelSession {
  /** A card is currently open somewhere — adjacent triggers skip the delay. */
  active: boolean
  /** Id of the currently open card, if any. */
  openId: string | null
  entityType: IntelEntityType | null
  entityId: string | null
  context: IntelContext | null
  mode: IntelSessionMode
  originElement: HTMLElement | null
  anchorRect: DOMRect | null
  history: IntelNavigationEntry[]
}

let state: IntelSession = { active: false, openId: null, entityType: null, entityId: null, context: null, mode: 'closed', originElement: null, anchorRect: null, history: [] }
const listeners = new Set<() => void>()

function emit(): void {
  for (const l of listeners) l()
}

export function intelSessionSnapshot(): IntelSession {
  return state
}

function subscribe(fn: () => void): () => void {
  listeners.add(fn)
  return () => {
    listeners.delete(fn)
  }
}

export function useIntelSession(): IntelSession {
  return useSyncExternalStore(subscribe, intelSessionSnapshot, intelSessionSnapshot)
}

/** Called when any card opens — starts/continues the rapid-scan session. */
export function intelOpened(id: string, entry?: IntelNavigationEntry, mode: IntelSessionMode = 'hover', originElement?: HTMLElement | null): void {
  state = {
    ...state,
    active: true,
    openId: id,
    entityType: entry?.entityType ?? null,
    entityId: entry?.entityId ?? null,
    context: entry?.context ?? null,
    mode,
    originElement: originElement ?? null,
    anchorRect: originElement?.getBoundingClientRect() ?? null,
    history: entry && state.entityId && state.entityType && state.context && state.entityId !== entry.entityId
      ? [...state.history, { entityType: state.entityType, entityId: state.entityId, context: state.context }]
      : state.history,
  }
  emit()
}

/** Called when a card closes — ends the session only if it was the open one. */
export function intelClosed(id: string): void {
  if (state.openId === id) {
    state = { ...state, active: false, openId: null, entityType: null, entityId: null, context: null, mode: 'closed', originElement: null, anchorRect: null, history: [] }
    emit()
  }
}

/** Another explicitly opened entity replaces the current one (no stacking). */
export function intelReplaced(nextId: string, entry?: IntelNavigationEntry, mode: IntelSessionMode = 'pinned', originElement?: HTMLElement | null): void {
  intelOpened(nextId, entry, mode, originElement)
}

/** Return to the prior entity inside the active Intel card or sheet. */
export function intelNavigateBack(id: string): void {
  if (state.openId !== id || state.history.length === 0) return
  const previous = state.history[state.history.length - 1]
  if (!previous) return
  state = {
    ...state,
    entityType: previous.entityType,
    entityId: previous.entityId,
    context: previous.context,
    history: state.history.slice(0, -1),
  }
  emit()
}

export function isIntelSessionActive(): boolean {
  return state.active
}
</file>

