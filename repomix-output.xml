                            Line Total
                            <span style={{ display: 'block', ...subtle, fontWeight: 400 }}>rate × qty</span>
                          </th>
                          <th style={{ ...th, textAlign: 'right' }} scope="col">
                            Children
                          </th>
                          <th style={th} scope="col">
