import { createContext, useContext } from 'react'
import { useViewport } from '../../lib/device'

/**
 * Below this much room, a floor workspace takes its one-column layout.
 *
 * It is a container width, not a window breakpoint (Law 14): list + 320px rail needs roughly this
 * much before the checklist table stops clipping its Status column. Revert = `() => false` in the
 * Shell's measurement, or delete the context and return `useViewport()` from `useFloorViewport`.
 */
export const FLOOR_TWO_COLUMN_MIN = 900

/* RULING 2026-10-14: the window's width is not the room a floor workspace has. The dock beside the
   queue is ~44% of the window, and a tablet held upright gives the full-screen sheet ~780px — in
   both the window says "tablet/desktop" while the room is phone-sized. The shell measures its own
   body and says so here; the workspaces then take the one-column layout. */
export const FloorNarrowContext = createContext(false)

export function useFloorViewport(): ReturnType<typeof useViewport> {
  const viewport = useViewport()
  return useContext(FloorNarrowContext) ? 'phone' : viewport
}
</file>

<file path="src/modules/operations/nextRequirement.ts">
/**
 * The one line shown beside a disabled Confirm: the first requirement still unmet and how many
 * follow it. The workspaces already evaluate their own gates; this only words the result so all
 * four stages say it the same way. Returns null when nothing is unmet.
 */
export function nextRequirement(unmet: readonly string[]): string | null {
  const [first, ...rest] = unmet
  if (!first) return null
  return rest.length > 0 ? `${first} (+${rest.length} more)` : first
}
</file>

<file path="src/modules/operations/OperationsWorkspaceContext.tsx">
import { createContext, useCallback, useContext, useMemo, useState, type ReactNode } from 'react'
import type { BookingStatus, JobName } from '../../lib/workflow'
import OperationsShell from './OperationsShell'

interface OpenWorkspace { bookingNo: string; bookingStatus: BookingStatus; job: JobName }
interface OperationsWorkspaceValue {
  openOperations: (bookingNo: string, bookingStatus: BookingStatus, job: JobName) => void
  closeOperations: () => void
}
const OperationsWorkspaceContext = createContext<OperationsWorkspaceValue | null>(null)

export function OperationsWorkspaceProvider({ children }: { children: ReactNode }) {
  const [workspace, setWorkspace] = useState<OpenWorkspace | null>(null)
  const closeOperations = useCallback(() => setWorkspace(null), [])
  const openOperations = useCallback((bookingNo: string, bookingStatus: BookingStatus, job: JobName) => setWorkspace({ bookingNo, bookingStatus, job }), [])
  const value = useMemo(() => ({ openOperations, closeOperations }), [closeOperations, openOperations])
  return <OperationsWorkspaceContext.Provider value={value}>
    {children}
    {workspace && <OperationsShell isOpen bookingNo={workspace.bookingNo} bookingStatus={workspace.bookingStatus} initialJob={workspace.job} onClose={closeOperations} />}
  </OperationsWorkspaceContext.Provider>
}

export function useOperationsWorkspace(): OperationsWorkspaceValue {
  const value = useContext(OperationsWorkspaceContext)
  if (!value) throw new Error('useOperationsWorkspace must be used inside OperationsWorkspaceProvider')
  return value
}
</file>

