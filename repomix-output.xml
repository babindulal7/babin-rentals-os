                </button>
              ) : null}
            </span>
          )}

          {/* 9. User Profile Trigger (Law 15: >= 44x44px hit area) */}
          <div style={{ position: 'relative' }}>
            <button
              ref={profileBtnRef}
              type="button"
              onClick={() => setProfileOpen((v) => !v)}
              aria-label={`${initials} — user profile`}
              title="User profile"
              aria-expanded={profileOpen}
              style={{
                ...iconBtn,
                padding: 0,
              }}
            >
              <span
                aria-hidden="true"
                style={{
                  width: 36,
                  height: 36,
                  borderRadius: 'var(--r-badge)',
                  background: 'var(--card2)',
                  border: '1px solid var(--border)',
                  display: 'grid',
                  placeItems: 'center',
                  color: 'var(--text)',
                  fontSize: 'var(--t-meta)',
                  fontWeight: 700,
                }}
              >
                {initials}
              </span>
            </button>

            {profileOpen && (
              <>
                <div
                  style={{ position: 'fixed', inset: 0, zIndex: 90 }}
                  onClick={() => {
                    setProfileOpen(false)
                    const active = document.activeElement as Element | null
                    if (!active || active === document.body) profileBtnRef.current?.focus()
                  }}
                  aria-hidden="true"
                />
                <div
                  role="dialog"
                  aria-label="User profile"
                  title="User profile"
                  onKeyDown={(event) => {
                    if (event.key === 'Escape') {
                      setProfileOpen(false)
                      profileBtnRef.current?.focus()
                    }
                  }}
                  style={{
                    position: 'absolute',
                    top: 'calc(100% + 8px)',
                    right: 0,
                    zIndex: 91,
                    width: 230,
                    background: 'var(--card)',
                    border: '1px solid var(--border)',
                    borderRadius: 'var(--r-card)',
                    boxShadow: 'var(--shadow-modal)',
                    padding: '12px 14px',
                    display: 'flex',
                    flexDirection: 'column',
                    gap: 10,
                  }}
                >
                  <div style={{ borderBottom: '1px solid var(--border)', paddingBottom: 8 }}>
                    <div style={{ fontSize: 'var(--t-ui)', fontWeight: 700, color: 'var(--text)' }}>
                      {user?.name || 'Guest'}
                    </div>
                    <div style={{ fontSize: 'var(--t-meta)', color: 'var(--muted)', marginTop: 2 }}>
                      {user?.role || ''} · Kathmandu HQ
                    </div>
                  </div>
                  {isPhone && (
                    <Button variant="secondary" icon="message" onClick={() => {
                      setProfileOpen(false)
                      setNotesOpen(true)
                    }}>
                      Team internal notes
                    </Button>
                  )}
                  {hasPin && (
                    <button
                      type="button"
                      onClick={() => {
                        setProfileOpen(false)
                        lockNow()
                      }}
                      style={{
                        display: 'flex',
                        alignItems: 'center',
                        gap: 8,
                        minHeight: 44,
                        padding: '0 10px',
                        borderRadius: 'var(--r-sm)',
                        border: '1px solid var(--border)',
                        background: 'var(--card2)',
                        color: 'var(--text)',
                        fontSize: 'var(--t-ui)',
                        fontWeight: 600,
                        cursor: 'pointer',
                        fontFamily: 'inherit',
                      }}
                    >
                      <Icon name="lock" size={16} />
                      Lock Session
                    </button>
                  )}
                  <button
                    type="button"
                    onClick={() => {
                      setProfileOpen(false)
                      handleLogoutRequest()
                    }}
                    style={{
                      display: 'flex',
                      alignItems: 'center',
                      gap: 8,
                      minHeight: 44,
                      padding: '0 10px',
                      borderRadius: 'var(--r-sm)',
                      border: '1px solid transparent',
                      background: 'var(--btn-danger-bg)',
                      color: 'var(--btn-danger-fg)',
                      fontSize: 'var(--t-ui)',
                      fontWeight: 600,
                      cursor: 'pointer',
                      fontFamily: 'inherit',
                    }}
                  >
                    Log Out
                  </button>
                </div>
              </>
            )}
          </div>
        </div>
      </header>

      {/* Confirmation Dialog for actions requiring confirmation */}
      {activeConfirmAction?.confirm && (
        <ConfirmDialog
          isOpen={true}
          title={activeConfirmAction.confirm.title}
          description={activeConfirmAction.confirm.description}
          confirmLabel={activeConfirmAction.confirm.confirmLabel}
          cancelLabel={activeConfirmAction.confirm.cancelLabel ?? 'Cancel'}
          variant={activeConfirmAction.confirm.variant === 'danger' ? 'danger' : 'default'}
          onClose={() => setActiveConfirmAction(null)}
          onConfirm={() => {
            const actionToRun = activeConfirmAction
            setActiveConfirmAction(null)
            void actionToRun.onClick?.()
          }}
        />
      )}

      {showHandover && (
        <HandoverSheet
          isOpen={showHandover}
          onClose={() => setShowHandover(false)}
          userName={user?.name}
          userRole={user?.role}
        />
      )}

      {(notesOpen || notesVisited) && <InternalNotesDrawer isOpen={notesOpen} onClose={() => setNotesOpen(false)} />}
    </>
  )
}
