  IconReceipt,
  IconChartBar,
  IconTool,
  IconSettings,
  IconHeadset,
  IconBriefcase,
  IconCurrencyDollar,
  IconBattery1,
  IconFileInvoice,
  IconCalendarStats,
  IconCircleFilled,
  IconMoon,
  IconRobot,
  IconPlug,
  IconSparkles,
  IconActivity,
  IconChevronUp,
  IconCamera,
