  font-family: var(--font-body);
  font-size: var(--t-th);
  font-weight: 700;
}

.movement-panel__items span {
  font-family: var(--font-body);
}

.movement-panel__status {
  justify-self: start;
  max-width: 100%;
  padding: 0.48rem 0.62rem;
  overflow: hidden;
  border-radius: 0.375rem;
  font-size: var(--t-th);
  font-weight: 800;
