                          {o.severity}
                        </span>
                      </td>
                      <td style={td}>
                        <Link
                          to={`/rentals/${o.bookingNo}/return`}
                          style={{
                            display: 'inline-flex',
                            alignItems: 'center',
                            gap: 4,
                            padding: '4px 10px',
                            background: 'var(--primary)',
                            color: '#fff',
                            borderRadius: 'var(--r-sm)',
                            fontSize: 'var(--t-meta)',
                            textDecoration: 'none',
                            fontWeight: 600,
                          }}
                        >
                          Process Return
