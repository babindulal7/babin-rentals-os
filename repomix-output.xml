                          <span
                            style={{
                              display: 'inline-flex',
                              alignItems: 'center',
                              gap: 3,
                              padding: '2px 8px',
                              borderRadius: 'var(--r-pill)',
                              background: 'rgba(47, 158, 68, 0.12)',
                              color: 'var(--success-text)',
                              fontSize: '11px',
                              fontWeight: 700,
                            }}
                          >
                            <Icon name="check" size={11} />
                            RESOLVED
                          </span>
                        ) : null}

                        {/* Pin and Delete Buttons */}
                        <button
                          type="button"
                          aria-label={isPinned ? 'Unpin note' : 'Pin note to top'}
                          onClick={() => handleTogglePin(n.id)}
                          title={isPinned ? 'Unpin note' : 'Pin note to top'}
                          style={{
                            minWidth: 44,
                            minHeight: 44,
                            border: 'none',
                            background: 'transparent',
                            color: isPinned ? 'var(--accent)' : 'var(--muted)',
                            cursor: 'pointer',
                            padding: 6,
                            borderRadius: 'var(--r-sm)',
                            display: 'grid',
                            placeItems: 'center',
                          }}
                        >
                          <Icon name="bell" size={15} fill={isPinned} />
                        </button>

                        <button
                          type="button"
                          aria-label="Delete note"
                          onClick={() => handleDelete(n.id)}
                          title="Delete note"
                          style={{
                            minWidth: 44,
                            minHeight: 44,
                            border: 'none',
                            background: 'transparent',
                            color: 'var(--muted)',
                            cursor: 'pointer',
                            padding: 6,
                            borderRadius: 'var(--r-sm)',
                            display: 'grid',
                            placeItems: 'center',
                          }}
                        >
                          <Icon name="close" size={15} />
                        </button>
                      </div>
                    </div>

                    {/* Note Body or Inline Edit Mode */}
                    {isEditing ? (
                      <div style={{ marginTop: 8, display: 'flex', flexDirection: 'column', gap: 10 }}>
                        <textarea
                          rows={3}
                          aria-label="Edit note content"
                          value={editDraft}
                          onChange={e => setEditDraft(e.target.value)}
                          style={{
                            width: '100%',
                            padding: '8px 10px',
                            borderRadius: 'var(--r-sm)',
                            border: '1px solid var(--accent)',
                            background: 'var(--input-bg)',
                            color: 'var(--text)',
                            fontSize: 'var(--t-body)',
                            fontFamily: 'inherit',
                          }}
                        />

                        {/* Edit attached ID */}
                        <div style={{ display: 'flex', alignItems: 'center', gap: 8, flexWrap: 'wrap' }}>
                          <span style={{ fontSize: '11px', color: 'var(--muted)', fontWeight: 600 }}>Linked Entity:</span>
                          {editRefId ? (
                            <span className="attached-ref-chip">
                              <Icon name={getReferenceIconName(editRefId)} size={12} />
                              {editRefId}
                              <button
                                type="button"
                                onClick={() => setEditRefId(null)}
                                title="Remove linked entity"
                              >
                                ×
                              </button>
                            </span>
                          ) : (
                            <button
                              type="button"
                              onClick={() => setIsEditingEntitySelectorOpen(true)}
                              style={{
                                minHeight: 44,
                                padding: '3px 10px',
                                borderRadius: 'var(--r-sm)',
                                border: '1px solid var(--border)',
                                background: 'var(--surface-2)',
                                color: 'var(--text2)',
                                fontSize: '11px',
                                cursor: 'pointer',
                                display: 'inline-flex',
                                alignItems: 'center',
                                gap: 4,
                              }}
                            >
                              <Icon name="barcode" size={12} />
                              + Select ID
                            </button>
                          )}
                        </div>

                        <div style={{ display: 'flex', gap: 8, alignItems: 'center', flexWrap: 'wrap' }}>
                          <select
                            value={editCategory}
                            aria-label="Edit note category"
                            onChange={e => setEditCategory(e.target.value as NoteCategory)}
                            style={{
                              padding: '6px 10px',
                              borderRadius: 'var(--r-sm)',
                              border: '1px solid var(--border)',
                              background: 'var(--input-bg)',
                              color: 'var(--text)',
                              fontSize: '11px',
                              minHeight: 44,
                            }}
                          >
                            {CATEGORIES.map(c => (
                              <option key={c} value={c}>{c}</option>
                            ))}
                          </select>
                          <select
                            value={editPriority}
                            aria-label="Edit note priority"
                            onChange={e => setEditPriority(e.target.value as NotePriority)}
                            style={{
                              padding: '6px 10px',
                              borderRadius: 'var(--r-sm)',
                              border: '1px solid var(--border)',
                              background: 'var(--input-bg)',
                              color: 'var(--text)',
                              fontSize: '11px',
                              minHeight: 44,
                            }}
                          >
                            <option value="low">Low</option>
                            <option value="normal">Normal</option>
                            <option value="high">High</option>
                            <option value="urgent">Urgent</option>
                          </select>
                          <div style={{ flex: 1 }} />
                          <Button variant="secondary" onClick={handleCancelEdit} style={{ minHeight: 44, padding: '0 16px' }}>
                            Cancel
                          </Button>
                          <Button variant="primary" onClick={() => handleSaveEdit(n.id)} style={{ minHeight: 44, padding: '0 16px' }}>
                            Save
                          </Button>
                        </div>
                      </div>
                    ) : (
                      <>
                        <div
                          style={{
                            fontSize: 'var(--t-body)',
                            color: isResolved ? 'var(--muted)' : 'var(--text)',
                            lineHeight: 1.5,
                            whiteSpace: 'pre-wrap',
                            textDecoration: isResolved ? 'line-through' : 'none',
                          }}
                        >
                          {n.text}
                        </div>

                        {/* Interactive Clickable Reference Links with entity icons */}
                        {allRefs.length > 0 && (
                          <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6, marginTop: 10 }}>
                            {allRefs.map(ref => (
                              <div key={ref} style={{ display: 'inline-flex', alignItems: 'center', gap: 4 }}>
                                <Link
                                  to={getReferenceUrl(ref)}
                                  className="note-ref-chip"
                                  title={`Open ${ref} details page`}
                                >
                                  <Icon name={getReferenceIconName(ref)} size={12} />
                                  {ref}
                                  <Icon name="external_link" size={10} style={{ opacity: 0.7 }} />
                                </Link>
                                <button
                                  type="button"
                                  onClick={() => setSelectedEntityFilter(ref)}
                                  title={`Filter all notes by ${ref}`}
                                  style={{
                                    minHeight: 44,
                                    border: 'none',
                                    background: 'var(--surface-2)',
                                    color: 'var(--muted)',
                                    cursor: 'pointer',
                                    padding: '0 10px',
                                    borderRadius: 'var(--r-sm)',
                                    fontSize: '10px',
                                    display: 'inline-flex',
                                    alignItems: 'center',
                                  }}
                                >
                                  Filter
                                </button>
                              </div>
                            ))}
                          </div>
                        )}

                        {/* Resolution Attribution */}
                        {isResolved && n.resolvedBy && (
                          <div
                            style={{
                              marginTop: 10,
                              padding: '6px 10px',
                              borderRadius: 'var(--r-sm)',
                              background: 'rgba(47, 158, 68, 0.08)',
                              color: 'var(--success-text)',
                              fontSize: '11px',
                              display: 'inline-flex',
                              alignItems: 'center',
                              gap: 6,
                            }}
                          >
                            <Icon name="check" size={12} />
                            Completed by {n.resolvedBy}
                          </div>
                        )}

                        {/* Card Bottom Actions */}
                        <div
                          style={{
                            display: 'flex',
                            alignItems: 'center',
                            justifyContent: 'space-between',
                            marginTop: 12,
                            paddingTop: 8,
                            borderTop: '1px solid var(--border)',
                          }}
                        >
                          <button
                            type="button"
                            onClick={() => handleToggleResolve(n.id)}
                            style={{
                              minHeight: 44,
                              padding: '0 12px',
                              borderRadius: 'var(--r-sm)',
                              border: `1px solid ${isResolved ? 'var(--border)' : 'var(--success-border, rgba(47, 158, 68, 0.4))'}`,
                              background: isResolved ? 'var(--surface-2)' : 'rgba(47, 158, 68, 0.08)',
                              color: isResolved ? 'var(--muted)' : 'var(--success-text)',
                              fontSize: '12px',
                              fontWeight: 600,
                              cursor: 'pointer',
                              display: 'inline-flex',
                              alignItems: 'center',
                              gap: 6,
                              transition: 'all var(--dur-fast)',
                            }}
                          >
                            <Icon name="check" size={14} />
                            {isResolved ? 'Reopen Task' : 'Mark as Done'}
                          </button>

                          <div style={{ display: 'flex', gap: 6, alignItems: 'center' }}>
                            <button
                              type="button"
                              onClick={() => handleStartEdit(n)}
                              title="Edit note"
                              style={{
                                minHeight: 44,
                                padding: '0 10px',
                                borderRadius: 'var(--r-sm)',
                                border: 'none',
                                background: 'transparent',
                                color: 'var(--muted)',
                                cursor: 'pointer',
                                fontSize: '11px',
                                display: 'inline-flex',
                                alignItems: 'center',
                                gap: 4,
                              }}
                            >
                              <Icon name="edit" size={13} />
                              Edit
                            </button>

                            <button
                              type="button"
                              onClick={() => {
                                if (navigator.clipboard) {
                                  void navigator.clipboard.writeText(n.text).then(() => {
                                    toast?.showSuccessToast('Copied', 'Note text copied.')
                                  })
                                }
                              }}
                              title="Copy text"
                              style={{
                                minHeight: 44,
                                padding: '0 10px',
                                borderRadius: 'var(--r-sm)',
                                border: 'none',
                                background: 'transparent',
                                color: 'var(--muted)',
                                cursor: 'pointer',
                                fontSize: '11px',
                                display: 'inline-flex',
                                alignItems: 'center',
                                gap: 4,
                              }}
                            >
                              <Icon name="copy" size={13} />
                              Copy
                            </button>
                          </div>
                        </div>
                      </>
                    )}
                  </div>
                )
              })}
            </div>
          )}
        </div>

        {/* Right Column: Note Composer & Entity Picker */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
          {/* Note Composer Card */}
          <div
            style={{
              background: 'var(--card)',
              border: '1px solid var(--border)',
              borderRadius: 'var(--r-card)',
              padding: 18,
              boxShadow: 'var(--shadow-card)',
            }}
          >
            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 12 }}>
              <div style={{ fontSize: '13px', fontWeight: 700, color: 'var(--text)' }}>
                Post Internal Dispatch Note
              </div>
              <span style={{ fontSize: '11px', color: 'var(--muted)' }}>
                Ctrl+Enter to post
              </span>
            </div>

            {/* Quick Templates */}
            <div style={{ marginBottom: 12 }}>
              <div style={{ fontSize: '11px', color: 'var(--muted)', marginBottom: 6, fontWeight: 600 }}>
                Quick Prompts:
              </div>
              <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6 }}>
                {QUICK_TEMPLATES.map(t => (
                  <button
                    key={t.label}
                    type="button"
                    className="note-template-pill"
                    onClick={() => handleApplyTemplate(t)}
                  >
                    {t.label}
                  </button>
                ))}
              </div>
            </div>

            <form onSubmit={handlePost} style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
              <textarea
                ref={textareaRef}
                rows={4}
                aria-label="Internal note draft"
                value={draft}
                onChange={e => setDraft(e.target.value)}
                onKeyDown={e => {
                  if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
                    e.preventDefault()
                    handlePost()
                  }
                }}
                placeholder="Log equipment defect, turnover checklist, booking warning... Use IDs like BR-2613 or EQ-SONY-FX6-02."
                style={{
                  width: '100%',
                  padding: '10px 12px',
                  borderRadius: 'var(--r-sm)',
                  border: '1px solid var(--border)',
                  background: 'var(--input-bg)',
                  color: 'var(--text)',
                  fontSize: 'var(--t-body)',
                  resize: 'vertical',
                  minHeight: 90,
