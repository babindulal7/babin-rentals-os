            )}
          </Card>

          {/* ── client profile rail ─────────────────────────────────── */}
          {selectedClient && (() => {
            const profileContent = (
            <Card bodyStyle={{ padding: 0 }}>
              <div
                style={{
                  padding: 14,
                  borderBottom: '1px solid var(--border)',
                  display: 'flex',
                  alignItems: 'flex-start',
