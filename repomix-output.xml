export function Field({
  label,
  id: propId,
  required,
  error,
  hint,
  children,
  span,
}: {
  label: string
  id?: string | undefined
  required?: boolean
  error?: string | null | undefined
  hint?: string | undefined
  children: ReactNode
  span?: number | undefined
}) {
  const autoId = useId()
