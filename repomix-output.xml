<file path="src/data/bundleIntel.ts">
/**
 * Hover Intel System v2.1 — the Bundle card.
 *
 * Mirrors `clientIntel.ts` / `equipmentIntel.ts`'s split: every gating
 * decision goes through `lib/fieldGating.ts`, this file only decides what a
 * field says once it has already been cleared to render. Nothing here is
 * computed independently of `data/bundles.ts` — `factsOf`, `ratioLabelOf`
 * and `isPriced` are the same single source of truth `Bundles.tsx` itself
 * reads, so the card cannot show a total that disagrees with the table row
 * it hovers over (§1's whole point).
 *
 * The condensed spec asks for a "final price" field gated to the `'booking'`
 * money category — Coordinator can see a bundle's daily rate the same way
 * they can see a booking's invoice total, per HIS v2.1 §4.1's carve-out.
 * Crew/vehicle are never priced here (§8 — they are priced in the booking's
 * own Crew/Transport sections), so there is nothing asset-finance-gated on
 * this card at all.
 */

import type { BundleRecord, BundleLine, BundleState } from './bundles'
import { factsOf, ratioLabelOf, isPriced, iconFor } from './bundles'
import { formatMoney } from '../lib/money'
import type { GateContext } from '../lib/fieldGating'
import { canViewMoneyField } from '../lib/fieldGating'
import type { IntelGlance, IntelGroup, IntelField } from '../components/ui/IntelCard'
import type { StatusKey } from '../lib/status'

const BUNDLE_TONE: Record<BundleState | 'Archived', StatusKey> = {
  Available: 'in',
  Reserved: 'primary',
  'On Rent': 'out',
  'Partially Available': 'progress',
  'On Maintenance': 'progress',
  Archived: 'neutral',
}

/** Glance-line readiness phrase — same state precedence `factsOf` already resolved. */
function readinessLabel(state: BundleState, archived?: boolean): string {
  if (archived) return 'Archived'
  switch (state) {
    case 'Available':
      return 'Bookable now'
    case 'Partially Available':
      return 'Partially bookable'
    case 'Reserved':
      return 'Reserved for a future booking'
    case 'On Rent':
      return 'Out with client'
    case 'On Maintenance':
      return 'On maintenance'
  }
}

/** Structure group's per-line description — mandatory/replaceable render as "not set", never guessed. */
function lineDetail(l: BundleLine): string {
  const bits: string[] = [
    `${l.unitsAvailable} of ${l.unitsStock} available (needs ${l.quantity})`,
    l.mandatory === undefined ? 'Mandatory: not set' : l.mandatory ? 'Mandatory' : 'Optional',
    l.replaceable === undefined ? 'Replaceable: not set' : l.replaceable ? 'Replaceable' : 'Fixed — no substitute',
  ]
  return bits.join(' · ')
}

export function bundleGlance(b: BundleRecord, gctx: GateContext): IntelGlance {
  const facts = factsOf(b)
  const state = b.archived ? 'Archived' : facts.state

  const badges = [
    { label: state, tone: BUNDLE_TONE[state] },
    ...b.tags.slice(0, 2).map((t) => ({ label: t })),
  ]

  const headline = `${readinessLabel(facts.state, b.archived)} · ${b.lines.length} component${b.lines.length === 1 ? '' : 's'}${b.nextConflictAd ? ` · next conflict ${b.nextConflictAd}` : ''}`
  const lines: string[] = [headline]
  if (facts.blockedItems > 0) {
    lines.push(`${facts.blockedItems} unit${facts.blockedItems === 1 ? '' : 's'} short across ${facts.blockedLines.length} line${facts.blockedLines.length === 1 ? '' : 's'}`)
  }
  if (canViewMoneyField(gctx, 'booking')) {
    lines.push(`${formatMoney(b.bundleRatePaisa)}/day`)
  }

  return {
    avatarLabel: b.category.slice(0, 2).toUpperCase(),
    avatarIcon: iconFor(b.category),
    avatarTone: BUNDLE_TONE[state],
    title: b.name,
    statusDot: BUNDLE_TONE[state],
    subtitle: b.category,
    badges,
    lines,
    /*
     * The detail page exists as of 7 Sep 2026, so this card gets its door back.
     * The comment here used to say the opposite — "linking to a route that does
     * not exist would be worse than no button at all" — which was right at the
     * time and is why the field was absent rather than broken.
     *
     * No window is appended: this is a pure function of a record and has no
     * access to the caller's `?from=`/`?to=`, and the detail page defaults to
     * today→tomorrow. A hover card is a glance, not a measurement; the links
     * that carry a measured window are the row menu and the preview footer,
     * both built by the pane that owns the dates.
     */
    primaryAction: { label: 'Open bundle', to: `/inventory/bundles/${b.id}` },
  }
}

export function bundleDetailGroups(b: BundleRecord, gctx: GateContext): IntelGroup[] {
  const groups: IntelGroup[] = []
  const facts = factsOf(b)
  const state = b.archived ? 'Archived' : facts.state

  groups.push({
    title: 'Identity',
    fields: [
      { label: 'Bundle ID', value: b.id },
      { label: 'Name', value: b.name },
      { label: 'Category', value: `${b.category} (Primary)` },
      { label: 'Tags', value: b.tags.length ? b.tags.join(', ') : '—' },
      {
        label: 'Lock mode',
        value:
          b.lockMode === 'Physical'
            ? 'Physical — specific serials reserved for this bundle instance'
            : b.lockMode === 'Virtual'
              ? 'Virtual — any available unit of each model may be assigned (default)'
              : 'Not set — defaults to Virtual (§10: a bundle stores models, never serials)',
      },
    ],
  })

  groups.push({
    title: 'Availability',
    fields: [
      { label: 'State', value: state },
      { label: 'Ready', value: ratioLabelOf(facts) },
      {
        label: 'Blocked components',
        value: facts.blockedItems > 0 ? `${facts.blockedItems} short across ${facts.blockedLines.length} line${facts.blockedLines.length === 1 ? '' : 's'}` : 'None — all components available',
      },
      { label: 'Next conflict', value: b.nextConflictAd ?? 'None recorded' },
    ],
  })

  // §5/§10 — the component tree, parent (group) → children (model), with
  // whatever mandatory/replaceable data has actually been triaged for that line.
  groups.push({
    title: 'Components',
    fields: b.lines.map(
      (l): IntelField => ({
        label: `${l.group} · ${l.model}${isPriced(l) ? '' : ' (not in rate)'}`,
        value: lineDetail(l),
      }),
    ),
  })

  const withSubstitutes = b.lines.filter((l) => l.substitutes && l.substitutes.length > 0)
  if (withSubstitutes.length > 0) {
    groups.push({
      title: 'Substitute suggestions',
      fields: withSubstitutes.map(
        (l): IntelField => ({
          label: l.model,
          value: (l.substitutes ?? []).join(', '),
        }),
      ),
    })
  }

  if (b.booking) {
    const booking = b.booking
    groups.push({
      title: 'Current booking',
      fields: [
        { label: 'Booking', value: booking.id, trigger: { label: 'Open', to: `/rentals/${booking.id}` } },
        { label: 'Client', value: booking.client },
        { label: 'Status', value: booking.state === 'out' ? 'Out with client' : 'Reserved (future)' },
      ],
    })
  }

  // §11 / §4.1 — final price is gated to the 'booking' money category, the
  // same carve-out that lets Coordinator see a booking's invoice total.
  if (canViewMoneyField(gctx, 'booking')) {
    groups.push({
      title: 'Money',
      fields: [
        { label: 'Bundle daily rate', value: formatMoney(b.bundleRatePaisa) },
        { label: 'Sum of parts (equipment only)', value: formatMoney(facts.sumOfPartsPaisa) },
        { label: 'You save', value: `${formatMoney(facts.savingPaisa)} (${facts.savingPct}%)` },
        { label: 'Final price', value: formatMoney(b.bundleRatePaisa) },
      ],
    })
  }

  return groups
}
</file>

<file path="src/data/bundles.ts">
import { rupees, roundHalfUp, type Paisa } from '../lib/money'
import type { IconName } from '../components/ui/Icon'

/**
 * **Bundles seed — Inventory ▸ Bundles v1.1 §1.**
 *
 * §1's rule is the whole reason this file exists:
 *
 * > *"Every number on this page is computed at render. None is stored, seeded
 * > or typed."*
 *
 * The build this replaces stored `sumOfPartsPaisa` beside a hand-typed chip
 * array reading `All 51 · 28 · 6 · 9 · 5 · 3` against **three** seeded rows.
 * §1 names that failure exactly: *"a computed value written as a literal. A
 * seeded 42 beside a seeded 28 + 6 + 9 + 5 + 3 will always drift, because
 * nothing forces them to agree."*
 *
 * So nothing derivable is stored here. A bundle holds **lines** — a model, the
 * quantity it requires, the stock behind that model and the model's current
 * daily rate — plus the booking it is committed to, if any. Item counts, the
 * ready ratio, the blocked list, the state, the donut, the sum of parts and the
 * saving are all functions of those lines (`factsOf`), so they cannot disagree
 * with each other.
 *
 * **Models, never serials** (§10). A bundle does not hold `SN-FX3-102`; it holds
 * `Sony FX3 Camera Body ×1`, and packing assigns whichever unit is free.
 */

/* ── shape ─────────────────────────────────────────────────────────────── */

/** §2 — the five states a live bundle can be in, plus the archived shelf. */
export type BundleState = 'Available' | 'Reserved' | 'On Rent' | 'Partially Available' | 'On Maintenance'

/**
 * §4.2 — the four things a bundle carries. Crew and vehicle are **suggestions
 * priced elsewhere** (§8); a case is equipment and *is* priced in the rate.
 */
export type BundleLineKind = 'equipment' | 'crew' | 'vehicle' | 'box'

/** Why a short line is short. Drives both the blocked list and the donut. */
export type BlockedBy = 'Reserved' | 'On Rent' | 'On Maintenance'

export interface BundleLine {
  /** Preview-tree heading — the model's inventory category, or Crew / Vehicle / Boxes / Bags. */
  group: string
  model: string
  kind: BundleLineKind
  /** Units of this model the bundle requires. */
  quantity: number
  /** Units owned. The preview reads `1 of 3 available` from this pair. */
  unitsStock: number
  /** Units free right now. */
  unitsAvailable: number
  /** Set only where `unitsAvailable < quantity`; asserted below. */
  blockedBy?: BlockedBy
  /** When the short units come back. AD, UTC — **BS is rendered, never stored**. */
  freesAd?: Date
  /** Today's daily rate for one unit. §7 — sum of parts is computed from these. */
  unitRatePaisa: Paisa

  /**
   * Hover Intel System v2.1 — Bundle card, Structure group.
   *
   * `true` = the bundle cannot be booked without this component; `false` = it
   * rides along but the booking still works without it; `undefined` = this
   * line has not been triaged yet. The card renders "not set" rather than
   * guessing — most lines below are still `undefined` on purpose, exactly the
   * `weightKg` pattern above: seed only where a real decision was made, never
   * default every line to `true` just to fill the column.
   */
  mandatory?: boolean
  /**
   * Whether a short unit of this line can be swapped for one of its
   * `substitutes` instead of blocking the bundle. Independent of `mandatory`
   * — a mandatory line can still be replaceable (any 35mm T-stop lens does
   * the job), and an optional line can be fixed (this exact van or none).
   */
  replaceable?: boolean
  /**
   * Model names the packer may substitute when this line is short. Always
   * real models already seeded elsewhere in this file — never an invented
   * SKU — so a suggestion the card shows is a suggestion someone could
   * actually pack today.
   */
  substitutes?: string[]
  /** Live product UUID (`products.id`) when bundle line is backed by database product. */
  productId?: string

  /*
   * ── deliberately NOT seeded ──────────────────────────────────────────────
   *
   * §6 asks the summary for a total weight. No weight exists anywhere in this
   * project's item master (`data/inventory.ts` carries none), so seeding one
   * per line would mean inventing a physical fact nobody supplied. §9 already
   * states the honest rendering: *"`—` where any line has no weight, never 0."*
   *
   * TODO(decision) — PLAN.md §4: where do per-model weights come from? They are
   * needed by Bundles, Packing and any airline/transport manifest.
   */
  weightKg?: number
}

export interface BundleBooking {
  /** Issued by the `BK` sequence — `prefixOf('BK')`, i.e. `B-` under the 12 Aug
   *  ruling. Links to `/rentals/:bookingNo`. */
  id: string
  client: string
  /** AD, UTC. `lib/bs` renders the BS line above it. */
  startAd: Date
  endAd: Date
  /** `out` = currently with the client; `reserved` = a future commitment. */
  state: 'out' | 'reserved'
}

export interface BundleRecord {
  id: string
  /** Database UUID (`bundles.id`) for saving to booking lines. */
  dbId?: string
  /** The human-readable bundle code (`BND-23`). */
  bundleCode?: string
  name: string
  /** §4.1 — one value, labelled `(Primary)`. The full mix is in the preview. */
  category: string
  tags: string[]
  archived?: boolean
  booking?: BundleBooking
  /** G4 — whole kits free for the booking's dates, and what limits them. Absent = no availability source. */
  kitCapacity?: import('../lib/bundleCapacityView').BundleKitCapacity | null
  /**
   * Hover Intel System v2.1 — Bundle card, Identity group.
   *
   * Rentman's own physical/virtual distinction: `'Physical'` locks this
   * bundle instance to specific serials (used once it is actually packed or
   * committed to a booking); `'Virtual'` is any-of-type — the packer assigns
   * whichever unit is free, per §10 ("a bundle stores models, never
   * serials"). `undefined` reads as the stated default, Virtual, rather than
   * a blank field, because §10 already names Virtual as how every bundle in
   * this file behaves until it is actually packed.
   */
  lockMode?: 'Physical' | 'Virtual'
  /**
   * Hover Intel System v2.1 — Bundle card glance line ("next conflict …").
   *
   * A short, already-formatted AD label — not a `Date` like the other `Ad`
   * fields in this file — because it answers a forward-looking question this
   * data model has no source for: the next time a component that is free
   * *today* becomes double-booked by a future reservation. `BundleLine`'s
   * `freesAd` answers the opposite question (when an already-short unit
   * frees up); neither can derive the other, so this is seeded, not
   * computed, and left `undefined` everywhere the fact is not actually
   * known — never guessed from `freesAd`.
   */
  nextConflictAd?: string
  /**
   * The advertised daily rate, equipment only (§7/§8).
   *
   * TODO(decision) — Bundles.md §14 ⭐: *"Is the bundle rate set manually, or a
   * discount percentage off the sum of parts?"* The render shows a set figure,
   * so it is stored as one; the saving is derived against it. If it turns out to
   * be a percentage, this field becomes `discountPct` and the rate joins the
   * derived values.
   */
  bundleRatePaisa: Paisa
  lines: BundleLine[]
}

const ad = (y: number, m: number, d: number) => new Date(Date.UTC(y, m - 1, d))

