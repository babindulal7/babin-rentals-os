   */
  function handleSubmit(mode: 'draft' | 'create'): boolean {
    setSubmitted(mode)
    const e = validate(mode)
    setOutcome(null)
    if (Object.keys(e).length > 0) {
      const firstSection = sectionDefs.find((s) =>
