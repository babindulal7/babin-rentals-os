                                                : dep.critical
                                                  ? 'color-mix(in srgb, var(--danger) 8%, var(--card))'
                                                  : 'var(--card2)',
                                              color: verified
                                                ? 'var(--success-text)'
                                                : dep.critical
                                                  ? 'var(--danger-text)'
