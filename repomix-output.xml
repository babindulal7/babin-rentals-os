<file path="src/modules/rentals/modals/AssignCrewModal.tsx">
import { useEffect, useRef, useState } from 'react'
import { Modal } from '../../../components/ui/Modal'
import { Button } from '../../../components/ui/Button'
import { Input } from '../../../components/ui/Input'
import { listAssignableCrew, type AssignableCrew } from '../../../lib/queries/bookingCrew'
import { bookCrew } from '../../../actions/crew/bookCrew'
import { useAuth } from '../../../lib/auth'
import { newClientUuid } from '../../../lib/supabase'
import { formatGateError } from '../../../lib/gates'
import { canAssignPricedCrew, crewTimeInput, crewTimeIso } from '../../../lib/crewAssignment'

interface AssignCrewModalProps {
  isOpen: boolean
  onClose: () => void
  onSuccess: (crewMember: { role: string; name: string }) => void
  bookingId: string
  bookingNo?: string
  pickupAt: string
  returnAt: string
  defaultDays: number | null
}

export function AssignCrewModal({ isOpen, onClose, onSuccess, bookingId, bookingNo, pickupAt, returnAt, defaultDays }: AssignCrewModalProps) {
  const { user } = useAuth()
  const allowed = !!user && canAssignPricedCrew(user.role)
  const [roster, setRoster] = useState<AssignableCrew[]>([])
  const [loading, setLoading] = useState(true)
  const [loadError, setLoadError] = useState<string | null>(null)
  const [version, setVersion] = useState(0)
  const [crewId, setCrewId] = useState('')
  const [role, setRole] = useState('')
  const [rate, setRate] = useState('')
  const [days, setDays] = useState('')
  const [call, setCall] = useState('')
  const [wrap, setWrap] = useState('')
  const [notes, setNotes] = useState('')
  const [saving, setSaving] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const submitting = useRef(false)
  const request = useRef<{ signature: string; uuid: string } | null>(null)
  const selected = roster.find((m) => m.id === crewId)

  useEffect(() => {
    if (!isOpen) return
    setCrewId(''); setRole(''); setRate(''); setDays(defaultDays === null ? '' : String(defaultDays))
    setCall(crewTimeInput(pickupAt)); setWrap(crewTimeInput(returnAt)); setNotes(''); setError(null)
    request.current = null
  }, [isOpen, bookingId, pickupAt, returnAt, defaultDays])

  useEffect(() => {
    if (!isOpen || !allowed) return
    let cancelled = false
    setLoading(true); setLoadError(null); setRoster([])
    listAssignableCrew().then((rows) => {
      if (!cancelled) { setRoster(rows); setLoading(false) }
    }).catch((err: unknown) => {
      if (!cancelled) { setLoadError(formatGateError(err)); setLoading(false) }
    })
    return () => { cancelled = true }
  }, [isOpen, allowed, version, user?.id])

  async function submit() {
    if (submitting.current || !allowed || !user) return
    setError(null)
    try {
      if (!selected || loading || loadError) throw new Error('Choose a crew member from the loaded roster.')
      if (!role.trim()) throw new Error('Enter the role for this booking.')
      if (!rate.trim() || !Number.isFinite(Number(rate)) || Number(rate) < 0) throw new Error('Enter a daily rate of 0 or more.')
      if (!Number.isInteger(Number(days)) || Number(days) < 1) throw new Error('Enter a whole number of days, at least 1.')
      const callTime = crewTimeIso(call), wrapTime = crewTimeIso(wrap)
      if (wrapTime <= callTime) throw new Error('Wrap time must be after call time.')
      const input = { bookingId, crewIds: [selected.id], role: role.trim(), dailyRate: Number(rate), days: Number(days), callTime, wrapTime, notes: notes.trim() }
      const signature = JSON.stringify(input)
      if (request.current?.signature !== signature) request.current = { signature, uuid: newClientUuid() }
      submitting.current = true; setSaving(true)
      const result = await bookCrew({ ...input, clientUuid: request.current.uuid }, { userId: user.id, role: user.role })
      if (!result.success || result.count !== 1) throw new Error('The crew assignment was not confirmed. Try again.')
      onSuccess({ name: selected.name, role: input.role })
      onClose()
    } catch (err: unknown) {
      setError(formatGateError(err))
    } finally {
      submitting.current = false; setSaving(false)
    }
  }

  const close = () => { if (!submitting.current) onClose() }
  return <Modal isOpen={isOpen} onClose={close} title={`Assign crew — ${bookingNo ?? bookingId}`} subtitle="Call and wrap times use Nepal time (AD)." size="md"
    footer={<><Button variant="secondary" onClick={close} disabled={saving}>Cancel</Button>
      {allowed && <Button variant="primary" onClick={() => void submit()} disabled={saving || loading || !!loadError || !roster.length}>{saving ? 'Assigning…' : 'Assign crew'}</Button>}</>}>
    {!allowed ? <p>This priced assignment requires an Owner, Admin, or Manager.</p> :
      <form onSubmit={(event) => { event.preventDefault(); void submit() }} style={{ display: 'grid', gap: 'var(--sp-md)' }}>
        {error && <p role="alert" style={{ color: 'var(--st-danger-fg)' }}>{error}</p>}
        {loading ? <p role="status">Loading crew roster…</p> : loadError ? <div role="alert"><p>{loadError}</p><Button onClick={() => setVersion((v) => v + 1)}>Retry roster</Button></div> : !roster.length ? <p>No active crew profiles are available. Add an active crew profile before assigning a member.</p> : <>
          <label htmlFor="booking-crew-member">Crew member</label>
          <select id="booking-crew-member" value={crewId} disabled={saving} onChange={(event) => {
            const member = roster.find((m) => m.id === event.target.value)
            setCrewId(event.target.value); setRole(member?.role ?? ''); setRate(member?.dailyRate == null ? '' : String(member.dailyRate))
          }} style={{ minHeight: 44, width: '100%', padding: '0 12px', border: '1px solid var(--border)', borderRadius: 'var(--r-btn)', background: 'var(--card)', color: 'var(--text)' }}>
            <option value="">Choose a crew member…</option>
            {roster.map((m) => <option key={m.id} value={m.id}>{m.name} — {m.role}</option>)}
          </select>
          <Input label="Role on this booking" value={role} disabled={saving} onChange={(e) => setRole(e.target.value)} required style={{ minHeight: 44 }} />
          <Input label="Call time (Nepal)" type="datetime-local" value={call} disabled={saving} onChange={(e) => setCall(e.target.value)} required style={{ minHeight: 44 }} />
          <Input label="Wrap time (Nepal)" type="datetime-local" value={wrap} disabled={saving} onChange={(e) => setWrap(e.target.value)} required style={{ minHeight: 44 }} />
          <Input label="Daily rate (Rs)" type="number" min="0" step="0.01" value={rate} disabled={saving} onChange={(e) => setRate(e.target.value)} required style={{ minHeight: 44 }} />
          <Input label="Days" type="number" min="1" step="1" value={days} disabled={saving} onChange={(e) => setDays(e.target.value)} required style={{ minHeight: 44 }} />
          <Input label="Assignment notes" value={notes} disabled={saving} onChange={(e) => setNotes(e.target.value)} style={{ minHeight: 44 }} />
        </>}
      </form>}
  </Modal>
}
</file>

<file path="src/modules/rentals/modals/CancelRentalModal.tsx">
import { useState } from 'react'
import { Modal } from '../../../components/ui/Modal'
import { Button } from '../../../components/ui/Button'
import { useAuth } from '../../../lib/auth'
import { useToast } from '../../../components/ui/Toast'
import { newClientUuid } from '../../../lib/supabase'
import { cancelRental } from '../../../actions/rentals/cancelRental'
import { formatGateError } from '../../../lib/gates'
import type { BookingStatus } from '../../../lib/workflow'

export interface CancelRentalModalProps {
  isOpen: boolean
  onClose: () => void
  onSuccess: (bookingId: string) => void
  bookingId: string
  bookingNo: string
  stage: BookingStatus | string
}

export function CancelRentalModal({
  isOpen,
  onClose,
  onSuccess,
  bookingId,
  bookingNo,
  stage,
}: CancelRentalModalProps) {
  const { user } = useAuth()
  const { showSuccessToast } = useToast()
  const [reason, setReason] = useState('')
  const [confirmed, setConfirmed] = useState(false)
  const [isSubmitting, setIsSubmitting] = useState(false)
  const [error, setError] = useState<string | null>(null)

  const trimmedReason = reason.trim()
  const isReasonValid = trimmedReason.length >= 10
  const isPacked = stage === 'Packed'

  const handleSubmit = async (e?: React.FormEvent) => {
    if (e) e.preventDefault()
    if (!user) {
      setError('You must be signed in to cancel a booking.')
      return
    }
    if (!isReasonValid) {
      setError('A cancellation reason of at least 10 characters is required.')
      return
    }
    if (!confirmed) {
      setError('Please confirm that you understand this cancellation is permanent and releases all inventory allocations.')
      return
    }

    setIsSubmitting(true)
    setError(null)

    try {
      const clientUuid = newClientUuid()
      await cancelRental(
        {
          id: bookingId,
          reason: trimmedReason,
          clientUuid,
        },
        { userId: user.id, role: user.role },
      )

      showSuccessToast(
        'Booking Cancelled',
        `${bookingNo} has been cancelled and its inventory reservations have been released.`,
      )
      onSuccess(bookingId)
      onClose()
    } catch (err: unknown) {
      setError(formatGateError(err))
    } finally {
      setIsSubmitting(false)
    }
  }

  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      title={`Cancel Booking — ${bookingNo}`}
      subtitle={`Stage: ${stage}. Cancelling releases all inventory reservations and records an immutable audit trail.`}
      size="md"
      footer={
        <>
          <Button variant="secondary" onClick={onClose} disabled={isSubmitting}>
            Keep Booking
          </Button>
          <Button
            variant="danger"
            onClick={() => handleSubmit()}
            disabled={isSubmitting || !isReasonValid || !confirmed}
          >
            {isSubmitting ? 'Cancelling…' : 'Cancel Booking'}
          </Button>
        </>
      }
    >
      <form onSubmit={handleSubmit} style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
        {error && (
          <div
            style={{
              padding: '10px 14px',
              borderRadius: 'var(--r-btn)',
              background: 'var(--st-danger-bg)',
              color: 'var(--st-danger-fg)',
              fontSize: 'var(--t-meta)',
              lineHeight: 1.5,
            }}
          >
            {error}
          </div>
        )}

        <div
          style={{
            padding: '10px 14px',
            borderRadius: 'var(--r-btn)',
            background: 'var(--card2)',
            border: '1px solid var(--border)',
            fontSize: 'var(--t-meta)',
            color: 'var(--muted)',
            lineHeight: 1.5,
          }}
        >
          <strong style={{ color: 'var(--text)', display: 'block', marginBottom: 4 }}>
            {/* Law 3 & Inventory Allocation */}Inventory Allocation </strong>
          Cancelling will immediately release all reserved equipment and inventory allocations for{' '}
          <span style={{ color: 'var(--text)', fontWeight: 600 }}>{bookingNo}</span>. This action is irreversible.
        </div>

        {isPacked && (
          <div
            style={{
              padding: '8px 12px',
              borderRadius: 'var(--r-btn)',
              /* §21 — soft caution callout uses the canonical chip-amber pair,
                 themed in both modes; the rgba(234,179,8) literal stayed
                 light-mode yellow under the dark theme. */
              background: 'var(--chip-amber-bg)',
              border: '1px solid color-mix(in srgb, var(--chip-amber-fg) 35%, transparent)',
              color: 'var(--text)',
              fontSize: 'var(--t-meta)',
            }}
          >
            <strong style={{ color: 'var(--chip-amber-fg)' }}>Manager Authority Required:</strong> Because this booking has already been packed, cancellation
            requires Manager, Admin, or Owner credentials per database gate rule (0115).
          </div>
        )}

        <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
            <label style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
              Reason for Cancellation <span style={{ color: 'var(--danger)' }}>*</span>
            </label>
            <span
              style={{
                fontSize: 'var(--t-caption)',
                color: isReasonValid ? 'var(--muted)' : 'var(--danger)',
              }}
            >
              {trimmedReason.length}/10 characters minimum
            </span>
          </div>
          <textarea
            id="cancel-reason"
            aria-label="Cancellation reason"
            rows={3}
            placeholder="State the operational reason for cancelling this booking (client cancelled shoot, scheduling conflict, etc.)..."
            value={reason}
            onChange={(e) => setReason(e.target.value)}
            style={{
              padding: '8px 12px',
              borderRadius: 'var(--r-btn)',
              border: '1px solid var(--border)',
              background: 'var(--card)',
              color: 'var(--text)',
              fontSize: 'var(--t-meta)',
              resize: 'vertical',
            }}
          />
        </div>

        <label
          style={{
            display: 'flex',
            alignItems: 'flex-start',
            gap: 'var(--sp-sm)',
            fontSize: 'var(--t-meta)',
            color: 'var(--text)',
            cursor: 'pointer',
          }}
        >
          <input
            type="checkbox"
            aria-label="I confirm that this booking is to be cancelled and all reserved equipment released back into stock"
            checked={confirmed}
            onChange={(e) => setConfirmed(e.target.checked)}
            style={{ marginTop: 2 }}
          />
          <span>I confirm that this booking is to be cancelled and all reserved equipment released back into stock.</span>
        </label>
      </form>
    </Modal>
  )
}
</file>

<file path="src/modules/rentals/modals/CreateSubRentalModal.tsx">
import { DateField } from '../../../components/ui/DateField'
import { useState } from 'react'
import { Modal } from '../../../components/ui/Modal'
import { Button } from '../../../components/ui/Button'
import { rupees, formatMoney } from '../../../lib/money'
import type { Paisa } from '../../../lib/money'
import { createSubRental } from '../../../actions/subrentals/createSubRental'
import { useAuth } from '../../../lib/auth'
import { formatGateError } from '../../../lib/gates'

interface CreateSubRentalModalProps {
  isOpen: boolean
  onClose: () => void
  onSuccess: (subRental: {
    vendor: string
    itemName: string
    vendorCostPaisa: Paisa
    clientChargePaisa: Paisa
    marginPaisa: Paisa
  }) => void
  bookingId: string
}

export function CreateSubRentalModal({
  isOpen,
  onClose,
  onSuccess,
  bookingId,
}: CreateSubRentalModalProps) {
  const { user } = useAuth()

  /*
   * ⛔ Every one of these four opened pre-filled: vendor "Cine Gear Nepal",
   * item "ARRI Alexa Mini Body", Rs 35,000 cost against a Rs 45,000 client
   * charge — a whole sub-rental, vendor and margin included, that no vendor
   * quoted and no operator entered. And NOTHING was dispatched: `handleSubmit`
   * emitted `DomainEvents.emit('subrental.created', …)` — an in-memory bus
   * whose only subscriber is a console logger — then called `onSuccess()`
   * unconditionally, firing BookingDetail's "Sub-Rental Created" toast. No
   * vendor PO existed, the charge never reached the client's invoice, and the
   * payable was invisible to Finance.
   *
   * All four open empty now. The operator states the deal; the screen states
   * nothing.
   */
  const [vendor, setVendor] = useState('')
  const [itemName, setItemName] = useState('')
  const [vendorCost, setVendorCost] = useState<number>(0)
  const [clientCharge, setClientCharge] = useState<number>(0)
  const [returnByDate, setReturnByDate] = useState('')
  const [isSubmitting, setIsSubmitting] = useState(false)
  const [error, setError] = useState<string | null>(null)

  const margin = clientCharge - vendorCost
  const figuresEntered = vendorCost > 0 && clientCharge > 0

  const handleSubmit = async (e?: React.FormEvent) => {
    if (e) e.preventDefault()
    if (!itemName.trim() || !vendor.trim()) {
      setError('Vendor and Item Name are required.')
      return
    }
    if (!returnByDate) {
      setError('Vendor return-by date is required.')
      return
    }
    if (!Number.isFinite(vendorCost) || vendorCost <= 0 || !Number.isFinite(clientCharge) || clientCharge <= 0) {
      setError('Cost and charge amounts must be greater than 0.')
      return
    }
    /*
     * No session, no sub-rental. `createAction` refuses a call with no context
     * rather than acting as somebody, but the operator has to read the reason
     * here — inline and persistent, because `useToast()` exposes successes
     * only (Law 12).
     */
    if (!user) {
      setError('You are not signed in, so this sub-rental cannot be attributed to anyone. Sign in and try again.')
      return
    }

    setIsSubmitting(true)
    setError(null)

    try {
      /* The action writes the booking line and emits SUBRENTAL_CREATED only after
         persistence. Vendor text is not passed as a supplier UUID. */
      await createSubRental(
        {
          bookingId,
          vendorName: vendor.trim(),
          itemDescription: itemName.trim(),
          returnByDate,
          costPaisa: rupees(vendorCost),
          chargePaisa: rupees(clientCharge),
        },
        { userId: user.id, role: user.role },
      )

      onSuccess({
        vendor: vendor.trim(),
        itemName: itemName.trim(),
        vendorCostPaisa: rupees(vendorCost),
        clientChargePaisa: rupees(clientCharge),
        marginPaisa: rupees(margin),
      })
      onClose()
    } catch (err: unknown) {
      setError(formatGateError(err))
    } finally {
      setIsSubmitting(false)
    }
  }

  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      title={`Create External Sub-Rental — ${bookingId}`}
      subtitle="Source unstocked equipment from external rental partners."
      size="md"
      footer={
        <>
          <Button variant="secondary" onClick={onClose} disabled={isSubmitting}>
            Cancel
          </Button>
          <Button variant="primary" onClick={() => handleSubmit()} disabled={isSubmitting}>
            {isSubmitting ? 'Creating...' : 'Create Sub-Rental'}
          </Button>
        </>
      }
    >
      <form onSubmit={handleSubmit} style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
        {error && (
          /*
            ⛔ Was `var(--danger-bg, #fee2e2)` / `var(--danger-text, #991b1b)`.
            Neither token exists — `styles/theme.css` declares `--st-danger-bg`
            and `--st-danger-fg` — so BOTH fell through to the raw hex, which
            is a §5 Conventions violation ("never a hex value in a component")
            AND a real theming bug: the light-theme pink stayed pink in dark
            mode, where the token resolves to `#4b1515`.

            Law 12 — errors are inline and persistent, so this also carries
            `role="alert"` rather than relying on the operator noticing it.
          */
          <div
            role="alert"
            style={{
              display: 'flex',
              alignItems: 'flex-start',
              gap: 'var(--sp-sm)',
              padding: '10px 14px',
              borderRadius: 'var(--r-btn)',
              border: '1px solid var(--danger)',
              background: 'var(--st-danger-bg)',
              color: 'var(--st-danger-fg)',
              fontSize: 'var(--t-meta)',
            }}
          >
            {error}
          </div>
        )}

        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 'var(--sp-md)' }}>
          <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
            <label style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
              External Vendor <span style={{ color: 'var(--danger)' }}>*</span>
            </label>
            <input
              type="text"
              placeholder="e.g. Cine Gear Nepal"
              value={vendor}
              onChange={(e) => setVendor(e.target.value)}
              style={{
                height: 36,
                padding: '0 12px',
                borderRadius: 'var(--r-btn)',
                border: '1px solid var(--border)',
                background: 'var(--card)',
                color: 'var(--text)',
                fontSize: 'var(--t-meta)',
              }}
            />
          </div>

          <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
            <label style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
              Equipment Name <span style={{ color: 'var(--danger)' }}>*</span>
            </label>
            <input
              type="text"
              placeholder="e.g. ARRI Alexa Mini"
              value={itemName}
              onChange={(e) => setItemName(e.target.value)}
              style={{
                height: 36,
                padding: '0 12px',
                borderRadius: 'var(--r-btn)',
                border: '1px solid var(--border)',
                background: 'var(--card)',
                color: 'var(--text)',
                fontSize: 'var(--t-meta)',
              }}
            />
          </div>
        </div>

        <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
          <label htmlFor="subrental-return-by" style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
            Vendor Return-By Date <span style={{ color: 'var(--danger)' }}>*</span>
          </label>
          <DateField id="subrental-return-by" bookingDate required ariaLabel="Vendor Return-By Date" value={returnByDate} onChange={setReturnByDate} style={{ minHeight: 44 }} />
        </div>

        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 'var(--sp-md)' }}>
          <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
            <label htmlFor="sub-rental-vendor-cost" style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
              Vendor Sub-Rental Cost (Rs) <span style={{ color: 'var(--danger)' }}>*</span>
            </label>
            {/* 0 renders as an empty box, never a typed-looking "0": the state
                must be a number for the guards and `rupees()`, but the operator
                has to see a field they are required to fill. */}
            <input
              id="sub-rental-vendor-cost"
              aria-label="Vendor Sub-Rental Cost in Rupees"
              type="number"
              min={1}
              value={vendorCost === 0 ? '' : vendorCost}
              onChange={(e) => {
                const next = Number(e.target.value)
                setVendorCost(Number.isFinite(next) ? next : 0)
              }}
              style={{
                height: 36,
                padding: '0 12px',
                borderRadius: 'var(--r-btn)',
                border: '1px solid var(--border)',
                background: 'var(--card)',
                color: 'var(--text)',
                fontSize: 'var(--t-meta)',
              }}
            />
          </div>

          <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
            <label style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
              Client Charge Price (Rs) <span style={{ color: 'var(--danger)' }}>*</span>
            </label>
            <input
              type="number"
              min={1}
              value={clientCharge === 0 ? '' : clientCharge}
              onChange={(e) => {
                const next = Number(e.target.value)
                setClientCharge(Number.isFinite(next) ? next : 0)
              }}
              style={{
                height: 36,
                padding: '0 12px',
                borderRadius: 'var(--r-btn)',
                border: '1px solid var(--border)',
                background: 'var(--card)',
                color: 'var(--text)',
                fontSize: 'var(--t-meta)',
              }}
            />
          </div>
        </div>

        <div
          style={{
            padding: 'var(--sp-md)',
            borderRadius: 'var(--r-btn)',
            background: 'var(--card2)',
            border: '1px solid var(--border)',
            display: 'flex',
            flexDirection: 'column',
            gap: 6,
            fontSize: 'var(--t-meta)',
          }}
        >
          {/* Em dashes until BOTH figures are entered — a rendered "Rs 0", and
              worse a "Rs 0 margin", reads as a deal the form is holding. */}
          <div style={{ display: 'flex', justifyContent: 'space-between' }}>
            <span>Vendor Cost:</span>
            <span>{vendorCost > 0 ? formatMoney(rupees(vendorCost)) : '—'}</span>
          </div>
          <div style={{ display: 'flex', justifyContent: 'space-between' }}>
            <span>Client Charge:</span>
            <span>{clientCharge > 0 ? formatMoney(rupees(clientCharge)) : '—'}</span>
          </div>
          <div
            style={{
              display: 'flex',
              justifyContent: 'space-between',
              paddingTop: 6,
              borderTop: '1px solid var(--border)',
              fontWeight: 700,
            }}
          >
            <span>Sub-Rental Net Margin:</span>
            {/* Never colour alone (Law 14) — the sign is in the text, so a
                negative margin does not depend on red being perceived. */}
            <span style={{ color: !figuresEntered ? 'var(--text2)' : margin >= 0 ? 'var(--success)' : 'var(--danger)' }}>
              {figuresEntered ? `${margin < 0 ? '−' : ''}${formatMoney(rupees(Math.abs(margin)))}` : '—'}
            </span>
          </div>
        </div>
      </form>
    </Modal>
  )
}
</file>

<file path="src/modules/rentals/modals/ExtendRentalModal.tsx">
import { formatAd } from '../../../lib/bs'
import { useState } from 'react'
import { Modal } from '../../../components/ui/Modal'
import { Button } from '../../../components/ui/Button'
import { rupees, formatMoney } from '../../../lib/money'
import type { Paisa } from '../../../lib/money'
import { extendRental } from '../../../actions/rentals/extendRental'
import { useAuth } from '../../../lib/auth'

interface ExtendRentalModalProps {
  isOpen: boolean
  onClose: () => void
  onSuccess: (extension: { days: number; extraAmountPaisa: Paisa; newReturnDate: string; reason: string }) => void
  bookingId: string
  client: string
  currentReturnDate?: string
}

export function ExtendRentalModal({
  isOpen,
  onClose,
  onSuccess,
  bookingId,
  client,
  currentReturnDate,
}: ExtendRentalModalProps) {
  const { user } = useAuth()

  /*
   * ⛔ Was `useState<number>(2)` and `useState<number>(15000)`.
   *
   * Two literals multiplied together and rendered as "Additional Rental
   * Charge: Rs 30,000" — the same figure, on every booking, before the
   * operator typed anything. No rate table, no booking line and no Settings
   * value produced it.
   *
   * TODO(decision): where does an extension's daily rate come from — the
   * booking's own line rates (what the original days were priced at), or a
   * named extension rate in Settings ▸ Finance? This modal is handed only
   * `bookingId`, `client` and a return date, so it can derive neither, and
   * guessing one here would be inventing a product decision. Until it is
   * ruled and passed in, the field opens EMPTY and the operator types it.
   */
  const [days, setDays] = useState<number>(0)
  const [dailyRate, setDailyRate] = useState<number>(0)
  const [reason, setReason] = useState('')
  /*
   * ⛔ Was `useState(true)`. "Client has authorized the extension and
   * additional charges" arrived pre-ticked — the screen attesting on the
   * client's behalf to a conversation that may never have happened — and
   * `handleSubmit` never read it, so it was decoration sitting on top of a
   * false claim. It starts unticked, and the submit guard now requires it.
   */
  const [confirmed, setConfirmed] = useState(false)
  const [isSubmitting, setIsSubmitting] = useState(false)
  const [error, setError] = useState<string | null>(null)

  const extraAmount = days * dailyRate

  /*
   * ⛔ `currentReturnDate` defaulted to the literal `'2026-08-12'`, and
   * `BookingDetail` — its only caller — does not pass it. So the subtitle read
   * "Current Return: 2026-08-12" for every booking in the system, and the
   * projection below counted the extension days from that invented date.
   *
   * No default now: `null` means "this dialog was not told", which the notice
   * and the submit guard both state. A projection is only offered when there
   * is a real date to project from.
   */
  const newReturnDateStr = ((): string | null => {
    if (!currentReturnDate || days <= 0) return null
    const base = new Date(currentReturnDate)
    if (Number.isNaN(base.getTime())) return null
    base.setDate(base.getDate() + days)
    return formatAd(base)
  })()

  const handleSubmit = async (e?: React.FormEvent) => {
    if (e) e.preventDefault()
    if (!Number.isFinite(days) || days <= 0) {
      setError('Extension days must be at least 1.')
      return
    }
    /*
     * The rate field opens empty (see the state initialiser), so this guard is
     * the only thing between an untouched form and a Rs 0 charge.
     * `Number.isFinite` is not decoration: `NaN <= 0` is `false`, so a
     * non-finite entry would slip past a bare `<= 0` and reach `rupees()`.
     */
    if (!Number.isFinite(dailyRate) || dailyRate <= 0) {
      setError(
        'Enter the daily extension rate in rupees. This dialog is not given the booking’s own rate, so it cannot fill it in for you.',
      )
      return
    }
    if (!reason.trim()) {
      setError('Please specify a reason for the extension.')
      return
    }
    if (!confirmed) {
      setError('Confirm that the client has authorized the extension and its additional charges before recording it.')
      return
    }
    if (!newReturnDateStr) {
      setError(
        'This dialog was not given the booking’s current return date, so the new return date cannot be worked out. ' +
          'Nothing has been changed — report this rather than retrying.',
      )
      return
    }
    /*
     * ⛔ The dispatch below read `{ userId: 'USR-001', role: 'Manager' }` — an
     * invented staff id, and a role the business-9 migration retired. Every
     * extension this screen attempted was attributed to somebody who does not
     * exist. No session, no extension: refusing is the only honest branch, and
     * it is inline because `useToast()` exposes successes only (Law 12).
     */
    if (!user) {
      setError('You are not signed in, so this extension cannot be attributed to anyone. Sign in and try again.')
      return
    }

    setIsSubmitting(true)
    setError(null)

    try {
      /*
       * `extendRental` is still a stub — `implemented` is unset in
       * `actions/rentals/extendRental.ts`, so `createAction` refuses it before
       * validate, execute, events or audit and the operator reads
       * "EXTEND_RENTAL is not connected to the database yet, so nothing was
       * saved." That refusal is the point: it is the truth, and `onSuccess`
       * below (which fires BookingDetail's "Rental Extended" toast) is never
       * reached on this path.
       *
       * Call extendRental action with validated bookingId, days, and reason.
       */
      await extendRental(
        { id: bookingId, days, reason: reason.trim() },
        { userId: user.id, role: user.role },
      )

      /*
       * The screen-level `DomainEvents.emit(RENTAL_EXTENDED, …)` that stood
       * here is gone. `createAction` emits that event itself, after `execute`
       * returns — events follow the write, never precede it. A second emit
       * from the screen announced an extension the engine had not necessarily
       * made, and would double-count once the action lands.
       */
      onSuccess({
        days,
        extraAmountPaisa: rupees(extraAmount),
        newReturnDate: newReturnDateStr,
        reason: reason.trim(),
      })
      onClose()
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Failed to extend rental')
    } finally {
      setIsSubmitting(false)
    }
  }

  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      title={`Extend Rental — ${bookingId}`}
      /* The "Current Return: …" clause is only stated when there is a real
         date behind it. It used to state the `'2026-08-12'` default as fact. */
      subtitle={<>Client: {client}{currentReturnDate && <> · Current Return: <span style={{ color: 'var(--booking-date-text)' }}>{formatAd(new Date(currentReturnDate))}</span></>}</>}
      size="md"
      footer={
        <>
          <Button variant="secondary" onClick={onClose} disabled={isSubmitting}>
            Cancel
          </Button>
          <Button variant="primary" onClick={() => handleSubmit()} disabled={isSubmitting}>
            {isSubmitting ? 'Extending...' : 'Confirm Extension'}
          </Button>
        </>
      }
    >
      <form onSubmit={handleSubmit} style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
        {error && (
          /*
            ⛔ Was `var(--danger-bg, #fee2e2)` / `var(--danger-text, #991b1b)`.
            Neither token exists — `styles/theme.css` declares `--st-danger-bg`
            and `--st-danger-fg` — so BOTH fell through to the raw hex, which
            is a §5 Conventions violation ("never a hex value in a component")
            AND a real theming bug: the light-theme pink stayed pink in dark
            mode, where the token resolves to `#4b1515`.

            Law 12 — errors are inline and persistent, so this also carries
            `role="alert"` rather than relying on the operator noticing it.
          */
          <div
            role="alert"
            style={{
              display: 'flex',
              alignItems: 'flex-start',
              gap: 'var(--sp-sm)',
              padding: '10px 14px',
              borderRadius: 'var(--r-btn)',
              border: '1px solid var(--danger)',
              background: 'var(--st-danger-bg)',
              color: 'var(--st-danger-fg)',
              fontSize: 'var(--t-meta)',
            }}
          >
            {error}
          </div>
        )}

        {/*
          Law 12 — stated when the dialog opens, not sprung on the operator at
          submit. The caller does not pass `currentReturnDate`, so this is
          currently always on: better a visible gap than the invented
          '2026-08-12' that used to fill it.
        */}
        {!currentReturnDate && (
          <div
            role="status"
            style={{
              padding: '10px 14px',
              borderRadius: 'var(--r-btn)',
              border: '1px solid var(--border)',
              background: 'var(--card2)',
              color: 'var(--text2)',
              fontSize: 'var(--t-meta)',
            }}
          >
            This dialog was not given the booking’s current return date, so it cannot work out the new one. The
            extension cannot be recorded until it is.
          </div>
        )}

        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 'var(--sp-md)' }}>
          <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
            <label style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
              Additional Days <span style={{ color: 'var(--danger)' }}>*</span>
            </label>
            <input
              type="number"
              min={1}
              /* 0 renders as an empty box, never a typed-looking "0": the state
                 must be a number for the guards, but the operator has to see a
                 field they are required to fill, not a figure this screen chose. */
              value={days === 0 ? '' : days}
              onChange={(e) => {
                const next = Number(e.target.value)
                setDays(Number.isFinite(next) ? next : 0)
              }}
              style={{
                height: 36,
                padding: '0 12px',
                borderRadius: 'var(--r-btn)',
                border: '1px solid var(--border)',
                background: 'var(--card)',
                color: 'var(--text)',
                fontSize: 'var(--t-meta)',
              }}
            />
          </div>

          <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
            <label style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
              Daily Extension Rate (Rs) <span style={{ color: 'var(--danger)' }}>*</span>
            </label>
            <input
              type="number"
              min={1}
              value={dailyRate === 0 ? '' : dailyRate}
              onChange={(e) => {
                const next = Number(e.target.value)
                setDailyRate(Number.isFinite(next) ? next : 0)
              }}
              style={{
                height: 36,
                padding: '0 12px',
                borderRadius: 'var(--r-btn)',
                border: '1px solid var(--border)',
                background: 'var(--card)',
                color: 'var(--text)',
                fontSize: 'var(--t-meta)',
              }}
            />
          </div>
        </div>

        <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
          <label style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
            Reason for Extension <span style={{ color: 'var(--danger)' }}>*</span>
          </label>
          <textarea
            rows={2}
            placeholder="e.g. Weather delay, shoot extension requested by director..."
            value={reason}
            onChange={(e) => setReason(e.target.value)}
            style={{
              padding: '8px 12px',
              borderRadius: 'var(--r-btn)',
              border: '1px solid var(--border)',
              background: 'var(--card)',
              color: 'var(--text)',
              fontSize: 'var(--t-meta)',
              resize: 'vertical',
            }}
          />
        </div>

        <div
          style={{
            padding: 'var(--sp-md)',
            borderRadius: 'var(--r-btn)',
            background: 'var(--card2)',
            border: '1px solid var(--border)',
            display: 'flex',
            flexDirection: 'column',
            gap: 6,
            fontSize: 'var(--t-meta)',
          }}
        >
          {/* An em dash, never a date or a "Rs 0", while the inputs behind
              these figures are incomplete — a rendered zero reads as a figure
              the form is holding, which is the defect this pass removes. */}
          <div style={{ display: 'flex', justifyContent: 'space-between' }}>
            <span>New Projected Return Date:</span>
            <span style={{ fontWeight: 700, color: newReturnDateStr ? 'var(--booking-date-text)' : 'var(--muted)' }}>{newReturnDateStr ?? '—'}</span>
          </div>

          <div style={{ display: 'flex', justifyContent: 'space-between' }}>
            <span>Additional Rental Charge:</span>
            <span style={{ fontWeight: 700 }}>
              {days > 0 && dailyRate > 0 ? formatMoney(rupees(extraAmount)) : '—'}
            </span>
          </div>
        </div>

        <label style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)', fontSize: 'var(--t-meta)', cursor: 'pointer' }}>
          <input
            type="checkbox"
            checked={confirmed}
            onChange={(e) => setConfirmed(e.target.checked)}
          />
          Client has authorized the extension and additional charges.
        </label>
      </form>
    </Modal>
  )
}
