        </section>

        {/* ── What Add Bundle will actually do ────────────────────────── */}
        <section
          style={{
            border: '1px solid var(--border)',
            borderRadius: 'var(--r-card)',
            background: 'var(--card2)',
            padding: 'var(--sp-md)',
            display: 'grid',
            gap: 7,
          }}
        >
          <h3
            style={{
              margin: 0,
              fontSize: 'var(--t-meta)',
              fontWeight: 700,
              letterSpacing: '0.06em',
              textTransform: 'uppercase',
              color: 'var(--text2)',
            }}
          >
            Adding this bundle
          </h3>
          {draft.notes.map((n) => (
            <p
              key={n}
              style={{
                margin: 0,
                display: 'flex',
                gap: 7,
                alignItems: 'flex-start',
