<file path="src/modules/reports/ProductReports.tsx">
import { useState, type ReactNode } from 'react'
import { PageHeader, KpiStrip, cardStyle } from '../../components/ui/Page'
import { DataTableShell } from '../../components/ui/DataTable'
import { PageBody } from '../../components/ui/PageBody'
import { ReportToolbar } from '../../components/ui/ReportToolbar'
import type { ReportCsvRow, ReportFilters } from '../../components/ui/ReportToolbar'
import { formatMoney } from '../../lib/money'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import { useViewport } from '../../lib/device'
import { useLoad } from '../../lib/queries/useLoad'
import { NOT_TRACKED } from '../../lib/queries/reportSupport'
import { getProductReportsSummary, type ProductReportsSummary } from '../../lib/queries/productReports'
import { reportFilterOptions, hasReportFilters, NoMatchRow } from './reportStates'

const cell = { padding: 'var(--sp-sm) var(--sp-md)' } as const
const right = { ...cell, textAlign: 'right' as const }

/** The export body. Money columns appear only for a money-visible role (Law 6), exactly as on screen. */
function productsCsv(summary: ProductReportsSummary | null, money: boolean): ReportCsvRow[] {
  if (!summary) return []
  return [
    ['Figure', 'Value'],
    ['Products', summary.productCount],
    ['Active products', summary.activeProducts],
    ['Products booked in period', summary.productsBooked],
    ...(money ? [['Revenue from product lines', formatMoney(summary.revenue)] as ReportCsvRow] : []),
    ['Gross profit', NOT_TRACKED],
    [],
    ['Category', 'Bookings', ...(money ? ['Revenue'] : [])],
    ...summary.byCategory.map((c): ReportCsvRow => [c.category, c.bookings, ...(money ? [formatMoney(c.revenue)] : [])]),
    [],
    ['Product', 'Category', 'Bookings', 'Quantity Booked', ...(money ? ['Revenue'] : [])],
    ...summary.topRevenue.map((p): ReportCsvRow => [p.name, p.category, p.bookings, p.quantityBooked, ...(money ? [formatMoney(p.revenue)] : [])]),
    [],
    ['Not booked in period', 'Category'],
    ...summary.notBooked.map((p): ReportCsvRow => [p.name, p.category]),
    [],
    ['At or below reorder level', 'On hand', 'Reorder level'],
    ...summary.lowStock.map((p): ReportCsvRow => [p.name, p.onHand, p.reorderLevel]),
  ]
}

function Section({ label, children }: { label: string; children: ReactNode }) {
  return (
    <section aria-label={label} style={cardStyle}>
      <div style={{ fontSize: 'var(--t-body)', fontWeight: 600, padding: 'var(--sp-md)', borderBottom: '1px solid var(--border)' }}>{label}</div>
      <DataTableShell ariaLabel={label}>{children}</DataTableShell>
    </section>
  )
}

/**
 * Product Reports.
 *
 * Phase 6 + Law 16: the page rendered `data/productReports` (invented trends,
 * profit, turnover, returns and suppliers) whatever the read returned. It now
 * draws catalogue, demand and stock figures from the catalogue and priced
 * booking lines, through `useLoad` + `PageBody`. Revenue is shown to
 * money-visible roles only (Law 6); a figure with no source says so.
 */
export default function ProductReports() {
  const money = useCanViewMoney()
  const viewport = useViewport()
  const [filters, setFilters] = useState<ReportFilters>({})
  const filtered = hasReportFilters(filters)
  const load = useLoad(() => getProductReportsSummary(reportFilterOptions(filters)), { key: JSON.stringify(filters) })
  const summary = load.data

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
      <PageHeader title="Product Reports" description="Catalogue, demand by product and category, and stock at or below reorder level." />

      <ReportToolbar
        title="Product Reports"
        value={filters}
        onChange={setFilters}
        dateColumn="pickup_at"
        csv={{ filename: 'product-reports', build: () => productsCsv(summary, money) }}
      />

      <PageBody
        noun="product figures"
        loading={load.loading}
        error={load.error}
        onRetry={load.reload}
        hasRows={summary !== null}
        skeleton="kpi"
        empty={summary !== null && summary.productCount === 0}
        emptyTitle="No products yet"
        emptyMessage="Product figures appear here once the first product is added to Inventory."
      >
        {summary && (
          <>
            <KpiStrip
              columns={viewport === 'phone' ? 1 : viewport === 'tablet' ? 2 : 4}
              items={[
                { label: 'Active Products', value: String(summary.activeProducts), icon: 'box', accent: 'primary', note: `${summary.productCount} in the catalogue` },
                {
                  label: 'Booked in Period',
                  value: String(summary.productsBooked),
                  icon: 'calendar',
                  accent: 'neutral',
                  note: filtered ? 'Products on bookings picked up in the period' : 'Products on any booking',
                },
                money
                  ? { label: 'Product Revenue', value: formatMoney(summary.revenue), icon: 'dollar', accent: 'success', note: 'Priced lines, bookings not cancelled' }
                  : { label: 'Reorder Alerts', value: String(summary.lowStock.length), icon: 'alert_triangle', accent: 'warn', note: 'At or below reorder level' },
                { label: 'Gross Profit', value: NOT_TRACKED, icon: 'chart', accent: 'neutral', note: 'No product cost is recorded' },
              ]}
            />

            <Section label="Demand by Category">
              <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: 'var(--t-meta)' }}>
                <thead>
                  <tr style={{ color: 'var(--text2)' }}>
                    <th style={cell}>Category</th>
                    <th style={right}>Bookings</th>
                    {money && <th style={right}>Revenue</th>}
                  </tr>
                </thead>
                <tbody>
                  {summary.byCategory.length === 0 && <NoMatchRow colSpan={money ? 3 : 2} noun="categories with bookings" />}
                  {summary.byCategory.map((c) => (
                    <tr key={c.category} style={{ borderTop: '1px solid var(--border)' }}>
                      <td style={{ ...cell, fontWeight: 600 }}>{c.category}</td>
                      <td style={right}>{c.bookings}</td>
                      {money && <td style={right}>{formatMoney(c.revenue)}</td>}
                    </tr>
                  ))}
                </tbody>
              </table>
            </Section>

            <Section label={money ? 'Top Products by Revenue' : 'Most Booked Products'}>
              <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: 'var(--t-meta)', minWidth: 520 }}>
                <thead>
                  <tr style={{ color: 'var(--text2)' }}>
                    <th style={cell}>Product</th>
                    <th style={cell}>Category</th>
                    <th style={right}>Bookings</th>
                    <th style={right}>Quantity</th>
                    {money && <th style={right}>Revenue</th>}
                  </tr>
                </thead>
                <tbody>
                  {summary.topRevenue.length === 0 && <NoMatchRow colSpan={money ? 5 : 4} noun="booked products" />}
                  {summary.topRevenue.map((p) => (
                    <tr key={p.productId} style={{ borderTop: '1px solid var(--border)' }}>
                      <td style={{ ...cell, fontWeight: 600 }}>{p.name}</td>
                      <td style={cell}>{p.category}</td>
                      <td style={right}>{p.bookings}</td>
                      <td style={right}>{p.quantityBooked}</td>
                      {money && <td style={right}>{formatMoney(p.revenue)}</td>}
                    </tr>
                  ))}
                </tbody>
              </table>
            </Section>

            <Section label="Not Booked in Period">
              <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: 'var(--t-meta)' }}>
                <thead>
                  <tr style={{ color: 'var(--text2)' }}>
                    <th style={cell}>Product</th>
                    <th style={cell}>Category</th>
                  </tr>
                </thead>
                <tbody>
                  {summary.notBooked.length === 0 && <NoMatchRow colSpan={2} noun="idle products" />}
                  {summary.notBooked.slice(0, 20).map((p) => (
                    <tr key={p.productId} style={{ borderTop: '1px solid var(--border)' }}>
                      <td style={{ ...cell, fontWeight: 600 }}>{p.name}</td>
                      <td style={cell}>{p.category}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </Section>

            <Section label="At or Below Reorder Level">
              <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: 'var(--t-meta)' }}>
                <thead>
                  <tr style={{ color: 'var(--text2)' }}>
                    <th style={cell}>Product</th>
                    <th style={right}>On Hand</th>
                    <th style={right}>Reorder Level</th>
                  </tr>
                </thead>
                <tbody>
                  {summary.lowStock.length === 0 && <NoMatchRow colSpan={3} noun="products at or below reorder level" />}
                  {summary.lowStock.map((p) => (
                    <tr key={p.productId} style={{ borderTop: '1px solid var(--border)' }}>
                      <td style={{ ...cell, fontWeight: 600 }}>{p.name}</td>
                      <td style={right}>{p.onHand}</td>
                      <td style={right}>{p.reorderLevel}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </Section>
          </>
        )}
      </PageBody>
    </div>
  )
}
</file>

<file path="src/modules/reports/PromotionsReports.tsx">
import { useState, type ReactNode } from 'react'
import { PageHeader, KpiStrip, cardStyle } from '../../components/ui/Page'
import { DataTableShell } from '../../components/ui/DataTable'
import { PageBody } from '../../components/ui/PageBody'
import { ReportToolbar } from '../../components/ui/ReportToolbar'
import type { ReportCsvRow, ReportFilters } from '../../components/ui/ReportToolbar'
import { formatMoney } from '../../lib/money'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import { useViewport } from '../../lib/device'
import { useLoad } from '../../lib/queries/useLoad'
import { getPromotionsReportsSummary, type PromotionsReportsSummary } from '../../lib/queries/promotionsReports'
import { reportFilterOptions, hasReportFilters, NoMatchRow } from './reportStates'

const cell = { padding: 'var(--sp-sm) var(--sp-md)' } as const
const right = { ...cell, textAlign: 'right' as const }
const pct = (n: number | null) => (n === null ? '—' : `${n}%`)

/** The export body — the same figures and tables the page draws. */
function promotionsCsv(s: PromotionsReportsSummary | null): ReportCsvRow[] {
  if (!s) return []
  return [
    ['Figure', 'Value'],
    ['Coupons (active)', `${s.couponCount} (${s.activeCoupons})`],
    ['Redemptions', s.redemptionCount],
    ['Discount given', formatMoney(s.discountsGiven)],
    ['Revenue on bookings that redeemed a coupon', formatMoney(s.promotionRevenue)],
    ['Return on promotion', s.returnOnPromotion === null ? '—' : `${s.returnOnPromotion}x`],
    [],
    ['Coupon', 'Percent', 'Active', 'Redemptions', 'Discount Given', 'Booking Revenue'],
    ...s.coupons.map((c): ReportCsvRow => [c.code, pct(c.discountPercent), c.isActive ? 'Yes' : 'No', c.redemptions, formatMoney(c.discountGiven), formatMoney(c.bookingRevenue)]),
    [],
    ['Discount Source', 'Count', 'Average Percent'],
    ...s.discountSources.map((d): ReportCsvRow => [d.source, d.count, pct(d.averagePercent)]),
    [],
    ['Bundle', 'Bookings', 'Revenue'],
    ...s.bundles.map((b): ReportCsvRow => [b.name, b.bookings, formatMoney(b.revenue)]),
  ]
}

function Section({ label, children }: { label: string; children: ReactNode }) {
  return (
    <section aria-label={label} style={cardStyle}>
      <div style={{ fontSize: 'var(--t-body)', fontWeight: 600, padding: 'var(--sp-md)', borderBottom: '1px solid var(--border)' }}>{label}</div>
      <DataTableShell ariaLabel={label}>{children}</DataTableShell>
    </section>
  )
}

/**
 * Promotions & Discounts.
 *
 * Phase 6 + Law 16: the page rendered `data/promotionsReports` whatever the
 * read returned. It now draws coupon redemptions, discount sources and bundle
 * usage from their tables, through `useLoad` + `PageBody`.
 */
export default function PromotionsReports() {
  const money = useCanViewMoney()
  const viewport = useViewport()
  const [filters, setFilters] = useState<ReportFilters>({})
  const filtered = hasReportFilters(filters)
  // Law 6 — a money-blind role never sends the read.
  const load = useLoad(() => getPromotionsReportsSummary(reportFilterOptions(filters)), {
    key: JSON.stringify(filters),
    enabled: money,
  })
  const s = load.data

  if (!money) {
    return (
      <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
        <PageHeader icon="box" title="Promotions & Discounts" description="Coupon redemptions, discounts given and bundle usage." />
        <PageBody
          restricted
          restrictedReason="Promotions are reported as revenue against discount given, so every headline figure on this page is money."
          restrictedRequiredRole="Owner, Admin, Coordinator or Accounts"
        >
          {null}
        </PageBody>
      </div>
    )
  }

  const nothing = s !== null && s.couponCount === 0 && s.discountSources.length === 0 && s.bundles.length === 0

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
      <PageHeader icon="box" title="Promotions & Discounts" description="Coupon redemptions, discounts given and bundle usage." />

      <ReportToolbar
        title="Promotions & Discounts"
        value={filters}
        onChange={setFilters}
        dateColumn="redeemed_at"
        csv={{ filename: 'promotions', build: () => promotionsCsv(s) }}
      />

      <PageBody
        noun="promotion figures"
        loading={load.loading}
        error={load.error}
        onRetry={load.reload}
        hasRows={s !== null}
        skeleton="kpi"
        empty={nothing}
        emptyIsFiltered={filtered}
        onClearFilters={() => setFilters({})}
        emptyTitle={filtered ? 'No promotions in this period' : 'No promotions yet'}
        emptyMessage={
          filtered
            ? 'No coupon was redeemed, no discount applied and no bundle booked in the selected period.'
            : 'Figures appear here once a coupon, discount or bundle is used.'
        }
      >
        {s && (
          <>
            <KpiStrip
              columns={viewport === 'phone' ? 1 : viewport === 'tablet' ? 2 : 4}
              items={[
                { label: 'Redemptions', value: String(s.redemptionCount), icon: 'check', accent: 'primary', note: `${s.activeCoupons} of ${s.couponCount} coupons active` },
                { label: 'Discount Given', value: formatMoney(s.discountsGiven), icon: 'dollar', accent: 'warn', note: 'On coupon redemptions' },
                { label: 'Promotion Revenue', value: formatMoney(s.promotionRevenue), icon: 'chart', accent: 'success', note: 'Bookings that redeemed a coupon' },
                {
                  label: 'Return on Promotion',
                  value: s.returnOnPromotion === null ? '—' : `${s.returnOnPromotion}x`,
                  icon: 'activity',
                  accent: 'neutral',
                  note: s.returnOnPromotion === null ? 'No discount given in this period' : 'Revenue per rupee of discount',
                },
              ]}
            />

            <Section label="Coupon Performance">
              <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: 'var(--t-meta)', minWidth: 560 }}>
                <thead>
                  <tr style={{ color: 'var(--text2)' }}>
                    <th style={cell}>Coupon</th>
                    <th style={right}>Percent</th>
                    <th style={cell}>Active</th>
                    <th style={right}>Redemptions</th>
                    <th style={right}>Discount Given</th>
                    <th style={right}>Booking Revenue</th>
                  </tr>
                </thead>
                <tbody>
                  {s.coupons.length === 0 && <NoMatchRow colSpan={6} noun="coupons" />}
                  {s.coupons.map((c) => (
                    <tr key={c.couponId} style={{ borderTop: '1px solid var(--border)' }}>
                      <td style={{ ...cell, fontWeight: 600 }}>{c.code}</td>
                      <td style={right}>{pct(c.discountPercent)}</td>
                      <td style={cell}>{c.isActive ? 'Yes' : 'No'}</td>
                      <td style={right}>{c.redemptions}</td>
                      <td style={right}>{formatMoney(c.discountGiven)}</td>
                      <td style={right}>{formatMoney(c.bookingRevenue)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </Section>

            <Section label="Discounts by Source">
              <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: 'var(--t-meta)' }}>
                <thead>
                  <tr style={{ color: 'var(--text2)' }}>
                    <th style={cell}>Source</th>
                    <th style={right}>Discounts</th>
                    <th style={right}>Average Percent</th>
                  </tr>
                </thead>
                <tbody>
                  {s.discountSources.length === 0 && <NoMatchRow colSpan={3} noun="discounts" />}
                  {s.discountSources.map((d) => (
                    <tr key={d.source} style={{ borderTop: '1px solid var(--border)' }}>
                      <td style={{ ...cell, fontWeight: 600 }}>{d.source}</td>
                      <td style={right}>{d.count}</td>
                      <td style={right}>{pct(d.averagePercent)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </Section>

            <Section label="Bundle Usage">
              <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: 'var(--t-meta)' }}>
                <thead>
                  <tr style={{ color: 'var(--text2)' }}>
                    <th style={cell}>Bundle</th>
                    <th style={right}>Bookings</th>
                    <th style={right}>Revenue</th>
                  </tr>
                </thead>
                <tbody>
                  {s.bundles.length === 0 && <NoMatchRow colSpan={3} noun="bundles booked" />}
                  {s.bundles.map((b) => (
                    <tr key={b.bundleId} style={{ borderTop: '1px solid var(--border)' }}>
                      <td style={{ ...cell, fontWeight: 600 }}>{b.name}</td>
                      <td style={right}>{b.bookings}</td>
                      <td style={right}>{formatMoney(b.revenue)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </Section>
          </>
        )}
      </PageBody>
    </div>
  )
}
