import { useMemo, useState, useSyncExternalStore } from 'react'
import { Link } from 'react-router-dom'
import { Button, cardStyle } from '../../components/ui/Page'
import { DataTableShell } from '../../components/ui/DataTable'
import { DateField } from '../../components/ui/DateField'
import { EmptyState, ErrorBanner, LoadingSkeleton } from '../../components/ui/StateViews'
import { useLoad } from '../../lib/queries/useLoad'
import { findShortages, type ShortageRow } from '../../lib/shortages'
import { readShortageInputs, type ShortageInputs } from '../../lib/queries/shortages'
import { availabilityRules } from '../../lib/queries/availability'
import { formatAdDateTime } from '../../lib/bs'
import { dayStartMinutesFrom, OPERATIONAL_DAY_START_DEFAULT_MINUTES } from '../../lib/operationalDay'
import { getSetting, subscribeSettings } from '../../lib/settingsStore'
import { defaultShortageDays, shortageCalendarLink, shortagePeriod } from '../../lib/shortagePeriod'

/**
 * **Shortages** — products whose live holds exceed the stock they own, for a
 * period you choose (C7). The arithmetic is `lib/shortages.ts`; this only asks
 * for a window, shows the answer, and says honestly what it cannot see.
 *
 * Dates select inclusive operational days; shortagePeriod owns their AD/UTC
 * boundaries. The calendar drill-down still labels the instant's civil date.
 */

const dayStart = () => dayStartMinutesFrom(getSetting('operationalDayStart'))

export default function ShortageSection() {
  const startMinutes = useSyncExternalStore(subscribeSettings, dayStart, () => OPERATIONAL_DAY_START_DEFAULT_MINUTES)
  const [fromDay, setFromDay] = useState(() => defaultShortageDays(new Date(), startMinutes).from)
  const [toDay, setToDay] = useState(() => defaultShortageDays(new Date(), startMinutes).to)
  /* Phase 6 — the shared read: skeleton while in flight, the failure as an
     inline banner with Retry (worded as offline when it is). It hand-rolled a
     plain-text error and a "Reading bookings…" line before. */
  const load = useLoad<ShortageInputs>(readShortageInputs)
  const inputs = load.data
  const error = load.error

  const window = useMemo(() => shortagePeriod(fromDay, toDay, startMinutes), [fromDay, toDay, startMinutes])

  const computed = useMemo<{ rows: ShortageRow[] | null; error: string | null }>(() => {
    if (!inputs || !window) return { rows: null, error: null }
    try {
      return { rows: findShortages({
        window,
        products: inputs.products,
        holdsByProduct: inputs.holdsByProduct,
        bounds: availabilityRules().bounds,
      }), error: null }
    } catch (err: unknown) {
      return { rows: null, error: err instanceof Error ? err.message : 'Availability could not be calculated.' }
    }
  }, [inputs, window])
  const rows = computed.rows
  const displayError = error ?? computed.error

  return (
    <section aria-label="Shortages" style={cardStyle}>
      <div style={{ padding: 'var(--sp-md)', borderBottom: '1px solid var(--border)' }}>
        <div style={{ fontSize: 'var(--t-body)', fontWeight: 600 }}>Shortages</div>
        <div style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', marginTop: 4 }}>
          Products whose bookings, at the busiest moment in the period, need more than the stock the product owns.
        </div>
        <div style={{ display: 'flex', flexWrap: 'wrap', gap: 'var(--sp-md)', marginTop: 'var(--sp-sm)' }}>
          <DateField label="From" ariaLabel="From" showBs={false} clearable value={fromDay} onChange={setFromDay} />
          <DateField label="To" ariaLabel="To" showBs={false} clearable value={toDay} onChange={setToDay} />
          <Button icon="refresh" onClick={load.reload}>Refresh shortages</Button>
        </div>
        <p style={{ margin: 'var(--sp-sm) 0 0', color: 'var(--text2)', fontSize: 'var(--t-meta)' }}>
          Includes each selected operational day, starting at {String(Math.floor(startMinutes / 60)).padStart(2, '0')}:{String(startMinutes % 60).padStart(2, '0')} Nepal time.
        </p>
        {!window && (
          <p role="alert" style={{ margin: 'var(--sp-sm) 0 0', fontSize: 'var(--t-meta)', color: 'var(--danger-text)' }}>
            Choose a From date that is on or before the To date.
          </p>
        )}
      </div>

      {displayError && (
        <div style={{ padding: 'var(--sp-md)' }}>
          <ErrorBanner
            title={error ? 'Could not read the bookings for shortages' : 'Availability could not be calculated'}
            message={displayError}
            {...(error ? { onRetry: load.reload } : {})}
          />
        </div>
      )}

      {!displayError && load.loading && rows === null && window && (
        <div style={{ padding: 'var(--sp-md)' }}>
          <LoadingSkeleton rows={3} label="Reading bookings…" />
        </div>
      )}

      {/* No RESULTS for the chosen period — the answer to the question asked,
          not a missing table. */}
      {!displayError && rows !== null && rows.length === 0 && (
        <div style={{ padding: 'var(--sp-md)' }}>
          <EmptyState
            kind="no-results"
            title="No shortages in this period"
            description="No product is over-committed in this period."
          />
        </div>
      )}

      {!displayError && rows !== null && rows.length > 0 && (
        <DataTableShell ariaLabel="Over-committed products">
          <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: 'var(--t-meta)', minWidth: 560 }}>
            <thead>
              <tr style={{ color: 'var(--text2)' }}>
                <th style={{ padding: 'var(--sp-sm) var(--sp-md)' }}>Product</th>
                <th style={{ padding: 'var(--sp-sm) var(--sp-md)' }}>In stock</th>
                <th style={{ padding: 'var(--sp-sm) var(--sp-md)' }}>Needed at peak</th>
                <th style={{ padding: 'var(--sp-sm) var(--sp-md)' }}>Short by</th>
                <th style={{ padding: 'var(--sp-sm) var(--sp-md)' }}>Peak at</th>
                <th style={{ padding: 'var(--sp-sm) var(--sp-md)' }}>Bookings holding it</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr key={r.productId} style={{ borderTop: '1px solid var(--border)' }}>
                  <td style={{ padding: 'var(--sp-sm) var(--sp-md)', fontWeight: 600 }}>
                    <Link to={`/inventory/${r.productId}`} style={{ display: 'inline-flex', alignItems: 'center', minHeight: 44 }}>{r.name}</Link> <span style={{ color: 'var(--text2)', fontWeight: 400 }}>{r.assetCode}</span>
                  </td>
                  <td style={{ padding: 'var(--sp-sm) var(--sp-md)' }}>{r.totalQuantity}</td>
                  <td style={{ padding: 'var(--sp-sm) var(--sp-md)' }}>{r.peakHeld}</td>
                  <td style={{ padding: 'var(--sp-sm) var(--sp-md)', fontWeight: 600, color: 'var(--danger-text)' }}>
                    {r.over}
                  </td>
                  <td style={{ padding: 'var(--sp-sm) var(--sp-md)' }}><Link to={shortageCalendarLink(r.peakAtAd)} style={{ display: 'inline-flex', alignItems: 'center', minHeight: 44 }}>{formatAdDateTime(r.peakAtAd)} · Calendar</Link></td>
                  <td style={{ padding: 'var(--sp-sm) var(--sp-md)' }}>
                    {r.holders.map((h, i) => (
                      <span key={h.bookingId}>
                        {i > 0 ? ', ' : ''}
                        <Link to={`/rentals/${h.bookingNo}`} style={{ display: 'inline-flex', alignItems: 'center', minHeight: 44 }}>{h.bookingNo}</Link>
                        {h.qty > 1 ? ` ×${h.qty}` : ''}
                      </span>
                    ))}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </DataTableShell>
      )}

      <p style={{ margin: 0, padding: 'var(--sp-sm) var(--sp-md) var(--sp-md)', fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
        Measured against each product’s stock on hand, the same ceiling the database enforces. Units out in Maintenance,
        Missing or Retired are not subtracted, so a fleet short because gear is in the workshop is not shown here.
      </p>
    </section>
  )
}
</file>

<file path="src/modules/reports/StaffReports.tsx">
import { useState } from 'react'
import { PageHeader, KpiStrip, cardStyle } from '../../components/ui/Page'
import { DataTableShell } from '../../components/ui/DataTable'
import { PageBody } from '../../components/ui/PageBody'
import { ReportToolbar } from '../../components/ui/ReportToolbar'
import type { ReportCsvRow, ReportFilters } from '../../components/ui/ReportToolbar'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import { useViewport } from '../../lib/device'
import { useAuth } from '../../lib/auth'
import { formatMoney } from '../../lib/money'
import { useLoad } from '../../lib/queries/useLoad'
import { NOT_TRACKED } from '../../lib/queries/reportSupport'
import { getStaffReportsSummary, type StaffReportsSummary } from '../../lib/queries/staffReports'
import { reportFilterOptions, hasReportFilters } from './reportStates'

const cell = { padding: 'var(--sp-sm) var(--sp-md)' } as const

/** The export body: the same figures and rows the page draws, nothing the page withholds. */
function staffCsv(summary: StaffReportsSummary | null): ReportCsvRow[] {
  if (!summary) return []
  return [
    ['Figure', 'Value'],
    ['Bookings created', summary.totals.bookingsCreated],
    ['Value of bookings created', formatMoney(summary.totals.bookingValue)],
    ['Rental collections received', formatMoney(summary.totals.collections)],
    ['Floor sessions completed', summary.totals.sessionsCompleted],
    ['Average response time', NOT_TRACKED],
    [],
    ['Staff', 'Role', 'Bookings Created', 'Booking Value', 'Collections Received', 'Sessions Completed'],
    ...summary.rows.map((s): ReportCsvRow => [
      s.name,
      s.role,
      s.bookingsCreated,
      formatMoney(s.bookingValue),
      formatMoney(s.collections),
      s.sessionsCompleted,
    ]),
  ]
}

/**
 * Staff Performance.
 *
 * Phase 6 + Law 16: this page rendered five invented people from
 * `data/staffReports` whatever the read returned. It now draws the per-person
 * figures `getStaffReportsSummary` derives from bookings, payments and floor
 * sessions, through `useLoad` + `PageBody` (loading · Error + Retry ·
 * nothing-yet vs nothing in this period). The invented "performance score" and
 * response time are gone — no table records either.
 */
export default function StaffReports() {
  const money = useCanViewMoney()
  const { user } = useAuth()
  const viewport = useViewport()
  const [filters, setFilters] = useState<ReportFilters>({})
  const filtered = hasReportFilters(filters)
  // Law 6 — a money-blind role never sends the read.
  const load = useLoad(() => getStaffReportsSummary(reportFilterOptions(filters)), {
    key: JSON.stringify(filters),
    enabled: money,
  })
  const summary = load.data

  // Law 6 — booking value and collections are the report; there is no
  // money-free version of it, so the shared RESTRICTED state stands in for the
  // whole page and no export is offered above it.
  if (!money) {
    return (
      <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
        <PageHeader icon="users" title="Staff Performance" description="Bookings created, collections received and floor work, per person." />
        <PageBody
          restricted
          restrictedReason="Staff performance is measured in booking value and collections, so there is no version of this page your role can see."
          restrictedRequiredRole="Owner, Admin, Coordinator or Accounts"
        >
          {null}
        </PageBody>
      </div>
    )
  }

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
      <PageHeader icon="users" title="Staff Performance" description="Bookings created, collections received and floor work, per person." />

      <ReportToolbar
        title="Staff Performance"
        value={filters}
        onChange={setFilters}
        dateColumn="created_at"
        csv={{
          filename: 'staff-performance',
          build: () => staffCsv(summary),
          ...(user?.name ? { generatedBy: user.name } : {}),
        }}
      />

      <PageBody
        noun="staff figures"
        loading={load.loading}
        error={load.error}
        onRetry={load.reload}
        hasRows={summary !== null}
        skeleton="kpi"
        empty={summary !== null && summary.rows.length === 0}
        emptyIsFiltered={filtered}
        onClearFilters={() => setFilters({})}
        emptyTitle={filtered ? 'No staff activity in this period' : 'No staff activity yet'}
        emptyMessage={
          filtered
            ? 'Nobody created a booking, received a payment or completed a floor session in the selected period.'
            : 'Figures appear here once staff create bookings, receive payments or complete floor work.'
        }
      >
        {summary && (
          <>
            <KpiStrip
              columns={viewport === 'phone' ? 1 : viewport === 'tablet' ? 2 : 4}
              items={[
                {
                  label: 'Booking Value',
                  value: formatMoney(summary.totals.bookingValue),
                  icon: 'dollar',
                  accent: 'primary',
                  note: `${summary.totals.bookingsCreated} bookings created, not cancelled`,
                },
                {
                  label: 'Collections Received',
                  value: formatMoney(summary.totals.collections),
                  icon: 'check',
                  accent: 'success',
                  note: 'Rental payments received; deposits excluded',
                },
                {
                  label: 'Floor Sessions',
                  value: String(summary.totals.sessionsCompleted),
                  icon: 'check',
                  accent: 'progress',
                  note: 'Packing, handover, return and more, completed',
                },
                {
                  label: 'Avg Response Time',
                  value: NOT_TRACKED,
                  icon: 'timer',
                  accent: 'neutral',
                  note: 'Nothing records when a task was acknowledged',
                },
              ]}
            />

            <section aria-label="Staff Breakdown" style={cardStyle}>
              <div style={{ fontSize: 'var(--t-body)', fontWeight: 600, padding: 'var(--sp-md)', borderBottom: '1px solid var(--border)' }}>
                Team Breakdown
              </div>
