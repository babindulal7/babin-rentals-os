/* ==========================================================================
   Calendar & Production Scheduler — Bento 2.0 & High-Density Operational Styling
   ========================================================================== */

.calendar-v2 {
  display: flex;
  flex-direction: column;
  gap: var(--space-4, 16px);
  width: 100%;
}

/* ── Monospace Tabular Numerals ─────────────────────────────────────────── */
.calendar-mono {
  font-family: var(--font-id, 'Source Sans 3', sans-serif);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
}

/* ── View Switcher & Filter Pills ───────────────────────────────────────── */
.calendar-view-tabs {
  display: inline-flex;
  gap: 3px;
  padding: 3px;
  border-radius: var(--r-card, 10px);
  background: var(--card2);
  border: 1px solid var(--border);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
}

.calendar-tab-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 0 14px;
  border-radius: var(--r-btn, 7px);
  border: 1px solid transparent;
  background: transparent;
  color: var(--text2);
  font-size: var(--t-meta, 13px);
  font-weight: 500;
  cursor: pointer;
  font-family: inherit;
  white-space: nowrap;
  transition: all var(--dur-fast, 150ms) var(--ease);
}

.calendar-tab-btn:hover {
  color: var(--text);
  background: var(--hover-card, rgba(0, 0, 0, 0.03));
}

.calendar-tab-btn.is-active {
  background: var(--card);
  border-color: var(--nav-active-accent);
  color: var(--nav-active-accent);
  font-weight: 700;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
}

/* ── Filter Kind Chips ─────────────────────────────────────────────────── */
.calendar-chip-track {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
  min-width: 0;
}

.calendar-kind-chip {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  min-height: 44px;
  padding: 0 12px;
  border-radius: var(--r-btn, 8px);
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text2);
  font-size: var(--t-meta, 13px);
  font-weight: 500;
  cursor: pointer;
  font-family: inherit;
  white-space: nowrap;
  transition: all var(--dur-fast, 150ms) var(--ease);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
}

.calendar-kind-chip:hover {
  border-color: var(--border2, var(--border));
  color: var(--text);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
}

.calendar-kind-chip.is-active {
  font-weight: 600;
  box-shadow: 0 0 0 1px var(--nav-active-accent), 0 2px 6px rgba(0, 0, 0, 0.05);
}

/* ── Month Grid Styling ─────────────────────────────────────────────────── */
.calendar-month-shell {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.calendar-weekday-row {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 6px;
  margin-bottom: 8px;
}

@media (max-width: 767px) {
  .calendar-weekday-row {
    gap: 3px;
    margin-bottom: 4px;
  }
}

.calendar-weekday-label {
  text-align: center;
  font-size: var(--t-th, 11px);
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--muted);
  text-transform: uppercase;
}

.calendar-weekday-label.is-weekend {
  color: var(--danger-text);
}

.calendar-month-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 6px;
}

@media (max-width: 767px) {
  .calendar-month-grid {
    gap: 3px;
  }
}

.calendar-day-lead {
  border-radius: var(--r-sm, 6px);
  background: var(--card2);
  opacity: 0.35;
}

.calendar-day-cell {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 8px;
  border-radius: var(--r-sm, 8px);
  border: 1px solid var(--border);
  background: var(--card);
  text-align: left;
  font-family: inherit;
