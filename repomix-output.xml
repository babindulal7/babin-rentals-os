/* ─── Side-by-Side Movement Board & Colorized Operational Icons ──────────── */
.rental-dashboard__panels {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: start;
  gap: 1.25rem;
  min-width: 0;
  width: 100%;
}

.movement-panel {
  position: relative;
  z-index: 1;
  min-width: 0;
  /* overflow must stay visible: the date-filter calendar pops out of the
     header and over the rows. Clipping moved to __body below so bottom
     corners stay rounded without cutting the dropdown. */
  overflow: visible;
  border: 1px solid var(--w10, var(--border));
  border-radius: var(--r-card, 12px);
  background: var(--surface-card, var(--card));
  box-shadow: var(--shadow-sm);
  transition: box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
}

/* An open calendar must paint above the neighbouring panel. */
.movement-panel:focus-within {
  z-index: 20;
}

/* Left side: Outgoing Pickups */
.movement-panel--outgoing {
  grid-column: 1;
  border-top: 3px solid var(--primary);
}

/* Right side: Incoming Returns */
.movement-panel--incoming {
  grid-column: 2;
  border-top: 3px solid var(--success);
}

.movement-panel__header {
  display: flex;
  align-items: center;
  gap: 0.875rem;
  min-height: 4.5rem;
  padding: 0.875rem 1.25rem;
  border-bottom: 1px solid var(--w08, var(--border));
  background: var(--card);
  border-top-left-radius: var(--r-card, 12px);
  border-top-right-radius: var(--r-card, 12px);
}

/* Operational Colorized Icons for Pickups (Blue Truck) and Returns (Green Arrow) */
.movement-panel__icon {
  display: grid;
  place-items: center;
  width: 2.75rem;
  height: 2.75rem;
  min-width: 2.75rem;
  min-height: 2.75rem;
  border-radius: var(--r-btn, 8px);
  flex-shrink: 0;
  transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}

.movement-panel__icon .ui-icon {
  width: 1.35rem;
  height: 1.35rem;
}

.movement-panel__icon--outgoing {
  background: var(--select-bg);
  color: var(--select-fg);
  border: 1px solid var(--select-bg);
  box-shadow: 0 2px 8px color-mix(in srgb, var(--primary) 18%, transparent);
}

.movement-panel__icon--incoming {
  background: color-mix(in srgb, var(--success) 12%, transparent);
  color: var(--success-text);
  border: 1px solid color-mix(in srgb, var(--success) 28%, transparent);
  box-shadow: 0 2px 8px color-mix(in srgb, var(--success) 18%, transparent);
}

.movement-panel__heading {
  min-width: 0;
}

.movement-panel__heading h2 {
  margin: 0;
  color: var(--text);
  font-family: 'Outfit', var(--font-display);
  font-size: var(--t-h4);
  font-weight: 700;
  letter-spacing: -0.02em;
  scroll-margin-block-start: 3rem;
}

.movement-panel--outgoing .movement-panel__heading h2 .figure {
  color: var(--primary-text);
}

.movement-panel--incoming .movement-panel__heading h2 .figure {
  color: var(--success-text);
}

.movement-panel__heading p {
  margin: 0.15rem 0 0;
  overflow: hidden;
  color: var(--text2);
  font-size: var(--t-th);
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.movement-panel__filter {
  margin-left: auto;
  position: relative;
  z-index: 30;
}

.movement-panel--outgoing .dashboard-date-filter__calendar {
  color: var(--primary-text);
}

.movement-panel--incoming .dashboard-date-filter__calendar {
  color: var(--success-text);
}

.movement-panel--compact {
  background: var(--card2);
  box-shadow: none;
}

.movement-panel--compact .movement-panel__header {
  border-bottom: 0;
  background: var(--card2);
}

.movement-panel--compact .movement-panel__heading p {
  overflow: visible;
  white-space: normal;
}

.rental-dashboard__panels--returns-focus,
.rental-dashboard__panels--pickups-focus {
  grid-template-columns: minmax(0, 1fr);
}

.rental-dashboard__panels--returns-focus .movement-panel,
.rental-dashboard__panels--pickups-focus .movement-panel {
  grid-column: 1;
}

@media (min-width: 1280px) {
  .rental-dashboard__panels--returns-focus .movement-cards-list,
  .rental-dashboard__panels--pickups-focus .movement-cards-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 1279px) {
  .rental-dashboard__panels {
    grid-template-columns: minmax(0, 1fr);
  }

  .rental-dashboard__panels .movement-panel,
  .rental-dashboard__panels .movement-panel--outgoing,
  .rental-dashboard__panels .movement-panel--incoming {
    grid-column: 1;
    width: 100%;
  }
}

.movement-panel__body {
  min-width: 0;
  /* Bottom-corner rounding lives here now that the panel itself is
     overflow:visible for the date-filter dropdown. */
  overflow: clip;
  border-radius: 0 0 var(--r-card, 12px) var(--r-card, 12px);
}

/* ─── Self-Contained Movement Cards (Zero Horizontal Overflow) ─────────── */
.movement-cards-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
