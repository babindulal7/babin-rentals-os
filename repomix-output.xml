import { useState } from 'react'
import { Modal, Button } from '../../components/ui'
import { ErrorBanner } from '../../components/ui/StateViews'
import { Unavailable } from '../../components/ui/Unavailable'
import { useNavigate } from 'react-router-dom'
import { useAuth } from '../../lib/auth'

/**
 * **Shift handover sheet** — an accountability record: it states who ended a
 * shift and who received it. Three of the things it stated were invented.
 *
 *  1. `userName = 'Ramesh'` and `userRole = 'Warehouse'` were DEFAULT PARAMETER
 *     values, and `Header` passes `userName={user?.name}`. A null session
 *     therefore substituted a literal person *invisibly* — nothing at the call
 *     site shows the substitution, which is what makes this shape worse than an
 *     explicit `??`. The identity now comes from `useAuth()` and nowhere else,
 *     and with no session the sheet REFUSES to render rather than naming
 *     someone. A degrading fallback would be no better: "shift ended by
 *     Unknown" still asserts that a shift was ended and attributed.
 *  2. The incoming-shift picker offered `Sita` and `Hari` as hardcoded
 *     `<option>`s, presented as the staff who could receive the handover. No
 *     query in `src/lib/queries/` reads `users` at all, so there is no roster to
 *     offer — a build gap, not a product decision. The control is `Unavailable`
 *     with that reason attached.
 *  3. The summary counters (14 packed · 11 returned · 3 jobs open) and the three
 *     open jobs (B-1043 · B-1051 · B-1060) were literals in this component,
 *     rendered as the signed-in operator's own shift. Nothing reads a shift, so
 *     the sheet no longer claims one.
 *
 * `handoverRental` in `src/actions/rentals/` is the equipment handover to a
 * client — a different verb. There is no shift-handover action anywhere, so
 * "Hand over & log out" could never write what its label announced; it renders
 * through `Unavailable`, and Skip logs out without claiming a handover.
 */

const NO_SHIFT_SOURCE =
  'This build does not record shifts, so what you packed, returned, or are leaving open cannot be shown here.'

const NO_ROSTER =
  'There is no staff list in this build — nothing reads the users table, so no colleague can be named here.'

const NO_HANDOVER_ACTION =
  'Recording a shift handover needs a wired action and this build has none. Skip logs you out without recording one.'

export default function HandoverSheet({
  isOpen,
  onClose,
}: {
  isOpen: boolean
  onClose: () => void
  /**
   * Still accepted so `Header`'s existing call site typechecks, and ignored on
   * purpose — the signed-in session is the only identity this sheet will name.
   * @deprecated drop once `Header` stops passing it.
   */
  userName?: string | undefined
  /** @deprecated see `userName`. */
  userRole?: string | undefined
}) {
  const [note, setNote] = useState('')
  const navigate = useNavigate()
  /** The one identity this sheet may state. No fallback, not even a degrading one. */
  const { user, logout } = useAuth()

  const handleLogout = () => {
    logout()
    navigate('/login')
  }

  // No session, no sheet. Law 12 — the refusal is inline and persistent.
  if (!user) {
    return (
      <Modal
        isOpen={isOpen}
        onClose={onClose}
        title="Ending your shift"
        footer={
          <>
            <Button variant="secondary" onClick={onClose}>
              Close
            </Button>
            <Button variant="primary" onClick={handleLogout}>
              Log out
            </Button>
          </>
        }
      >
        <ErrorBanner
          title="No signed-in session — this sheet cannot be filled in"
          message="A handover states who ended the shift and who received it, and nothing here knows who you are. Nothing has been recorded. Sign in again to end a shift on the record, or log out — logging out now hands over nothing."
        />
      </Modal>
    )
  }

  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      title={`Ending your shift — ${user.name}, ${user.role}`}
      footer={
        <>
          <Button variant="secondary" onClick={handleLogout}>
            Skip
          </Button>
          <Unavailable reason={NO_HANDOVER_ACTION}>
            <Button variant="primary" disabled>
              Hand over & log out
            </Button>
          </Unavailable>
        </>
      }
    >
      <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-xl)', paddingTop: 'var(--sp-sm)' }}>
        {/*
          Was: three counters (14 packed · 11 returned · 3 jobs open) and three
          hardcoded bookings under "Open jobs you are leaving". Every figure was
          a literal in this file, shown as the signed-in operator's own shift —
          a number nobody entered, attributed to a real person the moment the
          identity above became real.
        */}
        <div>
          <h4 style={{ margin: '0 0 6px', fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
            Your shift so far
          </h4>
          <p style={{ margin: 0, fontSize: 'var(--t-meta)', color: 'var(--muted)', lineHeight: 1.5 }}>
            {NO_SHIFT_SOURCE}
          </p>
        </div>

        <div>
          <h4 style={{ margin: '0 0 4px', fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
            Anything the next shift should know?
          </h4>
          {/* Nothing stores this note, and no button on this sheet can. Say so
              rather than let it be typed and silently dropped at log out. */}
          <p style={{ margin: '0 0 8px', fontSize: 'var(--t-meta)', color: 'var(--muted)', lineHeight: 1.5 }}>
            {NO_HANDOVER_ACTION} A note typed here is not kept.
          </p>
          <textarea
            value={note}
            aria-label="Optional notes for the next shift"
            onChange={(e) => setNote(e.target.value)}
            placeholder="Optional notes for the next shift..."
            style={{
              width: '100%',
              minHeight: 80,
              padding: '10px 12px',
              borderRadius: 'var(--r-btn)',
              border: '1px solid var(--input-border)',
              background: 'var(--input-bg)',
              color: 'var(--text)',
              fontFamily: 'inherit',
              fontSize: 'var(--t-base)',
              resize: 'vertical',
            }}
          />
        </div>

        <div>
          <h4 style={{ margin: '0 0 8px', fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
            Hand over to <span style={{ color: 'var(--muted)', fontWeight: 400 }}>(optional)</span>
          </h4>
          <Unavailable reason={NO_ROSTER} style={{ display: 'flex', width: '100%' }}>
            <button
              type="button"
              disabled
              style={{
                width: '100%',
                minHeight: 44,
                padding: '0 12px',
                textAlign: 'left',
                borderRadius: 'var(--r-btn)',
                border: '1px dashed var(--input-border)',
                background: 'var(--input-bg)',
                color: 'var(--muted)',
                fontFamily: 'inherit',
                fontSize: 'var(--t-base)',
                cursor: 'not-allowed',
              }}
            >
              No staff list in this build — nobody can be named here
            </button>
          </Unavailable>
        </div>
      </div>
    </Modal>
  )
}
</file>

<file path="src/modules/auth/Login.tsx">
import React, { useState, useEffect, useRef } from 'react'
import { useNavigate, useLocation, Link } from 'react-router-dom'
import { Button, Input } from '../../components/ui'
import Icon from '../../components/ui/Icon'
import { AuthCard } from './AuthCard'
import { PasswordInput } from './PasswordInput'
import { ErrorBanner } from '../../components/ui/StateViews'
import { useAuth } from '../../lib/auth'
import { IS_MOCK } from '../../lib/supabase'
import { MOCK_LOGINS } from '../../lib/devQuickLogins'
import './auth.css'

const REMEMBER_EMAIL_KEY = 'babin.auth.remember_email'

/**
 * **Staff sign-in.**
 *
 * Authenticates against Supabase Auth. The role that governs capability checks
 * is read from `users.primary_role` by `AuthProvider`.
 */
export default function Login() {
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [rememberEmail, setRememberEmail] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [lockoutSeconds, setLockoutSeconds] = useState(0)
  const [busy, setBusy] = useState(false)
  const { signIn } = useAuth()
  const navigate = useNavigate()
  const location = useLocation()
  const lockoutTimerRef = useRef<number | null>(null)

  // Load remembered work email on mount
  useEffect(() => {
    try {
      const savedEmail = localStorage.getItem(REMEMBER_EMAIL_KEY)
      if (savedEmail) {
        setEmail(savedEmail)
        setRememberEmail(true)
      }
    } catch {
      /* ignore storage access error */
    }
  }, [])

  // Lockout countdown timer ticker
  useEffect(() => {
    if (lockoutSeconds > 0) {
      lockoutTimerRef.current = window.setTimeout(() => {
        setLockoutSeconds((prev) => prev - 1)
      }, 1000)
    } else if (lockoutSeconds === 0 && lockoutTimerRef.current) {
      clearTimeout(lockoutTimerRef.current)
      lockoutTimerRef.current = null
    }

    return () => {
      if (lockoutTimerRef.current) {
        clearTimeout(lockoutTimerRef.current)
      }
    }
  }, [lockoutSeconds])

  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault()
    if (busy || lockoutSeconds > 0) return
    setError(null)

    const trimmedEmail = email.trim()
    if (!trimmedEmail || !password) {
      setError('Enter your work email and password.')
      return
    }

    setBusy(true)
    const { error: signInError } = await signIn(trimmedEmail, password)
    setBusy(false)

    if (signInError) {
      // Parse rate limit or lockout cooldowns if returned by Supabase
      const matchSeconds = signInError.match(/after (\d+) seconds/i)
      if (matchSeconds && matchSeconds[1]) {
        const sec = parseInt(matchSeconds[1], 10)
        if (!isNaN(sec) && sec > 0) {
          setLockoutSeconds(sec)
        }
      }

      setError(signInError)
      return
    }

    // Persist or clear remembered email on successful authentication
    try {
      if (rememberEmail) {
        localStorage.setItem(REMEMBER_EMAIL_KEY, trimmedEmail)
      } else {
        localStorage.removeItem(REMEMBER_EMAIL_KEY)
      }
    } catch {
      /* ignore */
    }

    // Return the user to wherever the guard intercepted them, not always /dashboard.
    const from = (location.state as { from?: string } | null)?.from
    navigate(from && from !== '/login' ? from : '/dashboard', { replace: true })
  }

  return (
    <AuthCard
      title="Welcome to Babin Rentals"
      subtitle="Sign in with your work email to continue."
      footer={<LoginFooter />}
    >
      <form onSubmit={handleLogin} noValidate className="auth-form">
        <div className="auth-field">
          <label htmlFor="login-email" className="auth-label">
            Work Email
          </label>
          <Input
            id="login-email"
            type="email"
            autoComplete="username"
            autoCapitalize="none"
            spellCheck={false}
            inputMode="email"
            value={email}
            onChange={(e) => setEmail(e.target.value)}
            placeholder="name@babinrentals.com"
            autoFocus
            aria-invalid={error ? true : undefined}
            aria-describedby={error ? 'login-error' : undefined}
          />
        </div>

        <div className="auth-field">
          <label htmlFor="login-password" className="auth-label">
            Password
          </label>
          <PasswordInput
            id="login-password"
            autoComplete="current-password"
            value={password}
            onChange={(e) => setPassword(e.target.value)}
            placeholder="••••••••"
            aria-invalid={error ? true : undefined}
            aria-describedby={error ? 'login-error' : undefined}
          />
        {/* Law 12 — inline persistent error, never a toast */}
        {error && (
          <div id="login-error">
            <ErrorBanner title="Could not sign in" message={error} />
          </div>
        )}

        </div>

        {/* Remember email checkbox */}
        <label className="auth-remember-row">
          <input
            type="checkbox"
            checked={rememberEmail}
            onChange={(e) => setRememberEmail(e.target.checked)}
            className="auth-remember-checkbox"
          />
          <span className="auth-remember-label">Remember work email on this device</span>
        </label>

        {/* Live lockout countdown feedback */}
        {lockoutSeconds > 0 && (
          <div className="auth-lockout-banner" role="alert" aria-live="assertive">
            <Icon name="alert_circle" size={16} />
            <span>
              Too many sign-in attempts. Please wait{' '}
              <span className="auth-lockout-timer">{lockoutSeconds}s</span> before retrying.
            </span>
          </div>
        )}

        {/* Mock mode: Quick 1-click role logins (Strictly zero emojis) */}
        {IS_MOCK && (
          <div role="status" className="auth-mock-box">
            <div className="auth-mock-title">Quick Sign-In (Demo / Offline Mode):</div>
            <div className="auth-mock-buttons">
              {MOCK_LOGINS.map((l) => (
                <button
                  key={l.email}
                  type="button"
                  className="auth-mock-btn"
                  onClick={async () => {
                    setEmail(l.email)
                    setPassword('demo1234')
                    setBusy(true)
                    const { error: err } = await signIn(l.email, 'demo1234')
                    setBusy(false)
                    if (err) {
                      setError(err)
                    } else {
                      if (rememberEmail) {
                        try {
                          localStorage.setItem(REMEMBER_EMAIL_KEY, l.email)
                        } catch {
                          /* ignore */
                        }
                      }
                      const from = (location.state as { from?: string } | null)?.from
                      navigate(from && from !== '/login' ? from : '/dashboard', { replace: true })
                    }
                  }}
                  title={`Sign in as ${l.role}`}
                >
                  <Icon
                    name={
                      l.role === 'Owner'
                        ? 'crew'
                        : l.role === 'Warehouse'
                          ? 'package'
                          : 'card'
                    }
                    size={14}
                  />
                  <span>{l.role}</span>
                </button>
              ))}
            </div>
          </div>
        )}

        <Button
          type="submit"
          variant="primary"
          disabled={busy || lockoutSeconds > 0}
          style={{ minHeight: 44, fontSize: 16 }}
        >
          {busy ? 'Signing in…' : lockoutSeconds > 0 ? `Wait (${lockoutSeconds}s)` : 'Sign In'}
        </Button>
      </form>
    </AuthCard>
  )
}

/**
 * The secondary routes under the divider.
 */
function LoginFooter() {
  return (
    <>
      <Link
        to="/forgot-password"
        className="auth-footer-link"
      >
        Forgot password?
      </Link>
    </>
  )
}
</file>

<file path="src/modules/auth/PasswordInput.tsx">
import { forwardRef, useState } from 'react'
import { Input } from '../../components/ui'
import type { InputProps } from '../../components/ui/Input'
import Icon from '../../components/ui/Icon'

export interface PasswordInputProps
  extends Omit<InputProps, 'type' | 'iconRight' | 'onClear' | 'label' | 'error' | 'helperText'> {
  showCapsLockWarning?: boolean
}

/**
 * The shared `Input` with a show/hide toggle and Caps Lock detection,
 * for every password field in the auth flow (`Login`, `ResetPassword`).
 */
export const PasswordInput = forwardRef<HTMLInputElement, PasswordInputProps>(
  function PasswordInput({ style, showCapsLockWarning = true, onKeyDown, onKeyUp, onFocus, onBlur, ...props }, ref) {
    const [visible, setVisible] = useState(false)
    const [capsLock, setCapsLock] = useState(false)
    const [focused, setFocused] = useState(false)

    const checkCapsLock = (e: React.KeyboardEvent<HTMLInputElement>) => {
      if (typeof e.getModifierState === 'function') {
        setCapsLock(e.getModifierState('CapsLock'))
      }
    }

    return (
      <div className="auth-password-wrapper" style={{ position: 'relative' }}>
        <Input
          ref={ref}
          aria-label={props['aria-label'] || 'Password'}
          type={visible ? 'text' : 'password'}
          style={{ paddingRight: 44, ...style }}
          onKeyDown={(e) => {
            checkCapsLock(e)
            onKeyDown?.(e)
          }}
          onKeyUp={(e) => {
            checkCapsLock(e)
            onKeyUp?.(e)
          }}
          onFocus={(e) => {
            setFocused(true)
            onFocus?.(e)
          }}
          onBlur={(e) => {
            setFocused(false)
            onBlur?.(e)
          }}
          {...props}
        />
        <button
          type="button"
          className="auth-password-toggle"
          onClick={() => setVisible((v) => !v)}
          aria-label={visible ? 'Hide password' : 'Show password'}
          aria-pressed={visible}
          tabIndex={-1}
        >
          <Icon name={visible ? 'eye_off' : 'eye'} size={18} />
        </button>

        {showCapsLockWarning && capsLock && focused && (
          <div className="auth-capslock-hint" role="status" aria-live="polite">
            <Icon name="alert_circle" size={14} />
            <span>Caps Lock is ON</span>
          </div>
        )}
      </div>
    )
  }
)
</file>

<file path="src/modules/auth/ResetPassword.tsx">
import React, { useEffect, useMemo, useState } from 'react'
import { Link, useNavigate } from 'react-router-dom'
import { Button } from '../../components/ui'
import { ErrorBanner } from '../../components/ui/StateViews'
import { useAuth } from '../../lib/auth'
import { AuthCard } from './AuthCard'
import { PasswordInput } from './PasswordInput'
import './auth.css'

/**
 * **Set a new password.** Where the emailed reset link lands. Built 15 Aug 2026.
 *
 * ## There is no "current password" field, and that is not an oversight
 *
 * Supabase establishes a session when the recovery link is followed, and
 * possession of a link sent to the address on the staff row IS the proof of
 * identity. Asking for the old password would ask the one thing the person on
 * this screen has already said they do not have.
 *
 * ## Why `isPasswordRecovery` is checked rather than `user`
 *
 * `updateUser({ password })` succeeds for ANY live session, including an
 * ordinary signed-in one. Gating on `user` would therefore turn this URL into a
 * change-password screen that any unattended, unlocked desk could reach — a
 * different feature, with a different threat model, that nobody asked for. The
 * flag is set only by Supabase's `PASSWORD_RECOVERY` event, which only a
 * recovery link raises.
 *
 * ## The link's own failures arrive in the URL fragment, not as an exception
 *
 * An expired or already-used link does not throw; Supabase redirects here with
 * `#error=access_denied&error_code=otp_expired&error_description=…` and no
 * session at all. Without reading that fragment this screen would render its
 * generic refusal and the operator would be told to request a link they had just
 * requested. It is read below and stated in words.
 */
export default function ResetPassword() {
  const [password, setPassword] = useState('')
  const [confirm, setConfirm] = useState('')
  const [error, setError] = useState<string | null>(null)
  const [busy, setBusy] = useState(false)
  const { updatePassword, isPasswordRecovery } = useAuth()
  const navigate = useNavigate()

  /**
   * Read once at mount: the fragment is cleared by supabase-js as it consumes
   * the token, so a later read finds nothing. `useMemo` with an empty dep list
   * rather than `useState` because it is derived, never set.
   */
  const linkError = useMemo(() => {
    if (typeof window === 'undefined') return null
    const hash = window.location.hash.startsWith('#') ? window.location.hash.slice(1) : window.location.hash
    if (!hash) return null
    const params = new URLSearchParams(hash)
    const code = params.get('error_code')
    if (!code && !params.get('error')) return null
    if (code === 'otp_expired') {
      return 'That reset link has expired. Request a new one — links are deliberately short-lived.'
    }
    return (
      params.get('error_description')?.replace(/\+/g, ' ') ??
      'That reset link is no longer valid. Request a new one.'
    )
  }, [])

  /* Clear the fragment so a refresh does not re-render a stale failure, and so a
     token never sits in the address bar longer than the moment it is used. */
  useEffect(() => {
    if (typeof window !== 'undefined' && window.location.hash) {
      window.history.replaceState(null, '', window.location.pathname + window.location.search)
    }
  }, [])

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    if (busy) return
    setError(null)

    if (!password || !confirm) {
      setError('Enter the new password twice.')
      return
    }
    if (password !== confirm) {
      setError('The two passwords do not match.')
      return
    }

    /*
     * No minimum length is checked here. How strong a staff password must be is
     * a product decision this repo has not made, and Supabase's project setting
     * already holds one — inventing a second rule in the client would let the
     * two disagree, and the client's copy would be the one nobody updates.
     * A password the project refuses comes back as a message from the server,
     * which is shown verbatim below.
     */
    setBusy(true)
    const { error: updateError } = await updatePassword(password)
    setBusy(false)

    if (updateError) {
      setError(updateError)
      return
    }

    // The recovery session is a real session — they are signed in as themselves.
    navigate('/dashboard', { replace: true })
  }

  if (!isPasswordRecovery) {
    return (
      <AuthCard
        title="This link is not active"
        subtitle="Open the most recent link from your email to set a new password."
        footer={
          <Link
            to="/forgot-password"
            className="auth-footer-link"
          >
            Request a new link
          </Link>
        }
      >
        <ErrorBanner
          title={linkError ? 'That link cannot be used' : 'No reset in progress'}
          message={
            linkError ??
            'This page only works when you arrive from a password-reset email. Nothing has been changed.'
          }
        />
      </AuthCard>
    )
  }

  return (
    <AuthCard title="Set a new password" subtitle="Choose a password you have not used here before.">
      <form onSubmit={handleSubmit} className="auth-form">
        <div className="auth-field">
          <label
            htmlFor="new-password"
            className="auth-label"
          >
            New Password
          </label>
          <PasswordInput
            id="new-password"
            autoComplete="new-password"
            value={password}
            onChange={(e) => setPassword(e.target.value)}
            placeholder="••••••••"
            autoFocus
            aria-invalid={error ? true : undefined}
            aria-describedby={error ? 'new-password-error' : undefined}
          />
        </div>

        <div className="auth-field">
          <label
            htmlFor="confirm-password"
            className="auth-label"
          >
            Confirm New Password
          </label>
          <PasswordInput
            id="confirm-password"
            autoComplete="new-password"
            value={confirm}
            onChange={(e) => setConfirm(e.target.value)}
            placeholder="••••••••"
            aria-invalid={error ? true : undefined}
            aria-describedby={error ? 'new-password-error' : undefined}
          />
        </div>

        {error && (
          <div id="new-password-error">
            <ErrorBanner title="Could not set the password" message={error} />
          </div>
        )}

        <Button type="submit" variant="primary" disabled={busy} style={{ minHeight: 44, fontSize: 16 }}>
          {busy ? 'Saving…' : 'Set password and sign in'}
        </Button>
      </form>
    </AuthCard>
  )
}
</file>

