}

.report-kpi-header {
  display: flex;
  align-items: center;
  gap: 8px;
}

.report-kpi-label {
  font-size: var(--t-meta, 13px);
  font-weight: 600;
  color: var(--text2);
}

.report-kpi-value {
  margin-top: 8px;
  font-family: var(--font-id, 'Source Sans 3', sans-serif);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
  font-size: clamp(20px, 2.2vw, 26px);
  font-weight: 700;
  color: var(--text);
  line-height: 1.15;
}

.report-kpi-note {
  margin-top: 6px;
  font-size: var(--t-th, 12px);
  color: var(--muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ── Detailed Catalog Grid ──────────────────────────────────────────────── */
.report-catalog-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--sp-md, 16px);
  align-items: start;
}

@media (max-width: 1279px) {
