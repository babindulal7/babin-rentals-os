import { useCallback, useEffect, useId, useState, type ReactNode } from 'react'
import { WorkspaceHeaderInformation } from '../shell/WorkspacePortal'
import { FilterDrawer } from './FilterDrawer'
import Icon from './Icon'

/** RULING 2026-10-20: mirror the left filter slider for existing right-side information. */
export function InformationDrawer({ children, id, width = 320, label = 'Quick information' }: {
  children: ReactNode
  id?: string
  width?: number
  label?: string
}) {
  const generatedId = useId()
  const panelId = id ?? `information-${generatedId}`
  const [open, setOpen] = useState(false)
  const close = useCallback(() => setOpen(false), [])
  useEffect(() => {
    const reveal = (event: Event) => {
      if ((event as CustomEvent<string>).detail === label) setOpen(true)
    }
    window.addEventListener('babin:show-information', reveal)
    return () => window.removeEventListener('babin:show-information', reveal)
  }, [label])
  return <>
    <span className="information-drawer-anchor" aria-hidden="true" />
    <WorkspaceHeaderInformation>
      <button type="button" className="information-drawer-toggle" aria-label={label}
        title={label} aria-expanded={open} aria-controls={panelId}
        onClick={() => setOpen((value) => !value)}>
        <Icon name={open ? 'panel_left_close' : 'panel_left_open'} size={20} style={{ transform: 'scaleX(-1)' }} />
      </button>
    </WorkspaceHeaderInformation>
    <FilterDrawer id={panelId} open={open} onClose={close} side="right" width={width}
      title={label} description="Information, notes and related details" keepMounted>
      <aside aria-label={label} style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)', minWidth: 0 }}>
        {children}
      </aside>
    </FilterDrawer>
  </>
}
</file>

<file path="src/components/ui/InfoTooltip.tsx">
import { useState, useRef, useEffect, useCallback, type ReactNode, type CSSProperties } from 'react'
import Icon from './Icon'

export interface InfoTooltipProps {
  /** The informational text or markup to display inside the tooltip popover. */
  content: ReactNode
  /** Accessible label for the icon trigger (screen reader text). Defaults to 'More info'. */
  label?: string
  /** Size of the info icon glyph in px. Default is 14. */
  size?: number
  /** Additional styling for the trigger wrapper. */
  style?: CSSProperties
}

/**
 * Standard InfoTooltip component.
 * Renders an accessible (i) icon that reveals extra details / explanatory notes
 * on hover, focus, or tap, keeping the primary UI uncluttered.
 */
export function InfoTooltip({ content, label = 'More info', size = 14, style }: InfoTooltipProps) {
  const [isOpen, setIsOpen] = useState(false)
  const [coords, setCoords] = useState<{ top: number; left: number; placeAbove: boolean }>({ top: 0, left: 0, placeAbove: true })
  const triggerRef = useRef<HTMLButtonElement>(null)
  const tooltipRef = useRef<HTMLDivElement>(null)

  const updatePosition = useCallback(() => {
    if (!triggerRef.current) return
    const rect = triggerRef.current.getBoundingClientRect()
    const viewportWidth = window.innerWidth
    const placeAbove = rect.top > 120 // place above unless too close to viewport top

    // Center horizontally on trigger, bounded within screen
    const tooltipWidth = Math.min(280, viewportWidth - 32)
    let left = rect.left + rect.width / 2 - tooltipWidth / 2
    if (left < 16) left = 16
    if (left + tooltipWidth > viewportWidth - 16) left = viewportWidth - 16 - tooltipWidth

    const top = placeAbove ? rect.top - 8 : rect.bottom + 8
    setCoords({ top, left, placeAbove })
  }, [])

  const handleOpen = () => {
    updatePosition()
    setIsOpen(true)
  }

  const handleClose = () => {
    setIsOpen(false)
  }

  const handleToggle = (e: React.MouseEvent) => {
    e.preventDefault()
    e.stopPropagation()
    if (!isOpen) {
      updatePosition()
    }
    setIsOpen((prev) => !prev)
  }

  // Handle click outside and Escape key
  useEffect(() => {
    if (!isOpen) return

    const handleClickOutside = (e: MouseEvent | TouchEvent) => {
      if (
        triggerRef.current &&
        !triggerRef.current.contains(e.target as Node) &&
        tooltipRef.current &&
        !tooltipRef.current.contains(e.target as Node)
      ) {
        setIsOpen(false)
      }
    }

    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        setIsOpen(false)
        triggerRef.current?.focus()
      }
    }

    const handleScrollOrResize = () => {
      updatePosition()
    }

    document.addEventListener('mousedown', handleClickOutside, true)
    document.addEventListener('touchstart', handleClickOutside, true)
    document.addEventListener('keydown', handleKeyDown, true)
    window.addEventListener('scroll', handleScrollOrResize, true)
    window.addEventListener('resize', handleScrollOrResize, true)

    return () => {
      document.removeEventListener('mousedown', handleClickOutside, true)
      document.removeEventListener('touchstart', handleClickOutside, true)
      document.removeEventListener('keydown', handleKeyDown, true)
      window.removeEventListener('scroll', handleScrollOrResize, true)
      window.removeEventListener('resize', handleScrollOrResize, true)
    }
  }, [isOpen, updatePosition])

  if (!content) return null

  return (
    <span
      style={{
        display: 'inline-flex',
        alignItems: 'center',
        verticalAlign: 'middle',
        position: 'relative',
        marginLeft: 4,
        ...style,
      }}
    >
      <button
        ref={triggerRef}
        type="button"
        aria-label={label}
        aria-expanded={isOpen}
        onClick={handleToggle}
        onMouseEnter={handleOpen}
        onMouseLeave={handleClose}
        onFocus={handleOpen}
        onBlur={handleClose}
        style={{
          display: 'inline-flex',
          alignItems: 'center',
          justifyContent: 'center',
          padding: 2,
          margin: 0,
          background: isOpen ? 'var(--st-neutral-bg, rgba(255,255,255,0.08))' : 'transparent',
          border: 'none',
          borderRadius: '50%',
          color: isOpen ? 'var(--primary, #3b82f6)' : 'var(--muted, #94a3b8)',
          cursor: 'pointer',
          lineHeight: 1,
          transition: 'color 0.15s ease, background 0.15s ease',
          outline: 'none',
        }}
      >
        <Icon name="info" size={size} />
      </button>

      {isOpen && (
        <div
          ref={tooltipRef}
          role="tooltip"
          style={{
            position: 'fixed',
            top: coords.top,
            left: coords.left,
            transform: coords.placeAbove ? 'translateY(-100%)' : 'none',
            maxWidth: 280,
            width: 'max-content',
            padding: '8px 12px',
            borderRadius: 'var(--r-sm, 6px)',
            background: 'var(--card, #1c222b)',
            border: '1px solid var(--border2, #333d4b)',
            boxShadow: 'var(--shadow-modal, 0 10px 25px -5px rgba(0, 0, 0, 0.4))',
            color: 'var(--text, #f1f5f9)',
            fontSize: 'var(--t-meta, 12px)',
            fontWeight: 400,
            lineHeight: 1.45,
            zIndex: 'var(--z-toast)',
            pointerEvents: 'auto',
            wordBreak: 'break-word',
            animation: 'fadeIn 0.15s ease-out',
          }}
        >
          {content}
        </div>
      )}
    </span>
  )
}

export default InfoTooltip
</file>

<file path="src/components/ui/OverflowMenu.tsx">
import { useEffect, useId, useRef, useState, type CSSProperties, type KeyboardEvent as ReactKeyboardEvent } from 'react'
import { createPortal } from 'react-dom'
import { floatingLayer } from './floatingLayer'
import { useFloatingMenu } from './useFloatingMenu'
import Icon from './Icon'
import type { IconName } from './Icon'
import { Unavailable } from './Unavailable'

export interface OverflowMenuItem {
  label: string
  icon: IconName
  onClick: () => void
  /** Disabled entries stay visible and greyed with the reason on hover/focus/long-press. */
  unavailable?: string
  /** A nested group, opened in place rather than as a second floating layer. */
  submenu?: { label: string; onClick: () => void; unavailable?: string }[]
}

export interface OverflowMenuProps {
  items: OverflowMenuItem[]
  ariaLabel?: string
  style?: CSSProperties
}

export function OverflowMenu({ items, ariaLabel = 'More actions', style }: OverflowMenuProps) {
  const [open, setOpen] = useState(false)
  const [expanded, setExpanded] = useState<string | null>(null)
  const ref = useRef<HTMLSpanElement>(null)
  const triggerRef = useRef<HTMLButtonElement>(null)
  const menuRef = useRef<HTMLDivElement>(null)
  const menuId = useId()
  const position = useFloatingMenu(open, triggerRef, menuRef, expanded)

  const closeMenu = (returnFocus = false) => {
    setOpen(false)
    if (returnFocus) triggerRef.current?.focus()
  }

  useEffect(() => {
    if (open) menuRef.current?.querySelector<HTMLButtonElement>('[role="menuitem"]:not(:disabled)')?.focus()
  }, [open])

  useEffect(() => {
    if (expanded) menuRef.current?.querySelector<HTMLButtonElement>('[data-submenu-item]:not(:disabled)')?.focus()
  }, [expanded])

  useEffect(() => {
    if (!open) return
    const onDown = (e: PointerEvent) => {
      if (!menuRef.current?.contains(e.target as Node) && ref.current && !ref.current.contains(e.target as Node)) closeMenu()
    }
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        e.preventDefault()
        closeMenu(true)
      }
    }
    document.addEventListener('pointerdown', onDown)
    document.addEventListener('keydown', onKey)
    return () => {
      document.removeEventListener('pointerdown', onDown)
      document.removeEventListener('keydown', onKey)
    }
  }, [open])

  useEffect(() => {
    if (!open) setExpanded(null)
  }, [open])

  if (!items || items.length === 0) return null

  const onMenuKeyDown = (event: ReactKeyboardEvent<HTMLDivElement>) => {
    if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return
    const enabled = Array.from(menuRef.current?.querySelectorAll<HTMLButtonElement>('[role="menuitem"]:not(:disabled)') ?? [])
    if (enabled.length === 0) return
    event.preventDefault()
    const current = enabled.indexOf(document.activeElement as HTMLButtonElement)
    const next = event.key === 'Home' ? 0
      : event.key === 'End' ? enabled.length - 1
        : event.key === 'ArrowDown' ? (current + 1) % enabled.length
          : (current - 1 + enabled.length) % enabled.length
    enabled[next]?.focus()
  }

  return (
    <span ref={ref} style={{ position: 'relative', display: 'inline-flex', ...style }}>
      <button
        ref={triggerRef}
        type="button"
        aria-label={ariaLabel}
        aria-haspopup="menu"
        aria-expanded={open}
        aria-controls={menuId}
        onClick={() => open ? closeMenu(true) : setOpen(true)}
        style={{
          width: 36,
          height: 36,
          minWidth: 36,
          minHeight: 36,
          borderRadius: 'var(--r-btn, 8px)',
          border: '1px solid var(--border)',
          background: open ? 'var(--hover-card)' : 'transparent',
          color: 'var(--text2)',
          display: 'grid',
          placeItems: 'center',
          cursor: 'pointer',
          boxSizing: 'border-box',
        }}
      >
        <Icon name="more_vert" size={16} />
      </button>

      {open && createPortal(
        <div
          id={menuId}
          ref={menuRef}
          role="menu"
          aria-label={ariaLabel}
          onKeyDown={onMenuKeyDown}
          style={{
            // User shell audit: escape clipping cards/tables and fit the viewport.
            position: 'fixed',
            top: position?.top ?? 0,
            left: position?.left ?? 0,
            width: position?.width ?? 230,
            maxHeight: position?.maxHeight,
            visibility: position ? 'visible' : 'hidden',
            overflowY: 'auto',
            overscrollBehavior: 'contain',
            zIndex: floatingLayer(triggerRef.current),
            background: 'var(--card)',
            border: '1px solid var(--border)',
            borderRadius: 'var(--r-card)',
            boxShadow: 'var(--shadow-card)',
            padding: 4,
            display: 'flex',
            flexDirection: 'column',
            gap: 2,
          }}
        >
          {items.map((it) => {
            const hasSub = Boolean(it.submenu && it.submenu.length > 0)
            const isSubExpanded = expanded === it.label
            const disabled = Boolean(it.unavailable)

            const itemButton = (
              <button
                type="button"
                role="menuitem"
                className="overflow-menu__item"
                disabled={disabled}
                aria-disabled={disabled ? 'true' : undefined}
                title={it.unavailable}
                aria-haspopup={hasSub ? 'menu' : undefined}
                aria-expanded={hasSub ? isSubExpanded : undefined}
                onClick={() => {
                  if (disabled) return
                  if (hasSub) {
                    setExpanded((prev) => (prev === it.label ? null : it.label))
                  } else {
                    it.onClick()
                    closeMenu(true)
                  }
                }}
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  gap: 8,
                  minHeight: 44,
                  padding: '0 10px',
                  borderRadius: 'var(--r-sm)',
                  border: 'none',
                  background: isSubExpanded ? 'var(--hover-card)' : 'transparent',
                  color: disabled ? 'var(--muted)' : 'var(--text)',
                  fontSize: 'var(--t-meta)',
                  fontFamily: 'inherit',
                  fontWeight: 500,
                  cursor: disabled ? 'not-allowed' : 'pointer',
                  textAlign: 'left',
                  width: '100%',
                }}
              >
                <span style={{ display: 'inline-flex', alignItems: 'center', gap: 8 }}>
                  <Icon name={it.icon} size={15} style={{ color: disabled ? 'var(--muted)' : 'var(--text2)' }} />
                  {it.label}
                </span>
                {hasSub && <Icon name={isSubExpanded ? 'chevron_up' : 'chevron_down'} size={14} style={{ color: 'var(--muted)' }} />}
              </button>
            )

            return (
              <div key={it.label} style={{ display: 'flex', flexDirection: 'column', flexShrink: 0 }}>
                {it.unavailable ? (
                  <Unavailable reason={it.unavailable} style={{ width: '100%' }}>
                    {itemButton}
                  </Unavailable>
                ) : (
                  itemButton
                )}

                {hasSub && isSubExpanded && (
                  <div
                    style={{
                      margin: '2px 0 4px 18px',
                      paddingLeft: 8,
                      borderLeft: '2px solid var(--border)',
                      display: 'flex',
                      flexDirection: 'column',
                      gap: 2,
                    }}
                  >
                    {it.submenu!.map((sub) => {
                      const subDisabled = Boolean(sub.unavailable)
                      const subButton = (
                        <button
                          key={sub.label}
                          type="button"
                          role="menuitem"
                          data-submenu-item=""
                          className="overflow-menu__item"
                          disabled={subDisabled}
                          aria-disabled={subDisabled ? 'true' : undefined}
                          title={sub.unavailable}
                          onClick={() => {
                            if (subDisabled) return
                            sub.onClick()
                            closeMenu(true)
                          }}
                          style={{
                            display: 'flex',
                            alignItems: 'center',
                            gap: 6,
                            minHeight: 44,
                            padding: '0 8px',
                            borderRadius: 'var(--r-sm)',
                            border: 'none',
                            background: 'transparent',
                            color: subDisabled ? 'var(--muted)' : 'var(--text2)',
                            fontSize: 'var(--t-meta)',
                            fontFamily: 'inherit',
                            cursor: subDisabled ? 'not-allowed' : 'pointer',
                            textAlign: 'left',
                            width: '100%',
                          }}
                        >
                          {sub.label}
                        </button>
                      )

                      return sub.unavailable ? (
                        <Unavailable key={sub.label} reason={sub.unavailable} style={{ width: '100%' }}>
                          {subButton}
                        </Unavailable>
                      ) : (
                        <div key={sub.label}>{subButton}</div>
                      )
                    })}
                  </div>
                )}
              </div>
            )
          })}
        </div>, document.body
      )}
    </span>
  )
}
export default OverflowMenu
