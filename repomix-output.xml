        },
        { userId: '00000000-0000-4000-8000-000000000001', role: 'Warehouse', isOnline: true },
      ),
    ).rejects.toThrow(/rental\.close/)

    // 6. Authorized role (Owner) closes rental
    const closeRes = await closeRental(
      {
