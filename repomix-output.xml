/**
 * ProductionsList — Project lifecycle hub rollup.
 *
 * Ported from the standalone's productions screen.
 * Tracks multi-day shoots, booking rollups, crew assignments,
 * and lifecycle phases: Pre-Production -> Shoot -> Return -> Wrap.
 */
import { useState, useMemo, useCallback } from 'react'
import { Link } from 'react-router-dom'
import { Card, KpiStrip, PageHeader, PageActions } from '../../components/ui/Page'
import type { Kpi } from '../../components/ui/Page'
import { Button } from '../../components/ui/Button'
import Icon from '../../components/ui/Icon'
import { Badge } from '../../components/ui/Badge'
import { SearchInput } from '../../components/ui/SearchInput'
import { PageShell } from '../../components/ui/PageShell'
import { Modal } from '../../components/ui/Modal'
import { useToast } from '../../components/ui/Toast'
import { formatMoney, rupees } from '../../lib/money'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import { useViewport } from '../../lib/device'
import { getBusinessToday } from '../../lib/bs'
import { IS_MOCK } from '../../lib/supabase'
import {
  PROD_PHASES,
  getProductions,
  createProduction,
  updateProductionPhase,
  getProductionStats,
  type Production,
  type ProductionPhase,
} from '../../lib/queries/productions'

const chipStyle = (active: boolean): React.CSSProperties => ({
  minHeight: 'var(--tap, 44px)',
  padding: '6px 14px',
  borderRadius: '9px',
  fontSize: '12px',
  fontWeight: 600,
  cursor: 'pointer',
  display: 'inline-flex',
  alignItems: 'center',
  border: active ? '1px solid rgba(47, 125, 255, 0.4)' : '1px solid var(--border)',
  background: active ? 'rgba(47, 125, 255, 0.14)' : 'transparent',
  color: active ? 'var(--info)' : 'var(--text3)',
  transition: 'all 0.15s',
})

const stepperStepStyle = (isCurrent: boolean, isPast: boolean): React.CSSProperties => ({
  flex: 1,
  minHeight: '36px',
  textAlign: 'center',
  padding: '6px 4px',
  borderRadius: '7px',
  fontSize: '11px',
  fontWeight: 600,
  cursor: 'pointer',
  display: 'inline-flex',
  alignItems: 'center',
  justifyContent: 'center',
  background: isCurrent ? 'var(--info)' : isPast ? 'rgba(46, 204, 143, 0.14)' : 'var(--surface)',
  color: isCurrent ? '#fff' : isPast ? 'var(--green)' : 'var(--text3)',
  border: isCurrent ? '1px solid var(--info)' : isPast ? '1px solid rgba(46, 204, 143, 0.3)' : '1px solid var(--border)',
  transition: 'all 0.15s',
})

export default function ProductionsList() {
  if (IS_MOCK) return <ProductionPreview />
  return (
    <PageShell header={<PageHeader title="Productions" />}>
      <Card><div role="status" style={{ padding: 'var(--sp-md)' }}>
        <h2>Production tracking unavailable</h2>
        <p>Shared production tracking is not available yet. Existing entries on this device have been kept.</p>
        <Link to="/rentals">Open Rentals</Link>
      </div></Card>
    </PageShell>
  )
}

function ProductionPreview() {
  const { showSuccessToast } = useToast()
  const viewport = useViewport()
  const isPhone = viewport === 'phone'
  const canViewMoney = useCanViewMoney()

  const [productions, setProductions] = useState<Production[]>(getProductions)
  const [phaseFilter, setPhaseFilter] = useState<'All' | ProductionPhase>('All')
  const [search, setSearch] = useState('')
  const [selectedProd, setSelectedProd] = useState<Production | null>(null)
  const [isNewModalOpen, setIsNewModalOpen] = useState(false)

  // New production form state
  const [newTitle, setNewTitle] = useState('')
  const [newClient, setNewClient] = useState('')
  const [newBookingId, setNewBookingId] = useState('')
  const [newDirector, setNewDirector] = useState('')
  const [newDop, setNewDop] = useState('')
  const [newDates, setNewDates] = useState('')
  const [newLocation, setNewLocation] = useState('')
  const [newGearCount, setNewGearCount] = useState('10')
  const [newBudget, setNewBudget] = useState('50000')
  const [newCrew, setNewCrew] = useState('')
  const [newNotes, setNewNotes] = useState('')

  const stats = useMemo(() => getProductionStats(productions), [productions])

  const filtered = useMemo(() => {
    return productions.filter((p) => {
      if (phaseFilter !== 'All' && p.phase !== phaseFilter) return false
      if (search.trim()) {
        const q = search.toLowerCase()
        return (
          p.title.toLowerCase().includes(q) ||
          p.client.toLowerCase().includes(q) ||
          p.director.toLowerCase().includes(q) ||
          p.dop.toLowerCase().includes(q) ||
          p.bookingId.toLowerCase().includes(q)
        )
      }
      return true
    })
  }, [productions, phaseFilter, search])

  const handlePhaseChange = useCallback((id: string, nextPhase: ProductionPhase) => {
    const updated = updateProductionPhase(id, nextPhase)
    setProductions([...updated])
    if (selectedProd && selectedProd.id === id) {
      setSelectedProd({ ...selectedProd, phase: nextPhase })
    }
    showSuccessToast(`Production phase updated to ${nextPhase}`)
  }, [selectedProd, showSuccessToast])

  const handleCreate = useCallback(() => {
    if (!newTitle.trim() || !newClient.trim()) return
    const created = createProduction({
      title: newTitle.trim(),
      client: newClient.trim(),
      bookingId: newBookingId.trim() || 'BR-NEW',
      director: newDirector.trim() || '—',
      dop: newDop.trim() || '—',
      dates: newDates.trim() || 'TBD',
      startDate: getBusinessToday().toISOString().slice(0, 10),
      endDate: getBusinessToday().toISOString().slice(0, 10),
      phase: 'Pre-Production',
      gearCount: Number(newGearCount) || 0,
      budgetNpr: Number(newBudget) || 0,
      crewSummary: newCrew.trim() || 'Crew unassigned',
      location: newLocation.trim() || 'Kathmandu',
      notes: newNotes.trim(),
    })

    setProductions(getProductions())
    setIsNewModalOpen(false)
    setNewTitle('')
    setNewClient('')
    setNewBookingId('')
    setNewDirector('')
    setNewDop('')
    setNewDates('')
    setNewLocation('')
    setNewCrew('')
    setNewNotes('')
    showSuccessToast(`Created production ${created.title}`)
  }, [newTitle, newClient, newBookingId, newDirector, newDop, newDates, newLocation, newGearCount, newBudget, newCrew, newNotes, showSuccessToast])

  const kpis: Kpi[] = useMemo(() => [
    { label: 'Active Productions', value: String(stats.totalCount), icon: 'video' as const, accent: 'primary' },
    { label: 'Shooting Now', value: String(stats.inShootCount), icon: 'camera', accent: 'success' },
    { label: 'Pre-Production', value: String(stats.preProdCount), icon: 'timer', accent: 'progress' },
    ...(canViewMoney
      ? [
          {
            label: 'Total Production Budget',
            value: formatMoney(rupees(stats.totalBudget)),
            icon: 'card' as const,
            accent: 'primary' as const,
            definition: 'Estimated equipment & services value across all active projects.',
          },
        ]
      : []),
  ], [stats, canViewMoney])

  return (
    <PageShell
      header={
        <PageHeader
          title="Productions Hub"
          description="High-level project rollups, shoot schedules, and equipment/crew packages."
          search={{
            value: search,
            onChange: setSearch,
            placeholder: 'Search title, client, director… (press /)',
          }}
          actions={
            <PageActions
              primary={
                <Button variant="primary" onClick={() => setIsNewModalOpen(true)}>
                  <Icon name="plus" size={14} />
                  New Production
                </Button>
              }
            />
          }
        />
      }
    >
      {/* KPI strip */}
      <KpiStrip items={kpis} columns={isPhone ? 2 : (canViewMoney ? 4 : 3)} />

      {/* Filter and search bar */}
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '12px', flexWrap: 'wrap', margin: 'var(--sp-md) 0' }}>
        <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap' }}>
          {(['All', ...PROD_PHASES] as const).map((ph) => (
            <button
              key={ph}
              type="button"
              aria-pressed={phaseFilter === ph}
              style={chipStyle(phaseFilter === ph)}
              onClick={() => setPhaseFilter(ph)}
            >
              {ph}
            </button>
          ))}
        </div>
        <div style={{ minWidth: 200, maxWidth: 300 }}>
          <SearchInput value={search} onChange={setSearch} placeholder="Search title, client, director…" />
        </div>
      </div>

      {/* Productions grid */}
      <div style={{ display: 'grid', gridTemplateColumns: isPhone ? '1fr' : 'repeat(auto-fill, minmax(360px, 1fr))', gap: 'var(--sp-md)' }}>
        {filtered.map((prod) => {
          const currentPhaseIdx = PROD_PHASES.indexOf(prod.phase)
          return (
            <Card key={prod.id}>
              <div style={{ padding: '16px', display: 'flex', flexDirection: 'column', gap: '12px' }}>
                {/* Header row */}
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', gap: '8px' }}>
                  <div>
                    <span style={{ fontSize: '11px', color: 'var(--text3)', fontWeight: 600, textTransform: 'uppercase' }}>
                      {prod.id} · <Link to={`/rentals`} style={{ color: 'var(--info)', textDecoration: 'none' }}>{prod.bookingId}</Link>
                    </span>
                    <h3 style={{ margin: '3px 0 0', fontSize: '16px', fontWeight: 700, color: 'var(--text)' }}>
                      {prod.title}
                    </h3>
                    <div style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', marginTop: '2px' }}>
                      {prod.client}
                    </div>
                  </div>
                  <Badge
                    tone={prod.phase === 'Shoot' ? 'in' : prod.phase === 'Return' ? 'warning' : prod.phase === 'Wrap' ? 'neutral' : 'primary'}
                    label={prod.phase}
                  />
                </div>

                {/* Lifecycle Stepper */}
                <div style={{ display: 'flex', gap: '4px', margin: '4px 0' }}>
                  {PROD_PHASES.map((p, idx) => (
                    <button
                      key={p}
                      type="button"
                      aria-pressed={idx === currentPhaseIdx}
                      style={stepperStepStyle(idx === currentPhaseIdx, idx < currentPhaseIdx)}
                      onClick={() => handlePhaseChange(prod.id, p)}
                      title={`Click to set stage to ${p}`}
                    >
                      {p}
                    </button>
                  ))}
                </div>

                {/* Facts row */}
                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(2, 1fr)', gap: '8px', padding: '10px 12px', background: 'var(--surface)', borderRadius: '8px', fontSize: 'var(--t-meta)' }}>
                  <div>
                    <div style={{ color: 'var(--text3)', fontSize: '11px' }}>Dates & Place</div>
                    <div style={{ fontWeight: 500, color: 'var(--text)' }}>{prod.dates}</div>
                    <div style={{ color: 'var(--text3)', fontSize: '11px' }}>{prod.location}</div>
                  </div>
                  <div>
                    <div style={{ color: 'var(--text3)', fontSize: '11px' }}>{canViewMoney ? 'Gear & Budget' : 'Gear'}</div>
                    <div style={{ fontWeight: 500, color: 'var(--text)' }}>{prod.gearCount} items</div>
                    {canViewMoney && (
                      <div style={{ color: 'var(--text2)', fontWeight: 600 }}>
                        {formatMoney(rupees(prod.budgetNpr))}
                      </div>
                    )}
                  </div>
                </div>

                {/* Crew line */}
                <div style={{ fontSize: 'var(--t-meta)', color: 'var(--text3)', display: 'flex', alignItems: 'center', gap: '6px' }}>
                  <Icon name="users" size={13} />
                  <span style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                    {prod.crewSummary}
                  </span>
                </div>

                {/* Footer action */}
                <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '8px', marginTop: '4px' }}>
                  <Button variant="outline" onClick={() => setSelectedProd(prod)}>
                    View Details
                  </Button>
                </div>
              </div>
            </Card>
          )
        })}
      </div>

      {filtered.length === 0 && (
        <div style={{ textAlign: 'center', padding: '60px 20px', color: 'var(--text3)' }}>
          No productions matching criteria
        </div>
      )}

      {/* Production Detail Modal */}
      {selectedProd && (
        <Modal isOpen onClose={() => setSelectedProd(null)} title={selectedProd.title}>
          <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <div>
                <span style={{ fontSize: '12px', color: 'var(--text3)' }}>{selectedProd.id} · {selectedProd.bookingId}</span>
                <div style={{ fontWeight: 600, fontSize: '15px' }}>{selectedProd.client}</div>
              </div>
              <Badge tone="primary" label={selectedProd.phase} />
            </div>

            {/* Stepper inside modal */}
            <div>
              <div style={{ fontSize: '11px', fontWeight: 600, color: 'var(--text2)', marginBottom: '6px' }}>
                ADVANCE PRODUCTION STAGE
              </div>
              <div style={{ display: 'flex', gap: '6px' }}>
                {PROD_PHASES.map((p) => (
                  <button
                    key={p}
                    type="button"
                    aria-pressed={p === selectedProd.phase}
                    style={stepperStepStyle(p === selectedProd.phase, PROD_PHASES.indexOf(p) < PROD_PHASES.indexOf(selectedProd.phase))}
                    onClick={() => handlePhaseChange(selectedProd.id, p)}
                  >
                    {p}
                  </button>
                ))}
              </div>
            </div>

            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '12px', fontSize: 'var(--t-meta)' }}>
              <div><strong>Director:</strong> {selectedProd.director}</div>
              <div><strong>Cinematographer:</strong> {selectedProd.dop}</div>
              <div><strong>Dates:</strong> {selectedProd.dates}</div>
              <div><strong>Location:</strong> {selectedProd.location}</div>
              <div><strong>Total Gear:</strong> {selectedProd.gearCount} items</div>
              {canViewMoney && (
                <div><strong>Budget:</strong> {formatMoney(rupees(selectedProd.budgetNpr))}</div>
              )}
            </div>

            <div>
              <strong>Assigned Crew:</strong>
              <div style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', marginTop: '4px' }}>
                {selectedProd.crewSummary}
              </div>
            </div>

            {selectedProd.notes && (
              <div style={{ padding: '10px 12px', background: 'var(--surface)', borderRadius: '8px', fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
                <strong>Production Notes:</strong> {selectedProd.notes}
              </div>
            )}

            <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '8px', marginTop: '12px' }}>
              <Button onClick={() => setSelectedProd(null)}>Close</Button>
            </div>
          </div>
        </Modal>
      )}

      {/* New Production Modal */}
      {isNewModalOpen && (
        <Modal isOpen onClose={() => setIsNewModalOpen(false)} title="Create New Production">
          <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
            <div>
              <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text2)' }}>Project Title *</label>
              <input
                type="text"
                placeholder='e.g. "Echoes of Mustang"'
                value={newTitle}
                onChange={(e) => setNewTitle(e.target.value)}
                style={{ width: '100%', padding: '8px 10px', borderRadius: '8px', border: '1px solid var(--border)', background: 'var(--surface)', color: 'var(--text)', marginTop: '4px' }}
              />
            </div>

            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '10px' }}>
              <div>
                <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text2)' }}>Client / Production Co. *</label>
                <input
                  type="text"
                  placeholder="e.g. Himalayan Films"
                  value={newClient}
                  onChange={(e) => setNewClient(e.target.value)}
                  style={{ width: '100%', padding: '8px 10px', borderRadius: '8px', border: '1px solid var(--border)', background: 'var(--surface)', color: 'var(--text)', marginTop: '4px' }}
                />
              </div>
              <div>
                <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text2)' }}>Linked Booking No.</label>
                <input
                  type="text"
                  placeholder="e.g. BR-2615"
                  value={newBookingId}
                  onChange={(e) => setNewBookingId(e.target.value)}
                  style={{ width: '100%', padding: '8px 10px', borderRadius: '8px', border: '1px solid var(--border)', background: 'var(--surface)', color: 'var(--text)', marginTop: '4px' }}
                />
              </div>
            </div>

            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '10px' }}>
              <div>
                <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text2)' }}>Director</label>
                <input
                  type="text"
                  placeholder="Director name"
                  value={newDirector}
                  onChange={(e) => setNewDirector(e.target.value)}
                  style={{ width: '100%', padding: '8px 10px', borderRadius: '8px', border: '1px solid var(--border)', background: 'var(--surface)', color: 'var(--text)', marginTop: '4px' }}
                />
              </div>
              <div>
                <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text2)' }}>Cinematographer (DOP)</label>
                <input
                  type="text"
                  placeholder="DOP name"
                  value={newDop}
                  onChange={(e) => setNewDop(e.target.value)}
                  style={{ width: '100%', padding: '8px 10px', borderRadius: '8px', border: '1px solid var(--border)', background: 'var(--surface)', color: 'var(--text)', marginTop: '4px' }}
                />
              </div>
            </div>

            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '10px' }}>
              <div>
                <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text2)' }}>Shoot Dates</label>
                <input
                  type="text"
                  placeholder="e.g. 24 Jul – 28 Jul"
                  value={newDates}
                  onChange={(e) => setNewDates(e.target.value)}
                  style={{ width: '100%', padding: '8px 10px', borderRadius: '8px', border: '1px solid var(--border)', background: 'var(--surface)', color: 'var(--text)', marginTop: '4px' }}
                />
              </div>
              <div>
                <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text2)' }}>Location</label>
                <input
                  type="text"
                  placeholder="e.g. Mustang / Patan"
                  value={newLocation}
                  onChange={(e) => setNewLocation(e.target.value)}
                  style={{ width: '100%', padding: '8px 10px', borderRadius: '8px', border: '1px solid var(--border)', background: 'var(--surface)', color: 'var(--text)', marginTop: '4px' }}
                />
              </div>
            </div>

            <div style={{ display: 'grid', gridTemplateColumns: canViewMoney ? '1fr 1fr' : '1fr', gap: '10px' }}>
              <div>
                <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text2)' }}>Gear Items Count</label>
                <input
                  type="number"
                  value={newGearCount}
                  onChange={(e) => setNewGearCount(e.target.value)}
                  style={{ width: '100%', padding: '8px 10px', borderRadius: '8px', border: '1px solid var(--border)', background: 'var(--surface)', color: 'var(--text)', marginTop: '4px' }}
                />
              </div>
              {canViewMoney && (
                <div>
                  <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text2)' }}>Estimated Budget (NPR)</label>
                  <input
                    type="number"
                    value={newBudget}
                    onChange={(e) => setNewBudget(e.target.value)}
                    style={{ width: '100%', padding: '8px 10px', borderRadius: '8px', border: '1px solid var(--border)', background: 'var(--surface)', color: 'var(--text)', marginTop: '4px' }}
                  />
                </div>
              )}
            </div>

            <div>
              <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text2)' }}>Assigned Crew</label>
              <input
                type="text"
                placeholder="e.g. Bikash Tamang (DOP), Suman Rai (Gaffer)"
                value={newCrew}
                onChange={(e) => setNewCrew(e.target.value)}
                style={{ width: '100%', padding: '8px 10px', borderRadius: '8px', border: '1px solid var(--border)', background: 'var(--surface)', color: 'var(--text)', marginTop: '4px' }}
              />
            </div>

            <div>
              <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text2)' }}>Special Notes</label>
              <textarea
                placeholder="Location conditions, power requirements, special riders..."
                value={newNotes}
                onChange={(e) => setNewNotes(e.target.value)}
                rows={2}
                style={{ width: '100%', padding: '8px 10px', borderRadius: '8px', border: '1px solid var(--border)', background: 'var(--surface)', color: 'var(--text)', marginTop: '4px', resize: 'vertical' }}
              />
            </div>

            <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '8px', marginTop: '12px' }}>
              <Button onClick={() => setIsNewModalOpen(false)}>Cancel</Button>
              <Button variant="primary" onClick={handleCreate} disabled={!newTitle.trim() || !newClient.trim()}>
                Create Production
              </Button>
            </div>
          </div>
        </Modal>
      )}
    </PageShell>
  )
}
</file>

<file path="src/modules/rentals/rental-timeline.css">
.rental-timeline { container-type: inline-size; container-name: timeline; min-width: 0; color: var(--text); }
.rental-timeline__summary { min-height: 48px; display: flex; align-items: center; justify-content: space-between; gap: var(--sp-md); padding: 0 16px; border-bottom: 1px solid var(--border); color: var(--text2); font-size: var(--t-meta); }
.rental-timeline__summary strong { color: var(--text); font-variant-numeric: tabular-nums; }
.rental-timeline__legend { display: flex; align-items: center; gap: 14px; color: var(--muted); font-size: var(--t-caption); }
.rental-timeline__legend span { display: inline-flex; align-items: center; gap: 6px; }
.rental-timeline__legend i { width: 8px; height: 8px; border-radius: 50%; }
.rental-timeline__legend-pickup { background: var(--primary); }
.rental-timeline__legend-return { background: var(--success); }
.rental-timeline__notice { display: flex; align-items: center; gap: 7px; padding: 9px 16px; background: var(--select-bg); color: var(--text2); font-size: var(--t-caption); }
.rental-timeline__scroll { overflow: auto; outline: none; scrollbar-color: var(--border2) transparent; }
.rental-timeline__scroll:focus-visible { box-shadow: inset 0 0 0 2px var(--input-focus); }
.rental-timeline__canvas { min-width: calc(240px + var(--timeline-width)); }
.rental-timeline__corner { position: sticky; left: 0; z-index: 4; width: 240px; height: 58px; display: flex; align-items: flex-end; box-sizing: border-box; padding: 0 16px 12px; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--card2); color: var(--muted); font-size: var(--t-caption); font-weight: 700; }
.rental-timeline__days { height: 58px; display: flex; margin-left: 240px; margin-top: -58px; border-bottom: 1px solid var(--border); background: var(--card2); }
.rental-timeline__day { flex: 0 0 auto; display: grid; align-content: center; gap: 2px; box-sizing: border-box; padding-left: 10px; border-right: 1px solid var(--border); color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: .04em; }
.rental-timeline__day strong { color: var(--text2); font-size: var(--t-caption); text-transform: none; letter-spacing: 0; font-variant-numeric: tabular-nums; }
.rental-timeline__row { display: grid; grid-template-columns: 240px var(--timeline-width); min-height: 66px; border-bottom: 1px solid var(--border); }
.rental-timeline__row:last-child { border-bottom: 0; }
.rental-timeline__identity { position: sticky; left: 0; z-index: 3; min-width: 0; padding: 10px 16px; box-sizing: border-box; border-right: 1px solid var(--border); background: var(--card); }
.rental-timeline__booking { color: var(--link); font-size: var(--t-meta); font-weight: 700; text-decoration: none; }
.rental-timeline__booking:hover { text-decoration: underline; }
.rental-timeline__client { margin-top: 2px; overflow: hidden; color: var(--text); font-size: var(--t-caption); font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.rental-timeline__project { margin-top: 1px; overflow: hidden; color: var(--muted); font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
.rental-timeline__track { position: relative; display: flex; min-width: 0; overflow: hidden; }
.rental-timeline__gridline { flex: 0 0 auto; box-sizing: border-box; border-right: 1px solid color-mix(in srgb, var(--border) 72%, transparent); }
.rental-timeline__today { position: absolute; z-index: 2; inset-block: 0; width: 1px; background: var(--danger); opacity: .7; }
.rental-timeline__today::before { content: ''; position: absolute; top: 0; left: -3px; width: 7px; height: 7px; border-radius: 50%; background: var(--danger); }
.rental-timeline__bar { position: absolute; z-index: 1; top: 17px; height: 32px; min-width: 28px; display: flex; align-items: center; justify-content: space-between; gap: 6px; box-sizing: border-box; padding: 0 8px; overflow: hidden; border: 1px solid var(--select-bg); border-radius: 7px; background: var(--select-bg); color: var(--select-fg); text-decoration: none; box-shadow: 0 4px 12px color-mix(in srgb, var(--select-bg) 12%, transparent); transition: box-shadow .18s ease, filter .18s ease; }
.rental-timeline__bar:hover { filter: brightness(1.06); box-shadow: 0 7px 16px color-mix(in srgb, var(--primary) 18%, transparent); }
.rental-timeline__bar:active { filter: brightness(0.96); }
.rental-timeline__bar[data-status='Packed'] { background: var(--st-progress-bg); color: var(--st-progress-fg); border-color: var(--ready); }
.rental-timeline__bar[data-status='On Rent'] { background: var(--st-out-bg); color: var(--st-out-fg); border-color: var(--warn); }
.rental-timeline__bar[data-status='Returned'] { background: var(--st-in-bg); color: var(--st-in-fg); border-color: var(--success); }
.rental-timeline__bar[data-status='Closed'] { background: var(--card2); color: var(--muted); border-color: var(--border2); }
.rental-timeline__bar[data-status='Quote'] { background: var(--card2); color: var(--text2); border-color: var(--border2); }
.rental-timeline__bar-label { overflow: hidden; font-size: 10px; font-weight: 750; letter-spacing: .03em; text-overflow: ellipsis; text-transform: uppercase; white-space: nowrap; }
.rental-timeline__endpoint { width: 7px; height: 7px; flex: 0 0 auto; border-radius: 50%; background: currentColor; }
.rental-timeline__endpoint--return { box-shadow: 0 0 0 2px color-mix(in srgb, currentColor 20%, transparent); }
.rental-timeline-phone { display: grid; gap: 10px; padding: 12px; background: var(--bg); }
.rental-timeline-phone__card { padding: 14px; border: 1px solid var(--border); border-radius: var(--r-card); background: var(--card); }
.rental-timeline-phone__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.rental-timeline-phone__journey { display: grid; grid-template-columns: 24px 1fr; margin-top: 14px; }
.rental-timeline-phone__event { grid-column: 1 / -1; display: grid; grid-template-columns: 24px 1fr; align-items: center; gap: 9px; color: var(--text2); font-size: var(--t-caption); font-variant-numeric: tabular-nums; }
.rental-timeline-phone__event strong { display: block; margin-bottom: 2px; color: var(--text); }
.rental-timeline-phone__dot { width: 24px; height: 24px; display: grid; place-items: center; border-radius: 50%; background: var(--select-bg); color: var(--select-bg); }
.rental-timeline-phone__line { width: 1px; height: 18px; margin: 3px 0 3px 12px; background: var(--border2); }
/* Component-internal density tweak (UI Consistency Phase 1, Decision 1):
   Container query preserves column density when the timeline component itself
   narrows below 1100px, without introducing a non-canonical global viewport band. */
@container timeline (max-width: 1100px) { .rental-timeline__corner, .rental-timeline__row { grid-template-columns: 200px var(--timeline-width); } .rental-timeline__corner { width: 200px; } .rental-timeline__days { margin-left: 200px; } }
@media (prefers-reduced-motion: reduce) { .rental-timeline__bar { transition: none; } }
</file>

<file path="src/modules/reports/ActivityReports.tsx">
import { formatAdDateTime } from '../../lib/bs'
import { useMemo, useState } from 'react'
import { PageHeader, KpiStrip, cardStyle } from '../../components/ui/Page'
import type { Kpi } from '../../components/ui/Page'
import { DataTableShell } from '../../components/ui/DataTable'
import { PageBody } from '../../components/ui/PageBody'
import { useLoad } from '../../lib/queries/useLoad'
import { hasReportFilters } from './reportStates'
import { ReportToolbar } from '../../components/ui/ReportToolbar'
import type { ReportCsvRow, ReportFilters } from '../../components/ui/ReportToolbar'
import { Donut, Legend, type Slice } from '../../components/ui/Charts'
import Icon from '../../components/ui/Icon'
import { useViewport } from '../../lib/device'
import { getActivityReport, type ActivityReportFilterOptions } from '../../lib/queries/activityReports'

type ActivityTab = 'overview' | 'operators' | 'stream'

const th = {
  textAlign: 'left' as const,
  padding: '10px 12px',
  fontSize: 'var(--t-th)',
  fontWeight: 600,
  color: 'var(--text2)',
  whiteSpace: 'nowrap' as const,
  borderBottom: '1px solid var(--border)',
}

const td = {
  height: 'var(--row-min-h)',
  padding: '10px 12px',
  fontSize: 'var(--t-meta)',
  color: 'var(--text)',
  borderBottom: '1px solid var(--border)',
}

export default function ActivityReports() {
  const viewport = useViewport()
  const [activeTab, setActiveTab] = useState<ActivityTab>('overview')
  const [filters, setFilters] = useState<ReportFilters>({})
  /* Phase 6 — the read used to fall back to seed staff and a seed activity
     log on failure and on an empty period; it now throws, and `PageBody` draws
     loading · Error + Retry · nothing-yet vs "nothing in this period". */
  const filtered = hasReportFilters(filters)
  const load = useLoad(
    () => {
      const queryOpts: ActivityReportFilterOptions = {
        ...(filters.dateRange?.fromAd ? { from: filters.dateRange.fromAd } : {}),
        ...(filters.dateRange?.toAd ? { to: filters.dateRange.toAd } : {}),
      }
      return getActivityReport(queryOpts)
    },
    { key: JSON.stringify(filters) },
  )
  const data = load.data

  const kpis = useMemo<Kpi[]>(() => {
    if (!data) return []
    const m = data.metrics
    const successRate = m.totalEvents > 0 ? Math.round((m.successfulEvents / m.totalEvents) * 100) : null

    return [
      {
        label: 'Total Audit Events',
        value: String(m.totalEvents),
        icon: 'activity',
        accent: 'primary',
        note: `Across ${data.eventsByCategory.length} system domains`,
      },
      {
        label: 'Active Operators',
        value: String(m.activeOperators),
        icon: 'users',
        accent: 'neutral',
        note: `Most active: ${m.mostActiveOperator}`,
      },
      {
        label: 'Operation Success',
        value: successRate === null ? '—' : `${successRate}%`,
        icon: 'check',
        accent: successRate === null ? 'neutral' : successRate >= 98 ? 'success' : 'warn',
        note: `${m.failedEvents} logged failures`,
      },
      {
        label: 'High & Critical Flags',
        value: String(m.criticalEvents),
        icon: 'alert_triangle',
        accent: m.criticalEvents === 0 ? 'success' : 'warn',
        note: 'Requires managerial review',
      },
    ]
  }, [data])

  const categorySlices = useMemo<Slice[]>(() => {
    if (!data || data.eventsByCategory.length === 0) return []
    return data.eventsByCategory.map((c) => ({
      label: c.label,
      value: c.count,
      display: String(c.count),
      percent: `${c.percentage}%`,
    }))
  }, [data])

  const severitySlices = useMemo<Slice[]>(() => {
    if (!data || data.eventsBySeverity.length === 0) return []
    return data.eventsBySeverity.map((s) => ({
      label: s.label,
      value: s.count,
      display: String(s.count),
      percent: `${s.percentage}%`,
    }))
  }, [data])

  const exportCsv = (): ReportCsvRow[] => {
    if (!data) return []
    const rows: ReportCsvRow[] = [
      ['Report', 'Staff & System Activity Report'],
      ['Total Events', data.metrics.totalEvents],
      ['Successful Events', data.metrics.successfulEvents],
      ['Failed Events', data.metrics.failedEvents],
      ['Critical Events', data.metrics.criticalEvents],
      ['Active Operators', data.metrics.activeOperators],
      ['Most Active Module', data.metrics.mostActiveModule],
      ['Most Active Operator', data.metrics.mostActiveOperator],
      [],
      ['--- OPERATOR ACTIVITY SUMMARY ---'],
      ['Employee Code', 'Staff Name', 'Primary Role', 'Total Logged Actions', 'Last Active', 'Recent Action'],
      ...data.staffSummaries.map((s): ReportCsvRow => [
        s.employeeCode,
        s.name,
        s.role,
        s.totalActions,
        s.lastActive ?? 'Never',
        s.recentAction ?? 'None',
      ]),
      [],
      ['--- AUDIT EVENT LOG ---'],
      ['Timestamp', 'Operator', 'Role', 'Action', 'Category', 'Module', 'Severity', 'Status', 'Target Table', 'Record ID', 'IP Address'],
      ...data.recentEvents.map((e): ReportCsvRow => [
        e.timestamp,
        e.actorName,
        e.actorRole,
        e.action,
        e.category,
        e.module,
        e.severity,
        e.status,
        e.tableName ?? 'N/A',
        e.recordId ?? 'N/A',
        e.ipAddress ?? 'N/A',
      ]),
    ]
    return rows
  }

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
      <PageHeader
        icon="activity"
        title="Staff & System Activity"
        description="Audit event volume, operator breakdown, and immutable system event log."
      />

      <ReportToolbar
        title="Staff Activity"
        value={filters}
        onChange={setFilters}
        dateColumn="created_at"
        csv={{
          filename: `staff-activity-${activeTab}`,
          build: exportCsv,
        }}
      >
        <div
          role="group"
          aria-label="Staff activity views"
          className="report-view-toggle"
          style={{ display: 'inline-flex' }}
        >
          {([
            ['Activity Overview', 'overview'],
            ['Operator Breakdown', 'operators'],
            ['Audit Trail Stream', 'stream'],
          ] as const).map(([label, key]) => {
            const on = activeTab === key
            return (
              <button
                key={key}
                type="button"
                aria-pressed={on}
                onClick={() => setActiveTab(key)}
                className={`report-toggle-btn ${on ? 'is-active' : ''}`}
              >
                {label}
              </button>
            )
          })}
        </div>
      </ReportToolbar>

      <KpiStrip items={kpis} />

      <PageBody
        noun="activity"
        loading={load.loading}
        error={load.error}
        onRetry={load.reload}
        hasRows={data !== null}
        skeleton="kpi"
        empty={data !== null && data.metrics.totalEvents === 0}
        emptyIsFiltered={filtered}
        onClearFilters={() => setFilters({})}
        emptyTitle={filtered ? 'No activity in this period' : 'No activity recorded yet'}
        emptyMessage={
          filtered
            ? 'Nothing was recorded in the selected period. Clear the filters to see all activity.'
            : 'Audit events appear here as soon as anyone works in the app.'
        }
      >
      {activeTab === 'overview' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
          <div
            style={{
              display: 'grid',
              gridTemplateColumns: viewport === 'phone' ? '1fr' : '1fr 1fr',
              gap: 'var(--sp-md)',
            }}
          >
            {/* Domain Categories */}
            <div style={cardStyle}>
              <h3
                style={{
                  margin: '0 0 var(--sp-sm)',
                  fontSize: 'var(--t-ui)',
                  fontWeight: 700,
                  color: 'var(--text)',
                }}
              >
                Activity by System Domain
              </h3>
              <p
                style={{
                  margin: '0 0 var(--sp-md)',
                  fontSize: 'var(--t-meta)',
                  color: 'var(--text2)',
                }}
              >
                Volume distribution across operational workflows and modules.
              </p>
              {categorySlices.length > 0 ? (
                <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-lg)' }}>
                  <Donut
                    slices={categorySlices}
                    centreLabel="Total Events"
                    centreValue={String(data?.metrics.totalEvents ?? 0)}
                    size={140}
                  />
                  <Legend slices={categorySlices} showPercent />
                </div>
              ) : (
                <div style={{ color: 'var(--text2)', fontSize: 'var(--t-meta)', padding: 'var(--sp-md) 0' }}>
                  No activity events recorded in this period.
                </div>
              )}
            </div>

            {/* Severity Distribution */}
            <div style={cardStyle}>
              <h3
                style={{
                  margin: '0 0 var(--sp-sm)',
                  fontSize: 'var(--t-ui)',
                  fontWeight: 700,
                  color: 'var(--text)',
                }}
              >
                Security &amp; Severity Profile
              </h3>
              <p
                style={{
                  margin: '0 0 var(--sp-md)',
                  fontSize: 'var(--t-meta)',
                  color: 'var(--text2)',
                }}
              >
                Breakdown of audit occurrences by operational impact severity.
              </p>
              {severitySlices.length > 0 ? (
                <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-lg)' }}>
                  <Donut
                    slices={severitySlices}
                    centreLabel="Flags"
                    centreValue={String(data?.metrics.criticalEvents ?? 0)}
                    size={140}
                  />
                  <Legend slices={severitySlices} showPercent />
                </div>
              ) : (
                <div style={{ color: 'var(--text2)', fontSize: 'var(--t-meta)', padding: 'var(--sp-md) 0' }}>
                  No severity markers recorded.
                </div>
              )}
            </div>
          </div>

          {/* Top Contributing Operators */}
          <div style={cardStyle}>
