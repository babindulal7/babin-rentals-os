                </Select>
              </label>

              <div style={{ marginTop: 'var(--sp-md)' }}>
                <span style={fieldLabel}>Next Number</span>
                <div
                  className="identifier settings-mono"
                  aria-live="polite"
                  style={{
                    padding: '11px 12px',
                    borderRadius: 'var(--r-btn)',
                    border: '1px solid var(--border)',
                    background: 'var(--card2)',
                    fontSize: 'var(--t-h3)',
                    fontWeight: 700,
                    color: 'var(--text)',
                    letterSpacing: '0.06em',
                    textAlign: 'center',
