                <Button variant="primary" onClick={() => window.print()}>
                  <Icon name="download" size={15} /> Print Gate Pass ⎙
                </Button>
              </div>
            </Modal>
          )}
        </div>
      </PageBody>
    </PageShell>
  )
}

