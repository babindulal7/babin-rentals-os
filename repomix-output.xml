}))

vi.mock('../../../lib/queries/finance', () => {
  const INVOICE = {
    id: 'inv-1',
    invoiceNo: 'INV-901',
    bookingId: '11111111-1111-4111-8111-111111111111',
    bookingNo: 'B-715',
    clientId: 'c-1',
    clientName: 'Himalayan Films Pvt. Ltd.',
    status: 'Sent',
    issueDateAd: '2026-07-16',
    dueDateAd: '2026-07-31',
