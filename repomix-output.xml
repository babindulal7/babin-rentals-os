/* ============================================================================
   Babin Rentals OS — Auth Styles (Login, Forgot Password, Reset Password, ScreenLock)
   Adheres strictly to design system tokens, 44px touch targets, and dark/light modes.
   ========================================================================== */

.auth-wrapper {
  min-height: 100vh;
  min-height: 100dvh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 50% 15%, rgba(99, 102, 241, 0.06) 0%, transparent 65%);
  padding: 1.5rem 1.25rem;
}

.auth-card {
  width: 100%;
  max-width: 440px;
  padding: 2.5rem 2.25rem;
  display: flex;
  flex-direction: column;
  gap: 1.75rem;
  background: var(--card, #1e293b);
  border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
  border-radius: var(--r-card, 16px);
  box-shadow: 0 0 0 1px var(--border, rgba(255, 255, 255, 0.04)), 0 24px 48px -12px rgba(0, 0, 0, 0.36), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  position: relative;
  overflow: hidden;
}

.auth-header {
  text-align: center;
}

.auth-brand-mark {
  display: inline-grid;
  place-items: center;
  width: 3rem;
  height: 3rem;
  margin-bottom: 1.25rem;
  border-radius: var(--r-card, 12px);
  border: 1px solid rgba(234, 179, 8, 0.35);
  background: linear-gradient(135deg, rgba(234, 179, 8, 0.16) 0%, rgba(234, 179, 8, 0.04) 100%);
  color: #eab308;
  font-weight: 800;
  font-size: 1.35rem;
  font-family: var(--font-id, 'Source Sans 3', sans-serif);
  letter-spacing: -0.04em;
  line-height: 1;
  box-shadow: 0 0 20px rgba(234, 179, 8, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.2);
}

.auth-title {
  font-size: clamp(1.3rem, 2.2vw, 1.6rem);
  font-weight: 700;
  letter-spacing: -0.025em;
  margin: 0 0 0.5rem;
  color: var(--text, #f8fafc);
}

.auth-subtitle {
  margin: 0;
  color: var(--text2, #94a3b8);
  font-size: var(--t-meta, 0.8125rem);
  line-height: 1.5;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: var(--sp-lg, 1.25rem);
}

.auth-field {
  text-align: left;
}

.auth-label {
  display: block;
  font-size: var(--t-meta, 0.8125rem);
  font-weight: 600;
  color: var(--text2, #94a3b8);
  margin-bottom: 0.375rem;
}

.auth-password-wrapper {
  position: relative;
}

.auth-password-toggle {
  position: absolute;
  top: 0;
  right: 0;
  height: 44px;
  width: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
  color: var(--muted, #64748b);
  cursor: pointer;
  border-radius: var(--r-input, 8px);
  transition: color var(--dur-fast, 150ms) var(--ease, ease);
}

.auth-password-toggle:hover {
  color: var(--text, #f8fafc);
}

.auth-password-toggle:focus-visible {
  outline: 2px solid var(--input-focus, var(--primary));
  outline-offset: -2px;
}

.auth-capslock-hint {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  margin-top: 0.375rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--warn-text, var(--warning, #d97706));
}

.auth-remember-row {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  cursor: pointer;
  user-select: none;
  min-height: 44px;
}

.auth-remember-checkbox {
  width: 1.125rem;
  height: 1.125rem;
  border-radius: 4px;
  border: 1px solid var(--border, rgba(255, 255, 255, 0.2));
