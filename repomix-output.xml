          fontWeight: 600,
          color: on ? 'var(--text)' : 'var(--text2)',
          cursor: 'pointer',
        }}
      >
        <span>{label}</span>
        {on && (
          <Icon
            name={sort.dir === 'asc' ? 'arrow_up' : 'arrow_down'}
            size={12}
            style={{ color: 'var(--text2)' }}
          />
        )}
