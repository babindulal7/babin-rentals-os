<file path="src/modules/inventory/components/SectionRelationships.tsx">
import Icon from '../../../components/ui/Icon'
import { Button } from '../../../components/ui/Page'
import { Field, SectionCard, inputStyle, fieldRow, Chip } from './EquipmentShared'
import { useEquipmentContext } from './AddEquipmentContext'
import { CONTAINER_MODELS, ATTACHABLE_MODELS, modelName, CONTAINER_CAPACITY_REASON } from '../../../lib/queries/addEquipment'

export function SectionRelationships() {
  const {
    category,
    brand,
    storedIn,
    setStoredIn,
    contains,
    setContains,
    containPick,
    setContainPick,
    compatible,
    setCompatible,
    compatiblePick,
    setCompatiblePick,
    requires,
    setRequires,
    requiresPick,
    setRequiresPick,
    suggestions,
    usedInBundles,
    addContained,
    errors,
    sectionNumber,
  } = useEquipmentContext()

  return (
    <SectionCard
            id="sec-relationships"
            n={sectionNumber('sec-relationships')}
            title="Relationships"
            note="Three classes, three cardinalities — containment is one, membership is many, compatibility is many-to-many."
          >
            {errors.relationships && (
              <span style={{ display: 'flex', alignItems: 'center', gap: 5, fontSize: 'var(--t-th)', color: 'var(--danger-text)' }}>
                <Icon name="error" size={12} />
                {errors.relationships}
              </span>
            )}

            {/* §6.1 — containment, physical, one parent. */}
            <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
              <strong style={{ fontSize: 'var(--t-meta)', color: 'var(--text)' }}>Containment — one container at a time</strong>
              <div style={fieldRow}>
                <Field label="Stored In" hint="Moving the container moves everything inside it.">
                  <select
                    value={storedIn}
                    onChange={(e) => {
                      setStoredIn(e.target.value)
                    }}
                    style={inputStyle(Boolean(errors.relationships))}
                  >
                    <option value="">None — direct shelf</option>
                    {CONTAINER_MODELS.map((m) => (
                      <option key={m.id} value={m.id}>
                        {m.name} ({m.sku})
                      </option>
                    ))}
                  </select>
                </Field>
                <Field label="Contains" hint="Existing inventory is attached, never duplicated.">
                  <div style={{ display: 'flex', gap: 6 }}>
                    <select value={containPick} onChange={(e) => setContainPick(e.target.value)} style={inputStyle()}>
                      <option value="">Select an item to attach</option>
                      {ATTACHABLE_MODELS.map((m) => (
                        <option key={m.id} value={m.id}>
                          {m.name}
                        </option>
                      ))}
                    </select>
                    <Button
                      variant="secondary"
                      onClick={() => {
                        addContained(containPick)
                        setContainPick('')
                      }}
                    >
                      Attach
                    </Button>
                  </div>
                </Field>
              </div>

              {contains.length > 0 && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
                  {contains.map((c) => (
                    <div
                      key={c.id}
                      style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '6px 10px', borderRadius: 7, background: 'var(--card2)', border: '1px solid var(--border)' }}
                    >
                      <Icon name="package" size={14} style={{ color: 'var(--link)', flexShrink: 0 }} />
                      <span style={{ flex: 1, minWidth: 0, fontSize: 'var(--t-meta)', color: 'var(--text)' }}>{modelName(c.modelId)}</span>
                      <label style={{ display: 'flex', alignItems: 'center', gap: 5, fontSize: 'var(--t-th)', color: 'var(--text2)' }}>
                        Qty
                        <input
                          type="number"
                          min={1}
                          value={c.quantity}
                          onChange={(e) =>
                            setContains((prev) => prev.map((x) => (x.id === c.id ? { ...x, quantity: Math.max(1, Number(e.target.value)) } : x)))
                          }
                          className="figure"
                          /* Law 15 — the `height: 28` override defeated inputStyle's
                             `minHeight: 44` touch floor on the one control in this row
                             that takes typing. Width stays 62: the floor is 44 and a
                             quantity is at most a few digits. */
                          style={{ ...inputStyle(), width: 62 }}
                        />
                      </label>
                      <button
                        type="button"
                        onClick={() => setContains((prev) => prev.filter((x) => x.id !== c.id))}
                        aria-label={`Detach ${modelName(c.modelId)}`}
                        style={{ border: 'none', background: 'transparent', color: 'var(--muted)', cursor: 'pointer' }}
                      >
                        <Icon name="close" size={13} />
                      </button>
                    </div>
                  ))}
                  <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>
                    {/* Detaching removes only the relationship — the child stays an independent asset (§6.1). */}Detaching removes only the relationship — the child stays an independent asset. </span>
                </div>
              )}

              {/* §7 — auto-suggested children from what comparable units contain. */}
              {suggestions.length > 0 && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
                  <span style={{ fontSize: 'var(--t-th)', color: 'var(--text2)' }}>
                    Suggested from what other {category || brand} units contain — click to attach:
                  </span>
                  <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6 }}>
                    {suggestions.map((s) => (
                      <button
                        key={s.id}
                        type="button"
                        onClick={() => addContained(s.id)}
                        style={{
                          display: 'inline-flex',
                          alignItems: 'center',
                          gap: 5,
                          padding: '4px 9px',
                          borderRadius: 'var(--r-badge)',
                          border: '1px dashed var(--border2)',
                          background: 'transparent',
                          color: 'var(--link)',
                          fontSize: 'var(--t-meta)',
                          fontFamily: 'inherit',
                          fontWeight: 600,
                          cursor: 'pointer',
                        }}
                      >
                        <Icon name="plus" size={11} />
                        {s.name}
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <span style={{ display: 'flex', alignItems: 'flex-start', gap: 5, fontSize: 'var(--t-th)', color: 'var(--muted)', lineHeight: 1.45 }}>
                <Icon name="info" size={12} style={{ flexShrink: 0, marginTop: 2 }} />
                {CONTAINER_CAPACITY_REASON}
              </span>
            </div>

            {/* §6.2 — kit membership, read-only. */}
            <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-sm)', paddingTop: 'var(--sp-md)', borderTop: '1px solid var(--border)' }}>
              <strong style={{ fontSize: 'var(--t-meta)', color: 'var(--text)' }}>Kit membership — read-only here</strong>
              {usedInBundles.length > 0 ? (
                <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6 }}>
                  {usedInBundles.map((b) => (
                    <Chip key={b} icon="queues">
                      {b}
                    </Chip>
                  ))}
                </div>
              ) : (
                <span style={{ fontSize: 'var(--t-meta)', color: 'var(--muted)' }}>
                  Not used in any bundle. Bundles are built in Inventory ▸ Bundles; this panel only shows where the item is
                  already used, so a retirement’s blast radius is visible.
                </span>
              )}
            </div>

            {/* §6.3 — compatibility, informational, many-to-many. */}
            <div style={{ display: 'flex', flexDirection: 'column', gap: 10, paddingTop: 'var(--sp-md)', borderTop: '1px solid var(--border)' }}>
              <strong style={{ fontSize: 'var(--t-meta)', color: 'var(--text)' }}>Compatibility — never affects availability or price</strong>
              <div style={fieldRow}>
                <Field label="Compatible with">
                  <div style={{ display: 'flex', gap: 6 }}>
                    <select value={compatiblePick} onChange={(e) => setCompatiblePick(e.target.value)} style={inputStyle()}>
                      <option value="">Select an item</option>
                      {ATTACHABLE_MODELS.map((m) => (
                        <option key={m.id} value={m.id}>
                          {m.name}
                        </option>
                      ))}
                    </select>
                    <Button
                      variant="secondary"
                      onClick={() => {
                        if (compatiblePick && !compatible.includes(compatiblePick)) setCompatible((prev) => [...prev, compatiblePick])
                        setCompatiblePick('')
                      }}
                    >
                      Add
                    </Button>
                  </div>
                </Field>
                <Field label="Requires" hint="Powers the missing-accessory warning at packing.">
                  <div style={{ display: 'flex', gap: 6 }}>
                    <select value={requiresPick} onChange={(e) => setRequiresPick(e.target.value)} style={inputStyle()}>
                      <option value="">Select an item</option>
                      {ATTACHABLE_MODELS.map((m) => (
                        <option key={m.id} value={m.id}>
                          {m.name}
                        </option>
                      ))}
                    </select>
                    <Button
                      variant="secondary"
                      onClick={() => {
                        if (requiresPick && !requires.includes(requiresPick)) setRequires((prev) => [...prev, requiresPick])
                        setRequiresPick('')
                      }}
                    >
                      Add
                    </Button>
                  </div>
                </Field>
              </div>

              {(compatible.length > 0 || requires.length > 0) && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-sm)' }}>
                  {compatible.length > 0 && (
                    <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6, alignItems: 'center' }}>
                      <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)', width: 74 }}>Compatible</span>
                      {compatible.map((id) => (
                        <Chip key={id} icon="external_link" onRemove={() => setCompatible((prev) => prev.filter((x) => x !== id))}>
                          {modelName(id)}
                        </Chip>
                      ))}
                    </div>
                  )}
                  {requires.length > 0 && (
                    <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6, alignItems: 'center' }}>
                      <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)', width: 74 }}>Requires</span>
                      {requires.map((id) => (
                        <Chip key={id} icon="plug" onRemove={() => setRequires((prev) => prev.filter((x) => x !== id))}>
                          {modelName(id)}
                        </Chip>
                      ))}
                    </div>
                  )}
                </div>
              )}
            </div>
          </SectionCard>
  )
}
</file>

<file path="src/modules/inventory/modals/CreatePurchaseRequestModal.tsx">
import { useState } from 'react'
import { Modal } from '../../../components/ui/Modal'
import { Button } from '../../../components/ui/Page'
import { rupees, formatMoney } from '../../../lib/money'
import type { Paisa } from '../../../lib/money'
import { getBusinessToday, toBs, formatBs } from '../../../lib/bs'
import { DomainEvents, EVENT_TYPES } from '../../../events/eventBus'
import { useAuth } from '../../../lib/auth'
import type { PRPriority, PurchaseRequest } from '../../../lib/queries/purchaseRequests'

export interface CreatePurchaseRequestModalProps {
  isOpen: boolean
  onClose: () => void
  onSuccess: (pr: PurchaseRequest) => void
}

export function CreatePurchaseRequestModal({
  isOpen,
  onClose,
  onSuccess,
}: CreatePurchaseRequestModalProps) {
  const { user } = useAuth()
  const [equipmentTitle, setEquipmentTitle] = useState('')
  const [category, setCategory] = useState('Camera Body')
  const [quantity, setQuantity] = useState<number>(1)
  const [unitCostRupees, setUnitCostRupees] = useState<number>(0)
  const [priority, setPriority] = useState<PRPriority>('Medium')
  const [turnaways, setTurnaways] = useState<number>(0)
  const [justification, setJustification] = useState('')
  const [submitting, setSubmitting] = useState(false)
  const [error, setError] = useState<string | null>(null)

  const totalCostRs = quantity * unitCostRupees

  const handleSubmit = async (e?: React.FormEvent) => {
    if (e) e.preventDefault()
    if (!equipmentTitle.trim()) {
      setError('Please provide an equipment model or title.')
      return
    }
    if (justification.trim().length < 5) {
      setError('Please document the business justification / utilization need for this purchase.')
      return
    }

    setSubmitting(true)
    setError(null)

    try {
      const prNo = `PR-2026-${Math.floor(1000 + Math.random() * 9000)}`
      const payload: PurchaseRequest = {
        id: prNo,
        prNo,
        fleetItemId: `EQ-${Math.floor(100 + Math.random() * 900)}`,
        fleetItemName: equipmentTitle.trim(),
        category,
        requestedQty: Math.max(1, quantity),
        reason: 'Demand exceeded',
        estimatedUnitCost: rupees(unitCostRupees),
        totalEstimatedCost: rupees(totalCostRs),
        totalSubRentPaid: 0 as Paisa,
        refusedCount: turnaways,
        subRentCount: 0,
        priorityScore: priority === 'High' ? 85 : priority === 'Medium' ? 60 : 40,
        priority,
        status: 'Draft',
        requestedBy: user?.name ?? 'Warehouse Lead',
        dateCreatedAD: getBusinessToday().toISOString().slice(0, 10),
        dateCreatedBS: (() => {
          const bs = toBs(getBusinessToday())
          return bs ? formatBs(bs) : ''
        })(),
        notes: justification.trim(),
        refusedBookings: [],
        subRentals: [],
      }

      await DomainEvents.emit(EVENT_TYPES.PURCHASE_REQUEST_UPDATED, payload)
      onSuccess(payload)
      onClose()
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Failed to create purchase request')
    } finally {
      setSubmitting(false)
    }
  }

  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      title="Create Equipment Purchase Request"
      subtitle="Draft a capital expenditure request backed by rental turnaways and sub-rental evidence."
      size="md"
      footer={
        <>
          <Button variant="secondary" onClick={onClose} disabled={submitting}>
            Cancel
          </Button>
          <Button variant="primary" onClick={() => handleSubmit()} disabled={submitting}>
            {submitting ? 'Submitting PR…' : 'Submit Purchase Request'}
          </Button>
        </>
      }
    >
      <form onSubmit={handleSubmit} style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
        {error && (
          <div
            style={{
              padding: '10px 14px',
              borderRadius: 'var(--r-btn)',
              background: 'var(--st-danger-bg)',
              color: 'var(--st-danger-fg)',
              fontSize: 'var(--t-meta)',
              fontWeight: 600,
            }}
          >
            {error}
          </div>
        )}

        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 'var(--sp-md)' }}>
          <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
            <label style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
              Equipment Name / Model <span style={{ color: 'var(--danger)' }}>*</span>
            </label>
            <input
              type="text"
              placeholder="e.g. Sony FE 70-200mm f/2.8 GM OSS II"
              value={equipmentTitle}
              onChange={(e) => setEquipmentTitle(e.target.value)}
              style={{
                height: 36,
                padding: '0 12px',
                borderRadius: 'var(--r-btn)',
                border: '1px solid var(--border)',
                background: 'var(--card)',
                color: 'var(--text)',
                fontSize: 'var(--t-meta)',
              }}
            />
          </div>

          <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
            <label style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
              Category
            </label>
            <select
              value={category}
              onChange={(e) => setCategory(e.target.value)}
              style={{
                height: 36,
                padding: '0 12px',
                borderRadius: 'var(--r-btn)',
                border: '1px solid var(--border)',
                background: 'var(--card)',
                color: 'var(--text)',
                fontSize: 'var(--t-meta)',
              }}
            >
              <option value="Camera Body">Camera Body</option>
              <option value="Cinema Lens">Cinema Lens</option>
              <option value="Lighting">Lighting / Grip</option>
              <option value="Audio">Audio / Wireless</option>
              <option value="Stabilization">Gimbal / Stabilization</option>
              <option value="Power">Power / Battery Batch</option>
            </select>
          </div>
        </div>

        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr 1fr', gap: 'var(--sp-md)' }}>
          <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
            <label style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
              Quantity <span style={{ color: 'var(--danger)' }}>*</span>
            </label>
            <input
              type="number"
              min={1}
              value={quantity}
              onChange={(e) => setQuantity(Math.max(1, Number(e.target.value) || 1))}
              style={{
                height: 36,
                padding: '0 12px',
                borderRadius: 'var(--r-btn)',
                border: '1px solid var(--border)',
                background: 'var(--card)',
                color: 'var(--text)',
                fontSize: 'var(--t-meta)',
              }}
            />
          </div>

          <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
            <label style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
              Unit Est. Cost (Rs)
            </label>
            <input
              type="number"
              min={0}
              value={unitCostRupees === 0 ? '' : unitCostRupees}
              placeholder="0"
              onChange={(e) => setUnitCostRupees(Math.max(0, Number(e.target.value) || 0))}
              style={{
                height: 36,
                padding: '0 12px',
                borderRadius: 'var(--r-btn)',
                border: '1px solid var(--border)',
                background: 'var(--card)',
                color: 'var(--text)',
                fontSize: 'var(--t-meta)',
              }}
            />
          </div>

          <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
            <label style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
              Priority
            </label>
            <select
              value={priority}
              onChange={(e) => setPriority(e.target.value as PRPriority)}
              style={{
                height: 36,
                padding: '0 12px',
                borderRadius: 'var(--r-btn)',
                border: '1px solid var(--border)',
                background: 'var(--card)',
                color: 'var(--text)',
                fontSize: 'var(--t-meta)',
              }}
            >
              <option value="Low">Low — Fleet expansion</option>
              <option value="Medium">Medium — High demand</option>
              <option value="High">High — Frequent turnaways</option>
            </select>
          </div>
        </div>

        <div style={{ padding: '8px 12px', borderRadius: 'var(--r-btn)', background: 'var(--card2)', border: '1px solid var(--border)', fontSize: 'var(--t-meta)' }}>
          <strong>Total Estimated Outlay:</strong> {formatMoney(rupees(totalCostRs))}
        </div>

        <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
          <label style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
            Turnaway Count in Last 30 Days
          </label>
          <input
            type="number"
            min={0}
            value={turnaways === 0 ? '' : turnaways}
            placeholder="0"
            onChange={(e) => setTurnaways(Math.max(0, Number(e.target.value) || 0))}
            style={{
              height: 36,
              padding: '0 12px',
              borderRadius: 'var(--r-btn)',
              border: '1px solid var(--border)',
              background: 'var(--card)',
              color: 'var(--text)',
              fontSize: 'var(--t-meta)',
            }}
          />
        </div>

        <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
          <label style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
            Business Justification &amp; ROI Case <span style={{ color: 'var(--danger)' }}>*</span>
          </label>
          <textarea
            rows={3}
            placeholder="Explain why acquiring this asset delivers immediate return (e.g. Eliminates external vendor rental cost and satisfies peak wedding season demand)…"
