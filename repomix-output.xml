<file path="src/lib/fieldGating.ts">
/**
 * Field-level gating — Hover Intel System v2.1 §4.
 *
 * `lib/rbac.ts` answers action-level questions ("can this role record a
 * payment"). This file answers a narrower, card-specific question: for one
 * field inside a Glance/Detail card, given a role and where the card is
 * rendered, should the caller construct that field at all?
 *
 * Every function here is a pure predicate. Nothing renders and nothing knows
 * about `IntelCard` — the caller (a card builder such as `clientIntel.ts`)
 * calls these while building an `IntelGroup[]`, and a field the predicate
 * refuses is simply never pushed onto the array. That is what HIS v2.1 §4.5
 * means by "gated blocks are omitted from the payload, not CSS-hidden": the
 * omission has to happen here, before the component ever sees the field —
 * there is no later CSS or conditional-render step that would make hiding it
 * acceptable.
 */

import type { SystemRole } from '../types/database'
import { canViewMoney } from './rbac'

/**
 * §4.3: "Context gate stacks and the stricter wins: on Floor surfaces
 * (Pack/Handover/Return/Reset/Scanner) all ₨ is stripped even for capable
 * roles." `'default'` is every other surface — the directories, detail
 * pages, and dashboards this system was designed for first.
 */
export type Surface = 'default' | 'floor'

export interface GateContext {
  role: SystemRole
  surface?: Surface
  /**
   * §4.2: Driver PII renders "only inside a delivery context — that
   * booking's delivery address + phone — nowhere else." True only when this
   * card is scoped to the one delivery/booking the Driver is assigned to.
   */
  deliveryLinked?: boolean
}

function ctx(role: SystemRole, opts?: Omit<GateContext, 'role'>): GateContext {
  return { role, surface: 'default', ...opts }
}
export { ctx as gateContext }

/**
 * §4.1: "Owner/Admin/Manager/Accounts = all ₨. Coordinator = booking-level
 * money + client balance/deposit only (no asset ROI, no crew pay, no
 * supplier margin). Warehouse/Technician/Driver = no ₨ anywhere."
 */
export type MoneyScope = 'full' | 'booking-and-client-balance' | 'none'

const MONEY_FULL: ReadonlySet<SystemRole> = new Set(['Owner', 'Admin', 'Manager', 'Accounts'])

export function moneyScope(c: GateContext): MoneyScope {
  // Context gate stacks, stricter wins — a Floor surface strips money even
  // for a role that would otherwise see all of it.
  if (c.surface === 'floor') return 'none'
  if (MONEY_FULL.has(c.role)) return 'full'
  if (c.role === 'Coordinator') return 'booking-and-client-balance'
  return 'none'
}

/** The four money field categories §4.1 actually distinguishes. */
export type MoneyField = 'booking' | 'client-balance' | 'asset-finance'

export function canViewMoneyField(c: GateContext, field: MoneyField): boolean {
  const scope = moneyScope(c)
  if (scope === 'full') return true
  if (scope === 'none') return false
  return field === 'booking' || field === 'client-balance'
}

/**
 * §4.1: "...and no utilization%" for the three money-blind floor roles.
 * The Equipment card's Utilization group states this again as "visible to
 * Manager+; hidden from floor" — the same rule stated twice, so it is not
 * re-derived from a separate list here.
 */
export function canViewUtilization(c: GateContext): boolean {
  if (c.surface === 'floor') return false
  return canViewMoney(c.role)
}

/**
 * §4.2: "phone/email/address render for Coordinator/Admin/Owner/Accounts
 * always; for Driver only inside a delivery context...; never for
 * Warehouse/Technician."
 */
const PII_ALWAYS: ReadonlySet<SystemRole> = new Set(['Owner', 'Admin', 'Manager', 'Coordinator', 'Accounts'])

export function canViewPII(c: GateContext): boolean {
  if (PII_ALWAYS.has(c.role)) return true
  if (c.role === 'Driver') return c.deliveryLinked === true
  return false
}

/**
 * Client card, Documents group: "Gated to Coordinator+." No rank order is
 * defined anywhere in the spec, so this reuses the same office-staff set PII
 * already draws the line at — the roles who can see a client's phone number
 * are the roles who can see their uploaded ID, not a separately-invented
 * tier.
 */
export const canViewDocuments = canViewPII

/**
 * Client card, Notes group: "Staff only, never Client role." The Client
 * (portal) role cannot reach this screen at all today — `rbac.ts`'s
 * `isStaff()` / the routing guard is what actually enforces that — but a
 * card builder that runs regardless of role should still ask before
 * constructing an internal note.
 */
export function canViewNotes(c: GateContext): boolean {
  return c.role !== 'Client'
}

/**
 * Client card, Credit control: "Gated; the *block* itself is visible to
 * everyone who tries to book." The on-stop status (is this client blocked,
 * yes/no) is therefore never gated by this function — a caller includes it
 * unconditionally. Only the reason and who-set-it are staff information.
 */
export const canViewOnStopReason = canViewPII
</file>

<file path="src/lib/floorPresence.ts">
import { useState, useEffect, useRef, useCallback } from 'react'

/**
 * # Multi-Terminal Floor Presence Engine (Pillar 4)
 *
 * Prevents race conditions and serial scan contention across warehouse floor tablets.
 * Uses `BroadcastChannel('br-floor-presence')` with localStorage fallback to coordinate
 * real-time terminal heartbeats and scan alerts across local tabs/devices.
 */

export interface FloorPeer {
  readonly terminalId: string
  readonly bookingNo: string
  readonly staffName: string
  readonly role: string
  readonly lastSeen: number
}

export type FloorPresenceMessage =
  | { readonly type: 'HEARTBEAT'; readonly peer: FloorPeer }
  | { readonly type: 'RELEASE'; readonly terminalId: string; readonly bookingNo: string }
  | { readonly type: 'SCAN'; readonly terminalId: string; readonly bookingNo: string; readonly assetTag: string; readonly staffName: string }

const CHANNEL_NAME = 'br-floor-presence'
const HEARTBEAT_INTERVAL_MS = 6000
const PEER_TIMEOUT_MS = 18000

let cachedTerminalId: string | null = null

export function getTerminalId(): string {
  if (cachedTerminalId) return cachedTerminalId
  try {
    if (typeof window !== 'undefined' && window.sessionStorage) {
      const stored = window.sessionStorage.getItem('br-terminal-id')
      if (stored) {
        cachedTerminalId = stored
        return stored
      }
      const newId = `T-${Math.random().toString(36).substring(2, 6).toUpperCase()}`
      window.sessionStorage.setItem('br-terminal-id', newId)
      cachedTerminalId = newId
      return newId
    }
  } catch {
    // SessionStorage restricted
  }
  cachedTerminalId = `T-${Math.random().toString(36).substring(2, 6).toUpperCase()}`
  return cachedTerminalId
}

export interface UseFloorPresenceResult {
  readonly terminalId: string
  readonly activePeers: readonly FloorPeer[]
  readonly presenceBanner: string | null
  readonly lastRemoteScan: { assetTag: string; staffName: string } | null
  readonly broadcastScan: (assetTag: string) => void
}

/**
 * Hook for floor workspaces to broadcast presence and detect concurrent terminal activity.
 */
export function useFloorPresence(
  bookingNo: string | undefined | null,
  staffName: string,
  role = 'Warehouse staff',
): UseFloorPresenceResult {
  const terminalId = useRef(getTerminalId()).current
  const [peers, setPeers] = useState<Record<string, FloorPeer>>({})
  const [lastRemoteScan, setLastRemoteScan] = useState<{ assetTag: string; staffName: string } | null>(null)
  const channelRef = useRef<BroadcastChannel | null>(null)

  // Broadcast helper
  const postMsg = useCallback((msg: FloorPresenceMessage) => {
    try {
      if (channelRef.current) {
        channelRef.current.postMessage(msg)
      } else if (typeof window !== 'undefined' && window.localStorage) {
        // Fallback for environments without BroadcastChannel
        window.localStorage.setItem('br-presence-event', JSON.stringify({ msg, rand: Math.random() }))
      }
    } catch {
      // Storage/broadcast restricted
    }
  }, [])

  const broadcastScan = useCallback((assetTag: string) => {
    if (!bookingNo) return
    postMsg({
      type: 'SCAN',
      terminalId,
      bookingNo,
      assetTag,
      staffName,
    })
  }, [bookingNo, postMsg, staffName, terminalId])

  useEffect(() => {
    if (!bookingNo) return

    // Setup channel
    if (typeof window !== 'undefined' && 'BroadcastChannel' in window) {
      try {
        channelRef.current = new BroadcastChannel(CHANNEL_NAME)
      } catch {
        channelRef.current = null
      }
    }

    const handleMessage = (msg: FloorPresenceMessage) => {
      const msgTerminalId = msg.type === 'HEARTBEAT' ? msg.peer.terminalId : msg.terminalId
      const msgBookingNo = msg.type === 'HEARTBEAT' ? msg.peer.bookingNo : msg.bookingNo

      if (msgTerminalId === terminalId) return
      if (msgBookingNo !== bookingNo) return

      if (msg.type === 'HEARTBEAT') {
        setPeers((prev) => ({
          ...prev,
          [msg.peer.terminalId]: msg.peer,
        }))
      } else if (msg.type === 'RELEASE') {
        setPeers((prev) => {
          const next = { ...prev }
          delete next[msg.terminalId]
          return next
        })
      } else if (msg.type === 'SCAN') {
        setLastRemoteScan({ assetTag: msg.assetTag, staffName: msg.staffName })
      }
    }

    // BroadcastChannel listener
    if (channelRef.current) {
      channelRef.current.onmessage = (event: MessageEvent<FloorPresenceMessage>) => {
        handleMessage(event.data)
      }
    }

    // Storage fallback listener
    const handleStorage = (event: StorageEvent) => {
      if (event.key === 'br-presence-event' && event.newValue) {
        try {
          const parsed = JSON.parse(event.newValue) as { msg: FloorPresenceMessage }
          if (parsed && parsed.msg) handleMessage(parsed.msg)
        } catch {
          // Ignore parse errors
        }
      }
    }
    window.addEventListener('storage', handleStorage)

    // Initial heartbeat
    const sendHeartbeat = () => {
      postMsg({
        type: 'HEARTBEAT',
        peer: {
          terminalId,
          bookingNo,
          staffName,
          role,
          lastSeen: Date.now(),
        },
      })
    }
    sendHeartbeat()

    const interval = setInterval(() => {
      sendHeartbeat()
      // Prune timed-out peers
      const now = Date.now()
      setPeers((prev) => {
        let changed = false
        const next: Record<string, FloorPeer> = {}
        for (const [id, peer] of Object.entries(prev)) {
          if (now - peer.lastSeen <= PEER_TIMEOUT_MS) {
            next[id] = peer
          } else {
            changed = true
          }
        }
        return changed ? next : prev
      })
    }, HEARTBEAT_INTERVAL_MS)

    return () => {
      clearInterval(interval)
      window.removeEventListener('storage', handleStorage)
      postMsg({ type: 'RELEASE', terminalId, bookingNo })
      if (channelRef.current) {
        channelRef.current.close()
        channelRef.current = null
      }
    }
  }, [bookingNo, postMsg, role, staffName, terminalId])

  const activePeers = Object.values(peers)
  const otherTechnician =
    activePeers.length > 0
      ? `${activePeers.map((p) => `${p.staffName} (${p.terminalId})`).join(', ')} also active on this booking`
      : null

  return {
    terminalId,
    activePeers,
    presenceBanner: otherTechnician,
    lastRemoteScan,
    broadcastScan,
  }
}
</file>

<file path="src/lib/format.ts">
/** `450` (minutes since midnight) → `"7:30 AM"`. */
export function clock(minOfDay: number): string {
  let h = Math.floor(minOfDay / 60) % 24
  const m = minOfDay % 60
  const ap = h >= 12 ? 'PM' : 'AM'
  h = h % 12 || 12
  return `${h}:${String(m).padStart(2, '0')} ${ap}`
}

/**
 * `540` → `"09:00 AM"`. Two-digit hour, so a column of times aligns without a
 * monospace hack. Dashboard.md §6 renders pickup times this way.
 */
export function clockPad(minOfDay: number): string {
  let h = Math.floor(minOfDay / 60) % 24
  const m = minOfDay % 60
  const ap = h >= 12 ? 'PM' : 'AM'
  h = h % 12 || 12
  return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')} ${ap}`
}

/**
 * South Asian (lakh) digit grouping — `185000` → `"1,85,000"`. Foundation §02
 * and Dashboard.md §18 both require it; `toLocaleString('en-IN')` is not used
 * because it is locale-data dependent and would silently regroup under a
 * different ICU build.
 *
 * The last three digits stay together, everything above them groups in twos.
 */
export function grouped(n: number): string {
  const neg = n < 0
  const s = String(Math.round(Math.abs(n)))
  if (s.length <= 3) return (neg ? '-' : '') + s
  const tail = s.slice(-3)
  const head = s.slice(0, -3).replace(/\B(?=(\d{2})+(?!\d))/g, ',')
  return `${neg ? '-' : ''}${head},${tail}`
}

/** `185000` → `"Rs 1,85,000"`. */
export function rs(n: number): string {
  return `Rs ${grouped(n)}`
}

/**
 * Renders a compact BS/AD date pair — BS leads at field size with its day and
 * month, AD sits one step smaller. Digits are Latin always (§3.4), and the
 * month spelling is the locked romanization (§3.3), never Devanagari — that
 * applies even under Nepal Mode with English UI, which is the default (§3.1).
 *
 * This takes pre-resolved BS components rather than converting AD→BS itself.
 * The real AD↔BS conversion is Date Engine territory (Phase 3, not built yet);
 * for now callers supply the already-known BS day/month/year, matched to the
 * capsule's reference dates.
 */
export function bsAdPair(bsDay: number, bsMonth: string, _bsYear: number, adLabel: string): { bs: string; ad: string } {
  return { bs: `${bsDay} ${bsMonth}`, ad: adLabel }
}

/**
 * Renders a stored `bookings.delivery_type` for an operator to read.
 *
 * **Law 17 / PLAN.md §6.1 — the word "customer" appears nowhere in the UI.**
 * The Postgres enum spells one member `'Customer Pickup'` (`0001_enums.sql:34`)
 * and that is correct: Law 17 governs what the operator reads, not what
 * Postgres stores. The write path already maps label → enum
 * (`deliveryTypeFromLabel`, `actions/rentals/createRental.ts:100`); this is the
 * inverse that was never written, so the raw enum reached the DOM at six render
 * sites. Every one of the 246 live bookings carries `'Customer Pickup'`, so the
 * banned word rendered on every booking, not on an edge case.
 *
 * This is **not** a rename and it moves no stored data — the coordinated
 * schema-wide rename is still `AUDIT_FINDINGS.md` P3, unstarted. Do not use it
 * for comparisons: logic that tests the stored value (e.g.
 * `driverSignatureRequired` in `HandoverWorkspace.tsx`) must keep comparing the
 * enum, never this label.
 */
export function deliveryTypeLabel(value: string | null | undefined, fallback = '—'): string {
  if (value == null || value === '') return fallback
  return value === 'Customer Pickup' ? 'Client Pickup' : value
}

/* ── booking numbers ──────────────────────────────────────────────────────────
 *
 * R-10 (RULINGS-2026-09-04.md): a booking number is a BARE INTEGER in the
 * database — `700`, `946`, `90000` — and the `#` is rendered at display only.
 *
 * The `#` is never stored because it is a URL fragment delimiter: `/rentals/#920`
 * never reaches the server, and the same breaks any link pasted into WhatsApp.
 * Storing bare also lets the column sort numerically, which is why 0085 adds an
 * expression index on `(booking_no)::bigint` — on text, '1000' sorts before '946'.
 *
 * One helper each way, deliberately. SPEC-P0-3 §4: "Do not scatter `'#' + x`
 * through the screens; the audit already found three phone normalisers with
 * different rules and that is the same failure waiting to happen."
 */

/** Display form of a stored booking number. `'946'` → `'#946'`. */
export function formatBookingNo(bookingNo: string | null | undefined, fallback = '—'): string {
  const n = (bookingNo ?? '').trim()
  if (n === '') return fallback
  return n.startsWith('#') ? n : `#${n}`
}

/**
 * Search form → stored form. Staff will type the old `B-946` for months, and so
 * will clients holding paperwork issued before 4 Sep; `#946` is what the screens
 * now show. All three must find the same rental (SPEC-P0-3 §7).
 *
 * Only a prefix followed by digits is stripped, so a project search for
 * something like "B-roll" is left exactly as typed — the same term also runs
 * against `project`, and rewriting it there would silently change what the
 * operator asked for.
 */
export function parseBookingNoSearch(term: string): string {
  const t = term.trim()
  const m = /^(?:#|[Bb]-)(\d+)$/.exec(t)
  return m ? m[1]! : t
}
</file>

<file path="src/lib/gates.ts">
/**
 * # Gate Registry & Error Parser — Foundation Specification & Stage 2
 *
 * All gate checks enforced by PostgreSQL in Stage 1 raise exceptions formatted as:
 *   raise exception 'GATE:<gate.id>|<human message>' using errcode = 'P0001';
 *
 * Law 1: Pages never implement business logic.
 * Law 12: Errors inline and persistent. Toasts carry successes only.
 * Law 17: The word "customer" appears nowhere in the UI. They are clients.
 *
 * This module parses gate error messages and maps them to clear, bilingual (EN / NE)
 * explanations and actionable resolutions.
 */

import type { Language } from './i18n'

export type GateCategory =
  | 'pack'
  | 'handover'
  | 'return'
  | 'cancel'
  | 'reopen'
  | 'close'
  | 'invoice'
  | 'payment'
  | 'unit_status'
  | 'users'
  | 'price'
  | 'conflict'
  | 'case'
  | 'maintenance'
  | 'purchase'
  | 'expense'
  | 'client'
  | 'admin'

export interface GateDefinition {
  id: string
  category: GateCategory
  title: { en: string; ne: string }
  message: { en: string; ne: string }
  howToResolve: { en: string; ne: string }
