 */
const td = { height: 'var(--row-min-h)', padding: '10px', fontSize: 'var(--t-meta)', color: 'var(--text)', verticalAlign: 'top' as const }

/* Law 15 — hit area over paint, number from `--tap`. One consumer: the range
