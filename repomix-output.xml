/* RULING 2026-10-08: a full-width setup area, then an equipment workspace
   beside review. Direct section links keep this a continuous form. */
.new-rental-shell {
  --new-rental-line: var(--border);
  --new-rental-scroll-clearance: 78px;
  gap: 18px;
  max-width: 1480px;
}
/* Only the original app header presents actions; no second title/action row. */
.new-rental-header-actions { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
.new-rental-header-primary { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 44px; white-space: nowrap; }
@media (max-width: 1279px) {
  .new-rental-header-primary { width: 44px; min-width: 44px; padding-inline: 0 !important; }
  .new-rental-header-primary .ui-button__label > span { display: none; }
}

.new-rental-jumpbar {
  position: sticky;
  top: 0;
  z-index: 12;
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 6px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface);
  box-shadow: var(--shadow-sm);
}
.new-rental-jumpbar button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  gap: 8px;
  min-height: 44px;
  padding: 0 14px;
  border: 0;
  border-radius: var(--r-btn);
  background: transparent;
  color: var(--text2);
  font: inherit;
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  cursor: pointer;
}
.new-rental-jumpbar button.is-active,
.new-rental-jumpbar button[data-active='true'] {
  color: var(--st-primary-fg, #2563eb) !important;
  font-weight: 600 !important;
  border-bottom: 2px solid var(--st-primary-fg, #2563eb) !important;
  border-radius: 4px 4px 0 0 !important;
  background: var(--card2) !important;
}
.new-rental-jumpbar__pill {
  font-size: 11px;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 999px;
  line-height: 1.2;
}
.new-rental-jumpbar__pill--warning {
  background: var(--st-warning-bg, #fef3c7);
  color: var(--st-warning-fg, #b45309);
  border: 1px solid var(--st-warning-border, #fcd34d);
}
