export function getProductions(): Production[] {
  if (!IS_MOCK) throw new Error('Production tracking is unavailable. Existing local entries have been preserved.')
  try {
    const raw = localStorage.getItem(STORAGE_KEY)
    if (raw) {
      const parsed = JSON.parse(raw) as Production[]
      if (Array.isArray(parsed) && parsed.length > 0) return parsed
    }
  } catch {
    /* fallback to seed */
  }
  return [...SEED_PRODUCTIONS]
}

export function saveProductions(items: Production[]): void {
  if (!IS_MOCK) throw new Error('Production tracking is unavailable. Existing local entries have been preserved.')
  localStorage.setItem(STORAGE_KEY, JSON.stringify(items))
}

export function createProduction(item: Omit<Production, 'id'>): Production {
  const all = getProductions()
  const nextNum = 100 + all.length + 1
  const newProd: Production = {
    ...item,
    id: `PRD-${nextNum}`,
  }
  all.unshift(newProd)
  saveProductions(all)
  return newProd
}

export function updateProductionPhase(id: string, phase: ProductionPhase): Production[] {
  const all = getProductions()
  const idx = all.findIndex((p) => p.id === id)
  if (idx !== -1) {
    const existing = all[idx]
    if (existing) {
      all[idx] = { ...existing, phase }
      saveProductions(all)
    }
  }
  return all
}

export interface ProductionStats {
  totalCount: number
  inShootCount: number
  preProdCount: number
  returnWrapCount: number
  totalBudget: number
  totalGearOut: number
}

export function getProductionStats(items: Production[]): ProductionStats {
  let inShootCount = 0
  let preProdCount = 0
  let returnWrapCount = 0
  let totalBudget = 0
  let totalGearOut = 0

  for (const p of items) {
    totalBudget += p.budgetNpr
    if (p.phase === 'Shoot') {
      inShootCount++
      totalGearOut += p.gearCount
    } else if (p.phase === 'Pre-Production') {
      preProdCount++
    } else {
      returnWrapCount++
    }
  }

  return {
    totalCount: items.length,
    inShootCount,
    preProdCount,
    returnWrapCount,
    totalBudget,
    totalGearOut,
  }
}
</file>

<file path="src/lib/queries/productReports.ts">
import { supabase } from '../supabase'
import type { Paisa } from '../money'
import { lineValue, readLineValues, rowsOf, type ReportFilterOptions } from './reportSupport'

/**
 * Product Reports — catalogue, demand and stock, from the catalogue itself.
 *
 * RULING 2026-10-16 (R-P6-STATES, Law 16): this read counted `products_v`
 * (falling back to the seed list's length when the count was 0) and the page
 * rendered `data/productReports` — invented sales trends, profit trends,
 * turnover, returns, suppliers and products — on every path. It now returns:
 *
 *   - catalogue counts                     — `products` (active / total)
 *   - demand in the period                 — priced lines (`booking_lines_v`) on
 *                                            non-cancelled bookings picked up in it
 *   - revenue by category, top products    — the same lines, money-visible roles
 *                                            only (the view nulls rates otherwise)
 *   - products with no booking in period   — active products none of those lines name
 *   - at or below reorder level            — `total_quantity` ≤ `reorder_level`
 *
 * Profit, turnover, returns and supplier ranking have no source and are not
 * returned. Throws on failure; an empty catalogue is empty.
 * Revert = restore the seed re-exports and the `catch`.
 */

export interface ProductReportRow {
  productId: string
  name: string
  category: string
  bookings: number
  quantityBooked: number
  revenue: Paisa
}

export interface CategoryRevenue {
  category: string
  revenue: Paisa
  bookings: number
}

export interface LowStockRow {
  productId: string
  name: string
  onHand: number
  reorderLevel: number
}

export interface ProductReportsSummary {
  productCount: number
  activeProducts: number
  productsBooked: number
  revenue: Paisa
  byCategory: CategoryRevenue[]
  topRevenue: ProductReportRow[]
  /** Active products no booking in the period named. */
  notBooked: { productId: string; name: string; category: string }[]
  lowStock: LowStockRow[]
}

type ProductRow = {
  id: string
  name: string | null
  category_id: string | null
  is_active: boolean | null
  total_quantity: number | null
  reorder_level: number | null
}

export async function getProductReportsSummary(options?: ReportFilterOptions): Promise<ProductReportsSummary> {
  let bookingsQ = supabase.from('bookings').select('id').is('cancelled_at', null)
  if (options?.from) bookingsQ = bookingsQ.gte('pickup_at', options.from)
  if (options?.to) bookingsQ = bookingsQ.lte('pickup_at', options.to)
  if (options?.branchId) bookingsQ = bookingsQ.eq('branch_id', options.branchId)

  const [productsRes, categoriesRes, bookingsRes, lineMap] = await Promise.all([
    supabase.from('products').select('id, name, category_id, is_active, total_quantity, reorder_level'),
    supabase.from('inventory_categories').select('id, name'),
    bookingsQ,
    readLineValues(),
  ])
  const products = rowsOf<ProductRow>(productsRes, 'Products read failed')
  const categories = rowsOf<{ id: string; name: string | null }>(categoriesRes, 'Categories read failed')
  const bookings = rowsOf<{ id: string }>(bookingsRes, 'Bookings read failed')

  const categoryName = new Map(categories.map((c) => [c.id, c.name?.trim() || '—']))
  const catOf = (p: ProductRow | undefined) => (p?.category_id && categoryName.get(p.category_id)) || 'Uncategorised'
  const productById = new Map(products.map((p) => [p.id, p]))

  const perProduct = new Map<string, { bookings: Set<string>; qty: number; revenue: number }>()
  for (const b of bookings) {
    for (const l of lineMap.get(b.id) ?? []) {
      if (!l.product_id) continue
      const acc = perProduct.get(l.product_id) ?? { bookings: new Set<string>(), qty: 0, revenue: 0 }
      acc.bookings.add(b.id)
      acc.qty += Number(l.qty) || 0
      acc.revenue += lineValue(l)
      perProduct.set(l.product_id, acc)
    }
  }

  const rows: ProductReportRow[] = [...perProduct.entries()].map(([id, v]) => ({
    productId: id,
    name: productById.get(id)?.name?.trim() || '—',
    category: catOf(productById.get(id)),
    bookings: v.bookings.size,
    quantityBooked: v.qty,
    revenue: v.revenue as Paisa,
  }))

  const catMap = new Map<string, { revenue: number; bookings: Set<string> }>()
  for (const [id, v] of perProduct) {
    const cat = catOf(productById.get(id))
    const acc = catMap.get(cat) ?? { revenue: 0, bookings: new Set<string>() }
    acc.revenue += v.revenue
    v.bookings.forEach((b) => acc.bookings.add(b))
    catMap.set(cat, acc)
  }

  const active = products.filter((p) => p.is_active !== false)
  return {
    productCount: products.length,
    activeProducts: active.length,
    productsBooked: perProduct.size,
    revenue: rows.reduce((a, r) => a + r.revenue, 0) as Paisa,
    byCategory: [...catMap.entries()]
      .map(([category, v]) => ({ category, revenue: v.revenue as Paisa, bookings: v.bookings.size }))
      .sort((a, b) => b.revenue - a.revenue || b.bookings - a.bookings),
    topRevenue: [...rows].sort((a, b) => b.revenue - a.revenue || b.bookings - a.bookings).slice(0, 10),
    notBooked: active
      .filter((p) => !perProduct.has(p.id))
      .map((p) => ({ productId: p.id, name: p.name?.trim() || '—', category: catOf(p) }))
      .sort((a, b) => a.name.localeCompare(b.name)),
    lowStock: active
      .filter((p) => (p.reorder_level ?? 0) > 0 && (p.total_quantity ?? 0) <= (p.reorder_level ?? 0))
      .map((p) => ({ productId: p.id, name: p.name?.trim() || '—', onHand: p.total_quantity ?? 0, reorderLevel: p.reorder_level ?? 0 })),
  }
}
</file>

<file path="src/lib/queries/promotionsReports.ts">
import { supabase } from '../supabase'
import { rupees, type Paisa } from '../money'
import { linesValue, readLineValues, rowsOf, type ReportFilterOptions } from './reportSupport'

/**
 * Promotions & Discounts — coupons, redemptions, discount sources and bundles.
 *
 * RULING 2026-10-16 (R-P6-STATES, Law 16): this read counted coupons,
 * redemptions and bundles (with `|| 842`-style seed fallbacks), summed a
 * `booking_discounts.discount_amount` column that does not exist, and the page
 * rendered `data/promotionsReports` on every path. It now returns:
 *
 *   - per coupon: redemptions in the period and discount given — `coupon_redemptions`
 *   - revenue on bookings that redeemed a coupon — priced lines (`booking_lines_v`)
 *   - discounts by source (count and average percent) — `booking_discounts`
 *   - bundle lines booked and their value — `booking_lines_v.bundle_id`
 *
 * Throws on failure; a period with no promotion activity is empty.
 * Revert = restore the seed re-exports and the `catch`.
 */

export interface CouponPerformanceRow {
  couponId: string
  code: string
  discountPercent: number | null
  isActive: boolean
  redemptions: number
  discountGiven: Paisa
  bookingRevenue: Paisa
}

export interface DiscountSourceRow {
  source: string
  count: number
  averagePercent: number | null
}

export interface BundleUsageRow {
  bundleId: string
  name: string
  bookings: number
  revenue: Paisa
}

export interface PromotionsReportsSummary {
  couponCount: number
  activeCoupons: number
  redemptionCount: number
  discountsGiven: Paisa
  /** Value of the priced lines on bookings that redeemed a coupon in the period. */
  promotionRevenue: Paisa
  /** Revenue ÷ discount given; null when no discount was given. */
  returnOnPromotion: number | null
  coupons: CouponPerformanceRow[]
  discountSources: DiscountSourceRow[]
  bundles: BundleUsageRow[]
}

export async function getPromotionsReportsSummary(options?: ReportFilterOptions): Promise<PromotionsReportsSummary> {
  let redemptionsQ = supabase.from('coupon_redemptions').select('coupon_id, booking_id, discount_amount, redeemed_at')
  let discountsQ = supabase.from('booking_discounts').select('discount_source, percent, applied_at')
  let bookingsQ = supabase.from('bookings').select('id').is('cancelled_at', null)
  if (options?.from) {
    redemptionsQ = redemptionsQ.gte('redeemed_at', options.from)
    discountsQ = discountsQ.gte('applied_at', options.from)
    bookingsQ = bookingsQ.gte('pickup_at', options.from)
  }
  if (options?.to) {
    redemptionsQ = redemptionsQ.lte('redeemed_at', options.to)
    discountsQ = discountsQ.lte('applied_at', options.to)
    bookingsQ = bookingsQ.lte('pickup_at', options.to)
  }
  if (options?.branchId) {
    discountsQ = discountsQ.eq('branch_id', options.branchId)
    bookingsQ = bookingsQ.eq('branch_id', options.branchId)
  }

  const [couponsRes, redemptionsRes, discountsRes, bundlesRes, bookingsRes, lineMap] = await Promise.all([
    supabase.from('coupons').select('id, code, discount_percent, is_active'),
    redemptionsQ,
    discountsQ,
    supabase.from('bundles').select('id, name'),
    bookingsQ,
    readLineValues(),
  ])
  const coupons = rowsOf<{ id: string; code: string; discount_percent: number | string | null; is_active: boolean | null }>(couponsRes, 'Coupons read failed')
  const redemptions = rowsOf<{ coupon_id: string; booking_id: string; discount_amount: number | string | null }>(redemptionsRes, 'Coupon redemptions read failed')
  const discounts = rowsOf<{ discount_source: string | null; percent: number | string | null }>(discountsRes, 'Booking discounts read failed')
  const bundles = rowsOf<{ id: string; name: string | null }>(bundlesRes, 'Bundles read failed')
  const bookings = rowsOf<{ id: string }>(bookingsRes, 'Bookings read failed')

  const perCoupon = new Map<string, { n: number; discount: number; revenue: number }>()
  let discountsGiven = 0
  let promotionRevenue = 0
  for (const r of redemptions) {
    const d = rupees(Number(r.discount_amount ?? 0) || 0)
    const rev = linesValue(lineMap.get(r.booking_id))
    const acc = perCoupon.get(r.coupon_id) ?? { n: 0, discount: 0, revenue: 0 }
    acc.n++
    acc.discount += d
    acc.revenue += rev
    perCoupon.set(r.coupon_id, acc)
    discountsGiven += d
    promotionRevenue += rev
  }

  const sourceMap = new Map<string, { count: number; pctSum: number; pctN: number }>()
  for (const d of discounts) {
    const source = d.discount_source?.trim() || 'Not set'
    const acc = sourceMap.get(source) ?? { count: 0, pctSum: 0, pctN: 0 }
    acc.count++
    if (d.percent != null && d.percent !== '') {
      acc.pctSum += Number(d.percent) || 0
      acc.pctN++
    }
    sourceMap.set(source, acc)
  }

  const bundleName = new Map(bundles.map((b) => [b.id, b.name?.trim() || '—']))
  const perBundle = new Map<string, { bookings: Set<string>; revenue: number }>()
  for (const b of bookings) {
    for (const l of lineMap.get(b.id) ?? []) {
      if (!l.bundle_id) continue
      const acc = perBundle.get(l.bundle_id) ?? { bookings: new Set<string>(), revenue: 0 }
      acc.bookings.add(b.id)
      acc.revenue += linesValue([l])
      perBundle.set(l.bundle_id, acc)
    }
  }

  return {
    couponCount: coupons.length,
    activeCoupons: coupons.filter((c) => c.is_active !== false).length,
    redemptionCount: redemptions.length,
    discountsGiven: discountsGiven as Paisa,
    promotionRevenue: promotionRevenue as Paisa,
    returnOnPromotion: discountsGiven > 0 ? Number((promotionRevenue / discountsGiven).toFixed(1)) : null,
    coupons: coupons
      .map((c) => {
        const acc = perCoupon.get(c.id)
        return {
          couponId: c.id,
          code: c.code,
          discountPercent: c.discount_percent == null || c.discount_percent === '' ? null : Number(c.discount_percent),
          isActive: c.is_active !== false,
          redemptions: acc?.n ?? 0,
          discountGiven: (acc?.discount ?? 0) as Paisa,
          bookingRevenue: (acc?.revenue ?? 0) as Paisa,
        }
      })
      .sort((a, b) => b.redemptions - a.redemptions || a.code.localeCompare(b.code)),
    discountSources: [...sourceMap.entries()]
      .map(([source, v]) => ({ source, count: v.count, averagePercent: v.pctN > 0 ? Number((v.pctSum / v.pctN).toFixed(1)) : null }))
      .sort((a, b) => b.count - a.count),
    bundles: [...perBundle.entries()]
      .map(([id, v]) => ({ bundleId: id, name: bundleName.get(id) ?? '—', bookings: v.bookings.size, revenue: v.revenue as Paisa }))
      .sort((a, b) => b.revenue - a.revenue || b.bookings - a.bookings),
  }
}
</file>

<file path="src/lib/queries/pulse.ts">
import { supabase } from '../supabase'
import { rupees, type Paisa } from '../money'
import {
  PERIODS,
  DEFAULT_PERIOD,
  DEFINITIONS,
  PERIOD_BASIS,
  RECONCILIATION,
  SCHEDULES,
  UPCOMING,
  LEDGER_ASSERTION_ERRORS,
  FLEET_RECONCILIATION_ERRORS,
  MODEL_DISCLOSURE,
  figuresFor,
  previousPeriod,
  rangeLabel,
  dueStatus,
  exportHeader,
  type ChartView,
  type PeriodFigures,
  type EquipmentRow,
  type ScheduleRow,
} from '../../data/pulse'

export {
  PERIODS,
  DEFAULT_PERIOD,
  DEFINITIONS,
  PERIOD_BASIS,
  RECONCILIATION,
  SCHEDULES,
  UPCOMING,
  LEDGER_ASSERTION_ERRORS,
  FLEET_RECONCILIATION_ERRORS,
  MODEL_DISCLOSURE,
  figuresFor,
  previousPeriod,
  rangeLabel,
  dueStatus,
  exportHeader,
}

export type { ChartView, PeriodFigures, EquipmentRow, ScheduleRow }

export interface PulseLiveSummary {
  bookingCount: number
  activeBookings: number
  invoicedTotal: Paisa
  collectedTotal: Paisa
  inventoryUnitsCount: number
}

/**
 * Queries PostgreSQL database for live operational and financial aggregates
 * behind the executive Pulse dashboard.
 *
 * RULING 2026-10-15: a failed read THROWS. It used to resolve to zeros — on a
 * caught exception, and silently on any one of the four reads returning an
 * error — so an outage read as "0 bookings, Rs 0 collected", a figure nobody
 * recorded (Law 16). Pulse draws its Error state (with Retry) from the throw,
 * and its "nothing yet" Empty state only from a read that genuinely returned
 * no rows. Revert = restore the `catch` returning zeros.
 */
export async function getPulseLiveSummary(): Promise<PulseLiveSummary> {
  const [bookingsRes, invoicesRes, paymentsRes, unitsRes] = await Promise.all([
    supabase.from('bookings').select('id, stage'),
    supabase.from('invoices').select('id, total_amount, status'),
    // `payment_status` is Received / Refunded / Failed / Cancelled (0001). This
    // filtered on 'Completed', which Postgres rejects; the old zero-fallback hid
    // that, so collected cash always read Rs 0. Surfaced by the throw below.
    supabase.from('payments').select('id, amount, status').eq('status', 'Received'),
    supabase.from('product_units').select('id, status'),
  ])

  const reads = { bookings: bookingsRes, invoices: invoicesRes, payments: paymentsRes, product_units: unitsRes }
  for (const [table, res] of Object.entries(reads)) {
    if (res.error) throw new Error(`getPulseLiveSummary failed on ${table}: ${res.error.message}`)
  }

  const bookings = bookingsRes.data ?? []
  const invoices = invoicesRes.data ?? []
  const payments = paymentsRes.data ?? []
  const units = unitsRes.data ?? []

  const activeBookings = bookings.filter((b) =>
    ['Confirmed', 'Packed', 'On Rent'].includes(b.stage),
  ).length

  const invoicedTotal = rupees(
    invoices.reduce((sum, inv) => sum + (Number(inv.total_amount) || 0), 0),
  )

  const collectedTotal = rupees(
    payments.reduce((sum, pay) => sum + (Number(pay.amount) || 0), 0),
  )

  return {
    bookingCount: bookings.length,
    activeBookings,
    invoicedTotal,
    collectedTotal,
    inventoryUnitsCount: units.length,
  }
}

/**
 * Whether the business has recorded nothing Pulse could summarise — no
 * bookings and no units. Pulse's "nothing yet" Empty state reads this, so the
 * first-run screen is a different sentence from "this period has no figures".
 */
export function isPulseNothingYet(summary: PulseLiveSummary): boolean {
  return summary.bookingCount === 0 && summary.inventoryUnitsCount === 0
}
</file>

<file path="src/lib/queries/rentalReports.ts">
import { supabase } from '../supabase'
import type { Paisa } from '../money'
import { rentalDaysBetween } from '../rentalDays'
import { embeddedName, isPermissionDenied, linesValue, percentOf, readLineValues, rowsOf, type ReportFilterOptions } from './reportSupport'

export type { ReportFilterOptions } from './reportSupport'

export interface RentalPerformanceMetrics {
  totalBookings: number
  activeRentals: number
  completedRentals: number
  cancelledRentals: number
  totalRevenue: Paisa
  averageBookingValue: Paisa
  totalRentalDays: number
  averageDurationDays: number
}

export interface StageBreakdownItem {
  stage: string
  count: number
  revenue: Paisa
  percent: number
}

export interface ProjectTypeBreakdownItem {
  projectType: string
  count: number
  revenue: Paisa
  percent: number
}

export interface TopBookingItem {
  id: string
  bookingNo: string
  clientName: string
  project: string
  days: number
  stage: string
  value: Paisa
}

export interface RentalPerformanceReportData {
  metrics: RentalPerformanceMetrics
  stages: StageBreakdownItem[]
  /**
   * Null when this session may not read `bookings.project_type` — the column
   * is granted by 0161/0162, which live does not have yet. The card then says
   * so instead of failing the whole report.
   */
  projectTypes: ProjectTypeBreakdownItem[] | null
  topBookings: TopBookingItem[]
}

export interface DurationBucket {
  key: string
  label: string
  minDays: number
  maxDays: number
  count: number
  sharePercent: number
  totalDays: number
  revenue: Paisa
  avgDailyRate: Paisa
}

export interface RentalDurationReportData {
  totalRentals: number
  averageDuration: number
  medianDuration: number
  longestDuration: number
  shortestDuration: number
  buckets: DurationBucket[]
}

export interface CancellationReasonItem {
  reason: string
  count: number
  percent: number
  lostRevenue: Paisa
}

export interface CancelledBookingItem {
  id: string
  bookingNo: string
  clientName: string
  project: string
  cancelledAt: string
  scheduledPickup: string
  lostRevenue: Paisa
  reason: string
}

export interface CancellationsReportData {
  totalCancellations: number
  cancellationRate: number
  totalLostRevenue: Paisa
  /** Mean days between cancelling and the scheduled pickup; null when no cancellation carries both dates. */
  averageNoticeDays: number | null
  reasons: CancellationReasonItem[]
  cancelledBookings: CancelledBookingItem[]
}

/*
 * RULING 2026-10-16 (R-P6-STATES, Law 16): these reads returned MOCK_PERFORMANCE /
 * MOCK_DURATION / MOCK_CANCELLATIONS on a failed read AND on an empty one, and
 * the trend was always the mock block. They now throw on failure (the page
 * draws Error + Retry) and return honest zeros on an empty period. Also fixed
 * while here, each of which made a live figure wrong:
 *   - cancellation is `bookings.cancelled_at` (0015), not `stage = 'Cancelled'`
 *     — Postgres rejects that literal, so the Cancellations tab could only ever
 *     show the mock block;
 *   - "completed" is Returned/Closed (the canonical six have no 'Completed');
 *   - money was computed in rupees then divided by 100 again (see `lineValue`);
 *   - line money was read from base `booking_lines`, whose rate columns 0062
 *     revokes — it now comes from `booking_lines_v` (`readLineValues`).
 * Revert = restore the MOCK_* constants and each `catch`.
 */

type BookingRow = {
  id: string
  booking_no: string
  stage: string
  pickup_at: string
  return_at: string
  project: string | null
  cancelled_at: string | null
  cancellation_reason?: string | null
  clients?: unknown
}

// Loosely typed on purpose: supabase-js's builder generics recurse past tsc's
// depth limit when threaded through a helper (TS2589).
// eslint-disable-next-line @typescript-eslint/no-explicit-any
type AnyQuery = any

function filtered(q: AnyQuery, options?: ReportFilterOptions): AnyQuery {
  let out = q
  if (options?.from) out = out.gte('pickup_at', options.from)
  if (options?.to) out = out.lte('pickup_at', options.to)
  if (options?.branchId) out = out.eq('branch_id', options.branchId)
  return out
}

function daysOf(b: Pick<BookingRow, 'pickup_at' | 'return_at'>): number {
  return rentalDaysBetween(b.pickup_at, b.return_at) ?? 1
}

export async function getRentalPerformanceReport(options?: ReportFilterOptions): Promise<RentalPerformanceReportData> {
  const [res, typeRes, lineMap] = await Promise.all([
    filtered(
      supabase.from('bookings').select('id, booking_no, stage, pickup_at, return_at, project, cancelled_at, clients!client_id(name)'),
      options,
    ),
    filtered(supabase.from('bookings').select('id, project_type'), options),
    readLineValues(),
  ])
  const rows = rowsOf<BookingRow>(res, 'Rental performance read failed')
  // The one tolerated refusal: a column grant live has not received yet.
  const typesReadable = !(typeRes.error && isPermissionDenied(typeRes.error))
  const typeById = new Map(
    (typesReadable ? rowsOf<{ id: string; project_type: string | null }>(typeRes, 'Project type read failed') : []).map((r) => [
      r.id,
      r.project_type,
    ]),
  )

  let totalRevenue = 0
  let totalRentalDays = 0
  let active = 0
  let completed = 0
  let cancelled = 0
  const stageMap = new Map<string, { count: number; revenue: number }>()
  const typeMap = new Map<string, { count: number; revenue: number }>()
  const top: TopBookingItem[] = []

  for (const b of rows) {
    const days = daysOf(b)
    const value = linesValue(lineMap.get(b.id), days)
    const isCancelled = b.cancelled_at != null
    const stage = isCancelled ? 'Cancelled' : b.stage
    if (isCancelled) cancelled++
    else if (b.stage === 'Packed' || b.stage === 'On Rent') active++
    else if (b.stage === 'Returned' || b.stage === 'Closed') completed++

    const st = stageMap.get(stage) ?? { count: 0, revenue: 0 }
    st.count++
    st.revenue += value
    stageMap.set(stage, st)

    const type = typeById.get(b.id)?.trim() || 'Not set'
    const pt = typeMap.get(type) ?? { count: 0, revenue: 0 }
    pt.count++
    pt.revenue += value
    typeMap.set(type, pt)

    if (isCancelled) continue
    totalRevenue += value
    totalRentalDays += days
    top.push({
      id: b.id,
      bookingNo: b.booking_no,
      clientName: embeddedName(b.clients),
      project: b.project?.trim() || '—',
      days,
      stage,
      value,
    })
  }

  const total = rows.length
  const live = total - cancelled
  top.sort((a, b) => b.value - a.value)

  return {
    metrics: {
      totalBookings: total,
      activeRentals: active,
      completedRentals: completed,
      cancelledRentals: cancelled,
      totalRevenue: totalRevenue as Paisa,
      averageBookingValue: (live > 0 ? Math.round(totalRevenue / live) : 0) as Paisa,
      totalRentalDays,
      averageDurationDays: live > 0 ? Number((totalRentalDays / live).toFixed(1)) : 0,
    },
    stages: [...stageMap.entries()]
      .sort((a, b) => b[1].count - a[1].count)
      .map(([stage, v]) => ({ stage, count: v.count, revenue: v.revenue as Paisa, percent: percentOf(v.count, total) })),
    projectTypes: !typesReadable
      ? null
      : [...typeMap.entries()]
      .sort((a, b) => b[1].count - a[1].count)
      .slice(0, 5)
      .map(([projectType, v]) => ({ projectType, count: v.count, revenue: v.revenue as Paisa, percent: percentOf(v.count, total) })),
    topBookings: top.slice(0, 5),
  }
}

const BUCKETS = [
  { key: '1d', label: '1 Day', minDays: 1, maxDays: 1 },
  { key: '2-3d', label: '2–3 Days', minDays: 2, maxDays: 3 },
  { key: '4-7d', label: '4–7 Days', minDays: 4, maxDays: 7 },
  { key: '8-14d', label: '8–14 Days', minDays: 8, maxDays: 14 },
  { key: '15d+', label: '15+ Days', minDays: 15, maxDays: 9999 },
] as const

export async function getRentalDurationReport(options?: ReportFilterOptions): Promise<RentalDurationReportData> {
  const [res, lineMap] = await Promise.all([
    filtered(supabase.from('bookings').select('id, pickup_at, return_at').is('cancelled_at', null), options),
    readLineValues(),
  ])
  const rows = rowsOf<Pick<BookingRow, 'id' | 'pickup_at' | 'return_at'>>(res, 'Rental duration read failed')

  const acc = BUCKETS.map((b) => ({ ...b, count: 0, totalDays: 0, revenue: 0 }))
  const durations: number[] = []
  for (const b of rows) {
    const days = daysOf(b)
    durations.push(days)
    const bucket = acc.find((d) => days >= d.minDays && days <= d.maxDays) ?? acc[acc.length - 1]
    if (!bucket) continue
    bucket.count++
    bucket.totalDays += days
    bucket.revenue += linesValue(lineMap.get(b.id), days)
  }
  durations.sort((a, b) => a - b)
  const n = durations.length
  const sum = durations.reduce((a, d) => a + d, 0)

  return {
    totalRentals: n,
    averageDuration: n > 0 ? Number((sum / n).toFixed(1)) : 0,
    medianDuration: n > 0 ? (durations[Math.floor(n / 2)] ?? 0) : 0,
    longestDuration: durations[n - 1] ?? 0,
    shortestDuration: durations[0] ?? 0,
    buckets: acc.map((b) => ({
      key: b.key,
      label: b.label,
      minDays: b.minDays,
      maxDays: b.maxDays,
      count: b.count,
      sharePercent: percentOf(b.count, n),
      totalDays: b.totalDays,
      revenue: b.revenue as Paisa,
      avgDailyRate: (b.totalDays > 0 ? Math.round(b.revenue / b.totalDays) : 0) as Paisa,
    })),
  }
}

export async function getCancellationsReport(options?: ReportFilterOptions): Promise<CancellationsReportData> {
  const [allRes, cancelRes, lineMap] = await Promise.all([
    filtered(supabase.from('bookings').select('id'), options),
    filtered(
      supabase
        .from('bookings')
        .select('id, booking_no, pickup_at, return_at, project, cancelled_at, cancellation_reason, clients!client_id(name)')
        .not('cancelled_at', 'is', null),
      options,
    ),
    readLineValues(),
  ])
  const totalAll = rowsOf(allRes, 'Booking count read failed').length
  const rows = rowsOf<BookingRow>(cancelRes, 'Cancellations read failed')

  let lostTotal = 0
  let noticeHours = 0
  let noticeCount = 0
  const reasonMap = new Map<string, { count: number; lost: number }>()
  const list: CancelledBookingItem[] = []

  for (const b of rows) {
    const lost = linesValue(lineMap.get(b.id), daysOf(b))
    lostTotal += lost
    // The DB refuses a cancellation without a reason (0002/0015 check); an
    // empty one here is an older row, and it says so rather than guessing.
    const reason = b.cancellation_reason?.trim() || 'No reason recorded'
    const r = reasonMap.get(reason) ?? { count: 0, lost: 0 }
    r.count++
    r.lost += lost
    reasonMap.set(reason, r)

    const c = b.cancelled_at ? Date.parse(b.cancelled_at) : NaN
    const p = Date.parse(b.pickup_at)
    if (!Number.isNaN(c) && !Number.isNaN(p)) {
      noticeHours += Math.max(0, (p - c) / 3_600_000)
      noticeCount++
    }

    list.push({
      id: b.id,
      bookingNo: b.booking_no,
      clientName: embeddedName(b.clients),
      project: b.project?.trim() || '—',
      cancelledAt: b.cancelled_at ?? '',
      scheduledPickup: b.pickup_at,
      lostRevenue: lost,
      reason,
    })
  }

  const n = rows.length
  return {
    totalCancellations: n,
    cancellationRate: totalAll > 0 ? Number(((n / totalAll) * 100).toFixed(1)) : 0,
    totalLostRevenue: lostTotal as Paisa,
    averageNoticeDays: noticeCount > 0 ? Number((noticeHours / noticeCount / 24).toFixed(1)) : null,
    reasons: [...reasonMap.entries()]
      .sort((a, b) => b[1].count - a[1].count)
      .map(([reason, v]) => ({ reason, count: v.count, percent: percentOf(v.count, n), lostRevenue: v.lost as Paisa })),
    cancelledBookings: list,
  }
}
