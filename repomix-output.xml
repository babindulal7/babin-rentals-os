<file path="src/lib/savedViews.ts">
import { newClientUuid, supabase } from './supabase'
import { readLocal, writeLocal } from './safeStorage'

/**
 * Shared saved list views (0159, G2). The database owns who sees what — a view that filters on money is
 * never returned to a money-blind role (Law 6), a retired view is never returned, and a system view cannot
 * be changed — so this module only maps rows and calls the two RPCs.
 */
export interface SharedListView {
  id: string
  name: string
  query: string
  hiddenColumns: string[]
  visibility: 'private' | 'team'
  isSystem: boolean
  ownerId: string | null
  createdAt: string
}

interface ViewRow {
  id: string
  name: string
  query: string
  hidden_columns: string[] | null
  visibility: 'private' | 'team'
  is_system: boolean
  owner_id: string | null
  created_at: string
}

export function rowToView(r: ViewRow): SharedListView {
  return {
    id: r.id,
    name: r.name,
    query: r.query,
    hiddenColumns: r.hidden_columns ?? [],
    visibility: r.visibility,
    isSystem: r.is_system,
    ownerId: r.owner_id,
    createdAt: r.created_at,
  }
}

export async function listSharedViews(listKey: string): Promise<SharedListView[]> {
  const { data, error } = await supabase
    .from('saved_views' as never)
    .select('id, name, query, hidden_columns, visibility, is_system, owner_id, created_at')
    .eq('list_key', listKey)
    .order('created_at', { ascending: true })
  if (error) throw new Error(error.message)
  return ((data ?? []) as unknown as ViewRow[])
    .filter((r) => typeof r?.id === 'string' && typeof r.name === 'string' && typeof r.query === 'string')
    .map(rowToView)
}

function unwrap(message: string): string {
  return message.replace(/^GATE:[^|]*\|/, '')
}

export async function saveSharedView(input: {
  id?: string | null
  listKey: string
  name: string
  query: string
  hiddenColumns: readonly string[]
  visibility: 'private' | 'team'
  clientUuid?: string
}): Promise<string> {
  const { data, error } = await supabase.rpc('save_view' as never, {
    p_client_uuid: input.clientUuid ?? newClientUuid(),
    p_list_key: input.listKey,
    p_name: input.name,
    p_query: input.query,
    p_hidden_columns: [...input.hiddenColumns],
    p_visibility: input.visibility,
    p_id: input.id ?? null,
  } as never)
  if (error) throw new Error(unwrap(error.message))
  return data as unknown as string
}

export async function retireSharedView(id: string): Promise<void> {
  const { error } = await supabase.rpc('retire_view' as never, { p_id: id } as never)
  if (error) throw new Error(unwrap(error.message))
}

interface LegacyView {
  name: string
  query: string
  hiddenColumns: string[]
}

function parseLegacy(raw: string | null): LegacyView[] {
  if (!raw) return []
  try {
    const parsed: unknown = JSON.parse(raw)
    if (!Array.isArray(parsed)) return []
    return parsed.filter(
      (v): v is LegacyView =>
        !!v &&
        typeof v === 'object' &&
        typeof (v as LegacyView).name === 'string' &&
        typeof (v as LegacyView).query === 'string' &&
        Array.isArray((v as LegacyView).hiddenColumns),
    )
  } catch {
    return []
  }
}

/**
 * First load after G2: this browser's old views become the signed-in user's private views, once.
 * The marker is written only after every save succeeded or was refused, so a network failure retries
 * next load; the old list is left in place as a backup (nothing is deleted).
 */
export async function migrateLocalViews(listKey: string, legacyStorageKey: string): Promise<number> {
  const marker = `${legacyStorageKey}:migrated-to-db`
  if (readLocal(marker) === 'done') return 0
  const legacy = parseLegacy(readLocal(legacyStorageKey))
  let moved = 0
  for (const v of legacy) {
    try {
      await saveSharedView({ listKey, name: v.name, query: v.query, hiddenColumns: v.hiddenColumns, visibility: 'private' })
      moved++
    } catch (e) {
      const msg = e instanceof Error ? e.message : ''
      /* A name that already exists, or a money view this role may not save, will never succeed — skip it.
         Anything else (network) leaves the marker unset so the next load tries again. */
      if (!/unique|duplicate|money/i.test(msg)) return moved
    }
  }
  writeLocal(marker, 'done')
  return moved
}

/**
 * Until 0159 is applied to a database, `saved_views` and its two functions do not exist there. That is
 * a deployment state, not an error the floor should read: the menu falls back to this device's own list
 * (the pre-G2 behaviour), and the first load after the migration moves that list up as private views.
 */
export function sharedViewsUnavailable(message: string): boolean {
  return /schema cache|does not exist|could not find the (table|function)|PGRST20[25]/i.test(message)
}

interface DeviceView extends LegacyView {
  id?: string
  createdAt?: string
}

export const DEFAULT_RENTALS_SYSTEM_VIEWS: readonly SharedListView[] = [
  { id: 'system-rentals-pickups-today', name: 'Pickups today', query: 'quick=Pickups+Today', hiddenColumns: [], visibility: 'team', isSystem: true, ownerId: null, createdAt: new Date(0).toISOString() },
  { id: 'system-rentals-returns-today', name: 'Returns today', query: 'quick=Returns+Today', hiddenColumns: [], visibility: 'team', isSystem: true, ownerId: null, createdAt: new Date(0).toISOString() },
  { id: 'system-rentals-overdue', name: 'Overdue', query: 'quick=Overdue', hiddenColumns: [], visibility: 'team', isSystem: true, ownerId: null, createdAt: new Date(0).toISOString() },
  { id: 'system-rentals-awaiting-inspection', name: 'Awaiting inspection', query: 'quick=Inspection', hiddenColumns: [], visibility: 'team', isSystem: true, ownerId: null, createdAt: new Date(0).toISOString() },
  { id: 'system-rentals-drafts', name: 'Drafts', query: 'stage=Draft', hiddenColumns: [], visibility: 'team', isSystem: true, ownerId: null, createdAt: new Date(0).toISOString() },
]

export function readDeviceViews(legacyStorageKey: string, userId: string | null, listKey?: string): SharedListView[] {
  const raw = parseLegacy(readLocal(legacyStorageKey)) as DeviceView[]
  const deviceViews: SharedListView[] = raw.map((v, i) => ({
    id: v.id ?? `device-${i}-${v.name}`,
    name: v.name,
    query: v.query,
    hiddenColumns: [...v.hiddenColumns],
    visibility: 'private',
    isSystem: false,
    ownerId: userId,
    createdAt: v.createdAt ?? new Date(0).toISOString(),
  }))
  if (listKey === 'rentals' || legacyStorageKey.includes('rentals')) {
    return [...DEFAULT_RENTALS_SYSTEM_VIEWS, ...deviceViews]
  }
  return deviceViews
}

export function writeDeviceViews(legacyStorageKey: string, views: readonly SharedListView[]): void {
  const toSave = views.filter((v) => !v.isSystem)
  writeLocal(
    legacyStorageKey,
    JSON.stringify(toSave.map((v) => ({ id: v.id, name: v.name, query: v.query, hiddenColumns: v.hiddenColumns, createdAt: v.createdAt }))),
  )
}
</file>

<file path="src/lib/syncEngine.ts">
import { supabase } from './supabase'
import { drainQueue, getOfflineQueueSummary } from './offlineQueue'
import { localStore, isIndexedDbAvailable } from './localStore'
import type { CachedClient, CachedProduct } from './localStore'
import { captureError } from './monitoring'

/* What the two delta pulls read off `select('*')`. The client carries no
   `Database` generic at this layer, so the shape is declared rather than
   inferred — every field but `id` is optional because `*` promises nothing. */
interface RemoteProduct extends Partial<Omit<CachedProduct, 'id'>> { id: string }
interface RemoteClient extends Partial<Omit<CachedClient, 'id'>> { id: string }

/* Dexie treats an absent key and an `undefined` value alike;
   `exactOptionalPropertyTypes` does not — an optional field may be missing,
   never `undefined`. The remote row is mapped with every column named and
   the undefined ones dropped here, so the cached row's type stays strict. */
function withoutUndefined<T extends object>(row: { [K in keyof T]: T[K] | undefined }): T {
  return Object.fromEntries(Object.entries(row).filter(([, v]) => v !== undefined)) as T
}

export type SyncStatusType = 'synced' | 'syncing' | 'pending' | 'offline' | 'error'

export interface SyncState {
  status: SyncStatusType
  pendingCount: number
  lastSyncTime: Date | null
  error?: string | undefined
}

type SyncListener = (state: SyncState) => void

class SyncEngine {
  private listeners: Set<SyncListener> = new Set()
  private state: SyncState = {
    status: typeof navigator !== 'undefined' && !navigator.onLine ? 'offline' : 'synced',
    pendingCount: 0,
    lastSyncTime: null,
  }
  private intervalTimer: number | null = null
  private syncing = false

  constructor() {
    if (typeof window !== 'undefined') {
      window.addEventListener('online', () => {
        this.updateState({ status: 'syncing' })
        this.syncAll().catch(() => {})
      })
      window.addEventListener('offline', () => {
        this.updateState({ status: 'offline' })
      })

      // Start periodic background sync every 25 seconds when online
      this.startBackgroundSync(25000)
    }
  }

  public getState(): SyncState {
    return this.state
  }

  public subscribe(listener: SyncListener): () => void {
    this.listeners.add(listener)
    listener(this.state)
    return () => this.listeners.delete(listener)
  }

  private updateState(partial: Partial<SyncState>) {
    this.state = { ...this.state, ...partial }
    this.listeners.forEach((l) => l(this.state))
  }

  public startBackgroundSync(intervalMs = 25000) {
    if (this.intervalTimer) window.clearInterval(this.intervalTimer)
    this.intervalTimer = window.setInterval(() => {
      if (typeof navigator !== 'undefined' && navigator.onLine) {
        this.syncAll().catch(() => {})
      }
    }, intervalMs)
  }

  public stopBackgroundSync() {
    if (this.intervalTimer) {
      window.clearInterval(this.intervalTimer)
      this.intervalTimer = null
    }
  }

  /**
   * Refreshes the pending mutation count from IndexedDB.
   */
  public async refreshPendingCount(): Promise<number> {
    if (!isIndexedDbAvailable()) return 0
    try {
      const summary = await getOfflineQueueSummary()
      const count = summary.total
      const error = summary.held > 0
        ? 'Saved offline work is held for another account or needs its original identity verified. It has been preserved.'
        : summary.failed > 0 ? 'Some saved offline work needs review before it can sync.' : undefined
      this.updateState({
        pendingCount: count,
        error,
        status:
          typeof navigator !== 'undefined' && !navigator.onLine
            ? 'offline'
            : count > 0
            ? 'pending'
            : 'synced',
      })
      return count
    } catch {
      return 0
    }
  }

  /**
   * Full 2-way sync: drains the pending mutation outbox to Supabase, then pulls fresh master deltas.
   */
  public async syncAll(): Promise<{ success: boolean; pushed: number; error?: string }> {
    if (this.syncing) return { success: false, pushed: 0 }
    if (typeof navigator !== 'undefined' && !navigator.onLine) {
      this.updateState({ status: 'offline' })
      return { success: false, pushed: 0, error: 'Offline' }
    }

    this.syncing = true
    this.updateState({ status: 'syncing', error: undefined })

    try {
      // 1. Drain upstream offline queue
      await drainQueue()
      const remainingPending = await this.refreshPendingCount()

      // 2. Pull downstream deltas into local Dexie store
      await this.pullDeltas()

      const now = new Date()
      this.updateState({
        status: remainingPending > 0 ? 'pending' : 'synced',
        pendingCount: remainingPending,
        lastSyncTime: now,
      })

      return { success: remainingPending === 0, pushed: 0 }
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : String(err)
      captureError(err, { where: 'syncEngine.sync' })
      this.updateState({
        status: 'error',
        error: message,
      })
      return { success: false, pushed: 0, error: message }
    } finally {
      this.syncing = false
    }
  }

  /**
   * Pulls delta tables from Supabase into Dexie localStore.
   */
  private async pullDeltas(): Promise<void> {
    if (!isIndexedDbAvailable()) return

    try {
      // Pull products / equipment
      const { data: products } = await supabase
        .from('products_v')
        .select('id, name, asset_code, brand, model, status, is_active, created_at')
        .limit(300)
      if (products && products.length > 0) {
        await localStore.products.bulkPut(
          products.map((p: RemoteProduct) => withoutUndefined<CachedProduct>({
            id: p.id,
            name: p.name ?? '',
            serial_no: p.serial_no,
            asset_tag: p.asset_tag,
            category: p.category,
            daily_rate_paisa: p.daily_rate_paisa,
            status: p.status,
            rack: p.rack,
            shelf: p.shelf,
            bin: p.bin,
            updated_at: p.updated_at || new Date().toISOString(),
          }))
        )
      }

      // Pull client directory
      const { data: clients } = await supabase
        .from('clients')
        .select('id, name, phone, email, address, is_blocked, created_at')
        .limit(300)
      if (clients && clients.length > 0) {
        await localStore.clients.bulkPut(
          clients.map((c: RemoteClient) => withoutUndefined<CachedClient>({
            id: c.id,
            name: c.name ?? '',
            phone: c.phone ?? '',
            email: c.email,
            address: c.address,
            credit_tier: c.credit_tier,
            is_blocked: c.is_blocked || false,
            updated_at: c.updated_at || new Date().toISOString(),
          }))
        )
      }
    } catch (e) {
      // Soft-fail delta caching without interrupting operational flow
      console.debug('[SyncEngine] Delta caching bypassed or unauthenticated:', e)
    }
  }
}

export const syncEngine = new SyncEngine()
</file>

<file path="src/modules/admin/ActivityLog.tsx">
import { formatAd } from '../../lib/bs'
import { useMemo, useState } from 'react'
import type { CSSProperties } from 'react'
import Icon from '../../components/ui/Icon'
import { PageHeader, KpiStrip, FooterNote, cardStyle } from '../../components/ui/Page'
import type { Kpi } from '../../components/ui/Page'
import { EmptyState } from '../../components/ui/StateViews'
import { PageBody } from '../../components/ui/PageBody'
import { useLoad } from '../../lib/queries/useLoad'
import { useViewport } from '../../lib/device'
import { useAuth } from '../../lib/auth'
import {
  listActivityEvents,
  ACTIVITY_MODULES,
  RETENTION_NOTE,
  targetLabel,
  type ActivityRow,
} from '../../lib/queries/activity'

/**
 * **Activity Log — `10_TOOLS.md` §10.5.**
 *
 * ```
 * ┌ ← Activity              [user ▾][module ▾][date ▾] ┐
 * │ ● 10:42  who │ did what, where                     │
 * │ ● 10:31  who │ did what, where   timeline, newest  │
 * │ ● 09:58  who │ did what, where   first             │
 * └────────────────────────────────────────────────────┘
 * ```
 *
 * §10.5 draws a **timeline**, not a table — a dotted rail with the time on the
 * left and the sentence on the right — and that is what this renders at every
 * width. The rail collapses to a single column below 768 rather than becoming a
 * card grid, because a timeline that loses its spine stops being one.
 *
 * ## Not the audit trail
 *
 * The two screens look alike and are not. Audit records **state changes** and is
 * append-only and view-only by specification (§10.4). This records **usage** —
 * who looked at what, who exported, who failed to sign in. A failed sign-in has
 * no before/after and belongs only here. Keeping them separate is why
 * `data/activityLog.ts` and `data/auditLog.ts` are two files rather than one
 * table with a `kind` column.
 *
 * The KPI strip predates this spec and no prose removes it (Rulings §1). Its
 * figures are counted from the rows; the old seed's `critical: 12` card is gone
 * because nothing in the build assigns a severity to an activity row, and
 * Rulings §8 forbids the plausible default that would have kept it.
 *
 * The `←` is wireframe shorthand — breadcrumbs, no Back button.
 */

const ALL = 'All'

export default function ActivityLog() {
  const viewport = useViewport()
  const { user } = useAuth()
  const showNetwork = user?.role === 'Owner' || user?.role === 'Manager' || user?.role === 'Admin'
  /*
   * Phase 6. The read was `listActivityEvents().then(...).catch(() => {})` over
   * a query that also swallowed its own errors, so loading, a failure and a
   * genuinely empty log all drew the same "No activity matches this filter".
   * `useLoad` separates them: skeleton, banner with Retry (offline-worded when
   * it is), and a "nothing yet" Empty distinct from the filtered one below.
   */
  const load = useLoad(() => listActivityEvents())
  const timeline = useMemo<readonly ActivityRow[]>(() => load.data?.rows ?? [], [load.data])

  const [who, setWho] = useState<string>(ALL)
  const [mod, setMod] = useState<string>(ALL)
  const [day, setDay] = useState<string>(ALL)

  const rows = useMemo(
    () =>
      timeline.filter((r) => who === ALL || r.user === who)
        .filter((r) => mod === ALL || r.module === mod)
        .filter((r) => day === ALL || r.timestamp.slice(0, 10) === day),
    [timeline, who, mod, day],
  )

  /** Newest first, grouped by day so the spine carries a date header. */
  const groups = useMemo(() => {
    const byDay = new Map<string, ActivityRow[]>()
    for (const r of rows) {
      const key = r.timestamp.slice(0, 10)
      const bucket = byDay.get(key)
      if (bucket) bucket.push(r)
      else byDay.set(key, [r])
    }
    return [...byDay.entries()].sort((a, b) => b[0].localeCompare(a[0]))
  }, [rows])

  const metrics = useMemo(() => ({
    totalActivities: timeline.length,
    failed: timeline.filter((r) => r.status === 'Failed').length,
    uniqueUsers: new Set(timeline.map((r) => r.user)).size,
    modulesTouched: new Set(timeline.map((r) => r.module)).size,
  }), [timeline])

  const userOptions = useMemo(() => [...new Set(timeline.map((r) => r.user))].sort((a, b) => a.localeCompare(b)), [timeline])
  const moduleOptions = useMemo(() => ACTIVITY_MODULES.filter((m) => timeline.some((r) => r.module === m)), [timeline])
  const dayOptions = useMemo(() => [...new Set(timeline.map((r) => r.timestamp.slice(0, 10)))].sort((a, b) => b.localeCompare(a)), [timeline])

  const kpis: Kpi[] = [
    { label: 'Entries', value: String(metrics.totalActivities), icon: 'activity', accent: 'primary', note: 'In this log' },
    { label: 'Failed', value: String(metrics.failed), icon: 'error', accent: 'danger', note: 'Errors or refusals' },
    { label: 'People', value: String(metrics.uniqueUsers), icon: 'users', accent: 'success', note: 'Distinct actors' },
    { label: 'Modules', value: String(metrics.modulesTouched), icon: 'queues', accent: 'progress', note: 'Touched' },
  ]

  const filtered = who !== ALL || mod !== ALL || day !== ALL

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-lg)' }}>
      <PageHeader
        icon="activity"
        title="Activity"
        description="Who did what, where — newest first. Usage, not state changes; those live in the Audit Log."
      />

      <PageBody
        noun="activity"
        loading={load.loading}
        error={load.error}
        onRetry={load.reload}
        hasRows={timeline.length > 0}
        empty={load.data !== null && timeline.length === 0}
        emptyTitle="No activity recorded yet"
        emptyMessage="Sign-ins, exports and other usage appear here as they happen."
      >
      <KpiStrip items={kpis} columns={viewport === 'phone' ? 1 : viewport === 'tablet' ? 2 : 4} />

      <div
        role="search"
        aria-label="Filter activity"
        style={{
          display: 'grid',
          gridTemplateColumns: viewport === 'phone' ? 'minmax(0,1fr)' : 'repeat(3, minmax(0,1fr))',
          gap: 'var(--sp-sm)',
        }}
      >
        <Filter label="User" value={who} onChange={setWho} options={userOptions} />
        <Filter label="Module" value={mod} onChange={setMod} options={moduleOptions} />
        <Filter label="Date" value={day} onChange={setDay} options={dayOptions} />
      </div>

      {/* Reached only with a non-empty log, so this is always no RESULTS —
          the "nothing yet" case is the PageBody's. */}
      {groups.length === 0 ? (
        <EmptyState
          kind="no-results"
          icon={<Icon name="search" size={22} />}
          title="No activity matches this filter"
          description="Try a wider date, another module, or clear the filters to see the whole timeline."
          {...(filtered
            ? {
                actionLabel: 'Clear filters',
                onAction: () => {
                  setWho(ALL)
                  setMod(ALL)
                  setDay(ALL)
                },
              }
            : {})}
        />
      ) : (
        <div style={{ ...cardStyle, padding: viewport === 'phone' ? '4px 14px 14px' : '4px 18px 18px' }}>
          {groups.map(([date, entries]) => (
            <section key={date} aria-label={`Activity on ${formatAd(new Date(date))}`}>
              <h2
                style={{
                  margin: '14px 0 4px',
                  fontSize: 'var(--t-th)',
                  fontWeight: 700,
                  letterSpacing: '0.06em',
                  textTransform: 'uppercase',
                  color: 'var(--muted)',
                }}
              >
                <span className="figure">{formatAd(new Date(date))}</span>
              </h2>
              <ol style={{ margin: 0, padding: 0, listStyle: 'none' }}>
                {entries.map((r, i) => (
                  <Entry key={r.id} row={r} last={i === entries.length - 1} phone={viewport === 'phone'} showNetwork={showNetwork} />
                ))}
              </ol>
            </section>
          ))}
        </div>
      )}
      </PageBody>

      <p style={{ margin: 0, fontSize: 'var(--t-meta)', color: 'var(--muted)', lineHeight: 1.6 }}>{RETENTION_NOTE}</p>

      <FooterNote />
    </div>
  )
}

/* ── one line of the timeline ──────────────────────────────────────────── */

function Entry({ row, last, phone, showNetwork }: { row: ActivityRow; last: boolean; phone: boolean; showNetwork: boolean }) {
  const failed = row.status === 'Failed'
  const target = targetLabel(row.target, row.timestamp)

  return (
    <li
      style={{
        display: 'grid',
        /* Desktop/tablet keep §10.5's two columns — time on the left of the
           spine, the sentence to its right. Phone drops to one column and the
           time moves above the sentence; the spine survives at both. */
        gridTemplateColumns: phone ? '18px minmax(0,1fr)' : '76px 18px minmax(0,1fr)',
        gap: '0 10px',
        alignItems: 'start',
      }}
    >
      {!phone && (
        <span className="figure" style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', padding: '10px 0', textAlign: 'right' }}>
          {hhmm(row.timestamp)}
        </span>
      )}

      {/* The spine. Law 11 — the dot is decoration; the status is stated in
          words on the row itself, never by colour alone. */}
      <span aria-hidden style={{ display: 'grid', gridTemplateRows: 'auto 1fr', justifyItems: 'center', height: '100%' }}>
        <span
          style={{
            marginTop: 13,
            width: 9,
            height: 9,
            borderRadius: '50%',
            background: failed ? 'var(--danger)' : 'var(--nav-active-accent)',
            flexShrink: 0,
          }}
        />
        {!last && <span style={{ width: 1, height: '100%', background: 'var(--border)' }} />}
      </span>

      <div style={{ padding: '10px 0 14px', minWidth: 0 }}>
        {phone && (
          <span className="figure" style={{ display: 'block', fontSize: 'var(--t-th)', color: 'var(--muted)' }}>
            {hhmm(row.timestamp)}
          </span>
        )}
        <p style={{ margin: 0, fontSize: 'var(--t-meta)', color: 'var(--text)', lineHeight: 1.55 }}>
          <strong style={{ fontWeight: 700 }}>{row.user}</strong> {row.action.toLowerCase()}
          {target && (
            <>
              {' '}
              <span className="identifier" style={{ fontWeight: 600 }}>
                {target}
              </span>
            </>
          )}
          <span style={{ color: 'var(--text2)' }}> in {row.where}</span>
        </p>
        <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginTop: 5, flexWrap: 'wrap' }}>
          <Tag icon="queues" text={row.module} />
          {/* Law 11 — icon + label + colour. Success is not shown as a bare
              green dot, and failure is never colour alone. */}
          <Tag icon={failed ? 'error' : 'check'} text={row.status} tone={failed ? 'danger' : 'neutral'} />
          {showNetwork && (
            <span className="figure" style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>
              {row.ip} — {row.location}
            </span>
          )}
        </div>
      </div>
    </li>
  )
}

function Tag({ icon, text, tone = 'neutral' }: { icon: 'queues' | 'error' | 'check'; text: string; tone?: 'neutral' | 'danger' }) {
  return (
    <span
      style={{
        display: 'inline-flex',
        alignItems: 'center',
        gap: 4,
        height: 20,
        padding: '0 7px',
        borderRadius: 'var(--r-badge)',
        background: tone === 'danger' ? 'var(--st-danger-bg)' : 'var(--card2)',
        color: tone === 'danger' ? 'var(--st-danger-fg)' : 'var(--text2)',
        fontSize: 'var(--t-th)',
        fontWeight: 700,
      }}
    >
      <Icon name={icon} size={10} />
      {text}
    </span>
  )
}

function Filter({
  label,
  value,
  onChange,
  options,
}: {
  label: string
  value: string
  onChange: (v: string) => void
  options: readonly string[]
}) {
  return (
    <label style={{ display: 'flex', flexDirection: 'column', gap: 5, minWidth: 0 }}>
      <span style={{ fontSize: 'var(--t-th)', fontWeight: 700, textTransform: 'uppercase', letterSpacing: '0.04em', color: 'var(--muted)' }}>
        {label}
      </span>
      <select value={value} onChange={(e) => onChange(e.target.value)} style={selectStyle}>
        <option value={ALL}>All {label.toLowerCase()}s</option>
        {options.map((o) => (
          <option key={o} value={o}>
            {label === 'Date' ? formatAd(new Date(o)) : o}
          </option>
        ))}
      </select>
    </label>
  )
}

/** Law 7 — stored AD/UTC, rendered here. */
function hhmm(iso: string): string {
  return new Date(iso).toISOString().slice(11, 16)
}

const selectStyle: CSSProperties = {
  width: '100%',
  /* Law 15 — 44×44 at every width. */
  minHeight: 44,
  padding: '8px 12px',
  borderRadius: 'var(--r-input)',
  border: '1px solid var(--input-border)',
  background: 'var(--input-bg)',
  color: 'var(--text)',
  fontSize: 'var(--t-body)',
  fontFamily: 'inherit',
}
</file>

