}
/* Unused slots consume no space; live slots retain canonical ordering. */
.app-global-header__action-slot:not(:has(button, a)) { display: none; }
.app-global-header__action-slot--secondary { gap: 8px; }
.app-global-header__action-slot--filters { width: 44px; flex-basis: 44px; }
