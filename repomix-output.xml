  text-decoration: none;
}

.movement-card__booking-link { grid-column: 1; }
.movement-card__client-link { grid-column: 2; }
.movement-card__schedule--pickup { grid-column: 3; }
.movement-card__schedule--return { grid-column: 4; }
.movement-card__status-action { grid-column: 5; }

.movement-card__booking-link {
