  'Picked Up': UNITS.filter((u) => u.state === 'Picked Up').length,
  Returned: UNITS.filter((u) => u.state === 'Returned').length,
  Missing: UNITS.filter((u) => u.state === 'Missing').length,
  Damaged: UNITS.filter((u) => u.condition === 'Damaged').length,
