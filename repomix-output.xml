    draftId,
    draftBookingNo,
    draftLoading,
    draftLoadError,
    setSavedDraftFingerprint,
    cancelIntent,
    setCancelIntent,
    quoteLoading,
    setQuoteReload,
    quoteDirty,
    confirmKey,
    draftBookingKey,
    draftData,
    draftHasUnsavedChanges,
    handleExit,
    localDraftOffer,
    restoreLocalDraft,
    discardLocalDraft,
    exitAndForget,
    retryLoadDraft,
