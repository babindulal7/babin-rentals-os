  padding: 0.875rem 1rem;
  border-radius: var(--r-card, 10px);
  border: 1px solid rgba(234, 179, 8, 0.2);
  font-size: var(--t-meta, 0.8125rem);
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
}

