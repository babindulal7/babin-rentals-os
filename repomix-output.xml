                        style={{
                          outline:
                            scanPulse === 'success'
                              ? '2px solid var(--success, #22c55e)'
                              : scanPulse === 'error'
                              ? '2px solid var(--danger, #ef4444)'
                              : 'none',
                          boxShadow:
                            scanPulse === 'success'
                              ? '0 0 12px color-mix(in srgb, var(--success, #22c55e) 40%, transparent)'
                              : scanPulse === 'error'
                              ? '0 0 12px color-mix(in srgb, var(--danger, #ef4444) 40%, transparent)'
                              : 'none',
                          transition: 'outline 0.15s ease-in-out, box-shadow 0.15s ease-in-out',
                        }}
                      >

                        <span className="floor-scanner-icon">
                          <Icon name="barcode" size={18} />
                        </span>
                        <Input
                          type="text"
                          value={ambientBarcode}
                          onChange={(e) => setAmbientBarcode(e.target.value)}
                          placeholder="Scan or type barcode/serial number and press Enter…"
                          aria-label="Scan or type barcode"
                          className="floor-scanner-input"
                        />
                        <span className="floor-scanner-enter-hint"><kbd>↵</kbd> Enter</span>
                      </div>
                      <Button type="submit" variant="secondary" style={{ minHeight: 44, padding: '0 16px', fontWeight: 600 }}>
                        {/* RULING 2026-09-23: one filled primary per workspace, and it is the completion gate (Complete Packing). The ambient scan-into-mark control is auxiliary — secondary, not primary. */}
                        Mark Packed
                      </Button>
                      <Button
                        type="button"
                        variant="secondary"
                        onClick={() => setShowScanner(true)}
                        style={{ minHeight: 44, display: 'inline-flex', alignItems: 'center', gap: 6, fontWeight: 600 }}
                      >
                        <Icon name="camera" size={16} />
                        Camera
                      </Button>
                    </form>
                  </div>
                  <div style={{ display: 'flex', gap: 7, padding: '9px 12px', borderBottom: '1px solid var(--border)', flexWrap: 'wrap', alignItems: 'center' }}>
                    <input
                      value={queryInput}
                      onChange={(e) => setQueryInput(e.target.value)}
                      onKeyDown={(e) => {
                        if (e.key === 'Enter') {
                          setQuery(queryInput)
                        }
