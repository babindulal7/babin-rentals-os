import { useState, useEffect, useMemo, useCallback } from 'react'
import { Modal } from '../../../components/ui/Modal'
import { Button } from '../../../components/ui/Button'
import Icon from '../../../components/ui/Icon'
import { completeReturn } from '../../../actions/rentals/returnRental'
import { fetchFloorBooking, type FloorBooking } from '../../../lib/queries/bookings'
import type { FloorLineInput } from '../../../actions/rentals/floorVerb'
import type { ItemCondition, NotReturnedDecision } from '../../../types/database'
import { useAuth } from '../../../lib/auth'
import { canPerformOperations } from '../../../lib/rbac'
import { newClientUuid, supabase } from '../../../lib/supabase'
import { useToast } from '../../../components/ui/Toast'
import {
  playScanSuccess,
  playScanError,
  playCaseComplete,
  playDamageAlert,
} from '../../../lib/acousticFeedback'

interface FastReturnModalProps {
  isOpen: boolean
  onClose: () => void
  onSuccess: (bookingId: string) => void
  initialBookingRef?: string
}

interface ActiveBookingOption {
  id: string
  booking_no: string
  client_name?: string | undefined
  starts_at?: string | undefined
  ends_at?: string | undefined
  stage: string
}

interface ReturnItemState {
  key: string
  lineId: string
  unitId: string | null
  assetId: string | null
  name: string
  serial: string | null
  qty: number
  alreadyReturned: boolean
  selected: boolean
  condition: ItemCondition
  missingReason: string
  missingDecision: NotReturnedDecision
}

const CONDITIONS: readonly ItemCondition[] = ['Good', 'Fair', 'Damaged', 'Lost']
const DECISIONS: readonly NotReturnedDecision[] = [
  'Still expected',
  'Charge replacement',
  'Insurance claim',
  'Write off',
]

function worstCondition(conds: readonly ItemCondition[]): ItemCondition {
  let worst: ItemCondition = 'Good'
  for (const c of conds) {
    if (CONDITIONS.indexOf(c) > CONDITIONS.indexOf(worst)) worst = c
  }
  return worst
}

export function FastReturnModal({
  isOpen,
  onClose,
  onSuccess,
  initialBookingRef = '',
}: FastReturnModalProps) {
  const { user } = useAuth()
  const { showSuccessToast } = useToast()
  const isAuthorized = user ? canPerformOperations(user.role) : false

  const [bookingRef, setBookingRef] = useState(initialBookingRef)
  const [activeBookings, setActiveBookings] = useState<ActiveBookingOption[]>([])
  const [loadedBooking, setLoadedBooking] = useState<FloorBooking | null>(null)
  const [items, setItems] = useState<ReturnItemState[]>([])
  const [loadingBooking, setLoadingBooking] = useState(false)
  const [submitting, setSubmitting] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [notes, setNotes] = useState('')

  // 1. Fetch active bookings strictly in 'On Rent' stage
  useEffect(() => {
    if (!isOpen) return
    setBookingRef(initialBookingRef)
    setLoadedBooking(null)
    setItems([])
    setError(null)
    setNotes('')

    let cancelled = false
    supabase
      .from('bookings')
      .select('id, booking_no, starts_at, ends_at, stage, client_id, clients:client_id (name)')
      .eq('stage', 'On Rent')
      .is('cancelled_at', null)
      .order('ends_at', { ascending: true })
      .limit(10)
      .then(({ data, error: err }) => {
        if (cancelled) return
        if (err || !data) return
        setActiveBookings(
          (data as unknown as Array<{
            id: string
            booking_no: string
            starts_at: string
            ends_at: string
            stage: string
            clients?: { name?: string } | null
          }>).map((b) => ({
            id: b.id,
            booking_no: b.booking_no,
            client_name: b.clients?.name,
            starts_at: b.starts_at,
            ends_at: b.ends_at,
            stage: b.stage,
          }))
        )
      })

    return () => {
      cancelled = true
    }
  }, [isOpen, initialBookingRef])

  // 2. Load booking lines & units when a booking is targeted
  const loadBookingDetails = useCallback(async (refToLoad: string) => {
    const trimmed = refToLoad.trim()
    if (!trimmed) {
      setLoadedBooking(null)
      setItems([])
      return
    }

    setLoadingBooking(true)
    setError(null)

    try {
      const booking = await fetchFloorBooking(trimmed)
      if (!booking) {
        setLoadedBooking(null)
        setItems([])
        setError(`Booking "${trimmed}" was not found.`)
        return
      }

      if (booking.isCancelled) {
        setLoadedBooking(null)
        setItems([])
        setError(`Booking ${booking.bookingNo} is cancelled — no return can be recorded against it.`)
        return
      }

      if (booking.stage !== 'On Rent') {
        setLoadedBooking(null)
        setItems([])
        setError(
          `Booking ${booking.bookingNo} is in "${booking.stage}" stage. Fast Return only accepts bookings that are currently On Rent.`
        )
        return
      }

      if (booking.lines.length === 0) {
        setLoadedBooking(null)
        setItems([])
        setError(`Booking ${booking.bookingNo} has no rental equipment lines to return.`)
        return
      }

      // Build checklist rows
      const rows: ReturnItemState[] = []
      for (const line of booking.lines) {
        const lineName = line.productName ?? line.description ?? `${line.lineType} line`
        if (line.unitsPresence === 'present' && line.units.length > 0) {
          line.units.forEach((u, i) => {
            const already = u.unitState === 'Returned'
            rows.push({
              key: u.id,
              lineId: line.id,
              unitId: u.id,
              assetId: u.assetId,
              name: line.units.length > 1 ? `${lineName} · unit ${i + 1}` : lineName,
              serial: u.serial ?? u.assetTag,
              qty: 1,
              alreadyReturned: already,
              selected: !already,
              condition: 'Good',
              missingReason: '',
              missingDecision: 'Still expected',
            })
          })
        } else {
          rows.push({
            key: `line:${line.id}`,
            lineId: line.id,
            unitId: null,
            assetId: null,
            name: lineName,
            serial: null,
            qty: line.qty,
            alreadyReturned: false,
            selected: true,
            condition: 'Good',
            missingReason: '',
            missingDecision: 'Still expected',
          })
        }
      }

      setLoadedBooking(booking)
      setItems(rows)
    } catch (err: unknown) {
      setLoadedBooking(null)
      setItems([])
      const message = err instanceof Error ? err.message : 'Failed to load booking equipment.'
      setError(message)
    } finally {
      setLoadingBooking(false)
    }
  }, [])

  // Auto-load if initialBookingRef is provided
  useEffect(() => {
    if (isOpen && initialBookingRef.trim()) {
      void loadBookingDetails(initialBookingRef)
    }
  }, [isOpen, initialBookingRef, loadBookingDetails])

  const handleSelectBooking = (selectedNo: string) => {
    setBookingRef(selectedNo)
    void loadBookingDetails(selectedNo)
  }

  const toggleItemSelection = (key: string) => {
    setItems((prev) => {
      const target = prev.find((item) => item.key === key)
      const nextSelected = target ? !target.selected : false
      if (nextSelected) {
        playScanSuccess()
      } else {
        playDamageAlert()
      }
      return prev.map((item) => (item.key === key ? { ...item, selected: nextSelected } : item))
    })
  }

  const updateItemCondition = (key: string, condition: ItemCondition) => {
    if (condition === 'Damaged' || condition === 'Lost') {
      playDamageAlert()
    } else {
      playScanSuccess()
    }
    setItems((prev) =>
      prev.map((item) => (item.key === key ? { ...item, condition } : item))
    )
  }

  const updateItemMissingReason = (key: string, missingReason: string) => {
    setItems((prev) =>
      prev.map((item) => (item.key === key ? { ...item, missingReason } : item))
    )
  }

  const updateItemMissingDecision = (key: string, missingDecision: NotReturnedDecision) => {
    setItems((prev) =>
      prev.map((item) => (item.key === key ? { ...item, missingDecision } : item))
    )
  }

  const unreturnedItems = useMemo(() => items.filter((i) => !i.alreadyReturned), [items])
  const selectedCount = useMemo(() => unreturnedItems.filter((i) => i.selected).length, [unreturnedItems])

  const handleSubmit = async (e?: React.FormEvent) => {
    if (e) e.preventDefault()
    if (!isAuthorized) {
      setError('You do not have permission to perform rental returns.')
      return
    }

    if (!loadedBooking) {
      setError('Please load and select an On Rent booking first.')
      return
    }

    if (unreturnedItems.length === 0) {
      setError('All equipment on this booking has already been returned.')
      return
    }

    // Check validation on missing items
    for (const item of unreturnedItems) {
      if (!item.selected) {
        if (item.missingReason.trim().length < 10) {
          setError(
            `Missing item "${item.name}" requires a reason of at least 10 characters.`
          )
          return
        }
        if (!item.missingDecision) {
          setError(`Missing item "${item.name}" requires a triage decision.`)
          return
        }
      }
    }

    // Build FloorLineInput[]
    const payload: FloorLineInput[] = []
    const extraNotes: string[] = []

    for (const line of loadedBooking.lines) {
      const lineItems = items.filter((i) => i.lineId === line.id && !i.alreadyReturned)
      if (lineItems.length === 0) continue

      const returned = lineItems.filter((i) => i.selected)
      const missing = lineItems.filter((i) => !i.selected)

      if (returned.length === 0 && missing.length === 0) continue

      if (returned.length === 0) {
        // Line entirely missing
        const decisions = [...new Set(missing.map((m) => m.missingDecision))]
        payload.push({
          bookingLineId: line.id,
          outcome: 'missing',
          reason: missing.map((m) => m.missingReason.trim()).join('; '),
          notReturnedDecision: decisions[0] ?? 'Still expected',
        })
      } else {
        // Line returned (or partially returned)
        const scannedAssets = returned.filter((r) => r.assetId !== null)
        const worst = worstCondition(returned.map((r) => r.condition))
        const returnedQty = returned.reduce((sum, r) => sum + r.qty, 0)

        payload.push({
          bookingLineId: line.id,
          outcome: 'done',
          ...(scannedAssets.length > 0
            ? {
                unitIds: scannedAssets.map((r) => r.assetId as string),
                serials: scannedAssets.map((r) => r.serial ?? ''),
              }
            : {}),
          qty: returnedQty,
          condition: worst,
        })

        if (missing.length > 0) {
          extraNotes.push(
            `Line ${line.productName ?? line.description}: ${missing.length} unit(s) not returned: ` +
              missing.map((m) => `${m.name} (${m.missingDecision}: ${m.missingReason.trim()})`).join(', ')
          )
        }
      }
    }

    if (payload.length === 0) {
      setError('No equipment items have been selected for return or triage.')
      return
    }

    setSubmitting(true)
    setError(null)

    const finalNotes = [notes.trim(), ...extraNotes].filter(Boolean).join('\n')

    try {
      await completeReturn(
        {
          rentalId: loadedBooking.id,
          lines: payload,
          clientUuid: newClientUuid(),
          occurredAt: new Date().toISOString(),
          ...(finalNotes ? { notes: finalNotes } : {}),
        },
        user ? { userId: user.id, role: user.role } : undefined
      )

      playCaseComplete()
      showSuccessToast('Return Completed', `Rental ${loadedBooking.bookingNo} returned successfully`)
      onSuccess(loadedBooking.id)
      onClose()
    } catch (err: unknown) {
      playScanError()
      const message = err instanceof Error ? err.message : 'Failed to complete return.'
      setError(message)
    } finally {
      setSubmitting(false)
    }
  }

  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      title="Fast Check-in / Return"
      size="md"
    >
      <form onSubmit={handleSubmit} style={{ display: 'grid', gap: 'var(--sp-md)' }}>
        <p style={{ margin: 0, fontSize: 'var(--t-body)', color: 'var(--text2)' }}>
          Quickly check in equipment for a booking currently <strong>On Rent</strong>.
        </p>

        {!isAuthorized && (
          <div
            role="alert"
            style={{
              padding: '10px 14px',
              borderRadius: 'var(--r-sm)',
              /* §21 / ErrorBanner shape: solid status pair, white on danger.
                 `--danger-bg` aliases to solid --st-danger-bg while
                 `--danger-border`/`#dc2626` were light-theme literals — the
                 old triple rendered red text on a solid red fill. */
              background: 'var(--st-danger-bg)',
              border: '1px solid var(--st-danger-bg)',
              color: 'var(--st-danger-fg)',
              fontSize: 'var(--t-meta)',
              display: 'flex',
              alignItems: 'center',
              gap: 8,
            }}
          >
            <Icon name="alert_triangle" size={16} />
            <span>You do not have permission to perform rental returns.</span>
          </div>
        )}

        {error && (
          <div
            role="alert"
            style={{
              padding: '10px 14px',
              borderRadius: 'var(--r-sm)',
              /* §21 / ErrorBanner shape: solid status pair, white on danger.
                 `--danger-bg` aliases to solid --st-danger-bg while
                 `--danger-border`/`#dc2626` were light-theme literals — the
                 old triple rendered red text on a solid red fill. */
              background: 'var(--st-danger-bg)',
              border: '1px solid var(--st-danger-bg)',
              color: 'var(--st-danger-fg)',
              fontSize: 'var(--t-meta)',
              display: 'flex',
              alignItems: 'center',
              gap: 8,
            }}
          >
            <Icon name="alert_triangle" size={16} />
            <span>{error}</span>
          </div>
        )}

        <div>
          <label
            htmlFor="fast-return-booking-ref"
            style={{ display: 'block', fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)', marginBottom: 6 }}
          >
            Booking number
          </label>
          <div style={{ display: 'flex', gap: 8 }}>
            <div style={{ position: 'relative', flex: 1 }}>
              <input
                id="fast-return-booking-ref"
                type="text"
                autoFocus
                placeholder="e.g. B-00042"
                value={bookingRef}
                onChange={(e) => setBookingRef(e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === 'Enter') {
                    e.preventDefault()
                    void loadBookingDetails(bookingRef)
                  }
                }}
                style={{
                  width: '100%',
                  minHeight: 'var(--tap)',
                  padding: '0 12px',
                  borderRadius: 'var(--r-input)',
                  border: '1px solid var(--input-border)',
                  background: 'var(--input-bg)',
                  color: 'var(--text)',
                  fontSize: 'var(--t-body)',
                  fontFamily: 'inherit',
                  fontVariantNumeric: 'tabular-nums',
                }}
              />
            </div>
            <Button
              type="button"
              onClick={() => void loadBookingDetails(bookingRef)}
              disabled={loadingBooking || !bookingRef.trim()}
              style={{ minHeight: 'var(--tap)', flexShrink: 0 }}
            >
              {loadingBooking ? 'Loading…' : 'Find Booking'}
            </Button>
          </div>
        </div>

        {/* Quick select from currently active On Rent bookings */}
        {activeBookings.length > 0 && !loadedBooking && (
          <div>
            <span style={{ display: 'block', fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text2)', marginBottom: 6 }}>
              Recent On-Rent Bookings
            </span>
            <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6 }}>
              {activeBookings.map((b) => (
                <button
                  key={b.id}
                  type="button"
                  className="tap"
                  onClick={() => handleSelectBooking(b.booking_no)}
                  style={{
                    display: 'inline-flex',
                    alignItems: 'center',
                    gap: 6,
                    minHeight: 44,
                    padding: '0 12px',
                    borderRadius: 'var(--r-btn, 8px)',
                    border: bookingRef === b.booking_no ? '1px solid var(--primary)' : '1px solid var(--border)',
                    background: bookingRef === b.booking_no ? 'var(--hover-card)' : 'transparent',
                    color: bookingRef === b.booking_no ? 'var(--primary)' : 'var(--text)',
                    fontSize: 'var(--t-meta)',
                    cursor: 'pointer',
                    fontFamily: 'inherit',
                  }}
                >
                  <strong>{b.booking_no}</strong>
                  {b.client_name && <span style={{ color: 'var(--muted)' }}>· {b.client_name}</span>}
                  <span style={{ fontSize: '11px', opacity: 0.8 }}>(On Rent)</span>
                </button>
              ))}
            </div>
          </div>
        )}

        {/* Loaded booking equipment checklist */}
        {loadedBooking && (
          <div style={{ border: '1px solid var(--border)', borderRadius: 'var(--r-sm)', padding: 12, background: 'var(--card)' }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 10, flexWrap: 'wrap', gap: 6 }}>
              <div>
                <strong style={{ fontSize: 'var(--t-ui)', color: 'var(--text)' }}>
                  {loadedBooking.bookingNo}
                </strong>
                {loadedBooking.clientName && (
                  <span style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', marginLeft: 8 }}>
                    · {loadedBooking.clientName}
                  </span>
                )}
              </div>
              <span style={{ fontSize: 'var(--t-meta)', color: 'var(--muted)' }}>
                {selectedCount} of {unreturnedItems.length} items to return
              </span>
            </div>

            <div style={{ maxHeight: 240, overflowY: 'auto', display: 'grid', gap: 8, paddingRight: 4 }}>
              {items.map((item) => (
                <div
                  key={item.key}
                  style={{
                    padding: '8px 10px',
                    borderRadius: 'var(--r-sm)',
                    background: item.alreadyReturned
                      ? 'var(--card2)'
                      : item.selected
                      ? 'var(--nav-active-bg)'
                      : 'var(--danger-soft)',
                    border: `1px solid ${
                      item.alreadyReturned
                        ? 'var(--border)'
                        : item.selected
                        ? 'var(--border)'
                        : 'color-mix(in srgb, var(--danger) 35%, transparent)'
                    }`,
                  }}
                >
                  <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 8, flexWrap: 'wrap' }}>
                    <label
                      style={{
                        display: 'flex',
                        alignItems: 'center',
                        gap: 8,
                        cursor: item.alreadyReturned ? 'default' : 'pointer',
                        flex: 1,
                        minWidth: 160,
                      }}
                    >
                      <input
                        type="checkbox"
                        aria-label={`Select ${item.name} for return`}
                        disabled={item.alreadyReturned}
                        checked={item.selected}
                        onChange={() => toggleItemSelection(item.key)}
                        style={{ width: 18, height: 18, accentColor: 'var(--primary)', cursor: 'pointer' }}
                      />
                      <span style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>
                        {item.name}
                        {item.serial && (
                          <span style={{ color: 'var(--muted)', fontWeight: 400, marginLeft: 6 }}>
                            ({item.serial})
                          </span>
                        )}
                        {item.qty > 1 && (
                          <span style={{ color: 'var(--muted)', fontWeight: 400, marginLeft: 6 }}>
                            × {item.qty}
                          </span>
                        )}
                      </span>
                    </label>

                    {item.alreadyReturned ? (
                      <span style={{ fontSize: '11px', color: 'var(--muted)' }}>Already Returned</span>
                    ) : item.selected ? (
                      <select
                        value={item.condition}
                        onChange={(e) => updateItemCondition(item.key, e.target.value as ItemCondition)}
                        aria-label={`Condition for ${item.name}`}
                        style={{
                          minHeight: 38,
                          padding: '0 8px',
                          fontSize: 'var(--t-meta, 13px)',
                          borderRadius: 'var(--r-sm)',
                          border: '1px solid var(--input-border)',
                          background: 'var(--input-bg)',
                          color: 'var(--text)',
                          fontWeight: 500,
                        }}
                      >
                        {CONDITIONS.map((c) => (
                          <option key={c} value={c}>
                            {c} Condition
                          </option>
                        ))}
                      </select>
                    ) : (
                      <span style={{ fontSize: '11px', fontWeight: 600, color: 'var(--danger)' }}>
                        Not Returned
                      </span>
                    )}
                  </div>

                  {/* If marked unreturned / missing, require reason and decision */}
                  {!item.alreadyReturned && !item.selected && (
                    <div style={{ marginTop: 8, display: 'grid', gap: 6, paddingLeft: 26 }}>
                      <input
                        type="text"
                        aria-label={`Reason missing for ${item.name}`}
                        placeholder="Reason missing (min 10 chars, e.g. Left on site)..."
                        value={item.missingReason}
                        onChange={(e) => updateItemMissingReason(item.key, e.target.value)}
                        style={{
                          width: '100%',
                          minHeight: 38,
                          padding: '0 10px',
                          fontSize: 'var(--t-meta, 13px)',
                          borderRadius: 'var(--r-input)',
                          border: '1px solid var(--danger)',
                          background: 'var(--input-bg)',
                          color: 'var(--text)',
                        }}
                      />
                      <select
                        value={item.missingDecision}
                        onChange={(e) =>
                          updateItemMissingDecision(item.key, e.target.value as NotReturnedDecision)
                        }
                        aria-label={`Decision for ${item.name}`}
                        style={{
                          width: '100%',
                          minHeight: 38,
                          padding: '0 10px',
                          fontSize: 'var(--t-meta, 13px)',
                          borderRadius: 'var(--r-input)',
                          border: '1px solid var(--input-border)',
                          background: 'var(--input-bg)',
                          color: 'var(--text)',
                        }}
                      >
                        {DECISIONS.map((d) => (
                          <option key={d} value={d}>
                            {d}
                          </option>
                        ))}
                      </select>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        <div>
          <label
            htmlFor="fast-return-notes"
            style={{ display: 'block', fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)', marginBottom: 6 }}
          >
            Check-in / Condition Notes (optional)
          </label>
          <textarea
            id="fast-return-notes"
            rows={2}
            placeholder="Equipment returned in clean condition, all accessories verified."
            value={notes}
            onChange={(e) => setNotes(e.target.value)}
            style={{
              width: '100%',
              padding: '8px 12px',
              borderRadius: 'var(--r-input)',
              border: '1px solid var(--input-border)',
              background: 'var(--input-bg)',
              color: 'var(--text)',
              fontSize: 'var(--t-meta)',
              fontFamily: 'inherit',
              resize: 'vertical',
            }}
          />
        </div>

        <div
          style={{
            display: 'flex',
            justifyContent: 'flex-end',
            gap: 'var(--sp-sm)',
            marginTop: 'var(--sp-sm)',
            borderTop: '1px solid var(--border)',
            paddingTop: 'var(--sp-md)',
          }}
        >
          <Button onClick={onClose} disabled={submitting}>
            Cancel
          </Button>
          <button
            type="submit"
            className="press tap"
            disabled={submitting || !loadedBooking || !isAuthorized}
            style={{
              display: 'inline-flex',
              alignItems: 'center',
              gap: 8,
              minHeight: 44,
              padding: '0 18px',
              borderRadius: 'var(--r-btn)',
              border: '1px solid transparent',
              background: submitting || !loadedBooking || !isAuthorized ? 'var(--disabled)' : 'var(--primary)',
              color: submitting || !loadedBooking || !isAuthorized ? 'var(--muted)' : 'var(--on-brand)',
              fontFamily: 'inherit',
              fontSize: 'var(--t-ui)',
              fontWeight: 700,
              cursor: submitting || !loadedBooking || !isAuthorized ? 'not-allowed' : 'pointer',
            }}
          >
            <Icon name="return_arrow" size={15} />
            <span>{submitting ? 'Checking in…' : 'Complete Fast Return'}</span>
          </button>
        </div>
      </form>
    </Modal>
  )
}
</file>

<file path="src/modules/rentals/modals/ReturnSettlementModal.tsx">
import { useState, useMemo } from 'react'
import { Modal } from '../../../components/ui/Modal'
import { Button } from '../../../components/ui/Button'
import Icon from '../../../components/ui/Icon'
import { formatMoney, rupees, grouped, type Paisa } from '../../../lib/money'
import {
  lateFee,
  formatOverage,
  bandExplanation,
  validateWaiver,
  WAIVER_REASON_MIN,
  type LateFeeResult,
} from '../../../lib/lateFee'
import { returnReceipt } from '../../../lib/whatsappTemplates'
import { buildWaLink, normalisePhone, NO_PHONE_REASON } from '../../../lib/whatsapp'
import { useAuth } from '../../../lib/auth'
import { canApproveLateFeeWaiver } from '../../../lib/rbac'

export interface ReturnSettlementDamageItem {
  key: string
  name: string
  serial?: string | null | undefined
  condition?: string | undefined
  isMissing?: boolean | undefined
  notes?: string | undefined
}

export interface ReturnSettlementSummary {
  bookingNo: string
  clientName: string
  totalItems: number
  damagedCount: number
  missingCount: number
  depositHeldPaisa: Paisa
  lateFeeSuggestedPaisa: Paisa
  lateFeeChargedPaisa: Paisa
  lateFeeWaiver?: { staffName: string; reason: string; approverName: string } | undefined
  damageChargesPaisa: Paisa
  totalPenaltiesPaisa: Paisa
  depositRefundPaisa: Paisa
  balanceDuePaisa: Paisa
  settledAtIso: string
}

export interface ReturnSettlementModalProps {
  isOpen: boolean
  onClose: () => void
  bookingNo: string
  clientName: string
  clientPhone?: string | null | undefined
  /** Security deposit currently held (Law 5 liability). */
  depositHeldPaisa?: Paisa | null | undefined
  scheduledReturnIso: string
  actualReturnIso?: string | undefined
  /** 1-day rate in Paisa for late fee calculation */
  dayRatePaisa?: Paisa | null | undefined
  dayRateBasis?: string | undefined
  totalItemCount: number
  /** Damaged or missing line items triaged during return inspection */
  itemsWithIssues?: ReturnSettlementDamageItem[] | undefined
  onConfirmSettlement?: ((summary: ReturnSettlementSummary) => Promise<void> | void) | undefined
}

export function ReturnSettlementModal({
  isOpen,
  onClose,
  bookingNo,
  clientName,
  clientPhone,
  depositHeldPaisa,
  scheduledReturnIso,
  actualReturnIso,
  dayRatePaisa,
  dayRateBasis = 'Standard 1-Day Equipment Rate',
  totalItemCount,
  itemsWithIssues = [],
  onConfirmSettlement,
}: ReturnSettlementModalProps) {
  const { user } = useAuth()
  const resolvedDayRate = dayRatePaisa ?? rupees(0)

  // 1. Damage charge estimates in whole Rupees (Law 1: converted to Paisa via rupees())
  const [damageEstimates, setDamageEstimates] = useState<Record<string, number>>({})

  // 2. Late Fee State
  const actualReturnDate = useMemo(
    () => (actualReturnIso ? new Date(actualReturnIso) : new Date()),
    [actualReturnIso],
  )
  const scheduledReturnDate = useMemo(
    () => new Date(scheduledReturnIso),
    [scheduledReturnIso],
  )

  const lateResult = useMemo<LateFeeResult>(() => {
    return lateFee({
      scheduledReturnAt: scheduledReturnDate,
      actualReturnAt: actualReturnDate,
      dayRatePaisa: resolvedDayRate,
    })
  }, [scheduledReturnDate, actualReturnDate, resolvedDayRate])

  const [lateDecision, setLateDecision] = useState<'Apply' | 'Waive'>(() =>
    lateResult.feePaisa > 0 ? 'Apply' : 'Apply',
  )
  const [waiverReason, setWaiverReason] = useState('')
  const [waiverError, setWaiverError] = useState<string | null>(null)
  const [submitting, setSubmitting] = useState(false)
  const [settled, setSettled] = useState(false)

  const mayApprove = user ? canApproveLateFeeWaiver(user.role) : false
  const staffName = user?.name?.trim() || 'Floor Staff'
  const approverName = user?.name?.trim() || ''

  // Damage charges total
  const totalDamagePaisa = useMemo<Paisa>(() => {
    const totalRupees = Object.values(damageEstimates).reduce((sum, val) => sum + (Number(val) || 0), 0)
    return rupees(Math.max(0, totalRupees))
  }, [damageEstimates])

  // Late fee charged
  const lateFeeChargedPaisa = useMemo<Paisa>(() => {
    if (lateResult.band === 'None') return rupees(0)
    return lateDecision === 'Apply' ? lateResult.feePaisa : rupees(0)
  }, [lateResult, lateDecision])

  // Total Penalties (Late fee + Damages) — Pure integer Paisa arithmetic (Foundation §2.3)
  const totalPenaltiesPaisa = useMemo<Paisa>(() => {
    return ((lateFeeChargedPaisa || 0) + (totalDamagePaisa || 0)) as Paisa
  }, [lateFeeChargedPaisa, totalDamagePaisa])

  // Security Deposit Reconciliation (Law 5)
  const depositHeld = depositHeldPaisa ?? (0 as Paisa)

  const { depositRefundPaisa, balanceDuePaisa } = useMemo(() => {
    const held = depositHeld
    const penalties = totalPenaltiesPaisa

    if (held >= penalties) {
      return {
        depositRefundPaisa: (held - penalties) as Paisa,
        balanceDuePaisa: 0 as Paisa,
      }
    } else {
      return {
        depositRefundPaisa: 0 as Paisa,
        balanceDuePaisa: (penalties - held) as Paisa,
      }
    }
  }, [depositHeld, totalPenaltiesPaisa])

  const damagedCount = itemsWithIssues.filter((i) => !i.isMissing).length
  const missingCount = itemsWithIssues.filter((i) => i.isMissing).length

  // WhatsApp return receipt message
  const waBody = useMemo(() => {
    return returnReceipt(
      {
        clientName,
        bookingNo,
        startIso: scheduledReturnIso,
        endIso: actualReturnDate.toISOString(),
        itemCount: totalItemCount,
        hasDamagedOrLost: itemsWithIssues.length > 0,
        damageCount: damagedCount > 0 ? damagedCount : undefined,
        lostCount: missingCount > 0 ? missingCount : undefined,
        depositRefundPaisa,
        balanceDuePaisa,
        receiptUrl: null,
      },
      {
        businessName: 'Babin Rentals',
        businessPhone: '+977-9712052571',
      },
    )
  }, [
    clientName,
    bookingNo,
    scheduledReturnIso,
    actualReturnDate,
    totalItemCount,
    itemsWithIssues.length,
    damagedCount,
    missingCount,
    depositRefundPaisa,
    balanceDuePaisa,
  ])

  const waHref = useMemo(() => {
    return buildWaLink(clientPhone, waBody)
  }, [clientPhone, waBody])

  const phoneValid = normalisePhone(clientPhone) !== null

  const handleEstimateChange = (key: string, valStr: string) => {
    const parsed = parseInt(valStr.replace(/\D/g, ''), 10)
    setDamageEstimates((prev) => ({
      ...prev,
      [key]: isNaN(parsed) ? 0 : parsed,
    }))
  }

  const handleConfirm = async () => {
    if (lateDecision === 'Waive' && lateResult.feePaisa > 0) {
      const check = validateWaiver({
        staffName,
        reason: waiverReason,
        approverName,
      })
      if (!check.valid) {
        setWaiverError(check.error)
        return
      }
    }

    setWaiverError(null)
    setSubmitting(true)

    const summary: ReturnSettlementSummary = {
      bookingNo,
      clientName,
      totalItems: totalItemCount,
      damagedCount,
      missingCount,
      depositHeldPaisa: depositHeld,
      lateFeeSuggestedPaisa: lateResult.feePaisa,
      lateFeeChargedPaisa,
      lateFeeWaiver:
        lateDecision === 'Waive' && lateResult.feePaisa > 0
          ? {
              staffName,
              reason: waiverReason.trim(),
              approverName,
            }
          : undefined,
      damageChargesPaisa: totalDamagePaisa,
      totalPenaltiesPaisa,
      depositRefundPaisa,
      balanceDuePaisa,
      settledAtIso: new Date().toISOString(),
    }

    try {
      if (onConfirmSettlement) {
        await onConfirmSettlement(summary)
      }
      setSettled(true)
    } finally {
      setSubmitting(false)
    }
  }

  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      size="lg"
      title={`Return Settlement & Deposit Reconciliation · ${bookingNo}`}
      subtitle={`Client: ${clientName} · ${totalItemCount} total items inspected`}
      footer={
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', width: '100%', gap: 12 }}>
          <Button variant="secondary" onClick={onClose} style={{ minHeight: 44 }}>
            {settled ? 'Close' : 'Cancel'}
          </Button>

          <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
            {waHref ? (
              <a
                href={waHref}
                target="_blank"
                rel="noopener noreferrer"
                style={{
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: 6,
                  minHeight: 44,
                  padding: '0 14px',
                  borderRadius: 'var(--r-btn, 6px)',
                  background: '#25D366',
                  color: '#fff',
                  fontWeight: 600,
                  fontSize: 'var(--t-meta, 12px)',
                  textDecoration: 'none',
                }}
              >
                <Icon name="message" size={16} />
                Send Return Receipt
              </a>
            ) : (
              <button
                type="button"
                disabled
                title={NO_PHONE_REASON}
                style={{
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: 6,
                  minHeight: 44,
                  padding: '0 14px',
                  borderRadius: 'var(--r-btn, 6px)',
                  background: 'var(--card2)',
                  color: 'var(--muted)',
                  border: '1px solid var(--border)',
                  fontSize: 'var(--t-meta, 12px)',
                  cursor: 'not-allowed',
                }}
              >
                <Icon name="message" size={16} />
                WhatsApp Unavailable ({!phoneValid ? 'No Phone' : 'Blocked'})
              </button>
            )}

            {!settled && (
              <Button
                variant="primary"
                onClick={handleConfirm}
                disabled={submitting}
                style={{ minHeight: 44, padding: '0 18px', fontWeight: 600 }}
              >
                {submitting ? 'Recording Settlement…' : 'Record Settlement & Release'}
              </Button>
            )}
          </div>
        </div>
      }
    >
      <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
        {settled && (
          <div
            role="status"
            style={{
              padding: '12px 14px',
              borderRadius: 'var(--r-btn, 8px)',
              background: 'color-mix(in srgb, var(--success, #22c55e) 15%, var(--card))',
              border: '1px solid var(--success, #22c55e)',
              display: 'flex',
              alignItems: 'center',
              gap: 10,
              color: 'var(--success-text, #22c55e)',
              fontWeight: 600,
              fontSize: 'var(--t-ui, 13px)',
            }}
          >
            <Icon name="check" size={18} />
            <span>Return settlement recorded. Deposit and penalty ledgers reconciled successfully.</span>
          </div>
        )}

        {/* ── SECTION 1: DEPOSIT & CHARGES SUMMARY TILES ── */}
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(180px, 1fr))', gap: 12 }}>
          {/* Security Deposit Held */}
          <div
            style={{
              padding: 12,
              borderRadius: 'var(--r-btn, 8px)',
              background: 'var(--card2)',
              border: '1px solid var(--border)',
            }}
          >
            <div style={{ fontSize: 'var(--t-meta, 11px)', color: 'var(--muted)', textTransform: 'uppercase', letterSpacing: '0.04em' }}>
              Security Deposit Held
            </div>
            <div className="figure" style={{ fontSize: 'var(--t-h3, 20px)', fontWeight: 700, color: 'var(--text)', marginTop: 4 }}>
              {formatMoney(depositHeld)}
            </div>
            <div style={{ fontSize: 'var(--t-meta, 11px)', color: 'var(--text2)', marginTop: 2 }}>
              {/* Liability (Law 5) */}Liability </div>
          </div>

          {/* Total Deductions / Penalties */}
          <div
            style={{
              padding: 12,
              borderRadius: 'var(--r-btn, 8px)',
              background: 'var(--card2)',
              border: '1px solid var(--border)',
            }}
          >
            <div style={{ fontSize: 'var(--t-meta, 11px)', color: 'var(--muted)', textTransform: 'uppercase', letterSpacing: '0.04em' }}>
              Total Deductions
            </div>
            <div
              className="figure"
              style={{
                fontSize: 'var(--t-h3, 20px)',
                fontWeight: 700,
                color: totalPenaltiesPaisa > 0 ? 'var(--danger-text, #ef4444)' : 'var(--text)',
                marginTop: 4,
              }}
            >
              {formatMoney(totalPenaltiesPaisa)}
            </div>
            <div style={{ fontSize: 'var(--t-meta, 11px)', color: 'var(--text2)', marginTop: 2 }}>
              Late Fee + Damage Charges
            </div>
          </div>

          {/* Net Settlement Outcome */}
          <div
            style={{
              padding: 12,
              borderRadius: 'var(--r-btn, 8px)',
              background:
                balanceDuePaisa > 0
                  ? 'color-mix(in srgb, var(--danger, #ef4444) 12%, var(--card))'
                  : 'color-mix(in srgb, var(--success, #22c55e) 12%, var(--card))',
              border: `1px solid ${balanceDuePaisa > 0 ? 'var(--danger, #ef4444)' : 'var(--success, #22c55e)'}`,
            }}
          >
            <div style={{ fontSize: 'var(--t-meta, 11px)', color: 'var(--muted)', textTransform: 'uppercase', letterSpacing: '0.04em' }}>
              {balanceDuePaisa > 0 ? 'Balance Owed by Client' : 'Net Deposit Refund'}
            </div>
            <div
              className="figure"
              style={{
                fontSize: 'var(--t-h3, 20px)',
                fontWeight: 700,
                color: balanceDuePaisa > 0 ? 'var(--danger-text, #ef4444)' : 'var(--success-text, #22c55e)',
                marginTop: 4,
              }}
            >
              {formatMoney(balanceDuePaisa > 0 ? balanceDuePaisa : depositRefundPaisa)}
            </div>
            <div style={{ fontSize: 'var(--t-meta, 11px)', color: 'var(--text2)', marginTop: 2 }}>
              {balanceDuePaisa > 0 ? '⚠️ Under-secured liability' : 'Release via Cash/Bank Transfer'}
            </div>
          </div>
        </div>

        {/* ── SECTION 2: LATE RETURN ASSESSMENT ── */}
        <div
          style={{
            padding: 14,
            borderRadius: 'var(--r-btn, 8px)',
            background: 'var(--card)',
            border: '1px solid var(--border)',
            display: 'flex',
            flexDirection: 'column',
            gap: 10,
          }}
        >
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: 8 }}>
            <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
              <Icon
                name={lateResult.band === 'None' ? 'check' : 'timer'}
                size={16}
                style={{ color: lateResult.band === 'None' ? 'var(--success-text)' : 'var(--progress-text)' }}
              />
              <strong style={{ fontSize: 'var(--t-ui, 13px)' }}>
                Late Return Duration: {formatOverage(lateResult.overageMinutes)}
              </strong>
            </div>
            <div style={{ fontSize: 'var(--t-meta, 12px)', color: 'var(--text2)' }}>
              Band: <b>{lateResult.band}</b> · Suggested Fee: <b>{formatMoney(lateResult.feePaisa)}</b>
            </div>
          </div>

          <p style={{ margin: 0, fontSize: 'var(--t-meta, 12px)', color: 'var(--muted)' }}>
            {bandExplanation(lateResult)} <span style={{ opacity: 0.7 }}>({dayRateBasis})</span>
          </p>

          {lateResult.band !== 'None' && (
            <div style={{ marginTop: 6, paddingTop: 10, borderTop: '1px solid var(--border)', display: 'flex', flexDirection: 'column', gap: 10 }}>
              <div style={{ display: 'flex', alignItems: 'center', gap: 12 }}>
                <label style={{ display: 'flex', alignItems: 'center', gap: 6, cursor: 'pointer', fontSize: 'var(--t-meta, 12px)' }}>
                  <input
                    type="radio"
                    name="lateDecision"
                    checked={lateDecision === 'Apply'}
                    onChange={() => setLateDecision('Apply')}
                    style={{ accentColor: 'var(--primary, #2563eb)' }}
                  />
                  <span>Charge Late Fee (<b>{formatMoney(lateResult.feePaisa)}</b>)</span>
                </label>

                <label style={{ display: 'flex', alignItems: 'center', gap: 6, cursor: 'pointer', fontSize: 'var(--t-meta, 12px)' }}>
                  <input
                    type="radio"
                    name="lateDecision"
                    checked={lateDecision === 'Waive'}
                    onChange={() => setLateDecision('Waive')}
                    style={{ accentColor: 'var(--primary, #2563eb)' }}
                  />
                  <span>Waive Late Fee</span>
                </label>
              </div>

              {lateDecision === 'Waive' && (
                <div style={{ background: 'var(--card2)', padding: 12, borderRadius: 'var(--r-btn, 6px)', border: '1px solid var(--border)' }}>
                  <div style={{ fontSize: 'var(--t-meta, 11px)', fontWeight: 600, color: 'var(--text2)', marginBottom: 6 }}>
                    Waiver Authorization (Manager / Owner approval required · min {WAIVER_REASON_MIN} characters):
                  </div>
                  <textarea
                    value={waiverReason}
                    onChange={(e) => setWaiverReason(e.target.value)}
                    placeholder="State detailed business rationale for waiving the late fee…"
                    aria-label="Late fee waiver reason"
                    rows={2}
                    style={{
                      width: '100%',
                      padding: 8,
                      borderRadius: 'var(--r-input, 4px)',
                      border: `1px solid ${waiverReason.trim().length < WAIVER_REASON_MIN ? 'var(--danger, #ef4444)' : 'var(--input-border)'}`,
                      background: 'var(--input-bg)',
                      color: 'var(--text)',
                      fontSize: 'var(--t-meta, 12px)',
                      fontFamily: 'inherit',
                      boxSizing: 'border-box',
                    }}
                  />
                  <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginTop: 4, fontSize: 11, color: 'var(--muted)' }}>
                    <span>Approver: <b>{approverName || 'Current Session'}</b> {mayApprove ? '✓ (Authorized)' : '⚠️ (Requires Manager)'}</span>
                    <span>{waiverReason.trim().length}/{WAIVER_REASON_MIN} min chars</span>
                  </div>
                  {waiverError && (
                    <div role="alert" style={{ color: 'var(--danger-text, #ef4444)', fontSize: 11, marginTop: 4, fontWeight: 600 }}>
                      {waiverError}
                    </div>
                  )}
                </div>
              )}
            </div>
          )}
        </div>

        {/* ── SECTION 3: DAMAGED & MISSING GEAR DEDUCTIONS ── */}
        <div
          style={{
            padding: 14,
            borderRadius: 'var(--r-btn, 8px)',
            background: 'var(--card)',
            border: '1px solid var(--border)',
            display: 'flex',
            flexDirection: 'column',
            gap: 10,
          }}
        >
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
            <strong style={{ fontSize: 'var(--t-ui, 13px)' }}>
              Damaged & Missing Equipment Charges ({itemsWithIssues.length})
            </strong>
            <span style={{ fontSize: 'var(--t-meta, 12px)', fontWeight: 600, color: totalDamagePaisa > 0 ? 'var(--danger-text, #ef4444)' : 'var(--muted)' }}>
              Total Damage Claim: {formatMoney(totalDamagePaisa)}
            </span>
          </div>

          {itemsWithIssues.length === 0 ? (
            <p style={{ margin: 0, fontSize: 'var(--t-meta, 12px)', color: 'var(--muted)' }}>
              ✓ No damaged or missing items flagged during return inspection. All equipment accounted for.
            </p>
          ) : (
            <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
              {itemsWithIssues.map((item) => {
                const currentEst = damageEstimates[item.key] ?? 0
                return (
                  <div
                    key={item.key}
                    style={{
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'space-between',
                      padding: '8px 10px',
                      background: 'var(--card2)',
                      borderRadius: 'var(--r-btn, 6px)',
                      border: '1px solid var(--border)',
                      gap: 12,
                      flexWrap: 'wrap',
                    }}
                  >
                    <div style={{ flex: 1, minWidth: 200 }}>
                      <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
                        <Icon
                          name={item.isMissing ? 'alert_circle' : 'tool'}
                          size={14}
                          style={{ color: item.isMissing ? 'var(--danger-text)' : 'var(--progress-text)' }}
                        />
                        <strong style={{ fontSize: 'var(--t-meta, 12px)', color: 'var(--text)' }}>
                          {item.name}
                        </strong>
                      </div>
                      <div style={{ fontSize: 11, color: 'var(--muted)', marginTop: 2 }}>
                        {item.serial ? `Serial: ${item.serial} · ` : ''}
                        Condition: <b>{item.isMissing ? 'Missing / Not Returned' : item.condition ?? 'Damaged'}</b>
                        {item.notes ? ` · Note: "${item.notes}"` : ''}
                      </div>
                    </div>

                    <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                      <span style={{ fontSize: 'var(--t-meta, 11px)', color: 'var(--muted)' }}>Repair / Replacement: Rs</span>
                      <input
                        type="text"
                        value={currentEst > 0 ? grouped(currentEst) : ''}
                        onChange={(e) => handleEstimateChange(item.key, e.target.value)}
                        placeholder="0"
                        aria-label={`Damage charge for ${item.name}`}
                        style={{
                          width: 110,
                          minHeight: 40,
                          padding: '0 10px',
                          borderRadius: 'var(--r-input, 6px)',
                          border: '1px solid var(--input-border)',
                          background: 'var(--input-bg)',
                          color: 'var(--text)',
                          fontSize: 'var(--t-meta, 13px)',
                          fontFamily: 'inherit',
                          textAlign: 'right',
                          fontWeight: 600,
                        }}
                      />
                    </div>
                  </div>
                )
              })}
            </div>
          )}
        </div>
      </div>
    </Modal>
  )
}
