<file path="src/lib/deterministicId.ts">
/**
 * Deterministic row ids, so two offline devices mint the SAME uuid for the same
 * logical row instead of two rows that can never be reconciled.
 *
 * ## The defect this exists for
 *
 * `PLAN.md §4.43(d).3` / `ONDEVICE_DB_PLAN` Phase 0 item 3:
 * `floorVerb.ts` mints an operation session id with `generateClientUuid()` —
 * `crypto.randomUUID()`. Two devices working one booking in the dead zone
 * therefore open two sessions for one operation. On sync the second insert is
 * refused by `operation_sessions_one_in_progress` (`0003:148`), and every
 * `packing_lines` / `handover_lines` / `return_lines` /
 * `session_line_movements` row the losing device wrote that shift now carries a
 * `session_id` foreign key to a session that will never exist. The whole shift
 * is unattachable, and nothing warned anyone at the time.
 *
 * ## Why the key is (booking_id, operation, session_no), NOT operational_day
 *
 * §4.43(d).3 prescribes deriving the id from
 * `(booking_id, operation, operational_day)`. That is wrong three times over,
 * and each was checked against the schema rather than reasoned about:
 *
 *  1. **It is wider than an existing invariant.**
 *     `operation_sessions_one_packing_per_booking` (`0003:152`) is
 *     `unique (booking_id) where operation = 'Packing'` — a booking gets exactly
 *     ONE Packing session, ever, on any day. Keying on the day mints a
 *     *different* id for a second-day pack that the index forbids anyway, so the
 *     losing device's children again point at a session that cannot exist. The
 *     prescription reintroduces the precise bug it was written to remove.
 *
 *  2. **It collapses two legitimate sessions.** `session_no` is 1-based within
 *     `(booking_id, operation)` and the floor uses it for repeat collections —
 *     `readLatestSession`'s own note calls session 1 the morning collection and
 *     session 2 the evening one. Both share an operational day, so a day-keyed
 *     id merges two distinct Handover/Return sessions into one row.
 *
 *  3. **`operational_day` is not fleet-deterministic.** It is computed by
 *     `operationalDayOf(instant, startMinutes)`, and `startMinutes` comes from
 *     the `operationalDayStart` setting — which `settingsStore.ts` persists to
 *     **`localStorage`, per browser**. `system_settings` is empty and has no
 *     writer. Two tablets configured differently place the same instant on
 *     different days and mint different ids, which is exactly the
 *     non-determinism the change is supposed to end.
 *
 * `session_no` has none of those problems. It already carries
 * `operation_sessions_session_no_unique` (`0003:85`,
 * `unique (booking_id, operation, session_no)`), so the id and the constraint
 * agree by construction; it needs no new column; and it depends on no setting.
 * Two offline devices reading the same local state compute the same
 * `(latest?.session_no ?? 0) + 1` and therefore the same id, and their rows
 * merge.
 *
 * **Its honest residual weakness:** a device whose view of prior sessions is
 * stale computes a `session_no` another device has already used, so both mint
 * the same id for what the operators meant as two different sessions. That
 * collides on a unique constraint the database already enforces and surfaces as
 * a sync conflict to resolve — which is strictly better than the current
 * failure, where nothing collides and a shift silently detaches.
 *
 * ## Why SHA-256 and not RFC 4122 v5
 *
 * v5 is name-based **SHA-1**. `crypto.subtle` in a browser exposes SHA-1 only
 * for `digest`, and shipping a SHA-1 dependency for new code to satisfy a
 * version nibble is not worth it. These ids are stamped version **8** (RFC 9562
 * "custom"), which is the honest label for a name-based uuid derived with a
 * different hash. Postgres does not read the version bits; humans and future
 * readers do.
 */

/** Fixed namespace for operation-session ids. Changing it re-keys every session. */
const OPERATION_SESSION_NAMESPACE = 'babin.rentals.os/operation_sessions/v1'

function hex(bytes: Uint8Array): string {
  let out = ''
  for (const b of bytes) out += b.toString(16).padStart(2, '0')
  return out
}

/**
 * Read one byte, refusing rather than coercing a short digest.
 *
 * `noUncheckedIndexedAccess` types `bytes[i]` as `number | undefined`, and the
 * two honest ways to satisfy it are a non-null assertion or this. A `?? 0`
 * fallback would silently emit a uuid with the wrong version bits on a runtime
 * whose SHA-256 returned something unexpected — a bad trade for a row id two
 * devices have to agree on.
 */
function byteAt(bytes: Uint8Array, index: number): number {
  const value = bytes[index]
  if (value === undefined) {
    throw new Error(`deterministicUuid: SHA-256 digest was too short — no byte at ${index}.`)
  }
  return value
}

/**
 * A uuid derived from `namespace` and `name`, stable across devices and runs.
 *
 * Async because `crypto.subtle.digest` is. Every call site is already async, so
 * this costs nothing; a synchronous hash would mean shipping our own.
 *
 * @throws if no Web Crypto implementation is present — deliberately, rather than
 *   falling back to a random id. A silent fall back to `randomUUID()` would
 *   reintroduce the defect on exactly the devices least able to report it.
 */
export async function deterministicUuid(namespace: string, name: string): Promise<string> {
  const subtle = globalThis.crypto?.subtle
  if (!subtle) {
    throw new Error(
      'deterministicUuid needs Web Crypto (crypto.subtle) and this runtime has none. ' +
        'Refusing to fall back to a random id: that is the offline defect this function exists to fix.',
    )
  }

  const input = new TextEncoder().encode(`${namespace}\0${name}`)
  const digest = new Uint8Array(await subtle.digest('SHA-256', input))
  const b = digest.slice(0, 16)

  // RFC 9562: version in the high nibble of byte 6, variant in the top bits of byte 8.
  b[6] = (byteAt(b, 6) & 0x0f) | 0x80 // version 8 — name-based with a non-standard hash
  b[8] = (byteAt(b, 8) & 0x3f) | 0x80 // variant 10xx

  const h = hex(b)
  return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`
}

/**
 * The id an `operation_sessions` row must carry, given the three facts that
 * identify it. Both devices in a dead zone compute this and land on one row.
 *
 * @param bookingId `bookings.id` — the uuid, never the `B-` number, which 0085
 *   is about to renumber.
 * @param operation `'Packing' | 'Handover' | 'Return'` — the `operation_kind`
 *   value as written to the column.
 * @param sessionNo 1-based within `(booking_id, operation)`; the value the
 *   insert is about to write, i.e. `(latest?.session_no ?? 0) + 1`.
 */
export async function operationSessionId(
  bookingId: string,
  operation: string,
  sessionNo: number,
): Promise<string> {
  if (!bookingId) throw new Error('operationSessionId needs a bookings.id.')
  if (!operation) throw new Error('operationSessionId needs an operation_kind.')
  if (!Number.isInteger(sessionNo) || sessionNo < 1) {
    throw new Error(
      `operationSessionId needs a 1-based session_no; got ${JSON.stringify(sessionNo)}. ` +
        'session_no is `not null default 1` with a unique constraint, so 0 or a fraction cannot be stored.',
    )
  }
  return deterministicUuid(OPERATION_SESSION_NAMESPACE, `${bookingId}:${operation}:${sessionNo}`)
}
