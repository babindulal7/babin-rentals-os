}

/* ── Calendar Booking Chips ─────────────────────────────────────────────── */
.calendar-chip {
  display: block;
  padding: 2px 6px;
  border-radius: 5px;
  font-size: var(--t-th, 11px);
  font-weight: 600;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: all var(--dur-fast, 120ms) var(--ease);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
}

.calendar-chip:hover {
