  pickupAtAd: '2026-08-14T03:15:00.000Z',
  returnAtAd: '2026-08-18T10:30:00.000Z',
  actualReturnAtAd: null,
  deliveryType: 'Client Pickup',
  pickupLocation: 'Kathmandu',
  returnLocation: null,
