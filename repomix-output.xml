import { useState, useEffect } from 'react'

export function useNetwork() {
  const [isOnline, setIsOnline] = useState(navigator.onLine)

  useEffect(() => {
    const handleOnline = () => setIsOnline(true)
    const handleOffline = () => setIsOnline(false)
    window.addEventListener('online', handleOnline)
    window.addEventListener('offline', handleOffline)
    return () => {
      window.removeEventListener('online', handleOnline)
      window.removeEventListener('offline', handleOffline)
    }
  }, [])

  return isOnline
}
</file>

<file path="src/lib/operationalDay.ts">
import { kathmanduCivil, NPT_OFFSET_MIN } from './bs'

/**
 * # The operational day — D4, ruled 30 Aug 2026
 *
 * `docs/booqable/REFERENCE_SPEC_v2.5.md` Appendix A0, D4: **the rental day runs
 * 06:00 → 06:00, as a setting.** Babin's ruling, evidenced twice in the live
 * Booqable account (Settings ▸ Rental period ▸ Default booking times, both
 * 06:00; and the client contract clause २.१) and by every captured booking
 * sitting at 06:00/06:15.
 *
 * This closes the `TODO(decision)` that lived in `queries/bookings.ts`'s
 * day-boundary block: "today's pickups" no longer means Kathmandu midnight to
 * midnight — it means the operational day, whose start the owner sets in
 * Settings (`operationalDayStart`, default `"06:00"`).
 *
 * ## What lives here, and what deliberately does not
 *
 * This module is the PURE half (Law 1): given a day and a start-of-day, it
 * answers where the day's boundaries sit and which operational day an instant
 * belongs to. It reads no storage — `queries/bookings.ts` reads the setting
 * and passes it in, the same split `lib/availability.ts` /
 * `queries/availability.ts` already use for the two availability rules.
 *
 * ## Which days this governs — and which it must NOT
 *
 * The operational day is the FLOOR's day: today's pickups, today's returns,
 * the Operations queues, the pickups report. It does **not** govern:
 *
 *  - **Finance day boundaries** (`queries/finance.ts` keeps its own
 *    calendar-midnight helpers). A payment taken at 05:30 belongs to that
 *    calendar date on the VAT books; moving tax-period boundaries with a floor
 *    setting would be a books-of-account change nobody ruled.
 *  - **Audit / activity-log day scopes** (`queries/audit.ts`). "What happened
 *    on the 12th" is a calendar question.
 *  - **BS calendar rendering** (`lib/bs.ts`). Which civil date it is never
 *    moves; only which *shift* an instant belongs to does.
 */

/** The ruled default — A0 D4. `settingsStore` carries the same string. */
export const OPERATIONAL_DAY_START_DEFAULT = '06:00'

/** Minutes after Kathmandu midnight that the ruled default names. */
export const OPERATIONAL_DAY_START_DEFAULT_MINUTES = 6 * 60

const HH_MM = /^([01]\d|2[0-3]):([0-5]\d)$/

/**
 * `"HH:mm"` → minutes after midnight, or `null` when the string is not a
 * clock time. `null` rather than a throw, because the one caller that faces
 * user-editable storage (`queries/bookings.ts`) must fall back to the ruled
 * default rather than take a screen down over a hand-edited localStorage —
 * the same posture `unitStatesForRule` takes on an unrecognised label.
 */
export function parseDayStart(value: string): number | null {
  const match = HH_MM.exec(value.trim())
  if (!match) return null
  return Number(match[1]) * 60 + Number(match[2])
}

/**
 * The stored setting value → minutes, falling back to the RULED default on
 * anything unparseable. Falling back to something permissive (midnight) would
 * silently re-rule D4; falling back to the ruling keeps a corrupted setting
 * from changing which bookings the 5am shift sees.
 */
export function dayStartMinutesFrom(value: unknown): number {
  const parsed = typeof value === 'string' ? parseDayStart(value) : null
  return parsed ?? OPERATIONAL_DAY_START_DEFAULT_MINUTES
}

/**
 * `+05:45`, formatted from `bs.ts`'s `NPT_OFFSET_MIN` rather than typed again.
 * `Calendar.md` §4.2 calls holding more than one copy of Nepal's offset "the
 * highest-priority correctness bug in the product" — this is the one string
 * form, and `queries/bookings.ts` imports it instead of building its own.
 */
export const NPT_OFFSET_STRING = `${NPT_OFFSET_MIN < 0 ? '-' : '+'}${String(
  Math.floor(Math.abs(NPT_OFFSET_MIN) / 60),
).padStart(2, '0')}:${String(Math.abs(NPT_OFFSET_MIN) % 60).padStart(2, '0')}`

const DAY_MS = 86_400_000

/** `YYYY-MM-DD` + n days, UTC-midnight arithmetic — day numbers are never added. */
function shiftDay(dayAd: string, days: number): string {
  const t = Date.parse(`${dayAd}T00:00:00.000Z`)
  if (Number.isNaN(t)) {
    throw new Error(`Expected an AD day (YYYY-MM-DD), got ${JSON.stringify(dayAd)}`)
  }
  return new Date(t + days * DAY_MS).toISOString().slice(0, 10)
}

function two(n: number): string {
  return String(n).padStart(2, '0')
}

/** Minutes after midnight → `"HH:mm:00.000"`. */
function clockOf(minutes: number): string {
  return `${two(Math.floor(minutes / 60))}:${two(minutes % 60)}:00.000`
}

export interface OperationalDayBounds {
  /** First instant INSIDE the day — `<day>T<start><+05:45>`. */
  readonly fromAd: string
  /**
   * Last instant INSIDE the day, to the millisecond — one ms before the next
   * day's start. `applyListFilters` compares with `lte` ("inclusive at both
   * ends"), so the bound must be the last value inside rather than the first
   * value after; the microsecond sliver this leaves open is the same one the
   * old midnight boundary accepted knowingly, for the same reason.
   */
  readonly toAd: string
}

/**
 * The boundaries of one operational day.
 *
 * With `startMinutes = 360` (06:00), day `2026-08-12` runs
 * `2026-08-12T06:00:00.000+05:45` → `2026-08-13T05:59:59.999+05:45`.
 * With `startMinutes = 0` it degrades exactly to the old calendar-midnight
 * pair (`T00:00:00.000` → same-day `T23:59:59.999`), so a business that rules
 * the day starts at midnight gets precisely the pre-D4 behaviour.
 */
export function operationalDayBounds(dayAd: string, startMinutes: number): OperationalDayBounds {
  assertStartMinutes(startMinutes)
  const fromAd = `${dayAd}T${clockOf(startMinutes)}${NPT_OFFSET_STRING}`

  if (startMinutes === 0) {
    return { fromAd, toAd: `${dayAd}T23:59:59.999${NPT_OFFSET_STRING}` }
  }

  // One ms before the NEXT day's start: HH:(mm-1):59.999 of the next calendar day.
  const endMinutes = startMinutes - 1
  const toAd = `${shiftDay(dayAd, 1)}T${two(Math.floor(endMinutes / 60))}:${two(endMinutes % 60)}:59.999${NPT_OFFSET_STRING}`
  return { fromAd, toAd }
}

/**
 * Which operational day an instant belongs to.
 *
 * A booking at 05:30 Kathmandu belongs to YESTERDAY's operational day when the
 * day starts at 06:00, and to today's when it starts at 00:00 — that sentence
 * is the D4 acceptance test, pinned in `__tests__/operationalDay.test.ts`.
 *
 * Implemented by shifting the instant back by the day-start and asking
 * `kathmanduCivil` — the SAME function the render side uses to decide which
 * day an instant belongs to — which civil date the shifted instant falls on.
 * The day a screen filters by and the day it labels therefore come from one
 * arithmetic.
 */
export function operationalDayOf(instantAd: string, startMinutes: number): string {
  assertStartMinutes(startMinutes)
  const t = Date.parse(instantAd)
  if (Number.isNaN(t)) {
    throw new Error(`Expected a full ISO instant, got ${JSON.stringify(instantAd)}`)
  }
  return new Date(kathmanduCivil(new Date(t - startMinutes * 60_000))).toISOString().slice(0, 10)
}

function assertStartMinutes(startMinutes: number): void {
  if (!Number.isInteger(startMinutes) || startMinutes < 0 || startMinutes >= 24 * 60) {
    throw new Error(
      `The operational day start must be whole minutes within one day (0–1439); got ${JSON.stringify(startMinutes)}. ` +
        'Use dayStartMinutesFrom() on the stored setting rather than passing it raw.',
    )
  }
}
</file>

<file path="src/lib/operationsShell.ts">
import type { IconName } from '../components/ui/Icon'
import { BOOKING_STATUS, JOBS, type BookingStatus, type JobName } from './workflow'

/**
 * Operations Popup Shell — shared item record engine & step gating.
 *
 * Spec §5, the core rule: "Packing and Return do not each read the booking
 * lines. There is one item record and it flows forward." Every `OperationItem`
 * below carries its pack state AND its return state on the same object —
 * Return reads what Packing actually produced (`packedSerial`/`qtyPacked`),
 * never the original booking line. §5.1: discrepancy is dispatched vs
 * returned, never quoted vs returned.
 *
 * §5.2: once handover is signed, packing lines lock. A correction after that
 * point is an append-only `CorrectionEntry`, never a rewrite — the effective
 * dispatched set is packing lines *plus* corrections, both visible.
 *
 * `lib/workflow.ts` owns the booking-status/job vocabulary; this file imports
 * it and adds display/step-gating logic to it.
 */

export type TrackingMode = 'serial' | 'count'
export type PackState = 'Pending' | 'Packed' | 'Short'
export type ReturnState = 'Pending' | 'Returned' | 'Missing' | 'Damaged'

export interface OperationItem {
  id: string
  name: string
  trackingMode: TrackingMode
  /** What the booking line originally specified — never mutated. */
  bookingSerial?: string
  qtyExpected: number
  location: string

  // ── Packing → produces the dispatched set ──
  packState: PackState
  /* `| undefined` explicit throughout (not just `?`) — tsconfig sets
     exactOptionalPropertyTypes, and `packItem`/`receiveReturn` below assign
     `undefined` directly (e.g. a count-tracked item has no serial) rather
     than omitting the key, same pattern already established in
     AddClient.tsx's `Field` component. */
  /** The serial actually packed. Differs from `bookingSerial` on a substitution. */
  packedSerial?: string | undefined
  qtyPacked: number
  packedBy?: string
  packedAt?: string
  /** Set once handover is signed — §5.2, packing becomes read-only past this point. */
  lockedAt?: string

  // ── Return → checked against the dispatched set, never the booking line ──
  returnState: ReturnState
  qtyReturned: number
  returnCondition?: 'Excellent' | 'Good' | 'Fair' | 'Damaged' | undefined
  returnedBy?: string
  returnedAt?: string
}

export interface CorrectionEntry {
  id: string
  itemId: string
  reason: string
  correctedBy: string
  correctedAt: string
  previousValue: string
  newValue: string
}

/* ── shell step metadata — imports JobName, adds display shape only ─────── */

export interface ShellStepDef {
  key: JobName
  label: string
  icon: IconName
}

/** §1.5 already ruled four operations, not five — Reset absorbs Cleaning.
 *  The shell's rail has 4 entries, not the 5 a step count guessed cold would
 *  assume. See `PLAN.md §4.6`. */
export const SHELL_STEPS: ShellStepDef[] = [
  { key: 'Pack', label: 'Packing', icon: 'box' },
  { key: 'Handover', label: 'Handover · Pickup', icon: 'truck' },
  { key: 'Return', label: 'Return & Inspection', icon: 'return_arrow' },
  { key: 'Reset', label: 'Reset · Cleaning', icon: 'refresh' },
]

export function entryStepFor(status: BookingStatus): JobName | null {
  const found = (Object.keys(JOBS) as JobName[]).find((j) => JOBS[j].runsAt === status)
  if (found) return found
  // Returned's job (Reset) also opens read-only at Closed — spec §4's table.
  if (status === 'Closed') return 'Reset'
  return null
}

export interface StepGate {
  allowed: boolean
  reason: string | null
}

/**
 * Spec §4.1: "Every step is always viewable. Write actions gate on status."
 * Reason text is inline, never a toast — matches the spec's own example
 * ("Pickup closed 6 Aug 09:14 by Ramesh.").
 */
export function stepWriteGate(step: JobName, bookingStatus: BookingStatus, completedAt?: string, completedBy?: string): StepGate {
  const meta = JOBS[step]
  if (meta.runsAt === bookingStatus) return { allowed: true, reason: null }

  const currentOrder = BOOKING_STATUS[bookingStatus].order
  const runsAtOrder = BOOKING_STATUS[meta.runsAt].order

  if (currentOrder < runsAtOrder) {
    return { allowed: false, reason: `${step} opens once this booking reaches ${meta.runsAt} — it is currently ${bookingStatus}.` }
  }
  return {
    allowed: false,
    reason: completedAt ? `${step} closed ${completedAt}${completedBy ? ` by ${completedBy}` : ''}.` : `${step} is already complete for this booking.`,
  }
}

export type StepDotState = 'not-started' | 'in-progress' | 'done' | 'blocked'

export function stepDotState(step: JobName, bookingStatus: BookingStatus, progress: { done: number; total: number }): StepDotState {
  const gate = stepWriteGate(step, bookingStatus)
  if (!gate.allowed) {
    const currentOrder = BOOKING_STATUS[bookingStatus].order
    const runsAtOrder = BOOKING_STATUS[JOBS[step].runsAt].order
    return currentOrder > runsAtOrder ? 'done' : 'blocked'
  }
  if (progress.done === 0) return 'not-started'
  if (progress.done >= progress.total) return 'done'
  return 'in-progress'
}

/* ── item mutations — every one returns a new array, never mutates in place ── */

export function packItem(items: OperationItem[], itemId: string, input: { serial?: string | undefined; qty: number; packedBy: string; packedAt: string }): OperationItem[] {
  return items.map((it) => {
    if (it.id !== itemId) return it
    // §5.2 — a locked line is read-only; a correction entry is the only
    // legal way to change it after this point. Enforced here, in the
    // engine, not just left to the UI hiding pack controls once packed —
    // incidental protection from one caller isn't the same as a guarantee
    // every future caller of this exported function gets for free.
    if (it.lockedAt) return it
    const qtyPacked = Math.min(input.qty, it.qtyExpected)
    return {
      ...it,
      qtyPacked,
      packedSerial: it.trackingMode === 'serial' ? (input.serial ?? it.bookingSerial) : undefined,
      packState: qtyPacked >= it.qtyExpected ? 'Packed' : 'Short',
      packedBy: input.packedBy,
      packedAt: input.packedAt,
    }
  })
}

/** §5.2 — called once, at handover signature. Every currently-packed line locks. */
export function lockPacking(items: OperationItem[], lockedAt: string): OperationItem[] {
  return items.map((it) => (it.packState !== 'Pending' ? { ...it, lockedAt } : it))
}

/**
 * A correction after lock. Never mutates the locked pack fields — appends an
 * entry instead, so `packing lines + corrections` (§5.2) is what's read as
 * the true dispatched set, and both stay visible independently.
 */
export function correctPackedItem(
  items: OperationItem[],
  corrections: CorrectionEntry[],
  itemId: string,
  newQty: number,
  reason: string,
  correctedBy: string,
  correctedAt: string,
): { items: OperationItem[]; corrections: CorrectionEntry[] } {
  const item = items.find((it) => it.id === itemId)
  if (!item) return { items, corrections }
  const entry: CorrectionEntry = {
    id: `corr-${itemId}-${corrections.length + 1}`,
    itemId,
    reason,
    correctedBy,
    correctedAt,
    previousValue: `${effectiveDispatchedQty(item, corrections)} packed`,
    newValue: `${newQty} packed`,
  }
  return { items, corrections: [...corrections, entry] }
}

/** The effective dispatched quantity — packing lines plus any correction, §5.2. */
export function effectiveDispatchedQty(item: OperationItem, corrections: CorrectionEntry[]): number {
  const itemCorrections = corrections.filter((c) => c.itemId === item.id)
  if (itemCorrections.length === 0) return item.qtyPacked
  const last = itemCorrections[itemCorrections.length - 1]!
  const match = /^(\d+)/.exec(last.newValue)
  return match ? Number(match[1]) : item.qtyPacked
}

/**
 * §5.1's core rule: discrepancy is dispatched vs returned, never quoted vs
 * returned. Checks against `qtyPacked` (+corrections), not `qtyExpected`.
 * Substitutions propagate automatically — the expected serial for Return is
 * whatever Packing actually sent out.
 */
export function receiveReturn(
  items: OperationItem[],
  corrections: CorrectionEntry[],
  itemId: string,
  input: { qty: number; condition: OperationItem['returnCondition']; returnedBy: string; returnedAt: string },
): OperationItem[] {
  return items.map((it) => {
    if (it.id !== itemId) return it
    const expected = effectiveDispatchedQty(it, corrections)
    const qtyReturned = Math.min(input.qty, expected)
    return {
      ...it,
      qtyReturned,
      returnCondition: input.condition,
      returnState: input.condition === 'Damaged' ? 'Damaged' : qtyReturned >= expected ? 'Returned' : 'Missing',
      returnedBy: input.returnedBy,
      returnedAt: input.returnedAt,
    }
  })
}

/** What Return should expect for this item — the dispatched set, not the booking line. */
export function expectedForReturn(item: OperationItem, corrections: CorrectionEntry[]): { serial?: string | undefined; qty: number; substituted: boolean } {
  return {
    serial: item.packedSerial,
    qty: effectiveDispatchedQty(item, corrections),
    substituted: Boolean(item.trackingMode === 'serial' && item.packedSerial && item.bookingSerial && item.packedSerial !== item.bookingSerial),
  }
}
</file>

<file path="src/lib/phone.ts">
/**
 * Client phone numbers — one rule, one place.
 *
 * `clients.phone` carries a hard database CHECK —
 * `supabase/migrations/0005_clients.sql:91`:
 *
 *     constraint clients_phone_format check (phone ~ '^\+977(97|98)[0-9]{8}$')
 *
 * Only 97/98 prefixes are legal and the stored value carries the country code.
 * An operator cannot see that rule, so every surface that accepts a phone must
 * state it and enforce it — otherwise a number that looks perfectly fine is
 * rejected by an invisible constraint at insert time.
 *
 * ## Why this is a module and not three copies
 *
 * Law 1 — *pages never implement business logic; the engines own it.* Three
 * screens create clients (`modules/clients/AddClient`, the booking-side
 * `modules/rentals/booking/AddClientModal`, and the CSV path through
 * `lib/clientImport`) and each had its own answer to "what is a valid phone":
 * two spellings of `/^9\d{9}$/` that accepted 96/95/90 numbers the database
 * rejects, and one correct copy. `AddClient` is `@ts-nocheck`, so nothing
 * typechecked the difference. The rule lives here so a fourth surface inherits
 * it instead of inventing a fourth answer.
 *
 * `lib/booqable/map/clients.ts` deliberately keeps its own copy — that file
 * states a self-containment convention for the whole mapper, its
 * `normalizeClientPhone` handles free-text from a foreign system rather than a
 * typed field, and it already routes non-conforming numbers to a conflict
 * queue. Left alone on purpose.
 *
 * ## What normalisation is allowed to do
 *
 * Only formatting is removed — spaces, hyphens, brackets, dots — plus a
 * `+977`/`977` country code pasted on top of a prefix the field already shows.
 * **Nothing else is rewritten.** A leading `0`, a 9-digit number or a landline
 * is *rejected with a reason*, never silently reshaped into a different number:
 * saving somebody a keystroke is not worth dialling a stranger on pickup day.
 */

/** A domestic mobile with the country code stripped — what an operator types. */
export const PHONE_LOCAL_RE = /^(97|98)\d{8}$/

/** The stored form. Mirrors the CHECK in migration 0005 character for character. */
export const PHONE_STORED_RE = /^\+977(97|98)[0-9]{8}$/

/**
 * The one wording for a rejected number, so the same miss cannot be explained
 * three different ways depending on which screen the operator happened to use.
 */
export const PHONE_REJECTION =
  'Must be a 10-digit Nepali mobile starting 97 or 98 — for example 9801234567.'

/** Strips formatting and a redundant country code. Never alters the digits themselves. */
export function phoneLocalDigits(raw: string): string {
  return raw.replace(/[\s\-().]/g, '').replace(/^(?:\+977|977)/, '')
}

/** True when what was typed is a phone number the database will accept. */
export function isValidLocalPhone(raw: string): boolean {
  return PHONE_LOCAL_RE.test(phoneLocalDigits(raw))
}

/**
 * The exact string that will be stored. Only meaningful for input that has
 * passed `isValidLocalPhone` — callers validate first and show this back to the
 * operator, so nobody is surprised by what landed in the record.
 */
export function canonicalPhone(raw: string): string {
  return `+977${phoneLocalDigits(raw)}`
}
