                        ? 'var(--primary-text)'
                        : pendingCount > 0 || syncStatus === 'pending'
                        ? 'var(--warn-text)'
                        : syncStatus === 'error'
                        ? 'var(--danger-text)'
                        : syncStatus === 'offline'
                        ? 'var(--muted)'
