/* RULING 2026-10-08: keep the catalogue first and optional charges beside
   the selected items they create. Width follows this card, not the screen. */
.new-rental-equipment-picker {
  container: equipment-picker / inline-size;
  min-width: 0;
  margin-bottom: 16px;
}

.new-rental-equipment-picker div:has(> input[role="combobox"]) {
  min-width: 0;
}

.new-rental-equipment-selection {
  container: equipment-selection / inline-size;
  min-width: 0;
}

.new-rental-equipment-label {
  margin: 0;
  color: var(--text2);
  font-size: var(--t-meta);
  font-weight: 600;
  line-height: 1.4;
}

.new-rental-equipment-selection > .new-rental-equipment-label {
  margin-bottom: 10px;
}

.new-rental-equipment-selection .new-rental-empty-products {
