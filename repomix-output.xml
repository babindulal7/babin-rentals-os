<file path="src/components/ui/Toast.tsx">
import { createContext, useCallback, useContext, useEffect, useRef, useState } from 'react'
import type { ReactNode } from 'react'
import Icon from './Icon'

/**
 * §12 (Law 12): "Toasts carry successes only." Errors are rendered inline in
 * their own surface — see `ErrorBanner` in `StateViews.tsx`, never here.
 *
 * Rewritten from Tailwind utility classNames — `fixed bottom-5 right-5...` —
 * to the app's real inline-style + CSS-variable system. Tailwind's Vite
 * plugin is registered but no CSS file imports `tailwindcss`, so every one of
 * those classes compiled to nothing: `ToastProvider` is mounted once, globally,
 * in `App.tsx`, and is the app's only success-feedback channel, so this bug
 * meant every success toast anywhere in the product rendered as an unstyled,
 * unpositioned `<div>` sitting in normal document flow — not a floating
 * bottom-right card, effectively invisible. Same prop/API shape as before, so
 * every existing `useToast().showSuccessToast(...)` call site is unaffected.
 */

/**
 * A single follow-on the toast may offer.
 *
 * It is an `href`, deliberately, and never a callback that opens a window.
 * WHATSAPP_LINKS_SPEC v1.0 §3 puts "Send receipt" on the payment success
 * toast, and a real anchor is the only version of that which cannot be eaten
 * by a popup blocker — `window.open` fired from a handler that has already
 * awaited a query has left its user gesture behind and is blocked in the
 * browsers the floor actually runs. The consequence shapes the caller: the URL
 * must be composed BEFORE the toast is raised, which is also what forces the
 * receipt's figures to be read rather than predicted.
 */
export interface ToastAction {
  label: string
  href: string
}

export interface ToastItem {
  id: string
  title: string
  message?: string
  action?: ToastAction
}

interface ToastContextValue {
  /**
   * Law 12 — successes only. The optional `action` is a follow-on to something
   * that already SUCCEEDED, never a retry for something that failed; a failure
   * still belongs inline, in its own surface.
   */
  showSuccessToast: (title: string, message?: string, action?: ToastAction) => void
}

const ToastContext = createContext<ToastContextValue | null>(null)

const NOOP_TOAST: ToastContextValue = {
  showSuccessToast: () => {},
}

export function useOptionalToast() {
  return useContext(ToastContext)
}

export function useToast(): ToastContextValue {
  const ctx = useContext(ToastContext)
  return ctx ?? NOOP_TOAST
}

// Fades + slides each toast in on mount. A per-item component (rather than
// inline logic in the .map below) is what lets this use its own mount-flag
// state, since hooks can't be called from inside a map callback.
function ToastCard({ toast, onDismiss }: { toast: ToastItem; onDismiss: (id: string) => void }) {
  const [mounted, setMounted] = useState(false)

  useEffect(() => {
    const frame = requestAnimationFrame(() => setMounted(true))
    return () => cancelAnimationFrame(frame)
  }, [])

  return (
    <div
      role="status"
      style={{
        pointerEvents: 'auto',
        display: 'flex',
        alignItems: 'flex-start',
        gap: 10,
        padding: 14,
        borderRadius: 'var(--r-card)',
        background: 'var(--dropdown)',
        backdropFilter: 'blur(16px)',
        WebkitBackdropFilter: 'blur(16px)',
        border: '1px solid var(--border2)',
        boxShadow: 'var(--shadow-xl)',
        opacity: mounted ? 1 : 0,
        transform: mounted ? 'translateY(0) scale(1)' : 'translateY(12px) scale(0.96)',
        transition: 'opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.22s cubic-bezier(0.16, 1, 0.3, 1)',
      }}
    >
      <span
        aria-hidden
        style={{
          width: 24,
          height: 24,
          borderRadius: 'var(--r-badge)',
          background: 'var(--st-in-bg)',
          color: 'var(--st-in-fg)',
          display: 'grid',
          placeItems: 'center',
          flexShrink: 0,
          marginTop: 1,
        }}
      >
        <Icon name="check" size={14} />
      </span>
      <div style={{ flex: 1, minWidth: 0 }}>
        <h4 style={{ margin: 0, fontSize: 'var(--t-meta)', fontWeight: 700, color: 'var(--text)' }}>
          {toast.title}
        </h4>
        {toast.message && (
          <p style={{ margin: '3px 0 0', fontSize: 'var(--t-meta)', color: 'var(--text2)', lineHeight: 1.4 }}>
            {toast.message}
          </p>
        )}
        {toast.action && (
          <a
            href={toast.action.href}
            target="_blank"
            rel="noopener noreferrer"
            onClick={() => onDismiss(toast.id)}
            style={{
              /* Law 15 — 44px of height even here. A toast that self-dismisses
                 in four seconds is the worst place in the app to ask for an
                 accurate click, so the target is full-width and the row is
                 tall; the dwell extension below buys the time to reach it. */
              display: 'flex',
              alignItems: 'center',
              minHeight: 44,
              marginTop: 6,
              fontSize: 'var(--t-meta)',
              fontWeight: 700,
              color: 'var(--primary-text)',
              textDecoration: 'none',
            }}
          >
            {toast.action.label}
          </a>
        )}
      </div>
      <button
        type="button"
        onClick={() => onDismiss(toast.id)}
        aria-label="Dismiss"
        style={{
          border: 'none',
          background: 'transparent',
          color: 'var(--muted)',
          cursor: 'pointer',
          padding: 3,
          flexShrink: 0,
          display: 'grid',
          placeItems: 'center',
        }}
      >
        <Icon name="close" size={14} />
      </button>
    </div>
  )
}

export function ToastProvider({ children }: { children: ReactNode }) {
  const [toasts, setToasts] = useState<ToastItem[]>([])
  const timerIdsRef = useRef<Set<ReturnType<typeof setTimeout>>>(new Set())

  useEffect(() => {
    const timers = timerIdsRef.current
    return () => {
      timers.forEach((t) => clearTimeout(t))
      timers.clear()
    }
  }, [])

  const showSuccessToast = useCallback((title: string, message?: string, action?: ToastAction) => {
    const id = Math.random().toString(36).slice(2, 9)
    const item: ToastItem = { id, title, ...(message ? { message } : {}), ...(action ? { action } : {}) }
    setToasts((prev) => [...prev, item])
    /*
     * Four seconds is right for a toast that only tells you something worked.
     * It is NOT right for one carrying an action: four seconds is about the
     * time it takes to read the line, decide, and move the pointer — so an
     * actionable toast would vanish under the cursor roughly as often as it
     * was caught. Twelve is the dwell the action earns; a toast without one is
     * unchanged, so nothing else in the product slows down.
     */
    const timer = setTimeout(
      () => {
        timerIdsRef.current.delete(timer)
        if (typeof window !== 'undefined') {
          setToasts((prev) => prev.filter((t) => t.id !== id))
        }
      },
      action ? 12000 : 4000,
    )
    timerIdsRef.current.add(timer)
  }, [])

  const removeToast = (id: string) => setToasts((prev) => prev.filter((t) => t.id !== id))

  return (
    <ToastContext.Provider value={{ showSuccessToast }}>
      {children}
      <div
        style={{
          position: 'fixed',
          /* A floor job open in the Operations shell lifts this clear of its Confirm button. */
          bottom: 'var(--toast-bottom, 20px)',
          right: 20,
          /* --z-system (10500), not the old literal 70. At 70 a toast painted
             BEHIND Calendar full view (200), the rentals dropdowns (1000),
             BranchesWarehouses (9000) — so the confirmation for an action
             taken on those surfaces was invisible. Toasts are system feedback;
             they sit above everything except nothing. */
          zIndex: 'var(--z-system)' as unknown as number,
          display: 'flex',
          flexDirection: 'column',
          gap: 10,
          maxWidth: 360,
          pointerEvents: 'none',
        }}
      >
        {toasts.map((toast) => (
          <ToastCard key={toast.id} toast={toast} onDismiss={removeToast} />
        ))}
      </div>
    </ToastContext.Provider>
  )
}
</file>

<file path="src/components/ui/TouchTarget.tsx">
import { forwardRef, type InputHTMLAttributes } from 'react'

/**
 * **A transparent 44×44 hit area centred on a control that is visually smaller.**
 *
 * Extracted 25 Aug 2026. Two private copies already existed —
 * `modules/rentals/NewRental.tsx` and `modules/rentals/booking/AddItemPanel.tsx`
 * — and the first one's own comment admits the duplication was a compromise:
 *
 * > *"Same shape as `booking/AddItemPanel.tsx`'s private `TouchInset`; it is not
 * > exported from that module, and re-declaring nine lines is better than
 * > widening another agent's public surface mid-flight."*
 *
 * A UI/UX audit on 25 Aug then found four more places that needed it, all on the
 * floor screens. Six consumers is past the point where re-declaring is cheaper
 * than sharing, so it moves here.
 *
 * ## The rule this exists to satisfy
 *
 * Law 15 — minimum 44px interactive target, on every device, never relaxed. And
 * `theme.css` states the sharper version of it beside the token:
 *
 * > *"§3.3 / §7.3 — the law is the HIT AREA, not the paint."*
 *
 * That distinction is the whole design. A packing table's remove glyph or a
 * pagination chevron inflated to 44px tall would wreck the density §60 asks for,
 * so the **target** grows and the **glyph does not**.
 *
 * ## `--tap` had no consumers until this file
 *
 * `--tap: 44px` has been defined in `theme.css` since the v4.1 direction and, as
 * of the audit, was referenced by exactly nothing — a stated law with no
 * enforcement anywhere in `src/`. Reading it here gives the token its first real
 * consumer, so the number lives in one place and a future change to the floor
 * moves every hit area at once.
 *
 * ## Usage
 *
 * The parent must be `position: 'relative'`; this is absolutely positioned
 * against it.
 *
 * ```tsx
 * <button style={{ height: 22, position: 'relative', ... }}>
 *   <TouchTarget />
 *   {label}
 * </button>
 * ```
 *
 * ⚠ OVERLAP — the failure mode this component causes, on BOTH axes.
 *
 * Any two controls whose boxes sit closer than 44px apart end up with
 * OVERLAPPING hit areas, and the later one in the DOM wins the tap. That is
 * worse than the small target it replaced, because nothing on screen shows you
 * why the wrong thing fired. Both axes have now bitten, and they look different
 * enough that finding one does not find the other:
 *
 *   HORIZONTAL — two side-by-side controls. `DateTimeField`'s calendar and
 *     clock buttons are 26px and share an edge; both targets grew to 44 and
 *     overlapped by 18px, so the timer's target reached ~9px into the calendar
 *     button's VISIBLE glyph. Fixed with `axis="y"`: take the free axis, and
 *     state the shortfall on the other rather than shipping a mis-fire. Two
 *     adjacent controls cannot both hold a 44-wide target inside 52px — that
 *     is geometry, and closing it is a layout change.
 *
 *   VERTICAL — the neighbour is the next ROW, not a sibling button, so an
 *     audit looking for adjacent controls will not see it. `CompactButton` is
 *     22px inside floor table rows that were 8+22+8 = 38px, so each target
 *     overhung its row by ~3px and adjacent rows overlapped by ~6px. On Return
 *     the two actions are "Mark Returned" and "Not Returned", so a boundary tap
 *     could record against the WRONG line item — a data error, not a cosmetic
 *     one. Fixed by giving those tables the §7.3 row floor
 *     (`height: var(--row-min-h)`, 56px), which the rows owed anyway: a 44px
 *     target then sits inside the row with 6px of margin each side.
 *
 * The rule of thumb: before adding this, ask what is 44px away in EVERY
 * direction — including the row above and below. If the answer is "another
 * target", fix the spacing or the row height first. Shrinking the target is the
 * wrong trade on a gloved-tablet screen.
 */
export function TouchTarget({ axis = 'both' }: { axis?: 'both' | 'y' } = {}) {
  return (
    <span
      aria-hidden="true"
      style={{
        position: 'absolute',
        left: '50%',
        top: '50%',
        transform: 'translate(-50%, -50%)',
        /*
         * `axis="y"` grows ONLY the vertical target and leaves the width at the
         * control's own box.
         *
         * It exists because of a real geometric limit, not a preference: two
         * horizontally-adjacent controls cannot BOTH have a 44px-wide target
         * inside less than 88px of width. Where they sit closer — the date
         * field's calendar and clock buttons are 26px each and share an edge —
         * growing both widths makes the later one in the DOM steal the earlier
         * one's visible glyph, so the tap lands on the wrong control. That is
         * strictly worse than the small target, because it is invisible.
         *
         * So on a horizontal pair, take the height (the axis that is free) and
         * be honest that the width is still short, rather than shipping an
         * overlap that silently mis-fires. Fixing the width is a layout change
         * — widen the field or drop to one control — and belongs to whoever
         * owns that design, not to a hit-area pass.
         */
        width: axis === 'y' ? '100%' : 'max(100%, var(--tap))',
        height: 'var(--tap)',
      }}
    />
  )
}

/**
 * A `<button>` that is visually compact but honours the 44px floor.
 *
 * The four floor workspaces (Return, Packing, Handover, Reset) each carried a
 * byte-identical private `RowAction` at `height: 22` — half the floor — and the
 * Return one rendered "Mark Returned" 4px from "Not Returned", two opposite
 * outcomes sharing an edge on a gloved tablet. This is that component, once,
 * with the hit area it always should have had.
 */
export function CompactButton({
  label,
  onClick,
  disabled = false,
  tone = 'neutral',
  title,
}: {
  label: string
  onClick: () => void
  disabled?: boolean
  /** `danger` and `success` tint the border only — the word still carries the meaning (Law 11). */
  tone?: 'neutral' | 'danger' | 'success'
  title?: string | undefined
}) {
  /*
   * `--danger` / `--success`, NOT `--st-danger-fg` / `--st-in-fg`.
   *
   * Those two are `--on-danger` and `--on-success`, and both resolve to
   * **#ffffff** in either theme — they are the ink you put ON a solid status
   * fill, not a colour for a border sitting on `--card2`.
   *
   * `ResetWorkspace`'s QC buttons used them, which meant its Pass and Fail
   * borders rendered IDENTICALLY WHITE: the author's colour coding was dead on
   * arrival and the two opposite verdicts were distinguishable only by their
   * word. (The word is what Law 11 requires and it was there, so this was a
   * silent cosmetic failure rather than a safety one — but it is still not what
   * the code says it does.)
   */
  const border =
    tone === 'danger' ? 'var(--danger)' : tone === 'success' ? 'var(--success)' : 'var(--border)'

  return (
    <button
      type="button"
      onClick={onClick}
      disabled={disabled}
      title={title}
      style={{
        position: 'relative',
        height: 22,
        padding: '0 7px',
        borderRadius: 'var(--r-xs)',
        border: `1px solid ${border}`,
        background: 'var(--card2)',
        color: disabled ? 'var(--muted)' : 'var(--text2)',
        fontSize: 'var(--t-meta)',
        fontWeight: 600,
        cursor: disabled ? 'not-allowed' : 'pointer',
        fontFamily: 'inherit',
        whiteSpace: 'nowrap',
        opacity: disabled ? 0.55 : 1,
      }}
    >
      <TouchTarget />
      {label}
    </button>
  )
}

/**
 * A native checkbox with a 44px hit area, for the floor tables.
 *
 * RULING 2026-10-14: on a tablet the floor workspaces render their ≥768 table layout, and the
 * row checkbox in it was the browser's bare 13px box with no label around it — the one control
 * a packer taps most, at 30% of the Law 15 floor. The `<label>` makes the whole inflated area
 * toggle the box; the glyph stays 18px so the table keeps its density. Rows are the §7.3
 * 56px floor, so the 44px target never reaches the next row.
 * Revert = swap `TapCheckbox` back to `<input type="checkbox">` at its call sites.
 */
export const TapCheckbox = forwardRef<HTMLInputElement, Omit<InputHTMLAttributes<HTMLInputElement>, 'type'>>(function TapCheckbox(
  { style, disabled, ...rest },
  ref,
) {
  return (
    <label
      style={{
        position: 'relative',
        display: 'inline-flex',
        alignItems: 'center',
        justifyContent: 'center',
        width: 22,
        height: 22,
        cursor: disabled ? 'not-allowed' : 'pointer',
      }}
    >
      <input ref={ref} type="checkbox" disabled={disabled} {...rest} style={{ width: 18, height: 18, margin: 0, cursor: 'inherit', ...style }} />
      <TouchTarget />
    </label>
  )
})
</file>

<file path="src/components/ui/Unavailable.tsx">
import { useEffect, useRef, useState } from 'react'
import type { ReactNode, CSSProperties } from 'react'
import { useCapability } from '../../lib/device'

const LONG_PRESS_MS = 500
const AUTO_DISMISS_MS = 2600

/**
 * **The disabled-control reason** — "grey it out, but say why" — used across
 * every deep screen. Fourteen files each carried their own copy of this before
 * this file existed, one more of the drifts §11 exists to prevent.
 *
 * `DEVICE/DEVICES.md` §7 build order item 4: "long-press wherever hover
 * carries information, gated on `!hasHover`." A `title` attribute is the
 * reason on a hover device, but it never fires on touch — there is no gesture
 * that reveals it, so a Warehouse tablet tapping a greyed-out button today
 * gets no explanation at all. Below `!hasHover`, a long-press (500ms hold)
 * shows the same reason in a small popover instead, auto-dismissed after a
 * few seconds so nothing gets stuck open.
 *
 * `IntelCard.tsx`'s Glance popover later generalized this exact pattern and,
 * in doing so, hardened three edges this file hadn't closed yet — folded back
 * in here rather than left to drift a second time:
 *  - a drag/scroll cancels an in-progress press (`onTouchMove`), so a page
 *    scroll that starts on a disabled control doesn't pop the reason open;
 *  - a completed long-press also emits a synthetic click on lift; unswallowed
 *    it can fall through to a clickable ancestor (a row that navigates/expands)
 *    the instant the popover opens — the exact defect SCREENS.md logs. A
 *    `suppress` ref + `onClick` guards it here too, defensively, even though
 *    today's children are disabled buttons or inert text;
 *  - Escape and an outside tap dismiss explicitly, and Enter/Space re-summon
 *    the popover on demand — useful once the auto-dismiss timer has fired but
 *    focus never left the control.
 */
export function Unavailable({
  reason,
  children,
  style,
}: {
  reason: string
  children: ReactNode
  style?: CSSProperties
}) {
  const { hasHover } = useCapability()
  const [show, setShow] = useState(false)
  const pressTimer = useRef<number | null>(null)
  const dismissTimer = useRef<number | null>(null)
  const suppress = useRef(false)
  const wrapperRef = useRef<HTMLSpanElement>(null)

  const clearTimers = () => {
    if (pressTimer.current !== null) window.clearTimeout(pressTimer.current)
    if (dismissTimer.current !== null) window.clearTimeout(dismissTimer.current)
    pressTimer.current = null
    dismissTimer.current = null
  }

  const reveal = () => {
    if (dismissTimer.current !== null) window.clearTimeout(dismissTimer.current)
    setShow(true)
    dismissTimer.current = window.setTimeout(() => setShow(false), AUTO_DISMISS_MS)
  }

  const dismiss = () => {
    if (dismissTimer.current !== null) window.clearTimeout(dismissTimer.current)
    dismissTimer.current = null
    setShow(false)
  }

  const onTouchStart = () => {
    if (hasHover) return
    suppress.current = false
    pressTimer.current = window.setTimeout(() => {
      suppress.current = true
      reveal()
    }, LONG_PRESS_MS)
  }
  const onTouchEnd = () => {
    if (pressTimer.current !== null) window.clearTimeout(pressTimer.current)
    pressTimer.current = null
  }

  useEffect(() => clearTimers, [])

  // Escape and an outside tap dismiss regardless of where focus landed —
  // touch doesn't reliably confer focus, so this can't depend on onBlur alone.
  useEffect(() => {
    if (!show) return
    const away = (e: Event) => {
      if (e.target instanceof Node && wrapperRef.current?.contains(e.target)) return
      dismiss()
    }
    const esc = (e: KeyboardEvent) => {
      if (e.key === 'Escape') dismiss()
    }
    document.addEventListener('pointerdown', away)
    document.addEventListener('keydown', esc)
    return () => {
      document.removeEventListener('pointerdown', away)
      document.removeEventListener('keydown', esc)
    }
  }, [show])

  return (
    <span
      ref={wrapperRef}
      aria-disabled
      aria-label={reason}
      tabIndex={0}
      title={hasHover ? reason : undefined}
      onTouchStart={onTouchStart}
      onTouchMove={onTouchEnd}
      onTouchEnd={onTouchEnd}
      onTouchCancel={onTouchEnd}
      onFocus={() => !hasHover && reveal()}
      onBlur={() => dismiss()}
      onKeyDown={(e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault()
          reveal()
        }
      }}
      onClick={(e) => {
        // Swallow the synthetic click a completed long-press emits on lift —
        // see the doc comment above.
        if (suppress.current) {
          suppress.current = false
          e.stopPropagation()
        }
      }}
      style={{ position: 'relative', display: 'inline-flex', cursor: 'not-allowed', ...style }}
    >
      {children}
      {show && (
        <span
          role="tooltip"
          style={{
            position: 'absolute',
            left: '50%',
            bottom: 'calc(100% + 7px)',
            transform: 'translateX(-50%)',
            maxWidth: 220,
            width: 'max-content',
            padding: '7px 10px',
            borderRadius: 'var(--r-sm)',
            background: 'var(--dropdown)',
            border: '1px solid var(--border)',
            boxShadow: 'var(--shadow-modal)',
            color: 'var(--text)',
            fontSize: 'var(--t-meta)',
            fontWeight: 500,
            lineHeight: 1.4,
            textAlign: 'left',
            zIndex: 40,
            pointerEvents: 'none',
          }}
        >
          {reason}
        </span>
      )}
    </span>
  )
}
</file>

<file path="src/components/ui/useFloatingMenu.ts">
import { useLayoutEffect, useState, type RefObject } from 'react'

/** Fixed body portals escape cards/tables and flip above cramped anchors. */
export function useFloatingMenu(open: boolean, triggerRef: RefObject<HTMLElement>, menuRef: RefObject<HTMLElement>, revision: string | null = null) {
  const [position, setPosition] = useState<{ top: number; left: number; width: number; maxHeight: number } | null>(null)
  useLayoutEffect(() => {
    if (!open) return
    const measure = () => {
      const anchor = triggerRef.current?.getBoundingClientRect()
      const menu = menuRef.current
      if (!anchor || !menu) return
      const width = Math.min(230, Math.max(0, window.innerWidth - 16))
      const below = Math.max(0, window.innerHeight - anchor.bottom - 12)
      const above = Math.max(0, anchor.top - 12)
      const height = Math.min(menu.scrollHeight, Math.max(above, below))
      const up = menu.scrollHeight > below && above > below
      setPosition({
        top: Math.max(8, up ? anchor.top - 4 - height : Math.min(anchor.bottom + 4, window.innerHeight - 8 - height)),
        left: Math.max(8, Math.min(anchor.right - width, window.innerWidth - width - 8)),
        width,
        maxHeight: up ? above : below,
      })
    }
    measure()
    window.addEventListener('scroll', measure, true)
    window.addEventListener('resize', measure)
    return () => {
      window.removeEventListener('scroll', measure, true)
      window.removeEventListener('resize', measure)
    }
  }, [open, revision, triggerRef, menuRef])
  return position
}
