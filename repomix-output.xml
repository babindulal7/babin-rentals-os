                                      style={{
                                        display: 'flex',
                                        alignItems: 'center',
                                        gap: 9,
                                        minHeight: 44,
                                        padding: '0 9px',
                                        borderRadius: 'var(--r-sm)',
                                        border: 'none',
                                        background: 'transparent',
                                        color: 'var(--text)',
                                        fontSize: 'var(--t-meta)',
                                        fontFamily: 'inherit',
                                        cursor: 'pointer',
                                        textAlign: 'left',
