import { DataTableShell } from '../../components/ui/DataTable'
import { PageBody } from '../../components/ui/PageBody'
import { ReportToolbar } from '../../components/ui/ReportToolbar'
import type { ReportCsvRow, ReportFilters } from '../../components/ui/ReportToolbar'
import { formatMoney, type Paisa } from '../../lib/money'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import { useViewport } from '../../lib/device'
import { useLoad } from '../../lib/queries/useLoad'
import { getClientReportsSummary, type ClientReportsSummary } from '../../lib/queries/clientReports'
import { reportFilterOptions, hasReportFilters, NoMatchRow } from './reportStates'

const cell = { padding: 'var(--sp-sm) var(--sp-md)' } as const
const right = { ...cell, textAlign: 'right' as const }
const m = (p: Paisa | null) => (p === null ? '—' : formatMoney(p))

/** The export body. Money sections appear only for a money-visible role (Law 6), exactly as on screen. */
function clientsCsv(s: ClientReportsSummary | null): ReportCsvRow[] {
  if (!s) return []
  return [
    ['Figure', 'Value'],
    ['Clients', s.totalClients],
    ['Active clients', s.activeClients],
    ['New clients in period', s.newClients],
    ['Members', s.members],
    ['Clients who booked', s.bookedClients],
    ['Repeat clients', s.repeatClients],
    ...(s.money
      ? ([
          ['Invoiced in period', formatMoney(s.money.invoiced)],
          ['Receivables now', formatMoney(s.money.receivables)],
        ] as ReportCsvRow[])
      : []),
    [],
    ['Booking frequency', 'Clients'],
    ...s.frequency.map((f): ReportCsvRow => [f.label, f.clients]),
    [],
    ['Client', 'Code', 'Bookings', ...(s.money ? ['Invoiced', 'Outstanding'] : [])],
    ...s.topClients.map((c): ReportCsvRow => [c.name, c.code, c.bookings, ...(s.money ? [m(c.invoiced), m(c.outstanding)] : [])]),
    ...(s.money
      ? ([
          [],
          ['Receivables ageing', 'Amount', 'Invoices'],
          ...s.money.ageing.map((a): ReportCsvRow => [a.label, formatMoney(a.amount), a.invoices]),
          [],
          ['Over 60 days overdue', 'Overdue', 'Oldest (days)'],
          ...s.money.highRisk.map((r): ReportCsvRow => [r.name, formatMoney(r.overdue), r.oldestDaysOverdue]),
        ] as ReportCsvRow[])
      : []),
  ]
}

function Section({ label, children }: { label: string; children: ReactNode }) {
  return (
    <section aria-label={label} style={cardStyle}>
      <div style={{ fontSize: 'var(--t-body)', fontWeight: 600, padding: 'var(--sp-md)', borderBottom: '1px solid var(--border)' }}>{label}</div>
      <DataTableShell ariaLabel={label}>{children}</DataTableShell>
    </section>
  )
}

/**
 * Client Reports.
 *
 * Phase 6 + Law 16: the page rendered `data/clientReports` (invented growth,
 * retention, ageing, top and high-risk clients, "insights") whatever the read
 * returned. It now draws the client base, booking frequency and — for a
 * money-visible role only — invoicing and receivables ageing, through
 * `useLoad` + `PageBody`.
 */
export default function ClientReports() {
  const money = useCanViewMoney()
  const viewport = useViewport()
  const [filters, setFilters] = useState<ReportFilters>({})
  const filtered = hasReportFilters(filters)
  const load = useLoad(() => getClientReportsSummary(reportFilterOptions(filters), { includeMoney: money }), {
    key: `${JSON.stringify(filters)}|${money}`,
  })
  const s = load.data

  const kpis: Kpi[] = s
    ? [
        { label: 'Clients', value: String(s.totalClients), icon: 'users', accent: 'primary', note: `${s.activeClients} active · ${s.members} members` },
        { label: 'New Clients', value: String(s.newClients), icon: 'plus', accent: 'neutral', note: filtered ? 'Added in the period' : 'All time' },
        { label: 'Clients Who Booked', value: String(s.bookedClients), icon: 'calendar', accent: 'neutral', note: `${s.repeatClients} booked more than once` },
        s.money
          ? { label: 'Receivables', value: formatMoney(s.money.receivables), icon: 'dollar', accent: s.money.receivables > 0 ? 'warn' : 'neutral', note: 'Outstanding on open invoices, now' }
          : { label: 'Repeat Clients', value: String(s.repeatClients), icon: 'check', accent: 'success', note: 'Two or more bookings' },
      ]
    : []

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
      <PageHeader title="Client Reports" description="The client base, how often clients book, and — for finance roles — what they owe." />

      <ReportToolbar
        title="Client Reports"
        value={filters}
        onChange={setFilters}
        dateColumn="pickup_at"
        csv={{ filename: 'client-reports', build: () => clientsCsv(s) }}
      />

      <PageBody
        noun="client figures"
        loading={load.loading}
        error={load.error}
        onRetry={load.reload}
        hasRows={s !== null}
        skeleton="kpi"
        empty={s !== null && s.totalClients === 0}
        emptyTitle="No clients yet"
        emptyMessage="Client figures appear here once the first client is added."
      >
        {s && (
          <>
            <KpiStrip columns={viewport === 'phone' ? 1 : viewport === 'tablet' ? 2 : 4} items={kpis} />

            <Section label="Booking Frequency">
              <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: 'var(--t-meta)' }}>
                <thead>
                  <tr style={{ color: 'var(--text2)' }}>
                    <th style={cell}>Bookings {filtered ? 'in period' : 'all time'}</th>
                    <th style={right}>Clients</th>
                  </tr>
                </thead>
                <tbody>
                  {s.frequency.map((f) => (
                    <tr key={f.label} style={{ borderTop: '1px solid var(--border)' }}>
                      <td style={{ ...cell, fontWeight: 600 }}>{f.label}</td>
                      <td style={right}>{f.clients}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </Section>

            <Section label={s.money ? 'Top Clients by Invoiced' : 'Most Active Clients'}>
              <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: 'var(--t-meta)', minWidth: 520 }}>
                <thead>
                  <tr style={{ color: 'var(--text2)' }}>
                    <th style={cell}>Client</th>
                    <th style={right}>Bookings</th>
                    {s.money && <th style={right}>Invoiced</th>}
                    {s.money && <th style={right}>Outstanding</th>}
                  </tr>
                </thead>
                <tbody>
                  {s.topClients.length === 0 && <NoMatchRow colSpan={s.money ? 4 : 2} noun="clients with bookings or invoices" />}
                  {s.topClients.map((c) => (
                    <tr key={c.clientId} style={{ borderTop: '1px solid var(--border)' }}>
                      <td style={{ ...cell, fontWeight: 600 }}>
                        <Link to={`/clients/${c.clientId}`} style={{ color: 'var(--primary)', textDecoration: 'none' }}>
                          {c.name}
                        </Link>
                      </td>
                      <td style={right}>{c.bookings}</td>
                      {s.money && <td style={right}>{m(c.invoiced)}</td>}
                      {s.money && <td style={right}>{m(c.outstanding)}</td>}
                    </tr>
                  ))}
                </tbody>
              </table>
            </Section>

            {s.money && (
              <>
                <Section label="Receivables Ageing">
                  <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: 'var(--t-meta)' }}>
                    <thead>
                      <tr style={{ color: 'var(--text2)' }}>
                        <th style={cell}>Past due date</th>
                        <th style={right}>Invoices</th>
                        <th style={right}>Outstanding</th>
                      </tr>
                    </thead>
                    <tbody>
                      {s.money.ageing.map((a) => (
                        <tr key={a.label} style={{ borderTop: '1px solid var(--border)' }}>
                          <td style={{ ...cell, fontWeight: 600 }}>{a.label}</td>
                          <td style={right}>{a.invoices}</td>
                          <td style={right}>{formatMoney(a.amount)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </Section>

                <Section label="Over 60 Days Overdue">
                  <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: 'var(--t-meta)' }}>
                    <thead>
                      <tr style={{ color: 'var(--text2)' }}>
                        <th style={cell}>Client</th>
                        <th style={right}>Overdue</th>
                        <th style={right}>Oldest</th>
                      </tr>
                    </thead>
                    <tbody>
                      {s.money.highRisk.length === 0 && <NoMatchRow colSpan={3} noun="clients over 60 days overdue" />}
                      {s.money.highRisk.map((r) => (
                        <tr key={r.clientId} style={{ borderTop: '1px solid var(--border)' }}>
                          <td style={{ ...cell, fontWeight: 600 }}>{r.name}</td>
                          <td style={right}>{formatMoney(r.overdue)}</td>
                          <td style={right}>{r.oldestDaysOverdue} days</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </Section>
              </>
            )}
          </>
        )}
      </PageBody>
    </div>
  )
}
</file>

<file path="src/modules/reports/CustomReport.tsx">
import { formatAd } from '../../lib/bs'
import { useMemo, useState } from 'react'
import { PageHeader, KpiStrip, cardStyle } from '../../components/ui/Page'
import type { Kpi } from '../../components/ui/Page'
import { DataTableShell } from '../../components/ui/DataTable'
import { ReportToolbar } from '../../components/ui/ReportToolbar'
import type { ReportCsvRow, ReportFilters } from '../../components/ui/ReportToolbar'
import { ReportFamiliesNav } from '../../components/ui/ReportFamiliesNav'
import Icon from '../../components/ui/Icon'
import { formatMoney, rupees } from '../../lib/money'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import { useViewport } from '../../lib/device'
import { ROWS } from '../../data/rentals'
import { CLIENTS_DATA } from '../../data/clients'
import { CASES } from '../../data/cases'

type Domain = 'rentals' | 'invoices' | 'clients' | 'cases'

interface ColumnOption {
  id: string
  label: string
  money?: boolean
}

const DOMAIN_COLUMNS: Record<Domain, ColumnOption[]> = {
  rentals: [
    { id: 'bookingNo', label: 'Booking No' },
    { id: 'clientName', label: 'Client' },
    { id: 'projectName', label: 'Project' },
    { id: 'stage', label: 'Status' },
    { id: 'startDate', label: 'Pickup Date' },
    { id: 'endDate', label: 'Return Date' },
    { id: 'total', label: 'Rental Total', money: true },
    { id: 'paid', label: 'Paid Amount', money: true },
  ],
  invoices: [
    { id: 'invoiceNo', label: 'Invoice No' },
    { id: 'clientName', label: 'Client' },
    { id: 'issueDate', label: 'Issue Date' },
    { id: 'status', label: 'Status' },
    { id: 'subtotal', label: 'Subtotal', money: true },
    { id: 'total', label: 'Total', money: true },
    { id: 'outstanding', label: 'Outstanding', money: true },
  ],
  clients: [
    { id: 'clientCode', label: 'Client Code' },
    { id: 'name', label: 'Name' },
    { id: 'company', label: 'Company' },
    { id: 'tier', label: 'Membership' },
    { id: 'totalBookings', label: 'Current Rentals' },
    { id: 'credit', label: 'Credit Limit', money: true },
    { id: 'balance', label: 'Outstanding', money: true },
  ],
  cases: [
    { id: 'caseNo', label: 'Case No' },
    { id: 'type', label: 'Type' },
    { id: 'title', label: 'Title' },
    { id: 'counterparty', label: 'Counterparty' },
    { id: 'priority', label: 'Priority' },
    { id: 'status', label: 'Status' },
    { id: 'assessed', label: 'Assessed Amount', money: true },
    { id: 'recovered', label: 'Recovered Amount', money: true },
  ],
}

interface CustomRow {
  [key: string]: string | number | undefined
  rawTotal: number
}

const th = {
  textAlign: 'left' as const,
  padding: '10px 12px',
  fontSize: 'var(--t-th)',
  fontWeight: 600,
  color: 'var(--text2)',
  whiteSpace: 'nowrap' as const,
  borderBottom: '1px solid var(--border)',
}

const td = {
  height: 'var(--row-min-h)',
  padding: '10px 12px',
  fontSize: 'var(--t-meta)',
  color: 'var(--text)',
  borderBottom: '1px solid var(--border)',
}

export default function CustomReport() {
  const money = useCanViewMoney()
  const viewport = useViewport()
  const [domain, setDomain] = useState<Domain>('rentals')
  const [search, setSearch] = useState('')
  const [selectedColumns, setSelectedColumns] = useState<string[]>([
    'bookingNo',
    'clientName',
    'projectName',
    'stage',
    'startDate',
    'total',
  ])
  const [filters, setFilters] = useState<ReportFilters>({})

  // When domain changes, default columns for that domain
  const handleDomainChange = (newDomain: Domain) => {
    setDomain(newDomain)
    const available = DOMAIN_COLUMNS[newDomain]
      .filter((c) => money || !c.money)
      .map((c) => c.id)
    setSelectedColumns(available)
  }

  // Toggle column
  const toggleColumn = (colId: string) => {
    if (selectedColumns.includes(colId)) {
      if (selectedColumns.length > 2) {
        setSelectedColumns(selectedColumns.filter((id) => id !== colId))
      }
    } else {
      setSelectedColumns([...selectedColumns, colId])
    }
  }

  // Filter rows based on domain and search
  const rows = useMemo<CustomRow[]>(() => {
    const q = search.toLowerCase().trim()

    if (domain === 'rentals') {
      return ROWS.filter((b) => {
        if (!q) return true
        return (
          b.bookingNo.toLowerCase().includes(q) ||
          b.client.toLowerCase().includes(q) ||
          b.project.toLowerCase().includes(q)
        )
      }).map((b): CustomRow => ({
        bookingNo: b.bookingNo,
        clientName: b.client,
        projectName: b.project,
        stage: b.status,
        startDate: formatAd(b.pickup.ad),
        endDate: formatAd(b.ret.ad),
        total: b.amount ? formatMoney(b.amount) : '—',
        paid: b.amount && b.due !== undefined ? formatMoney(rupees(Math.max(0, (b.amount as number) - (b.due as number)))) : '—',
        rawTotal: (b.amount as number) || 0,
      }))
    } else if (domain === 'invoices') {
      // Mock / snapshot invoice data
      const sampleInvoices = [
        { invoiceNo: 'INV-2026-001', clientName: 'Kathmandu Cinema Works', issueDate: '2026-07-15', status: 'Paid', subtotal: rupees(120000), total: rupees(135600), outstanding: rupees(0) },
        { invoiceNo: 'INV-2026-002', clientName: 'Himalayan Film Collective', issueDate: '2026-07-18', status: 'Paid', subtotal: rupees(85000), total: rupees(96050), outstanding: rupees(0) },
        { invoiceNo: 'INV-2026-003', clientName: 'Everest Frame Studios', issueDate: '2026-07-22', status: 'Unpaid', subtotal: rupees(210000), total: rupees(237300), outstanding: rupees(237300) },
        { invoiceNo: 'INV-2026-004', clientName: 'Pokhara Visuals', issueDate: '2026-07-25', status: 'Partially Paid', subtotal: rupees(160000), total: rupees(180800), outstanding: rupees(80800) },
      ]
      return sampleInvoices.filter((inv) => {
        if (!q) return true
        return (
          inv.invoiceNo.toLowerCase().includes(q) ||
          inv.clientName.toLowerCase().includes(q)
        )
      }).map((inv): CustomRow => ({
        invoiceNo: inv.invoiceNo,
        clientName: inv.clientName,
        issueDate: inv.issueDate,
        status: inv.status,
        subtotal: formatMoney(inv.subtotal),
        total: formatMoney(inv.total),
        outstanding: formatMoney(inv.outstanding),
        rawTotal: inv.total as number,
      }))
    } else if (domain === 'clients') {
      return CLIENTS_DATA.filter((c) => {
        if (!q) return true
        return (
          c.name.toLowerCase().includes(q) ||
          (c.company && c.company.toLowerCase().includes(q)) ||
          c.id.toLowerCase().includes(q)
        )
      }).map((c): CustomRow => ({
        clientCode: c.id,
        name: c.name,
        company: c.company ?? '—',
        tier: c.membership,
        totalBookings: c.currentRentalsCount,
        credit: formatMoney(c.creditLimitPaisa),
        balance: formatMoney(c.outstandingPaisa),
        rawTotal: c.outstandingPaisa as number,
      }))
    } else {
      return CASES.filter((cs) => {
        if (!q) return true
        return (
          cs.id.toLowerCase().includes(q) ||
          cs.title.toLowerCase().includes(q) ||
          cs.counterpartyName.toLowerCase().includes(q)
        )
      }).map((cs): CustomRow => ({
        caseNo: cs.id,
        type: cs.type,
        title: cs.title,
        counterparty: cs.counterpartyName,
        priority: cs.priority,
        status: cs.status,
        assessed: formatMoney(cs.assessedPaisa),
        recovered: formatMoney(cs.chargedToClientPaisa),
        rawTotal: cs.assessedPaisa as number,
      }))
    }
  }, [domain, search])

  // KPIs derived from custom query
  const kpis = useMemo<Kpi[]>(() => {
    const count = rows.length
    const totalAmount = rupees(
      rows.reduce((sum: number, r: CustomRow) => sum + r.rawTotal, 0),
    )

    return [
      {
        label: 'Extracted Records',
        value: String(count),
        icon: 'box',
        accent: 'primary',
        note: `Target domain: ${domain.toUpperCase()}`,
      },
      {
        label: 'Active Columns',
        value: `${selectedColumns.length} fields`,
        icon: 'checklist',
        accent: 'neutral',
        note: 'Included in tabular view & CSV',
      },
      ...(money
        ? [
            {
              label: 'Aggregated Volume',
              value: formatMoney(totalAmount),
              icon: 'dollar' as const,
              accent: 'success' as const,
              note: 'Sum of selected domain records',
            },
          ]
        : []),
    ]
  }, [rows, domain, selectedColumns.length, money])

  // Available column metadata for current domain
  const availableColumns = useMemo(() => {
    return DOMAIN_COLUMNS[domain].filter((c) => money || !c.money)
  }, [domain, money])

  const activeColumnDefs = useMemo(() => {
    return availableColumns.filter((c) => selectedColumns.includes(c.id))
  }, [availableColumns, selectedColumns])

  // CSV Builder
  function getCsvRows(): ReportCsvRow[] {
    const headers = activeColumnDefs.map((c) => c.label)
    const dataRows = rows.map((r) =>
      activeColumnDefs.map((c) => {
        const val = r[c.id]
        return val != null ? String(val) : '—'
      }),
    )

    return [
      [`Custom ${domain.toUpperCase()} Report Extract`],
      [`Generated for Babin Rentals OS · ${formatAd(new Date())}`],
      [],
      headers,
      ...dataRows,
    ]
  }

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
      <PageHeader
        icon="tool"
        title="Custom Report Builder"
        description="Build ad-hoc reports, choose fields, filter records across operational domains, and export clean CSVs."
      />

      <ReportFamiliesNav current="Custom" />

      {/* Domain Selection & Toolbar */}
      <ReportToolbar
        title="Custom Report Builder"
        value={filters}
        onChange={setFilters}
        csv={{
          filename: `custom-report-${domain}`,
          build: getCsvRows,
        }}
      >
        <div
          role="group"
          aria-label="Custom report domain selector"
          className="report-view-toggle"
          style={{ display: 'inline-flex' }}
        >
          {([
            ['Rentals / Bookings', 'rentals'],
            ['Invoices & Billing', 'invoices'],
            ['Clients & CRM', 'clients'],
            ['Cases & Incidents', 'cases'],
          ] as const).map(([label, d]) => {
            const active = domain === d
            return (
              <button
                key={d}
                type="button"
                className="tap"
                onClick={() => handleDomainChange(d)}
                aria-pressed={active}
                style={{
                  minHeight: 44,
                  padding: '0 14px',
                  fontSize: 'var(--t-meta)',
                  fontWeight: active ? 600 : 400,
                  border: '1px solid var(--border)',
                  background: active ? 'var(--select-bg)' : 'transparent',
                  color: active ? 'var(--select-fg)' : 'var(--text2)',
                  borderRadius:
                    d === 'rentals'
                      ? 'var(--rad-sm) 0 0 var(--rad-sm)'
                      : d === 'cases'
                        ? '0 var(--rad-sm) var(--rad-sm) 0'
                        : 0,
                  cursor: 'pointer',
                }}
              >
                {label}
              </button>
            )
          })}
        </div>
      </ReportToolbar>

      {/* Search Input & Column Selection Strip */}
      <div
        style={{
          ...cardStyle,
          padding: '12px 14px',
          display: 'flex',
          flexDirection: 'column',
          gap: 'var(--sp-sm)',
        }}
      >
        <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)' }}>
          <Icon name="search" size={16} style={{ color: 'var(--muted)' }} />
          <input
            type="search"
            aria-label={`Filter ${domain} records`}
            placeholder={`Filter ${domain} records…`}
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            style={{
              flex: 1,
              border: 'none',
              background: 'transparent',
              fontSize: 'var(--t-meta)',
              color: 'var(--text)',
              outline: 'none',
            }}
          />
        </div>

        <div style={{ display: 'flex', flexWrap: 'wrap', alignItems: 'center', gap: 'var(--sp-sm)', borderTop: '1px solid var(--border)', paddingTop: 8 }}>
          <span style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text2)', marginRight: 6 }}>
            Include Columns:
          </span>
          {availableColumns.map((col) => {
            const isSelected = selectedColumns.includes(col.id)
            return (
              <button
                key={col.id}
                type="button"
                className="tap"
                onClick={() => toggleColumn(col.id)}
                aria-pressed={isSelected}
                style={{
                  minHeight: 36,
                  padding: '0 12px',
                  borderRadius: 'var(--r-badge)',
                  fontSize: 'var(--t-meta)',
                  fontWeight: isSelected ? 600 : 400,
                  border: `1px solid ${isSelected ? 'var(--nav-active-accent)' : 'var(--border)'}`,
                  background: isSelected ? 'var(--select-bg)' : 'transparent',
                  color: isSelected ? 'var(--select-fg)' : 'var(--muted)',
                  cursor: 'pointer',
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: 5,
                }}
              >
                {isSelected ? <Icon name="check" size={13} /> : <span style={{ width: 13 }} />}
                {col.label}
              </button>
            )
          })}
        </div>
      </div>

      {/* Dynamic KPIs */}
      <KpiStrip items={kpis} columns={viewport === 'phone' ? 1 : viewport === 'tablet' ? 2 : kpis.length} />

      {/* Dynamic Data Table */}
      <DataTableShell ariaLabel={`Custom tabular query with ${selectedColumns.length} fields over ${domain}`}>
        {rows.length === 0 ? (
          <div style={{ padding: 'var(--sp-xl)', textAlign: 'center', color: 'var(--muted)' }}>
            No records match the current filters.
          </div>
        ) : (
          <table style={{ width: '100%', borderCollapse: 'collapse' }}>
            <thead>
              <tr>
                {activeColumnDefs.map((col) => (
                  <th key={col.id} style={th}>
                    {col.label}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map((row, idx) => (
                <tr key={idx}>
                  {activeColumnDefs.map((col) => {
                    const val = row[col.id]
                    return (
                      <td key={col.id} style={td} className={col.money ? 'figure' : undefined}>
                        {val != null ? String(val) : '—'}
                      </td>
                    )
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </DataTableShell>
    </div>
  )
}
</file>

<file path="src/modules/reports/DamageMaintenanceReports.tsx">
import { formatAd, formatAdDateTime } from '../../lib/bs'
import { useMemo, useState } from 'react'
import { Link } from 'react-router-dom'
import { PageHeader, KpiStrip, cardStyle } from '../../components/ui/Page'
import type { Kpi } from '../../components/ui/Page'
import { DataTableShell } from '../../components/ui/DataTable'
import { PageBody } from '../../components/ui/PageBody'
import { useLoad } from '../../lib/queries/useLoad'
import { NOT_TRACKED } from '../../lib/queries/reportSupport'
import { reportFilterOptions, hasReportFilters, NoMatchRow } from './reportStates'
import { ReportToolbar } from '../../components/ui/ReportToolbar'
import type { ReportCsvRow, ReportFilters } from '../../components/ui/ReportToolbar'
import { Donut, Legend, type Slice } from '../../components/ui/Charts'
import Icon from '../../components/ui/Icon'
import { formatMoney, type Paisa } from '../../lib/money'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import { useViewport } from '../../lib/device'
import { getDamageMaintenanceReport } from '../../lib/queries/damageMaintenanceReports'

/** A date the read did not return reads as a dash, never "Invalid Date". */
const dateOrDash = (iso: string): string => (iso && !Number.isNaN(Date.parse(iso)) ? formatAd(new Date(iso)) : '—')

type DmTab = 'damage' | 'repairs' | 'servicing' | 'availability'

const th = {
  textAlign: 'left' as const,
  padding: '10px 12px',
  fontSize: 'var(--t-th)',
  fontWeight: 600,
  color: 'var(--text2)',
  whiteSpace: 'nowrap' as const,
  borderBottom: '1px solid var(--border)',
}

const td = {
  height: 'var(--row-min-h)',
  padding: '10px 12px',
  fontSize: 'var(--t-meta)',
  color: 'var(--text)',
  borderBottom: '1px solid var(--border)',
}

export default function DamageMaintenanceReports() {
  const money = useCanViewMoney()
  const viewport = useViewport()
  const [activeTab, setActiveTab] = useState<DmTab>('damage')
  const [filters, setFilters] = useState<ReportFilters>({})
  /* Phase 6 — the read used to return seed figures on failure, on an empty
     database, and per figure (`|| MOCK_DM`); it now throws, and `PageBody`
     draws loading · Error + Retry · nothing-yet vs "nothing in this period". */
  const filtered = hasReportFilters(filters)
  const load = useLoad(() => getDamageMaintenanceReport(reportFilterOptions(filters)), { key: JSON.stringify(filters) })
  const data = load.data
  const nothing =
    data !== null &&
    data.incidents.length === 0 &&
    data.repairs.length === 0 &&
    data.servicing.length === 0 &&
    // The fleet tab has figures whenever any unit exists, findings or not.
    data.metrics.fleetAvailabilityRate === null

  // Damage KPI Strip
  const damageKpis = useMemo<Kpi[]>(() => {
    if (!data) return []
    const m = data.metrics
    return [
      {
        label: 'Damage Incidents',
        value: String(m.totalFindings),
        icon: 'alert_triangle',
        accent: m.totalFindings > 0 ? 'danger' : 'neutral',
        note: 'Triage return inspection findings',
      },
      {
        label: 'Assessed Damage',
        value: money ? formatMoney(m.totalDamageCost) : '—',
        icon: 'dollar',
        accent: 'danger',
        note: money ? 'Total hardware repair quote' : /* Restricted (Law 6) */ "Restricted",
      },
      {
        label: 'Client Recovered',
        value: money ? formatMoney(m.totalChargedToClient) : '—',
        icon: 'check',
        accent: 'success',
        note: money ? 'Charged to the client on the linked case' : /* Restricted (Law 6) */ "Restricted",
      },
      {
        label: 'Pending Approval',
        value: String(data.incidents.filter((i) => i.approvalState === 'Pending Approval').length),
        icon: 'timer',
        accent: 'warn',
        note: 'Findings awaiting approval',
      },
    ]
  }, [data, money])

  // Repairs KPI Strip
  const repairKpis = useMemo<Kpi[]>(() => {
    if (!data) return []
    const m = data.metrics
    return [
      {
        label: 'Active Repairs',
        value: String(m.activeRepairs),
        icon: 'tool',
        accent: 'primary',
        note: 'Units currently in shop',
      },
      {
        label: 'Avg Turnaround',
        value: m.averageTurnaroundDays === null ? '—' : `${m.averageTurnaroundDays} Days`,
        icon: 'timer',
        accent: 'neutral',
        note: m.averageTurnaroundDays === null ? 'No repair has both a start and a finish yet' : 'Started to completed',
      },
      {
        label: 'Repair Expenditure',
        value: money ? formatMoney(m.totalRepairSpend) : '—',
        icon: 'dollar',
        accent: 'neutral',
        note: money ? 'Parts & technician servicing' : /* Restricted (Law 6) */ "Restricted",
      },
      {
        label: 'In-House Ratio',
        value: NOT_TRACKED,
        icon: 'sparkles',
        accent: 'neutral',
        note: 'Repairs do not record in-house vs outside shop',
      },
    ]
  }, [data, money])

  // Servicing KPI Strip
  const servicingKpis = useMemo<Kpi[]>(() => {
    if (!data) return []
    const m = data.metrics
    return [
      {
        label: 'Routine Servicing',
        value: String(m.routineServicesCompleted),
        icon: 'check',
        accent: 'success',
        note: 'Non-repair maintenance completed',
      },
      {
        label: 'Upcoming Scheduled',
        value: String(data.servicing.filter((s) => s.status === 'Scheduled').length),
        icon: 'calendar',
        accent: 'primary',
        note: 'Non-repair maintenance with status Scheduled',
      },
      {
        label: 'Calibration Compliance',
        value: NOT_TRACKED,
        icon: 'sparkles',
        accent: 'neutral',
        note: 'No calibration record exists yet',
      },
      {
        label: 'Firmware Up-to-date',
        value: NOT_TRACKED,
        icon: 'check',
        accent: 'neutral',
        note: 'No firmware record exists yet',
      },
    ]
  }, [data])

  // Availability KPI Strip
  const availabilityKpis = useMemo<Kpi[]>(() => {
    if (!data) return []
    const m = data.metrics
    return [
      {
        label: 'Fleet Availability',
        value: m.fleetAvailabilityRate === null ? '—' : `${m.fleetAvailabilityRate}%`,
        icon: 'chart',
        accent: 'neutral',
        note: 'Units In Stock of all units not retired, now',
      },
      {
        label: 'Sidelined Units',
        value: String(m.sidelinedUnitsCount),
        icon: 'alert_triangle',
        accent: m.sidelinedUnitsCount > 5 ? 'warn' : 'neutral',
        note: 'In inspection, cleaning, maintenance or missing',
      },
      {
        label: 'Workshop Downtime',
        value: NOT_TRACKED,
        icon: 'timer',
        accent: 'neutral',
        note: 'Needs unit state history over time',
      },
      {
        label: 'Rental Ready Fleet',
        value: `${m.rentalReadyUnits} Units`,
        icon: 'box',
        accent: 'primary',
        note: 'Units In Stock right now',
      },
    ]
  }, [data])

  // CSV export generator
  const getCsvRows = (): ReportCsvRow[] => {
    if (activeTab === 'damage') {
      return [
        ['Damage Findings & Liabilities Report'],
        ['Metric', 'Value'],
        ['Total Damage Incidents', data?.metrics.totalFindings ?? 0],
        ['Total Assessed Damage Cost', money ? formatMoney(data?.metrics.totalDamageCost ?? (0 as Paisa)) : 'Restricted'],
        ['Total Recovered from Clients', money ? formatMoney(data?.metrics.totalChargedToClient ?? (0 as Paisa)) : 'Restricted'],
        [],
        ['Severity Breakdown'],
        ['Severity', 'Incidents Count', 'Share %', 'Total Cost'],
        ...(data?.severityBreakdown.map((s): ReportCsvRow => [
          s.severity,
          s.count,
          `${s.percent}%`,
          money ? formatMoney(s.totalCost) : 'Restricted',
        ]) ?? []),
        [],
        ['Damage Incidents Log'],
        ['Finding ID', 'Booking No', 'Client', 'Equipment Unit', 'Serial', 'Severity', 'Estimated Cost', 'Disposition'],
        ...(data?.incidents.map((i): ReportCsvRow => [
          i.id,
          i.bookingNo,
          i.clientName,
          i.unitName,
          i.serial,
          i.severity,
          money ? formatMoney(i.estimatedCost) : 'Restricted',
          i.disposition,
        ]) ?? []),
      ]
    } else if (activeTab === 'repairs') {
      return [
        ['Equipment Repairs & Workshop Turnaround Report'],
        ['Metric', 'Value'],
        ['Active Repairs in Shop', data?.metrics.activeRepairs ?? 0],
        ['Average Turnaround Days', data?.metrics.averageTurnaroundDays == null ? '—' : `${data.metrics.averageTurnaroundDays} Days`],
        ['Total Repair Spend', money ? formatMoney(data?.metrics.totalRepairSpend ?? (0 as Paisa)) : 'Restricted'],
        [],
        ['Repairs Log'],
        ['Record No', 'Equipment Unit', 'Serial', 'Issue Description', 'Vendor / Shop', 'Priority', 'Status', 'Turnaround Days', 'Cost'],
        ...(data?.repairs.map((r): ReportCsvRow => [
          r.recordNo,
          r.unitName,
          r.serial,
          r.issue,
          r.vendorOrShop,
          r.priority,
          r.status,
          `${r.turnaroundDays} days`,
          money ? formatMoney(r.cost) : 'Restricted',
        ]) ?? []),
      ]
    } else if (activeTab === 'servicing') {
      return [
        ['Preventive Servicing & Calibration Report'],
        ['Metric', 'Value'],
        ['Routine Services Completed', data?.metrics.routineServicesCompleted ?? 0],
        [],
        ['Servicing Schedule Log'],
        ['Record No', 'Equipment Unit', 'Serial', 'Service Type', 'Scheduled Date', 'Assigned Tech', 'Status'],
        ...(data?.servicing.map((s): ReportCsvRow => [
          s.recordNo,
          s.unitName,
          s.serial,
          s.serviceType,
          s.scheduledDate,
          s.performedBy,
          s.status,
        ]) ?? []),
      ]
    } else {
      return [
        ['Fleet Downtime & Out-of-Service Rate Report'],
        ['Metric', 'Value'],
        ['Fleet Availability Rate', data?.metrics.fleetAvailabilityRate == null ? '—' : `${data.metrics.fleetAvailabilityRate}%`],
        ['Total Sidelined Units', data?.metrics.sidelinedUnitsCount ?? 0],
        [],
        ['Sidelined Fleet Units Register'],
        ['Serial', 'Model Name', 'Current Status', 'Sidelined Since', 'Downtime Reason'],
        ...(data?.sidelinedUnits.map((u): ReportCsvRow => [
          u.serial,
          u.modelName,
          u.status,
          u.sidelinedSince,
          u.reason,
        ]) ?? []),
      ]
    }
  }

  // Slices for Donut charts
  const severitySlices: Slice[] = useMemo(() => {
    if (!data) return []
    return data.severityBreakdown.map((s) => ({
      label: s.severity,
      value: s.count,
      display: `${s.count} incidents`,
      percent: `${s.percent}%`,
    }))
  }, [data])

  const typeSlices: Slice[] = useMemo(() => {
    if (!data) return []
    return data.damageTypeBreakdown.map((t) => ({
      label: t.damageType,
      value: t.count,
      display: `${t.count} (${t.percent}%)`,
      percent: `${t.percent}%`,
    }))
  }, [data])

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
      <PageHeader
        icon="tool"
        title="Damage & Maintenance Reports"
        description="Physical condition findings, workshop turnaround, preventive calibration servicing, and sidelined fleet units."
      />

      {/* Shared Toolbar */}
      <ReportToolbar
        title="Damage & Maintenance Reports"
        value={filters}
        onChange={setFilters}
        dateColumn="created_at"
        csv={{
          filename: `damage-maintenance-${activeTab}`,
          build: getCsvRows,
        }}
      >
        <div
          role="group"
          aria-label="Damage report views"
          className="report-view-toggle"
          style={{ display: 'inline-flex' }}
        >
          {([
            ['Damage Findings', 'damage'],
            ['Equipment Repairs', 'repairs'],
            ['Scheduled Servicing', 'servicing'],
            ['Fleet Availability', 'availability'],
          ] as const).map(([label, key]) => {
            const on = activeTab === key
            return (
              <button
                key={key}
                type="button"
                aria-pressed={on}
                onClick={() => setActiveTab(key)}
                className={`report-toggle-btn ${on ? 'is-active' : ''}`}
              >
                {label}
              </button>
            )
          })}
        </div>
      </ReportToolbar>

      {/* TAB 1: DAMAGE FINDINGS */}
      <PageBody
        noun="damage and maintenance figures"
        loading={load.loading}
        error={load.error}
        onRetry={load.reload}
        hasRows={data !== null}
        skeleton="kpi"
        empty={nothing}
        emptyIsFiltered={filtered}
        onClearFilters={() => setFilters({})}
        emptyTitle={filtered ? 'No damage or maintenance in this period' : 'No damage or maintenance recorded yet'}
        emptyMessage={
          filtered
            ? 'Nothing was recorded in the selected period. Clear the filters to see everything.'
            : 'Findings, repairs and servicing appear here once the first one is recorded.'
        }
      >
      {activeTab === 'damage' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
          <KpiStrip items={damageKpis} />

          <div
            style={{
              display: 'grid',
              gridTemplateColumns: viewport === 'desktop' ? '1fr 1fr' : '1fr',
              gap: 'var(--sp-md)',
            }}
          >
            {/* Severity Distribution */}
            <div style={cardStyle}>
              <h3 style={{ fontSize: 'var(--t-h3)', fontWeight: 600, marginBottom: 'var(--sp-sm)' }}>
                Findings by Severity Rating
              </h3>
              <p style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', marginBottom: 'var(--sp-md)' }}>
                Classification of physical condition findings recorded at check-in.
              </p>
              {severitySlices.length > 0 && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)', alignItems: 'center' }}>
                  <Donut slices={severitySlices} size={180} />
                  <Legend slices={severitySlices} />
                </div>
              )}
            </div>

            {/* Damage Types Breakdown */}
            <div style={cardStyle}>
              <h3 style={{ fontSize: 'var(--t-h3)', fontWeight: 600, marginBottom: 'var(--sp-sm)' }}>
                Primary Damage Categories
              </h3>
              <p style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', marginBottom: 'var(--sp-md)' }}>
                Hardware failure and handling incident distribution.
              </p>
              <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-sm)' }}>
                {typeSlices.map((ts) => (
                  <div
                    key={ts.label}
                    style={{
                      display: 'flex',
                      justifyContent: 'space-between',
                      alignItems: 'center',
                      padding: '10px 14px',
                      background: 'var(--surface-hover)',
                      borderRadius: 'var(--r-sm)',
                    }}
                  >
                    <div style={{ fontWeight: 600, fontSize: 'var(--t-body)' }}>{ts.label}</div>
                    <div style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
                      {ts.display}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          {/* Incidents Table */}
          <div style={cardStyle}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 'var(--sp-sm)' }}>
              <div>
                <h3 style={{ fontSize: 'var(--t-h3)', fontWeight: 600 }}>Recorded Damage Findings</h3>
                <p style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
                  Audit log of returned equipment issues, assessed liability, and repair disposition.
                </p>
              </div>
              <Link
                to="/cases"
                style={{
                  fontSize: 'var(--t-meta)',
                  color: 'var(--primary)',
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: 4,
                  textDecoration: 'none',
                }}
              >
                View Cases Workspace <Icon name="chevron_right" size={12} />
              </Link>
            </div>

            <DataTableShell ariaLabel="Recorded Damage Findings">
              <table style={{ width: '100%', borderCollapse: 'collapse' }}>
                <thead>
                  <tr>
                    <th style={th}>Finding ID</th>
                    <th style={th}>Booking</th>
                    <th style={th}>Equipment Unit</th>
                    <th style={th}>Serial</th>
                    <th style={th}>Severity</th>
                    <th style={th}>Description</th>
                    {money && <th style={{ ...th, textAlign: 'right' }}>Assessed Cost</th>}
                    <th style={th}>Disposition</th>
                  </tr>
                </thead>
                <tbody>
                  {data?.incidents.length === 0 && <NoMatchRow colSpan={money ? 8 : 7} noun="damage findings" />}
                  {data?.incidents.map((inc) => (
                    <tr key={inc.id}>
                      <td style={{ ...td, fontWeight: 600, color: 'var(--primary)' }}>{inc.id}</td>
                      <td style={td}>
                        {inc.bookingNo === '—' ? (
                          '—'
                        ) : (
                          <Link
                            to={`/rentals/${inc.bookingNo}`}
                            style={{ color: 'var(--primary)', fontWeight: 600, textDecoration: 'none' }}
                          >
                            {inc.bookingNo}
                          </Link>
                        )}
                      </td>
                      <td style={{ ...td, fontWeight: 600 }}>{inc.unitName}</td>
                      <td style={{ ...td, fontFamily: 'var(--font-id, sans-serif)', fontVariantNumeric: 'tabular-nums' }}>{inc.serial}</td>
                      <td style={td}>
                        <span
                          style={{
                            display: 'inline-block',
                            padding: '2px 8px',
                            borderRadius: 'var(--r-sm)',
                            fontSize: 'var(--t-meta)',
                            fontWeight: 600,
                            background:
                              inc.severity === 'Critical' || inc.severity === 'Severe'
                                ? 'var(--status-danger-bg)'
                                : inc.severity === 'Moderate'
                                  ? 'var(--status-warn-bg)'
                                  : 'var(--surface-hover)',
                            color:
                              inc.severity === 'Critical' || inc.severity === 'Severe'
                                ? 'var(--status-danger-text)'
                                : inc.severity === 'Moderate'
                                  ? 'var(--status-warn-text)'
                                  : 'var(--text)',
                          }}
                        >
                          {inc.severity}
                        </span>
                      </td>
                      <td style={{ ...td, maxWidth: 260 }}>{inc.description}</td>
                      {money && (
                        <td style={{ ...td, textAlign: 'right', fontWeight: 600 }}>
                          {formatMoney(inc.estimatedCost)}
                        </td>
                      )}
                      <td style={td}>{inc.disposition}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </DataTableShell>
          </div>
        </div>
      )}

      {/* TAB 2: EQUIPMENT REPAIRS */}
      {activeTab === 'repairs' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
          <KpiStrip items={repairKpis} />

          <div style={cardStyle}>
            <h3 style={{ fontSize: 'var(--t-h3)', fontWeight: 600, marginBottom: 'var(--sp-sm)' }}>
              Workshop Repair Jobs Log
            </h3>
            <p style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', marginBottom: 'var(--sp-md)' }}>
              Active and completed corrective maintenance jobs across in-house workshop and authorized service partners.
            </p>

            <DataTableShell ariaLabel="Workshop Repair Jobs Log">
              <table style={{ width: '100%', borderCollapse: 'collapse' }}>
                <thead>
                  <tr>
                    <th style={th}>Record No</th>
                    <th style={th}>Equipment</th>
                    <th style={th}>Serial</th>
                    <th style={th}>Fault / Issue Description</th>
                    <th style={th}>Repair Facility</th>
                    <th style={th}>Turnaround</th>
                    <th style={th}>Priority</th>
                    <th style={th}>Status</th>
                    {money && <th style={{ ...th, textAlign: 'right' }}>Cost</th>}
                  </tr>
                </thead>
                <tbody>
                  {data?.repairs.length === 0 && <NoMatchRow colSpan={money ? 9 : 8} noun="repairs" />}
                  {data?.repairs.map((rep) => (
                    <tr key={rep.id}>
                      <td style={{ ...td, fontWeight: 600, color: 'var(--primary)' }}>{rep.recordNo}</td>
                      <td style={{ ...td, fontWeight: 600 }}>{rep.unitName}</td>
                      <td style={{ ...td, fontFamily: 'var(--font-id, sans-serif)', fontVariantNumeric: 'tabular-nums' }}>{rep.serial}</td>
                      <td style={{ ...td, maxWidth: 250 }}>{rep.issue}</td>
                      <td style={td}>{rep.vendorOrShop}</td>
                      <td style={td}>{rep.turnaroundDays === null ? '—' : `${rep.turnaroundDays} days`}</td>
                      <td style={td}>
                        <span
                          style={{
                            display: 'inline-block',
                            padding: '2px 8px',
                            borderRadius: 'var(--r-sm)',
                            fontSize: 'var(--t-meta)',
                            fontWeight: 600,
                            background: rep.priority === 'Urgent' ? 'var(--status-danger-bg)' : 'var(--surface-hover)',
                            color: rep.priority === 'Urgent' ? 'var(--status-danger-text)' : 'var(--text)',
                          }}
                        >
                          {rep.priority}
                        </span>
                      </td>
                      <td style={td}>
                        <span
                          style={{
                            display: 'inline-block',
                            padding: '2px 8px',
                            borderRadius: 'var(--r-sm)',
                            fontSize: 'var(--t-meta)',
                            background: rep.status === 'Completed' ? 'var(--status-success-bg)' : 'var(--status-warn-bg)',
                            color: rep.status === 'Completed' ? 'var(--status-success-text)' : 'var(--status-warn-text)',
                            fontWeight: 600,
                          }}
                        >
                          {rep.status}
                        </span>
                      </td>
                      {money && (
                        <td style={{ ...td, textAlign: 'right', fontWeight: 600 }}>
                          {formatMoney(rep.cost)}
                        </td>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </DataTableShell>
          </div>
        </div>
      )}

      {/* TAB 3: SCHEDULED SERVICING */}
      {activeTab === 'servicing' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
          <KpiStrip items={servicingKpis} />

          <div style={cardStyle}>
            <h3 style={{ fontSize: 'var(--t-h3)', fontWeight: 600, marginBottom: 'var(--sp-sm)' }}>
              Preventive Maintenance & Calibration Schedule
            </h3>
            <p style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', marginBottom: 'var(--sp-md)' }}>
              Calendar of sensor cleaning, firmware upgrades, and lens collimation checks to ensure zero on-set failure.
            </p>

            <DataTableShell ariaLabel="Preventive Maintenance Schedule">
              <table style={{ width: '100%', borderCollapse: 'collapse' }}>
                <thead>
                  <tr>
                    <th style={th}>Record No</th>
                    <th style={th}>Equipment</th>
                    <th style={th}>Serial</th>
                    <th style={th}>Servicing Scope</th>
                    <th style={th}>Scheduled Date</th>
                    <th style={th}>Technician</th>
                    <th style={th}>Status</th>
                  </tr>
                </thead>
                <tbody>
                  {data?.servicing.length === 0 && <NoMatchRow colSpan={7} noun="servicing records" />}
                  {data?.servicing.map((srv) => (
                    <tr key={srv.id}>
                      <td style={{ ...td, fontWeight: 600, color: 'var(--primary)' }}>{srv.recordNo}</td>
                      <td style={{ ...td, fontWeight: 600 }}>{srv.unitName}</td>
                      <td style={{ ...td, fontFamily: 'var(--font-id, sans-serif)', fontVariantNumeric: 'tabular-nums' }}>{srv.serial}</td>
                      <td style={td}>{srv.serviceType}</td>
                      <td style={td}>{dateOrDash(srv.scheduledDate)}</td>
                      <td style={td}>{srv.performedBy}</td>
                      <td style={td}>
                        <span
                          style={{
                            display: 'inline-block',
                            padding: '2px 8px',
                            borderRadius: 'var(--r-sm)',
                            fontSize: 'var(--t-meta)',
                            background: srv.status === 'Completed' ? 'var(--status-success-bg)' : 'var(--surface-hover)',
                            color: srv.status === 'Completed' ? 'var(--status-success-text)' : 'var(--text)',
                          }}
                        >
                          {srv.status}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </DataTableShell>
          </div>
        </div>
      )}

      {/* TAB 4: FLEET AVAILABILITY */}
      {activeTab === 'availability' && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
          <KpiStrip items={availabilityKpis} />

          <div style={cardStyle}>
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 'var(--sp-sm)' }}>
              <div>
