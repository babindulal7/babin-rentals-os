}

/** Mount a workspace behind its real parameterised route, so `useParams` is live. */
async function mountAt(path: string, element: ReactNode, pattern: string) {
  await mount(
    <Routes>
      <Route path={pattern} element={element} />
    </Routes>,
    path,
  )
}

