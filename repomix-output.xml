import { describe, expect, it } from 'vitest'

import { PAYMENT_STATUS_TONE, paymentStatusTone, STATUS } from '../status'
import { paymentGlance } from '../../data/bookingIntel'
import type { PaymentHistoryRow } from '../../data/booking'
