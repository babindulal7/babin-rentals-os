<file path="src/lib/queries/productAvailability.ts">
import {
  availabilityRules,
  readCandidates,
  readHolds,
  readProductModes,
  readQuantityHolds,
} from './availability'
import { capacityFor, isRetired, selectUnitsForLine, windowsOverlap } from '../availability'
import type {
  AssignmentOutcome,
  BoundConvention,
  RentalWindow,
  QuantityHold,
  UnitCandidate,
  UnitHold,
} from '../availability'

/**
 * # One product's availability, for a stated window
 *
 * The equipment sibling of `queries/bundleRecords.ts`. That module answers
 * *"can this bundle be filled between these two instants"*; this one answers
 * the same question for a single product, through the same engine, so the
 * catalogue and the Bundles pane cannot disagree about the same camera.
 *
 * ## Why it exists (NR-09)
 *
 * `booking/itemCatalogue.ts`'s `equipmentResultsFrom` derived a verdict from
 * `unitsByState` — a count of where each unit is **at this instant**. Its own
 * strings said so ("None of 4 free right now") while the panel above them said
 * *"Availability shown for this booking's dates"*, and `NewRental.tsx` raised a
 * Critical from it that blocked Confirm. A booking three weeks out was refused
 * because a camera was on someone else's shoot today.
 *
 * A now-count cannot answer a future window. The date-overlap check can, and it
 * already exists: `lib/availability.ts`'s `selectUnitsForLine`, under
 * `availabilityRules()` — the owner's `unitAvailabilityRule` and
 * `rentalTurnaround` settings, read per call. Nothing here re-implements it.
 *
 * ## Why the window is a required argument
 *
 * The same pressure `listBundleRecords` applies, for the same reason (PLAN.md
 * §4.44, ruled 4 Sep 2026): "free" is not a property of a product, it is the
 * answer to "free *when*". A caller that cannot say which window it means must
 * not get a green answer by omission.
 *
 * ## What this deliberately does not answer
 *
 * A product with **no unit rows** — quantity-tracked bulk stock — gets
 * `unitsOwned: 0`. There is nothing for the overlap check to overlap, so no
 * verdict is produced and none is guessed: the caller reports the stock count
 * and says it is not unit-tracked. `products.total_quantity` is not read here
 * at all, because a bulk count is not an availability answer and mixing the two
 * is how a fabricated status gets built a second time.
 *
 * Products are evaluated **independently of one another**, like bundles in
 * `listBundleRecords`: two catalogue rows never compete for the same unit
 * because a unit belongs to exactly one product. What is NOT answered here is
 * whether two BOOKING LINES naming the same product can both be filled — that
 * is a per-line question, answered by comparing `unitsFree` against the summed
 * quantity, which is the caller's arithmetic on this module's counts.
 */

/** What the engine can say about one product between two instants. */
export type ProductStockMode = 'unit' | 'quantity'

export interface ProductWindowAvailability {
  /** `products.id`. */
  readonly productId: string
  /**
   * Which of the two stock models answered. `unit` counts `product_units`
   * rows and overlaps them one at a time; `quantity` compares
   * `products.total_quantity` against the peak of the model-level holds.
   *
   * Carried because the two are not interchangeable to a reader: `unitsOwned`
   * is a count of serials in one and a bulk figure in the other, and a screen
   * that prints "3 of 4 free" should be able to say which kind of four it
   * means. It also makes an all-`quantity` catalogue visible as such, which
   * live is today (204 of 204 products).
   */
  readonly mode: ProductStockMode
  /**
   * Unit rows this product has, retired ones excluded — the same "units owned"
   * reading `bundleRecords.lineOf` takes: a retired unit is not stock, the
   * business no longer has it. `0` means the product has no unit rows at all,
   * which is a real state (bulk stock) and not a failed read.
   */
  readonly unitsOwned: number
  /** How many of those the engine can assign for the window. */
  readonly unitsFree: number
  /** Units rejected because another booking holds them across the window. */
  readonly unitsHeld: number
  /**
   * The bookings holding them, by `bookings.booking_no`, de-duplicated and
   * sorted. The one fact that tells a coordinator what to do next — the same
   * reasoning `lib/availability.ts:explainShortfall` gives for naming them.
   */
  readonly heldBy: readonly string[]
}

/**
 * The rule half — **pure**, so the windowed answer is drivable by execution in
 * a test with no database. Everything below it is the read.
 *
 * `needed` is `owned.length` rather than any particular line's quantity, the
 * same probe `bundleRecords.lineOf` uses and for the same reason: it makes
 * `assigned.length` the TRUE count of free units, so the catalogue can print
 * "2 of 4 free for these dates" instead of capping at whatever one line
 * happened to ask for. `selectUnitsForLine` refuses `needed < 1`, so an empty
 * pool short-circuits rather than being answered.
 */
export function productAvailabilityFor(
  productId: string,
  pool: readonly UnitCandidate[],
  holds: readonly UnitHold[],
  window: RentalWindow,
  rules: { disqualifyingStates: ReadonlySet<string>; bounds: BoundConvention },
): ProductWindowAvailability {
  const owned = pool.filter((unit) => !isRetired(unit))

  const outcome: AssignmentOutcome =
    owned.length === 0
      ? { assigned: [], shortfall: 0, rejected: [] }
      : selectUnitsForLine({
          needed: owned.length,
          window,
          candidates: owned,
          holds,
          disqualifyingStates: rules.disqualifyingStates,
          bounds: rules.bounds,
        })

  const heldBy = new Set<string>()
  let unitsHeld = 0
  for (const rejection of outcome.rejected) {
    if (rejection.reason.kind !== 'held') continue
    unitsHeld += 1
    heldBy.add(rejection.reason.by.bookingNo)
  }

  return {
    productId,
    mode: 'unit',
    unitsOwned: owned.length,
    unitsFree: outcome.assigned.length,
    unitsHeld,
    heldBy: [...heldBy].sort((a, b) => a.localeCompare(b)),
  }
}


/**
 * The quantity half — bulk stock, compared against the peak of its holds.
 *
 * RULING 2026-09-09 (R-37): bulk stock gets a real windowed answer instead of
 * silence. Revert = delete this function and send every product down the unit
 * path, which reports `unitsOwned: 0` for all 204 live products.
 *
 * ## Why this exists, and why it did not before
 *
 * The header above used to say bulk stock gets `unitsOwned: 0` and no verdict,
 * because "a bulk count is not an availability answer". That was true when this
 * module was written: there was no way to ask what a quantity-tracked product
 * had promised, so reporting the raw stock as free would have invented capacity.
 *
 * The engine grew that half on 7 Sep 2026 — `readQuantityHolds` reads the
 * model-level rows `readHolds` deliberately skips, and `capacityFor` computes
 * `total_quantity − peakHeld` under the same bounds convention. So the answer
 * now exists and the silence is no longer honest.
 *
 * It matters more than the unit half does. **Live has 204 quantity-tracked
 * products and zero `product_units` rows**, so on production every catalogue
 * row goes down THIS path and none goes down the other one. A module that
 * answers only for serials answers for nothing that is actually in the
 * business.
 *
 * ## `qtyRequested: 1`
 *
 * `capacityFor` is a per-LINE question ("can I have 3 of these between these
 * instants") and this is a per-PRODUCT one ("how many could I have"). Asking
 * for one is the smallest legal ask — the function refuses `< 1` — and `free`
 * is computed from `totalQuantity − peakHeld` independently of it, so the
 * number returned here is the true ceiling rather than one line's verdict. The
 * caller compares it against whatever quantity it actually wants, which is the
 * same arithmetic the unit branch leaves to its caller.
 *
 * ## `unitsHeld` is a peak, not a sum
 *
 * Two holds of 2 that do not overlap each other claim 2 at once, not 4. That is
 * `capacityFor`'s `peakHeld`, and it is the figure the database's own capacity
 * trigger compares against — so this previews the question Postgres will ask
 * rather than a stricter one that would refuse bookings it would allow.
 */
export function productCapacityFor(
  productId: string,
  totalQuantity: number,
  holds: readonly QuantityHold[],
  window: RentalWindow,
  rules: { disqualifyingStates: ReadonlySet<string>; bounds: BoundConvention },
): ProductWindowAvailability {
  const outcome = capacityFor({
    window,
    holds,
    totalQuantity,
    qtyRequested: 1,
    bounds: rules.bounds,
  })

  /* Only the holds that actually touch the window are named. `capacityFor`
     already ignores the rest when it computes the peak, and naming a booking
     that does not overlap would send a coordinator to the wrong one. */
  const heldBy = new Set<string>()
  for (const hold of holds) {
    if (windowsOverlap(window, hold.window, rules.bounds)) heldBy.add(hold.bookingNo)
  }

  return {
    productId,
    mode: 'quantity',
    unitsOwned: outcome.totalQuantity,
    unitsFree: outcome.free,
    unitsHeld: outcome.peakHeld,
    heldBy: [...heldBy].sort((a, b) => a.localeCompare(b)),
  }
}

/**
 * Every named product's availability for `window`, in one pair of reads.
 *
 * Two queries for the whole list rather than one pair per row — `readCandidates`
 * takes every product id at once and `readHolds(null)` is the tentative-booking
 * read built for exactly this case (there is no booking of ours to exclude yet).
 * That is what makes this affordable to run behind a catalogue the operator is
 * typing into, which the old header of `equipmentResultsFrom` gave as the reason
 * for not consulting the window at all.
 *
 * **Throws** on a failed read rather than returning an empty map. An empty map
 * is indistinguishable from "every product has no units", and the caller renders
 * that as a state of its own ("could not check") — so the failure has to arrive
 * as a failure. `planCreationUnits` swallows its reads for the opposite reason:
 * it must never block a write. This one only feeds a screen.
 */
export async function readProductAvailability(
  window: RentalWindow,
  productIds: readonly string[],
): Promise<Map<string, ProductWindowAvailability>> {
  const out = new Map<string, ProductWindowAvailability>()
  const ids = [...new Set(productIds)]
  if (ids.length === 0) return out

  const [candidatesByProduct, holds, quantityHolds, modes] = await Promise.all([
    readCandidates(ids),
    readHolds(null),
    readQuantityHolds(ids, null),
    readProductModes(ids),
  ])
  /* Read ONCE for the whole list, not per product: a rule changed mid-loop
     would answer the first half of the catalogue under one policy and the rest
     under another — the same reasoning `planAssignment` states per plan. */
  const rules = availabilityRules()

  for (const id of ids) {
    const mode = modes.get(id)
    /* Explicitly bulk, or else the unit path. `readProductModes` already turns a
       null `tracking_mode` into `Serialised` and says why: the unit path can only
       ever refuse, which is the safe direction. Defaulting the OTHER way here
       would undo that, because the quantity path needs a ceiling and would read
       an absent one as stock nobody counted. A product the modes read did not
       return at all lands here too, with an empty pool and no capacity. */
    const bulk = mode?.trackingMode === 'Quantity' || mode?.trackingMode === 'Consumable'
    out.set(
      id,
      bulk
        ? productCapacityFor(id, mode?.totalQuantity ?? 0, quantityHolds.get(id) ?? [], window, rules)
        : productAvailabilityFor(id, candidatesByProduct.get(id) ?? [], holds, window, rules),
    )
  }
  return out
}
</file>

<file path="src/lib/queries/productDeposits.ts">
import { supabase } from '../supabase'
import { captureError } from '../monitoring'
import type { ProductDepositTerms } from '../productDeposit'

/**
 * Deposit terms for the products on a booking (C6, see `lib/productDeposit.ts`).
 *
 * Reads `products_v`, never `products`: `deposit_percent`, `deposit_fixed` and
 * `replacement_value` are money columns and the view masks them to `null` for a
 * money-blind session (Law 6). That `null` means "this session may not see it",
 * never "free" — `unitDepositPaisa` turns it into "asks for nothing", which
 * leaves the existing flat deposit rule standing.
 *
 * A failed read throws to the caller. Swallowing it here would silently weaken a
 * deposit to the flat rule with no one told; the caller decides how to say so.
 */

type Row = {
  id: string
  replacement_value: number | string | null
  deposit_percent: number | string | null
  deposit_fixed: number | string | null
}

const toPaisa = (v: number | string | null): number | null => {
  if (v === null || v === undefined) return null
  const n = Number(v)
  return Number.isFinite(n) ? Math.round(n * 100) : null
}

const toNumber = (v: number | string | null): number | null => {
  if (v === null || v === undefined) return null
  const n = Number(v)
  return Number.isFinite(n) ? n : null
}

export async function fetchProductDepositTerms(
  productIds: readonly string[],
): Promise<Map<string, ProductDepositTerms>> {
  const ids = [...new Set(productIds.filter(Boolean))]
  const out = new Map<string, ProductDepositTerms>()
  if (ids.length === 0) return out

  const { data, error } = await supabase
    .from('products_v')
    .select('id, replacement_value, deposit_percent, deposit_fixed')
    .in('id', ids)

  if (error) {
    captureError(new Error(`product deposit read failed: ${error.message}`), { where: 'productDeposits.fetch' })
    throw new Error(error.message)
  }

  for (const row of (data ?? []) as unknown as Row[]) {
    out.set(row.id, {
      fixedPaisa: toPaisa(row.deposit_fixed),
      percent: toNumber(row.deposit_percent),
      replacementPaisa: toPaisa(row.replacement_value),
    })
  }
  return out
}
</file>

<file path="src/lib/queries/productPricingTerms.ts">
import { supabase } from '../supabase'
import { rupees } from '../money'
import type { PricingRule, PricingStructure } from '../pricingStructures'

/**
 * A product's structure and ruleset, read for the quote engine (`lib/pricingStructures.ts`, G3 / 0160).
 *
 * RLS (0160) returns nothing to a money-blind role, so for them `fetchProductPricingTerms` is an empty map
 * and the screen falls back to the flat rate — which is also all they could see.
 * Retired tiles and rules are dropped here; nothing is deleted, it is simply no longer priced from.
 */
export interface ProductPricingTerms {
  readonly structure: PricingStructure | null
  readonly rules: readonly PricingRule[]
}

interface TileRow { duration_days: number; amount: number | string; retired_at: string | null }
interface StructureRow { id: string; extra_day_amount: number | string | null; retired_at: string | null; tiles: TileRow[] | null }
interface RuleRow {
  sort_order: number; kind: 'charge' | 'price'; name: string; charge_action: string | null
  pickup_after: string | null; return_before: string | null; percent: number | string | null
  weekdays: number[] | null; valid_from: string | null; valid_to: string | null
  apply_when: 'overlaps' | 'fits_within' | 'spans'; stack: boolean; retired_at: string | null
}
interface RulesetRow { id: string; retired_at: string | null; rules: RuleRow[] | null }

const hhmm = (t: string | null): string | undefined => (t ? t.slice(0, 5) : undefined)

export function structureFromRow(row: StructureRow): PricingStructure | null {
  if (row.retired_at) return null
  const tiles = (row.tiles ?? [])
    .filter((t) => !t.retired_at)
    .map((t) => ({ days: t.duration_days, pricePaisa: rupees(Number(t.amount)) as number }))
  if (tiles.length === 0) return null
  return {
    tiles,
    extraDayPaisa: row.extra_day_amount === null || row.extra_day_amount === undefined ? null : (rupees(Number(row.extra_day_amount)) as number),
  }
}

export function rulesFromRow(row: RulesetRow): PricingRule[] {
  if (row.retired_at) return []
  return (row.rules ?? [])
    .filter((r) => !r.retired_at)
    .sort((a, b) => a.sort_order - b.sort_order)
    .map((r): PricingRule => {
      if (r.kind === 'charge') {
        const pickupAfter = hhmm(r.pickup_after)
        const returnBefore = hhmm(r.return_before)
        return {
          kind: 'charge',
          action: r.charge_action === 'skip_return_day' ? 'skip_return_day' : 'skip_pickup_day',
          ...(pickupAfter ? { pickupAfter } : {}),
          ...(returnBefore ? { returnBefore } : {}),
        }
      }
      return {
        kind: 'price',
        name: r.name,
        percent: Number(r.percent ?? 0),
        applyWhen: r.apply_when,
        stack: r.stack,
        ...(r.weekdays && r.weekdays.length > 0 ? { weekdays: r.weekdays } : {}),
        ...(r.valid_from ? { from: r.valid_from } : {}),
        ...(r.valid_to ? { to: r.valid_to } : {}),
      }
    })
}

export async function fetchProductPricingTerms(productIds: readonly string[]): Promise<Map<string, ProductPricingTerms>> {
  const out = new Map<string, ProductPricingTerms>()
  if (productIds.length === 0) return out
  const { data, error } = await supabase
    .from('products')
    .select(
      'id, structure:pricing_structures ( id, extra_day_amount, retired_at, tiles:pricing_structure_tiles ( duration_days, amount, retired_at ) ), ' +
        'ruleset:pricing_rulesets ( id, retired_at, rules:pricing_rules ( sort_order, kind, name, charge_action, pickup_after, return_before, percent, weekdays, valid_from, valid_to, apply_when, stack, retired_at ) )',
    )
    .in('id', [...productIds])
  if (error) throw new Error(`Could not read product pricing terms: ${error.message}`)
  for (const row of (data ?? []) as unknown as Array<{ id: string; structure: StructureRow | null; ruleset: RulesetRow | null }>) {
    const structure = row.structure ? structureFromRow(row.structure) : null
    const rules = row.ruleset ? rulesFromRow(row.ruleset) : []
    if (structure || rules.length > 0) out.set(row.id, { structure, rules })
  }
  return out
}
</file>

<file path="src/lib/queries/purchaseRequests.ts">
import { supabase } from '../supabase'
import { rupees } from '../money'
import type { Paisa } from '../money'
import type { ListFilters } from './listQuery'
import { useList, type ListQueryResult, type ListResult } from './useList'
import type { PurchaseRequest, PRStatus, PRReason } from '../../data/purchaseRequests'

/**
 * # Purchase requests, the real ones
 *
 * `modules/inventory/PurchaseRequests.tsx` read `data/purchaseRequests.ts`'s
 * `PURCHASE_REQUESTS` — hand-written rows — while its approve/reject decisions
 * wrote to Postgres (`PurchaseRequests.tsx:257`). An operator approved a request
 * and the list never changed. Same read-frozen / write-live split as the Bundles
 * list, fixed the same way.
 *
 * ## Four reads, not one embed
 *
 * `purchase_requests` names a product, a supplier, a requester and an approver.
 * Only the product is awkward: **`0062_law6_column_grants_arm_the_mask.sql`
 * revokes table-level SELECT on `products`**, so the name and category are
 * reachable only through `products_v` — the same reason `queries/bundles.ts`
 * splits its reads rather than embedding, and its header is the long version of
 * this note.
 *
 * `requested_by` and `approved_by` are **two FKs to the same table**, which
 * PostgREST can only disambiguate with explicit constraint hints and the mock
 * engine's `REL` map cannot express at all (it is keyed `parent.table`). Reading
 * `users` once by id set sidesteps that instead of encoding a fragile hint.
 *
 * ## What has no source, and is therefore absent
 *
 * The spec's §6 priority formula is
 * `(refused_bookings × 2) + sub_rental_events + (sub_rental_cost / cost × 10)`.
 * **None of its three inputs exists.** There is no refused-booking table, no
 * sub-rental table, and no column on `purchase_requests` holding either count —
 * checked across every migration.
 *
 * So `priority` and `priorityScore` come back **`null`**, and the screen says
 * "Not scored" rather than printing `Low`. That is not a missing feature being
 * hidden: scoring every live request `Low` would rank a genuinely urgent
 * purchase below a trivial one, which is worse than declining to rank. The
 * evidence arrays are empty for the same reason, and the panel that lists them
 * says so.
 *
 * `notes` has no column either. `dateDecided*` is deliberately NOT taken from
 * `updated_at`: that column moves on any edit, so using it would date a decision
 * to the last time anyone touched the row.
 */

interface PurchaseRequestRow {
  id: string
  pr_no: string
  product_id: string
  supplier_id: string | null
  quantity: number
  estimated_unit_cost: number | null
  total_estimated_cost: number | null
  reason_type: string
  urgency: string
  status: string
  requested_by: string
  approved_by: string | null
  rejection_reason: string | null
  created_at: string
}

const PR_COLUMNS =
  'id, pr_no, product_id, supplier_id, quantity, estimated_unit_cost, total_estimated_cost, ' +
  'reason_type, urgency, status, requested_by, approved_by, rejection_reason, created_at'

/** `products_v` — never `products`; see the header on 0062. */
async function readProductFacts(ids: readonly string[]): Promise<Map<string, { name: string; category: string | null }>> {
  const out = new Map<string, { name: string; category: string | null }>()
  if (ids.length === 0) return out

  const { data, error } = await supabase
    .from('products_v')
    .select('id, name, category:inventory_categories ( name )')
    .in('id', [...new Set(ids)])

  if (error) throw new Error(`listPurchaseRequests could not read the requested products: ${error.message}`)

  for (const row of (data ?? []) as unknown as Array<{
    id: string
    name: string
    category: { name: string } | null
  }>) {
    out.set(row.id, { name: row.name, category: row.category?.name ?? null })
  }
  return out
}

async function readSupplierNames(ids: readonly string[]): Promise<Map<string, string>> {
  const out = new Map<string, string>()
  if (ids.length === 0) return out

  const { data, error } = await supabase.from('suppliers').select('id, name').in('id', [...new Set(ids)])
  if (error) throw new Error(`listPurchaseRequests could not read the suppliers: ${error.message}`)

  for (const row of (data ?? []) as unknown as Array<{ id: string; name: string }>) out.set(row.id, row.name)
  return out
}

async function readUserNames(ids: readonly string[]): Promise<Map<string, string>> {
  const out = new Map<string, string>()
  if (ids.length === 0) return out

  const { data, error } = await supabase.from('users').select('id, full_name').in('id', [...new Set(ids)])
  if (error) throw new Error(`listPurchaseRequests could not read who raised these requests: ${error.message}`)

  for (const row of (data ?? []) as unknown as Array<{ id: string; full_name: string | null }>) {
    if (row.full_name !== null) out.set(row.id, row.full_name)
  }
  return out
}

const money = (v: number | null): Paisa => rupees(v ?? 0)

/**
 * Every purchase request, newest first.
 *
 * Law 3 — nothing is filtered out by status. `Rejected` and `Cancelled` are
 * terminal states a request KEEPS, and the screen has chips for both; hiding
 * them here would make the chip counts lie.
 */
export async function listPurchaseRequests(limit = 200): Promise<PurchaseRequest[]> {
  const { data, error } = await supabase
    .from('purchase_requests_v')
    .select(PR_COLUMNS)
    .order('created_at', { ascending: false })
    .limit(limit)

  if (error) throw new Error(`listPurchaseRequests failed: ${error.message}`)

  const rows = (data ?? []) as unknown as PurchaseRequestRow[]
  if (rows.length === 0) return []

  const [products, suppliers, users] = await Promise.all([
    readProductFacts(rows.map((r) => r.product_id)),
    readSupplierNames(rows.map((r) => r.supplier_id).filter((v): v is string => v !== null)),
    readUserNames([
      ...rows.map((r) => r.requested_by),
      ...rows.map((r) => r.approved_by).filter((v): v is string => v !== null),
    ]),
  ])

  return rows.map((r): PurchaseRequest => {
    const product = products.get(r.product_id)
    const supplierName = r.supplier_id === null ? undefined : suppliers.get(r.supplier_id)
    const decidedBy = r.approved_by === null ? undefined : users.get(r.approved_by)

    return {
      id: r.id,
      prNo: r.pr_no,
      fleetItemId: r.product_id,
      /* Named, never blank. A request whose product row this session cannot read
         is a real RLS state, and the operator must see that rather than an empty
         cell that looks like a rendering fault. */
      fleetItemName: product?.name ?? `Unreadable product ${r.product_id.slice(0, 8)}`,
      category: product?.category ?? 'Uncategorised',
      requestedQty: r.quantity,
      /* The enum's members are these three strings exactly (`0001:645`), so the
         cast is a narrowing, not a translation. */
      reason: r.reason_type as PRReason,
      estimatedUnitCost: money(r.estimated_unit_cost),
      totalEstimatedCost: money(r.total_estimated_cost),
      /* No source — see the header. Zero here means "no evidence recorded",
         which is why `priority` is null rather than the `Low` these would score. */
      totalSubRentPaid: rupees(0),
      refusedCount: 0,
      subRentCount: 0,
      priorityScore: null,
      priority: null,
      ...(supplierName === undefined ? {} : { suggestedSupplier: supplierName }),
      status: r.status as PRStatus,
      requestedBy: users.get(r.requested_by) ?? 'Unknown',
      ...(decidedBy === undefined ? {} : { decidedBy }),
      ...(r.rejection_reason === null ? {} : { decisionReason: r.rejection_reason }),
      dateCreatedAD: r.created_at.slice(0, 10),
      /* BS is rendered, never stored — the screen converts for display. */
      dateCreatedBS: '',
      refusedBookings: [],
      subRentals: [],
    }
  })
}

async function fetchPurchaseRequests(_filters: ListFilters): Promise<ListQueryResult<PurchaseRequest>> {
  const rows = await listPurchaseRequests()
  return { rows, total: rows.length }
}

/** The screen's rows. Filtering and chips are the screen's own, over the full set. */
