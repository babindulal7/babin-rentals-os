  padding: 0.5rem 0.875rem;
  background: var(--surface, #0f172a);
  border: 1px solid var(--border, rgba(255, 255, 255, 0.12));
  border-radius: var(--r-btn, 8px);
  color: var(--text, #f8fafc);
  font-size: 0.8125rem;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  box-shadow: var(--shadow-sm);
  min-height: 44px;
  transition: all 0.15s ease;
}

.auth-mock-btn:hover {
