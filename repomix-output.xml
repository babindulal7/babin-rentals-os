<file path="src/lib/queries/bundleRecords.ts">
import { supabase } from '../supabase'
import { rupees } from '../money'
import { listBundlesWithItems } from './bundles'
import type { BundleWithItems, BundleComponent, ListBundlesOptions } from './bundles'
import { availabilityRules, readCandidates, readHolds, readProductModes, readQuantityHolds } from './availability'
import { productCapacityFor } from './productAvailability'
import { selectUnitsForLine, isRetired } from '../availability'
import type { RentalWindow, UnitCandidate, UnitHold, AssignmentOutcome } from '../availability'
import type { BundleRecord, BundleLine, BundleBooking, BlockedBy } from '../../data/bundles'

/**
 * # The Bundles pane's records, from the database, for a stated window
 *
 * `modules/inventory/Bundles.tsx` consumed `data/bundles.ts`'s `ACTIVE_BUNDLES`
 * — nine hand-written literals — while `actions/inventory/createBundle.ts` wrote
 * real rows. A bundle you created could never appear on the screen that lists
 * bundles. This module is the other half of that wire: it returns the same
 * `BundleRecord` shape the pane and `factsOf` already consume, so the screen's
 * derivations, chips and donut are untouched.
 *
 * ## Why a window is a required argument
 *
 * **PLAN.md §4.44, ruled 4 Sep 2026 (option b).** `BundleLine.unitsAvailable` is
 * not a property of a bundle — it is the answer to "free *when*?". The seed
 * baked in a single figure as though the question had one answer; wiring that to
 * live data without a window would have made every un-booked bundle render
 * `Available`, a confident claim that all of its gear is free, on the screen an
 * operator uses to promise kit to a client.
 *
 * So the window is a parameter with no default. A caller that does not know
 * which window it means cannot call this, which is the intended pressure.
 *
 * ## What is derived, and what is simply absent
 *
 * Availability comes from the real engine — `readCandidates` + `readHolds` feed
 * `selectUnitsForLine`, the same path `planCreationUnits` uses to assign units
 * at creation, under the same §4.30 rules. Nothing is re-implemented here.
 *
 * These `BundleRecord` fields have **no column anywhere** and are therefore left
 * empty rather than guessed (§4.44's closing note):
 *
 * | Field | Why absent |
 * |---|---|
 * | `tags` | no column on `bundles` |
 * | `lockMode` | no column; `data/bundles.ts` calls Virtual the default |
 * | `nextConflictAd` | the seed itself says it "is seeded, not computed" |
 * | `substitutes` · `replaceable` | no column on `bundle_items` |
 * | `kind` other than `equipment` | `bundle_items.product_id` is `not null references products`, so a live bundle **cannot** hold a crew, vehicle or box line |
 *
 * `weightKg` is likewise absent, so `factsOf`'s `totalWeightKg` reads `null` —
 * its own "only when every line knows" rule, reached honestly.
 */

/** How a rejected unit's reason maps onto the three words the donut counts. */
function blockedByOf(outcome: AssignmentOutcome, now: number): { blockedBy?: BlockedBy; freesAd?: Date } {
  let earliestFree: number | null = null
  let held = false
  let maintenance = false

  for (const rejection of outcome.rejected) {
    if (rejection.reason.kind === 'held') {
      held = true
      const end = Date.parse(rejection.reason.by.window.toAd)
      if (earliestFree === null || end < earliestFree) earliestFree = end
      continue
    }
    if (rejection.reason.kind === 'state' && rejection.reason.state === 'Maintenance') maintenance = true
  }

  /*
   * Precedence, and the gap in it.
   *
   * A held unit outranks a maintenance one because "it is with a client until
   * the 3rd" is the more actionable sentence. `On Rent` vs `Reserved` is decided
   * by whether the hold has actually started — a future commitment is not out.
   *
   * `Missing` and `Retired` are the gap: they are in `DISQUALIFYING_UNIT_STATES`
   * and genuinely reduce availability, but `BlockedBy` has no member for either,
   * so a line short only for those reasons carries NO `blockedBy`. That is
   * deliberate. Attributing lost gear to `On Maintenance` would put a wrong word
   * on screen, and the pane already has a reconcile note for counts that do not
   * add up. Adding a fourth `BlockedBy` member changes the donut's four fixed
   * segments and is a spec question, not a wiring one.
   */
  if (held) {
    const started = earliestFree !== null && outcome.rejected.some(
      (r) => r.reason.kind === 'held' && Date.parse(r.reason.by.window.fromAd) <= now,
    )
    return {
      blockedBy: started ? 'On Rent' : 'Reserved',
      ...(earliestFree === null ? {} : { freesAd: new Date(earliestFree) }),
    }
  }
  if (maintenance) return { blockedBy: 'On Maintenance' }
  return {}
}

/** One component's line, with availability measured against `window`. */
function lineOf(
  item: BundleComponent,
  pool: readonly UnitCandidate[],
  holds: readonly UnitHold[],
  window: RentalWindow,
  now: number,
): BundleLine {
  const rules = availabilityRules()
  /* `unitsStock` is "units owned" (`data/bundles.ts:51`), so a retired unit is
     not stock — the business no longer has it. Everything else counts, including
     units that are merely busy; that is what makes `x of y available` a sentence
     worth printing. */
  const owned = pool.filter((unit) => !isRetired(unit))

  /*
   * Asking for `owned.length` rather than `item.quantity` is deliberate: it
   * makes `assigned.length` the TRUE number of free units, so the preview can
   * say "1 of 3 available" rather than capping at what this bundle happens to
   * need. `factsOf` clamps with `min`/`max` anyway, so the derived counts are
   * identical either way — only the printed pair differs.
   */
  const outcome =
    owned.length === 0
      ? ({ assigned: [], shortfall: item.quantity, rejected: [] } as AssignmentOutcome)
      : selectUnitsForLine({
          needed: owned.length,
          window,
          candidates: owned,
          holds,
          disqualifyingStates: rules.disqualifyingStates,
          bounds: rules.bounds,
        })

  const unitsAvailable = outcome.assigned.length
  const short = unitsAvailable < item.quantity

  return {
    /* The preview tree's heading. The product's own category is the only
       grouping the live model has; §4.44 records that Crew / Vehicle /
       Boxes & Bags cannot arise here at all. */
    group: item.category ?? 'Uncategorised',
    model: item.productName,
    productId: item.productId,
    kind: 'equipment',
    quantity: item.quantity,
    unitsStock: owned.length,
    unitsAvailable,
    /* Asserted by the seed's own invariant: set only where the line is short. */
    ...(short ? blockedByOf(outcome, now) : {}),
    /* Money, and `null` is not zero — `queries/bundles.ts`'s header. A
       money-blind session gets 0 here, which makes `factsOf`'s sum-of-parts and
       saving meaningless for that session; the pane gates every money figure on
       the same flag before rendering, so those numbers are never shown to it. */
    unitRatePaisa: item.dailyRate ?? rupees(0),
  }
}

interface BookingLineRow {
  bundle_id: string | null
  bookings: {
    booking_no: string
    pickup_at: string | null
    return_at: string | null
    clients: { name: string } | null
  } | null
}

/**
 * The live commitment against each bundle, via **`booking_lines.bundle_id`** —
 * a real FK since `0042:52`, which is why `BundleRecord.booking` is sourceable
 * at all and `factsOf`'s `On Rent` / `Reserved` states are not guesses.
 *
 * Law 3 — a removed line is `voided_at`, never deleted, and a voided line
 * commits nothing. A bundle carrying several live lines keeps the one that is
 * out now, else the soonest future one, because that is the commitment an
 * operator is about to trip over.
 */
async function readBundleBookings(bundleIds: readonly string[], now: number): Promise<Map<string, BundleBooking>> {
  const out = new Map<string, BundleBooking>()
  if (bundleIds.length === 0) return out

  const { data, error } = await supabase
    .from('booking_lines')
    .select('bundle_id, bookings ( booking_no, pickup_at, return_at, clients ( name ) )')
    .in('bundle_id', [...new Set(bundleIds)])
    .is('voided_at', null)

  if (error) throw new Error(`Could not read the bookings holding these bundles: ${error.message}`)

  for (const row of (data ?? []) as unknown as BookingLineRow[]) {
    const b = row.bookings
    if (row.bundle_id === null || b === null || b.pickup_at === null || b.return_at === null) continue

    const startAd = new Date(b.pickup_at)
    const endAd = new Date(b.return_at)
    if (Number.isNaN(startAd.getTime()) || Number.isNaN(endAd.getTime())) continue
    /* Already handed back: not a commitment any more, and not this screen's
       business. Only `out` and `reserved` are states `BundleBooking` can hold. */
    if (endAd.getTime() < now) continue

    const candidate: BundleBooking = {
      id: b.booking_no,
      client: b.clients?.name ?? 'Unnamed client',
      startAd,
      endAd,
      state: startAd.getTime() <= now ? 'out' : 'reserved',
    }

    const held = out.get(row.bundle_id)
    if (
      held === undefined ||
      (held.state === 'reserved' && candidate.state === 'out') ||
      (held.state === candidate.state && candidate.startAd.getTime() < held.startAd.getTime())
    ) {
      out.set(row.bundle_id, candidate)
    }
  }
  return out
}

export interface ListBundleRecordsOptions {
  /** One bundle only, by code or uuid — see `ListBundlesOptions.bundleRef`. */
  bundleRef?: string
  /**
   * Include each component's `daily_rate`. **Money.** Pass the caller's own
   * money gate — never a literal `true`.
   */
  withMoney?: boolean
  limit?: number
}

/**
 * Every bundle — live and archived — as the pane's own record shape, with
 * availability measured against `window`.
 *
 * Two reads beyond `listBundlesWithItems`: the candidate units for every product
 * any bundle names, and every live hold. Both are fetched once for the whole
 * list rather than per bundle.
 *
 * Bundles are evaluated **independently of one another**: two bundles that both
 * name the last free camera are both reported as covering it. That is correct
 * for a catalogue — only one of them will be booked — and is why this does not
 * carry `planCreationUnits`'s cross-line `claimed` set. Within a single bundle
 * the pool IS shared, so one free unit never covers two of its lines.
 */
export async function listBundleRecords(
  window: RentalWindow,
  opts: ListBundleRecordsOptions = {},
): Promise<BundleRecord[]> {
  /* Built up rather than written inline: `exactOptionalPropertyTypes` is on,
     so passing `withMoney: undefined` is not the same as omitting it. */
  const listOpts: ListBundlesOptions = { includeArchived: true }
  if (opts.withMoney !== undefined) listOpts.withMoney = opts.withMoney
  if (opts.limit !== undefined) listOpts.limit = opts.limit
  if (opts.bundleRef !== undefined) listOpts.bundleRef = opts.bundleRef

  const bundles: BundleWithItems[] = await listBundlesWithItems(listOpts)
  if (bundles.length === 0) return []

  const productIds = [...new Set(bundles.flatMap((b) => b.items.map((i) => i.productId)))]
  const [candidatesByProduct, holds, bookings, modes, quantityHolds] = await Promise.all([
    readCandidates(productIds),
    readHolds(null),
    readBundleBookings(bundles.map((b) => b.id), Date.parse(window.fromAd)),
    readProductModes(productIds),
    readQuantityHolds(productIds, null),
  ])

  const now = Date.parse(window.fromAd)

  /*
   * RULING 2026-10-07 — found by driving New Rental against live: every bundle read "Unavailable ·
   * N of N items unavailable" while each of its components, one row below, read "10 of 10 free for
   * these dates". `lineOf` only counts serialised `product_units`, and live's 204 products are all
   * quantity-tracked with zero unit rows, so a bulk component always came back 0 free.
   *
   * A bulk (Quantity / Consumable) component is now answered by the same `productCapacityFor` the
   * catalogue rows use — total stock less the peak of overlapping holds — so the bundle verdict and
   * its components cannot disagree. Serialised components are unchanged.
   */
  const rules = availabilityRules()
  const bulkFree = new Map<string, number>()
  for (const id of productIds) {
    const mode = modes.get(id)
    if (mode?.trackingMode !== 'Quantity' && mode?.trackingMode !== 'Consumable') continue
    const a = productCapacityFor(id, mode.totalQuantity ?? 0, quantityHolds.get(id) ?? [], window, rules)
    bulkFree.set(id, a.unitsFree)
  }

  return bundles.map((b): BundleRecord => {
    /* Shared within the bundle, so a `qty: 2` line cannot be covered twice by
       one unit, and two lines naming the same product compete honestly. */
    const claimed = new Set<string>()
    /* Bulk stock is shared within the bundle exactly as serialised units are: two lines naming the
       same product cannot both count the same free units. */
    const bulkUsed = new Map<string, number>()
    const lines = b.items.map((item) => {
      const free = bulkFree.get(item.productId)
      if (free !== undefined) {
        const mode = modes.get(item.productId)
        const left = Math.max(0, free - (bulkUsed.get(item.productId) ?? 0))
        bulkUsed.set(item.productId, (bulkUsed.get(item.productId) ?? 0) + Math.min(left, item.quantity))
        const base = lineOf(item, [], holds, window, now)
        const { blockedBy: _none, freesAd: _noDate, ...rest } = base
        void _none
        void _noDate
        return {
          ...rest,
          unitsStock: mode?.totalQuantity ?? 0,
          unitsAvailable: left,
          /* Short because other bookings hold the stock — the only reason a bulk line is short. */
          ...(left < item.quantity && (quantityHolds.get(item.productId) ?? []).length > 0 ? { blockedBy: 'Reserved' as const } : {}),
        }
      }
      const pool = (candidatesByProduct.get(item.productId) ?? []).filter((u) => !claimed.has(u.unitId))
      const line = lineOf(item, pool, holds, window, now)
      let taken = 0
      for (const unit of pool) {
        if (taken >= Math.min(line.unitsAvailable, item.quantity)) break
        claimed.add(unit.unitId)
        taken += 1
      }
      return line
    })

    const booking = bookings.get(b.id)

    return {
      /* The pane addresses and searches a bundle by its code, and the record's
         `id` is what it renders — matching `ClientRecord`, whose `id` is the
         client code while the uuid travels separately. */
      id: b.bundleCode,
      dbId: b.id,
      bundleCode: b.bundleCode,
      name: b.name,
      category: b.category ?? 'Uncategorised',
      /* No column. §4.44 — absent, not invented. */
      tags: [],
      ...(b.isActive ? {} : { archived: true }),
      ...(booking === undefined ? {} : { booking }),
      bundleRatePaisa: b.dailyRate,
      lines,
    }
  })
}

/**
 * One bundle, for a stated window, or `null` when the reference matches nothing.
 *
 * The narrowing happens in the SQL (`bundleRef` reaches `listBundlesWithItems`'s
 * `.eq`), not by fetching every bundle and filtering in memory — so the detail
 * page reads one row and only the units and holds its own components need.
 *
 * `null` is "no such bundle", never "the read failed": a failure throws, and the
 * screen tells those apart because `PageBody` ranks error above empty.
 */
export async function getBundleRecord(
  ref: string,
  window: RentalWindow,
  opts: ListBundleRecordsOptions = {},
): Promise<BundleRecord | null> {
  const rows = await listBundleRecords(window, { ...opts, bundleRef: ref })
  return rows[0] ?? null
}
</file>

<file path="src/lib/queries/bundles.ts">
import { supabase } from '../supabase'
import { rupees } from '../money'
import type { Paisa } from '../money'

/**
 * # Bundles, with their components — the real ones
 *
 * New Rental persistence spec §22 C2. `AddItemPanel`'s Bundles tab read
 * `src/data/bundles.ts`'s `ACTIVE_BUNDLES` — nine hand-written records whose
 * ids are `BND-23` codes and whose component lines name models by string. None
 * of it can be written to `booking_lines`, which wants `bundles.id` and
 * `products.id` uuids.
 *
 * This is the query that answers the same question from the database:
 * `bundles` + `bundle_items` + the products those items name, plus the unit
 * counts the availability verdict is derived from.
 *
 * ## Three reads, not one embed
 *
 * `bundles → bundle_items` is a real FK and embeds cleanly. `bundle_items →
 * products` is a real FK too, **but `0062_law6_column_grants_arm_the_mask.sql`
 * revokes table-level SELECT on `products`** and hands back the non-money
 * columns only; `daily_rate` — the one figure a bundle component needs — is
 * reachable exclusively through `products_v`. Embedding the base table would
 * therefore work today and 403 the day 0062 lands, which is the failure mode
 * `queries/inventory.ts`'s header already documents for `product_units`.
 *
 * So: bundles+items in one call, then `products_v` for the named products, then
 * `product_units_v` for their units. Three round trips for a list that is
 * fetched once when the booking workspace mounts.
 *
 * ## Money is `Paisa | null`, and the null is load-bearing
 *
 * A `null` `dailyRate` means EITHER "this caller did not ask for money"
 * (`withMoney` false) OR "this session may not see money" (the view masked it).
 * It never means free. Same contract as `InventoryListRow.dailyRate` and
 * `ClientListItem.outstanding`; a screen gates on the role before rendering and
 * must not coerce it to 0 for display.
 *
 * `bundles.daily_rate` IS masked for money-blind roles — this module reads
 * `bundles_v` (0130 armed the base table's money grants), so the advertised
 * rate returns `null` for Warehouse rather than leaking. Money-visible roles
 * get the real figure through the same view.
 */

/** `bundle_items` joined to the product it names. */
export interface BundleComponent {
  /** `bundle_items.id`. */
  itemId: string
  /** `bundle_items.product_id` — a **uuid**, and what a child booking line stores. */
  productId: string
  /** `products.name`, or a stated placeholder when the product could not be read. */
  productName: string
  /** `inventory_categories.name`, the `product_category` enum. Null when unresolved. */
  category: string | null
  brand: string | null
  /** `bundle_items.quantity` — units of this product ONE bundle requires. */
  quantity: number
  /** `bundle_items.days`. Carried but not used as the line's days: the booking's window decides. */
  days: number
  /** `bundle_items.is_mandatory`. An optional component may be toggled off before adding. */
  isMandatory: boolean
  sortOrder: number
  /** `products_v.daily_rate`. **Money** — see the header; null is not zero. */
  dailyRate: Paisa | null
  /** `products.tracking_mode`. */
  trackingMode: string | null
  /** Unit rows this product has, retired included. `0` for a quantity-tracked SKU. */
  unitsTotal: number
  /** Units whose `product_units_v.status` is `In Stock` — present tense, not window-aware. */
  unitsInStock: number
}

export interface BundleWithItems {
  /** `bundles.id` — a **uuid**, and what a Bundle parent line stores in `bundle_id`. */
  id: string
  /** `bundles.bundle_code` — `BND-23`. What the operator reads and searches. */
  bundleCode: string
  name: string
  description: string | null
  category: string | null
  /**
   * `bundles.category_id` — the uuid the NAME above is a display of.
   *
   * Both are returned because they answer different questions: a list renders
   * the name, and an **edit** writes the id (`bundles.category_id` is a uuid FK
   * to `inventory_categories`, 0004:386). Re-resolving the name back to an id at
   * save time is what `createBundle` had to do and documented as a hazard —
   * `inventory_categories` holds six rows while the picker offered sixteen enum
   * labels, so ten of them resolved to nothing. Carrying the id means an edit
   * that does not touch the category cannot lose it.
   */
  categoryId: string | null
  /** `bundles.daily_rate` — the advertised rate the Bundle parent line carries. Never masked. */
  dailyRate: Paisa
  weeklyRate: Paisa
  /**
   * `bundles.is_active`. Law 3 — a retired bundle is `false`, never a deleted
   * row, so "archived" is a value this list carries rather than an absence the
   * caller has to infer. Only populated when `includeArchived` was asked for;
   * without it every row is `true` by construction.
   */
  isActive: boolean
  items: BundleComponent[]
}

interface BundleRow {
  id: string
  bundle_code: string
  name: string
  description: string | null
  daily_rate: number | null
  weekly_rate: number | null
  is_active: boolean
  category_id: string | null
  category: { name: string } | null
  items:
    | Array<{
        id: string
        product_id: string
        quantity: number
        days: number
        is_mandatory: boolean
        sort_order: number
        is_active?: boolean
      }>
    | null
}

const BUNDLE_COLUMNS =
  'id, bundle_code, name, description, daily_rate, weekly_rate, is_active, category_id, ' +
  'category:inventory_categories ( name ), ' +
  'items:bundle_items ( id, product_id, quantity, days, is_mandatory, sort_order, is_active )'
const LEGACY_BUNDLE_COLUMNS =
  'id, bundle_code, name, description, daily_rate, weekly_rate, is_active, category_id, ' +
  'category:inventory_categories ( name ), ' +
  'items:bundle_items ( id, product_id, quantity, days, is_mandatory, sort_order )'

export interface ListBundlesOptions {
  /**
   * Include each component's `daily_rate`. **Money.** Pass the caller's own
   * money gate — never a literal `true`. Without it every `dailyRate` is null,
   * which is the honest reading of "this caller did not ask".
   */
  withMoney?: boolean
  limit?: number
  /**
   * Return retired bundles (`is_active = false`) alongside live ones, tagged by
   * `isActive`. The Bundles pane needs them: its chip row has an **Archived**
   * shelf, and Law 3 means those rows still exist and must still be openable.
   * Default `false` keeps the New Rental picker — the original caller — showing
   * only bundles that can actually be sold.
   */
  includeArchived?: boolean
  /**
   * Narrow to ONE bundle, by `bundle_code` (`BND-23`) **or** `bundles.id` (a uuid).
   *
   * Dispatching on the shape of the reference is this codebase's ruled answer to
   * "the caller may hold either" — `queries/clients.ts:getClientRecord`,
   * `queries/availability.ts:147` and `queries/bookings.ts:1021` all do it, and
   * the 4 Sep P0 (eight links passing a uuid into a code-only lookup) is why.
   *
   * Nothing produces a bundle uuid for the UI today: `bundleRecords.ts` maps
   * `id: b.bundleCode` and drops the uuid, so every link carries a code. The
   * uuid branch costs one regex and means a future caller holding the uuid
   * cannot reintroduce that bug.
   */
  bundleRef?: string
}

/** `bundles.id` is a uuid; `bundle_code` is `^BND-[0-9]+$`. They cannot collide. */
const BUNDLE_UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i

/**
 * Active bundles with their components resolved to real products.
 *
 * Law 3 — an inactive bundle is retained, never deleted, so it is filtered here
 * rather than expected to be absent. Archived/retired bundles are simply
 * `is_active = false`.
 */
export async function listBundlesWithItems(opts: ListBundlesOptions = {}): Promise<BundleWithItems[]> {
  const readBundles = async (columns: string) => {
    let query = supabase.from('bundles_v').select(columns)
    /* Law 3 — an inactive bundle is retained, never deleted, so it is filtered
       here rather than expected to be absent. */
    if (opts.includeArchived !== true) query = query.eq('is_active', true)
    if (opts.bundleRef !== undefined) {
      query = query.eq(BUNDLE_UUID_RE.test(opts.bundleRef) ? 'id' : 'bundle_code', opts.bundleRef)
    }
    return await query.order('name', { ascending: true }).limit(opts.limit ?? 200)
  }

  let result = await readBundles(BUNDLE_COLUMNS)
  // 0134 added soft-deactivation to bundle_items. Older connected databases
  // have no such column, so every existing component is active by definition.
  // Retry only that missing-column error; all other read failures stay visible.
  if (result.error && /column bundle_items(?:_\d+)?\.is_active does not exist/.test(result.error.message)) {
    result = await readBundles(LEGACY_BUNDLE_COLUMNS)
  }
  const { data, error } = result

  if (error) throw new Error(`listBundlesWithItems failed: ${error.message}`)

  const bundles = (data ?? []) as unknown as BundleRow[]
  if (bundles.length === 0) return []

  const productIds = [
    ...new Set(
      bundles
        .flatMap((b) => (b.items ?? []).filter((i) => i.is_active !== false).map((i) => i.product_id))
        .filter(Boolean),
    ),
  ]

  const [products, units] = await Promise.all([
    readProducts(productIds, opts.withMoney === true),
    readUnitCounts(productIds),
  ])

  return bundles.map((b) => ({
    id: b.id,
    bundleCode: b.bundle_code,
    name: b.name,
    description: b.description,
    category: b.category?.name ?? null,
    categoryId: b.category_id,
    dailyRate: rupees(b.daily_rate ?? 0),
    weeklyRate: rupees(b.weekly_rate ?? 0),
    isActive: b.is_active,
    items: [...(b.items ?? [])]
      .filter((i) => i.is_active !== false)
      .sort((x, y) => x.sort_order - y.sort_order || x.id.localeCompare(y.id))
      .map((i): BundleComponent => {
        const p = products.get(i.product_id)
        const counts = units.get(i.product_id)
        return {
          itemId: i.id,
          productId: i.product_id,
          /* Named, never blank. A component whose product row could not be read
             is a real (RLS or deleted-catalogue) state, and the operator must
             see that the bundle references something this session cannot see —
             not an empty row that looks like a rendering bug. */
          productName: p?.name ?? `Unreadable product ${i.product_id.slice(0, 8)}`,
          category: p?.category ?? null,
          brand: p?.brand ?? null,
          quantity: i.quantity,
          days: i.days,
          isMandatory: i.is_mandatory,
          sortOrder: i.sort_order,
          dailyRate: p?.dailyRate ?? null,
          trackingMode: p?.trackingMode ?? null,
          unitsTotal: counts?.total ?? 0,
          unitsInStock: counts?.inStock ?? 0,
        }
      }),
  }))
}

interface ProductFacts {
  name: string
  brand: string | null
  category: string | null
  trackingMode: string | null
  dailyRate: Paisa | null
}

async function readProducts(ids: readonly string[], withMoney: boolean): Promise<Map<string, ProductFacts>> {
  const out = new Map<string, ProductFacts>()
  if (ids.length === 0) return out

  const columns =
    'id, name, brand, tracking_mode, category:inventory_categories ( name )' + (withMoney ? ', daily_rate' : '')

  const { data, error } = await supabase.from('products_v').select(columns).in('id', [...ids])
  if (error) throw new Error(`listBundlesWithItems could not read the component products: ${error.message}`)

  for (const row of (data ?? []) as unknown as Array<{
    id: string
    name: string
    brand: string | null
    tracking_mode: string | null
    category: { name: string } | null
    daily_rate?: number | null
  }>) {
    out.set(row.id, {
      name: row.name,
      brand: row.brand,
      category: row.category?.name ?? null,
      trackingMode: row.tracking_mode,
      dailyRate: row.daily_rate === null || row.daily_rate === undefined ? null : rupees(row.daily_rate),
    })
  }
  return out
}

async function readUnitCounts(ids: readonly string[]): Promise<Map<string, { total: number; inStock: number }>> {
  const out = new Map<string, { total: number; inStock: number }>()
  if (ids.length === 0) return out

  const { data, error } = await supabase
    .from('product_units_v')
    .select('id, product_id, status')
    .in('product_id', [...ids])

  if (error) throw new Error(`listBundlesWithItems could not read the component units: ${error.message}`)

  for (const row of (data ?? []) as unknown as Array<{ product_id: string; status: string }>) {
    const entry = out.get(row.product_id) ?? { total: 0, inStock: 0 }
    entry.total += 1
    if (row.status === 'In Stock') entry.inStock += 1
    out.set(row.product_id, entry)
  }
  return out
}

export {
  ACTIVE_BUNDLES,
  ALL_CATEGORIES,
  BUNDLE_STATES,
  factsOf,
  ratioLabelOf,
  iconFor,
  isPriced,
} from '../../data/bundles'
export { bundleGlance, bundleDetailGroups } from '../../data/bundleIntel'
export type { BundleRecord, BundleState, BundleLine, BundleFacts } from '../../data/bundles'
</file>

<file path="src/lib/queries/calendar.ts">
import { supabase } from '../supabase'
import { getSetting } from '../settingsStore'
import { dayStartMinutesFrom, operationalDayOf } from '../operationalDay'
import { todaysOutgoing } from './bookings'
import type { ListFilters } from './listQuery'
import type { ListQueryResult } from './useList'
import type { Database } from '../../types/supabase'
import type { Bar, BarKind } from '../../data/calendar'

/**
 * # The Calendar Workspace's one read
 *
 * `modules/calendar/Calendar.tsx` had **zero** imports from `lib/queries` or
 * `lib/supabase` before this file existed: every bar, every rail figure and
 * every festival on the screen came from `data/calendar.ts`, which is a
 * transcription of two renders. The page sat under today's real date beside a
 * Dashboard reading the live database, and the two contradicted each other.
 *
 * This module is the replacement read. It owns the RULE — which bookings fall
 * in a window and what each one looks like as a bar — so the page owns none of
 * it (Law 1).
 *
 * ## Why this queries Supabase directly instead of going through `listBookings`
 *
 * The question a calendar asks is an **overlap**: *which bookings are on screen
 * between these two days*, i.e.
 *
 *     pickup_at <= <end of the last day>  AND  return_at >= <start of the first>
 *
 * `ListFilters.dateRange` (`listQuery.ts`) carries ONE `{ column, fromAd, toAd }`
 * and `applyListFilters` turns it into `gte`/`lte` on that single column. Two
 * different columns, each with one bound, is not expressible in that shape.
 *
 * Three routes were open and this is why the third was taken:
 *
 *  1. **Bound `pickup_at` alone.** A booking that started before the window and
 *     is still out — the one an operator most needs to see — would vanish from
 *     the grid. Wrong answer, quietly.
 *  2. **Widen `ListFilters`** with a list of ranges. Honest, but it is a change
 *     to the contract 34 screens share, plus `applyListFilters`,
 *     `useList`'s `narrowingKey` and `filterKey` — a lot of blast radius for
 *     one screen's question, and the shared shape would then carry a feature
 *     with exactly one caller.
 *  3. **Ask Postgres directly here**, the way `fetchFloorBooking`
 *     (`queries/bookings.ts`) already does for the floor's per-booking read.
 *     The rule stays inside a query module, the page still sees only rows, and
 *     nothing shared has to move.
 *
 * If a second screen ever needs an overlap, route (2) becomes the right one and
 * this function becomes its first caller.
 *
 * ## Law 6 — no money
 *
 * `CALENDAR_COLUMNS` below names no money column, by the same construction as
 * `FLOOR_COLUMNS` in `queries/bookings.ts`: "this module cannot leak a rupee
 * figure" is checkable by reading one constant. The Calendar is a Warehouse
 * surface (Foundation §8.3) and has no reason to carry one.
 *
 * ## Law 7 — AD in, AD out
 *
 * `pickup_at` / `return_at` are `timestamptz not null` (0002:31-32). Every
 * instant crossing this boundary is AD/UTC; the BS labels are rendered by
 * `lib/bs.ts` at paint time and are never stored, queried or returned from here.
 */

type BookingStageDb = Database['public']['Enums']['booking_stage']

/**
 * The stages that HAVE a bar kind, and the kind each becomes.
 *
 * ## What is deliberately missing, and why none of it is guessed
 *
 * - **`Returned` and `Closed`** — 190 of the 246 live bookings. Neither has a
 *   legend kind in `data/calendar.ts`'s `BarKind`, and neither is `Reserved`
 *   (the gear is not booked out any more) or `On Rent` (it is not with the
 *   client). Drawing them as either would put 190 wrong bars on the grid, so
 *   they are omitted entirely.
 *   `TODO(decision)`: should a finished booking stay visible on the calendar —
 *   a 'Completed' kind in the legend, drawn quieter than the live ones — or
 *   does the calendar show only work that is still ahead? Either is defensible;
 *   nothing in `Calendar.md` §6 says which, so nothing here picks.
 * - **`Quote`** — a quote is not a reservation and does not hold stock. The
 *   legend's `Quote Expiry` is a POINT marker on the expiry date, not a window
 *   spanning the requested dates, so mapping a Quote onto a bar would draw the
 *   wrong shape as well as the wrong fact.
 *   `TODO(decision)`: whether quotes appear on the calendar at all, and if so
 *   as an expiry marker or as a provisional window.
 *
 * Cancellation is not a stage (0015: it is the `cancelled_at` flag), so it is
 * excluded by presence below rather than here.
 */
const STAGE_BAR_KIND = {
  // 7 Oct audit: history and provisional quotes stay visible, without reserving stock.
  Quote: 'Quote',
  Booked: 'Reserved',
  Packed: 'Reserved',
  'On Rent': 'On Rent',
  Returned: 'Completed',
  Closed: 'Completed',
} as const satisfies Partial<Record<BookingStageDb, BarKind>>

/** The stages above, as the `in (...)` list. Derived, so the two cannot drift. */
const CALENDAR_STAGES = Object.keys(STAGE_BAR_KIND) as BookingStageDb[]

/**
 * The bar kinds this read can actually produce.
 *
 * Exported so the screen's event-type filter offers the kinds a booking can be
 * rather than all twelve in the legend. Ten of those twelve — Cleaning,
 * Maintenance, Crew Duty, Blocked, both Sub-Rental kinds, Conflict, Quote
 * Expiry, Case Escalation, Available — have no source anywhere: each would come
 * from a table with no rows, and most from a table with no writer either. A chip
 * for one of them is a control whose only possible outcome is an emptied grid,
 * which is the defect `data/today.ts`'s `LIST_STAGES` exists to prevent on the
 * Dashboard.
 *
 * Derived from the map above rather than typed out, so a stage gaining a kind
 * puts its chip on the screen in the same edit.
 */
export const CALENDAR_BAR_KINDS: readonly BarKind[] = [...new Set<BarKind>(Object.values(STAGE_BAR_KIND)), 'Draft']

/**
 * The projection. **No money column appears here and none may be added** — see
 * the Law 6 note in the header.
 *
 * Every name was checked against `supabase/migrations/0002_bookings.sql`'s
 * `create table bookings` and against the GENERATED `src/types/supabase.ts`
 * (`bookings.Row`): `booking_no` (:24), `project` (:29), `stage` (:30),
 * `pickup_at` (:31), `return_at` (:32), `cancelled_at` (:39). `clients ( name )`
 * is the same embed `BASE_COLUMNS` uses.
 *
 * ⚠ Line numbers rot. `booking_no` was cited at :23 and `cancelled_at` at :44
 * here; both were wrong, and a wrong citation is worse than none because the
 * next reader checks the line, finds a different column, and stops trusting the
 * rest of the note. Re-check them against the file or cite by name only.
 */
const CALENDAR_COLUMNS = 'id, booking_no, project, stage, pickup_at, return_at, cancelled_at, clients ( name )'

/**
 * The ceiling on one window's read, stated here rather than inherited.
 *
 * ⛔ This query had no `.limit()` and no count. PostgREST applies its OWN
 * ceiling in that case (`db-max-rows`, unset in this project's config but
 * enforced by the platform), and it applies it **silently**: the response is a
 * short array with a 200 status. `total` was `rows.length`, so a truncated
 * window reported itself as complete and the grid drew a month with bookings
 * quietly missing from it — the one failure a calendar must not have, because
 * an absent bar reads as "nothing is booked that day".
 *
 * So the cap is named here and the count is asked for. `total` is now the EXACT
 * number of bookings overlapping the window, whether or not they all came back,
 * and the screen compares the two and says so on the page face when they differ
 * (Law 12 — inline and persistent, never a toast).
 *
 * 1000 is not a guess about the business: it is well above any real month
 * (49 bookings are live in the whole database today) and well below the point
 * where the browser-side narrowing in `Calendar.tsx` would be slow. It is a
 * backstop, not a page size — there is no second page to fetch.
 */
const CALENDAR_WINDOW_LIMIT = 1000

interface RawCalendarRow {
  id: string
  booking_no: string
  project: string | null
  stage: BookingStageDb
  /** `timestamptz not null` (0002:31). AD, UTC. */
  pickup_at: string
  /** `timestamptz not null` (0002:32). AD, UTC. */
  return_at: string
  cancelled_at: string | null
  clients: { name: string } | null
}

/**
 * Read fresh per call, never captured at module load, so a changed operational
 * day start takes effect without a reload — the same rule
 * `queries/bookings.ts`'s `operationalDayStartMinutes` follows.
 */
function dayStartMinutes(): number {
  return dayStartMinutesFrom(getSetting('operationalDayStart'))
}

/**
 * The instant a Nepal calendar day opens and the instant it closes.
 *
 * Both are taken from `todaysOutgoing`, the named set, rather than rebuilt here
 * — the trick `data/today.ts`'s `overDays` documents and for the same reason:
 * `startOfDay` / `endOfDay` are module-private in `queries/bookings.ts` and
 * carry the `+05:45` and operational-day-start (D4) reasoning that makes the day
 * a screen FILTERS by the day it LABELS. Re-deriving those boundaries in a
 * second file is how two answers to "which day is it in Kathmandu" get written.
 *
 * `todaysOutgoing` always returns a `dateRange` with both ends, so the fallback
 * can only fire if that contract changes — in which case failing loudly beats
 * quietly querying an unbounded window.
 */
function dayBounds(dayAd: string): { open: string; close: string } {
  const range = todaysOutgoing(dayAd).dateRange
  if (!range?.fromAd || !range.toAd) {
    throw new Error(`Could not resolve the operational-day bounds for ${JSON.stringify(dayAd)}.`)
  }
  return { open: range.fromAd, close: range.toAd }
}

/** A UTC-midnight AD day, which is the only date shape `Bar.from` / `Bar.to` accept. */
function utcMidnight(dayAd: string): Date {
  return new Date(`${dayAd}T00:00:00.000Z`)
}

/**
 * The operational day an instant belongs to, as a UTC-midnight AD `Date`.
 *
 * `operationalDayOf` is the same function `queries/bookings.ts`'s `nepalDay`
 * uses, so the day a bar is DRAWN on and the day the filters would have
 * selected it by are computed by one piece of arithmetic. A pickup at 05:30
 * Kathmandu belongs to the previous day when the day starts at 06:00, and the
 * bar lands there too.
 */
function dayOf(instantAd: string, startMinutes: number): Date {
  return utcMidnight(operationalDayOf(instantAd, startMinutes))
}

/**
 * One booking → one bar.
 *
 * The bar's window is the PICKUP day through the RETURN day, inclusive at both
 * ends — which is what `Bar.from` / `Bar.to` mean and what `place()` and
 * `coversDay()` on the screen assume. It is deliberately not the half-open
 * `[pickup, return)` convention `RENTAL_WINDOW_BOUNDS` uses for overlap
 * arithmetic: that answers "may these two bookings share a unit", a different
 * question from "which cells does this booking appear in". A one-day booking
 * must occupy one cell, not zero.
 */
function toBar(r: RawCalendarRow, startMinutes: number): Bar {
  const kind = STAGE_BAR_KIND[r.stage as keyof typeof STAGE_BAR_KIND]
  // A booking always has a client (NOT NULL + FK), so a missing join is a query
  // bug rather than a data state — say so instead of printing a friendly dash.
  const clientName = r.clients?.name ?? 'Client not recorded'
  const from = dayOf(r.pickup_at, startMinutes)
  const to = dayOf(r.return_at, startMinutes)

  return {
    // Keyed on the row's uuid, so the id is stable across refetches and unique
    // even if two bookings ever shared a number.
    id: `bk-${r.id}`,
    kind,
    label: r.booking_no,
    sub: `${r.project ? `${clientName} · ${r.project}` : clientName}${r.stage === 'Quote' ? ' · not reserved' : ''}`,
    client: clientName,
    // The bar's own booking, carried explicitly. The screen used to decide
    // whether a bar could be opened by testing whether its LABEL looked like a
    // booking number; a bar that carries its booking cannot be wrong about it.
    bookingNo: r.booking_no,
    from,
    // A return recorded before its pickup would render as a negative span and
    // silently disappear from the grid. The database does not forbid it, so the
    // bar is clamped to at least its pickup day and stays visible.
    to: to.getTime() < from.getTime() ? from : to,
  }
}

/**
 * The bookings OVERLAPPING an inclusive AD day window, as calendar bars.
 *
 * `fromAd` / `toAd` are Nepal calendar days (`YYYY-MM-DD`) — the days the grid
 * is drawing, not instants.
 *
 * The overlap is the whole point: `pickup_at <= <close of toAd>` and
 * `return_at >= <open of fromAd>` selects the four cases a calendar must show —
 * a booking wholly inside the window, one that starts before it and runs in, one
 * that starts inside and runs out, and one that spans the window entirely. A
 * single-column range would have kept only the first two.
 *
 * Returns bars sorted by start day, then by row id — the primary key, not the
 * booking number, because only a unique column makes the order total — so a
 * re-render cannot reshuffle the lanes under the operator's cursor.
 *
 * `total` is the EXACT count of overlapping bookings, which may be larger than
 * `rows.length`: see `CALENDAR_WINDOW_LIMIT`. A caller that draws the rows must
 * compare the two and say when the window was cut.
 */
export async function listCalendarBookings(fromAd: string, toAd: string): Promise<ListQueryResult<Bar>> {
  const startMinutes = dayStartMinutes()
  const windowOpen = dayBounds(fromAd).open
  const windowClose = dayBounds(toAd).close

  const { data, error, count } = await supabase
    .from('bookings')
    // `count: 'exact'` costs a second planner pass and buys the one thing a
    // silent truncation destroys: the ability to know it happened.
    .select(CALENDAR_COLUMNS, { count: 'exact' })
    // The overlap. Both bounds are inclusive: a booking returning at the exact
    // instant the window opens still occupied that day.
    .lte('pickup_at', windowClose)
    .gte('return_at', windowOpen)
    .in('stage', CALENDAR_STAGES)
    // Law 3 / 0015 — 'Cancelled' is a flag, not a stage. A cancelled booking is
    // still a row and is still read elsewhere; it is not work on a calendar.
    .is('cancelled_at', null)
    .order('pickup_at', { ascending: true })
    // `bookings.id` is the primary key (0002:22) — a total order, so paging and
    // re-fetching return the same sequence. See PAGINATION in `listQuery.ts`.
    .order('id', { ascending: true })
    // The named ceiling, so truncation is this module's decision rather than
    // PostgREST's default applied out of sight. See `CALENDAR_WINDOW_LIMIT`.
    .limit(CALENDAR_WINDOW_LIMIT)

  if (error) throw new Error(`listCalendarBookings failed: ${error.message}`)

  const rows = ((data ?? []) as unknown as RawCalendarRow[]).map((r) => toBar(r, startMinutes))
  // `count` is the exact number of matching bookings; `rows.length` is how many
  // came back. They differ exactly when the window was cut. Falling back to
  // `rows.length` when the count is absent keeps the old — honest, if less
  // informative — behaviour rather than inventing a total.
  return { rows, total: count ?? rows.length }
}

/**
 * The nominal column the window travels under.
 *
 * ⚠ This filter set never reaches `applyListFilters` — `fetchCalendarBars`
 * unpacks it and calls `listCalendarBookings`, which builds its own overlap.
 * The name is here so the shape is a legal `ListFilters` and so `useList`'s
 * `filterKey` re-fetches when the window moves; it is not the column the query
 * bounds. `pickup_at` is used rather than an invented name so nothing downstream
 * can be handed a column that does not exist.
 */
const WINDOW_COLUMN = 'pickup_at'

/**
 * The window as a `ListFilters`, so the screen can drive this read through
 * `useList` like every other list and get the same loading / error / empty
 * states without a bespoke effect.
 */
export function calendarWindow(fromAd: string, toAd: string): ListFilters {
  return { dateRange: { column: WINDOW_COLUMN, fromAd, toAd } }
}

/**
 * The `useList` adapter. Reads the window back out of the filter set
 * `calendarWindow` built and asks the real question.
 *
 * A filter set with no window is a programming mistake at a fixed call site, not
 * a runtime condition, so it throws rather than quietly fetching every booking
 * in the table.
 */
export async function fetchCalendarBars(filters: ListFilters): Promise<ListQueryResult<Bar>> {
  const { fromAd, toAd } = filters.dateRange ?? {}
  if (!fromAd || !toAd) {
    throw new Error('fetchCalendarBars needs a window — build it with calendarWindow(fromAd, toAd).')
  }
  const bookings = await listCalendarBookings(fromAd, toAd)
  const drafts = await listCalendarDrafts(fromAd, toAd)
  return { rows: [...bookings.rows, ...drafts.rows].sort((a, b) => a.from.getTime() - b.from.getTime() || a.id.localeCompare(b.id)), total: (bookings.total ?? bookings.rows.length) + (drafts.total ?? drafts.rows.length) }
}

/** Provisional dates only: never read the draft's pricing snapshot on this floor surface. */
export async function listCalendarDrafts(fromAd: string, toAd: string): Promise<ListQueryResult<Bar>> {
  const { data, error, count } = await supabase.from('rental_drafts')
    .select('id, booking_no:data->>bookingNo, client_name:data->>clientName, project:data->>project, pickup:data->>pickup, return_date:data->>returnDate', { count: 'exact' })
    .eq('status', 'Active').lte('data->>pickup', toAd).gte('data->>returnDate', fromAd)
    .order('id', { ascending: true }).limit(CALENDAR_WINDOW_LIMIT)
  if (error) throw new Error(`Calendar drafts could not load: ${error.message}`)
  type DraftWindow = { id: string; booking_no: string | null; client_name: string | null; project: string | null; pickup: string | null; return_date: string | null }
  const rows: Bar[] = []
  for (const draft of (data ?? []) as unknown as DraftWindow[]) {
    if (!draft.pickup || !draft.return_date) continue
    const from = utcMidnight(draft.pickup)
    const to = utcMidnight(draft.return_date)
    if (!Number.isFinite(from.getTime()) || !Number.isFinite(to.getTime())) continue
    rows.push({ id: `draft-${draft.id}`, draftId: draft.id, kind: 'Draft', label: `Draft #${draft.booking_no ?? draft.id.slice(0, 8)}`, sub: `${draft.client_name || 'Client not selected'} · not reserved`, client: draft.client_name ?? '', from, to: to < from ? from : to })
  }
  return { rows, total: count ?? rows.length }
}

