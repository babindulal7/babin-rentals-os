<file path="src/modules/rentals/booking/clientHealth.ts">
/**
 * **Client health engine — "New Booking" spec §12–13.**
 *
 * One pure module, no JSX, so the combobox row, the quick-view drawer, the
 * history drawer and (later) any other screen that needs "is this client OK to
 * book?" all read the *same* verdict instead of each re-deriving it from
 * `outstandingPaisa` by hand. That re-derivation is exactly how the same client
 * ends up green on one screen and red on another.
 *
 * ## Why the verdict carries reasons
 *
 * CLAUDE.md's "never colour alone" law: a colour is never the sole carrier of
 * meaning. So `clientHealth()` never returns just a level — it returns the
 * level *with* the human-readable reasons that produced it. The chip renders
 * icon + label + colour, and the quick-view and tooltip render the reasons.
 * There is deliberately no code path that gets a colour without a sentence.
 *
 * ## What this module refuses to do
 *
 * Several signals §12–13 names are simply **not in the data layer**
 * (`src/data/clients.ts`). Rather than invent a plausible number — which would
 * make a fabricated figure look like a fact on a booking screen — those signals
 * are modelled as an *input* (`ClientHealthSignals`) that the caller may supply
 * once a real source exists, and `deriveClientHealthSignals()` returns them
 * genuinely **absent** today. An absent signal contributes nothing; it never
 * silently reads as zero-and-therefore-fine, and the quick-view renders it as
 * an honest em-dash.
 *
 * ## The one absent signal that is NOT allowed to contribute nothing
 *
 * "Contributes nothing" is the right default for a signal that can only ever
 * *add* a reason — an overdue invoice count that is missing cannot make a
 * client look better than they are.
 *
 * **Credit used is different.** It is the denominator of a blocker
 * ("credit limit exceeded"), so treating its absence as nothing is the same as
 * asserting the client is within their limit. See `creditCheck` below: when the
 * check cannot be run it returns `unavailable`, and `clientHealth` raises that
 * as a *critical* reason. A safety check that cannot be computed withholds the
 * verdict; it does not pass it.
 */

import { formatMoney, rupees } from '../../../lib/money'
import type { Paisa } from '../../../lib/money'
import type { StatusKey } from '../../../lib/status'
import type { ClientRecord } from '../../../lib/queries/clients'
import type { IconName } from '../../../components/ui/Icon'

/* ════════════════════════════════════════════════════════════════════════
 * THRESHOLDS — the one block a human rules on
 * ════════════════════════════════════════════════════════════════════════ */

/**
 * ⚠ **TODO(decision)** — every number in this block is a *placeholder*, not a
 * ruling.
 *
 * The New Booking spec §12–13 says "significant outstanding balance" (Red) and
 * "small outstanding balance" (Orange), and "credit limit exceeded" (Red) vs
 * "credit limit approaching" (Orange). It never states where significant stops
 * being small, or how close "approaching" is. PLAN.md carries no ruling on it
 * either. These are business rules for the owner, not a developer's guess to
 * bury inline — so they live here, named, in one place, and every threshold in
 * the engine reads from this object. Change a number here and every screen
 * moves together.
 *
 * Record the real values in PLAN.md §4 and delete this warning.
 */
export const CLIENT_HEALTH_THRESHOLDS = {
  /**
   * At or above this outstanding balance the client is Red ("significant").
   * Below it, but above zero, the client is Orange ("small").
   *
   * Placeholder rationale, stated so it can be argued with: Rs 50,000 is
   * roughly one mid-size camera package for a few days in this catalogue, i.e.
   * about one unpaid booking. Not a ruling.
   */
  significantOutstandingPaisa: rupees(50_000) as Paisa,

  /**
   * Fraction of the credit limit at or above which the client is Orange
   * ("approaching"). Exceeding the limit outright (ratio > 1) is Red.
   */
  creditLimitApproachingRatio: 0.8,

  /**
   * Whether a client with **no credit limit configured** (`creditLimitPaisa`
   * is 0) counts as "credit limit exceeded" the moment they owe anything.
   *
   * Placeholder answer: **no**. A zero in this seed layer reads as "no credit
   * facility has been set up yet", not "this client is allowed zero credit" —
   * and the outstanding-balance thresholds above already catch a real balance.
   * Treating 0 as a hard limit would turn every un-configured client red on
   * their first unpaid rupee. Genuinely ambiguous; needs a ruling.
   */
  zeroCreditLimitMeansNoCredit: true,

  /**
   * Whether KYC state feeds health at all.
   *
   * §12–13 does **not** enumerate KYC. But a client whose KYC was *Rejected*
   * reading "Good — no issues" on the booking screen is the kind of quiet
   * omission this product's laws exist to prevent, so it is included and
   * flagged rather than silently dropped. Set to `false` to take KYC out of
   * health entirely without touching the engine.
   */
  kycAffectsHealth: true,

  /**
   * Days-until-due at or under which "payment due soon" fires (Orange).
   * Inert today — nothing in the data layer carries an invoice due date; see
   * `ClientHealthSignals.paymentDueInDays`.
   */
  paymentDueSoonDays: 7,
} as const

/* ════════════════════════════════════════════════════════════════════════
 * SIGNALS THE DATA LAYER DOES NOT CARRY YET
 * ════════════════════════════════════════════════════════════════════════ */

/**
 * Signals §12–13 names that **no field in `src/data/clients.ts` supplies**.
 *
 * Every one is optional and every one is genuinely absent today. The engine
 * accepts them so that the day a real source exists (Phase 2's booking /
 * invoice / return queries) the wiring is a one-line change at the call site
 * rather than a rewrite of the rules.
 *
 * ⚠ TODO(decision) — none of these can be derived from the current seed layer:
 *
 * - `overdueInvoiceCount` — there is no invoices table, and no client-scoped
 *   invoice list, anywhere in `src/data/`. `booking.ts`'s `PAYMENT_HISTORY` is
 *   two rows belonging to one demo booking, not a per-client ledger.
 * - `unreturnedUnitCount` — `bookings.actual_return_at` is a column nothing in
 *   the repo ever writes (see the note on `lateFee` in `lib/money.ts`), so
 *   "still out past the return date" is not computable.
 * - `currentlyMissingUnitCount` / `unresolvedDamageChargePaisa` —
 *   `ClientRecord.reliability` carries *lifetime case counts*
 *   (`missingCases`, `damageCases`) with **no resolution state**. A settled
 *   damage case from last year and an open one from yesterday are the same
 *   number there. Those lifetime counts are therefore treated below as
 *   *history* (Orange, "previous issue"), never as an open Red condition —
 *   promoting them to Red would flag long-resolved cases forever.
 * - `depositPendingPaisa` — `depositHeldPaisa` is the deposit *held*, which is
 *   the opposite of pending. Deposit-pending is a per-booking figure and lives
 *   on the booking, not the client.
 * - `paymentDueInDays` — no due dates exist; see `overdueInvoiceCount`.
 * - `creditUsedPaisa` — the one whose absence is *dangerous* rather than merely
 *   incomplete. See `creditCheck`.
 */
export interface ClientHealthSignals {
  /**
   * How much of the client's approved credit limit is currently committed.
   *
   * **The only source this engine will accept for the credit-limit check.**
   * Supply it only from a figure something actually computed; leaving it absent
   * is not a neutral choice, it makes the check report `unavailable` and the
   * client read as Attention Required. That is deliberate — see `creditCheck`.
   *
   * ⚠ TODO(decision) — nothing in the app can produce this today. There is no
   * `credit_used` column, no view exposes one, and no formula has been ruled
   * (`lib/queries/clients.ts` carries the same TODO). Until a rule exists,
   * every client with a configured credit limit is unverifiable, and says so.
   */
  creditUsedPaisa?: Paisa
  /** Count of the client's invoices past their due date. */
  overdueInvoiceCount?: number
  /** Units still out past their scheduled return. */
  unreturnedUnitCount?: number
  /** Units currently recorded missing (not a lifetime case count). */
  currentlyMissingUnitCount?: number
  /** Damage charge raised and not yet settled or written off. */
  unresolvedDamageChargePaisa?: Paisa
  /** Deposit invoiced/required and not yet received. */
  depositPendingPaisa?: Paisa
  /** Days until the client's soonest payment falls due. Negative = already past. */
  paymentDueInDays?: number
}

/**
 * What the data layer can honestly supply today: **nothing**.
 *
 * Returned as an empty object rather than a set of zeroes on purpose — see the
 * "Not configured, never zero" convention `lib/money.ts` already follows for
 * the crew coordination fee. A caller that wants the seam visible can call
 * this; a caller that has real values passes them directly.
 */
export function deriveClientHealthSignals(_client: ClientRecord): ClientHealthSignals {
  return {}
}

/* ════════════════════════════════════════════════════════════════════════
 * THE VERDICT
 * ════════════════════════════════════════════════════════════════════════ */

/** §13's three bands. Ordered worst-last so comparisons stay obvious. */
export type ClientHealthLevel = 'good' | 'warning' | 'attention'

export type ClientHealthSeverity = 'critical' | 'warning'

export interface ClientHealthReason {
  /** Stable machine key — safe to test against, unlike the prose. */
  code: string
  /** Human-readable, already money-formatted. This is what the UI shows. */
  text: string
  severity: ClientHealthSeverity
}

export interface ClientHealthVerdict {
  level: ClientHealthLevel
  /** The word that always travels with the colour. Never render the colour without it. */
  label: 'Good' | 'Warning' | 'Attention Required'
  /** Paired glyph — the second non-colour carrier. */
  icon: IconName
  /** Foundation §4.2 token key; resolve through `STATUS` at the call site. */
  tone: StatusKey
  /** Everything that fired, critical first. Empty only when the level is `good`. */
  reasons: ClientHealthReason[]
  /** One line fit for a tooltip or an accessible name. */
  summary: string
}

/** Level → the label / icon / tone triple. Exported so a chip cannot invent its own. */
export function healthPresentation(level: ClientHealthLevel): {
  label: ClientHealthVerdict['label']
  icon: IconName
  tone: StatusKey
} {
  switch (level) {
    case 'attention':
      // `error` is Tabler's alert-circle — a different silhouette from the
      // warning triangle, so the two read apart in greyscale as well as colour.
      return { label: 'Attention Required', icon: 'error', tone: 'danger' }
    case 'warning':
      return { label: 'Warning', icon: 'alert_triangle', tone: 'progress' }
    case 'good':
      return { label: 'Good', icon: 'check', tone: 'in' }
  }
}

/**
 * Whether the credit-limit check can be run for this client, and its result if
 * it can.
 *
 * ## Why this replaced `creditUtilisation(client): number | null`
 *
 * That function divided `client.creditUsedPaisa` by `client.creditLimitPaisa`
 * and returned `null` for one reason only — no limit configured. Two different
 * facts therefore shared one representation, and callers read both as benign:
 *
 *   1. "there is no limit, so there is nothing to exceed" — genuinely benign;
 *   2. "we cannot tell how much of the limit is used" — **not benign at all**.
 *
 * Case 2 was unreachable only by accident. `ClientRecord.creditUsedPaisa` has
 * no source: there is no `credit_used` column, no view publishes one, and no
 * formula has been ruled, so `toClientRecord` in `lib/queries/clients.ts` sets
 * it to `0`. The only non-zero values anywhere are the hand-typed demo numbers
 * in `CLIENTS_DATA`. On the day the New Booking screen reads real clients
 * instead of that seed, every utilisation becomes `0 / limit = 0`,
 * "Credit limit exceeded" stops firing for every client alive, and nothing
 * anywhere shows a symptom — a safety gate failing open, silently, on the
 * screen where money decisions are taken.
 *
 * So the figure comes from `ClientHealthSignals.creditUsedPaisa`, which a
 * caller passes only when something really computed it, and its absence is
 * reported as `unavailable` instead of being computed as zero. `clientHealth`
 * raises `unavailable` as a **critical** reason.
 *
 * `ClientRecord.creditUsedPaisa` is deliberately **not read here**. It cannot
 * distinguish "this client has committed nothing" from "nobody computed this",
 * and a check that gates money must not guess which of the two it is holding.
 * Do not reconnect it — the way to make this compute again is a ruled formula
 * plus a caller that supplies the signal.
 */
export type CreditCheck =
  /**
   * No credit facility configured, so there is no limit to exceed. This is a
   * fact about the client, not a gap in the data — `approved_credit_limit` is a
   * real column and 0/absent is a real answer. See `zeroCreditLimitMeansNoCredit`.
   */
  | { state: 'not-applicable' }
  /**
   * A limit **is** configured, but how much of it is used is not computed
   * anywhere. The check could not be run; nothing may report the client as
   * within their limit.
   */
  | { state: 'unavailable'; limitPaisa: Paisa }
  | { state: 'computed'; ratio: number; usedPaisa: Paisa; limitPaisa: Paisa }

export function creditCheck(client: ClientRecord, signals: ClientHealthSignals = {}): CreditCheck {
  const limitPaisa = client.creditLimitPaisa
  if (limitPaisa <= 0) return { state: 'not-applicable' }

  const usedPaisa = signals.creditUsedPaisa
  if (usedPaisa === undefined) return { state: 'unavailable', limitPaisa }

  return { state: 'computed', ratio: usedPaisa / limitPaisa, usedPaisa, limitPaisa }
}

/**
 * §13's strict priority: **any** critical condition → Red; else **any** warning
 * condition → Orange; else Green. Not a score, not a weighted sum — one Red
 * signal outranks any number of Orange ones, which is what makes the colour
 * mean the same thing every time it appears.
 */
export function clientHealth(
  client: ClientRecord,
  signals: ClientHealthSignals = deriveClientHealthSignals(client),
): ClientHealthVerdict {
  const T = CLIENT_HEALTH_THRESHOLDS
  const critical: ClientHealthReason[] = []
  const warning: ClientHealthReason[] = []

  const crit = (code: string, text: string) => critical.push({ code, text, severity: 'critical' })
  const warn = (code: string, text: string) => warning.push({ code, text, severity: 'warning' })

  /* ── Red · §12 "critical" ─────────────────────────────────────────── */

  // "serious payment issue" — On-Stop is the strongest form the data carries,
  // and it is already the app-wide bar on new bookings (see `clientIntel.ts`).
  if (client.isBlocked || client.onStop) {
    const why = client.onStop?.reason ?? client.blockReason
    crit('on-stop', why ? `On-Stop — ${why}` : 'On-Stop — blocked from new bookings')
  }

  // "significant outstanding balance"
  if (client.outstandingPaisa >= T.significantOutstandingPaisa) {
    crit(
      'outstanding-significant',
      `Outstanding ${formatMoney(client.outstandingPaisa)} — at or above the ${formatMoney(
        T.significantOutstandingPaisa,
      )} attention threshold`,
    )
  }

  // "credit limit exceeded" — and, when the check cannot be run at all, a
  // critical that says exactly that. `creditCheck`'s doc has the reasoning: an
  // uncomputable credit check withholds the verdict rather than passing it, so
  // this branch can never quietly become "fine".
  const credit = creditCheck(client, signals)
  if (credit.state === 'computed' && credit.ratio > 1) {
    crit(
      'credit-exceeded',
      `Credit limit exceeded — ${formatMoney(credit.usedPaisa)} used against a ${formatMoney(
        credit.limitPaisa,
      )} limit`,
    )
  } else if (credit.state === 'unavailable') {
    crit(
      'credit-check-unavailable',
      `Credit limit ${formatMoney(credit.limitPaisa)} is set, but credit used is not computed anywhere — ` +
        'the credit-limit check could not be run. Unverified, not within limit.',
    )
  } else if (credit.state === 'not-applicable' && !T.zeroCreditLimitMeansNoCredit && client.outstandingPaisa > 0) {
    crit('credit-none-configured', 'No credit limit configured and a balance is outstanding')
  }

  // "overdue invoice" — absent today; fires only when a caller supplies it.
  if (signals.overdueInvoiceCount !== undefined && signals.overdueInvoiceCount > 0) {
    crit(
      'invoice-overdue',
      `${signals.overdueInvoiceCount} overdue invoice${signals.overdueInvoiceCount === 1 ? '' : 's'}`,
    )
  }

  // "unreturned / missing equipment" — current, not historical. Absent today.
  if (signals.unreturnedUnitCount !== undefined && signals.unreturnedUnitCount > 0) {
    crit(
      'equipment-unreturned',
      `${signals.unreturnedUnitCount} item${signals.unreturnedUnitCount === 1 ? '' : 's'} not returned`,
    )
  }
  if (signals.currentlyMissingUnitCount !== undefined && signals.currentlyMissingUnitCount > 0) {
    crit(
      'equipment-missing',
      `${signals.currentlyMissingUnitCount} item${signals.currentlyMissingUnitCount === 1 ? '' : 's'} recorded missing`,
    )
  }

  // "unresolved damage charge" — absent today.
  if (signals.unresolvedDamageChargePaisa !== undefined && signals.unresolvedDamageChargePaisa > 0) {
    crit('damage-unresolved', `Unresolved damage charge ${formatMoney(signals.unresolvedDamageChargePaisa)}`)
  }

  // KYC — not enumerated by §12; included behind a flag, see the threshold block.
  if (T.kycAffectsHealth && client.kycStatus === 'Rejected') {
    crit('kyc-rejected', 'KYC rejected — identity documents were not accepted')
  }

  /* ── Orange · §12 "warning" ───────────────────────────────────────── */

  // "small outstanding balance" — anything above zero that did not already
  // trip the significant threshold above.
  if (client.outstandingPaisa > 0 && client.outstandingPaisa < T.significantOutstandingPaisa) {
    warn('outstanding-small', `Outstanding ${formatMoney(client.outstandingPaisa)}`)
  }

  // "credit limit approaching" — only ever from a figure that was really
  // computed. An unavailable check has already fired a critical above; it must
  // not also produce a softer, reassuring-sounding percentage here.
  if (credit.state === 'computed' && credit.ratio >= T.creditLimitApproachingRatio && credit.ratio <= 1) {
    warn(
      'credit-approaching',
      `Credit ${Math.round(credit.ratio * 100)}% used — ${formatMoney(credit.usedPaisa)} of ${formatMoney(
        credit.limitPaisa,
      )}`,
    )
  }

  // "previous late return" — a real lifetime count where the record carries one.
  const lateReturns = client.reliability?.lateReturns
  if (lateReturns !== undefined && lateReturns > 0) {
    warn(
      'late-returns',
      `${lateReturns} late return${lateReturns === 1 ? '' : 's'} on record` +
        (client.reliability && client.reliability.totalReturns > 0
          ? ` of ${client.reliability.totalReturns}`
          : ''),
    )
  }

  // "minor unresolved issue" — the lifetime damage / missing case counts. See
  // the TODO(decision) on `ClientHealthSignals`: these carry no resolution
  // state, so they are history, never an open Red condition.
  const damageCases = client.reliability?.damageCases
  if (damageCases !== undefined && damageCases > 0) {
    warn('damage-history', `${damageCases} previous damage case${damageCases === 1 ? '' : 's'}`)
  }
  const missingCases = client.reliability?.missingCases
  if (missingCases !== undefined && missingCases > 0) {
    warn('missing-history', `${missingCases} previous missing-item case${missingCases === 1 ? '' : 's'}`)
  }

  // "deposit pending" — absent today.
  if (signals.depositPendingPaisa !== undefined && signals.depositPendingPaisa > 0) {
    warn('deposit-pending', `Deposit pending ${formatMoney(signals.depositPendingPaisa)}`)
  }

  // "payment due soon" — absent today.
  if (signals.paymentDueInDays !== undefined && signals.paymentDueInDays <= T.paymentDueSoonDays) {
    warn(
      'payment-due-soon',
      signals.paymentDueInDays <= 0
        ? 'Payment due today'
        : `Payment due in ${signals.paymentDueInDays} day${signals.paymentDueInDays === 1 ? '' : 's'}`,
    )
  }

  // KYC, warning band.
  if (T.kycAffectsHealth && (client.kycStatus === 'Pending Review' || client.kycStatus === 'Not Submitted')) {
    warn('kyc-incomplete', `KYC ${client.kycStatus.toLowerCase()}`)
  }

  /* ── Verdict ──────────────────────────────────────────────────────── */

  const level: ClientHealthLevel =
    critical.length > 0 ? 'attention' : warning.length > 0 ? 'warning' : 'good'
  const { label, icon, tone } = healthPresentation(level)
  const reasons = [...critical, ...warning]

  const summary =
    level === 'good'
      ? 'Good — no outstanding balance, credit or reliability issues on record'
      : `${label} — ${reasons.map((r) => r.text).join(' · ')}`

  return { level, label, icon, tone, reasons, summary }
}

/**
 * The accessible name fragment for a client row or the health control, so the
 * health never reaches a screen-reader user as colour-only. Kept here beside
 * the verdict so the visual chip and the spoken name cannot drift.
 */
export function healthAccessibleName(client: ClientRecord, verdict: ClientHealthVerdict): string {
  return `${client.name}. Client health: ${verdict.summary}`
}

/**
 * Ordering helper for lists that should surface problems first — same strict
 * priority as `clientHealth`, expressed as a sortable rank.
 */
export const HEALTH_RANK: Record<ClientHealthLevel, number> = {
  attention: 0,
  warning: 1,
  good: 2,
}
</file>

<file path="src/modules/rentals/booking/ClientHealthChip.tsx">
/**
 * The two presentational carriers of `clientHealth()` — a labelled chip and the
 * eye control that doubles as the health indicator ("New Booking" spec §11).
 *
 * Both exist here rather than inside the combobox because the combobox row, the
 * field's eye button, the quick-view header and the history drawer all show the
 * same verdict, and three hand-rolled copies of "green dot + maybe a word" is
 * precisely how a colour ends up meaning two different things on one screen.
 *
 * **Never colour alone.** Neither component can be rendered as a bare coloured
 * dot: the icon (three distinct silhouettes — tick / triangle / circle-alert)
 * and the word ("Good" / "Warning" / "Attention Required") are not optional
 * props. There is no icon-only or colour-only mode, on purpose.
 */

import type { CSSProperties } from 'react'
import Icon from '../../../components/ui/Icon'
import { STATUS } from '../../../lib/status'
import type { ClientHealthVerdict } from './clientHealth'

/** CLAUDE.md: 44×44 minimum on every device, desktop included. */
export const TOUCH = 44

/* ── Chip ──────────────────────────────────────────────────────────────── */

export interface ClientHealthChipProps {
  verdict: ClientHealthVerdict
  /** `sm` for dense list rows, `md` for the quick-view header. */
  size?: 'sm' | 'md'
  /** Hover text. Defaults to the full reason list, so the *why* is one hover away. */
  title?: string
  style?: CSSProperties
}

export function ClientHealthChip({ verdict, size = 'sm', title, style }: ClientHealthChipProps) {
  const t = STATUS[verdict.tone]
  const dense = size === 'sm'
  return (
    <span
      title={title ?? verdict.summary}
      style={{
        display: 'inline-flex',
        alignItems: 'center',
        gap: dense ? 4 : 6,
        height: dense ? 20 : 26,
        padding: dense ? '0 7px' : '0 10px',
        borderRadius: 'var(--r-badge)',
        background: t.bg,
        color: t.fg,
        ...(t.border ? { border: `1px solid ${t.border}` } : {}),
        fontSize: 'var(--t-meta)',
        fontWeight: 600,
        lineHeight: 1,
        whiteSpace: 'nowrap',
        ...style,
      }}
    >
      <Icon name={verdict.icon} size={dense ? 12 : 14} fill />
      {verdict.label}
    </span>
  )
}

/* ── Reason list ───────────────────────────────────────────────────────── */

/**
 * The sentences behind the colour. §13's strict priority is preserved in the
 * order (`reasons` arrives critical-first), and each row re-states its own
 * severity with a glyph so a reason is never distinguishable by colour alone.
 */
export function ClientHealthReasons({
  verdict,
  max,
}: {
  verdict: ClientHealthVerdict
  /** Truncate to the first N and append a "+N more" line. Omit for all. */
  max?: number
}) {
  if (verdict.reasons.length === 0) {
    return (
      <p style={{ margin: 0, fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
        No outstanding balance, credit or reliability issues on record.
      </p>
    )
  }
  const shown = max === undefined ? verdict.reasons : verdict.reasons.slice(0, max)
  const hidden = verdict.reasons.length - shown.length
  return (
    <ul style={{ margin: 0, padding: 0, listStyle: 'none', display: 'grid', gap: 5 }}>
      {shown.map((r) => (
        <li
          key={r.code}
          style={{
            display: 'flex',
            alignItems: 'flex-start',
            gap: 6,
            fontSize: 'var(--t-meta)',
            color: r.severity === 'critical' ? 'var(--danger-text)' : 'var(--ready-text)',
          }}
        >
          <span style={{ display: 'inline-flex', paddingTop: 1, flexShrink: 0 }}>
            <Icon name={r.severity === 'critical' ? 'error' : 'alert_triangle'} size={13} />
          </span>
          <span style={{ minWidth: 0 }}>{r.text}</span>
        </li>
      ))}
      {hidden > 0 && (
        <li style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>+{hidden} more</li>
      )}
    </ul>
  )
}

/* ── Eye ───────────────────────────────────────────────────────────────── */

export interface ClientHealthEyeProps {
  verdict: ClientHealthVerdict
  /** Client name, so the accessible name says whose health this is. */
  clientName: string
  onClick: () => void
  /** Drives `aria-expanded` — the drawer is a disclosure, not a navigation. */
  open: boolean
  /** `id` of the panel this control discloses. */
  controls?: string
  disabled?: boolean
}

/**
 * §11 — one control, two jobs: it opens the quick view **and** it is the health
 * indicator. It must not navigate away, so it is a `<button type="button">`,
 * never a `<Link>`.
 *
 * The 44×44 minimum is met by the control's own height and padding rather than
 * by inflating the glyph — the eye stays 18px, the hit area is the button.
 */
export function ClientHealthEye({
  verdict,
  clientName,
  onClick,
  open,
  controls,
  disabled = false,
}: ClientHealthEyeProps) {
  const t = STATUS[verdict.tone]
  return (
    <button
      type="button"
      className="press"
      onClick={onClick}
      disabled={disabled}
      aria-expanded={open}
      {...(controls ? { 'aria-controls': controls } : {})}
      aria-label={`Client health quick view for ${clientName}. ${verdict.summary}`}
      title={verdict.summary}
      style={{
        display: 'inline-flex',
        alignItems: 'center',
        justifyContent: 'center',
        gap: 6,
        minHeight: TOUCH,
        minWidth: TOUCH,
        padding: '0 12px',
        borderRadius: 'var(--r-btn)',
        background: t.bg,
        color: t.fg,
        border: `1px solid ${t.border ?? 'transparent'}`,
        fontFamily: 'inherit',
        fontSize: 'var(--t-meta)',
        fontWeight: 600,
        lineHeight: 1,
        whiteSpace: 'nowrap',
        cursor: disabled ? 'not-allowed' : 'pointer',
        opacity: disabled ? 0.6 : 1,
      }}
    >
      <Icon name="eye" size={18} />
      <Icon name={verdict.icon} size={14} fill />
      {/* The word travels with the colour — this label is not optional. */}
      <span>{verdict.label}</span>
    </button>
  )
}
</file>

<file path="src/modules/rentals/booking/ClientHistoryDrawer.tsx">
/**
 * **Client history — "New Booking" spec §20.**
 *
 * §20 wants the existing "Client History" button to open a *compact drawer*
 * showing previous rentals, payment history, outstanding balance, late returns,
 * damaged items, missing items and recent bookings — and, like §11's quick
 * view, to **not navigate away**. Today that button calls
 * `navigate('/clients/:id')`, which discards a half-built booking to answer a
 * question that takes four seconds to read.
 *
 * ## What the data layer can and cannot back
 *
 * This drawer is mostly **honest gaps**, and that is the point. `src/data/` has
 * no per-client rental ledger and no per-client payment ledger:
 *
 * - `data/rentals.ts`' `ROWS` is the Rentals list's own seed. Its `client`
 *   field is a *display string* (`'ABC Films'`, `'Creative Studio'`) and those
 *   strings do not exist in `data/clients.ts` at all. Worse, the two layers
 *   contradict each other on ownership: `C-1` (Kathmandu Cinema Works)
 *   claims `B-715`, and `ROWS` attributes that exact booking number to
 *   "ABC Films". Joining them would print one client's project, dates and money
 *   under another client's name on a booking screen. So this component **does
 *   not join**. It shows the booking *numbers* the client record itself
 *   asserts, and takes richer rows only from the `bookings` prop — the seam for
 *   Phase 2's real per-client booking query.
 * - `data/booking.ts`' `PAYMENT_HISTORY` is two rows belonging to one demo
 *   booking. It is not client-scoped and is not shown here.
 *
 * ⚠ TODO(decision) — the `ROWS` / `CLIENTS_DATA` ownership contradiction above
 * is a real seed-data defect, not just a missing join. Whichever layer is wrong
 * needs correcting before any screen claims to list a client's bookings.
 */

import { formatMoney } from '../../../lib/money'
import type { Paisa } from '../../../lib/money'
import Icon from '../../../components/ui/Icon'
import { Button } from '../../../components/ui/Button'
import type { ClientRecord } from '../../../lib/queries/clients'
import { TOUCH } from './ClientHealthChip'
import { creditCheck } from './clientHealth'
import type { ClientHealthSignals } from './clientHealth'
import { Drawer, DrawerRow, DrawerSection, DrawerUnavailable } from './Drawer'

/**
 * One booking row, as supplied by the page. Everything beyond `bookingNo` is
 * optional because the only fact the client record itself carries is the
 * number — see the module note above.
 */
export interface ClientBookingSummary {
  bookingNo: string
  project?: string
  /** Pre-formatted AD label, same convention as `ClientRecord.lastRentalAd`. */
  dateLabel?: string
  /** Plain text, deliberately uncoloured — a coloured pill here would need an icon and a label to be lawful, and the status vocabulary is the Rentals list's, not this drawer's. */
  status?: string
  amountPaisa?: Paisa
  duePaisa?: Paisa
}

export interface ClientHistoryDrawerProps {
  client: ClientRecord
  open: boolean
  onClose: () => void
  /**
   * Real per-client bookings once they exist. Defaults to the booking numbers
   * on the client record, with no invented detail attached.
   */
  bookings?: readonly ClientBookingSummary[]
  /** Opening a booking is an explicit choice; the page decides how (route or tab). */
  onOpenBooking?: (bookingNo: string) => void
  /** Escape hatch to the full client record. The page routes; this never does. */
  onViewClient?: (client: ClientRecord) => void
  /** Pass the page's `canViewMoneyField(gctx, 'client-balance')`. */
  showMoney?: boolean
  /**
   * The same seam `ClientQuickView` takes. Only `creditUsedPaisa` is read here,
   * and only to decide whether the credit line can be stated at all — see
   * `creditCheck`. Absent (the case today) means the credit-limit check cannot
   * be run, and this drawer says so instead of printing a figure.
   */
  signals?: ClientHealthSignals
  id?: string
}

export function ClientHistoryDrawer({
  client,
  open,
  onClose,
  bookings,
  onOpenBooking,
  onViewClient,
  showMoney = true,
  signals,
  id = 'client-history-drawer',
}: ClientHistoryDrawerProps) {
  const rows: ClientBookingSummary[] =
    bookings && bookings.length > 0
      ? [...bookings]
      : client.activeBookings.map((bookingNo) => ({ bookingNo }))

  const reliability = client.reliability
  const depositPending = null // Deposit *pending* is a per-booking figure; the client record only holds deposit held.
  const credit = creditCheck(client, signals)

  return (
    <Drawer
      open={open}
      onClose={onClose}
      id={id}
      title="Client History"
      subtitle={`${client.name} · ${client.id}`}
      width={440}
      footer={
        <>
          <Button variant="secondary" onClick={onClose}>
            Close
          </Button>
          {onViewClient && (
            <Button variant="primary" icon="external_link" onClick={() => onViewClient(client)}>
              View Client
            </Button>
          )}
        </>
      }
    >
      {/* ── Outstanding balance ───────────────────────────────────────── */}
      <DrawerSection title="Outstanding Balance">
        {showMoney ? (
          <DrawerRow
            label="Rental outstanding"
            value={formatMoney(client.outstandingPaisa)}
            figure
            {...(client.outstandingPaisa > 0 ? { tone: 'danger' as const } : { tone: 'success' as const })}
          />
        ) : (
          <DrawerRow
            label="Rental outstanding"
            value={
              <span style={{ display: 'inline-flex', alignItems: 'center', gap: 'var(--sp-xs)', color: 'var(--muted)' }}>
                <Icon name="lock" size={12} />
                Restricted
              </span>
            }
          />
        )}
        {/*
          This row used to print `creditUsedPaisa` as a fact. It is not one —
          the field has no column and no ruled formula behind it, so a real
          client's "credit used" is Rs 0 by construction. Printing "Rs 0 of
          Rs 500,000" beside an outstanding balance states that the client has
          committed nothing against their facility, which nothing in the system
          knows. `creditCheck` reports that as `unavailable` and the row becomes
          the honest em-dash.
        */}
        {showMoney && credit.state === 'computed' && (
          <DrawerRow
            label="Credit used of limit"
            value={`${formatMoney(credit.usedPaisa)} of ${formatMoney(credit.limitPaisa)}`}
            figure
          />
        )}
        {showMoney && credit.state === 'unavailable' && (
          <>
            <DrawerRow
              label="Credit used of limit"
              value={null}
              unavailableNote="Not computed anywhere in the system — there is no credit-used column and no ruled formula, so how much of this limit is committed is unknown."
            />
            <DrawerUnavailable>
              A credit limit of {formatMoney(credit.limitPaisa)} is approved, but nothing computes how much
              of it is used — so the credit-limit check cannot be run and this client is{' '}
              <strong>unverified</strong>, not confirmed within limit.
            </DrawerUnavailable>
          </>
        )}
        {showMoney && credit.state === 'not-applicable' && (
          <DrawerRow label="Credit used of limit" value="No credit limit configured" />
        )}
      </DrawerSection>

      {/*
        Deposits are liabilities — Foundation §2.2 / PLAN.md §0. They get their
        own block and are never added to, netted against, or shown beside the
        rental outstanding above as if they were the same kind of money.
      */}
      {showMoney && (
        <DrawerSection title="Deposit — Liability, Not Revenue">
          <DrawerRow label="Deposit held" value={formatMoney(client.depositHeldPaisa)} figure />
          <DrawerRow
            label="Deposit pending"
            value={depositPending}
            unavailableNote="Not tracked at client level — deposit pending is a per-booking figure and lives on the booking."
          />
          <DrawerUnavailable>
            Held deposits are refundable client money. They are never part of the outstanding balance above.
          </DrawerUnavailable>
        </DrawerSection>
      )}

      {/* ── Recent bookings ───────────────────────────────────────────── */}
      <DrawerSection title="Recent Bookings">
        {rows.length === 0 ? (
          <DrawerUnavailable>No bookings are recorded against this client.</DrawerUnavailable>
        ) : (
          <ul style={{ listStyle: 'none', margin: 0, padding: 0, display: 'grid', gap: 6 }}>
            {rows.map((b) => {
              const meta = [b.project, b.dateLabel, b.status].filter(Boolean).join(' · ')
              const inner = (
                <>
                  <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)', minWidth: 0 }}>
                    <span className="booking-id" style={{ fontSize: 'var(--t-ui)', fontWeight: 600, color: 'var(--text)' }}>
                      {b.bookingNo}
                    </span>
                    {showMoney && b.amountPaisa !== undefined && (
                      <span className="figure" style={{ marginLeft: 'auto', fontSize: 'var(--t-meta)', fontWeight: 600 }}>
                        {formatMoney(b.amountPaisa)}
                      </span>
                    )}
                  </div>
                  {meta && (
                    <div style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
                      {b.project}{b.project && (b.dateLabel || b.status) ? ' · ' : ''}
                      {b.dateLabel && <span style={{ color: 'var(--booking-date-text)' }}>{b.dateLabel}</span>}
                      {b.dateLabel && b.status ? ' · ' : ''}{b.status}
                    </div>
                  )}
                  {showMoney && b.duePaisa !== undefined && b.duePaisa > 0 && (
                    <div className="figure" style={{ fontSize: 'var(--t-meta)', color: 'var(--danger-text)', fontWeight: 600 }}>
                      {formatMoney(b.duePaisa)} due
                    </div>
                  )}
                </>
              )
              return (
                <li key={b.bookingNo}>
                  {onOpenBooking ? (
                    <button
                      type="button"
                      className="press"
                      onClick={() => onOpenBooking(b.bookingNo)}
                      style={{
                        display: 'grid',
                        gap: 2,
                        width: '100%',
                        minHeight: TOUCH,
                        padding: '8px 10px',
                        textAlign: 'left',
                        borderRadius: 'var(--r-btn)',
                        border: '1px solid var(--border)',
                        background: 'var(--card)',
                        color: 'var(--text)',
                        fontFamily: 'inherit',
                        cursor: 'pointer',
                      }}
                    >
                      {inner}
                    </button>
                  ) : (
                    <div
                      style={{
                        display: 'grid',
                        gap: 2,
                        minHeight: TOUCH,
                        padding: '8px 10px',
                        borderRadius: 'var(--r-btn)',
                        border: '1px solid var(--border)',
                        background: 'var(--card)',
                      }}
                    >
                      {inner}
                    </div>
                  )}
                </li>
              )
            })}
          </ul>
        )}
        {!bookings && (
          <DrawerUnavailable>
            Booking numbers come from this client&apos;s own record. Project, dates and amounts are not shown
            because the bookings seed layer attributes these numbers to different client names — joining the
            two would print another client&apos;s figures here.
          </DrawerUnavailable>
        )}
      </DrawerSection>

      {/* ── Previous rentals ──────────────────────────────────────────── */}
      <DrawerSection title="Previous Rentals">
        <DrawerRow label="Lifetime rentals" value={client.totalRentalsCount} figure />
        {showMoney && <DrawerRow label="Lifetime spend" value={formatMoney(client.totalSpentPaisa)} figure />}
        <DrawerRow label="Currently on rent" value={client.currentRentalsCount} figure />
        <DrawerRow label="Last rental" value={<span style={{ color: client.lastRentalAd && client.lastRentalAd !== '—' ? 'var(--booking-date-text)' : undefined }}>{client.lastRentalAd}</span>} figure />
        <DrawerRow label="Client since" value={client.clientSinceAd ?? null} unavailableNote="Not recorded on this client." figure />
        <DrawerUnavailable>
          An itemised list of completed rentals is not available — no per-client rental ledger exists in the
          data layer yet. The figures above are the aggregates the client record maintains.
        </DrawerUnavailable>
      </DrawerSection>

      {/* ── Payment history ───────────────────────────────────────────── */}
      <DrawerSection title="Payment History">
        <DrawerUnavailable>
          Not available yet — payments are recorded against a booking, and there is no client-scoped payment
          ledger in the data layer. Payments for a specific booking are on that booking&apos;s page.
        </DrawerUnavailable>
        <DrawerRow
          label="Payment terms"
          value={client.paymentTerms ?? null}
          unavailableNote="Not recorded on this client."
        />
      </DrawerSection>

      {/* ── Reliability: late returns, damaged, missing ───────────────── */}
      <DrawerSection title="Late Returns, Damage & Missing Items">
        {reliability ? (
          <>
            <DrawerRow
              label="Late returns"
              value={`${reliability.lateReturns} of ${reliability.totalReturns} returns`}
              figure
              {...(reliability.lateReturns > 0 ? { tone: 'warning' as const } : { tone: 'success' as const })}
            />
            <DrawerRow
              label="Average days late"
              value={reliability.avgDaysLateOverall}
              figure
              {...(reliability.avgDaysLateOverall > 1 ? { tone: 'warning' as const } : {})}
            />
            <DrawerRow
              label="Damage cases"
              value={reliability.damageCases}
              figure
              {...(reliability.damageCases > 0 ? { tone: 'warning' as const } : {})}
            />
            <DrawerRow
              label="Missing-item cases"
              value={reliability.missingCases}
              figure
              {...(reliability.missingCases > 0 ? { tone: 'warning' as const } : {})}
            />
            <DrawerUnavailable>
              Lifetime case counts. The record carries no resolution state, so a settled case and an open one
              are indistinguishable here — treat these as history, not as open items.
            </DrawerUnavailable>
          </>
        ) : (
          <DrawerUnavailable>
            No reliability record exists for this client. That is not the same as a clean record — late
            returns, damage and missing items have simply never been captured for them.
          </DrawerUnavailable>
        )}
      </DrawerSection>
    </Drawer>
  )
}
</file>

<file path="src/modules/rentals/booking/ClientQuickView.tsx">
/**
 * **Client quick view — "New Booking" spec §11 and §14.**
 *
 * §11: an eye control sits at the right of the Client field, and *the eye is
 * both the quick-view action and the health indicator*. §11 is also explicit
 * that it **must not navigate away** — checking whether a client owes money is
 * not worth losing a half-built booking, which is exactly what a route change
 * to `/clients/:id` costs today. So this is a drawer over the workspace, and
 * the one control that does leave (`[View Client]`) is an explicit, labelled
 * choice at the bottom, raised as a callback so the page owns the routing.
 *
 * §14's section list is rendered exactly: CLIENT STATUS, FINANCIAL, EQUIPMENT,
 * RENTAL HISTORY, Last Rental, [View Client].
 *
 * ## Honesty rule
 *
 * Several §14 figures have no field behind them in `src/data/clients.ts`. Every
 * one of those renders an em-dash carrying a `title` that says *what* is not
 * tracked and *why* — never a 0, and never a plausible invented number. A zero
 * on a line called "Unreturned" is a claim that the client has nothing out; the
 * data cannot support that claim, so it is not made. Where the record *does*
 * carry a number but it means something narrower than the §14 label suggests
 * (lifetime damage/missing *cases*, which have no resolution state), the row
 * label says so rather than letting the heading imply currency.
 */

import { formatMoney } from '../../../lib/money'
import Icon from '../../../components/ui/Icon'
import { Button } from '../../../components/ui/Button'
import type { ClientRecord } from '../../../lib/queries/clients'
import { CLIENT_HEALTH_THRESHOLDS, clientHealth, creditCheck } from './clientHealth'
import type { ClientHealthSignals } from './clientHealth'
import { ClientHealthChip, ClientHealthReasons } from './ClientHealthChip'
import { Drawer, DrawerRow, DrawerSection, DrawerUnavailable } from './Drawer'

export interface ClientQuickViewProps {
  client: ClientRecord
  open: boolean
  onClose: () => void
  /** `[View Client]`. The page routes; this component never does. */
  onViewClient: (client: ClientRecord) => void
  /** Pass the page's `canViewMoneyField(gctx, 'client-balance')`. */
  showMoney?: boolean
  /** Real signals once Phase 2 supplies them — see `ClientHealthSignals`. */
  signals?: ClientHealthSignals
  /** DOM id, so the eye's `aria-controls` can point at the panel. */
  id?: string
}

const RESTRICTED = (
  <span style={{ display: 'inline-flex', alignItems: 'center', gap: 'var(--sp-xs)', color: 'var(--muted)' }}>
    <Icon name="lock" size={12} />
    Restricted
  </span>
)

export function ClientQuickView({
  client,
  open,
  onClose,
  onViewClient,
  showMoney = true,
  signals,
  id = 'client-quick-view',
}: ClientQuickViewProps) {
  const verdict = signals ? clientHealth(client, signals) : clientHealth(client)
  /**
   * Three states, not a ratio-or-null. `unavailable` means a credit limit IS
   * configured but nothing computes how much of it is used, so this panel may
   * not print a percentage — see `creditCheck`. It renders the em-dash and says
   * why, and the health chip above is already holding the client at Attention
   * for the same reason.
   */
  const credit = creditCheck(client, signals)

  /**
   * §14's "Payment Status", from what the record actually knows.
   *
   * ⚠ TODO(decision) — a real payment status needs invoice due dates, and no
   * invoice source exists in `src/data/` (see `ClientHealthSignals`). "Overdue"
   * is therefore *not* a value this can return; On-Stop is the strongest state
   * the data supports. Stated in the panel rather than implied.
   */
  const paymentStatus: { text: string; tone: 'danger' | 'warning' | 'success' } =
    client.isBlocked || client.onStop
      ? { text: 'On Stop', tone: 'danger' }
      : client.outstandingPaisa > 0
        ? { text: 'Balance due', tone: 'warning' }
        : { text: 'Clear', tone: 'success' }

  const reliability = client.reliability

  /**
   * "Completed" is not stored. `reliability.totalReturns` is the real figure
   * where a record carries it; otherwise this is a stated derivation
   * (lifetime rentals minus the ones still running), and the `title` says so
   * on the row so nobody reads a derived number as a recorded one.
   */
  const completed =
    reliability?.totalReturns ?? Math.max(0, client.totalRentalsCount - client.currentRentalsCount)
  const completedIsDerived = reliability?.totalReturns === undefined

  return (
    <Drawer
      open={open}
      onClose={onClose}
      id={id}
      title="Client Status"
      subtitle={`${client.name} · ${client.id}`}
      width={400}
      footer={
        <>
          <Button variant="secondary" onClick={onClose}>
            Close
          </Button>
          <Button variant="primary" icon="external_link" onClick={() => onViewClient(client)}>
            View Client
          </Button>
        </>
      }
    >
      {/* ── CLIENT STATUS ─────────────────────────────────────────────── */}
      <DrawerSection title="Client Status">
        <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)', flexWrap: 'wrap' }}>
          <span style={{ fontSize: 'var(--t-h3)', fontWeight: 700, color: 'var(--text)', minWidth: 0 }}>
            {client.name}
          </span>
          {/*
            * The drawer's copy of `ClientCombobox`'s VIP chip, and it carried
            * the same bug: `--ext-line` + `--gold`, which v4.1 §2 reserves for
            * sub-rented / external gear and forbids as a status outright. See
            * the long note at `ClientCombobox.tsx` for the full reasoning; the
            * short version is that a VIP client is not external gear, and blue
            * ("committed · scheduled", §2) is the one hue of the seven that
            * describes a standing client relationship.
            *
            * Both copies now render the same <Badge>, so the drawer and the
            * option row cannot drift apart the way they already had — this one
            * was 20px at radius 999, the other 18px at radius 999, neither
            * matching §4's block.
            */}
          {client.isVip && <span
                    style={{
                      display: 'inline-flex',
                      alignItems: 'center',
                      gap: 4,
                      padding: '2px 7px',
                      borderRadius: 'var(--r-chip)',
                      background: 'var(--surface-2)',
                      border: '1px solid var(--border)',
                      color: 'var(--text2)',
                      fontSize: 'var(--t-th)',
                      fontWeight: 700,
                      letterSpacing: '0.02em',
                    }}
                  >
                    VIP
                  </span>}
          <ClientHealthChip verdict={verdict} size="md" style={{ marginLeft: 'auto' }} />
        </div>
        {client.company && (
          <div style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>{client.company}</div>
        )}
        {/* The colour never travels alone — these are the sentences behind it. */}
        <ClientHealthReasons verdict={verdict} />
      </DrawerSection>

      {/* ── FINANCIAL ─────────────────────────────────────────────────── */}
      <DrawerSection title="Financial">
        <DrawerRow
          label="Outstanding"
          value={showMoney ? formatMoney(client.outstandingPaisa) : RESTRICTED}
          figure
          {...(showMoney && client.outstandingPaisa > 0 ? { tone: 'danger' as const } : {})}
        />
        <DrawerRow
          label="Credit limit"
          value={
            !showMoney
              ? RESTRICTED
              : client.creditLimitPaisa > 0
                ? formatMoney(client.creditLimitPaisa)
                : 'Not configured'
          }
          figure={showMoney && client.creditLimitPaisa > 0}
        />
        {showMoney && credit.state === 'computed' && (
          <DrawerRow
            label="Credit used"
            value={`${formatMoney(credit.usedPaisa)} · ${Math.round(credit.ratio * 100)}%`}
            figure
            {...(credit.ratio > 1
              ? { tone: 'danger' as const }
              : credit.ratio >= CLIENT_HEALTH_THRESHOLDS.creditLimitApproachingRatio
                ? { tone: 'warning' as const }
                : {})}
          />
        )}
        {showMoney && credit.state === 'unavailable' && (
          <DrawerRow
            label="Credit used"
            value={null}
            unavailableNote="Not computed anywhere in the system — there is no credit-used column and no ruled formula, so the credit-limit check cannot be run for this client."
          />
        )}
        <DrawerRow label="Payment status" value={paymentStatus.text} tone={paymentStatus.tone} />
        {showMoney && credit.state === 'unavailable' && (
          <DrawerUnavailable>
            <strong>The credit-limit check could not be run.</strong> A limit of{' '}
            {formatMoney(credit.limitPaisa)} is approved, but nothing in the system computes how much of it
            is committed — so this client is <strong>unverified</strong>, which is not the same as within
            limit. The health above is held at Attention Required until a credit-used figure exists.
          </DrawerUnavailable>
        )}
        <DrawerUnavailable>
          Invoice-level status (overdue, days past due) is not tracked yet — no invoice source exists in the
          data layer, so this reflects the client balance only.
        </DrawerUnavailable>
      </DrawerSection>

      {/* ── EQUIPMENT ─────────────────────────────────────────────────── */}
      <DrawerSection title="Equipment">
        <DrawerRow
          label="Unreturned (open)"
          value={null}
          unavailableNote="Not tracked yet — no booking return date is recorded against a client in the current data layer."
        />
        <DrawerRow
          label="Missing — cases on record"
          value={reliability ? reliability.missingCases : null}
          unavailableNote="Not tracked for this client — the reliability record is absent."
          figure
          {...(reliability && reliability.missingCases > 0 ? { tone: 'warning' as const } : {})}
        />
        <DrawerRow
          label="Damaged — cases on record"
          value={reliability ? reliability.damageCases : null}
          unavailableNote="Not tracked for this client — the reliability record is absent."
          figure
          {...(reliability && reliability.damageCases > 0 ? { tone: 'warning' as const } : {})}
        />
        <DrawerUnavailable>
          These are <strong>lifetime case counts</strong>, not open items — the record carries no resolution
          state, so a settled case and an open one look the same here.
        </DrawerUnavailable>
      </DrawerSection>

      {/* ── RENTAL HISTORY ────────────────────────────────────────────── */}
      <DrawerSection title="Rental History">
        <DrawerRow label="Total rentals" value={client.totalRentalsCount} figure />
        <DrawerRow
          label={completedIsDerived ? 'Completed (derived)' : 'Completed'}
          value={
            completedIsDerived ? (
              <span title="Derived: lifetime rentals minus the rentals still running. Not a recorded figure.">
                {completed}
              </span>
            ) : (
              completed
            )
          }
          figure
        />
        <DrawerRow label="Currently on rent" value={client.currentRentalsCount} figure />
        <DrawerRow
          label="Late returns"
          value={reliability ? reliability.lateReturns : null}
          unavailableNote="Not tracked for this client — the reliability record is absent."
          figure
          {...(reliability && reliability.lateReturns > 0 ? { tone: 'warning' as const } : {})}
        />
        <DrawerRow label="Last rental" value={client.lastRentalAd} figure />
      </DrawerSection>
    </Drawer>
  )
}
</file>

<file path="src/modules/rentals/booking/CrewAndTransportSection.tsx">
import { useMemo } from 'react'
import type { Paisa } from '../../../lib/money'
import type { CrewMember } from '../../../lib/queries/crew'
import { CrewSection, type CrewLine } from './CrewSection'
import { DeliverySection } from './DeliverySection'

export interface TransportDetails {
  clientPickup: boolean
  deliveryType: 'Client Pickup' | 'Babin Delivery'
  vehicle: string
  numberPlate: string
  driverContact: string
  pickupLocation: string
  returnLocation: string
  specialInstructions: string
  returnPickupType: 'Client Return' | 'Babin Pickup'
  returnPickupAddress: string
  returnPickupTime: string
  returnPickupChargePaisa: number
  deliveryChargePaisa: Paisa
  fuelChargePaisa: Paisa
  transportPaisa: Paisa
}

export interface CrewAndTransportSectionProps {
  crew: CrewLine[]
  transport: TransportDetails
  onUpdateCrew: (crewId: string, updates: Partial<CrewLine>) => void
  onRemoveCrew: (crewId: string) => void
  onClearCrew: () => void
  onAddCrew?: ((crewId: string) => void) | undefined
  onUpdateTransport: (updates: Partial<TransportDetails>) => void
  canCrewMoney: boolean
  canBookingMoney?: boolean | undefined
  days?: number | undefined
  readOnly?: boolean | undefined
  liveCrew?: readonly CrewMember[] | null | undefined
  isPhone?: boolean | undefined
  openCrew?: boolean | undefined
  onToggleCrew?: (() => void) | undefined
  openDelivery?: boolean | undefined
  onToggleDelivery?: (() => void) | undefined
  crewTitle?: string | undefined
  deliveryTitle?: string | undefined
}

/**
 * Consolidated Crew & Transport Logistics section (Contract FR-007 / Item 13).
 *
 * Encapsulates assigned crew members, role tags, overtime/per-diem extras,
 * and delivery/pickup logistics. Holds zero business logic or pricing arithmetic;
 * delegates edits through declared callbacks `onUpdateCrew` and `onUpdateTransport`.
 *
 * Law 6: strictly omits all money amounts and inputs when `canCrewMoney` or
 * `canBookingMoney` are false.
 */
export function CrewAndTransportSection({
  crew,
  transport,
  onUpdateCrew,
  onRemoveCrew,
  onClearCrew,
  onAddCrew = () => {},
  onUpdateTransport,
  canCrewMoney,
  canBookingMoney = true,
  days = 1,
  liveCrew,
  isPhone = false,
  openCrew = false,
  onToggleCrew = () => {},
  openDelivery = false,
  onToggleDelivery = () => {},
  crewTitle,
  deliveryTitle,
}: CrewAndTransportSectionProps) {
  const crewChargesPaisa = useMemo(
    () =>
      crew.reduce(
        (acc, member) =>
          acc +
          member.dayRatePaisa * (member.days ?? (days || 1)) +
          member.overtimePaisa +
          member.accommodationPaisa +
          member.mealsPaisa,
        0,
      ) as Paisa,
    [crew, days],
  )

  const handleUpdateCrewExtras = (
    crewId: string,
    field: 'overtimePaisa' | 'accommodationPaisa' | 'mealsPaisa',
    paisa: Paisa,
  ) => {
    onUpdateCrew(crewId, { [field]: paisa })
  }

  return (
    <>
      <CrewSection
        open={openCrew}
        onToggle={onToggleCrew}
        crew={crew}
        days={days}
        canCrewMoney={canCrewMoney}
        liveCrew={liveCrew}
        onAddCrew={onAddCrew}
        onRemoveCrew={onRemoveCrew}
        onClearCrew={onClearCrew}
        onUpdateCrewExtras={handleUpdateCrewExtras}
        crewChargesPaisa={crewChargesPaisa}
        isPhone={isPhone}
        {...(crewTitle ? { title: crewTitle } : {})}
      />

      <DeliverySection
        open={openDelivery}
        onToggle={onToggleDelivery}
        isPhone={isPhone}
        clientPickup={transport.clientPickup}
        deliveryType={transport.deliveryType}
        setDeliveryType={(val) =>
          onUpdateTransport({
            deliveryType: val,
            clientPickup: val === 'Client Pickup',
          })
        }
        vehicle={transport.vehicle}
        setVehicle={(val) => onUpdateTransport({ vehicle: val })}
        numberPlate={transport.numberPlate}
        setNumberPlate={(val) => onUpdateTransport({ numberPlate: val })}
        driverContact={transport.driverContact}
        setDriverContact={(val) => onUpdateTransport({ driverContact: val })}
        pickupLocation={transport.pickupLocation}
        setPickupLocation={(val) => onUpdateTransport({ pickupLocation: val })}
        returnLocation={transport.returnLocation}
        setReturnLocation={(val) => onUpdateTransport({ returnLocation: val })}
        specialInstructions={transport.specialInstructions}
        setSpecialInstructions={(val) =>
          onUpdateTransport({ specialInstructions: val })
        }
        returnPickupType={transport.returnPickupType}
        setReturnPickupType={(val) => onUpdateTransport({ returnPickupType: val })}
        returnPickupAddress={transport.returnPickupAddress}
        setReturnPickupAddress={(val) =>
          onUpdateTransport({ returnPickupAddress: val })
        }
        returnPickupTime={transport.returnPickupTime}
        setReturnPickupTime={(val) =>
          onUpdateTransport({ returnPickupTime: val })
        }
        returnPickupChargePaisa={transport.returnPickupChargePaisa}
        setReturnPickupChargePaisa={(val) =>
          onUpdateTransport({ returnPickupChargePaisa: val })
        }
        deliveryChargePaisa={transport.deliveryChargePaisa}
        setDeliveryChargePaisa={(val) =>
          onUpdateTransport({ deliveryChargePaisa: val })
        }
        fuelChargePaisa={transport.fuelChargePaisa}
        setFuelChargePaisa={(val) => onUpdateTransport({ fuelChargePaisa: val })}
        transportPaisa={transport.transportPaisa}
        canBookingMoney={canBookingMoney}
        {...(deliveryTitle ? { title: deliveryTitle } : {})}
      />
    </>
  )
}
</file>

<file path="src/modules/rentals/booking/CrewSearch.tsx">
import React, { useEffect, useId, useMemo, useRef, useState } from 'react'
import Icon from '../../../components/ui/Icon'
import { formatMoney } from '../../../lib/money'
import { CREW_ROSTER, searchRoster, type CrewMember, type CrewRole } from '../../../lib/queries/crew'
import { CREW_ROLES } from '../../../actions/rentals/createRental'
import { Field, inputStyle } from './BookingFormWidgets'

export type RoleRejectedByDb = Exclude<CrewRole, (typeof CREW_ROLES)[number]>

export const ROLES_ACCEPTED_BY_DB: ReadonlySet<string> = new Set<string>(CREW_ROLES)

export function dbRejectsRole(role: CrewRole): role is RoleRejectedByDb {
  return !ROLES_ACCEPTED_BY_DB.has(role)
}

/** One sentence, no jargon, same wording in the row and in its accessible name. */
export function rejectionNote(role: CrewRole): string {
  return `The database has no “${role}” role, so Confirm will refuse this booking until that is settled.`
}

export interface CrewSearchProps {
  /** Who is already on the booking. Excluded from the list — nobody is added twice. */
  onBooking: readonly { crewId: string }[]
  onAdd: (crewId: string) => void
  /** The page's `canCrewMoney`. A money-blind role sees the roster and never a rate. */
  showRates: boolean
  roster?: readonly CrewMember[]
}

export function CrewSearch({
  onBooking,
  onAdd,
  showRates,
  roster = CREW_ROSTER,
}: CrewSearchProps) {
  const reactId = useId()
  const labelId = `${reactId}-crew-label`
  const listboxId = `${reactId}-crew-listbox`
  const hintId = `${reactId}-crew-hint`

  const [query, setQuery] = useState('')
  const [activeIndex, setActiveIndex] = useState(0)
  const [open, setOpen] = useState(false)
  const [cursorMoved, setCursorMoved] = useState(false)
  const rootRef = useRef<HTMLDivElement | null>(null)
  const inputRef = useRef<HTMLInputElement | null>(null)

  const excludeIds = useMemo(() => onBooking.map((c) => c.crewId), [onBooking])
  const options = useMemo(() => searchRoster(query, excludeIds, roster), [query, excludeIds, roster])
  const rosterExhausted = useMemo(() => searchRoster('', excludeIds, roster).length === 0, [excludeIds, roster])

  // Clamp the cursor whenever the result set shrinks under it.
  useEffect(() => {
    setActiveIndex((i) => (i >= options.length ? 0 : i))
  }, [options.length])

  const activeId = open && options[activeIndex] ? `${listboxId}-opt-${activeIndex}` : undefined

  useEffect(() => {
    if (!open || !cursorMoved || !activeId) return
    document.getElementById(activeId)?.scrollIntoView({ block: 'nearest' })
  }, [open, cursorMoved, activeId])

  /** Close on outside pointer interaction */
  useEffect(() => {
    if (!open) return
    const onPointerDown = (e: PointerEvent) => {
      const target = e.target as Node | null
      if (rootRef.current && !rootRef.current.contains(target)) {
        setOpen(false)
      }
    }
    document.addEventListener('pointerdown', onPointerDown)
    return () => document.removeEventListener('pointerdown', onPointerDown)
  }, [open])

  const commit = (m: CrewMember) => {
    onAdd(m.id)
    setQuery('')
    setActiveIndex(0)
    setOpen(false)
    inputRef.current?.focus()
  }

  function onKeyDown(e: React.KeyboardEvent<HTMLInputElement>) {
    const count = options.length
    switch (e.key) {
      case 'ArrowDown':
      case 'ArrowUp':
        e.preventDefault()
        if (!open) {
          setOpen(true)
          return
        }
        setCursorMoved(true)
        setActiveIndex((i) => (count === 0 ? 0 : e.key === 'ArrowDown' ? (i + 1) % count : (i - 1 + count) % count))
        return
      case 'Home':
      case 'End': {
        if (query !== '') return
        e.preventDefault()
        setCursorMoved(true)
        setActiveIndex(e.key === 'Home' ? 0 : Math.max(0, count - 1))
        return
      }
      case 'Enter': {
        const m = options[activeIndex]
        if (!m) return
        e.preventDefault()
        commit(m)
        return
      }
      case 'Escape':
        e.preventDefault()
        e.stopPropagation()
        setOpen(false)
        if (query !== '') {
          setQuery('')
          setActiveIndex(0)
        }
        setCursorMoved(false)
        inputRef.current?.blur()
        return
      default:
    }
  }

  return (
    <div ref={rootRef} style={{ position: 'relative', marginBottom: 'var(--sp-md)' }}>
      <Field label="Add crew" labelId={labelId}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
          <div style={{ position: 'relative', flex: 1 }}>
            <input
              ref={inputRef}
              type="text"
              role="combobox"
              autoComplete="off"
              spellCheck={false}
              aria-expanded={open}
              aria-controls={listboxId}
              aria-autocomplete="list"
              aria-haspopup="listbox"
              aria-labelledby={labelId}
              aria-describedby={hintId}
              {...(activeId ? { 'aria-activedescendant': activeId } : {})}
              placeholder="Search the roster by name or role…"
              value={query}
              onFocus={() => setOpen(true)}
              onClick={() => setOpen(true)}
              onChange={(e) => {
                setQuery(e.target.value)
                setActiveIndex(0)
                if (!open) setOpen(true)
              }}
              onKeyDown={onKeyDown}
              style={{ ...inputStyle, paddingLeft: 32, paddingRight: query ? 32 : 10 }}
            />
            <span
              aria-hidden="true"
              style={{
                position: 'absolute',
                left: 10,
                top: '50%',
                transform: 'translateY(-50%)',
                display: 'inline-flex',
                color: 'var(--muted)',
                pointerEvents: 'none',
              }}
            >
              <Icon name="search" size={15} />
            </span>
            {query && (
              <button
                type="button"
                className="press"
                aria-label="Clear search query"
                onClick={() => {
                  setQuery('')
                  setActiveIndex(0)
                  inputRef.current?.focus()
                }}
                style={{
                  position: 'absolute',
                  right: 8,
                  top: '50%',
                  transform: 'translateY(-50%)',
                  background: 'transparent',
                  border: 'none',
                  color: 'var(--muted)',
                  cursor: 'pointer',
                  padding: 4,
                  display: 'inline-flex',
                  alignItems: 'center',
                  justifyContent: 'center',
                  borderRadius: 4,
                }}
              >
                <Icon name="close" size={14} />
              </button>
            )}
          </div>

          <button
            type="button"
            className="press"
            onClick={() => {
              setOpen((o) => {
                const next = !o
                if (next) globalThis.requestAnimationFrame(() => inputRef.current?.focus())
                else inputRef.current?.blur()
                return next
              })
            }}
            aria-expanded={open}
            aria-label={open ? 'Hide crew roster' : 'Browse crew roster'}
            style={{
              display: 'inline-flex',
              alignItems: 'center',
              gap: 6,
              height: 38,
              padding: '0 14px',
              borderRadius: 'var(--r-btn)',
              background: open ? 'var(--st-primary-bg)' : 'var(--btn-secondary-bg)',
              color: open ? 'var(--st-primary-fg)' : 'var(--text)',
              border: `1px solid ${open ? 'var(--primary)' : 'var(--btn-secondary-border)'}`,
              fontFamily: 'inherit',
              fontSize: 'var(--t-meta)',
              fontWeight: 600,
              cursor: 'pointer',
              whiteSpace: 'nowrap',
              flexShrink: 0,
            }}
          >
            <span>{open ? 'Hide' : 'Browse'}</span>
            <Icon name={open ? 'chevron_up' : 'chevron_down'} size={15} />
          </button>
        </div>
      </Field>

      {open && (
        <div
          role="dialog"
          aria-label="Crew roster search results"
          style={{
            position: 'absolute',
            zIndex: 35,
            top: 'calc(100% + 4px)',
            left: 0,
            width: '100%',
            maxHeight: 260,
            overflowY: 'auto',
            border: '1px solid var(--border)',
            borderRadius: 'var(--r-card)',
            background: 'var(--dropdown)',
            boxShadow: 'var(--shadow-modal)',
          }}
        >
          <p id={hintId} style={{ margin: '8px 10px 4px', fontSize: 'var(--t-meta)', color: 'var(--muted)' }}>
            Up and Down to move, Enter to add, Escape to close. Anyone already on this booking is left out of the list.
          </p>

          <ul id={listboxId} role="listbox" aria-labelledby={labelId} style={{ listStyle: 'none', margin: 0, padding: 4 }}>
            {options.map((m, i) => {
              const active = i === activeIndex
              const rejected = dbRejectsRole(m.role)
              const note = rejected ? rejectionNote(m.role) : ''
              return (
                <li
                  key={m.id}
                  id={`${listboxId}-opt-${i}`}
                  role="option"
                  aria-selected={active}
                  aria-label={`${m.name}, ${m.role}.${
                    showRates ? ` ${formatMoney(m.dayRatePaisa)} per day.` : ''
                  }${note ? ` ${note}` : ''} Press Enter to add to this booking.`}
                  onMouseMove={() => {
                    setCursorMoved(false)
                    setActiveIndex(i)
                  }}
                  onClick={() => commit(m)}
                  style={{
                    display: 'grid',
                    gap: 2,
                    minHeight: 'var(--tap)',
                    alignContent: 'center',
                    padding: '7px 9px',
                    borderRadius: 'var(--r-btn)',
                    cursor: 'pointer',
                    background: active ? 'var(--hover-row)' : 'transparent',
                  }}
                >
                  <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)', minWidth: 0 }}>
                    <span style={{ display: 'inline-flex', flexShrink: 0, color: 'var(--text2)' }}>
                      <Icon name="crew" size={15} />
                    </span>
                    <span
                      style={{
                        fontSize: 'var(--t-ui)',
                        fontWeight: 600,
                        color: 'var(--text)',
                        overflow: 'hidden',
                        textOverflow: 'ellipsis',
                        whiteSpace: 'nowrap',
                      }}
                    >
                      {m.name}
                    </span>
                    <span style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)', whiteSpace: 'nowrap' }}>{m.role}</span>
                    {showRates && (
                      <span
                        className="figure"
                        style={{ marginLeft: 'auto', flexShrink: 0, fontSize: 'var(--t-meta)', fontWeight: 700, color: 'var(--text)' }}
                      >
                        {formatMoney(m.dayRatePaisa)}/day
                      </span>
                    )}
                  </div>
                  {note && (
                    <div style={{ display: 'flex', alignItems: 'flex-start', gap: 5, fontSize: 'var(--t-meta)', color: 'var(--warn-text)' }}>
                      <span style={{ display: 'inline-flex', paddingTop: 1, flexShrink: 0 }}>
                        <Icon name="alert_triangle" size={13} />
                      </span>
                      <span style={{ minWidth: 0 }}>{note}</span>
                    </div>
                  )}
                </li>
              )
            })}
            {options.length === 0 && (
              <li role="presentation" style={{ padding: '10px 9px', fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
                {rosterExhausted
                  ? 'Everyone on the roster is already on this booking.'
                  : `No one on the roster matches “${query.trim()}”. Names and roles are searched.`}
              </li>
            )}
          </ul>
        </div>
      )}
    </div>
  )
}
</file>

<file path="src/modules/rentals/booking/CrewSection.tsx">
import { Fragment, useState } from 'react'
import { Link } from 'react-router-dom'
import Icon from '../../../components/ui/Icon'
import { Button, Input } from '../../../components/ui'
import { DataTableShell } from '../../../components/ui/DataTable'
import { EmptyState } from '../../../components/ui/StateViews'
import { Field, Section, TouchInset, inputStyle } from './BookingFormWidgets'
import { formatMoney, rupees, type Paisa } from '../../../lib/money'
import { crewPool, type CrewMember, type CrewRole } from '../../../lib/queries/crew'
import { CrewSearch } from './CrewSearch'

export interface CrewLine {
  crewId: string
  bookingCrewLineId?: string | undefined
  crewMemberId?: string | undefined
  days?: number | undefined
  name: string
  role: CrewRole
  phone: string
  dayRatePaisa: Paisa
  overtimePaisa: Paisa
  accommodationPaisa: Paisa
  mealsPaisa: Paisa
}

const th = {
  textAlign: 'left' as const,
  padding: '7px 9px',
  fontSize: 'var(--t-th)',
  fontWeight: 700,
  color: 'var(--text2)',
  letterSpacing: '0.03em',
  textTransform: 'uppercase' as const,
  whiteSpace: 'nowrap' as const,
  borderBottom: '1px solid var(--border)',
}

const td = {
  height: 'var(--row-min-h)',
  padding: '7px 9px',
  fontSize: 'var(--t-meta)',
  color: 'var(--text)',
  whiteSpace: 'nowrap' as const,
}

export interface CrewSectionProps {
  open: boolean
  onToggle: () => void
  crew: CrewLine[]
  days: number
  canCrewMoney: boolean
  liveCrew?: readonly CrewMember[] | null | undefined
  onAddCrew: (crewId: string) => void
  onRemoveCrew: (crewId: string) => void
  onClearCrew: () => void
  onUpdateCrewExtras: (
    crewId: string,
    field: 'overtimePaisa' | 'accommodationPaisa' | 'mealsPaisa',
    paisa: Paisa,
  ) => void
  crewChargesPaisa: Paisa
  isPhone: boolean
  title?: string
}

export function CrewSection({
  open,
  onToggle,
  crew,
  days,
  canCrewMoney,
  liveCrew,
  onAddCrew,
  onRemoveCrew,
  onClearCrew,
  onUpdateCrewExtras,
  crewChargesPaisa,
  isPhone,
  title = 'Crew',
}: CrewSectionProps) {
  const [expandedCrew, setExpandedCrew] = useState<Set<string>>(new Set())

  const toggleCrewExpanded = (crewId: string) => {
    setExpandedCrew((prev) => {
      const next = new Set(prev)
      if (next.has(crewId)) {
        next.delete(crewId)
      } else {
        next.add(crewId)
      }
      return next
    })
  }

  return (
    <Section
      id="section-3"
      title={title}
      badge={
        crew.length > 0 ? (
          <span
            style={{
              display: 'inline-flex',
              alignItems: 'center',
              gap: 4,
              padding: '2px 8px',
              borderRadius: 'var(--r-badge)',
              background: 'var(--st-primary-bg)',
              color: 'var(--st-primary-fg)',
              fontSize: 11,
              fontWeight: 600,
            }}
          >
            {crew.length} {crew.length === 1 ? 'member' : 'members'}
          </span>
        ) : null
      }
      open={open}
      onToggle={onToggle}
      summary={crew.length === 0 ? 'Optional / None' : `${crew.length} crew`}
    >
      <div>
        {(!liveCrew || liveCrew.length === 0) && (
          <p style={{ margin: '0 0 var(--sp-sm)', fontSize: 'var(--t-meta)', color: 'var(--warn-text)', lineHeight: 1.5 }}>
            This is a <strong>sample roster</strong> — the people and the day rates they are priced at are invented in
            the app, not read from the database. Adding someone puts their name, role and rate on this booking when it
            is confirmed; it does not link a staff record, and it reserves nobody, because booking a crew member's own
            calendar is not built yet.
          </p>
        )}
        <CrewSearch
          onBooking={crew}
          onAdd={onAddCrew}
          showRates={canCrewMoney}
          roster={crewPool(liveCrew)}
        />
        <div style={{ minWidth: 0 }}>
          <DataTableShell ariaLabel="Assigned crew">
            <table style={{ width: '100%', borderCollapse: 'collapse', minWidth: 500 }}>
              <thead>
                <tr style={{ background: 'var(--th-bg)' }}>
                  {(canCrewMoney
                    ? ['Name', 'Role', 'Day Rate', 'Days', 'Amount', '', '']
                    : ['Name', 'Role', '']
                  ).map((h, i) => (
                    <th
                      key={h === '' ? `blank-${i}` : h}
                      scope="col"
                      style={{ ...th, textAlign: i >= 2 && i <= 4 ? 'right' : 'left' }}
                    >
                      {h}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {crew.map((c) => {
                  const expanded = expandedCrew.has(c.crewId)
                  const hasExtras = c.overtimePaisa > 0 || c.mealsPaisa > 0 || c.accommodationPaisa > 0
                  return (
                    <Fragment key={c.crewId}>
                      <tr style={{ borderBottom: expanded ? 'none' : '1px solid var(--border)' }}>
                        <td style={{ ...td, fontWeight: 600 }}>
                          <Link
                            to={`/crew`}
                            style={{ color: 'inherit', textDecoration: 'none' }}
                            title={`Open ${c.name} in Crew Assist`}
                          >
                            {c.name}
                          </Link>
                        </td>
                        <td style={{ ...td, color: 'var(--text2)' }}>{c.role}</td>
                        {canCrewMoney && (
                          <>
                            <td className="figure" style={{ ...td, textAlign: 'right', color: 'var(--text2)' }}>
                              {formatMoney(c.dayRatePaisa)}
                            </td>
                            <td className="figure" style={{ ...td, textAlign: 'right' }}>
                              {c.days ?? days}
                            </td>
                            <td className="figure" style={{ ...td, textAlign: 'right', fontWeight: 700 }}>
                              {formatMoney(
                                (c.dayRatePaisa * (c.days ?? days) +
                                  c.overtimePaisa +
                                  c.accommodationPaisa +
                                  c.mealsPaisa) as Paisa,
                              )}
                            </td>
                            <td style={{ ...td, width: 30, textAlign: 'right' }}>
                              <button
                                type="button"
                                className="press"
                                aria-label={`${expanded ? 'Hide' : 'Show'} overtime, meals and accommodation for ${c.name}`}
                                aria-expanded={expanded}
                                onClick={() => toggleCrewExpanded(c.crewId)}
                                style={{
                                  position: 'relative',
                                  width: 22,
                                  height: 22,
                                  display: 'grid',
                                  placeItems: 'center',
                                  borderRadius: 'var(--r-xs)',
                                  border: 'none',
                                  background: hasExtras ? 'var(--st-primary-bg)' : 'transparent',
                                  color: hasExtras ? 'var(--st-primary-fg)' : expanded ? 'var(--text)' : 'var(--muted)',
                                  cursor: 'pointer',
                                }}
                              >
                                <TouchInset />
                                <Icon name={expanded ? 'chevron_up' : 'chevron_down'} size={13} />
                              </button>
                            </td>
                          </>
                        )}
                        <td style={{ ...td, width: 30, textAlign: 'right' }}>
                          <button
                            type="button"
                            className="press"
                            aria-label={`Remove ${c.name} from this booking`}
                            title={`Remove ${c.name}`}
                            onClick={() => onRemoveCrew(c.crewId)}
                            style={{
                              position: 'relative',
                              width: 22,
                              height: 22,
                              display: 'grid',
                              placeItems: 'center',
                              borderRadius: 'var(--r-xs)',
                              border: 'none',
                              background: 'transparent',
                              color: 'var(--muted)',
                              cursor: 'pointer',
                            }}
                          >
                            <TouchInset />
                            <Icon name="close" size={13} />
                          </button>
                        </td>
                      </tr>
                      {canCrewMoney && expanded && (
                        <tr style={{ borderBottom: '1px solid var(--border)' }}>
                          <td colSpan={7} style={{ ...td, background: 'var(--card2)', padding: '10px 12px' }}>
                            <div
                              style={{
                                display: 'grid',
                                gridTemplateColumns: isPhone ? '1fr' : 'repeat(3, minmax(0, 180px))',
                                gap: 12,
                                alignItems: 'center',
                              }}
                            >
                              <Field label="Overtime (Rs) *">
                                <Input
                                  type="number"
                                  min={0}
                                  value={c.overtimePaisa > 0 ? c.overtimePaisa / 100 : ''}
                                  placeholder="0"
                                  onChange={(e) =>
                                    onUpdateCrewExtras(
                                      c.crewId,
                                      'overtimePaisa',
                                      rupees(Math.max(0, Number(e.target.value) || 0)),
                                    )
                                  }
                                  style={{ ...inputStyle, minHeight: 44, fontSize: 'var(--t-meta)' }}
                                />
                              </Field>
                              <Field label="Meals (Rs) *">
                                <Input
                                  type="number"
                                  min={0}
                                  value={c.mealsPaisa > 0 ? c.mealsPaisa / 100 : ''}
                                  placeholder="0"
                                  onChange={(e) =>
                                    onUpdateCrewExtras(
                                      c.crewId,
                                      'mealsPaisa',
                                      rupees(Math.max(0, Number(e.target.value) || 0)),
                                    )
                                  }
                                  style={{ ...inputStyle, minHeight: 44, fontSize: 'var(--t-meta)' }}
                                />
                              </Field>
                              <Field label="Accommodation (Rs) *">
                                <Input
                                  type="number"
                                  min={0}
                                  value={c.accommodationPaisa > 0 ? c.accommodationPaisa / 100 : ''}
                                  placeholder="0"
                                  onChange={(e) =>
                                    onUpdateCrewExtras(
                                      c.crewId,
                                      'accommodationPaisa',
                                      rupees(Math.max(0, Number(e.target.value) || 0)),
                                    )
                                  }
                                  style={{ ...inputStyle, minHeight: 44, fontSize: 'var(--t-meta)' }}
                                />
                              </Field>
                            </div>
                          </td>
                        </tr>
                      )}
                    </Fragment>
                  )
                })}
                {canCrewMoney && (
                  <tr>
                    <td colSpan={4} style={{ ...td, fontWeight: 700, color: 'var(--text2)' }}>
                      Crew Subtotal
                    </td>
                    <td className="figure" style={{ ...td, textAlign: 'right', fontWeight: 700 }}>
                      {formatMoney(crewChargesPaisa)}
                    </td>
                    <td style={td} />
                    <td style={td} />
                  </tr>
                )}
              </tbody>
            </table>
          </DataTableShell>
          {crew.length === 0 && (
            <div style={{ marginTop: 10 }}>
              <EmptyState title="No crew assigned" description="Add a crew member to staff this booking." />
            </div>
          )}
          {crew.length > 0 && (
            <div style={{ marginTop: 9 }}>
              <Button onClick={onClearCrew}>Clear crew</Button>
            </div>
          )}
        </div>
      </div>
    </Section>
  )
}
</file>

<file path="src/modules/rentals/booking/DateTimeField.tsx">
import { useEffect, useLayoutEffect, useRef, useState } from 'react'
import { createPortal } from 'react-dom'
import Icon from '../../../components/ui/Icon'
import { TouchTarget } from '../../../components/ui/TouchTarget'
import { floatingLayer } from '../../../components/ui/floatingLayer'
import {
  CalendarPopover,
  TimeListPopover,
  displayDate,
  parseDateInput,
  parseTimeInput,
} from '../../../components/ui/DateField'
import { toBs, formatBs } from '../../../lib/bs'

/**
 * redesign v1 §4 — typeable date + time, two separate 44×44 icon buttons,
 * BS rendered above the AD value, default time never blank. The rental day
 * runs 06:00→06:00 (Foundation), so a booking with no time cannot be priced
 * correctly at the boundary — this replaced the bare `<input type="date">`
 * NewRental used before, which had no time component at all.
 *
 * ## The calendar moved out, 4 Sep 2026
 *
 * The month grid, the time list and the date/time parsers used to live in this
 * file, which meant the app's only real date picker was reachable from exactly
 * one screen while 24 other date inputs across 13 files fell back to the
 * browser's native control — and a native control cannot render a BS date at
 * all (Law 9 §9.4).
 *
 * They now live in `components/ui/DateField`, and this file composes them.
 * Nothing about the rendered field changed; the parsers are re-exported below
 * because `booking/index.ts` publishes them and tests import them from here.
 */

export { parseDateInput, parseTimeInput }

// RULING 2026-10-08: the wider setup row gives each date/time picker a full 44px target.
const iconBtnStyle = {
  position: 'relative' as const,
  flexShrink: 0,
  width: 44,
  height: 44,
  display: 'grid',
  placeItems: 'center',
  borderRadius: 'var(--r-xs)',
  border: 'none',
  background: 'transparent',
  color: 'var(--text2)',
  cursor: 'pointer',
}

export interface DateTimeFieldProps {
  label: string
  required?: boolean
  /** 'YYYY-MM-DD' */
  dateValue: string
  /** 'HH:mm' — never blank; callers seed a default (09:00 pickup / 18:00 return per redesign v1 §4). */
  timeValue: string
  onDateChange: (v: string) => void
  onTimeChange: (v: string) => void
  error?: string | undefined
}

export function DateTimeField({ label, required = false, dateValue, timeValue, onDateChange, onTimeChange, error }: DateTimeFieldProps) {
  const [dateText, setDateText] = useState(() => displayDate(dateValue))
  const [timeText, setTimeText] = useState(timeValue)
  const [calendarOpen, setCalendarOpen] = useState(false)
  const [timeListOpen, setTimeListOpen] = useState(false)
  const rootRef = useRef<HTMLDivElement | null>(null)
  const panelRef = useRef<HTMLDivElement | null>(null)
  const panelAdjusted = useRef(false)
  /* Floating position of the portaled popups. The New Rental sections clip
     overflow (`new-rental-section-card`), so inline absolute popups get cut —
     the portal wrapper is a viewport-positioned box matching the field, and
     the inner absolute panels resolve against it. */
  const [panelPos, setPanelPos] = useState<{ top: number; left: number; width: number } | null>(null)

  const measurePanel = () => {
    const el = rootRef.current
    if (!el) return
    panelAdjusted.current = false
    const r = el.getBoundingClientRect()
    const panelW = Math.min(360, window.innerWidth - 24)
    setPanelPos({
      top: r.bottom,
      left: Math.min(Math.max(8, r.left), Math.max(8, window.innerWidth - panelW - 8)),
      width: Math.max(r.width, 120),
    })
  }

  useEffect(() => {
    if (!calendarOpen && !timeListOpen) {
      panelAdjusted.current = false
      return
    }
    measurePanel()
    window.addEventListener('scroll', measurePanel, true)
    window.addEventListener('resize', measurePanel)
    return () => {
      window.removeEventListener('scroll', measurePanel, true)
      window.removeEventListener('resize', measurePanel)
    }
  }, [calendarOpen, timeListOpen])

  /* Pull up when the panel would run past the viewport bottom. */
  useLayoutEffect(() => {
    if ((!calendarOpen && !timeListOpen) || !panelPos || panelAdjusted.current) return
    const panel = panelRef.current?.firstElementChild as HTMLElement | null
    if (!panel) return
    const overflow = panel.getBoundingClientRect().bottom - window.innerHeight + 8
    if (overflow > 0) {
      panelAdjusted.current = true
      setPanelPos((p) => (p ? { ...p, top: Math.max(8, p.top - overflow) } : p))
    }
  }, [calendarOpen, timeListOpen, panelPos])

  useEffect(() => setDateText(displayDate(dateValue)), [dateValue])
  useEffect(() => setTimeText(timeValue), [timeValue])

  useEffect(() => {
    if (!calendarOpen && !timeListOpen) return
    const onDown = (e: MouseEvent) => {
      const target = e.target as Node | null
      // Popups are portaled to document.body — a pointer inside them is
      // logically inside, even though outside `rootRef` in the DOM.
      if (panelRef.current?.contains(target)) return
      if (!rootRef.current?.contains(target)) {
        setCalendarOpen(false)
        setTimeListOpen(false)
      }
    }
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        setCalendarOpen(false)
        setTimeListOpen(false)
      }
    }
    document.addEventListener('mousedown', onDown)
    window.addEventListener('keydown', onKey)
    return () => {
      document.removeEventListener('mousedown', onDown)
      window.removeEventListener('keydown', onKey)
    }
  }, [calendarOpen, timeListOpen])

  const adDate = Number.isNaN(Date.parse(dateValue)) ? null : new Date(dateValue)
  const bs = adDate ? toBs(adDate) : null

  const commitDate = (text: string) => {
    const parsed = parseDateInput(text)
    if (parsed) onDateChange(parsed)
    else setDateText(displayDate(dateValue))
  }
  // Never blank — an unparseable time reverts to the last good value rather
  // than silently becoming midnight (redesign v1 §4).
  const commitTime = (text: string) => {
    const parsed = parseTimeInput(text) ?? timeValue
    onTimeChange(parsed)
    setTimeText(parsed)
  }

  return (
    <div ref={rootRef} style={{ position: 'relative', minWidth: 0 }}>
      <span style={{ display: 'block', fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--muted)', marginBottom: 3 }}>{label}{required ? ' *' : ''}</span>
      {/* 01_NEW_RENTAL §1.1 DATES box — "BS above AD on both". The wireframe and
          Foundation §3.2's "BS leads AD" put it first, so it sits above the
          input rather than under it. `lib/bs.ts` is the one Date Engine: nothing
          here computes a BS date, and outside the month that engine vouches for
          it says so instead of rendering a plausible one. */}
      <div
        className="figure"
        style={{ marginBottom: 3, fontSize: 'var(--t-th)', fontWeight: 700, color: bs ? 'var(--booking-date-text)' : 'var(--muted)' }}
      >
        {bs ? formatBs(bs) : 'BS not available for this date'}
      </div>
      <div className="focus-host" style={{ display: 'flex', alignItems: 'center', gap: 0, border: '1px solid var(--input-border)', borderRadius: 'var(--r-input)', background: 'var(--input-bg)', padding: '0 0 0 10px', minHeight: 46 }}>
        <input
          value={dateText}
          onChange={(e) => setDateText(e.target.value)}
          onBlur={(e) => commitDate(e.target.value)}
          onKeyDown={(e) => {
            if (e.key === 'Enter') (e.target as HTMLInputElement).blur()
          }}
          onClick={() => {
            // Tapping the date box opens the calendar — the icon is a second
            // way in, not the only one.
            setTimeListOpen(false)
            setCalendarOpen(true)
          }}
          aria-label={`${label} date`}
          aria-required={required || undefined}
          style={{ flex: '1 1 auto', minWidth: 0, minHeight: 44, border: 'none', background: 'transparent', color: 'var(--booking-date-text)', fontSize: 'var(--t-meta)', fontFamily: 'inherit', outline: 'none' }}
        />
        <button
          type="button"
          className="press"
          aria-label={`Open calendar for ${label}`}
          aria-haspopup="dialog"
          aria-expanded={calendarOpen}
          onClick={() => {
            setCalendarOpen((o) => !o)
            setTimeListOpen(false)
          }}
          style={iconBtnStyle}
        >
          <TouchTarget axis="y" />
          <Icon name="calendar_event" size={15} />
        </button>
        <input
          value={timeText}
          onChange={(e) => setTimeText(e.target.value)}
          onBlur={(e) => commitTime(e.target.value)}
          onKeyDown={(e) => {
            if (e.key === 'Enter') (e.target as HTMLInputElement).blur()
          }}
          aria-label={`${label} time`}
          aria-required={required || undefined}
          style={{ width: 48, minHeight: 44, flexShrink: 0, border: 'none', borderLeft: '1px solid var(--border)', background: 'transparent', color: 'var(--booking-date-text)', fontSize: 'var(--t-meta)', fontFamily: 'inherit', textAlign: 'center', paddingLeft: 4 }}
        />
        <button
          type="button"
          className="press"
          aria-label={`Open time picker for ${label}`}
          aria-haspopup="listbox"
          aria-expanded={timeListOpen}
          onClick={() => {
            setTimeListOpen((o) => !o)
            setCalendarOpen(false)
          }}
          style={iconBtnStyle}
        >
          <TouchTarget axis="y" />
          <Icon name="timer" size={15} />
        </button>
      </div>
      {error && <span role="alert" style={{ display: 'block', fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--danger-text)', marginTop: 3 }}>{error}</span>}

      {(calendarOpen || timeListOpen) && panelPos && createPortal(
        <div ref={panelRef} style={{ position: 'fixed', top: panelPos.top, left: panelPos.left, width: panelPos.width, height: 0, zIndex: floatingLayer(rootRef.current) }}>
          {calendarOpen && (
        <CalendarPopover
          value={dateValue}
          onSelect={(v) => {
            onDateChange(v)
            setCalendarOpen(false)
            // Chained flow: once the day is set, the time list opens on its
            // own so the operator never hunts for the second picker.
            setTimeListOpen(true)
          }}
          onDismiss={() => setCalendarOpen(false)}
        />
          )}
          {timeListOpen && (
        <TimeListPopover
          value={timeValue}
          onSelect={(v) => {
            onTimeChange(v)
            setTimeListOpen(false)
          }}
        />
          )}
        </div>,
        document.body,
      )}
    </div>
  )
}
</file>

