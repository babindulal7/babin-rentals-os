}

.movement-card__cta-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  min-height: var(--tap, 44px);
  min-width: 44px;
  padding: 0 0.85rem;
  border-radius: var(--r-btn, 8px);
  font-size: var(--t-th);
