<file path="src/modules/inventory/AdjustStockModal.tsx">
import { useState } from 'react'
import { Modal } from '../../components/ui/Modal'
import { Button } from '../../components/ui/Button'
import { adjustStock } from '../../actions/inventory/adjustStock'
import { useAuth } from '../../lib/auth'
import { formatGateError } from '../../lib/gates'
import { newClientUuid } from '../../lib/supabase'

export function AdjustStockModal({ productId, productName, currentQuantity, onClose, onAdjusted }: {
  productId: string
  productName: string
  currentQuantity: number
  onClose: () => void
  onAdjusted: () => void
}) {
  const { user } = useAuth()
  const [delta, setDelta] = useState('')
  const [reason, setReason] = useState('')
  const [clientUuid] = useState(newClientUuid)
  const [saving, setSaving] = useState(false)
  const [error, setError] = useState<string | null>(null)

  const submit = async () => {
    const quantity = Number(delta)
    if (!Number.isSafeInteger(quantity) || quantity === 0) {
      setError('Enter a non-zero whole number, with + to add or − to remove stock.')
      return
    }
    if (reason.trim().length < 10) {
      setError('Give a reason of at least ten characters.')
      return
    }
    if (!user) {
      setError('Sign in before adjusting stock.')
      return
    }
    setSaving(true)
    setError(null)
    try {
      await adjustStock({ productId, delta: quantity, reason, clientUuid }, { userId: user.id, role: user.role })
      onAdjusted()
      onClose()
    } catch (cause: unknown) {
      setError(formatGateError(cause))
    } finally {
      setSaving(false)
    }
  }

  return (
    <Modal
      isOpen
      onClose={onClose}
      title={`Adjust Stock — ${productName}`}
      subtitle={`Recorded quantity: ${currentQuantity}`}
      size="md"
      footer={<>
        <Button variant="secondary" onClick={onClose} disabled={saving}>Cancel</Button>
        <Button variant="primary" onClick={submit} disabled={saving}>{saving ? 'Adjusting…' : 'Record Adjustment'}</Button>
      </>}
    >
      <div style={{ display: 'grid', gap: 'var(--sp-md)' }}>
        {error && <div role="alert" style={{ padding: '10px 14px', border: '1px solid var(--danger)', borderRadius: 'var(--r-btn)', background: 'var(--st-danger-bg)', color: 'var(--st-danger-fg)' }}>{error}</div>}
        <label style={{ display: 'grid', gap: 6, color: 'var(--text)', fontWeight: 600 }}>
          Quantity change <span style={{ color: 'var(--danger)' }}>*</span>
          <input type="number" inputMode="numeric" step="1" value={delta} onChange={(event) => setDelta(event.target.value)} placeholder="+2 or -3" style={{ minHeight: 44, padding: '0 12px', borderRadius: 'var(--r-btn)', border: '1px solid var(--border)', background: 'var(--card)', color: 'var(--text)' }} />
        </label>
        <label style={{ display: 'grid', gap: 6, color: 'var(--text)', fontWeight: 600 }}>
          Reason <span style={{ color: 'var(--danger)' }}>*</span>
          <textarea value={reason} onChange={(event) => setReason(event.target.value)} rows={3} placeholder="Explain what changed and why" style={{ minHeight: 80, padding: '10px 12px', borderRadius: 'var(--r-btn)', border: '1px solid var(--border)', background: 'var(--card)', color: 'var(--text)', resize: 'vertical' }} />
        </label>
      </div>
    </Modal>
  )
}
</file>

<file path="src/modules/inventory/BundleDetail.tsx">
import { useMemo } from 'react'
import type { CSSProperties } from 'react'
import { Link, useNavigate, useParams, useSearchParams } from 'react-router-dom'
import Icon from '../../components/ui/Icon'
import { Card, PageHeader, Button, KpiStrip, FooterNote } from '../../components/ui/Page'
import { DataTableShell } from '../../components/ui/DataTable'
import { PageShell } from '../../components/ui/PageShell'
import EditBundle from './EditBundle'
import type { Kpi } from '../../components/ui/Page'
import { PageBody } from '../../components/ui/PageBody'
import { Badge } from '../../components/ui/Badge'
import { DateField } from '../../components/ui/DateField'
import { Donut, Legend } from '../../components/ui/Charts'
import type { Slice } from '../../components/ui/Charts'
import { STATUS } from '../../lib/status'
import type { StatusKey } from '../../lib/status'
import { formatMoney } from '../../lib/money'
import { toBs, formatBs, formatAd } from '../../lib/bs'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import { useAuth } from '../../lib/auth'
import { canUpdateBundle } from '../../lib/rbac'
import { gateContext } from '../../lib/fieldGating'
import { useViewport } from '../../lib/device'
import {
  useBundleRecord,
  bundleDetailGroups,
  factsOf,
  ratioLabelOf,
  iconFor,
  isPriced,
  type BundleRecord,
  type BundleState,
} from '../../lib/queries/useBundles'
import { useRentalWindowParams, dayValue } from '../../lib/rentalWindowParams'
import './inventory.css'

/**
 * **Bundle detail** — `/inventory/bundles/:bundleRef`.
 *
 * The audit of 4 Sep filed this as missing entirely, and it was the odd one out:
 * `data/bundleIntel.ts:97 bundleDetailGroups` had been written to describe a
 * bundle in full — Identity, Availability, Components, Substitutes, Current
 * booking and Money, each already gated — and nothing rendered it. `Bundles.tsx`
 * said so twice, in a row-menu item and in a disabled "View full breakdown"
 * button, both carrying the same sentence: *"Bundle detail has no screen yet."*
 *
 * ## What this screen is, given no spec exists for it
 *
 * There is no spec and no approved render for a bundle detail page — the spec
 * library holds `Bundles.md` (the list) and `Add Bundle.md` (the create form) and
 * nothing else. So the *layout* follows `ClientDetail.tsx`, the closest sibling
 * that uses the shared furniture (`PageHeader` → `KpiStrip` → `Card`s →
 * `FooterNote`), and the *content* is `bundleDetailGroups` — which is not
 * invention: it is the field set the intel layer already decided this bundle
 * has, cited to `Bundles.md` §4, §7, §8 and §10 in its own comments.
 *
 * Nothing here re-derives a figure. Every count, ratio, donut segment and money
 * value comes from one `factsOf(bundle)` call, because `data/bundles.ts` §1 is
 * blunt: *"Every number on this page is computed at render. None is stored."*
 *
 * ## The window is not decoration
 *
 * **§4.44.** A bundle is not available in the abstract, so this page carries the
 * same `?from=`/`?to=` window as the list and links back and forth with it
 * intact. Opening a bundle from a list showing "4 / 5 Ready for next week" and
 * seeing a different ratio here would be the screen contradicting itself.
 *
 * ## Why several fields read "not set" on live data
 *
 * `bundleDetailGroups` was written against the nine-record seed. Live records are
 * thinner: `bundleRecords.ts` documents that `tags`, `lockMode`, `nextConflictAd`,
 * `substitutes` and `replaceable` have **no column anywhere**, so they come back
 * empty and the intel layer prints its own honest fallbacks. A page full of
 * "not set" reads as a loading fault unless it says why, so it says why once,
 * under Identity, rather than leaving the operator to guess.
 */

const th: CSSProperties = {
  textAlign: 'left',
  padding: '9px 10px',
  fontSize: 'var(--t-th)',
  fontWeight: 600,
  color: 'var(--text2)',
  whiteSpace: 'nowrap',
  borderBottom: '1px solid var(--border)',
}

const td: CSSProperties = {
  height: 'var(--row-min-h)',
  padding: '10px',
  fontSize: 'var(--t-meta)',
  color: 'var(--text)',
  verticalAlign: 'top',
}

const subtle: CSSProperties = { fontSize: 'var(--t-th)', color: 'var(--muted)' }

/** Same tokens the list uses, so a bundle does not change colour when opened. */
const STATE_TONE: Record<BundleState | 'Archived', StatusKey> = {
  Available: 'in',
  Reserved: 'primary',
  'On Rent': 'out',
  'Partially Available': 'progress',
  'On Maintenance': 'progress',
  Archived: 'neutral',
}

/** Foundation §3.1 — BS above AD, Latin digits, always with a year. */
function BsAd({ date, prefix }: { date: Date; prefix?: string }) {
  const bs = toBs(date)
  return (
    <span style={{ display: 'flex', flexDirection: 'column', lineHeight: 1.35 }}>
      <span className="figure" style={{ fontSize: 'var(--t-th)', color: 'var(--text2)' }}>
        {prefix ? `${prefix} ` : ''}
        {bs ? formatBs(bs) : formatAd(date)}
      </span>
      {bs && <span className="figure" style={subtle}>{formatAd(date)}</span>}
    </span>
  )
}

export function BundleDetail() {
  const navigate = useNavigate()
  const money = useCanViewMoney()
  const { user } = useAuth()
  const gctx = useMemo(() => gateContext(user?.role ?? 'Client'), [user?.role])
  const viewport = useViewport()
  const tabular = viewport !== 'phone'

  /*
   * The param name must match the route's exactly — `App.tsx:330` carries a
   * comment recording the one time it did not, when `/inventory/:code` met
   * `useParams<{ assetId }>()` and the param was silently always undefined.
   */
  const { bundleRef } = useParams<{ bundleRef?: string }>()

  const { window: availabilityWindow, setWindow, search: windowSearch } = useRentalWindowParams()
  const { fromAd, toAd } = availabilityWindow

  const record = useBundleRecord(bundleRef, availabilityWindow, money)
  const bundle: BundleRecord | null = record.rows[0] ?? null

  /* The list's address, with the operator's window preserved. NEVER
     `/inventory/bundles` — that has no route and resolves to `/inventory/:assetId`,
     which renders AssetDetail hunting for an asset called "bundles". */
  const backTo = `/inventory${windowSearch.replace('?', '?tab=bundles&')}`

  const [params, setParams] = useSearchParams()
  const isEdit = params.get('action') === 'edit'

  /*
   * Integrated in-page: When action === 'edit', render EditBundle in-place
   * within BundleDetail workspace instead of bouncing to a detached shortcut page.
   */
  if (isEdit && user && canUpdateBundle(user.role)) {
    return (
      <EditBundle
        bundleRef={bundleRef}
        embedded
        onDone={() => {
          record.refetch()
          const p = new URLSearchParams(params)
          p.delete('action')
          setParams(p, { replace: true })
        }}
      />
    )
  }

  /*
   * The record gate, in the shape every sibling detail screen uses: guard on the
   * record, hand `PageBody` the four states and `{null}` children, and let it
   * rank error above empty so "the read failed" is never dressed up as "no such
   * bundle". `useBundleRecord` passes `isFilteredOverride: false`, so the empty
   * state does not offer "Clear filters" for an address that does not exist.
   */
  if (!bundle) {
    return (
      <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)', maxWidth: 720, margin: '40px auto', padding: '0 20px' }}>
        <PageBody
          loading={record.loading}
          error={record.error}
          onRetry={record.refetch}
          empty={record.isEmpty}
          noun="bundle"
          skeleton="card"
          emptyTitle="Bundle not found"
          emptyMessage={`No bundle matches "${bundleRef ?? ''}" by bundle code. It may have been archived, or the reference may be out of date.`}
          emptyActionLabel="Back to Bundles"
          onEmptyAction={() => navigate(backTo)}
        >
          {null}
        </PageBody>
      </div>
    )
  }

  const facts = factsOf(bundle)
  const groups = bundleDetailGroups(bundle, gctx)
  const state: BundleState | 'Archived' = bundle.archived ? 'Archived' : facts.state

  /*
   * The fields with no column, named once. `bundleRecords.ts`'s header is the
   * authority; this is its operator-facing sentence. Shown only when they are
   * actually empty, so the day a column lands the note disappears on its own
   * rather than becoming a stale apology.
   */
  const unrecorded: string[] = []
  if (bundle.tags.length === 0) unrecorded.push('tags')
  if (bundle.lockMode === undefined) unrecorded.push('lock mode')
  if (bundle.nextConflictAd === undefined) unrecorded.push('next conflict')
  if (!bundle.lines.some((l) => l.substitutes && l.substitutes.length > 0)) unrecorded.push('substitutes')

  const kpis: Kpi[] = [
    {
      label: 'Ready',
      value: ratioLabelOf(facts),
      icon: 'check',
      accent: facts.readyItems === facts.totalItems ? 'success' : 'warn',
      note: `${facts.totalItems} required items`,
    },
    {
      label: 'Components',
      value: String(bundle.lines.length),
      icon: 'queues',
      accent: 'primary',
      note: `${facts.equipment} equipment${facts.boxes ? ` · ${facts.boxes} case` : ''}`,
    },
    {
      label: 'Blocked',
      value: String(facts.blockedItems),
      icon: facts.blockedItems > 0 ? 'alert_triangle' : 'check',
      accent: facts.blockedItems > 0 ? 'warn' : 'success',
      note: facts.blockedLines.length === 0 ? 'Nothing short in this window' : `${facts.blockedLines.length} line${facts.blockedLines.length === 1 ? '' : 's'} short`,
    },
    /* Law 6 — the rate tile is money, so it is dropped outright rather than
       masked for a money-blind session. The grid closes up. */
    ...(money
      ? [{
          label: 'Daily rate',
          value: formatMoney(bundle.bundleRatePaisa),
          icon: 'card' as const,
          accent: 'success' as const,
          note: facts.savingPct > 0 ? `Saves ${facts.savingPct}% on parts` : 'At or above sum of parts',
        }]
      : []),
  ]

  /* Built exactly as the list's SummaryCard builds them (`Bundles.tsx:1482`) —
     `display` and `percent` are pre-formatted because the chart kit never
     guesses a format. Denominator guarded so an all-zero bundle cannot divide
     by zero. */
  const segmentTotal = facts.segments.reduce((sum, x) => sum + x.value, 0) || 1
  const slices: Slice[] = facts.segments.map((s) => ({
    label: s.label,
    value: s.value,
    display: String(s.value),
    percent: `${Math.round((s.value / segmentTotal) * 100)}%`,
  }))

  return (
    <PageShell width="full">
      <PageHeader
        icon={iconFor(bundle.category)}
        title={bundle.name}
        description={
          <span style={{ display: 'inline-flex', alignItems: 'center', gap: 8, flexWrap: 'wrap' }}>
            <span className="inventory-asset-code identifier">{bundle.id}</span>
            <span>·</span>
            <span>{bundle.category} (Primary)</span>
            <span>·</span>
            <span>{bundle.lines.length} components</span>
          </span>
        }
        actions={
          <div style={{ display: 'flex', gap: 'var(--sp-sm)', alignItems: 'center', flexWrap: 'wrap' }}>
            <Badge tone={STATE_TONE[state]} label={state} />
            {/*
              ABSENT, not disabled, for a role that cannot edit — `bundles_manage`
              is Owner/Admin/Manager and offering the control to anyone else would
              end at a refused write. The window rides along so the editor's
              Cancel returns to the same availability question this page is
              answering (§4.44).
            */}
            {user && canUpdateBundle(user.role) && (
              <Button
                variant="secondary"
                onClick={() => {
                  const p = new URLSearchParams(params)
                  p.set('action', 'edit')
                  setParams(p, { replace: true })
                }}
              >
                Edit bundle
              </Button>
            )}
            <Link to={backTo} style={{ textDecoration: 'none' }}>
              <Button icon="chevron_left" variant="secondary">Back to Bundles</Button>
            </Link>
          </div>
        }
      />

      <KpiStrip items={kpis} columns={viewport === 'phone' ? 1 : viewport === 'tablet' ? 2 : kpis.length} />

      {/*
        §4.44 — the window every availability figure below is measured against,
        carried in from the list. It is not a filter: it does not decide what is
        shown, it decides what "available" means for all of it.
      */}
      <div className="bundle-window-card">
        <div style={{ display: 'flex', alignItems: 'center', gap: 6, marginBottom: 8 }}>
          <span className="inventory-thumb-sm" style={{ display: 'inline-grid', placeItems: 'center' }}>
            <Icon name="calendar" size={13} />
          </span>
          <span style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>Available for</span>
        </div>
        <div style={{ display: 'flex', gap: 'var(--sp-md)', flexWrap: 'wrap', alignItems: 'center' }}>
          <label style={{ display: 'inline-flex', alignItems: 'center', gap: 6, fontSize: 'var(--t-th)', color: 'var(--muted)' }}>
            From
            <DateField ariaLabel="Availability window from" value={dayValue(fromAd)} onChange={(v) => setWindow('from', v)} showBs={false} />
          </label>
          <label style={{ display: 'inline-flex', alignItems: 'center', gap: 6, fontSize: 'var(--t-th)', color: 'var(--muted)' }}>
            To
            <DateField ariaLabel="Availability window to" value={dayValue(toAd)} onChange={(v) => setWindow('to', v)} showBs={false} align="right" />
          </label>
          <BsAd date={new Date(fromAd)} prefix="From" />
          <BsAd date={new Date(toAd)} prefix="To" />
          <span style={{ ...subtle, flexBasis: '100%', marginTop: 2 }}>
            Returns are half-open: a rental ending on the To date does not block this window.
          </span>
        </div>
      </div>

      <Card title="Readiness">
        <div style={{ display: 'flex', gap: 'var(--sp-lg)', alignItems: 'center', flexWrap: 'wrap' }}>
          <Donut slices={slices} size={112} centreValue={`${facts.readyItems} / ${facts.totalItems}`} centreLabel="Available" />
          <Legend slices={slices} showPercent={false} />
        </div>
      </Card>

      {/*
        The components table is the reason an operator opens this page: which
        model, how many needed, how many free in this window, and what is holding
        the rest. `blockedBy` is only ever set on a short line, so an empty cell
        there means the line is covered, not that the reason is missing.
      */}
      <Card title={`Components (${bundle.lines.length})`} bodyStyle={{ padding: 0 }}>
        <DataTableShell ariaLabel="Bundle components">
          <table className="inventory-table" style={{ width: '100%', borderCollapse: 'collapse', minWidth: tabular ? 720 : undefined }}>
            <thead>
              <tr style={{ background: 'var(--th-bg)' }}>
                <th style={th}>Group</th>
                <th style={th}>Model</th>
                <th style={{ ...th, textAlign: 'right' }}>Needs</th>
                <th style={{ ...th, textAlign: 'right' }}>Available</th>
                <th style={{ ...th, textAlign: 'right' }}>Stock</th>
                <th style={th}>Held by</th>
                {money && <th style={{ ...th, textAlign: 'right' }}>Unit rate</th>}
              </tr>
            </thead>
            <tbody>
              {bundle.lines.map((l, i) => {
                const short = l.unitsAvailable < l.quantity
                return (
                  <tr key={`${l.group}-${l.model}-${i}`} className="inventory-child-row" style={{ borderBottom: '1px solid var(--border)' }}>
                    <td style={td}>
                      <span style={{ display: 'inline-flex', alignItems: 'center', gap: 6 }}>
                        <span className="inventory-thumb-sm" style={{ display: 'inline-grid', placeItems: 'center' }}>
                          <Icon name={iconFor(l.group)} size={13} />
                        </span>
                        {l.group}
                      </span>
                    </td>
                    <td style={{ ...td, fontWeight: 500 }}>
                      {l.model}
                      {!isPriced(l) && (
                        <span style={{ ...subtle, marginLeft: 6 }} title="Priced in the booking's own section, not in the bundle rate.">
                          (not in rate)
                        </span>
                      )}
                    </td>
                    <td style={{ ...td, textAlign: 'right' }} className="figure">{l.quantity}</td>
                    <td style={{ ...td, textAlign: 'right', color: short ? 'var(--danger-text)' : 'var(--text)', fontWeight: short ? 700 : 400 }} className="figure">
                      {l.unitsAvailable}
                    </td>
                    <td style={{ ...td, textAlign: 'right' }} className="figure">{l.unitsStock}</td>
                    <td style={td}>
                      {short && l.blockedBy ? (
                        <span style={{ display: 'inline-flex', flexDirection: 'column', gap: 2 }}>
                          <span style={{ color: STATUS[l.blockedBy === 'On Rent' ? 'out' : l.blockedBy === 'Reserved' ? 'primary' : 'progress'].fg }}>
                            {l.blockedBy}
                          </span>
                          {l.freesAd && <span style={subtle}>frees {formatAd(l.freesAd)}</span>}
                        </span>
                      ) : short && l.unitsStock < l.quantity ? (
                        /*
                         * Short because the business does not OWN enough — a
                         * fully explained shortfall, and not the same thing as an
                         * unnameable one. Driving the page caught this: both
                         * cases first rendered "reason not recorded", which told
                         * an operator the system did not know, when the answer
                         * was simply that the kit asks for more than the shelf
                         * holds. No amount of waiting frees these.
                         */
                        <span style={{ color: 'var(--warn-text)' }} title={`This bundle needs ${l.quantity} but only ${l.unitsStock} ${l.unitsStock === 1 ? 'is' : 'are'} owned.`}>
                          Only {l.unitsStock} owned
                        </span>
                      ) : short ? (
                        /* Enough are owned, none is free, and the reason is not
                           one the four-state model can name: `BlockedBy` has no
                           member for Missing or Retired, and `bundleRecords.ts`
                           refuses to call lost gear "On Maintenance" just to
                           fill the cell. */
                        <span style={subtle} title="Enough units are owned but none is free, and the reason is not one the four-state model can name — see bundleRecords.ts.">
                          Short — reason not recorded
                        </span>
                      ) : (
                        <span style={subtle}>—</span>
                      )}
                    </td>
                    {money && (
                      <td style={{ ...td, textAlign: 'right' }} className="figure">
                        {isPriced(l) ? formatMoney(l.unitRatePaisa) : '—'}
                      </td>
                    )}
                  </tr>
                )
              })}
            </tbody>
          </table>
        </DataTableShell>
      </Card>

      {/*
        `bundleDetailGroups` is rendered rather than re-implemented: it is already
        gated, already cited to the spec, and already the exact field set the
        hover card shows, so the card and the page cannot disagree. `IntelCard`'s
        own `DetailGroups` renderer is module-local and unexported, hence the
        small renderer here rather than an import.
      */}
      <div style={{ display: 'grid', gap: 'var(--sp-lg)', gridTemplateColumns: tabular ? 'repeat(auto-fit, minmax(320px, 1fr))' : '1fr' }}>
        {groups.map((g) => (
          <Card key={g.title} title={g.title}>
            <dl style={{ margin: 0, display: 'grid', gridTemplateColumns: 'minmax(0, 1fr) minmax(0, 1.4fr)', gap: '8px 14px', fontSize: 'var(--t-meta)' }}>
              {g.fields.map((f, i) => (
                <div key={`${g.title}-${f.label}-${i}`} style={{ display: 'contents' }}>
                  <dt style={{ color: 'var(--muted)', overflowWrap: 'anywhere' }}>{f.label}</dt>
                  <dd style={{ margin: 0, color: 'var(--text)', overflowWrap: 'anywhere' }}>
                    {f.value}
                    {f.trigger && (
                      <>
                        {' '}
                        <Link to={f.trigger.to} style={{ color: 'var(--nav-active-accent)' }}>
                          {f.trigger.label}
                        </Link>
                      </>
                    )}
                  </dd>
                </div>
              ))}
              {g.title === 'Identity' && unrecorded.length > 0 && (
                <div style={{ display: 'contents' }}>
                  <dt style={{ color: 'var(--muted)' }}>Not recorded</dt>
                  <dd style={{ margin: 0, color: 'var(--text2)' }}>
                    {unrecorded.join(', ')} — no column holds {unrecorded.length === 1 ? 'it' : 'them'} yet,
                    so the fields above read as unset rather than being left blank.
                  </dd>
                </div>
              )}
            </dl>
          </Card>
        ))}
      </div>

      <FooterNote
        extra={[
          `Availability measured for ${formatAd(new Date(fromAd))} → ${formatAd(new Date(toAd))}`,
          'A bundle stores models, never serials — units are assigned at packing',
        ]}
      />
    </PageShell>
  )
}

export default BundleDetail
</file>

<file path="src/modules/inventory/DamageTab.tsx">
import { Children, useMemo, useState, useEffect } from 'react'
import Icon from '../../components/ui/Icon'
import { Card, Button, cardStyle } from '../../components/ui/Page'
import { Badge } from '../../components/ui/Badge'
import type { StatusKey } from '../../lib/status'
import { EmptyState } from '../../components/ui/StateViews'
import { formatMoney, rupees, toRupees } from '../../lib/money'
import type { Paisa } from '../../lib/money'
import { useAuth } from '../../lib/auth'
import { canApproveDamage } from '../../lib/rbac'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import {
  approverFor,
  validateDamageReport,
  settleDeposit,
  approvalEffect,
  OWNER_APPROVAL_THRESHOLD,
  MIN_PHOTOS,
} from '../../lib/damage'
import { getDamageFindings } from '../../lib/queries/damage'
import type { DamageFinding } from '../../lib/queries/damage'

/**
 * # Inventory ▸ Maintenance ▸ Damage
 *
 * The half of the damage flow that carries money.
 *
 * The finding itself is raised at Return, and stays money-free there:
 * `ReturnWorkspace.tsx` is the Warehouse's screen, Foundation §8.3 keeps every
 * Rs figure off it, and §13.1 already says the damage-approval gate reads
 * *"Damage approval required, with no amount"*. So Return captures the
 * description, the photos and the routing; the **charge, the approver and the
 * deposit settlement are here**, where a money-visible role can see them.
 *
 * Every rule below comes from `lib/damage.ts`. This file decides nothing —
 * pages never implement business logic (`CLAUDE.md`).
 */

/**
 * This screen's four chip tones, mapped onto the §4 hues.
 *
 * `success` is the only name that does not survive verbatim: `lib/status`
 * calls green `in` ("home & ready · settled"), which is what an approved
 * finding is. The local name is kept at the call sites — five of them read
 * `tone="success"` / `tone="progress"` and they say what this screen means,
 * not what the palette calls it — so the translation lives here, once.
 */
const CHIP_TONE = {
  danger: 'danger',
  progress: 'progress',
  success: 'in',
  neutral: 'neutral',
} as const satisfies Record<string, StatusKey>

/**
 * Delegates to `<Badge>` — DESIGN_DIRECTION_SPEC_v4.1 §8 step 2: "one
 * component rendering the §4 map from lib/status; every screen inherits. No
 * screen colours a status itself."
 *
 * The two ternary chains this replaces were assembling a bg/fg pair by hand,
 * and the `success` arm got the pairing wrong: `--st-in-bg` (the solid green
 * fill) under `--success-text` (the green INK meant for a page surface). Green
 * on green. The on-colour for that fill is `--on-success`, and §3.2 is
 * explicit that the on-colour is "part of the token, not a screen choice" —
 * which is exactly the choice a hand-built pair forces a screen to make, and
 * this one made it wrong.
 *
 * The `neutral` arm was not a status hue at all (`--card2` / `--text2`); it is
 * now v4.1's gray, "not started yet", which is what both its call sites mean:
 * a finding that has not been approved, and an approval level nobody has acted
 * on yet.
 *
 * The wrapper stays so the call sites keep reading in this screen's own
 * vocabulary, and because it takes `children` rather than a string — the two
 * chips that render `{approver} approves` and `{approverFor(…)} level` compose
 * their word from an engine call. `<Badge>`'s `label` is a string, so the
 * children are joined here.
 */
function Chip({ tone, children }: { tone: keyof typeof CHIP_TONE; children: React.ReactNode }) {
  return <Badge tone={CHIP_TONE[tone]} label={Children.toArray(children).join('')} size="sm" />
}

export function DamageTab() {
  const money = useCanViewMoney()
  const { user } = useAuth()
  const role = user?.role ?? 'Client'

  /*
   * ⛔ The approver is read here ONCE, and there is no fallback for it.
   *
   * This screen used to write `approvedBy: user?.name ?? 'Unknown'` onto the
   * finding and hand the same `'Unknown'` to `approvalEffect()`, so the
   * engine's `reason` — the line that goes to the maintenance record and the
   * audit trail — read "Damage approved by Unknown", and the unit's
   * `availableForBooking: false` consequence was computed from an approver who
   * does not exist. A degrading placeholder is no better than an escalating
   * one here: "approved by Unknown" still asserts that a Rs 1,85,000 charge
   * was approved and attributed to somebody.
   *
   * An approval is the whole point of this card, so the honest answer with no
   * session is not a weaker name — it is no approval. `approver` is `null`
   * whenever nobody is signed in, which disables both decisions below and is
   * stated inline and persistently on the card (Law 12) rather than toasted.
   *
   * RESOLVED 12 Aug 2026 — this carried a `TODO(decision)` because no `lib/rbac`
   * capability governed a damage approval, and the role test was computed inline
   * on this page. It is now `rbac.canApproveDamage(role, requiredApprover)`:
   * **Owner and Manager only.**
   *
   * Two things that changed with it. The page no longer implements the rule
   * (Law 1 — the engines own it), and **Admin no longer qualifies**: the inline
   * expression this replaced read
   * `approver === 'Owner' ? role === 'Owner' : role === 'Owner' || role === 'Admin' || role === 'Manager'`,
   * which granted Admin a sign-off the ruling excludes.
   *
   * The Rs 25,000 banding stays in `lib/damage`'s `approverFor()` and is passed
   * in, so the threshold and the role rule each live in exactly one place.
   */
  const approver = user?.name.trim() ? user.name.trim() : null

  const [findings, setFindings] = useState<DamageFinding[]>([])

  useEffect(() => {
    let active = true
    getDamageFindings().then((res) => {
      if (active) {
        setFindings(res)
      }
    }).catch(() => {})
    return () => {
      active = false
    }
  }, [])

  /* The approval confirmation cannot live inside the pending list: approving
     removes the row from it, so the message would render into a branch that no
     longer exists. Held here and shown above the list instead. */
  const [justApproved, setJustApproved] = useState<{ unitName: string } | null>(null)
  const [chargeDraft, setChargeDraft] = useState<Record<string, string>>({})

  const pending = useMemo(() => findings.filter((f) => f.state === 'Awaiting Approval'), [findings])

  /* §8.3 — a money-blind role does not get a blanked screen, it gets the half
     of this that is its business: what is damaged and what it blocks. */
  if (!money) {
    return (
      <Card title={`Damage findings (${findings.length})`}>
        {findings.length === 0 ? (
          <EmptyState title="No damage findings" description="No active damage findings are currently recorded." />
        ) : (
          <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
            {findings.map((f) => (
              <div key={f.id} style={{ ...cardStyle, padding: 12 }}>
                <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)', flexWrap: 'wrap' }}>
                  <strong style={{ fontSize: 'var(--t-meta)' }}>{f.unitName}</strong>
                  <span className="identifier" style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>{f.serial}</span>
                  <Chip tone={f.state === 'Approved' ? 'success' : 'progress'}>{f.state}</Chip>
                </div>
                <p style={{ margin: '6px 0 0', fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>{f.description}</p>
                <span style={{ display: 'flex', alignItems: 'center', gap: 5, marginTop: 6, fontSize: 'var(--t-th)', color: 'var(--muted)' }}>
                  <Icon name="lock" size={11} />
                  Charges and deposit settlement are not shown to this role.
                </span>
              </div>
            ))}
          </div>
        )}
      </Card>
    )
  }

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
      {/* RS-05 — this used to read "moved to Maintenance and is no longer
          available for booking". Nothing here writes `damage_findings`, opens a
          maintenance job or changes `product_units`: there is no damage action
          in src/actions, so the decision lives in this screen's state only and
          the notice says exactly that. TODO(decision): an `approveDamageFinding`
          action (finding write + maintenance job + unit status, per
          `approvalEffect` in lib/damage.ts) is needed before this can claim
          the move. */}
      {justApproved && (
        <div role="status" style={{ ...cardStyle, padding: '10px 12px', display: 'flex', alignItems: 'flex-start', gap: 'var(--sp-sm)' }}>
          <Icon name="alert_triangle" size={14} style={{ flexShrink: 0, marginTop: 2, color: 'var(--warn-text)' }} />
          <span style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
            Approval for {justApproved.unitName} is recorded on this screen only — nothing has been written. No damage
            action exists yet, so the finding is not saved, no maintenance job was opened and the unit's availability is
            unchanged.
          </span>
        </div>
      )}

      <Card title={`Awaiting approval (${pending.length})`}>
        {pending.length === 0 ? (
          <EmptyState title="Nothing waiting" description="Every damage finding raised at Return has been approved or rejected." />
        ) : (
          <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
            {pending.map((f) => {
              const draft = chargeDraft[f.id]
              const chargePaisa: Paisa = draft === undefined ? f.chargePaisa : rupees(Number(draft) || 0)
              const validation = validateDamageReport({
                description: f.description,
                photos: f.photos,
                chargePaisa,
                replacementPaisa: f.replacementPaisa,
              })
              const settlement = settleDeposit(f.depositPaisa, chargePaisa)
              /* The engine decides who signs; the screen only reports it. A
                 Manager looking at a Rs 1,85,000 finding is told plainly that
                 it is not theirs to approve. */
              const roleMayApprove = canApproveDamage(role, validation.approver)
              /* No session, no approver, no approval — see `approver` above. */
              const mayApprove = approver !== null && roleMayApprove

              return (
                <div key={f.id} style={{ ...cardStyle, padding: 14, display: 'flex', flexDirection: 'column', gap: 8 }}>
                  <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)', flexWrap: 'wrap' }}>
                    <span className="identifier" style={{ fontSize: 'var(--t-th)', fontWeight: 700 }}>{f.id}</span>
                    <strong style={{ fontSize: 'var(--t-ui)' }}>{f.unitName}</strong>
                    <span className="identifier" style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>{f.serial}</span>
                    <Chip tone={validation.approver === 'Owner' ? 'danger' : 'progress'}>{validation.approver} approves</Chip>
                  </div>

                  <p style={{ margin: 0, fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>{f.description}</p>

                  <div style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>
                    {f.bookingNo} · {f.client} · raised by {f.raisedBy}, {f.raisedAtAd} ·{' '}
                    <span style={{ color: f.photos >= MIN_PHOTOS ? 'var(--success-text)' : 'var(--danger-text)', fontWeight: 600 }}>
                      {f.photos} photo(s)
                    </span>
                  </div>

                  {/* The reference figure, labelled as one. Nothing derives the
                      charge from it — the charge is case-by-case. */}
                  <div style={{ display: 'flex', gap: 'var(--sp-lg)', flexWrap: 'wrap', fontSize: 'var(--t-meta)' }}>
                    <span style={{ color: 'var(--text2)' }}>
                      Replacement value{' '}
                      <span className="figure" style={{ color: 'var(--text)', fontWeight: 600 }}>{formatMoney(f.replacementPaisa)}</span>{' '}
                      <span style={{ color: 'var(--muted)', fontSize: 'var(--t-th)' }}>(reference only)</span>
                    </span>
                  </div>

                  <label style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)', fontSize: 'var(--t-meta)', flexWrap: 'wrap' }}>
                    <span style={{ color: 'var(--text2)' }}>Charge (Rs)</span>
                    <input
                      id={`damage-charge-${f.id}`}
                      type="number"
                      value={draft ?? String(toRupees(f.chargePaisa))}
                      onChange={(e) => setChargeDraft((d) => ({ ...d, [f.id]: e.target.value }))}
                      style={{ width: 140, height: 32, padding: '0 10px', borderRadius: 'var(--r-input)', border: `1px solid ${validation.errors.charge ? 'var(--danger)' : 'var(--input-border)'}`, background: 'var(--input-bg)', color: 'var(--text)', fontSize: 'var(--t-meta)', fontFamily: 'inherit' }}
                    />
                    <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>
                      Crosses to Owner at {formatMoney(OWNER_APPROVAL_THRESHOLD)}
                    </span>
                  </label>

                  {validation.errors.charge && (
                    <span role="alert" style={{ display: 'flex', alignItems: 'flex-start', gap: 5, fontSize: 'var(--t-th)', color: 'var(--danger-text)' }}>
                      <Icon name="alert_triangle" size={11} style={{ flexShrink: 0, marginTop: 2 }} />
                      {validation.errors.charge}
                    </span>
                  )}

                  {validation.warnings.map((w) => (
                    <span key={w} style={{ display: 'flex', alignItems: 'flex-start', gap: 5, fontSize: 'var(--t-th)', color: 'var(--progress-text)' }}>
                      <Icon name="info" size={11} style={{ flexShrink: 0, marginTop: 2 }} />
                      {w}
                    </span>
                  ))}

                  {/* Law 5 — the deposit is a liability. The refund is derived,
                      never typed, and a charge above the deposit produces a
                      shortfall rather than a negative refund. */}
                  <div style={{ borderTop: '1px solid var(--border)', paddingTop: 8, display: 'flex', flexDirection: 'column', gap: 3, fontSize: 'var(--t-meta)' }}>
                    <div style={{ display: 'flex', justifyContent: 'space-between', gap: 'var(--sp-md)' }}>
                      <span style={{ color: 'var(--text2)' }}>Deposit held</span>
                      <span className="figure" style={{ fontWeight: 600 }}>{formatMoney(f.depositPaisa)}</span>
                    </div>
                    <div style={{ display: 'flex', justifyContent: 'space-between', gap: 'var(--sp-md)' }}>
                      <span style={{ color: 'var(--text2)' }}>Refund after damage</span>
                      <span className="figure" style={{ fontWeight: 700, color: 'var(--success-text)' }}>{formatMoney(settlement.refundPaisa)}</span>
                    </div>
                    {settlement.shortfallPaisa > 0 && (
                      <div style={{ display: 'flex', justifyContent: 'space-between', gap: 'var(--sp-md)' }}>
                        <span style={{ color: 'var(--danger-text)' }}>Not covered by the deposit</span>
                        <span className="figure" style={{ fontWeight: 700, color: 'var(--danger-text)' }}>{formatMoney(settlement.shortfallPaisa)}</span>
                      </div>
                    )}
                    <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)', marginTop: 2 }}>
                      The accountant confirms before the refund is issued.
                      {settlement.shortfallPaisa > 0 && ' The shortfall is raised as a separate receivable — it never moves the deposit below zero.'}
                    </span>
                  </div>

                  <div style={{ display: 'flex', gap: 'var(--sp-sm)', flexWrap: 'wrap', alignItems: 'center' }}>
                    <Button
                      variant="primary"
                      icon="check"
                      disabled={!validation.valid || !mayApprove}
                      onClick={async () => {
                        /* Second gate, deliberately not relying on `disabled`:
                           an edit that loosens the button must not be able to
                           reopen the fabricated-approver path. The refusal is
                           already on the card, so this returns silently. */
                        if (approver === null) return

                        try {
                          const effect = approvalEffect(
                            { description: f.description, photos: f.photos, chargePaisa, replacementPaisa: f.replacementPaisa },
                            approver,
                          )

                          // FORMS-05: Call the backend action to persist the resolution
                          const { resolveDamageFinding } = await import('../../actions/inventory/resolveDamage')
                          await resolveDamageFinding({
                            findingId: f.id,
                            disposition: 'Charge Client', // Hardcoded as the standard path for this UI, could be expanded
                            chargePaisa
                          })

                          setFindings((prev) =>
                            prev.map((x) =>
                              x.id === f.id
                                ? { ...x, state: 'Approved', chargePaisa, approvedBy: approver }
                                : x,
                            ),
                          )
                          /* The move and the unavailability are one fact the
                             engine returns together — the screen reports both or
                             neither. */
                          setJustApproved(effect.availableForBooking === false ? { unitName: f.unitName } : null)
                        } catch (err) {
                          console.error('Failed to approve damage', err)
                          alert('Failed to approve damage: ' + (err instanceof Error ? err.message : String(err)))
                        }
                      }}
                    >
                      Approve as {validation.approver}
                    </Button>
                    <Button
                      variant="danger"
                      icon="close"
                      disabled={!mayApprove}
                      onClick={() => {
                        if (approver === null) return
                        setFindings((prev) => prev.map((x) => (x.id === f.id ? { ...x, state: 'Rejected' } : x)))
                      }}
                    >
                      Reject
                    </Button>
                    {/* The two refusals are different facts and are stated as
                        different things. "Your role is Client" for a session
                        that does not exist would be a second fabrication on top
                        of the one this card just stopped making, so the
                        no-session case gets the screen's inline error
                        affordance — the same persistent `role="alert"` line the
                        charge error uses — and the role case keeps its lock. */}
                    {approver === null ? (
                      <span role="alert" style={{ display: 'flex', alignItems: 'flex-start', gap: 5, fontSize: 'var(--t-th)', color: 'var(--danger-text)' }}>
                        <Icon name="alert_triangle" size={11} style={{ flexShrink: 0, marginTop: 2 }} />
                        Nobody is signed in, so this finding cannot be approved or rejected. A damage charge is recorded
                        against the person who signed it off, and there is no honest stand-in for that name. Sign in and
                        reopen this tab.
                      </span>
                    ) : (
                      !mayApprove && (
                        <span style={{ display: 'flex', alignItems: 'center', gap: 5, fontSize: 'var(--t-th)', color: 'var(--muted)' }}>
                          <Icon name="lock" size={11} />
                          A charge of {formatMoney(chargePaisa)} needs {validation.approver} approval. Your role is {role}.
                        </span>
                      )
                    )}
                  </div>

                </div>
              )
            })}
          </div>
        )}
      </Card>

      <Card title="Settled">
        {findings.filter((f) => f.state === 'Approved' || f.state === 'Rejected').length === 0 ? (
          <EmptyState title="No settled findings" description="No damage findings have been approved or rejected yet." />
        ) : (
          <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
            {findings
              .filter((f) => f.state === 'Approved' || f.state === 'Rejected')
              .map((f) => {
              /* RS-04 — a rejected finding charges nothing. Settling against
                 the figure that was refused printed a refund and an
                 "uncovered" shortfall for money nobody is owed. */
              const rejected = f.state === 'Rejected'
              const s = settleDeposit(f.depositPaisa, rejected ? (0 as Paisa) : f.chargePaisa)
              return (
                <div key={f.id} style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)', flexWrap: 'wrap', fontSize: 'var(--t-meta)' }}>
                  <span className="identifier" style={{ fontSize: 'var(--t-th)', fontWeight: 700 }}>{f.id}</span>
                  <span style={{ flex: 1, minWidth: 160 }}>{f.unitName}</span>
                  <Chip tone={f.state === 'Approved' ? 'success' : 'neutral'}>{f.state}</Chip>
                  {rejected ? (
                    <span style={{ fontWeight: 600, color: 'var(--muted)' }}>No charge — rejected</span>
                  ) : (
                    <span className="figure" style={{ fontWeight: 600 }}>{formatMoney(f.chargePaisa)}</span>
                  )}
                  <span className="figure" style={{ color: 'var(--muted)', fontSize: 'var(--t-th)' }}>
                    refund {formatMoney(s.refundPaisa)}
                    {s.shortfallPaisa > 0 && ` · ${formatMoney(s.shortfallPaisa)} uncovered`}
                  </span>
                  {f.approvedBy && <span style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>by {f.approvedBy}</span>}
                  {/* `approverFor` is re-read here rather than stored, so a
                      changed threshold reclassifies history consistently. */}
                  <Chip tone="neutral">{approverFor(f.chargePaisa)} level</Chip>
                </div>
              )
            })}
          </div>
        )}
      </Card>
    </div>
  )
}
