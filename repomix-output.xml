                          display: 'flex',
                          alignItems: 'flex-start',
                          gap: 'var(--sp-sm)',
                          padding: '10px 12px',
                          borderRadius: 'var(--r-sm)',
                          border: '1px dashed var(--border)',
                          background: 'var(--card2)',
                          fontSize: 'var(--t-meta)',
                          color: 'var(--text2)',
                        }}
