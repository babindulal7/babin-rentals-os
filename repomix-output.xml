<file path="src/modules/inventory/StockCheck.tsx">
import { useCallback, useMemo, useState } from 'react'
import { Link, useNavigate } from 'react-router-dom'
import Icon from '../../components/ui/Icon'
import { Card, PageHeader, KpiStrip } from '../../components/ui/Page'
import { PageShell } from '../../components/ui/PageShell'
import type { Kpi } from '../../components/ui/Page'
import { Button } from '../../components/ui/Button'
import { EmptyState, ErrorBanner } from '../../components/ui/StateViews'
import { PageBody } from '../../components/ui/PageBody'
import { DataTableShell } from '../../components/ui/DataTable'
import { Unavailable } from '../../components/ui/Unavailable'
import { BarcodeScannerModal } from '../../components/ui/BarcodeScannerModal'
import { useViewport } from '../../lib/device'
import { useAuth } from '../../lib/auth'
import { formatAd, formatAdDateTime, formatBs, toBs } from '../../lib/bs'
import { captureError } from '../../lib/monitoring'
import { useList } from '../../lib/queries/useList'
import type { ListFilters } from '../../lib/queries/listQuery'
import {
  auditItemKpiFilters,
  findStockAuditItemByCode,
  itemsOfAudit,
  listStockAuditItems,
  listStockAudits,
  OUTCOME_OF_STATE,
  recentAudits,
  stockAuditRestriction,
  unitStateOfOutcome,
  withOutcomes,
  STOCK_CHECK_STATE_META,
} from '../../lib/queries/stockAudits'
import type { StockAuditItemRow, StockAuditListRow, StockCheckUnitState } from '../../lib/queries/stockAudits'
import './inventory.css'

/**
 * **§7.3 Stock Check.**
 *
 * ## The correctness rule this screen exists to hold
 *
 * > *"unscanned = Unverified, never auto-Missing."*
 *
 * That is not a label. Nothing on this page may turn an unscanned unit into a
 * missing one, and the database now says the same thing: a manifest line's
 * `outcome` DEFAULTS to `'Left unverified'` (0004:650), which maps to
 * `Unverified` here and nowhere near Missing. **`[Confirm missing]` is the only
 * path from Unverified to Confirmed missing, and a person presses it** — and in
 * Phase 1 there is NO action file to record that assertion, so the control is
 * rendered through `Unavailable` with the reason spelled out rather than
 * pretending a local `setState` wrote a loss into the record.
 *
 * ## What is real now, and what is not yet
 *
 * The audits list and the manifest are REAL reads: `stock_audits` and
 * `stock_audit_items` through `lib/queries/stockAudits.ts` (Law 2), unit
 * identity resolved through `product_units_v`/`products_v`, KPIs counted from
 * the items with one-row count queries — never read off the session row's
 * stored totals, which nothing reconciles. The scan box answers against the
 * server (`findStockAuditItemByCode`, exact match on serial / asset tag /
 * barcode) and says honestly that the scan itself is NOT recorded — there is no
 * scan-write action yet, and inventing a local "Verified" flip over rows the
 * database owns would fabricate success. The `Unexpected` list is the one
 * deliberately session-local thing left: a scratch log of codes that answered
 * "not on this manifest", labelled as unsaved.
 *
 * In mock mode neither table is served (`lib/mock/corpus.ts`), and the mock
 * engine answers with `[]` (`lib/mock/client.ts:100-106`) — the screen degrades
 * to its honest "No stock audits yet" empty state.
 *
 * ## Two surfaces, one component
 *
 * `/inventory/stock-check` is still a route — `data/caseIntel.ts:202`,
 * `data/rackIntel.ts:197` link straight to it — and the same component is also
 * the `?tab=stock-check` pane of `/inventory`. `embedded` drops the page header
 * the tab strip already provides; nothing else changes between them. There is
 * still no per-session route param, so deep links land on the default
 * selection: the first session that is started-but-not-completed, else the most
 * recently scheduled.
 *
 * ## Three layouts
 *
 * §7.3 draws DESKTOP and TABLET identically — session card, list, `[Confirm
 * missing]`, scanner FAB — and PHONE as progress · list · scan bar. The session
 * picker + scanner terminal is a rail at desktop and **reflows beneath the
 * list** below 1280 (`WIREFRAME_RULINGS_2026-08-12.md` §7: collapse means
 * reflow, not hide).
 */

/**
 * Named reason, per the Unavailable rule: no `src/actions/` file exists for
 * confirming a unit missing, and no capability string is declared for it —
 * so the assertion cannot land anywhere. The old build set a local flag and
 * showed the badge, which is a fabricated write on what is now a real record.
 */
const CONFIRM_MISSING_UNAVAILABLE =
  'Confirming a unit missing is not wired yet — no confirm-missing action exists, so the assertion would not be recorded. Phase 2 adds the write; until then the unit stays Unverified, which is the truthful state.'

type FilterMode = 'all' | 'verified' | 'unverified' | 'missing' | 'unexpected'

/** Which screen-state each narrowing chip means. The outcome it sends is `OUTCOME_OF_STATE`'s single mapping. */
const CHIP_STATE: Record<Exclude<FilterMode, 'all' | 'unexpected'>, StockCheckUnitState> = {
  verified: 'Verified',
  unverified: 'Unverified',
  missing: 'Confirmed missing',
}

/**
 * A figure, or an explicit non-value while it is unknown. A KPI reading `0`
 * during the first load or after a failure is a WRONG figure, not a missing one
 * — same helper, same reasoning, as `Inventory.tsx` and `AuditLog.tsx`.
 */
function countOf(list: { loading: boolean; error: string | null }, value: number | null): string {
  return list.loading || list.error !== null || value === null ? '—' : String(value)
}

/** `scheduled_date` (`YYYY-MM-DD`, AD) → "22 Shrawan 2083 BS · 6 Aug 2026", BS via `lib/bs.ts` only (Law 7). */
function scheduledLabel(dayAd: string): string {
  const d = new Date(`${dayAd}T00:00:00+05:45`)
  if (Number.isNaN(d.getTime())) return dayAd
  const bs = toBs(d)
  return bs ? `${formatBs(bs)} · ${formatAd(d)}` : formatAd(d)
}

function scopeLine(a: StockAuditListRow): string {
  return a.warehouseName ? `${a.scope} · ${a.warehouseName}` : a.scope
}

/** Display fallbacks, in honesty order — never an invented serial, the uuid last. */
function titleOf(it: StockAuditItemRow): string {
  return it.productName ?? it.serialNo ?? it.assetTag ?? it.productUnitId
}

function codeLineOf(it: StockAuditItemRow): string {
  const parts = [it.productAssetCode, it.serialNo ?? it.assetTag].filter(Boolean)
  return parts.length ? parts.join(' · ') : it.productUnitId
}

function locationOf(it: StockAuditItemRow): string {
  const parts = [it.rack, it.shelf, it.bin].filter(Boolean)
  return parts.length ? parts.join(' · ') : '—'
}

function linkTargetOf(it: StockAuditItemRow): string | null {
  const key = it.productAssetCode ?? it.serialNo
  return key ? `/inventory/${encodeURIComponent(key)}` : null
}

/** What `[Manual verify]` types into the scan box. Null when the unit embed did not resolve — no code to type. */
function verifySeedOf(it: StockAuditItemRow): string | null {
  return it.serialNo ?? it.assetTag
}

export default function StockCheck({ embedded = false }: { embedded?: boolean } = {}) {
  const navigate = useNavigate()
  const viewport = useViewport()
  /** The one identity this session's reconcile may be recorded against. */
  const { user } = useAuth()

  const [selectedId, setSelectedId] = useState<string | null>(null)
  const [scanInput, setScanInput] = useState('')
  const [scanBusy, setScanBusy] = useState(false)
  /** A failed LOOKUP is an error, not a "not on manifest" verdict. Law 12 — inline. */
  const [scanError, setScanError] = useState<string | null>(null)
  const [showScannerModal, setShowScannerModal] = useState(false)
  /**
   * Codes that answered "not on this manifest" — a statement about where a unit
   * IS, never that an expected unit is gone. Deliberately session-local and
   * labelled as such: no table receives unexpected scans in Phase 1.
   */
  const [unexpectedUnits, setUnexpectedUnits] = useState<
    Array<{ serial: string; location: string; scannedAt: string }>
  >([])
  const [lastScannedFeedback, setLastScannedFeedback] = useState<{
    serial: string
    name: string
    match: boolean
    message: string
  } | null>(null)
  const [filterMode, setFilterMode] = useState<FilterMode>('all')
  /**
   * The last RECONCILE_STOCK_CHECK rejection. Law 12 — inline and persistent;
   * `useToast()` carries successes only and no error toast is invented here.
   */
  const [reconcileError, setReconcileError] = useState<string | null>(null)

  const phone = viewport === 'phone'
  const desktop = viewport === 'desktop'

  /* ── The audits list — the real `stock_audits` table ─────────────────── */

  const fetchAudits = useCallback((f: ListFilters) => listStockAudits(f), [])
  const auditsBaseline = useMemo(() => recentAudits(), [])
  const audits = useList<StockAuditListRow>(fetchAudits, auditsBaseline, { baseline: auditsBaseline })

  /**
   * The working session: an explicit pick when it still exists in the list,
   * else the first started-but-not-completed session, else the most recently
   * scheduled. Derived, not an effect — no frame renders a stale selection.
   * Lifecycle is read off the TIMESTAMPS: `status` is free text with no CHECK
   * (0004:618) and is displayed but never branched on.
   */
  const selected: StockAuditListRow | null = useMemo(() => {
    if (selectedId) {
      const hit = audits.rows.find((a) => a.id === selectedId)
      if (hit) return hit
    }
    return audits.rows.find((a) => a.startedAtAd !== null && a.completedAtAd === null) ?? audits.rows[0] ?? null
  }, [audits.rows, selectedId])

  const auditId = selected?.id ?? ''
  const completed = selected?.completedAtAd != null

  /* ── The manifest — real `stock_audit_items`, chip-narrowed SERVER-side ── */

  const fetchItems = useCallback((f: ListFilters) => listStockAuditItems(f), [])
  const manifestBaseline = useMemo(() => itemsOfAudit(auditId), [auditId])
  const manifestFilters = useMemo(() => {
    if (filterMode === 'all' || filterMode === 'unexpected') return manifestBaseline
    return withOutcomes(manifestBaseline, [OUTCOME_OF_STATE[CHIP_STATE[filterMode]]])
  }, [manifestBaseline, filterMode])
  const items = useList<StockAuditItemRow>(fetchItems, manifestFilters, { baseline: manifestBaseline })

  /*
   * The four figures — counted from the ITEMS with one-row count queries (the
   * `INVENTORY_KPI_FILTERS` pattern), never read from the session row's stored
   * `total_*` columns, which a writer maintains and nothing reconciles. Four
   * fixed calls in a fixed order, never a loop, so hook order cannot change.
   */
  const countFetcher = useCallback((f: ListFilters) => listStockAuditItems({ ...f, withCount: true }), [])
  const kpiFilters = useMemo(() => auditItemKpiFilters(auditId), [auditId])
  const expectedKpi = useList<StockAuditItemRow>(countFetcher, kpiFilters.expected, { isFilteredOverride: false })
  const foundKpi = useList<StockAuditItemRow>(countFetcher, kpiFilters.found, { isFilteredOverride: false })
  const unverifiedKpi = useList<StockAuditItemRow>(countFetcher, kpiFilters.unverified, { isFilteredOverride: false })
  const missingKpi = useList<StockAuditItemRow>(countFetcher, kpiFilters.missing, { isFilteredOverride: false })

  /* `useList` memoises `refetch`; naming them keeps the callback keyed on
     the functions rather than on the whole list objects, which are fresh
     literals every render (react-hooks/exhaustive-deps, TODO_SWEEP A13). */
  const { refetch: refetchAudits } = audits
  const { refetch: refetchItems } = items
  const { refetch: refetchExpected } = expectedKpi
  const { refetch: refetchFound } = foundKpi
  const { refetch: refetchUnverified } = unverifiedKpi
  const { refetch: refetchMissing } = missingKpi
  const refetchAll = useCallback(() => {
    refetchAudits()
    refetchItems()
    refetchExpected()
    refetchFound()
    refetchUnverified()
    refetchMissing()
  }, [refetchAudits, refetchItems, refetchExpected, refetchFound, refetchUnverified, refetchMissing])

  const progressPct =
    foundKpi.total !== null && expectedKpi.total !== null && expectedKpi.total > 0
      ? Math.round((foundKpi.total / expectedKpi.total) * 100)
      : null

  /**
   * The scan box, answered by the SERVER against the whole manifest — the list
   * in hand may be chip-narrowed to one outcome, so matching against it would
   * call an unverified serial "not on this manifest".
   *
   * A match does NOT flip anything: the rows are the database's, and there is
   * no scan-write action yet. The feedback says what is true — on the manifest,
   * current outcome, nothing saved. Fabricating a local "Verified" over a real
   * record is the exact failure "never fabricate success" names.
   */
  const handleScanSubmit = (e?: React.FormEvent) => {
    if (e) e.preventDefault()
    const query = scanInput.trim()
    if (!query || scanBusy || !selected) return

    setScanBusy(true)
    setScanError(null)

    findStockAuditItemByCode(selected.id, query)
      .then((hit) => {
        if (hit) {
          const code = hit.serialNo ?? hit.assetTag ?? hit.productUnitId
          setLastScannedFeedback({
            serial: code,
            name: hit.productName ?? 'Manifest unit',
            match: true,
            message: `${hit.productName ?? 'Unit'} (${code}) is on this manifest — currently ${unitStateOfOutcome(
              hit.outcome,
            )}. Recording a scan is not wired yet (Phase 2), so nothing was saved.`,
          })
        } else {
          const serial = query.toUpperCase()
          // Not on this manifest — a MISPLACED statement about where a unit is,
          // not a statement that any expected unit is gone. Deduped: scanning
          // the same unknown code twice is one fact, not two rows.
          setUnexpectedUnits((prev) =>
            prev.some((u) => u.serial === serial)
              ? prev
              : [
                  {
                    serial,
                    location: scopeLine(selected),
                    scannedAt: formatAdDateTime(new Date().toISOString()),
                  },
                  ...prev,
                ],
          )
          setLastScannedFeedback({
            serial,
            name: 'Unexpected item',
            match: false,
            message: `${serial} is not on this audit's manifest. Logged under Unexpected for this session only — nothing was saved, and no expected unit was marked missing.`,
          })
        }
        setScanInput('')
      })
      .catch((err: unknown) => {
        setScanError(err instanceof Error ? err.message : String(err))
      })
      .finally(() => setScanBusy(false))
  }

  /**
   * Completing the audit closes the session. It does **not** touch a single
   * line's outcome: whatever is Unverified when the officer stops stays
   * Unverified, and the completion note says so out loud.
   *
   * ⭐ 12 Aug 2026 — nothing local flips on dispatch. The action is a Phase 2
   * stub (`reconcileStockCheck` never sets `implemented`, so `actions/core.ts`
   * fails it closed before anything observable); the `.then` re-reads the
   * database, which is the only party allowed to say the session completed.
   * The rejection lands in the inline banner and the session keeps reading
   * In Progress — which is the truth.
   */
  const handleFinishAudit = () => {
    if (!user) {
      setReconcileError(
        'You are not signed in, so this audit cannot be reconciled against anyone. Nothing was written and the session is unchanged.',
      )
      return
    }
    if (!selected) {
      setReconcileError('No audit session is selected, so there is nothing to reconcile.')
      return
    }
    const scannedCount = foundKpi.total
    const totalCount = expectedKpi.total
    if (scannedCount === null || totalCount === null) {
      setReconcileError(
        'The audit counts have not finished loading, so the reconcile totals would be wrong. Wait for the counts, then try again.',
      )
      return
    }
    setReconcileError(null)
    void import('../../actions/inventory/reconcileStockCheck')
      .then((m) => m.reconcileStockCheck({ scannedCount, totalCount }, { userId: user.id, role: user.role }))
      .then(() => refetchAll())
      .catch((err: unknown) => {
        captureError(err, { where: 'StockCheck.reconcile' })
        setReconcileError(err instanceof Error ? err.message : String(err))
      })
  }

  const kpis: Kpi[] = [
    {
      label: 'Audit progress',
      value: progressPct === null ? '—' : `${progressPct}%`,
      icon: 'activity',
      accent: 'primary',
      note: `${countOf(foundKpi, foundKpi.total)} of ${countOf(expectedKpi, expectedKpi.total)} verified`,
    },
    {
      label: 'Verified',
      value: countOf(foundKpi, foundKpi.total),
      icon: 'check',
      accent: 'success',
      note: 'Outcome Found on the record',
    },
    {
      label: 'Unverified',
      value: countOf(unverifiedKpi, unverifiedKpi.total),
      icon: 'alert_triangle',
      accent: 'progress',
      note: 'No scan yet — never counted as missing',
    },
    {
      label: 'Confirmed missing',
      value: countOf(missingKpi, missingKpi.total),
      icon: 'error',
      accent: 'danger',
      note: 'Asserted by a person, one at a time',
    },
  ]

  const stateBadge = (state: StockCheckUnitState) => {
    const meta = STOCK_CHECK_STATE_META[state]
    return (
      <span
        style={{
          display: 'inline-flex',
          alignItems: 'center',
          gap: 'var(--sp-xs)',
          padding: '2px 8px',
          borderRadius: 4,
          background: meta.bg,
          color: meta.fg,
          border: `1px solid ${meta.border}`,
          fontSize: 'var(--t-th)',
          fontWeight: 700,
          whiteSpace: 'nowrap',
        }}
      >
        {/* Law 11 — never colour alone. */}
        <Icon name={meta.icon} size={12} />
        {state}
      </span>
    )
  }

  /** The two row buttons. Confirm-missing is Unavailable, not fake — see the constant. */
  const rowActions = (it: StockAuditItemRow) => {
    const seed = verifySeedOf(it)
    return (
      <span style={{ display: 'inline-flex', gap: 'var(--sp-xs)', justifyContent: 'flex-end', flexWrap: 'wrap' }}>
        {seed && (
          <Button variant="ghost" size="sm" onClick={() => setScanInput(seed)}>
            Manual verify
          </Button>
        )}
        <Unavailable reason={CONFIRM_MISSING_UNAVAILABLE}>
          <Button variant="outline" size="sm" disabled>
            Confirm missing
          </Button>
        </Unavailable>
      </span>
    )
  }

  /* ── Session picker — the audits list, on screen ─────────────────────── */

  const sessionsCard = (
    <Card title={`Audit sessions (${audits.rows.length})`} bodyStyle={{ padding: 0 }}>
      <div style={{ display: 'flex', flexDirection: 'column' }}>
        {audits.rows.map((a) => {
          const active = a.id === auditId
          return (
            <button
              key={a.id}
              type="button"
              onClick={() => setSelectedId(a.id)}
              aria-pressed={active}
              style={{
                display: 'flex',
                flexDirection: 'column',
                alignItems: 'stretch',
                gap: 4,
                textAlign: 'left',
                minHeight: 44,
                padding: '10px 14px',
                background: active ? 'var(--hover)' : 'transparent',
                border: 'none',
                borderLeft: `3px solid ${active ? 'var(--nav-active-accent)' : 'transparent'}`,
                borderBottom: '1px solid var(--border)',
                color: 'var(--text)',
                cursor: 'pointer',
                fontFamily: 'inherit',
                fontSize: 'var(--t-meta)',
              }}
            >
              <span style={{ display: 'flex', alignItems: 'baseline', gap: 'var(--sp-sm)', flexWrap: 'wrap' }}>
                <span className="identifier" style={{ fontWeight: 700 }}>
                  {a.auditNo}
                </span>
                <span style={{ color: 'var(--muted)', fontSize: 'var(--t-th)' }}>{a.status}</span>
              </span>
              <span style={{ color: 'var(--text2)', fontSize: 'var(--t-th)' }}>{scopeLine(a)}</span>
              <span style={{ color: 'var(--muted)', fontSize: 'var(--t-th)' }}>
                scheduled {scheduledLabel(a.scheduledDateAd)}
              </span>
            </button>
          )
        })}
      </div>
    </Card>
  )

  /* ── Scanner terminal ────────────────────────────────────────────────── */

  const scannerCard = (
    <Card title="Barcode / QR scan input">
      <form onSubmit={handleScanSubmit} style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
        <div>
          <label
            htmlFor="stock-check-scan"
            style={{ display: 'block', fontSize: 'var(--t-meta)', fontWeight: 600, marginBottom: 6 }}
          >
            Scan serial, asset tag or barcode
          </label>
          <div style={{ display: 'flex', gap: 'var(--sp-sm)', flexWrap: 'wrap' }}>
            <input
              id="stock-check-scan"
              type="text"
              autoFocus={!embedded}
              placeholder="Scan or type a serial…"
              value={scanInput}
              onChange={(e) => setScanInput(e.target.value)}
              className="identifier"
              style={{
                flex: 1,
                minWidth: 140,
                height: 44,
                padding: '0 12px',
                borderRadius: 'var(--r-xs)',
                border: '2px solid var(--nav-active-accent)',
                background: 'var(--hover)',
                color: 'var(--text)',
                fontSize: 'var(--t-ui)',
              }}
            />
            <Button variant="primary" icon={<Icon name="checklist" size={13} />} disabled={scanBusy} onClick={handleScanSubmit}>
              {scanBusy ? 'Checking…' : 'Scan'}
            </Button>
            {/* variant/size explicit since the Phase-1 default unification:
                importing from ui/Button no longer implies primary/md. */}
            <Button type="button" variant="primary" size="md" icon={<Icon name="camera" size={13} />} onClick={() => setShowScannerModal(true)}>
              Camera
            </Button>
          </div>
        </div>

        {/* A failed lookup is an error about the QUERY, never a verdict about the unit. Law 12 — inline. */}
        {scanError && <ErrorBanner title="The scan could not be checked" message={scanError} />}

        {/* Law 12 — inline and persistent; a toast never carries this. */}
        {lastScannedFeedback && (
          <div
            style={{
              padding: 'var(--sp-md)',
              borderRadius: 'var(--r-sm)',
              background: lastScannedFeedback.match ? 'var(--st-in-bg)' : 'var(--st-progress-bg)',
              border: `1px solid ${lastScannedFeedback.match ? 'var(--success-text)' : 'var(--ready-text)'}`,
              display: 'flex',
              flexDirection: 'column',
              gap: 'var(--sp-xs)',
              marginTop: 6,
            }}
          >
            <div
              style={{
                display: 'flex',
                alignItems: 'center',
                gap: 6,
                fontWeight: 700,
                fontSize: 'var(--t-meta)',
                color: lastScannedFeedback.match ? 'var(--success-text)' : 'var(--ready-text)',
              }}
            >
              <Icon name={lastScannedFeedback.match ? 'check' : 'alert_triangle'} size={14} />
              <span>{lastScannedFeedback.match ? 'On this manifest' : 'Location alert'}</span>
            </div>
            <div style={{ fontSize: 'var(--t-th)', color: 'var(--text)' }}>{lastScannedFeedback.message}</div>
          </div>
        )}
      </form>
    </Card>
  )

  /* ── Session scope ───────────────────────────────────────────────────── */

  const scopeCard = selected && (
    <Card title="Session scope">
      <div
        style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-sm)', fontSize: 'var(--t-meta)', color: 'var(--text2)' }}
      >
        <div>
          Facility: <strong style={{ color: 'var(--text)' }}>{selected.warehouseName ?? '—'}</strong>
        </div>
        <div>
          Scope: <strong style={{ color: 'var(--text)' }}>{selected.scope}</strong>
        </div>
        <div>
          Status: <strong style={{ color: 'var(--text)' }}>{selected.status}</strong>
        </div>
        <div>
          Scheduled: <strong style={{ color: 'var(--text)' }}>{scheduledLabel(selected.scheduledDateAd)}</strong>
        </div>
        <div>
          Started:{' '}
          <strong style={{ color: 'var(--text)' }}>
            {selected.startedAtAd ? formatAdDateTime(selected.startedAtAd) : '—'}
          </strong>
        </div>
        {selected.completedAtAd && (
          <div>
            Completed: <strong style={{ color: 'var(--text)' }}>{formatAdDateTime(selected.completedAtAd)}</strong>
          </div>
        )}
        {/* The auditor is `audited_by`, a users.id — `users` is self-scoped by RLS
            (0020:55), so a name cannot be resolved for anyone but the viewer and
            no name is invented here. */}
        {selected.notes && <p style={{ margin: 0, fontSize: 'var(--t-th)', color: 'var(--muted)' }}>{selected.notes}</p>}
      </div>
    </Card>
  )

  /** §7.3's `[Confirm missing] (manual)` — present, disabled, and it says why. */
  const confirmMissingBar = (
    <div
      style={{
        display: 'flex',
        alignItems: 'center',
        gap: 'var(--sp-md)',
        padding: '10px 14px',
        borderTop: '1px solid var(--border)',
        flexWrap: 'wrap',
        fontSize: 'var(--t-meta)',
        color: 'var(--text2)',
      }}
    >
      <span>
        {countOf(unverifiedKpi, unverifiedKpi.total)} unverified · {countOf(missingKpi, missingKpi.total)} confirmed
        missing
      </span>
      <span style={{ marginLeft: 'auto', display: 'flex', gap: 'var(--sp-sm)', flexWrap: 'wrap' }}>
        <Unavailable reason={CONFIRM_MISSING_UNAVAILABLE}>
          <Button variant="outline" size="sm" disabled>
            Confirm missing
          </Button>
        </Unavailable>
      </span>
    </div>
  )

  /* ── The manifest ────────────────────────────────────────────────────── */

  const chipRow = (
    <div className="rsp-chip-scroll inventory-chip-track">
      {(
        [
          { id: 'all', name: 'All', count: countOf(expectedKpi, expectedKpi.total) },
          { id: 'verified', name: 'Verified', count: countOf(foundKpi, foundKpi.total) },
          { id: 'unverified', name: 'Unverified', count: countOf(unverifiedKpi, unverifiedKpi.total) },
          { id: 'missing', name: 'Missing', count: countOf(missingKpi, missingKpi.total) },
          { id: 'unexpected', name: 'Unexpected', count: String(unexpectedUnits.length) },
        ] as Array<{ id: FilterMode; name: string; count: string }>
      ).map((t) => {
        const active = filterMode === t.id
        return (
          <button
            key={t.id}
            type="button"
            onClick={() => setFilterMode(t.id)}
            aria-pressed={active}
            className={`inventory-filter-chip ${active ? 'is-active' : ''}`}
          >
            {t.name}
            <span className="figure" style={{ color: active ? 'var(--nav-active-accent)' : 'var(--muted)', fontWeight: 600 }}>
              {t.count}
            </span>
          </button>
        )
      })}
    </div>
  )

  const itemMeta = (it: StockAuditItemRow) => (
    <>
      {it.exclusionReason && (
        <div style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>Excluded — {it.exclusionReason}</div>
      )}
      {it.scannedAtAd && (
        <div style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>scanned {formatAdDateTime(it.scannedAtAd)}</div>
      )}
      {it.discrepancyNotes && (
        <div style={{ fontSize: 'var(--t-th)', color: 'var(--muted)', fontStyle: 'italic', lineHeight: '1.5' }}>{it.discrepancyNotes}</div>
      )}
    </>
  )

  const itemTitle = (it: StockAuditItemRow) => {
    const target = linkTargetOf(it)
    const inner = (
      <>
        <div style={{ fontWeight: 600, color: 'var(--text)' }}>{titleOf(it)}</div>
        <div className="identifier" style={{ fontSize: 'var(--t-th)', color: 'var(--muted)' }}>
          {codeLineOf(it)}
        </div>
      </>
    )
    return target ? (
      <Link to={target} style={{ color: 'inherit', textDecoration: 'none' }}>
        {inner}
      </Link>
    ) : (
      inner
    )
  }

  const manifest = (
    <Card
      title={
        filterMode === 'unexpected'
          ? `Unexpected scans (${unexpectedUnits.length})`
          : `Location manifest (${items.rows.length}${expectedKpi.total !== null ? ` of ${expectedKpi.total}` : ''})`
      }
      action={chipRow}
      bodyStyle={{ padding: 0 }}
    >
      {filterMode === 'unexpected' ? (
        unexpectedUnits.length === 0 ? (
          <div style={{ padding: 'var(--sp-md)' }}>
            <EmptyState
              icon={<Icon name="alert_triangle" size={22} />}
              title="No misplaced or unexpected items scanned yet"
              description="Codes that answer 'not on this manifest' are listed here for this session only — nothing is saved, and a misplaced item never marks an expected unit missing."
            />
          </div>
        ) : (
          <DataTableShell ariaLabel="Unexpected scanned units" data-table-scroll style={{ overflowX: 'auto', padding: 'var(--sp-md)' }}>
            <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: 'var(--t-meta)' }}>
              <thead>
                <tr style={{ borderBottom: '1px solid var(--border)', textAlign: 'left', color: 'var(--muted)' }}>
                  <th style={{ padding: 8 }}>Scanned identifier</th>
                  <th style={{ padding: 8 }}>State</th>
                  <th style={{ padding: 8 }}>Location scanned</th>
                  <th style={{ padding: 8 }}>Time scanned</th>
                </tr>
              </thead>
              <tbody>
                {unexpectedUnits.map((u) => (
                  <tr key={u.serial} style={{ borderBottom: '1px solid var(--border)' }}>
                    <td style={{ padding: '10px 8px' }}>
                      <span className="identifier" style={{ color: 'var(--danger-text)', fontWeight: 600 }}>
                        {u.serial}
                      </span>
                    </td>
                    <td style={{ padding: '10px 8px' }}>
                      <span
                        style={{
                          display: 'inline-flex',
                          alignItems: 'center',
                          gap: 'var(--sp-xs)',
                          padding: '2px 8px',
                          borderRadius: 4,
                          background: 'var(--st-danger-bg)',
                          color: 'var(--danger-text)',
                          fontSize: 'var(--t-th)',
                          fontWeight: 700,
                        }}
                      >
                        <Icon name="alert_triangle" size={12} />
                        Misplaced
                      </span>
                    </td>
                    <td style={{ padding: '10px 8px', color: 'var(--text2)' }}>{u.location}</td>
                    <td style={{ padding: '10px 8px', color: 'var(--muted)' }}>{u.scannedAt}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </DataTableShell>
        )
      ) : (
        <PageBody
          loading={items.loading}
          error={items.error}
          onRetry={items.refetch}
          hasRows={items.rows.length > 0}
          empty={items.isEmpty}
          emptyIsFiltered={items.isFiltered}
          onClearFilters={() => setFilterMode('all')}
          noun="manifest lines"
          skeleton="table"
          skeletonRows={6}
          {...(items.isFiltered
            ? {}
            : {
                emptyTitle: 'No lines on this manifest',
                emptyMessage: 'This audit has no expected units recorded against it.',
              })}
        >
          {phone ? (
            /* Below 768 the manifest is card rows — `▪ item  Unverified`. */
            <div style={{ display: 'flex', flexDirection: 'column' }}>
              {items.rows.map((it) => {
                const state = unitStateOfOutcome(it.outcome)
                return (
                  <div
                    key={it.id}
                    style={{
                      display: 'flex',
                      flexDirection: 'column',
                      gap: 6,
                      padding: '12px 14px',
                      borderBottom: '1px solid var(--border)',
                    }}
                  >
                    {itemTitle(it)}
                    <div style={{ fontSize: 'var(--t-th)', color: 'var(--text2)' }}>{locationOf(it)}</div>
                    {itemMeta(it)}
                    <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--sp-sm)', flexWrap: 'wrap' }}>
                      {stateBadge(state)}
                      {state === 'Unverified' && rowActions(it)}
                    </div>
                  </div>
                )
              })}
            </div>
          ) : (
            <DataTableShell ariaLabel="Manifest expected units" data-table-scroll style={{ overflowX: 'auto', borderRadius: 'var(--r-card) var(--r-card) 0 0' }}>
              <table className="inventory-table" style={{ width: '100%', borderCollapse: 'collapse', fontSize: 'var(--t-meta)' }}>
                <thead>
                  <tr style={{ background: 'var(--th-bg)' }}>
                    <th style={{ padding: '10px 12px' }}>Item &amp; tag</th>
                    {/* Tablet drops the serial column — §7.3's "same, fewer columns". */}
                    {desktop && <th style={{ padding: '10px 12px' }}>Serial number</th>}
                    <th style={{ padding: '10px 12px' }}>Rack / shelf / bin</th>
                    <th style={{ padding: '10px 12px' }}>State</th>
                    <th style={{ padding: '10px 12px', textAlign: 'right' }}>Action</th>
                  </tr>
                </thead>
                <tbody>
                  {items.rows.map((it) => {
                    const state = unitStateOfOutcome(it.outcome)
                    return (
                      <tr key={it.id} className="inventory-parent-row">
                        <td style={{ padding: '12px' }}>{itemTitle(it)}</td>
                        {desktop && (
                          <td style={{ padding: '12px' }}>
                            <span className="inventory-asset-code identifier">
                              {it.serialNo ?? '—'}
                            </span>
                          </td>
                        )}
                        <td style={{ padding: '12px', color: 'var(--text2)' }}>
                          <div style={{ fontWeight: 500 }}>{locationOf(it)}</div>
                          {itemMeta(it)}
                        </td>
                        <td style={{ padding: '12px' }}>{stateBadge(state)}</td>
                        <td style={{ padding: '12px', textAlign: 'right' }}>
                          {state === 'Unverified' && rowActions(it)}
                        </td>
                      </tr>
                    )
                  })}
                </tbody>
              </table>
            </DataTableShell>
          )}
        </PageBody>
      )}

      {filterMode !== 'unexpected' && confirmMissingBar}
    </Card>
  )

  /* ── Page ────────────────────────────────────────────────────────────── */

  const restriction = stockAuditRestriction(user?.role)

  return (
    <PageShell width="full">
      <div className="inventory-v2">
      {/* §5 — breadcrumb only. The Shell carries the crumb trail and PLAN.md
          Phase 5 forbids a Back button. Embedded, the tab strip above already
          says where we are. */}
      {!embedded && (
        <PageHeader
          title={selected ? `Stock check: ${selected.auditNo}` : 'Stock check'}
          description={selected ? scopeLine(selected) : 'Physical count sessions against the live inventory record'}
          actions={
            <div style={{ display: 'flex', alignItems: 'center', gap: 10, flexWrap: 'wrap' }}>
              <Button variant="ghost" onClick={() => navigate('/inventory')}>
                Exit session
              </Button>
              {selected && !completed && (
                <Button variant="primary" icon={<Icon name="check" size={14} />} onClick={handleFinishAudit}>
                  Reconcile &amp; complete audit
                </Button>
              )}
              {selected && completed && (
                <span
                  style={{
                    display: 'inline-flex',
                    alignItems: 'center',
                    gap: 6,
                    padding: '6px 14px',
                    borderRadius: 'var(--r-xs)',
                    background: 'var(--st-in-bg)',
                    color: 'var(--success-text)',
                    fontWeight: 700,
                    fontSize: 'var(--t-meta)',
                  }}
                >
                  <Icon name="check" size={13} />
                  Audit completed
                </span>
              )}
            </div>
          }
        />
      )}

      {/* Law 12 — the reconcile rejection, inline and persistent. The session
          above it still reads In Progress, which is the truth. */}
      {reconcileError && <ErrorBanner title="The audit was not reconciled" message={reconcileError} />}

      <PageBody
        {...restriction}
        loading={audits.loading}
        error={audits.error}
        onRetry={audits.refetch}
        hasRows={audits.rows.length > 0}
        empty={audits.isEmpty}
        noun="stock audits"
        skeleton="card"
        emptyTitle="No stock audits yet"
        emptyMessage="No stock-take session exists in the record. Creating one from this screen is not wired yet; sessions appear here once they exist in the database."
      >
        {selected && (
          <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-lg)' }}>
            <KpiStrip items={kpis} columns={4} />

            {/* §7.3's session card — `session · scheduled` over the progress bar. */}
            <Card>
              <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-sm)' }}>
                <div style={{ display: 'flex', alignItems: 'baseline', gap: 'var(--sp-sm)', flexWrap: 'wrap' }}>
                  <span className="identifier" style={{ fontWeight: 700, color: 'var(--text)' }}>
                    {selected.auditNo}
                  </span>
                  <span style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
                    scheduled {scheduledLabel(selected.scheduledDateAd)} · {selected.status}
                  </span>
                  <span className="figure" style={{ marginLeft: 'auto', fontWeight: 700, color: 'var(--text)' }}>
                    {countOf(foundKpi, foundKpi.total)} / {countOf(expectedKpi, expectedKpi.total)}
                  </span>
                </div>
                <div
                  role="progressbar"
                  aria-valuenow={progressPct ?? 0}
                  aria-valuemin={0}
                  aria-valuemax={100}
                  aria-label="Audit progress"
                  style={{ width: '100%', height: 8, borderRadius: 4, background: 'var(--hover)', overflow: 'hidden' }}
                >
                  <div
                    style={{
                      width: '100%',
                      height: '100%',
                      background: 'var(--nav-active-accent)',
                      transform: `scaleX(${(progressPct ?? 0) / 100})`,
                      transformOrigin: 'left',
                      transition: 'transform 0.2s ease',
                    }}
                  />
                </div>
                <p style={{ margin: 0, fontSize: 'var(--t-th)', color: 'var(--muted)' }}>
                  An unscanned unit stays <strong>Unverified</strong>. Nothing on this screen marks one missing — that
                  is [Confirm missing], and a person presses it.
                </p>
              </div>
            </Card>

            {/*
              Desktop: session picker + scanner terminal to the left of the
              manifest. Below 1280 they reflow BENEATH the manifest — still
              visible, still operable, never behind a handle.
            */}
            <div
              style={{
                display: 'grid',
                gridTemplateColumns: desktop ? 'minmax(300px, 360px) minmax(0, 1fr)' : 'minmax(0, 1fr)',
                gap: 'var(--sp-lg)',
                alignItems: 'start',
              }}
            >
              {desktop && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-lg)' }}>
                  {sessionsCard}
                  {scannerCard}
                  {scopeCard}
                </div>
              )}

              {manifest}

              {!desktop && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-lg)' }}>
                  {sessionsCard}
                  {scannerCard}
                  {scopeCard}
                </div>
              )}
            </div>
          </div>
        )}
      </PageBody>

      {/* §7.3 phone — a sticky `⦿ scan to verify` bar under the list. The Scanner
          FAB exists at every width in the shell; this is the screen's own
          in-context entry to the same modal. */}
      {phone && selected && (
        <>
          <div style={{ height: 68 }} aria-hidden />
          <div
            style={{
              position: 'fixed',
              left: 0,
              right: 0,
              bottom: 0,
              zIndex: 5,
              padding: '10px var(--sp-md) calc(10px + env(safe-area-inset-bottom, 0px))',
              background: 'var(--card)',
              borderTop: '1px solid var(--border)',
              boxShadow: '0 -2px 10px rgba(0, 0, 0, 0.05)',
              display: 'flex',
              justifyContent: 'center',
            }}
          >
            <Button
              variant="primary"
              size="md"
              icon={<Icon name="camera" size={16} />}
              onClick={() => setShowScannerModal(true)}
              style={{ width: '100%', minHeight: 48, justifyContent: 'center' }}
            >
              Scan to verify
            </Button>
          </div>
        </>
      )}

      <BarcodeScannerModal
        isOpen={showScannerModal}
        onClose={() => setShowScannerModal(false)}
        mode="reset"
        items={items.rows.map((it) => ({
          id: it.id,
          name: titleOf(it),
          ...(it.serialNo ? { serial: it.serialNo } : {}),
          ...(it.assetTag ? { assetTag: it.assetTag } : {}),
        }))}
        matchLabel="matched — code copied to the scan field; press Scan to check it against the manifest (nothing saved)"
        onItemScanned={(item) => {
          setScanInput(item.serial ?? item.assetTag ?? item.id)
        }}
      />
      </div>
    </PageShell>
  )
}
</file>

<file path="src/modules/inventory/WarrantyTracker.tsx">
/**
 * WarrantyTracker — Equipment coverage & RMA claims management.
 *
 * Ported from the standalone's WARRANTY engine (script_1.js:6950-6992).
 * Monitors warranty periods, upcoming expirations (<=60d), RMA claims,
 * and warranty ROI (% of premiums recovered).
 */
import { useState, useMemo, useCallback } from 'react'
import { Card, KpiStrip, PageHeader } from '../../components/ui/Page'
import type { Kpi } from '../../components/ui/Page'
import { Button } from '../../components/ui/Button'
import { Badge } from '../../components/ui/Badge'
import { SearchInput } from '../../components/ui/SearchInput'
import { PageShell } from '../../components/ui/PageShell'
import { DataTableShell } from '../../components/ui/DataTable'
import { Modal } from '../../components/ui/Modal'
import { useToast } from '../../components/ui/Toast'
import { formatMoney, rupees } from '../../lib/money'
import { useCanViewMoney } from '../../lib/moneyVisibility'
import { useViewport } from '../../lib/device'
import { IS_MOCK } from '../../lib/supabase'
import {
  getWarrantyItems,
  recordWarrantyClaim,
  getWarrantyStats,
  type WarrantyItem,
  type WarrantyState,
} from '../../lib/queries/warranty'

const chipStyle = (active: boolean): React.CSSProperties => ({
  minHeight: 'var(--tap, 44px)',
  padding: '6px 14px',
  borderRadius: '9px',
  fontSize: '12px',
  fontWeight: 600,
  cursor: 'pointer',
  display: 'inline-flex',
  alignItems: 'center',
  border: active ? '1px solid rgba(47, 125, 255, 0.4)' : '1px solid var(--border)',
  background: active ? 'rgba(47, 125, 255, 0.14)' : 'transparent',
  color: active ? 'var(--info)' : 'var(--text3)',
  transition: 'all 0.15s',
})

export default function WarrantyTracker() {
  if (IS_MOCK) return <WarrantyPreview />
  return (
    <PageShell header={<PageHeader title="Equipment Warranty" />}>
      <Card><div role="status" style={{ padding: 'var(--sp-md)' }}>
        <h2>Warranty claims unavailable</h2>
        <p>Shared warranty tracking and claims are not available yet. Existing entries on this device have been kept.</p>
      </div></Card>
    </PageShell>
  )
}

function WarrantyPreview() {
  const { showSuccessToast } = useToast()
  const viewport = useViewport()
  const isPhone = viewport === 'phone'
  const canViewMoney = useCanViewMoney()

  const [items, setItems] = useState<WarrantyItem[]>(getWarrantyItems)
  const [filter, setFilter] = useState<'All' | WarrantyState>('All')
  const [search, setSearch] = useState('')
  const [claimTarget, setClaimTarget] = useState<WarrantyItem | null>(null)
  const [claimAmount, setClaimAmount] = useState('10000')
  const [claimNotes, setClaimNotes] = useState('')

  const stats = useMemo(() => getWarrantyStats(items), [items])

  const filtered = useMemo(() => {
    return items.filter((item) => {
      if (filter !== 'All' && item.status !== filter) return false
      if (search.trim()) {
        const q = search.toLowerCase()
        return (
          item.name.toLowerCase().includes(q) ||
          item.serialNo.toLowerCase().includes(q) ||
          item.provider.toLowerCase().includes(q) ||
          item.category.toLowerCase().includes(q)
        )
      }
      return true
    })
  }, [items, filter, search])

  const handleRecordClaim = useCallback(() => {
    if (!claimTarget) return
    const amt = Number(claimAmount) || 0
    const updated = recordWarrantyClaim(claimTarget.id, amt, claimNotes)
    setItems(updated)
    setClaimTarget(null)
    setClaimAmount('10000')
    setClaimNotes('')
    showSuccessToast(
      canViewMoney
        ? `Claim of ${formatMoney(rupees(amt))} recorded for ${claimTarget.name}`
        : `Warranty claim recorded for ${claimTarget.name}`,
    )
  }, [claimTarget, claimAmount, claimNotes, canViewMoney, showSuccessToast])

  const kpis: Kpi[] = useMemo(() => [
    ...(canViewMoney
      ? [
          {
            label: 'Premiums Paid',
            value: formatMoney(rupees(stats.totalPremiums)),
            icon: 'card' as const,
            accent: 'primary' as const,
            definition: 'Total cost of warranty policies & care packages across gear.',
          },
          {
            label: 'Claims Recovered',
            value: formatMoney(rupees(stats.totalRecovered)),
            icon: 'check' as const,
            accent: 'success' as const,
            definition: 'Value of repairs and replacements recovered through RMA warranty.',
          },
        ]
      : []),
    { label: 'Expiring ≤ 60d', value: String(stats.expiringSoonCount), icon: 'alert_triangle', accent: 'warn' },
    { label: 'Expired / Void', value: String(stats.expiredCount), icon: 'alert_triangle', accent: 'danger' },
  ], [stats, canViewMoney])

  return (
    <PageShell
      header={
        <PageHeader
          title="Equipment Warranty & RMA Tracker"
          description="Manufacturer guarantees, care packages, upcoming expirations (≤60d), and claims."
          search={{
            value: search,
            onChange: setSearch,
            placeholder: 'Search equipment, serial, provider… (press /)',
          }}
        />
      }
    >
      {/* KPI strip */}
      <KpiStrip items={kpis} columns={isPhone || !canViewMoney ? 2 : 4} />

      {/* Filter and search bar */}
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: '12px', flexWrap: 'wrap', margin: 'var(--sp-md) 0' }}>
        <div style={{ display: 'flex', gap: '8px', flexWrap: 'wrap' }}>
          {(['All', 'Expiring', 'Active', 'Expired'] as const).map((st) => (
            <button
              key={st}
              type="button"
              aria-pressed={filter === st}
              style={chipStyle(filter === st)}
              onClick={() => setFilter(st)}
            >
              {st}
            </button>
          ))}
        </div>
        <div style={{ minWidth: 200, maxWidth: 300 }}>
          <SearchInput value={search} onChange={setSearch} placeholder="Search equipment, serial, provider…" />
        </div>
      </div>

      {/* Table of items */}
      <Card>
        <DataTableShell ariaLabel="Warranty tracker">
          <table style={{ width: '100%', borderCollapse: 'collapse', textAlign: 'left', fontSize: 'var(--t-meta)' }}>
            <thead>
              <tr style={{ borderBottom: '1px solid var(--border)' }}>
                <th style={{ padding: '10px 16px', fontWeight: 600, color: 'var(--text2)' }}>Equipment / Serial</th>
                <th style={{ padding: '10px 8px', fontWeight: 600, color: 'var(--text2)' }}>Coverage Provider</th>
                <th style={{ padding: '10px 8px', fontWeight: 600, color: 'var(--text2)' }}>End Date</th>
                <th style={{ padding: '10px 8px', fontWeight: 600, color: 'var(--text2)' }}>Status</th>
                {canViewMoney && (
                  <th style={{ padding: '10px 8px', fontWeight: 600, color: 'var(--text2)', textAlign: 'right' }}>Premium</th>
                )}
                <th style={{ padding: '10px 16px', fontWeight: 600, color: 'var(--text2)', textAlign: 'right' }}>
                  {canViewMoney ? 'Claims Recovered' : 'Claims'}
                </th>
                <th style={{ padding: '10px 16px', fontWeight: 600, color: 'var(--text2)', textAlign: 'right' }}>Actions</th>
              </tr>
            </thead>
            <tbody>
              {filtered.length === 0 && (
                <tr>
                  <td colSpan={canViewMoney ? 7 : 6} style={{ padding: '40px 16px', textAlign: 'center', color: 'var(--text3)' }}>
                    No warranty records matching "{search}"
                  </td>
                </tr>
              )}
              {filtered.map((item) => {
                const roi = item.premiumCost > 0 ? Math.round((item.claimsRecovered / item.premiumCost) * 100) : 0
                return (
                  <tr key={item.id} style={{ borderBottom: '1px solid var(--border)' }}>
                    <td style={{ padding: '10px 16px' }}>
                      <div style={{ fontWeight: 600, color: 'var(--text)' }}>{item.name}</div>
                      <div style={{ fontSize: '11px', color: 'var(--text3)', marginTop: '2px' }}>
                        {item.serialNo} · {item.category}
                      </div>
                    </td>
                    <td style={{ padding: '10px 8px', color: 'var(--text2)' }}>
                      <div>{item.provider}</div>
                      <div style={{ fontSize: '11px', color: 'var(--text3)' }}>{item.termMonths} mos</div>
                    </td>
                    <td style={{ padding: '10px 8px' }}>
                      <div>{item.endDate}</div>
                      <div style={{ fontSize: '11px', color: item.daysRemaining < 0 ? 'var(--red)' : item.daysRemaining <= 60 ? 'var(--gold)' : 'var(--text3)' }}>
                        {item.daysRemaining < 0 ? `${Math.abs(item.daysRemaining)}d ago` : `${item.daysRemaining}d left`}
                      </div>
                    </td>
                    <td style={{ padding: '10px 8px' }}>
                      <Badge
                        tone={item.status === 'Active' ? 'in' : item.status === 'Expiring' ? 'warning' : 'danger'}
                        label={item.status}
                      />
                    </td>
                    {canViewMoney && (
                      <td style={{ padding: '10px 8px', textAlign: 'right', fontWeight: 500 }}>
                        {formatMoney(rupees(item.premiumCost))}
                      </td>
                    )}
                    <td style={{ padding: '10px 16px', textAlign: 'right' }}>
                      {canViewMoney && (
                        <div style={{ fontWeight: 600, color: 'var(--text)' }}>
                          {formatMoney(rupees(item.claimsRecovered))}
                        </div>
                      )}
                      <div style={{ fontSize: '11px', color: canViewMoney && roi >= 100 ? 'var(--green)' : item.claimsCount > 0 ? 'var(--gold)' : 'var(--text3)' }}>
                        {item.claimsCount} claim{item.claimsCount === 1 ? '' : 's'} {canViewMoney && item.claimsCount > 0 ? `· ${roi}% ROI` : ''}
                      </div>
                    </td>
                    <td style={{ padding: '10px 16px', textAlign: 'right' }}>
                      <Button
                        variant="outline"
                        size="sm"
                        onClick={() => setClaimTarget(item)}
                      >
                        Record Claim
                      </Button>
                    </td>
                  </tr>
                )
              })}
            </tbody>
          </table>
        </DataTableShell>
      </Card>

      {/* Record Claim Modal */}
      {claimTarget && (
        <Modal isOpen onClose={() => setClaimTarget(null)} title={`Record Warranty Claim — ${claimTarget.name}`}>
          <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
            <div style={{ padding: '10px 12px', background: 'var(--surface)', borderRadius: '8px', fontSize: 'var(--t-meta)' }}>
              <div><strong>Serial No:</strong> {claimTarget.serialNo}</div>
              <div><strong>Provider:</strong> {claimTarget.provider}</div>
              <div>
                <strong>Current Claims:</strong> {claimTarget.claimsCount}
                {canViewMoney ? ` (${formatMoney(rupees(claimTarget.claimsRecovered))} recovered)` : ''}
              </div>
            </div>

            {canViewMoney && (
              <div>
                <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text2)' }}>Claim Value Recovered (NPR) *</label>
                <input
                  type="number"
                  value={claimAmount}
                  onChange={(e) => setClaimAmount(e.target.value)}
                  style={{ width: '100%', padding: '8px 10px', borderRadius: '8px', border: '1px solid var(--border)', background: 'var(--surface)', color: 'var(--text)', marginTop: '4px' }}
                />
              </div>
            )}

            <div>
              <label style={{ fontSize: '12px', fontWeight: 600, color: 'var(--text2)' }}>Claim / RMA Description</label>
              <textarea
                placeholder="e.g. Shutter replacement, optical re-centering, sensor cleaning..."
                value={claimNotes}
                onChange={(e) => setClaimNotes(e.target.value)}
                rows={3}
                style={{ width: '100%', padding: '8px 10px', borderRadius: '8px', border: '1px solid var(--border)', background: 'var(--surface)', color: 'var(--text)', marginTop: '4px', resize: 'vertical' }}
              />
            </div>

            <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '8px', marginTop: '12px' }}>
              <Button onClick={() => setClaimTarget(null)}>Cancel</Button>
              <Button variant="primary" onClick={handleRecordClaim}>
                Save Claim
              </Button>
            </div>
          </div>
        </Modal>
      )}
    </PageShell>
  )
}
</file>

<file path="src/modules/notes/EntityIdSelectorModal.tsx">
/**
 * EntityIdSelectorModal — Interactive Entity ID Picker for Notes & Dispatch
 * Babin Rentals OS
 *
 * Allows operators to quickly search, browse, and pick Equipment Asset Tags,
 * Booking Numbers, Client IDs, Invoices, Transport units, or custom IDs.
 */

import { useState, useEffect, useMemo, useRef } from 'react'
import { Modal } from '../../components/ui'
import Icon from '../../components/ui/Icon'
import { Button } from '../../components/ui/Button'
import { Badge } from '../../components/ui/Badge'
import {
  searchEntityLookup,
  getRecentEntitiesFromNotes,
  createCustomEntityItem,
  type EntityLookupItem,
  type EntityLookupKind,
} from '../../lib/queries/entityLookup'
import { getReferenceIconName, type InternalNote } from '../../lib/queries/internalNotes'

interface EntityIdSelectorModalProps {
  isOpen: boolean
  onClose: () => void
  onSelectEntity: (item: EntityLookupItem, action: 'attach' | 'insert') => void
  currentAttachedId?: string | undefined
  recentNotes?: InternalNote[] | undefined
}

const TABS: Array<{ kind: EntityLookupKind; label: string; icon: import('../../components/ui/Icon').IconName }> = [
  { kind: 'all', label: 'All Entities', icon: 'queues' },
  { kind: 'equipment', label: 'Equipment (EQ)', icon: 'camera' },
  { kind: 'booking', label: 'Bookings (BR)', icon: 'calendar' },
  { kind: 'client', label: 'Clients (CL)', icon: 'user' },
  { kind: 'invoice', label: 'Invoices (INV)', icon: 'receipt' },
  { kind: 'transport', label: 'Transport (TR)', icon: 'truck' },
  { kind: 'custom', label: 'Custom ID', icon: 'edit' },
]

export default function EntityIdSelectorModal({
  isOpen,
  onClose,
  onSelectEntity,
  currentAttachedId,
  recentNotes = [],
}: EntityIdSelectorModalProps) {
  const [activeTab, setActiveTab] = useState<EntityLookupKind>('all')
  const [searchTerm, setSearchTerm] = useState('')
  const [customInput, setCustomInput] = useState('')
  const [results, setResults] = useState<EntityLookupItem[]>([])
  const [isSearching, setIsSearching] = useState(false)
  const searchInputRef = useRef<HTMLInputElement>(null)

  // Focus input on open
  useEffect(() => {
    if (isOpen) {
      setSearchTerm('')
      setCustomInput('')
      setTimeout(() => searchInputRef.current?.focus(), 100)
    }
  }, [isOpen])

  // Suggested / recent items from active notes
  const recentItems = useMemo(() => {
    return getRecentEntitiesFromNotes(recentNotes).slice(0, 6)
  }, [recentNotes])

  // Search effect
  useEffect(() => {
    let isMounted = true
    setIsSearching(true)

    const timer = setTimeout(() => {
      void searchEntityLookup(searchTerm, activeTab === 'custom' ? 'all' : activeTab, 20).then(res => {
        if (isMounted) {
          setResults(res)
          setIsSearching(false)
        }
      })
    }, 80)

    return () => {
      isMounted = false
      clearTimeout(timer)
    }
  }, [searchTerm, activeTab])

  const handleSelect = (item: EntityLookupItem, action: 'attach' | 'insert') => {
    onSelectEntity(item, action)
    onClose()
  }

  const handleCustomSubmit = (e?: React.FormEvent) => {
    if (e) e.preventDefault()
    if (!customInput.trim()) return
    const customItem = createCustomEntityItem(customInput)
    handleSelect(customItem, 'attach')
  }

  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      title="Select Entity ID"
      size="lg"
    >
      <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
        {/* Current Attached Alert */}
        {currentAttachedId && (
          <div
            style={{
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
              padding: '8px 12px',
              borderRadius: 'var(--r-sm)',
              background: 'rgba(28, 92, 196, 0.08)',
              border: '1px solid var(--border)',
              fontSize: '12px',
            }}
          >
            <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
              <span style={{ color: 'var(--muted)' }}>Currently linked:</span>
              <span
                style={{
                  fontFamily: 'var(--font-mono, "JetBrains Mono", monospace)',
                  fontWeight: 700,
                  color: 'var(--accent)',
                  fontSize: '13px',
                }}
              >
                {currentAttachedId}
              </span>
            </div>
            <span style={{ fontSize: '11px', color: 'var(--text2)' }}>
              Selecting another ID will update this note
            </span>
          </div>
        )}

        {/* Tab Pills */}
        <div
          style={{
            display: 'flex',
            gap: 6,
            overflowX: 'auto',
            paddingBottom: 4,
            borderBottom: '1px solid var(--border)',
          }}
        >
          {TABS.map(tab => {
            const isActive = activeTab === tab.kind
            return (
              <button
                key={tab.kind}
                type="button"
                onClick={() => setActiveTab(tab.kind)}
                style={{
                  minHeight: 44,
                  padding: '0 14px',
                  borderRadius: 'var(--r-sm)',
                  border: `1px solid ${isActive ? 'var(--accent)' : 'transparent'}`,
                  background: isActive ? 'var(--accent)' : 'var(--surface-2)',
                  color: isActive ? '#fff' : 'var(--text2)',
                  fontSize: 'var(--t-meta, 13px)',
                  fontWeight: 600,
                  cursor: 'pointer',
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: 6,
                  whiteSpace: 'nowrap',
                  transition: 'all var(--dur-fast) var(--ease)',
                }}
              >
                <Icon name={tab.icon} size={14} />
                {tab.label}
              </button>
            )
          })}
        </div>

        {/* Custom ID Form if on Custom tab */}
        {activeTab === 'custom' ? (
          <form
            onSubmit={handleCustomSubmit}
            style={{
              padding: 16,
              borderRadius: 'var(--r-card)',
              background: 'var(--card)',
              border: '1px solid var(--border)',
              display: 'flex',
              flexDirection: 'column',
              gap: 12,
            }}
          >
            <div style={{ fontSize: '13px', fontWeight: 600, color: 'var(--text)' }}>
              Enter Custom / Vehicle / Case Identifier:
            </div>
            <div style={{ display: 'flex', gap: 8 }}>
              <input
                type="text"
                value={customInput}
                onChange={e => setCustomInput(e.target.value)}
                placeholder="e.g. TR-VEHICLE-01, CASE-RED-04, DM-1044..."
                style={{
                  flex: 1,
                  minHeight: 44,
                  padding: '0 12px',
                  borderRadius: 'var(--r-sm)',
                  border: '1px solid var(--border)',
                  background: 'var(--input-bg)',
                  color: 'var(--text)',
                  fontSize: '14px',
                  fontFamily: 'var(--font-mono, "JetBrains Mono", monospace)',
                }}
              />
              <Button
                variant="primary"
                type="submit"
                disabled={!customInput.trim()}
                style={{ minHeight: 44 }}
              >
                <Icon name="check" size={16} />
                Attach Custom ID
              </Button>
            </div>
            <div style={{ fontSize: '11px', color: 'var(--muted)' }}>
              Use custom prefixes like <code>TR-</code> for transport vehicles or <code>CASE-</code> for flight cases.
            </div>
          </form>
        ) : (
          <>
            {/* Search Input Bar */}
            <div style={{ position: 'relative' }}>
              <input
                ref={searchInputRef}
                type="text"
                aria-label="Search entities"
                value={searchTerm}
                onChange={e => setSearchTerm(e.target.value)}
                placeholder="Search equipment tag, booking #, client name, invoice..."
                style={{
                  width: '100%',
                  minHeight: 44,
                  padding: '0 36px 0 36px',
                  borderRadius: 'var(--r-sm)',
                  border: '1px solid var(--border)',
                  background: 'var(--input-bg)',
                  color: 'var(--text)',
                  fontSize: '13px',
                }}
              />
              <span
                style={{
                  position: 'absolute',
                  left: 10,
                  top: '50%',
                  transform: 'translateY(-50%)',
                  color: 'var(--muted)',
                  pointerEvents: 'none',
                }}
              >
                <Icon name="search" size={16} />
              </span>
              {searchTerm && (
                <button
                  type="button"
                  onClick={() => setSearchTerm('')}
                  style={{
                    position: 'absolute',
                    right: 8,
                    top: '50%',
                    transform: 'translateY(-50%)',
                    background: 'none',
                    border: 'none',
                    color: 'var(--muted)',
                    cursor: 'pointer',
                    padding: 4,
                  }}
                >
                  <Icon name="close" size={14} />
                </button>
              )}
            </div>

            {/* Recent Suggestions Row */}
            {recentItems.length > 0 && !searchTerm && (
              <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
                <div style={{ fontSize: '11px', fontWeight: 600, color: 'var(--muted)', textTransform: 'uppercase' }}>
                  Recently Referenced in Shift Notes:
                </div>
                <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6 }}>
                  {recentItems.map(item => (
                    <button
                      key={item.code}
                      type="button"
                      onClick={() => handleSelect(item, 'attach')}
                      style={{
                        padding: '4px 10px',
                        borderRadius: 'var(--r-pill)',
                        border: '1px solid var(--border)',
                        background: 'var(--surface-2)',
                        color: 'var(--text)',
                        fontSize: '11px',
                        fontFamily: 'var(--font-mono, "JetBrains Mono", monospace)',
                        fontWeight: 600,
                        cursor: 'pointer',
                        display: 'inline-flex',
                        alignItems: 'center',
                        gap: 5,
                        transition: 'all var(--dur-fast)',
                      }}
                    >
                      <Icon name={getReferenceIconName(item.code)} size={12} style={{ color: 'var(--accent)' }} />
                      <span>{item.code}</span>
                      <span style={{ fontSize: '10px', color: 'var(--muted)', fontFamily: 'sans-serif' }}>
                        · {item.title.slice(0, 18)}
                      </span>
                    </button>
                  ))}
                </div>
              </div>
            )}

            {/* Results List */}
            <div
              style={{
                display: 'flex',
                flexDirection: 'column',
                gap: 8,
                maxHeight: 380,
                overflowY: 'auto',
                paddingRight: 4,
              }}
            >
              {isSearching ? (
                <div style={{ padding: 24, textAlign: 'center', color: 'var(--muted)', fontSize: '13px' }}>
                  Searching fleet inventory and bookings...
                </div>
              ) : results.length === 0 ? (
                <div
                  style={{
                    padding: '32px 16px',
                    textAlign: 'center',
                    background: 'var(--surface-2)',
                    borderRadius: 'var(--r-card)',
                    border: '1px dashed var(--border)',
                  }}
                >
                  <div style={{ fontSize: '13px', fontWeight: 600, color: 'var(--text)', marginBottom: 4 }}>
                    No matching entity found for "{searchTerm}"
                  </div>
                  <div style={{ fontSize: '12px', color: 'var(--muted)', marginBottom: 12 }}>
                    You can still attach this as a custom reference code.
                  </div>
                  {searchTerm && (
                    <Button
                      variant="primary"
                      onClick={() => handleSelect(createCustomEntityItem(searchTerm), 'attach')}
                      style={{ minHeight: 40, margin: '0 auto' }}
                    >
                      <Icon name="plus" size={14} />
                      Attach "{searchTerm.toUpperCase()}" as Custom ID
                    </Button>
                  )}
                </div>
              ) : (
                results.map(item => {
                  const iconName = getReferenceIconName(item.code)
                  return (
                    <div
                      key={item.id}
                      style={{
                        padding: '10px 14px',
                        borderRadius: 'var(--r-sm)',
                        background: 'var(--card)',
                        border: '1px solid var(--border)',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'space-between',
                        gap: 12,
                        flexWrap: 'wrap',
                        transition: 'border-color var(--dur-fast)',
                      }}
                    >
                      <div style={{ display: 'flex', alignItems: 'center', gap: 12, minWidth: 200, flex: 1 }}>
                        <div
                          style={{
                            width: 34,
                            height: 34,
                            borderRadius: 'var(--r-sm)',
                            background: 'var(--surface-2)',
                            color: 'var(--accent)',
                            display: 'grid',
                            placeItems: 'center',
                            flexShrink: 0,
                          }}
                        >
                          <Icon name={iconName} size={16} />
                        </div>
                        <div style={{ minWidth: 0, flex: 1 }}>
                          <div style={{ display: 'flex', alignItems: 'center', gap: 8, flexWrap: 'wrap' }}>
                            <span
                              style={{
                                fontFamily: 'var(--font-mono, "JetBrains Mono", monospace)',
                                fontWeight: 700,
                                fontSize: '13px',
                                color: 'var(--text)',
                                background: 'var(--surface-2)',
                                padding: '2px 6px',
                                borderRadius: 'var(--r-sm)',
                                border: '1px solid var(--border)',
                              }}
                            >
                              {item.code}
                            </span>
                            <span
                              style={{
                                fontSize: '13px',
                                fontWeight: 600,
                                color: 'var(--text)',
                                overflow: 'hidden',
                                textOverflow: 'ellipsis',
                                whiteSpace: 'nowrap',
                              }}
                            >
                              {item.title}
                            </span>
                            {item.badge && (
                              <Badge
                                label={item.badge}
                                tone={item.badgeTone || 'neutral'}
                              />
                            )}
                          </div>
                          <div
                            style={{
                              fontSize: '11px',
                              color: 'var(--muted)',
                              marginTop: 2,
                              overflow: 'hidden',
                              textOverflow: 'ellipsis',
                              whiteSpace: 'nowrap',
                            }}
                          >
                            {item.subtitle}
                          </div>
                        </div>
                      </div>

                      {/* Action buttons */}
                      <div style={{ display: 'flex', gap: 6, flexShrink: 0, alignItems: 'center' }}>
                        <button
                          type="button"
                          onClick={() => handleSelect(item, 'insert')}
                          title={`Insert [${item.code}] into note draft text`}
                          style={{
                            minHeight: 44,
                            padding: '0 12px',
                            borderRadius: 'var(--r-sm)',
                            border: '1px solid var(--border)',
                            background: 'var(--surface-2)',
                            color: 'var(--text2)',
                            fontSize: 'var(--t-meta, 12px)',
                            fontWeight: 600,
                            cursor: 'pointer',
                            display: 'inline-flex',
                            alignItems: 'center',
                            gap: 6,
                          }}
                        >
                          <Icon name="plus" size={14} />
                          Insert in Text
                        </button>
                        <Button
                          variant="primary"
                          onClick={() => handleSelect(item, 'attach')}
                          style={{ minHeight: 44, padding: '0 14px', fontSize: 'var(--t-meta, 12px)' }}
                        >
                          <Icon name="check" size={16} />
                          Attach ID
                        </Button>
                      </div>
                    </div>
                  )
                })
              )}
            </div>
          </>
        )}
      </div>
    </Modal>
  )
}
</file>

<file path="src/modules/notes/InternalNotesPage.tsx">
/**
 * InternalNotesPage — Team Dispatch & Operations Scratchpad Page
 * Babin Rentals OS
 *
 * Dedicated team operational hub for shift handovers, gear alerts,
 * vehicle dispatch remarks, and booking notices with clickable cross-links.
 */
import { useState, useEffect, useMemo, useRef } from 'react'
import { Link } from 'react-router-dom'
import Icon from '../../components/ui/Icon'
import { Badge } from '../../components/ui/Badge'
import { Button } from '../../components/ui/Button'
import { PageHeader, Card } from '../../components/ui/Page'
import { PageShell } from '../../components/ui/PageShell'
import { IS_MOCK } from '../../lib/supabase'
import { ConfirmDialog } from '../../components/ui/ConfirmDialog'
import { useAuth } from '../../lib/auth'
import { useOptionalToast } from '../../components/ui/Toast'
import { toBs, formatBs, formatAd } from '../../lib/bs'
import {
  listInternalNotes,
  addInternalNote,
  updateInternalNote,
  togglePinNote,
  toggleResolveNote,
  deleteInternalNote,
  clearResolvedNotes,
  getInternalNotesStats,
  getReferenceUrl,
  extractReferenceId,
  extractReferenceIds,
  getReferenceIconName,
  type InternalNote,
  type NoteCategory,
  type NotePriority,
} from '../../lib/queries/internalNotes'
import EntityIdSelectorModal from './EntityIdSelectorModal'
import ShiftBriefModal from './ShiftBriefModal'
import { getRecentEntitiesFromNotes, type EntityLookupItem } from '../../lib/queries/entityLookup'
import './notes.css'

const CATEGORIES: NoteCategory[] = [
  'Shift Handover',
  'Equipment Alert',
  'Logistics & Transport',
  'Client Remark',
  'General',
]

const QUICK_TEMPLATES = [
  {
    label: '🚨 Equipment Defect',
    category: 'Equipment Alert' as NoteCategory,
    priority: 'urgent' as NotePriority,
    template: 'EQ-SONY-FX6-01 sensor needs wet cleaning before tomorrow shoot.',
    refId: 'EQ-SONY-FX6-01',
  },
  {
    label: '🔄 Shift Handover',
    category: 'Shift Handover' as NoteCategory,
    priority: 'high' as NotePriority,
    template: 'Shift Handover: BR-2613 packed 3 cases; NiSi primes pending final check.',
    refId: 'BR-2613',
  },
  {
    label: '🚚 Dispatch Route',
    category: 'Logistics & Transport' as NoteCategory,
    priority: 'high' as NotePriority,
    template: 'Dispatch BR-2615: Balkhu road blockage, driver reroute via Kirtipur.',
    refId: 'BR-2615',
  },
  {
    label: '👤 Client Remark',
    category: 'Client Remark' as NoteCategory,
    priority: 'normal' as NotePriority,
    template: 'Client Q-1049 requested 6:00 AM delivery to site; call location manager 30m prior.',
    refId: 'Q-1049',
  },
]

export default function InternalNotesPage() {
  if (IS_MOCK) return <InternalNotesPreview />
  return (
    <PageShell header={<PageHeader title="Team Notes" />}>
      <Card><div role="status" style={{ padding: 'var(--sp-md)' }}>
        <h2>Shared team notes unavailable</h2>
        <p>Team notes cannot be shared between staff yet. Existing entries on this device have been kept.</p>
      </div></Card>
    </PageShell>
  )
}

function InternalNotesPreview() {
  const { user } = useAuth()
  const toast = useOptionalToast()

  const [notes, setNotes] = useState<InternalNote[]>(() => listInternalNotes())
  const [draft, setDraft] = useState('')
  const [category, setCategory] = useState<NoteCategory>('General')
  const [priority, setPriority] = useState<NotePriority>('normal')
  const [attachedRefId, setAttachedRefId] = useState<string | null>(null)

  // Filters & search
  const [searchTerm, setSearchTerm] = useState('')
  const [filterCategory, setFilterCategory] = useState<string>('All')
  const [statusFilter, setStatusFilter] = useState<'all' | 'open' | 'resolved' | 'pinned'>('all')
  const [priorityFilter, setPriorityFilter] = useState<'all' | 'urgent'>('all')
  const [selectedEntityFilter, setSelectedEntityFilter] = useState<string | null>(null)
  const [sortBy, setSortBy] = useState<'pinned-first' | 'newest' | 'oldest' | 'priority'>('pinned-first')
  const [viewMode, setViewMode] = useState<'cards' | 'compact'>('cards')

  // Inline editing state
  const [editingId, setEditingId] = useState<string | null>(null)
  const [editDraft, setEditDraft] = useState('')
  const [editCategory, setEditCategory] = useState<NoteCategory>('General')
  const [editPriority, setEditPriority] = useState<NotePriority>('normal')
  const [editRefId, setEditRefId] = useState<string | null>(null)

  // Modals state
  const [isEntitySelectorOpen, setIsEntitySelectorOpen] = useState(false)
  const [isEditingEntitySelectorOpen, setIsEditingEntitySelectorOpen] = useState(false)
  const [isShiftBriefOpen, setIsShiftBriefOpen] = useState(false)

  const textareaRef = useRef<HTMLTextAreaElement>(null)
  const searchInputRef = useRef<HTMLInputElement>(null)

  const reloadNotes = () => {
    setNotes(listInternalNotes())
  }

  useEffect(() => {
    const handleUpdate = () => reloadNotes()
    window.addEventListener('babin:notes-updated', handleUpdate)
    return () => window.removeEventListener('babin:notes-updated', handleUpdate)
  }, [])

  // Keyboard shortcut listener (/ to search, Esc to clear)
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === '/' && document.activeElement !== searchInputRef.current && document.activeElement !== textareaRef.current) {
        e.preventDefault()
        searchInputRef.current?.focus()
      } else if (e.key === 'Escape') {
        if (editingId) {
          setEditingId(null)
        } else if (selectedEntityFilter) {
          setSelectedEntityFilter(null)
        } else if (searchTerm) {
          setSearchTerm('')
        }
      }
    }
    window.addEventListener('keydown', handleKeyDown)
    return () => window.removeEventListener('keydown', handleKeyDown)
  }, [editingId, selectedEntityFilter, searchTerm])

  const detectedRef = useMemo(() => extractReferenceId(draft), [draft])

  // Current NPT & BS Date header
  const nepaliDateStr = useMemo(() => {
    try {
      const now = new Date()
      const bs = toBs(now)
      const bsStr = bs ? formatBs(bs) : ''
      const adStr = formatAd(now)
      return bsStr ? `${adStr} · ${bsStr}` : adStr
    } catch {
      return 'Kathmandu HQ'
    }
  }, [])

  const stats = useMemo(() => getInternalNotesStats(notes), [notes])

  // Category counts
  const categoryCounts = useMemo(() => {
    const counts: Record<string, number> = { All: notes.length }
    for (const cat of CATEGORIES) {
      counts[cat] = notes.filter(n => n.category === cat).length
    }
    return counts
  }, [notes])

  // Top suggestions from notes for 1-click select
  const suggestedEntities = useMemo(() => {
    return getRecentEntitiesFromNotes(notes).slice(0, 5)
  }, [notes])

  const handlePost = (e?: React.FormEvent) => {
    if (e) e.preventDefault()
    if (!draft.trim()) return

    const authorName = user?.name || 'Staff Member'
    const authorRole = user?.role || 'Operations'

    addInternalNote({
      author: authorName,
      authorRole,
      text: draft,
      category,
      priority,
      ...(attachedRefId ? { referenceId: attachedRefId } : {}),
    })

    setDraft('')
    setAttachedRefId(null)
    reloadNotes()
    toast?.showSuccessToast('Note Posted', 'Shift log updated successfully.')
  }

  const handleApplyTemplate = (tmpl: typeof QUICK_TEMPLATES[number]) => {
    setCategory(tmpl.category)
    setPriority(tmpl.priority)
    setDraft(tmpl.template)
    if (tmpl.refId) {
      setAttachedRefId(tmpl.refId)
    }
    textareaRef.current?.focus()
  }

  const handleTogglePin = (id: string) => {
    togglePinNote(id)
    reloadNotes()
  }

  const handleToggleResolve = (id: string) => {
    const current = notes.find(n => n.id === id)
    const operator = user?.name || 'Operations Staff'
    toggleResolveNote(id, operator)
    reloadNotes()
    if (current?.status !== 'resolved') {
      toast?.showSuccessToast('Task Resolved', 'Marked as completed for this shift.')
    } else {
      toast?.showSuccessToast('Task Reopened', 'Restored to open queue.')
    }
  }

  const [confirmDialog, setConfirmDialog] = useState<{
    isOpen: boolean
    title: string
    description: string
    confirmLabel: string
    onConfirm: () => void
  } | null>(null)

  const handleDelete = (id: string) => {
    setConfirmDialog({
      isOpen: true,
      title: 'Delete this internal note?',
      description: 'Are you sure you want to permanently delete this internal note from the dispatch log?',
      confirmLabel: 'Delete Note',
      onConfirm: () => {
        setConfirmDialog(null)
        deleteInternalNote(id)
        reloadNotes()
        toast?.showSuccessToast('Note Deleted', 'Removed from internal dispatch log.')
      },
    })
  }

  const handleClearResolved = () => {
    if (stats.resolved === 0) return
    setConfirmDialog({
      isOpen: true,
      title: `Clear all ${stats.resolved} resolved notes?`,
      description: `This will archive all ${stats.resolved} resolved tasks and clear them from the current view.`,
      confirmLabel: 'Clear Resolved',
      onConfirm: () => {
        setConfirmDialog(null)
        const count = clearResolvedNotes()
        reloadNotes()
        toast?.showSuccessToast('Cleaned Log', `Archived ${count} resolved notes.`)
      },
    })
  }

  const handleStartEdit = (note: InternalNote) => {
    setEditingId(note.id)
    setEditDraft(note.text)
    setEditCategory(note.category)
    setEditPriority(note.priority || 'normal')
    setEditRefId(note.referenceId || null)
  }

  const handleSaveEdit = (id: string) => {
    if (!editDraft.trim()) return
    updateInternalNote(id, {
      text: editDraft,
      category: editCategory,
      priority: editPriority,
      referenceId: editRefId || undefined,
    })
    setEditingId(null)
    reloadNotes()
    toast?.showSuccessToast('Note Updated', 'Changes saved successfully.')
  }

  const handleCancelEdit = () => {
    setEditingId(null)
    setEditDraft('')
    setEditRefId(null)
  }

  // Handle entity selected from Modal
  const handleEntitySelected = (item: EntityLookupItem, action: 'attach' | 'insert') => {
    if (action === 'attach') {
      setAttachedRefId(item.code)
      toast?.showSuccessToast('ID Attached', `Linked ${item.code} to note.`)
    } else {
      // Insert in text at cursor or append
      const codeTag = `[${item.code}] `
      setDraft(prev => prev ? `${prev} ${codeTag}` : codeTag)
      setAttachedRefId(item.code)
      toast?.showSuccessToast('ID Inserted', `Added ${item.code} to draft text.`)
    }
  }

  const handleEditingEntitySelected = (item: EntityLookupItem, action: 'attach' | 'insert') => {
    if (action === 'attach') {
      setEditRefId(item.code)
    } else {
      setEditDraft(prev => prev ? `${prev} [${item.code}] ` : `[${item.code}] `)
      setEditRefId(item.code)
    }
  }

  // Filter and sort notes
  const filteredNotes = useMemo(() => {
    let result = [...notes]

    // Search query
    if (searchTerm.trim()) {
      const q = searchTerm.toLowerCase().trim()
      result = result.filter(n => {
        const textMatch = n.text.toLowerCase().includes(q)
        const authorMatch = n.author.toLowerCase().includes(q)
        const roleMatch = n.authorRole.toLowerCase().includes(q)
        const refMatch = n.referenceId?.toLowerCase().includes(q) || n.referenceIds?.some(r => r.toLowerCase().includes(q))
        return textMatch || authorMatch || roleMatch || refMatch
      })
    }

    // Specific entity filter
    if (selectedEntityFilter) {
      const target = selectedEntityFilter.toUpperCase()
      result = result.filter(n => {
        return (
          n.referenceId?.toUpperCase() === target ||
          n.referenceIds?.some(r => r.toUpperCase() === target) ||
          n.text.toUpperCase().includes(target)
        )
      })
    }

    // Category filter
    if (filterCategory !== 'All') {
      result = result.filter(n => n.category.toLowerCase() === filterCategory.toLowerCase())
    }

    // Status filter
    if (statusFilter === 'open') {
      result = result.filter(n => n.status !== 'resolved')
    } else if (statusFilter === 'resolved') {
      result = result.filter(n => n.status === 'resolved')
    } else if (statusFilter === 'pinned') {
      result = result.filter(n => Boolean(n.pinned))
    }

    // Priority filter
    if (priorityFilter === 'urgent') {
      result = result.filter(n => n.priority === 'urgent')
    }

    // Sorting
    result.sort((a, b) => {
      if (sortBy === 'pinned-first') {
        if (a.pinned && !b.pinned) return -1
        if (!a.pinned && b.pinned) return 1
        return b.timestamp - a.timestamp
      }
      if (sortBy === 'newest') {
        return b.timestamp - a.timestamp
      }
      if (sortBy === 'oldest') {
        return a.timestamp - b.timestamp
      }
      if (sortBy === 'priority') {
        const rank: Record<string, number> = { urgent: 3, high: 2, normal: 1, low: 0 }
        const rA = rank[a.priority || 'normal'] ?? 1
        const rB = rank[b.priority || 'normal'] ?? 1
        if (rA !== rB) return rB - rA
        return b.timestamp - a.timestamp
      }
      return 0
    })

    return result
  }, [notes, searchTerm, selectedEntityFilter, filterCategory, statusFilter, priorityFilter, sortBy])

  return (
    <div className="notes-page-container">
      {confirmDialog && (
        <ConfirmDialog
          isOpen={confirmDialog.isOpen}
          title={confirmDialog.title}
          description={confirmDialog.description}
          confirmLabel={confirmDialog.confirmLabel}
          variant="danger"
          onClose={() => setConfirmDialog(null)}
          onConfirm={confirmDialog.onConfirm}
        />
      )}

      {/* Entity ID Selector Modals */}
      <EntityIdSelectorModal
        isOpen={isEntitySelectorOpen}
        onClose={() => setIsEntitySelectorOpen(false)}
        onSelectEntity={handleEntitySelected}
        currentAttachedId={attachedRefId || undefined}
        recentNotes={notes}
      />

      <EntityIdSelectorModal
        isOpen={isEditingEntitySelectorOpen}
        onClose={() => setIsEditingEntitySelectorOpen(false)}
        onSelectEntity={handleEditingEntitySelected}
        currentAttachedId={editRefId || undefined}
        recentNotes={notes}
      />

      {/* Shift Handover Brief Modal */}
      <ShiftBriefModal
        isOpen={isShiftBriefOpen}
        onClose={() => setIsShiftBriefOpen(false)}
        notes={notes}
      />

      {/* Page Header */}
      <PageHeader
        title="Team Dispatch & Shift Notes"
        description={`Live shift handovers, equipment alerts & field notices · ${nepaliDateStr}`}
        search={{
          value: searchTerm,
          onChange: setSearchTerm,
          placeholder: 'Search notes by keyword, booking ID, author, asset tag… (press /)',
        }}
        actions={
          <div style={{ display: 'flex', alignItems: 'center', gap: 8, flexWrap: 'wrap' }}>
            {/* View Mode Toggle */}
            <div style={{ display: 'flex', borderRadius: 'var(--r-sm)', border: '1px solid var(--border)', overflow: 'hidden' }}>
              <button
                type="button"
                aria-pressed={viewMode === 'cards'}
                className={`notes-view-btn ${viewMode === 'cards' ? 'is-active' : ''}`}
                onClick={() => setViewMode('cards')}
                title="Cards feed view"
                style={{ minHeight: 44 }}
              >
                <Icon name="queues" size={14} />
                Cards
              </button>
              <button
                type="button"
                aria-pressed={viewMode === 'compact'}
                className={`notes-view-btn ${viewMode === 'compact' ? 'is-active' : ''}`}
                onClick={() => setViewMode('compact')}
                title="Compact operations table view"
                style={{ minHeight: 44 }}
              >
                <Icon name="checklist" size={14} />
                Compact
              </button>
            </div>

            <Button
              variant="secondary"
              onClick={() => setIsShiftBriefOpen(true)}
              title="Open structured shift handover brief modal (WhatsApp/Telegram export)"
              style={{ minHeight: 44 }}
            >
              <Icon name="copy" size={16} />
              Shift Brief
            </Button>

            {stats.resolved > 0 && (
              <Button
                variant="secondary"
                onClick={handleClearResolved}
                title={`Archive ${stats.resolved} resolved notes`}
                style={{ minHeight: 44, color: 'var(--muted)' }}
              >
                <Icon name="archive" size={16} />
                Clear Resolved ({stats.resolved})
              </Button>
            )}

            <Button
              variant="secondary"
              onClick={() => window.dispatchEvent(new CustomEvent('babin:open-notes'))}
              title="Open quick drawer overlay (Alt+N)"
              style={{ minHeight: 44 }}
            >
              <Icon name="external_link" size={16} />
              Open in Drawer
            </Button>
          </div>
        }
      />

      {/* Metrics KPI Strip — Interactive Clickable Filters */}
      <div className="notes-metrics-grid">
        <button
          type="button"
          onClick={() => {
            setFilterCategory('Equipment Alert')
            setStatusFilter('open')
          }}
          style={{
            background: 'var(--card)',
            border: `1px solid ${stats.gearAlerts > 0 ? 'var(--danger)' : 'var(--border)'}`,
            borderRadius: 'var(--r-card)',
            padding: '14px 16px',
            boxShadow: 'var(--shadow-card)',
            display: 'flex',
            alignItems: 'center',
            gap: 12,
            textAlign: 'left',
            cursor: 'pointer',
            transition: 'transform var(--dur-fast)',
          }}
        >
          <div
            style={{
              width: 40,
              height: 40,
              borderRadius: 'var(--r-sm)',
              background: stats.gearAlerts > 0 ? 'rgba(217, 72, 69, 0.12)' : 'var(--surface-2)',
              color: stats.gearAlerts > 0 ? 'var(--danger)' : 'var(--muted)',
              display: 'grid',
              placeItems: 'center',
            }}
          >
            <Icon name="alert_triangle" size={20} />
          </div>
          <div>
            <div style={{ fontSize: '11px', fontWeight: 600, color: 'var(--muted)', textTransform: 'uppercase' }}>
              Equipment Alerts
            </div>
            <div style={{ fontSize: '20px', fontWeight: 700, color: stats.gearAlerts > 0 ? 'var(--danger)' : 'var(--text)', fontFamily: 'var(--font-mono, monospace)', fontVariantNumeric: 'tabular-nums' }}>
              {stats.gearAlerts}
            </div>
          </div>
        </button>

        <button
          type="button"
          onClick={() => {
            setFilterCategory('Shift Handover')
            setStatusFilter('open')
          }}
          style={{
            background: 'var(--card)',
            border: '1px solid var(--border)',
            borderRadius: 'var(--r-card)',
            padding: '14px 16px',
            boxShadow: 'var(--shadow-card)',
            display: 'flex',
            alignItems: 'center',
            gap: 12,
            textAlign: 'left',
            cursor: 'pointer',
          }}
        >
          <div
            style={{
              width: 40,
              height: 40,
              borderRadius: 'var(--r-sm)',
              background: 'rgba(28, 92, 196, 0.1)',
              color: 'var(--accent)',
              display: 'grid',
              placeItems: 'center',
            }}
          >
            <Icon name="refresh" size={20} />
          </div>
          <div>
            <div style={{ fontSize: '11px', fontWeight: 600, color: 'var(--muted)', textTransform: 'uppercase' }}>
              Shift Handovers
            </div>
            <div style={{ fontSize: '20px', fontWeight: 700, color: 'var(--text)', fontFamily: 'var(--font-mono, monospace)', fontVariantNumeric: 'tabular-nums' }}>
              {stats.handoverCount}
            </div>
          </div>
        </button>

        <button
          type="button"
          onClick={() => {
            setPriorityFilter('urgent')
            setStatusFilter('open')
          }}
          style={{
            background: 'var(--card)',
            border: `1px solid ${stats.urgentCount > 0 ? 'var(--warn)' : 'var(--border)'}`,
            borderRadius: 'var(--r-card)',
            padding: '14px 16px',
            boxShadow: 'var(--shadow-card)',
            display: 'flex',
            alignItems: 'center',
            gap: 12,
            textAlign: 'left',
            cursor: 'pointer',
          }}
        >
          <div
            style={{
              width: 40,
              height: 40,
              borderRadius: 'var(--r-sm)',
              background: stats.urgentCount > 0 ? 'rgba(240, 140, 0, 0.12)' : 'var(--surface-2)',
              color: stats.urgentCount > 0 ? 'var(--warn-text)' : 'var(--muted)',
              display: 'grid',
              placeItems: 'center',
            }}
          >
            <Icon name="bell" size={20} />
          </div>
          <div>
            <div style={{ fontSize: '11px', fontWeight: 600, color: 'var(--muted)', textTransform: 'uppercase' }}>
