                            onPatch={(u) => patch(l.key, u)}
                            onRemove={() => removeLine(l.key)}
                            onToggleChild={(childId, required, on) => toggleChild(l.key, childId, required, on)}
                            childIsLine={(id) => lines.some((o) => o.modelId === id)}
