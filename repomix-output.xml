<file path="src/modules/operations/operations.css">
.operations-v2 { gap: 18px; }
/* PageHeader typography/padding is locked (Page.tsx) — no page overrides. */
.operations-v2__topline, .operations-v2__filters, .operations-v2__queues { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
/* Filters row owns a stacking level so the open date popover paints above
   the sticky table header and row cells below it. */
.operations-v2__filters { position: relative; z-index: 30; }
.operations-v2__topline { justify-content: flex-end; }
.operations-v2__queues { padding: 14px 0 6px; border-top: 1px solid var(--border); }
.operations-v2__queue { min-height: 46px; }
.operations-v2__date-wrap, .operations-v2__more-wrap { position: relative; }
.operations-v2__date-wrap:has(.operations-v2__popover) { z-index: 31; }
.operations-v2__popover { position: absolute; z-index: 50; top: calc(100% + 8px); right: 0; width: min(360px, calc(100vw - 32px)); padding: 12px; background: var(--card); border: 1px solid var(--border); border-radius: var(--r-card); box-shadow: var(--shadow-lg); }
.operations-v2__date-popover { left: 0; right: auto; width: 290px; }
.operations-v2__action-popover { width: auto; min-width: 170px; }
.operations-v2__action-popover .ui-button { width: 100%; justify-content: flex-start; }
.operations-v2__date-options { display: grid; gap: 3px; }
.operations-v2__date-option { justify-content: flex-start !important; min-height: var(--tap) !important; }
.operations-v2__custom-range { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border); }
.operations-v2__calendar-range { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border); }
.operations-v2__custom-range label { display: grid; gap: 5px; color: var(--text2); font-size: var(--t-meta); }
.operations-v2__filter-select, .operations-v2__search { min-height: 44px; box-sizing: border-box; border: 1px solid var(--input-border, var(--border)); border-radius: var(--r-btn); background: var(--input-bg, var(--card)); color: var(--text); font: inherit; font-size: var(--t-meta); }
.operations-v2__filter-select { min-width: 144px; padding: 0 34px 0 13px; }
.operations-v2__search { flex: 1 1 240px; padding: 0 13px; }
.operations-v2__filter-select:focus, .operations-v2__search:focus { outline: 2px solid var(--input-focus); outline-offset: 1px; }
.operations-v2__more-sections { display: grid; gap: 14px; }
.operations-v2__more-heading { margin: 0 0 7px; font-size: var(--t-meta); color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
.operations-v2__facet-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.operations-v2__facet { min-height: var(--tap) !important; justify-content: flex-start !important; padding: 0 10px !important; }
.operations-v2__table-card { overflow: hidden; }
/* RULING 2026-10-15 (zoom audit): no forced 900px floor. The eight columns need 777px, so the
   floor alone scrolled ACTION and the row link off a 911px window (1366px laptop at 150%).
   Nowrap cells still make a narrower box scroll rather than squash. Revert = `min-width: 900px`. */
.operations-v2__table { width: 100%; border-collapse: collapse; }
/* RULING 2026-10-17 (zoom audit): the Action column and the row link stay pinned to the scroller's
   right edge when the queue is wider than its box (884px of columns in an 808px box at 911px,
   a 1366px laptop at 150%) — Rentals §4.1's "action column stays visible". The link column is a
   fixed 64px (44px target + padding) so Action can sit exactly beside it. Each cell repaints
   opaque so columns sliding under it never show through. Revert = delete these rules. */
.operations-v2__table th:last-child, .operations-v2__table td:last-child { position: sticky; right: 0; z-index: 1; width: 64px; min-width: 64px; max-width: 64px; box-sizing: border-box; background: var(--card); }
.operations-v2__table th:nth-last-child(2), .operations-v2__table td:nth-last-child(2) { position: sticky; right: 64px; z-index: 1; background: var(--card); box-shadow: inset 1px 0 0 var(--border); }
.operations-v2__table thead th:last-child, .operations-v2__table thead th:nth-last-child(2) { z-index: 3; background: var(--th-bg); }
.operations-v2__table tbody tr:hover td:last-child, .operations-v2__table tbody tr:hover td:nth-last-child(2) { background: linear-gradient(color-mix(in srgb, var(--nav-active-bg) 36%, transparent), color-mix(in srgb, var(--nav-active-bg) 36%, transparent)), var(--card); }
.operations-v2__table th { height: 48px; background: var(--th-bg); color: var(--text2); font-size: 12px; text-transform: none; letter-spacing: 0; }
.operations-v2__table thead th { position: sticky; top: 0; z-index: 2; }
.operations-v2__table tr { border-bottom: 1px solid var(--border); }
.operations-v2__table tr:last-child { border-bottom: 0; }
.operations-v2__table tbody tr { transition: background-color var(--dur-fast) var(--ease); }
.operations-v2__table tbody tr:hover { background: color-mix(in srgb, var(--nav-active-bg) 36%, transparent); }
/* The whole row opens the booking (8 Oct 2026). */
.operations-v2__table tbody tr.operations-v2__row { cursor: pointer; }
.operations-v2__table input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--primary); cursor: pointer; }
/* Law 15 — the 18px box needs a 44px activation area: enlarge the invisible
   hit zone, keep the visible box unchanged. */
.operations-v2__table td input[type="checkbox"], .operations-v2__table th input[type="checkbox"] { position: relative; }
.operations-v2__table td input[type="checkbox"]::after, .operations-v2__table th input[type="checkbox"]::after { content: ''; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); min-width: 44px; min-height: 44px; }
.operations-v2__resultbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; border-top: 1px solid var(--border); color: var(--text2); font-size: var(--t-meta); }
.operations-v2__pagination { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.operations-v2__pagination label { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
.operations-v2__pagination select { min-height: var(--tap); border: 1px solid var(--border); border-radius: var(--r-btn); background: var(--input-bg); color: var(--text); font: inherit; padding: 0 7px; }
.operations-v2__pagination .ui-button { min-width: 44px; min-height: 44px; padding: 0 9px; }
.operations-v2__empty-search { padding: 48px 18px; text-align: center; color: var(--muted); }
/* Canonical bands only (768/1280, see styles/responsive.css). The old 900px
   "tablet" rule moved into the phone band (the layout it fixed wraps fine
   until then); 620px became the canonical 768 phone band. */
@media (max-width: 767px) { .operations-v2__topline { justify-content: flex-start; } .operations-v2__filter-select { min-width: 120px; flex: 1 1 140px; } .operations-v2__queues { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 10px; } .operations-v2__queue { flex-shrink: 0; } .operations-v2__filters { align-items: stretch; } .operations-v2__filter-select, .operations-v2__search { flex: 1 1 100%; width: 100%; } .operations-v2__custom-range { grid-template-columns: 1fr; } .operations-v2__resultbar { align-items: flex-start; flex-direction: column; } }
