<file path="src/actions/clients/blockClient.ts">
import { createAction, type ActionConfig, type ActionContext } from '../core'
import { EVENT_TYPES } from '../../events/eventBus'
import { idempotentInsert, safeUpdate } from '../../lib/dataAccess'
import { supabase } from '../../lib/supabase'
import { getClientRecord } from '../../lib/queries/clients'

/**
 * # BLOCK_CLIENT — the write, and the end of block-as-component-state
 *
 * ## What this replaced
 *
 * ```ts
 * console.log(`[DB TX] Client ${input.clientId} ${input.blocked ? 'BLOCKED' : 'UNBLOCKED'}`)
 * return { result: { success: true }, events }
 * ```
 *
 * …behind screens that flipped `isBlocked` in local React state and showed a
 * green toast. A block that lives in component state is gone on reload, and
 * `client_directory_v.is_blocked` (0054) now publishes the real fact, so the
 * local flip had become a fake block painted over a genuinely un-blocked
 * record with nothing to tell the two apart. Both screens had already been
 * changed to refuse in writing rather than fake it; this file is what they
 * refused for.
 *
 * ## Blocked is a row, not a status
 *
 * `0005_clients.sql:150` — *"Deactivated is terminal, never a DELETE. Blocked is
 * never written here — it is a flag on client_flags."* `client_status` has
 * exactly two members, `Active | Deactivated` (verified against the live enum).
 * So:
 *
 *   **block**   = INSERT `client_flags` (flag_type `'Blocked'`, source
 *                 `'Manual'`, `created_by` = the actor — CHECK
 *                 `client_flags_manual_requires_actor` makes that mandatory:
 *                 *"a person's decision must name the person"*).
 *   **unblock**  = UPDATE that row's `removed_at` / `removed_by` /
 *                 `removal_reason`. **Never a DELETE** — 0005:254-255,
 *                 *"Removal is a state change on the row; the row is never
 *                 deleted"*, and Law 3 more generally. The history of who
 *                 blocked whom, why, and who lifted it, is the point.
 *
 * `client_flags_one_live_per_kind` — a partial unique index on
 * `(client_id, flag_type) where removed_at is null` (0005:260-262) — is what
 * makes "already blocked" a database fact rather than a UI guess, and it is why
 * a second block is refused by name below instead of silently inserting a
 * second live row.
 *
 * `client_flags.client_id` is the **company**, not a contact (0005:246-247:
 * *"otherwise a second contact books around the block"*).
 *
 * ## What blocking does and does not do
 *
 * 0005:264-269, and this action must not extend it: a live Blocked flag causes
 * the database to reject a **new booking INSERT** for that client, with no role
 * bypass including Owner. It must **not** cancel existing bookings, void
 * invoices, remove portal access to existing records, or touch rental history.
 * Nothing in this file writes anything but the flag row.
 *
 * ## ⚠ TODO(decision) — `client.block` resolves to no rule in `lib/rbac`
 *
 * `actions/core.ts:105-126` resolves seven capability strings and `client.block`
 * is not one of them, so the dispatcher denies this action before `execute`
 * runs. Fail-closed and deliberate — and, like `client.create`, not actually
 * unknown. The rule is applied to the database and simply has no mirror in
 * `lib/rbac`, which rbac's own header says is the drift it exists to prevent.
 * Read off the live project, 12 Aug 2026:
 *
 *     policy client_flags_insert  with check (
 *       (flag_type =  'Blocked' and auth_user_role() = any (array['Owner','Admin','Manager']))
 *       or
 *       (flag_type <> 'Blocked' and auth_user_role() = any (array['Owner','Admin','Manager','Coordinator','Warehouse']))
 *     )
 *     policy client_flags_update  using  (… Owner, Admin, Manager, Coordinator, Warehouse …)
 *                                 with check (… same Blocked/non-Blocked split as above …)
 *
 * i.e. **Owner, Admin and Manager may block and unblock; Coordinator and
 * Warehouse may not** — 0038 split 0025's single policy specifically to take
 * Blocked away from the Coordinator seat (0005:1044). Because the UPDATE policy's
 * WITH CHECK is evaluated against the post-update row, whose `flag_type` is still
 * `'Blocked'`, the same three roles gate the unblock. Writing that into
 * `lib/rbac` is a one-function change in a file this task was not given, so it is
 * recorded here rather than invented here.
 *
 * ## ⚠ TODO(decision) — is a reason mandatory?
 *
 * `client_flags.reason` is nullable and 0005:250-251 says why: *"nullable ONLY
 * because Blacklist.md leaves mandatory-reason unsettled while arguing it should
 * be mandatory. Do not ship nullable for Blocked without that ruling."* Every
 * block surface in this app already requires ten characters, so `validate`
 * below enforces the rule the UI already enforces rather than inventing a
 * looser one. `removal_reason` on the unblock side has no such UI rule and is
 * therefore accepted-but-optional; 0005:256 argues it should be recorded
 * (*"A block whose reason nobody recorded becomes a block nobody dares
 * remove"*) without making it mandatory, and that gap is the ruling above.
 */

export type BlockClientInput = {
  /**
   * `clients.client_code` — e.g. `CL-2026-0001`.
   *
   * **Not the uuid, and deliberately so.** Every clients surface holds
   * `ClientRecord.id`, which `queries/clients.ts:toClientRecord` sets to
   * `client_code`; `client_flags.client_id` is a uuid FK. Taking the code and
   * resolving it here is what stops a screen passing a code into a uuid column
   * and writing a flag against nothing. The previous input was named `clientId`
   * and was handed exactly that code by both call sites.
   */
  clientCode: string
  /** `true` inserts the flag, `false` lifts the live one. Never a delete. */
  blocked: boolean
  /** `client_flags.reason` on a block; `client_flags.removal_reason` on an unblock. */
  reason?: string | undefined
  /** **Law 8** — minted where the operator pressed the button, reused across retries. */
  clientUuid?: string | undefined
}

export type BlockClientResult = {
  /** `clients.id` — the uuid the flag row points at. */
  clientId: string
  clientCode: string
  clientName: string
  blocked: boolean
  /** `client_flags.id` — the row inserted, or the row whose removal fields were set. */
  flagId: string
}

/** The minimum a block row needs. `source` defaults to `'Manual'` on the table;
 *  it is stated because `client_flags_manual_requires_actor` pairs it with `created_by`. */
type BlockFlagInsert = {
  client_uuid: string
  client_id: string
  flag_type: 'Blocked'
  source: 'Manual'
  reason: string
  created_by: string
}

/** Law 3's removal trio. There is no other unblock path and no DELETE anywhere. */
type BlockFlagRemoval = {
  removed_at: string
  removed_by: string
  removal_reason: string | null
}

/**
 * The live Blocked flag's row id, or null.
 *
 * ⚠ **Why this read is here and not in `lib/queries/clients.ts`.** That module
 * owns client reads (Law 2's Single Query Rule) and is the correct long-term
 * home, but it is outside this task's file list and another session is live-
 * editing this repo — the same trade `actions/finance/recordPayment.ts:164-180`
 * records for its own invoice lookup. This is a one-column, single-row lookup
 * against the partial unique index, with no filters and no money conversion, so
 * none of that module's masking contract is being re-implemented.
 * TODO(refactor): hoist to `queries/clients.ts` as `liveBlockFlagId()`.
 */
async function liveBlockedFlagId(clientId: string): Promise<string | null> {
  const { data, error } = await supabase
    .from('client_flags')
    .select('id')
    .eq('client_id', clientId)
    .eq('flag_type', 'Blocked')
    .is('removed_at', null)
    .maybeSingle()

  if (error) {
    throw new Error(`Could not read this client's block state, so nothing was changed: ${error.message}`)
  }
  return data ? (data as unknown as { id: string }).id : null
}

/**
 * The config, exported alongside the dispatched action — same reason as
 * `createClient.ts`'s: `client.block` resolves to nothing in `checkCapability`,
 * so every call through `blockClient` is denied before `execute` runs, and this
 * handle is the only way the body can be tested until the matrix is ruled.
 */
export const blockClientConfig: ActionConfig<BlockClientInput, BlockClientResult> = {
  name: 'BLOCK_CLIENT',
  // Left naming the real capability — see the TODO(decision) in the header.
  permissions: ['client.block'],

  /**
   * `true` because `execute` below writes `client_flags` through
   * `lib/dataAccess` — `idempotentInsert` on block, `safeUpdate` on unblock —
   * and verifies the row came back before returning.
   *
   * ⚠ Driven against the live project as SQL, inside a PL/pgSQL block aborted
   * by `raise exception` so nothing committed: the Blocked insert made
   * `exists(live flag)` true, the removal UPDATE made it false again, and
   * `count(*)` on the client's flags stayed at 1 — the row is retained, Law 3.
   * It could **not** be driven through the UI, because the dispatcher denies
   * `client.block` before `execute` runs.
   */
  implemented: true,

  validate: (input) => {
    if (!input.clientCode || input.clientCode.trim() === '') {
      throw new Error('A block must name the client it applies to.')
    }
    if (typeof input.blocked !== 'boolean') {
      throw new Error('A block must state whether it is being applied or lifted.')
    }
    if (!input.clientUuid || input.clientUuid.trim() === '') {
      throw new Error(
        'This block carries no idempotency key, so a retry could write it twice. Nothing was sent.',
      )
    }
    if (input.blocked && (input.reason ?? '').trim().length < 10) {
      // The rule every block surface in the app already enforces. See the
      // TODO(decision) in the header for why it is not also a NOT NULL.
      throw new Error(
        'State a reason of at least ten characters. A block whose reason nobody recorded becomes a block ' +
          'nobody dares remove.',
      )
    }
  },

  execute: async (input, ctx: ActionContext) => {
    /*
     * OFFLINE — refused, not queued. `dataAccess` queues an offline write and
     * returns the payload it was handed as though it had landed
     * (`dataAccess.ts:39-43`, `:114-118`). A block that only exists in the
     * outbox is exactly the state this action was written to end: the screen
     * would say blocked, the database would say otherwise, and the booking gate
     * — which runs in Postgres — would let the next rental through.
     */
    if (typeof navigator !== 'undefined' && navigator.onLine === false) {
      throw new Error(
        'This device is offline. A block is not queued for later — it is enforced by the database when a ' +
          'booking is created, so a block that has not reached the database stops nothing. Try again when ' +
          'you are back online.',
      )
    }

    const code = input.clientCode.trim()
    const profile = await getClientRecord(code)
    if (!profile) {
      throw new Error(`No client with code ${code} exists, so nothing was changed.`)
    }

    const clientId = profile.id
    const clientName = profile.record.name
    const reason = input.reason?.trim() || null
    const liveFlagId = await liveBlockedFlagId(clientId)

    let flagId: string

    if (input.blocked) {
      if (liveFlagId) {
        // Not a silent no-op: the operator asked for a change and there is none
        // to make, and the partial unique index would reject the insert anyway.
        throw new Error(`${clientName} (${code}) is already blocked, so nothing was changed.`)
      }

      const payload: BlockFlagInsert = {
        client_uuid: input.clientUuid as string,
        client_id: clientId,
        flag_type: 'Blocked',
        source: 'Manual',
        // `validate` has already refused anything shorter than ten characters.
        reason: reason as string,
        created_by: ctx.userId,
      }

      let inserted
      try {
        /*
         * `'client_flags' as never` — `client_flags` is absent from
         * `src/types/database.ts` entirely (that file hand-declares 21 tables;
         * the accurate generated types are `src/types/supabase.ts`). Same cast,
         * same reason, as `lib/booqable/sync.ts:1772`. `BlockFlagInsert` above
         * is what typechecks the payload.
         * TODO(refactor): add `client_flags` to `src/types/database.ts` and drop
         * the cast. Out of this task's files.
         *
         * `insertViaSourceSwitch` is not used because it would only delegate:
         * `resolveDataSource('client_flags')` is `'os-native'` — the table is on
         * neither Booqable list.
         */
        inserted = await idempotentInsert('client_flags' as never, payload as never)
      } catch (err) {
        const message = err instanceof Error ? err.message : String(err)
        if (message.includes('client_flags_one_live_per_kind')) {
          throw new Error(
            `${clientName} (${code}) was blocked by someone else a moment ago, so nothing was changed.`,
          )
        }
        if (message.includes('client_flags_manual_requires_actor') || message.includes('created_by')) {
          throw new Error(
            'The signed-in user has no row in the users table, so the database refused to record who applied ' +
              'this block. Nothing was changed.',
          )
        }
        if (message.includes('client_flags_client_uuid_key')) {
          throw new Error('This block was already recorded by an earlier press. Nothing was written twice.')
        }
        throw new Error(message)
      }

      /* ── PERSISTENCE CHECK — see recordPayment for the full reasoning.
       * `idempotentInsert` returns the payload it SENT on its two queue
       * branches, and that payload has no `id`: the column is
       * `default gen_random_uuid()` and only Postgres fills it. */
      const persisted = inserted.data as unknown as { id?: string } | null
      if (inserted.error) {
        throw new Error(
          `The block could not be confirmed against the database, so treat it as not applied: ${
            (inserted.error as { message?: string }).message ?? String(inserted.error)
          }`,
        )
      }
      if (!persisted || typeof persisted.id !== 'string') {
        throw new Error(
          'The block was queued rather than written, so the database is not enforcing it yet. Check the ' +
            'connection and try again.',
        )
      }
      flagId = persisted.id
    } else {
      if (!liveFlagId) {
        throw new Error(`${clientName} (${code}) is not blocked, so there is nothing to lift.`)
      }

      const removal: BlockFlagRemoval = {
        // Device UTC. The row's `created_at` is server-side (`default now()`),
        // but PostgREST cannot send `now()` in an UPDATE payload, so removal is
        // stamped here. Law 7 — AD, in UTC, never a local wall clock.
        removed_at: new Date().toISOString(),
        removed_by: ctx.userId,
        removal_reason: reason,
      }

      /*
       * Law 3, in one line: this is an UPDATE, and there is no `.delete()`
       * anywhere in this file. `client_flags` is not on `safeUpdate`'s immutable
       * list, so the update is permitted; `clientUuid` is passed as the ACTION
       * key for the offline envelope and is deliberately not written into the
       * row (see `dataAccess.ts:66-87`).
       */
      const updated = await safeUpdate(
        'client_flags' as never,
        liveFlagId,
        { ...removal } as never,
        input.clientUuid as string,
      )

      const persisted = updated.data as unknown as { id?: string; removed_at?: string | null } | null
      if (updated.error) {
        throw new Error(
          `The block could not be lifted: ${
            (updated.error as { message?: string }).message ?? String(updated.error)
          }`,
        )
      }
      if (!persisted || typeof persisted.removed_at !== 'string') {
        throw new Error(
          'The unblock was queued rather than written, so the database is still enforcing the block. Check ' +
            'the connection and try again.',
        )
      }
      flagId = persisted.id ?? liveFlagId
    }

    const events = [
      {
        type: EVENT_TYPES.CLIENT_STATUS_UPDATED,
        payload: {
          clientId,
          clientCode: code,
          blocked: input.blocked,
          reason,
          flagId,
          userId: ctx.userId,
        },
      },
    ]

    return {
      result: { clientId, clientCode: code, clientName, blocked: input.blocked, flagId },
      events,
    }
  },
}

export const blockClient = createAction(blockClientConfig)
</file>

<file path="src/actions/clients/createClient.ts">
import { createAction, type ActionConfig, type ActionContext } from '../core'
import { EVENT_TYPES } from '../../events/eventBus'
import { idempotentInsert } from '../../lib/dataAccess'
import { supabase } from '../../lib/supabase'
import { PHONE_STORED_RE, PHONE_REJECTION } from '../../lib/phone'

/**
 * # CREATE_CLIENT — the write
 *
 * ## What this replaced
 *
 * ```ts
 * const generatedId = issue('CL', Number(Date.now().toString().slice(-4)))
 * console.log(`[DB TX] Created client ${generatedId}: ${input.name} …`)
 * return { result: { success: true, clientId: generatedId }, events }
 * ```
 *
 * A `console.log` and a client code minted off the wall clock — which
 * `slice(-4)` recycles every ten seconds and which fails the live
 * `clients_client_code_format` CHECK outright. Nothing reached Postgres. The
 * dispatcher's `implemented` default (false) is the only reason no operator was
 * shown that success. This file is now the insert.
 *
 * ## The schema facts this body is built on
 *
 * Read from `supabase/migrations/0005_clients.sql:36-119` **and** re-read off
 * the live project's catalog on 12 Aug 2026, because the two drift (see
 * `client_code` below, which is exactly that):
 *
 * 1. `clients.client_code` is `text NOT NULL` with **no default and no
 *    BEFORE-INSERT trigger** — `trg_audit_clients` is the only trigger on the
 *    table. An insert that omits it fails 23502, not 23514. The value therefore
 *    has to come from somewhere, and `next_document_number('client')`
 *    (`0007_admin_security.sql:359`) is the only allocator: it takes
 *    `for update` on `number_sequences`, so two operators submitting in the same
 *    instant cannot be handed the same code.
 * 2. `clients.phone` is `NOT NULL`, `unique (clients_phone_key)` and carries
 *    CHECK `clients_phone_format`. 0005's own comment: *"Phone is the unique
 *    identifier, not email."* The rule lives in `lib/phone` and is reused here,
 *    never restated — `PHONE_STORED_RE` mirrors that CHECK character for
 *    character.
 * 3. `type_parent` is physically nullable and 0005 marks it *TRIGGER REQUIRED*
 *    on INSERT — **that trigger does not exist on the live project**. So a
 *    client saved without a type is accepted and surfaces in the Unassigned
 *    bucket, which is what `queries/clients.ts:toClientRecord` already renders.
 *    It is still sent when the operator picked one, because they picked one.
 *    `clients_org_subtype_pairing` then requires Organisation ⇒ subtype present
 *    and Individual ⇒ subtype absent.
 * 4. **`clients` is Booqable-mastered** — `lib/dataAccess.ts:214-218` lists it in
 *    `BOOQABLE_BRIDGE_WRITABLE_TABLES`, so `insertViaSourceSwitch('clients', …)`
 *    throws by design. The raw `idempotentInsert` is the correct call here, the
 *    same one `lib/booqable/sync.ts:1772` makes for its own client writes.
 * 5. `approved_credit_limit` and `payment_terms` are **not written here and
 *    cannot be**: 0005:162-164 — *"Written ONLY by an Approved
 *    client_commercial_overrides row. No direct UPDATE path, for any role
 *    including Owner."* Add Client collects both; the screen says plainly that
 *    they are not saved rather than dropping them silently.
 *
 * ## ⚠ TODO(decision) — `client.create` resolves to no rule in `lib/rbac`
 *
 * `actions/core.ts:105-126` can resolve seven capability strings and
 * `client.create` is not one of them, so `checkCapability` returns `undefined`
 * and the dispatcher denies this action **before** `execute` ever runs
 * (`core.ts:144-149`). That is the fail-closed direction and it is deliberate;
 * it also means this body cannot be exercised through the UI until the matrix
 * `core.ts:45-52` marks TODO(decision) is ruled.
 *
 * The rule is not actually unknown — it is already applied to the database and
 * simply has no mirror in `lib/rbac`, which is the drift rbac's own header says
 * must not exist. Read off the live project, 12 Aug 2026:
 *
 *     policy clients_insert  with check (auth_user_role() = any (array[
 *       'Owner', 'Admin', 'Manager', 'Coordinator', 'Warehouse'
 *     ]))
 *
 * Writing that into `lib/rbac` is a one-function change in a file this task was
 * not given, so it is recorded here rather than invented here. `permissions`
 * below is left naming the real capability rather than being re-pointed at a
 * mapped-but-different one.
 *
 * ## ⚠ TODO(decision) — the `client_code` format mismatch (PLAN.md §4.20)
 *
 * The live CHECK is `client_code ~ '^CL-[0-9]{4}-[0-9]{4}$'` while
 * `src/data/numbering.ts` emits `C-1` under the 12 Aug identifier ruling.
 * `0055_ruled_identifier_formats.sql` moves the CHECK, the sequence rows and
 * `next_document_number()` together, and is written but **not applied**.
 *
 * This action deliberately picks neither side: it asks the database for the
 * number, so whichever format the database is configured for is the one that
 * gets written, before and after 0055. If the two halves are ever out of step
 * the insert returns a CHECK violation, and `describeInsertFailure` below turns
 * that into a sentence naming the constraint and the migration instead of an
 * unhandled 400.
 *
 * Related, and out of this task's scope: the live `clients` table already holds
 * `CL-2026-0102` while `number_sequences.current_value` for `client` is still
 * `0`, so the allocator will walk into that code and collide on
 * `clients_client_code_key` at the 102nd create. Reported, not fixed.
 */

/** `clients.type_parent` — `client_type_parent` (0001). */
export type ClientTypeParent = 'Organisation' | 'Individual'

export type CreateClientInput = {
  /** `clients.name` — one column; the label swaps by type (0005:127-128). */
  name: string
  /**
   * `clients.phone`, in the **stored** form (`+9779801234567`). Callers run
   * `lib/phone`'s `canonicalPhone()` first — this action re-checks rather than
   * re-implements, because the column's unique constraint makes a malformed
   * number a permanent bad row rather than a rejected one.
   */
  phone: string
  /** `clients.email` — nullable. Blank is stored as NULL, never as `''`. */
  email?: string | undefined
  /** `clients.type_parent`. Omitted → the client lands in the Unassigned bucket. */
  clientType?: ClientTypeParent | undefined
  /**
   * `clients.org_subtype` — a `client_organisation_subtype` member. Required by
   * CHECK when `clientType` is `'Organisation'`, forbidden when `'Individual'`.
   */
  orgSubtype?: string | undefined
  addressLine?: string | undefined
  city?: string | undefined
  district?: string | undefined
  postalCode?: string | undefined
  /** `clients.country` — NOT NULL, database default `'Nepal'`. */
  country?: string | undefined
  /** `clients.pan_vat` — CHECK: exactly nine digits, or absent. */
  panVat?: string | undefined
  notes?: string | undefined
  /**
   * **Law 8.** Minted once where the operator pressed Save (`newClientUuid()`
   * in `lib/supabase`) and reused across every retry of that one press, so a
   * double submit conflicts on `clients_client_uuid_key` instead of creating a
   * second client with a second phone-unique violation.
   *
   * Optional in the type only so the one caller this task may not edit
   * (`modules/rentals/booking/AddClientModal.tsx`) keeps compiling; `validate`
   * refuses it. `idempotentInsert` would happily mint a fresh key per call,
   * which is a duplicate client per retry — the failure Law 8 exists for.
   */
  clientUuid?: string | undefined
  /**
   * @deprecated There is no draft column anywhere on `clients` and no drafts
   * table. Accepted so existing callers passing `isDraft: false` still compile;
   * `validate` refuses `true` rather than accepting a flag it would drop.
   */
  isDraft?: boolean | undefined
}

export type CreateClientResult = {
  /** `clients.id` — the row's uuid, generated by Postgres. Never a client-side string. */
  clientId: string
  /** `clients.client_code` — allocated by `next_document_number('client')`. */
  clientCode: string
  name: string
  phone: string
}

/** The exact column set this action writes. Declared so the payload is typechecked
 *  against something true before the cast below defeats the stale hand-written type. */
type ClientInsertPayload = {
  client_uuid: string
  client_code: string
  name: string
  phone: string
  email: string | null
  type_parent?: ClientTypeParent
  org_subtype?: string
  address_line: string | null
  city: string | null
  district: string | null
  postal_code: string | null
  country: string
  pan_vat: string | null
  notes: string | null
  created_by: string
}

/** Trimmed, or null — a blank optional column is NULL, never an empty string. */
function orNull(v: string | undefined): string | null {
  const t = v?.trim()
  return t ? t : null
}

/**
 * Turn a Postgres failure into something an operator can act on.
 *
 * `idempotentInsert` reports failure by throwing an `Error` whose message is
 * `[DataAccess] Insert failed on clients: <postgres message>` — the error CODE
 * is not carried through, so the constraint name inside the message is the only
 * signal available. Each branch below names a constraint that is live on the
 * project today; anything unmatched is re-thrown verbatim rather than replaced
 * with a friendlier sentence that hides what actually happened.
 */
function describeInsertFailure(message: string, input: CreateClientInput, clientCode: string): string {
  if (message.includes('clients_phone_key')) {
    return (
      `A client with phone ${input.phone} already exists, and phone is the unique identifier for a client ` +
      `(0005:131-132). Nothing was saved — open the existing client instead, or correct the number.`
    )
  }
  if (message.includes('clients_phone_format')) {
    return `${PHONE_REJECTION} The number ${input.phone} was refused by the database, so nothing was saved.`
  }
  if (message.includes('clients_client_code_format')) {
    return (
      `The database allocated the client code ${clientCode}, and its own clients_client_code_format CHECK ` +
      `rejected it, so nothing was saved. The number sequence and the CHECK are out of step — ` +
      `migration 0055_ruled_identifier_formats.sql moves both together and has not been applied ` +
      `(PLAN.md §4.20). This needs a migration, not a retry.`
    )
  }
  if (message.includes('clients_client_code_key')) {
    return (
      `The client code ${clientCode} is already taken, so nothing was saved. The 'client' number sequence ` +
      `is behind the codes already in the table and is re-issuing them. This needs the sequence corrected, ` +
      `not a retry.`
    )
  }
  if (message.includes('clients_pan_vat_nine_digits')) {
    return `PAN/VAT must be exactly nine digits. Nothing was saved.`
  }
  if (message.includes('clients_org_subtype_pairing')) {
    return (
      `An Organisation must carry an organisation type and an Individual must not, and this client carried ` +
      `the wrong combination. Nothing was saved.`
    )
  }
  if (message.includes('clients_client_uuid_key')) {
    // Reachable only if the re-select inside idempotentInsert also failed.
    return `This client was already saved by an earlier submit of the same form. Nothing was saved twice.`
  }
  if (message.includes('created_by') || message.includes('clients_created_by')) {
    return (
      `The signed-in user has no row in the users table, so the database refused to record who created this ` +
      `client. Nothing was saved.`
    )
  }
  return message
}

/**
 * The config, exported alongside the dispatched action.
 *
 * Not a convenience. `client.create` resolves to nothing in `checkCapability`,
 * so **every** call through `createClient` below throws `ActionPermissionError`
 * before `validate` or `execute` runs — which would leave this body with no way
 * to be exercised at all, and "untested because unreachable" is how a write
 * body rots between the day it is written and the day the capability matrix
 * lands. `__tests__/createClient.test.ts` drives `validate`/`execute` through
 * this handle, and pins the denial separately through `createClient` itself, so
 * whoever rules the matrix has an executable statement of both facts.
 */
export const createClientConfig: ActionConfig<CreateClientInput, CreateClientResult> = {
  name: 'CREATE_CLIENT',
  // Left naming the real capability. See the TODO(decision) in the header: the
  // rule exists in RLS and has no mirror in `lib/rbac`, and inventing one in a
  // file this task was not given is the product decision CLAUDE.md forbids.
  permissions: ['client.create'],

  /**
   * `true` because `execute` below inserts into `clients` through
   * `lib/dataAccess`'s `idempotentInsert` and then verifies a uuid came back
   * from Postgres. See the PERSISTENCE CHECK block.
   *
   * ⚠ The write was driven against the live project as SQL, inside a
   * PL/pgSQL block aborted by `raise exception` so nothing committed
   * (`next_document_number('client')` → `CL-2026-0001`, insert accepted, the
   * sequence left at 0). It could **not** be driven through the UI, because the
   * dispatcher denies `client.create` before `execute` runs — see the header.
   */
  implemented: true,

  validate: (input) => {
    if (!input.name || input.name.trim() === '') {
      throw new Error('A client must have a name.')
    }
    if (!input.phone || input.phone.trim() === '') {
      throw new Error('A client must have a phone number — it is the unique identifier a client is matched on.')
    }
    if (!PHONE_STORED_RE.test(input.phone.trim())) {
      // The one wording, from `lib/phone`. Three screens create clients and may
      // not each explain the same rejection differently.
      throw new Error(PHONE_REJECTION)
    }
    if (!input.clientUuid || input.clientUuid.trim() === '') {
      throw new Error(
        'This client carries no idempotency key, so a retry could create a second client with the same phone. ' +
          'Nothing was sent.',
      )
    }
    if (input.isDraft === true) {
      throw new Error(
        'Draft clients have nowhere to be stored — `clients` has no draft column and there is no drafts table. ' +
          'Nothing was sent.',
      )
    }
    if (input.clientType === 'Organisation' && !input.orgSubtype?.trim()) {
      throw new Error('An Organisation must state what kind of organisation it is.')
    }
    if (input.clientType === 'Individual' && input.orgSubtype?.trim()) {
      throw new Error('An Individual cannot carry an organisation type.')
    }
    const pan = input.panVat?.trim()
    if (pan && !/^[0-9]{9}$/.test(pan)) {
      throw new Error('PAN/VAT must be exactly nine digits.')
    }
  },

  execute: async (input, ctx: ActionContext) => {
    /*
     * OFFLINE — refused, not queued.
     *
     * `idempotentInsert` queues an offline insert and returns
     * `{ data: <the payload you sent>, error: null }` (`dataAccess.ts:39-43`),
     * which has no `id` and no `client_code` the database agreed to. Handing
     * that back as a created client would show the operator a client code the
     * registry has never issued, and Add Client navigates away on success. A
     * create is refused offline instead.
     */
    if (typeof navigator !== 'undefined' && navigator.onLine === false) {
      throw new Error(
        'This device is offline. A new client is not queued for later — the client code comes from the ' +
          'database and cannot be issued here. Save it when you are back online.',
      )
    }

    /*
     * The code from the database's allocator, never from the clock.
     *
     * ⚠ A retry re-enters this RPC BEFORE the insert, so a replay that then
     * conflicts on `client_uuid` has burned a sequence value and writes no row.
     * Gaps in `client_code` are therefore possible and are not a defect — the
     * same caveat `recordPayment` records for `payment_no`.
     */
    const { data: clientCode, error: numberError } = await supabase.rpc('next_document_number', {
      p_sequence_key: 'client',
    })

    if (numberError) {
      throw new Error(`Could not allocate a client code, so nothing was saved: ${numberError.message}`)
    }
    if (!clientCode) {
      throw new Error('next_document_number returned no client code, so nothing was saved.')
    }

    const payload: ClientInsertPayload = {
      client_uuid: input.clientUuid as string,
      client_code: clientCode as string,
      name: input.name.trim(),
      phone: input.phone.trim(),
      email: orNull(input.email),
      // Spread rather than assigned: `exactOptionalPropertyTypes` is on, and an
      // absent type must be ABSENT from the payload, not present-and-undefined.
      ...(input.clientType ? { type_parent: input.clientType } : {}),
      ...(input.clientType === 'Organisation' && input.orgSubtype?.trim()
        ? { org_subtype: input.orgSubtype.trim() }
        : {}),
      address_line: orNull(input.addressLine),
      city: orNull(input.city),
      district: orNull(input.district),
      postal_code: orNull(input.postalCode),
      // NOT NULL with a database default; only sent when the operator supplied one.
      country: input.country?.trim() || 'Nepal',
      pan_vat: orNull(input.panVat),
      notes: orNull(input.notes),
      created_by: ctx.userId,
      /*
       * Deliberately NOT written, each for a stated reason:
       *  - approved_credit_limit / payment_terms — 0005:162-164, writable only
       *    through an Approved `client_commercial_overrides` row.
       *  - preferred_contact_channels — the screen offers 'Phone', which is not
       *    a member of the `preferred_contact_channel` enum
       *    (Email | SMS | WhatsApp | Push). Sending it is a 22P02; mapping it
       *    onto a different channel is inventing the operator's answer. The
       *    column keeps its `{WhatsApp}` default.
       *  - membership tier — `client_memberships`, a different table.
       *  - status — defaults to 'Active'. 'Blocked' is never a status
       *    (0005:149-150); it is a `client_flags` row, see `blockClient.ts`.
       *  - client_since — defaults to `current_date` on the server. Law 7: the
       *    database's clock is the one that cannot be skewed by a device.
       */
    }

    let result: Awaited<ReturnType<typeof idempotentInsert>>
    try {
      result = await idempotentInsert('clients' as never, payload as never, {
        /* 0130 arms Law 6 column grants on `clients` — a bare `RETURNING *`
           names the ungranted money columns (approved_credit_limit,
           payment_terms) and throws 42501 AFTER the row commits. Name the two
           granted columns the persistence check actually reads. */
        returningColumns: 'id, client_code',
      })
    } catch (err) {
      /*
       * `'clients' as never` / `payload as never` — the same cast
       * `lib/booqable/sync.ts:1772` and `:1790` already make, and for the same
       * reason: `dataAccess` is generic over `src/types/database.ts`, whose
       * hand-written `clients` entry describes columns this table does not have
       * (`client_no`, `full_name`, `mobile`, `address`, `is_blocked`). The
       * accurate generated types are in `src/types/supabase.ts`.
       * `ClientInsertPayload` above is what actually typechecks the payload, so
       * the cast defeats a wrong type rather than a right one.
       * TODO(refactor): correct the `clients` entry in `src/types/database.ts`
       * against the live catalog and drop both casts. Out of this task's files.
       */
      const message = err instanceof Error ? err.message : String(err)
      throw new Error(describeInsertFailure(message, input, clientCode as string))
    }

    /* ── PERSISTENCE CHECK ──────────────────────────────────────────────────
     * `idempotentInsert` throws on a real failure, but two of its branches
     * return successfully having written nothing: the offline queue (guarded
     * above) and the `'Failed to fetch'`/408 network branch (`:49-53`), which
     * fires even when `navigator.onLine` is true. Both return the payload that
     * was SENT, which carries no `id` — that column is
     * `default gen_random_uuid()` and only Postgres fills it. A third branch
     * (`:56-58`, the Law 8 replay) returns the raw PostgREST result, so unlike
     * every other path its `error` can be non-null.
     */
    const persisted = result.data as unknown as { id?: string; client_code?: string } | null
    if (result.error) {
      throw new Error(
        `The client could not be confirmed against the database, so treat it as not saved: ${
          (result.error as { message?: string }).message ?? String(result.error)
        }`,
      )
    }
    if (!persisted || typeof persisted.id !== 'string') {
      throw new Error(
        'The client was queued rather than written — the database has not confirmed it, so it has no client ' +
          'code yet. Check the connection and save it again.',
      )
    }

    const savedCode = persisted.client_code ?? (clientCode as string)

    const events = [
      {
        type: EVENT_TYPES.CLIENT_CREATED,
        payload: {
          clientId: persisted.id,
          clientCode: savedCode,
          name: payload.name,
          phone: payload.phone,
          email: payload.email,
          clientType: input.clientType ?? null,
          userId: ctx.userId,
        },
      },
    ]

    return {
      result: {
        clientId: persisted.id,
        clientCode: savedCode,
        name: payload.name,
        phone: payload.phone,
      },
      events,
    }
  },
}

export const createClient = createAction(createClientConfig)
</file>

<file path="src/actions/finance/__tests__/approveDailyClosing.test.ts">
/**
 * APPROVE_DAILY_CLOSING — the refusals, which are the part that matters.
 *
 * A closing is a signed record, so every way this can decline to write one has
 * to say whether anything was stored. The happy path is one test; the rest are
 * the sentences an operator reads when it did not happen.
 */

import { describe, it, expect, vi, beforeEach } from 'vitest'
import type { Paisa } from '../../../lib/money'

const rs = (n: number) => (n * 100) as Paisa

vi.mock('../../../lib/dataAccess', () => ({ idempotentInsert: vi.fn() }))
vi.mock('../../../lib/supabase', () => ({
  supabase: { from: vi.fn() },
  newClientUuid: () => 'uuid-fixed',
}))

const { idempotentInsert } = await import('../../../lib/dataAccess')
const { supabase } = await import('../../../lib/supabase')
const { approveDailyClosingConfig } = await import('../approveDailyClosing')

const asMock = (f: unknown) => f as ReturnType<typeof vi.fn>
const CTX = { userId: 'user-1', role: 'Owner' as const }

const INPUT = {
  businessDate: '2026-09-01',
  countedCash: rs(2500),
  expectedCash: rs(2000),
  variance: rs(500),
  pickupsCount: 6,
  returnsCount: 4,
  newCount: 2,
  collectedCash: rs(2000),
  collectedBank: rs(0),
  collectedCard: rs(0),
  collectedOther: rs(0),
  receivables: rs(0),
  depositsHeld: rs(5825),
  clientUuid: 'uuid-1',
}

/** `users` lookup returns a branch unless a test says otherwise. */
function mockBranch(branch: string | null, error: { message: string } | null = null) {
  asMock(supabase.from).mockReturnValue({
    select: () => ({ eq: () => ({ maybeSingle: async () => ({ data: branch ? { branch_id: branch } : null, error }) }) }),
  })
}

beforeEach(() => {
  vi.clearAllMocks()
  mockBranch('branch-1')
  asMock(idempotentInsert).mockResolvedValue({ data: { id: 'closing-1', approved_at: '2026-09-01T12:00:00Z' }, error: null })
})

const run = (over: Partial<typeof INPUT> = {}) =>
  approveDailyClosingConfig.execute({ ...INPUT, ...over }, CTX)

describe('the write', () => {
  it('stores the day, not the instant — business_date is a date column', async () => {
    await run()
    const payload = asMock(idempotentInsert).mock.calls[0]![1]
    expect(payload.business_date).toBe('2026-09-01')
  })

  it('files it under the approver’s own branch, read rather than assumed', async () => {
    await run()
    expect(asMock(idempotentInsert).mock.calls[0]![1].branch_id).toBe('branch-1')
  })

  it('names the returning columns, so the read-back cannot hit a masked one', async () => {
    /* 0078 revoked table SELECT and granted back 13 non-money columns. An
       unqualified RETURNING * would be denied on counted_cash and the write
       would LOOK like a failure while the row committed. */
    await run()
    const options = asMock(idempotentInsert).mock.calls[0]![2]
    expect(options.returningColumns).toBe('id, approved_at')
  })

  it('carries the idempotency key so a double press is one closing', async () => {
    await run()
    expect(asMock(idempotentInsert).mock.calls[0]![1].client_uuid).toBe('uuid-1')
  })

  it('returns the id Postgres minted', async () => {
    const out = await run()
    expect(out.result.closingId).toBe('closing-1')
  })
})

describe('validate — nothing leaves the screen', () => {
  const v = (over: Partial<typeof INPUT>) => () => approveDailyClosingConfig.validate?.({ ...INPUT, ...over })

  it('refuses a variance that contradicts its own two figures', () => {
    expect(v({ variance: rs(999) })).toThrow(/contradict/i)
  })

  it('refuses a negative count', () => {
    expect(v({ countedCash: -1 as Paisa })).toThrow(/never negative/i)
  })

  it('refuses a day that is not a date', () => {
    expect(v({ businessDate: '1/9/2026' })).toThrow(/YYYY-MM-DD/)
  })

  it('refuses a press with no idempotency key', () => {
    expect(v({ clientUuid: '' })).toThrow(/idempotency/i)
  })
})

describe('refusals — each says whether anything was written', () => {
  it('refuses when the approver has no branch, rather than defaulting to one', async () => {
    /* Defaulting would file one branch's takings under another, silently. */
    mockBranch(null)
    await expect(run()).rejects.toThrow(/carries no branch/i)
  })

  it('says nothing was signed when the branch lookup itself fails', async () => {
    mockBranch(null, { message: 'network down' })
    await expect(run()).rejects.toThrow(/nothing was signed/i)
  })

  it('translates the one-live-closing-per-day index into a sentence with the way out', async () => {
    asMock(idempotentInsert).mockResolvedValue({
      data: null,
      error: { message: 'duplicate key value violates unique constraint "daily_closings_one_live_per_branch_day"' },
    })
    await expect(run()).rejects.toThrow(/already closed for this branch.*[Vv]oid/s)
  })

  it('reads a client_uuid duplicate as the same press twice, not as a second closing', async () => {
    asMock(idempotentInsert).mockResolvedValue({
      data: null,
      error: { message: 'duplicate key value violates unique constraint "daily_closings_client_uuid_key"' },
    })
    await expect(run()).rejects.toThrow(/reached the database twice/i)
  })

  it('translates the variance CHECK', async () => {
    asMock(idempotentInsert).mockResolvedValue({
      data: null,
      error: { message: 'new row violates check constraint "daily_closings_variance_agrees"' },
    })
    await expect(run()).rejects.toThrow(/does not match the counted and expected/i)
  })

  it('translates an RLS refusal into a role sentence', async () => {
    asMock(idempotentInsert).mockResolvedValue({
      data: null,
      error: { message: 'new row violates row-level security policy for table "daily_closings"' },
    })
    await expect(run()).rejects.toThrow(/may not approve a closing/i)
  })

  it('passes an unrecognised database error through rather than swallowing it', async () => {
    asMock(idempotentInsert).mockResolvedValue({ data: null, error: { message: 'some novel failure' } })
    await expect(run()).rejects.toThrow(/some novel failure/)
  })

  it('refuses to call the day signed when no server row came back', async () => {
    /* The offline branch of idempotentInsert echoes the payload, which has no
       server id. Treating that as success would show "signed" for a closing
       that does not exist. */
    asMock(idempotentInsert).mockResolvedValue({ data: { business_date: '2026-09-01' }, error: null })
    await expect(run()).rejects.toThrow(/NOT signed off/)
  })
})
