import { useEffect, useState } from 'react'

// Helper to detect first run and set a flag
export function useFirstRun(): { firstRun: boolean; setFirstRun: (value: boolean) => void } {
  const [firstRun, setFirstRun] = useState(true)

  useEffect(() => {
    const stored = localStorage.getItem('babin-first-run')
    if (stored === 'true') {
      setFirstRun(false)
    } else {
      // Mark as not first run after this effect
      localStorage.setItem('babin-first-run', 'true')
      setFirstRun(true) // Will be false on next mount
    }
  }, [])

  return { firstRun, setFirstRun }
}

// Onboarding step type
export interface OnboardingStep {
  id: string
  title: string
  description: string
  cta?: string
  onCTA?: () => void
}

const DEFAULT_STEPS: OnboardingStep[] = [
  {
    id: 'step1',
    title: 'Welcome to Babin Rentals OS',
    description: 'Manage equipment rentals, track inventory, and handle crew scheduling all in one place.',
  },
  {
    id: 'step2',
    title: 'Create Your First Rental',
    description: 'Start by adding a client, selecting equipment, and setting the rental dates.',
    cta: 'Start Now',
  },
  {
    id: 'step3',
    title: 'Set Delivery & Terms',
    description: 'Configure delivery type, pricing, and payment terms for your rental.',
  },
  {
    id: 'step4',
    title: 'You\'re All Set!',
    description: 'Begin renting equipment and managing your inventory. All data is saved to the cloud.',
  },
]

// Onboarding hook
export function useOnboarding(onComplete: () => void) {
  const { firstRun } = useFirstRun()
  const [currentStep, setCurrentStep] = useState(1)
  const [steps, setSteps] = useState<OnboardingStep[]>([])

  useEffect(() => {
    if (firstRun) {
      setSteps(DEFAULT_STEPS.map((s) => s.id === 'step2' ? { ...s, onCTA: () => setCurrentStep(3) } : s))
    }
  }, [firstRun])

  const completeOnboarding = () => {
    localStorage.setItem('babin-first-run', 'true')
    setCurrentStep(steps.length + 1)
    onComplete()
  }

  return {
    firstRun,
    currentStep,
    steps,
    completeOnboarding,
    isComplete: currentStep > steps.length,
  }
}
</file>

<file path="src/lib/useNewRentalProgress.ts">
import { useCallback, useState, useRef } from 'react'

/**
 * Tracks which sections of the New Rental form have been visited.
 * 
 * §2/§3/§19 — sections are NOT a wizard (no Previous/Next), but we can still
 * provide a progress overview so the operator always knows where they are
 * in the 6-section workflow: Client → Dates → Equipment → Crew → Delivery → Terms.
 */
export interface SectionProgress {
  id: string
  title: string
  visited: boolean
  completed: boolean
}

/**
 * Returns section progress state and refs for tracking section visits.
 * 
 * @param sectionTitles - The section titles in order (matching NewRental.SECTIONS)
 * @param onChange - Optional callback when progress updates
 */
export function useNewRentalProgress(
  sectionTitles: readonly string[],
  onChange?: (progress: SectionProgress[]) => void
) {
  // Initialize progress: all sections start as unvisited
  const [progress, setProgress] = useState<SectionProgress[]>(() =>
    sectionTitles.map(title => ({
      id: `section-${sectionTitles.indexOf(title)}`,
      title,
      visited: false,
      completed: false,
    }))
  )

  const sectionRefs = useRef<Map<string, HTMLDivElement>>(new Map())

  const handleToggle = useCallback((sectionIndex: number) => {
    setProgress(prev => {
      const updated = [...prev]
      const target = updated[sectionIndex]
      if (target) {
        updated[sectionIndex] = {
          ...target,
          visited: true,
          completed: !target.completed,
        }
      }
      onChange?.(updated)
      return updated
    })
  }, [onChange])

  return { progress, sectionRefs, handleToggle }
}
