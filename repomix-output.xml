  gap: 6px;
}
.app-global-header__phone-search { width: 44px; min-width: 44px; display: inline-flex; align-items: center; justify-content: center; }
/* In tight tablet layouts, defer secondary verbs to the existing overflow. */
@media (max-width: 1279px) {
  .app-global-header__action-slot--add { min-width: 106px; }
  .app-global-header__action-slot--primary { width: auto; min-width: 44px; max-width: 160px; flex-basis: auto; }
}
@media (max-width: 767px) {
  .app-global-header__action-slot--filters,
  .app-global-header__action-slot--more,
  .app-global-header__action-slot--add { width: 44px; flex-basis: 44px; }
  .app-global-header__action-slot--primary { width: auto; min-width: 44px; max-width: 110px; flex-basis: auto; }
  /* A registry Add trigger may still contain label text on phone; icon remains. */
  .app-global-header__action-slot--add button {
    width: 44px;
    max-width: 44px;
    min-width: 44px;
    justify-content: center;
    padding: 0 !important;
    overflow: hidden;
  }
  .app-global-header__action-slot--add button span { display: none; }
  /* Unused slots consume no phone space; live slots retain canonical ordering. */
  .app-global-header__action-slot:not(:has(button, a)) { display: none; }
  .app-global-header__action-slot--primary { overflow: hidden; }
  .app-global-header__action-slot--primary button,
  .app-global-header__action-slot--primary a {
    min-width: 44px;
    max-width: 110px;
    padding: 0 10px !important;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
}

/* RULING 2026-10-15: the filter toggle sits in the left zone of the header; that zone always keeps room for it.
   On tablet and desktop, maintain at least 140px so module and booking titles are not crushed to 0px. */
.app-global-header__breadcrumbs { min-width: 140px; }
@media (max-width: 767px) {
  .app-global-header__breadcrumbs { min-width: 52px; }
}
.app-global-header__breadcrumbs .workspace-page-actions { flex-shrink: 0; }
