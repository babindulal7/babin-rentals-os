  }
  return {
    listInvoices: async () => ({ rows: [INVOICE], total: null }),
    listPayments: async () => ({ rows: [PAYMENT], total: null }),
    invoicesForBooking: (bookingId: string) => ({ chips: { booking_id: [bookingId] } }),
    paymentsForBooking: (bookingId: string) => ({ chips: { booking_id: [bookingId] } }),
  }
})

window.matchMedia = ((q: string) => ({
  matches: false,
  media: q,
  onchange: null,
  addEventListener: () => {},
  removeEventListener: () => {},
  addListener: () => {},
  removeListener: () => {},
  dispatchEvent: () => false,
})) as unknown as typeof window.matchMedia
;(globalThis as Record<string, unknown>)['IS_REACT_ACT_ENVIRONMENT'] = true

const { default: BookingDetail } = await import('../BookingDetail')

let container: HTMLDivElement
let root: Root

async function mount(width: number, as = 'Owner') {
  role = as
  Object.defineProperty(window, 'innerWidth', { value: width, configurable: true, writable: true })
  container = document.createElement('div')
  document.body.appendChild(container)
  root = createRoot(container)
  await act(async () => {
    root.render(
      <MemoryRouter initialEntries={['/rentals/B-715']}>
        <ToastProvider>
          <Routes>
            <Route path="/rentals/:bookingNo" element={<BookingDetail />} />
          </Routes>
        </ToastProvider>
      </MemoryRouter>,
    )
  })
  // The reads are CHAINED: the head row must land before the invoice/payment
  // fetch effects even fire (they key on the booking's uuid). Each flush lets
  // one round of promise → setState → effect settle.
  for (let i = 0; i < 4; i++) {
    await act(async () => {
      await Promise.resolve()
    })
  }
}

afterEach(async () => {
  if (root) await act(async () => root.unmount())
  container?.remove()
  role = 'Owner'
})

const text = () => container.textContent ?? ''
const allButtons = () => [...container.querySelectorAll('button')]
const button = (label: string) => allButtons().find((b) => b.textContent?.trim() === label)

/** §4.2's bottom bar — bottom-anchored sticky; every sticky rail is top-anchored. */
const stickyBars = () =>
  [...container.querySelectorAll('div')].filter((d) => d.style.position === 'sticky' && d.style.bottom !== '')

describe('§4.2 — the six-step stepper, from the QUERIED stage', () => {
  it('names all six canonical stages, in order, as a real list', async () => {
    await mount(1280)
    const steps = container.querySelector('ol[aria-label="Booking stages"]')
    expect(steps).not.toBeNull()
    const labels = [...(steps?.querySelectorAll('li') ?? [])].map((li) =>
      (li.firstElementChild?.nextElementSibling?.textContent ?? '').trim(),
    )
    expect(labels).toEqual(['Quote', 'Booked', 'Packed', 'On Rent', 'Returned', 'Closed'])
  })

  it('marks exactly one step as current, and it is the booking’s own stage', async () => {
    await mount(1280)
    const current = [...container.querySelectorAll('li[aria-current="step"]')]
    expect(current).toHaveLength(1)
    expect(current[0]?.textContent).toContain('Booked')
  })

  it('carries an icon in every node, so the fill is never the only signal (Law 11)', async () => {
    await mount(1280)
    const nodes = [...container.querySelectorAll('ol[aria-label="Booking stages"] li svg')]
    expect(nodes).toHaveLength(6)
  })

  it('becomes the dot row on phone, with the position stated in words', async () => {
    await mount(420)
    expect(container.querySelector('ol[aria-label="Booking stages"]')).toBeNull()
    expect(text()).toContain('Step 2 of 6 — Booked')
  })
})

/* PLAN.md Phase 9, from main's Phase 9 work (ported 13 Oct 2026): the header
   says how old the page is, once BOTH of its reads have landed. */
describe('Phase 9 — the age badge', () => {
  it('reads "Updated Just now" once the booking and its lines have loaded', async () => {
    await mount(1280)
    expect(text()).toContain('Updated Just now')
    expect(text()).not.toContain('No cache')
  })

  // RULING 2026-10-16: on a phone fresh data keeps only the refresh button, so the words
  // stop taking the record title's width; Stale and Offline still say so in words.
  it('on a phone, keeps the refresh button but drops the fresh-data words', async () => {
    await mount(420)
    expect(text()).not.toContain('Updated Just now')
    expect(container.querySelector('button[aria-label="Refresh data"]')).not.toBeNull()
  })
})

describe('§4.2 — the phone segmented control', () => {
  it('is absent above 768, where every section renders at once', async () => {
    await mount(1280)
    expect(container.querySelector('[role="tablist"]')).toBeNull()
    expect(text()).toContain('Client & Schedule')
    expect(text()).toContain('Pricing & Payments')
    expect(text()).toContain('Documents')
  })

  it('offers [Items][Money][Docs] on phone, showing one at a time', async () => {
    await mount(420)
    const tabs = [...(container.querySelector('[role="tablist"]')?.querySelectorAll('[role="tab"]') ?? [])].map((t) =>
      t.textContent?.trim(),
    )
    expect(tabs).toEqual(['Items', 'Money', 'Docs'])
    // Items is the opening segment — witnessed by Block 2's heading, which
    // appears in no other segment.
    expect(text()).toContain('Equipment, Bundles & Services')
    expect(text()).not.toContain('No documents available for this rental yet.')
  })

  it('switches the page when a segment is picked', async () => {
    await mount(420)
    const docs = [...container.querySelectorAll('[role="tab"]')].find((t) => t.textContent?.trim() === 'Docs')
    await act(async () => {
      docs?.dispatchEvent(new MouseEvent('click', { bubbles: true }))
    })
    expect(text()).toContain('No documents available for this rental yet.')
    expect(text()).not.toContain('Equipment, Bundles & Services')
  })
})

describe('audit — payments have one action and no obstructing bottom bar', () => {
  it('has no bar on desktop, where the rail itself is on screen', async () => {
    await mount(1280)
    expect(button('Record Payment')).toBeDefined() // Block 4's own button
    expect(stickyBars()).toHaveLength(0)
  })

  it('keeps the invoice total and one payment action in the body at tablet', async () => {
    await mount(1000)
    const sticky = stickyBars()
    expect(sticky).toHaveLength(0)
    expect(text()).toContain('Rental Total')
    // formatMoney(13,950,600 paisa) — the invoice's own column, not a figure
    // the screen computed.
    expect(text()).toContain('1,39,506')
    expect(allButtons().filter((b) => b.textContent?.trim() === 'Record Payment')).toHaveLength(1)
  })

  it('keeps the phone free of an obstructing payment bar', async () => {
    await mount(420)
    const sticky = stickyBars()
    expect(sticky).toHaveLength(0)
  })
})

describe('Law 6 — money blocks are OMITTED for money-blind roles, not greyed', () => {
  it('renders NOT ONE rupee figure anywhere on the page', async () => {
    await mount(1280, 'Warehouse')
    // Matching the CURRENCY rather than a list of labels is what makes this
    // catch the next leak too — it found three real ones on 12 Aug.
    expect(text()).not.toMatch(/Rs\s?[\d,]/)
  })

  it('drops the whole Pricing & Payments block, omitted rather than greyed', async () => {
    await mount(1280, 'Warehouse')
    expect(text()).not.toContain('Pricing & Payments')
    // 'Rental Total' lives only inside money surfaces. ('Outstanding' alone is
    // not asserted — the unconditional FooterNote states Law 5 in words for
    // every role, which is a sentence, not a figure.)
    expect(text()).not.toContain('Rental Total')
    expect(button('Record Payment')).toBeUndefined()
    expect(button('Receive Payment')).toBeUndefined()
  })

  it('drops the Money SEGMENT on phone, rather than offering an empty tab', async () => {
    await mount(420, 'Warehouse')
    const tabs = [...container.querySelectorAll('[role="tab"]')].map((t) => t.textContent?.trim())
    expect(tabs).toEqual(['Items', 'Docs'])
  })

  it('drops the sticky bar entirely below 1280 — every part of it is money', async () => {
    await mount(1000, 'Warehouse')
    expect(stickyBars()).toHaveLength(0)
  })

  it('still shows the stepper and the item list, which are not money', async () => {
    await mount(1280, 'Warehouse')
    expect(container.querySelector('ol[aria-label="Booking stages"]')).not.toBeNull()
    expect(text()).toContain('Equipment, Bundles & Services')
    expect(text()).toContain('Sony FX3')
  })
})

describe('Law 5 — the deposit is a liability and says so where it could be misread', () => {
  it('states it beside the deposit ledger', async () => {
    await mount(1280)
    expect(text()).toContain('never reduces Outstanding')
  })
})

describe('Law 16 — unwired surfaces do not invent booking data', () => {
  it('keeps only the activity gap and never invents an alert', async () => {
    await mount(1280)
    expect(text()).toContain('No activity recorded yet.')
    // And none of the seed's invented content survives.
    expect(text()).not.toContain('only 2 left this week')
    expect(text()).not.toContain('Draft created')
  })
})

describe('§4.2 header — [Operations ▾] and [⋮], with dead controls removed', () => {
  it('keeps Operations as its own control', async () => {
    await mount(1280)
    // RULING 2026-10-15: the 44px icon at every width; its accessible name is still "Operations".
    expect(allButtons().find((b) => b.getAttribute('aria-label') === 'Operations')).toBeDefined()
  })

  it('moves Extend, Assign Crew and Sub-Rental into the overflow rather than dropping them', async () => {
    await mount(1280)
    const more = allButtons().find((b) => b.getAttribute('aria-label') === 'More booking actions')
    expect(more).toBeDefined()
    expect(more?.getAttribute('aria-expanded')).toBe('false')

    await act(async () => {
      more?.dispatchEvent(new MouseEvent('click', { bubbles: true }))
    })
    const items = [...document.querySelectorAll('[role="menuitem"]')].map((i) => i.textContent?.trim())
    /* All remaining rows lead to a real action. The former Save draft entry
       had no persistence path and was removed rather than masquerading as a
       disabled action. RULING 2026-10-15: the booking's own rows lead the one
       More, ahead of the rental groups; its Cancel is the rental group's. */
    expect(items.slice(0, 5)).toEqual([
      'Print booking',
      'Message client',
      'Extend rental',
      'Assign crew',
      'Create sub-rental',
    ])
    expect(items).toContain('Cancel Rental')
    expect(items).not.toContain('Cancel booking')
    expect(items).not.toContain('Save draft')
  })
})

/*
 * RULING 2026-10-15 (Booking Detail header): the header holds the title, the
 * search and ONE primary. Operations stays as the booking's floor door, and
 * every other control lives in ONE More. The old desktop cluster (stage badge,
 * WhatsApp, More ▾, Operations ▾, Print booking and a second ⋮) was 610px and
 * squeezed "902 · Annapurna Media Pvt. Ltd." to 37px at 1280 with the sidebar
 * open. This suite fails on that cluster.
 */
describe('15 Oct header rule — the stage action, Operations and ONE More, at every width', () => {
  /** What a screen reader announces for each header control, in order. */
  const headerControls = () =>
    [...(container.querySelector('.page-actions')?.querySelectorAll('button') ?? [])].map(
      (b) => b.getAttribute('aria-label') ?? b.textContent?.trim() ?? '',
    )

  for (const width of [420, 1024, 1280, 1440]) {
    it(`renders exactly Operations, More and the stage action at ${width}px`, async () => {
      await mount(width)
      expect(headerControls()).toEqual(['Operations', 'More booking actions', 'Start Packing'])
    })
  }

  it('leaves the stage to the stepper rather than repeating it as a header badge', async () => {
    await mount(1280)
    expect(container.querySelector('.page-actions')?.textContent?.toLowerCase()).not.toContain('booked')
    expect(container.querySelector('li[aria-current="step"]')?.textContent).toContain('Booked')
  })

  it('keeps every moved action one menu away, with one Cancel', async () => {
    await mount(1280)
    const more = allButtons().find((b) => b.getAttribute('aria-label') === 'More booking actions')
    await act(async () => {
      more?.dispatchEvent(new MouseEvent('click', { bubbles: true }))
    })
    const items = [...document.querySelectorAll('[role="menuitem"]')].map((i) => i.textContent?.trim() ?? '')
    for (const label of ['Print booking', 'Message client', 'Extend rental', 'Assign crew', 'Create sub-rental']) {
      expect(items, `${label} should be in More`).toContain(label)
    }
    expect(items.filter((i) => i.startsWith('Cancel'))).toEqual(['Cancel Rental'])
  })
})

/*
 * RULING 2026-10-16 (phone header): at 375px the header held back 44, the title, Operations 44,
 * More 44, the stage action, Search 44 and the avatar 44. "Receive Overdue Return" (182px)
 * overflowed it by 37px and left the title 0px. On a phone the stage action is an icon over one
 * word (its full name stays the accessible name and tooltip), and Search moves into the More.
 * Measured in the mock at 375 and 390; jsdom has no layout, so this pins the structure.
 */
describe('16 Oct phone header — a one-word stage action and Search in the More', () => {
  const stageAction = () =>
    [...(container.querySelector('.page-actions')?.querySelectorAll('button') ?? [])].find(
      (b) => (b.getAttribute('aria-label') ?? b.textContent?.trim()) === 'Start Packing',
    )
  const openMore = async () => {
    const more = allButtons().find((b) => b.getAttribute('aria-label') === 'More booking actions')
    await act(async () => {
      more?.dispatchEvent(new MouseEvent('click', { bubbles: true }))
    })
    return [...document.querySelectorAll('[role="menuitem"]')]
  }

  for (const width of [375, 390]) {
    it(`shows the stage action as one word, still named in full, at ${width}px`, async () => {
      await mount(width)
      const action = stageAction()
      expect(action).toBeDefined()
      expect(action?.querySelector('.ui-button__label')?.textContent).toBe('Pack')
      expect(action?.getAttribute('title')).toBe('Start Packing')
      // Law 15: the stacked form keeps the 44px floor.
      expect(action?.style.minHeight).toBe('44px')
    })

    it(`puts Search in the More, where it opens the command palette, at ${width}px`, async () => {
      await mount(width)
      const opened = vi.fn()
      window.addEventListener('open-command-palette', opened)
      const search = (await openMore()).find((i) => i.textContent?.trim() === 'Search')
      expect(search).toBeDefined()
      await act(async () => {
        search?.dispatchEvent(new MouseEvent('click', { bubbles: true }))
      })
      window.removeEventListener('open-command-palette', opened)
      expect(opened).toHaveBeenCalledTimes(1)
    })
  }

  for (const width of [768, 1280]) {
    it(`keeps the full label and no Search row at ${width}px`, async () => {
      await mount(width)
      expect(stageAction()?.textContent?.trim()).toBe('Start Packing')
      expect(stageAction()?.hasAttribute('aria-label')).toBe(false)
      const items = (await openMore()).map((i) => i.textContent?.trim())
      expect(items).not.toContain('Search')
    })
  }
})

/**
 * Law 17 on the READ path — PLAN.md §6.1, "the word customer appears nowhere
 * in the UI".
 *
 * The mocked booking above already carries the real stored value,
 * `deliveryType: 'Customer Pickup'` — that is the `delivery_type` enum member
 * (`0001_enums.sql:34`), and **all 246 live bookings carry it**. The write path
 * mapped label → enum from the start (`createRental.ts:100`); the inverse was
 * never written, so the raw enum rendered straight into the DOM here.
 *
 * This asserts the rendered text, which is the only thing Law 17 governs. The
 * three older Law-17 tests assert over static label constants and structurally
 * cannot catch a value that arrives from the database.
 */
describe('Law 17 — a stored delivery type never reaches the DOM raw', () => {
  it('renders "Client Pickup" for the stored delivery type', async () => {
    await mount(1440)
    expect(text()).toContain('Client Pickup')
  })

  it('never renders the banned word, at any width', async () => {
    for (const width of [390, 1024, 1440]) {
      await mount(width)
      expect(text().toLowerCase()).not.toContain('customer')
    }
  })
})
</file>

