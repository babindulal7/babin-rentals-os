  /** What the operator proposes to charge. */
  chargePaisa: Paisa
  /** The deposit held against the booking, for the settlement line. */
  depositPaisa: Paisa
  state: DamageState
  raisedBy: string
  raisedAtAd: string
  approvedBy?: string | undefined
}

