<file path="src/modules/rentals/booking/CrewSection.tsx">
import { Fragment, useState } from 'react'
import { Link } from 'react-router-dom'
import Icon from '../../../components/ui/Icon'
import { Button, Input } from '../../../components/ui'
import { DataTableShell } from '../../../components/ui/DataTable'
import { EmptyState } from '../../../components/ui/StateViews'
import { Field, Section, TouchInset, inputStyle } from './BookingFormWidgets'
import { formatMoney, rupees, type Paisa } from '../../../lib/money'
import { crewPool, type CrewMember, type CrewRole } from '../../../lib/queries/crew'
import { CrewSearch } from './CrewSearch'

export interface CrewLine {
  crewId: string
  bookingCrewLineId?: string | undefined
  crewMemberId?: string | undefined
  days?: number | undefined
  name: string
  role: CrewRole
  phone: string
  dayRatePaisa: Paisa
  overtimePaisa: Paisa
  accommodationPaisa: Paisa
  mealsPaisa: Paisa
}

const th = {
  textAlign: 'left' as const,
  padding: '7px 9px',
  fontSize: 'var(--t-th)',
  fontWeight: 700,
  color: 'var(--text2)',
  letterSpacing: '0.03em',
  textTransform: 'uppercase' as const,
  whiteSpace: 'nowrap' as const,
  borderBottom: '1px solid var(--border)',
}

const td = {
  height: 'var(--row-min-h)',
  padding: '7px 9px',
  fontSize: 'var(--t-meta)',
  color: 'var(--text)',
  whiteSpace: 'nowrap' as const,
}

export interface CrewSectionProps {
  open: boolean
  onToggle: () => void
  crew: CrewLine[]
  days: number
  canCrewMoney: boolean
  liveCrew?: readonly CrewMember[] | null | undefined
  onAddCrew: (crewId: string) => void
  onRemoveCrew: (crewId: string) => void
  onClearCrew: () => void
  onUpdateCrewExtras: (
    crewId: string,
    field: 'overtimePaisa' | 'accommodationPaisa' | 'mealsPaisa',
    paisa: Paisa,
  ) => void
  crewChargesPaisa: Paisa
  isPhone: boolean
  title?: string
}

export function CrewSection({
  open,
  onToggle,
  crew,
  days,
  canCrewMoney,
  liveCrew,
  onAddCrew,
  onRemoveCrew,
  onClearCrew,
  onUpdateCrewExtras,
  crewChargesPaisa,
  isPhone,
  title = 'Crew',
}: CrewSectionProps) {
  const [expandedCrew, setExpandedCrew] = useState<Set<string>>(new Set())

  const toggleCrewExpanded = (crewId: string) => {
    setExpandedCrew((prev) => {
      const next = new Set(prev)
      if (next.has(crewId)) {
        next.delete(crewId)
      } else {
        next.add(crewId)
      }
      return next
    })
  }

  return (
    <Section
      id="section-3"
      title={title}
      badge={
        crew.length > 0 ? (
          <span
            style={{
              display: 'inline-flex',
              alignItems: 'center',
              gap: 4,
              padding: '2px 8px',
              borderRadius: 'var(--r-badge)',
              background: 'var(--st-primary-bg)',
              color: 'var(--st-primary-fg)',
              fontSize: 11,
              fontWeight: 600,
            }}
          >
            {crew.length} {crew.length === 1 ? 'member' : 'members'}
          </span>
        ) : null
      }
      open={open}
      onToggle={onToggle}
      summary={crew.length === 0 ? 'Optional / None' : `${crew.length} crew`}
    >
      <div>
        {(!liveCrew || liveCrew.length === 0) && (
          <p style={{ margin: '0 0 var(--sp-sm)', fontSize: 'var(--t-meta)', color: 'var(--warn-text)', lineHeight: 1.5 }}>
            This is a <strong>sample roster</strong> — the people and the day rates they are priced at are invented in
            the app, not read from the database. Adding someone puts their name, role and rate on this booking when it
            is confirmed; it does not link a staff record, and it reserves nobody, because booking a crew member's own
            calendar is not built yet.
          </p>
        )}
        <CrewSearch
          onBooking={crew}
          onAdd={onAddCrew}
          showRates={canCrewMoney}
          roster={crewPool(liveCrew)}
        />
        <div style={{ minWidth: 0 }}>
          <DataTableShell ariaLabel="Assigned crew">
            <table style={{ width: '100%', borderCollapse: 'collapse', minWidth: 500 }}>
              <thead>
                <tr style={{ background: 'var(--th-bg)' }}>
                  {(canCrewMoney
                    ? ['Name', 'Role', 'Day Rate', 'Days', 'Amount', '', '']
                    : ['Name', 'Role', '']
                  ).map((h, i) => (
                    <th
                      key={h === '' ? `blank-${i}` : h}
                      scope="col"
                      style={{ ...th, textAlign: i >= 2 && i <= 4 ? 'right' : 'left' }}
                    >
                      {h}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {crew.map((c) => {
                  const expanded = expandedCrew.has(c.crewId)
                  const hasExtras = c.overtimePaisa > 0 || c.mealsPaisa > 0 || c.accommodationPaisa > 0
                  return (
                    <Fragment key={c.crewId}>
                      <tr style={{ borderBottom: expanded ? 'none' : '1px solid var(--border)' }}>
                        <td style={{ ...td, fontWeight: 600 }}>
                          <Link
                            to={`/crew`}
                            style={{ color: 'inherit', textDecoration: 'none' }}
                            title={`Open ${c.name} in Crew Assist`}
                          >
                            {c.name}
                          </Link>
                        </td>
                        <td style={{ ...td, color: 'var(--text2)' }}>{c.role}</td>
                        {canCrewMoney && (
                          <>
                            <td className="figure" style={{ ...td, textAlign: 'right', color: 'var(--text2)' }}>
                              {formatMoney(c.dayRatePaisa)}
                            </td>
                            <td className="figure" style={{ ...td, textAlign: 'right' }}>
                              {c.days ?? days}
                            </td>
                            <td className="figure" style={{ ...td, textAlign: 'right', fontWeight: 700 }}>
                              {formatMoney(
                                (c.dayRatePaisa * (c.days ?? days) +
                                  c.overtimePaisa +
                                  c.accommodationPaisa +
                                  c.mealsPaisa) as Paisa,
                              )}
                            </td>
                            <td style={{ ...td, width: 30, textAlign: 'right' }}>
                              <button
                                type="button"
                                className="press"
                                aria-label={`${expanded ? 'Hide' : 'Show'} overtime, meals and accommodation for ${c.name}`}
                                aria-expanded={expanded}
                                onClick={() => toggleCrewExpanded(c.crewId)}
                                style={{
                                  position: 'relative',
                                  width: 22,
                                  height: 22,
                                  display: 'grid',
                                  placeItems: 'center',
                                  borderRadius: 'var(--r-xs)',
                                  border: 'none',
                                  background: hasExtras ? 'var(--st-primary-bg)' : 'transparent',
                                  color: hasExtras ? 'var(--st-primary-fg)' : expanded ? 'var(--text)' : 'var(--muted)',
                                  cursor: 'pointer',
                                }}
                              >
                                <TouchInset />
                                <Icon name={expanded ? 'chevron_up' : 'chevron_down'} size={13} />
                              </button>
                            </td>
                          </>
                        )}
                        <td style={{ ...td, width: 30, textAlign: 'right' }}>
                          <button
                            type="button"
                            className="press"
                            aria-label={`Remove ${c.name} from this booking`}
                            title={`Remove ${c.name}`}
                            onClick={() => onRemoveCrew(c.crewId)}
                            style={{
                              position: 'relative',
                              width: 22,
                              height: 22,
                              display: 'grid',
                              placeItems: 'center',
                              borderRadius: 'var(--r-xs)',
                              border: 'none',
                              background: 'transparent',
                              color: 'var(--muted)',
                              cursor: 'pointer',
                            }}
                          >
                            <TouchInset />
                            <Icon name="close" size={13} />
                          </button>
                        </td>
                      </tr>
                      {canCrewMoney && expanded && (
                        <tr style={{ borderBottom: '1px solid var(--border)' }}>
                          <td colSpan={7} style={{ ...td, background: 'var(--card2)', padding: '10px 12px' }}>
                            <div
                              style={{
                                display: 'grid',
                                gridTemplateColumns: isPhone ? '1fr' : 'repeat(3, minmax(0, 180px))',
                                gap: 12,
                                alignItems: 'center',
                              }}
                            >
                              <Field label="Overtime (Rs) *">
                                <Input
                                  type="number"
                                  min={0}
                                  value={c.overtimePaisa > 0 ? c.overtimePaisa / 100 : ''}
                                  placeholder="0"
                                  onChange={(e) =>
                                    onUpdateCrewExtras(
                                      c.crewId,
                                      'overtimePaisa',
                                      rupees(Math.max(0, Number(e.target.value) || 0)),
                                    )
                                  }
                                  style={{ ...inputStyle, minHeight: 44, fontSize: 'var(--t-meta)' }}
                                />
                              </Field>
                              <Field label="Meals (Rs) *">
                                <Input
                                  type="number"
                                  min={0}
                                  value={c.mealsPaisa > 0 ? c.mealsPaisa / 100 : ''}
                                  placeholder="0"
                                  onChange={(e) =>
                                    onUpdateCrewExtras(
                                      c.crewId,
                                      'mealsPaisa',
                                      rupees(Math.max(0, Number(e.target.value) || 0)),
                                    )
                                  }
                                  style={{ ...inputStyle, minHeight: 44, fontSize: 'var(--t-meta)' }}
                                />
                              </Field>
                              <Field label="Accommodation (Rs) *">
                                <Input
                                  type="number"
                                  min={0}
                                  value={c.accommodationPaisa > 0 ? c.accommodationPaisa / 100 : ''}
                                  placeholder="0"
                                  onChange={(e) =>
                                    onUpdateCrewExtras(
                                      c.crewId,
                                      'accommodationPaisa',
                                      rupees(Math.max(0, Number(e.target.value) || 0)),
                                    )
                                  }
                                  style={{ ...inputStyle, minHeight: 44, fontSize: 'var(--t-meta)' }}
                                />
                              </Field>
                            </div>
                          </td>
                        </tr>
                      )}
                    </Fragment>
                  )
                })}
                {canCrewMoney && (
                  <tr>
                    <td colSpan={4} style={{ ...td, fontWeight: 700, color: 'var(--text2)' }}>
                      Crew Subtotal
                    </td>
                    <td className="figure" style={{ ...td, textAlign: 'right', fontWeight: 700 }}>
                      {formatMoney(crewChargesPaisa)}
                    </td>
                    <td style={td} />
                    <td style={td} />
                  </tr>
                )}
              </tbody>
            </table>
          </DataTableShell>
          {crew.length === 0 && (
            <div style={{ marginTop: 10 }}>
              <EmptyState title="No crew assigned" description="Add a crew member to staff this booking." />
            </div>
          )}
          {crew.length > 0 && (
            <div style={{ marginTop: 9 }}>
              <Button onClick={onClearCrew}>Clear crew</Button>
            </div>
          )}
        </div>
      </div>
    </Section>
  )
}
</file>

<file path="src/modules/rentals/booking/DateTimeField.tsx">
import { useEffect, useLayoutEffect, useRef, useState } from 'react'
import { createPortal } from 'react-dom'
import Icon from '../../../components/ui/Icon'
import { TouchTarget } from '../../../components/ui/TouchTarget'
import { floatingLayer } from '../../../components/ui/floatingLayer'
import {
  CalendarPopover,
  TimeListPopover,
  displayDate,
  parseDateInput,
  parseTimeInput,
} from '../../../components/ui/DateField'
import { toBs, formatBs } from '../../../lib/bs'

/**
 * redesign v1 §4 — typeable date + time, two separate 44×44 icon buttons,
 * BS rendered above the AD value, default time never blank. The rental day
 * runs 06:00→06:00 (Foundation), so a booking with no time cannot be priced
 * correctly at the boundary — this replaced the bare `<input type="date">`
 * NewRental used before, which had no time component at all.
 *
 * ## The calendar moved out, 4 Sep 2026
 *
 * The month grid, the time list and the date/time parsers used to live in this
 * file, which meant the app's only real date picker was reachable from exactly
 * one screen while 24 other date inputs across 13 files fell back to the
 * browser's native control — and a native control cannot render a BS date at
 * all (Law 9 §9.4).
 *
 * They now live in `components/ui/DateField`, and this file composes them.
 * Nothing about the rendered field changed; the parsers are re-exported below
 * because `booking/index.ts` publishes them and tests import them from here.
 */

export { parseDateInput, parseTimeInput }

// RULING 2026-10-08: the wider setup row gives each date/time picker a full 44px target.
const iconBtnStyle = {
  position: 'relative' as const,
  flexShrink: 0,
  width: 44,
  height: 44,
  display: 'grid',
  placeItems: 'center',
  borderRadius: 'var(--r-xs)',
  border: 'none',
  background: 'transparent',
  color: 'var(--text2)',
  cursor: 'pointer',
}

export interface DateTimeFieldProps {
  label: string
  required?: boolean
  /** 'YYYY-MM-DD' */
  dateValue: string
  /** 'HH:mm' — never blank; callers seed a default (09:00 pickup / 18:00 return per redesign v1 §4). */
  timeValue: string
  onDateChange: (v: string) => void
  onTimeChange: (v: string) => void
  error?: string | undefined
}

export function DateTimeField({ label, required = false, dateValue, timeValue, onDateChange, onTimeChange, error }: DateTimeFieldProps) {
  const [dateText, setDateText] = useState(() => displayDate(dateValue))
  const [timeText, setTimeText] = useState(timeValue)
  const [calendarOpen, setCalendarOpen] = useState(false)
  const [timeListOpen, setTimeListOpen] = useState(false)
  const rootRef = useRef<HTMLDivElement | null>(null)
  const panelRef = useRef<HTMLDivElement | null>(null)
  const panelAdjusted = useRef(false)
  /* Floating position of the portaled popups. The New Rental sections clip
     overflow (`new-rental-section-card`), so inline absolute popups get cut —
     the portal wrapper is a viewport-positioned box matching the field, and
     the inner absolute panels resolve against it. */
  const [panelPos, setPanelPos] = useState<{ top: number; left: number; width: number } | null>(null)

  const measurePanel = () => {
    const el = rootRef.current
    if (!el) return
    panelAdjusted.current = false
    const r = el.getBoundingClientRect()
    const panelW = Math.min(360, window.innerWidth - 24)
    setPanelPos({
      top: r.bottom,
      left: Math.min(Math.max(8, r.left), Math.max(8, window.innerWidth - panelW - 8)),
      width: Math.max(r.width, 120),
    })
  }

  useEffect(() => {
    if (!calendarOpen && !timeListOpen) {
      panelAdjusted.current = false
      return
    }
    measurePanel()
    window.addEventListener('scroll', measurePanel, true)
    window.addEventListener('resize', measurePanel)
    return () => {
      window.removeEventListener('scroll', measurePanel, true)
      window.removeEventListener('resize', measurePanel)
    }
  }, [calendarOpen, timeListOpen])

  /* Pull up when the panel would run past the viewport bottom. */
  useLayoutEffect(() => {
    if ((!calendarOpen && !timeListOpen) || !panelPos || panelAdjusted.current) return
    const panel = panelRef.current?.firstElementChild as HTMLElement | null
    if (!panel) return
    const overflow = panel.getBoundingClientRect().bottom - window.innerHeight + 8
    if (overflow > 0) {
      panelAdjusted.current = true
      setPanelPos((p) => (p ? { ...p, top: Math.max(8, p.top - overflow) } : p))
    }
  }, [calendarOpen, timeListOpen, panelPos])

  useEffect(() => setDateText(displayDate(dateValue)), [dateValue])
  useEffect(() => setTimeText(timeValue), [timeValue])

  useEffect(() => {
    if (!calendarOpen && !timeListOpen) return
    const onDown = (e: MouseEvent) => {
      const target = e.target as Node | null
      // Popups are portaled to document.body — a pointer inside them is
      // logically inside, even though outside `rootRef` in the DOM.
      if (panelRef.current?.contains(target)) return
      if (!rootRef.current?.contains(target)) {
        setCalendarOpen(false)
        setTimeListOpen(false)
      }
    }
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        setCalendarOpen(false)
        setTimeListOpen(false)
      }
    }
    document.addEventListener('mousedown', onDown)
    window.addEventListener('keydown', onKey)
    return () => {
      document.removeEventListener('mousedown', onDown)
      window.removeEventListener('keydown', onKey)
    }
  }, [calendarOpen, timeListOpen])

  const adDate = Number.isNaN(Date.parse(dateValue)) ? null : new Date(dateValue)
  const bs = adDate ? toBs(adDate) : null

  const commitDate = (text: string) => {
    const parsed = parseDateInput(text)
    if (parsed) onDateChange(parsed)
    else setDateText(displayDate(dateValue))
  }
  // Never blank — an unparseable time reverts to the last good value rather
  // than silently becoming midnight (redesign v1 §4).
  const commitTime = (text: string) => {
    const parsed = parseTimeInput(text) ?? timeValue
    onTimeChange(parsed)
    setTimeText(parsed)
  }

  return (
    <div ref={rootRef} style={{ position: 'relative', minWidth: 0 }}>
      <span style={{ display: 'block', fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--muted)', marginBottom: 3 }}>{label}{required ? ' *' : ''}</span>
      {/* 01_NEW_RENTAL §1.1 DATES box — "BS above AD on both". The wireframe and
          Foundation §3.2's "BS leads AD" put it first, so it sits above the
          input rather than under it. `lib/bs.ts` is the one Date Engine: nothing
          here computes a BS date, and outside the month that engine vouches for
          it says so instead of rendering a plausible one. */}
      <div
        className="figure"
        style={{ marginBottom: 3, fontSize: 'var(--t-th)', fontWeight: 700, color: bs ? 'var(--booking-date-text)' : 'var(--muted)' }}
      >
        {bs ? formatBs(bs) : 'BS not available for this date'}
      </div>
      <div className="focus-host" style={{ display: 'flex', alignItems: 'center', gap: 0, border: '1px solid var(--input-border)', borderRadius: 'var(--r-input)', background: 'var(--input-bg)', padding: '0 0 0 10px', minHeight: 46 }}>
        <input
          value={dateText}
          onChange={(e) => setDateText(e.target.value)}
          onBlur={(e) => commitDate(e.target.value)}
          onKeyDown={(e) => {
            if (e.key === 'Enter') (e.target as HTMLInputElement).blur()
          }}
          onClick={() => {
            // Tapping the date box opens the calendar — the icon is a second
            // way in, not the only one.
            setTimeListOpen(false)
            setCalendarOpen(true)
          }}
          aria-label={`${label} date`}
          aria-required={required || undefined}
          style={{ flex: '1 1 auto', minWidth: 0, minHeight: 44, border: 'none', background: 'transparent', color: 'var(--booking-date-text)', fontSize: 'var(--t-meta)', fontFamily: 'inherit', outline: 'none' }}
        />
        <button
          type="button"
          className="press"
          aria-label={`Open calendar for ${label}`}
          aria-haspopup="dialog"
          aria-expanded={calendarOpen}
          onClick={() => {
            setCalendarOpen((o) => !o)
            setTimeListOpen(false)
          }}
          style={iconBtnStyle}
        >
          <TouchTarget axis="y" />
          <Icon name="calendar_event" size={15} />
        </button>
        <input
          value={timeText}
          onChange={(e) => setTimeText(e.target.value)}
          onBlur={(e) => commitTime(e.target.value)}
          onKeyDown={(e) => {
            if (e.key === 'Enter') (e.target as HTMLInputElement).blur()
          }}
          aria-label={`${label} time`}
          aria-required={required || undefined}
          style={{ width: 48, minHeight: 44, flexShrink: 0, border: 'none', borderLeft: '1px solid var(--border)', background: 'transparent', color: 'var(--booking-date-text)', fontSize: 'var(--t-meta)', fontFamily: 'inherit', textAlign: 'center', paddingLeft: 4 }}
        />
        <button
          type="button"
          className="press"
          aria-label={`Open time picker for ${label}`}
          aria-haspopup="listbox"
          aria-expanded={timeListOpen}
          onClick={() => {
            setTimeListOpen((o) => !o)
            setCalendarOpen(false)
          }}
          style={iconBtnStyle}
        >
          <TouchTarget axis="y" />
          <Icon name="timer" size={15} />
        </button>
      </div>
      {error && <span role="alert" style={{ display: 'block', fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--danger-text)', marginTop: 3 }}>{error}</span>}

      {(calendarOpen || timeListOpen) && panelPos && createPortal(
        <div ref={panelRef} style={{ position: 'fixed', top: panelPos.top, left: panelPos.left, width: panelPos.width, height: 0, zIndex: floatingLayer(rootRef.current) }}>
          {calendarOpen && (
        <CalendarPopover
          value={dateValue}
          onSelect={(v) => {
            onDateChange(v)
            setCalendarOpen(false)
            // Chained flow: once the day is set, the time list opens on its
            // own so the operator never hunts for the second picker.
            setTimeListOpen(true)
          }}
          onDismiss={() => setCalendarOpen(false)}
        />
          )}
          {timeListOpen && (
        <TimeListPopover
          value={timeValue}
          onSelect={(v) => {
            onTimeChange(v)
            setTimeListOpen(false)
          }}
        />
          )}
        </div>,
        document.body,
      )}
    </div>
  )
}
</file>

<file path="src/modules/rentals/booking/DeliverySection.tsx">
import Icon from '../../../components/ui/Icon'
import { Input, Select } from '../../../components/ui'
import { Field, Section, MoneyRow, inputStyle } from './BookingFormWidgets'
import { formatMoney, rupees, type Paisa } from '../../../lib/money'

const sub = {
  margin: '0 0 8px',
  fontSize: 'var(--t-th)',
  fontWeight: 700,
  color: 'var(--text2)',
  letterSpacing: '0.04em',
  textTransform: 'uppercase',
} as const

const moneyBlock = {
  background: 'var(--card2)',
  borderRadius: 'var(--r-card)',
  padding: 'var(--sp-md)',
