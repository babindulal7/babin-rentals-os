        clientUuid: '55555555-6666-7777-8888-999999999999',
      },
      { userId: '00000000-0000-4000-8000-000000000001', role: 'Owner', isOnline: true },
    )
    expect(closeRes.stage).toBe('Closed')
    expect(closeRes.bookingNo).toBe('BK-2026-0715')
  })
