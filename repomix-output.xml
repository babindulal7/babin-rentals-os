import { IS_MOCK, supabase } from '../supabase'
import type { ListFilters } from './listQuery'
import type { ListQueryResult } from './useList'
import type { Database } from '../../types/supabase'
import type { SystemRole } from '../../types/database'
import {
  DOCUMENTS,
  type DocRow,
  type DocStatus,
  type CategoryKey,
  type CategoryMeta,
  type RelatedKind,
  type SortKey,
  type MissingDoc,
  type ExpiringDoc,
  type QuickAction,
  CATEGORIES,
  ARCHIVED_NOT_RECYCLE_BIN,
  ALL_TAB,
  DOC_STATUSES,
  DOC_STATUS,
  RELATED_TARGET,
  ALL_TYPES,
  ALL_STATUS,
  ALL_RELATED,
  ALL_BRANCHES,
  BRANCHES,
  SORTS,
  PER_PAGE,
  documentsFor,
