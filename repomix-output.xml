import React from 'react'
import Icon, { type IconName } from '../Icon'
import { StatusPill, type StatusTone } from './StatusPill'
import { OverflowMenu, type OverflowMenuItem } from '../OverflowMenu'
import './module-shell.css'

export interface ModuleTableRowData {
  id: string
  code: string
  codePrefix?: string
  entityTitle: React.ReactNode
  entitySubtitle?: React.ReactNode
  contextPrimary: React.ReactNode
  contextSecondary?: React.ReactNode
  statusLabel: string
  statusTone: StatusTone
  statusIcon?: IconName
  metricValue?: React.ReactNode
  metricSub?: React.ReactNode
  primaryAction?: {
    label: string
    onClick: (e: React.MouseEvent) => void
    icon?: IconName
    tone?: 'dominant' | 'prep'
    disabled?: boolean
  }
  overflowActions?: OverflowMenuItem[]
  onClick?: () => void
}

export interface ModuleTableColumnTitles {
  code?: string
  entity?: string
  context?: string
  status?: string
  metric?: string
  actions?: string
}

export interface ModuleTableProps {
  rows: readonly ModuleTableRowData[]
  columnTitles?: ModuleTableColumnTitles
  emptyMessage?: string
  emptySubtitle?: string
  loading?: boolean
  className?: string
  style?: React.CSSProperties
}

/**
 * Zone 4: Standard Data Table
 * Standardized 6-column layout:
 * 1. Code/ID: Monospace badge
 * 2. Primary Entity: Bold title + muted secondary subtitle
 * 3. Context / Dates / Specs: Standardized dates or specs
 * 4. Status: Unified semantic status pill
 * 5. Metric: Right-aligned NPR or quantity figure
 * 6. Actions: Pinned context action button + overflow menu
 */
export const ModuleTable: React.FC<ModuleTableProps> = ({
  rows,
  columnTitles,
  emptyMessage = 'No records found',
  emptySubtitle = 'Try adjusting your filters or search query.',
  loading = false,
  className = '',
  style,
}) => {
  const titles = {
    code: columnTitles?.code || 'ID',
    entity: columnTitles?.entity || 'Primary Entity',
    context: columnTitles?.context || 'Schedule & Context',
    status: columnTitles?.status || 'Status',
    metric: columnTitles?.metric || 'Financial / Metric',
    actions: columnTitles?.actions || 'Actions',
  }

  return (
    <div className={`module-table-container ${className}`.trim()} style={style}>
      <div className="module-table-scroll">
        <table className="module-table">
          <thead>
            <tr>
              <th style={{ width: '130px' }}>{titles.code}</th>
              <th style={{ minWidth: '220px' }}>{titles.entity}</th>
              <th style={{ minWidth: '180px' }}>{titles.context}</th>
              <th style={{ width: '150px' }}>{titles.status}</th>
              <th style={{ width: '160px', textAlign: 'right' }}>{titles.metric}</th>
              <th style={{ width: '170px', textAlign: 'right' }}>{titles.actions}</th>
            </tr>
          </thead>
          <tbody>
            {loading ? (
              <tr>
                <td colSpan={6} style={{ padding: '36px', textAlign: 'center', color: 'var(--muted)' }}>
                  <div style={{ display: 'inline-flex', alignItems: 'center', gap: 8 }}>
                    <Icon name="refresh" size={18} className="spin" />
                    <span>Loading records…</span>
                  </div>
                </td>
              </tr>
            ) : rows.length === 0 ? (
              <tr>
                <td colSpan={6} style={{ padding: '48px 24px', textAlign: 'center' }}>
                  <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 6 }}>
                    <Icon name="search" size={24} style={{ color: 'var(--muted)' }} />
                    <strong style={{ color: 'var(--text)', fontSize: 'var(--t-ui, 14px)' }}>{emptyMessage}</strong>
                    <span style={{ color: 'var(--text2)', fontSize: 'var(--t-meta, 13px)' }}>{emptySubtitle}</span>
                  </div>
                </td>
              </tr>
            ) : (
              rows.map((row) => {
                const isClickable = Boolean(row.onClick)

                const handleRowKeyDown = (e: React.KeyboardEvent<HTMLTableRowElement>) => {
                  const target = e.target as HTMLElement
                  if (target.closest('button, a, input, select')) return
                  if (isClickable && (e.key === 'Enter' || e.key === ' ')) {
                    e.preventDefault()
                    row.onClick?.()
                  }
                }

                return (
                  <tr
                    key={row.id}
                    className={isClickable ? 'is-clickable' : ''}
                    onClick={row.onClick}
                    onKeyDown={isClickable ? handleRowKeyDown : undefined}
                    tabIndex={isClickable ? 0 : undefined}
                  >
                    {/* Col 1: Code / ID */}
                    <td>
                      <span className="module-table__code-badge">
                        {row.codePrefix || ''}{row.code}
                      </span>
                    </td>

                    {/* Col 2: Primary Entity */}
                    <td>
                      <div className="module-table__entity">
                        <div className="module-table__entity-title">{row.entityTitle}</div>
                        {row.entitySubtitle && (
                          <div className="module-table__entity-sub">{row.entitySubtitle}</div>
                        )}
                      </div>
                    </td>

                    {/* Col 3: Context / Dates / Specs */}
                    <td>
                      <div className="module-table__context">
                        <span className="module-table__context-primary">{row.contextPrimary}</span>
                        {row.contextSecondary && (
                          <span className="module-table__context-secondary">{row.contextSecondary}</span>
                        )}
                      </div>
                    </td>

                    {/* Col 4: Unified Status Pill */}
                    <td>
                      <StatusPill
                        label={row.statusLabel}
                        {...(row.statusTone ? { tone: row.statusTone } : {})}
                        {...(row.statusIcon ? { icon: row.statusIcon } : {})}
                      />
                    </td>

                    {/* Col 5: Financial / Metric */}
                    <td className="module-table__metric">
                      <div>{row.metricValue ?? '—'}</div>
                      {row.metricSub && (
                        <div style={{ fontSize: '11px', color: 'var(--muted)', fontWeight: 500 }}>
                          {row.metricSub}
                        </div>
                      )}
                    </td>

                    {/* Col 6: Pinned Row Action + Overflow */}
                    <td>
                      <div className="module-table__actions" onClick={(e) => e.stopPropagation()}>
                        {row.primaryAction && (
                          <button
                            type="button"
                            className={`module-table__row-cta press ${row.primaryAction.tone === 'prep' ? 'module-table__row-cta--prep' : ''}`}
                            onClick={row.primaryAction.onClick}
                            disabled={row.primaryAction.disabled}
                          >
                            <span>{row.primaryAction.label}</span>
                            <Icon name={row.primaryAction.icon || 'arrow_right'} size={14} />
                          </button>
                        )}
                        {row.overflowActions && row.overflowActions.length > 0 && (
                          <OverflowMenu
                            ariaLabel={`Actions for ${row.code}`}
                            items={row.overflowActions}
                          />
                        )}
                      </div>
                    </td>
                  </tr>
                )
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  )
}
</file>

<file path="src/components/ui/BooqableRentalFilterDrawer.tsx">
import { useId } from 'react'
import { FilterDrawer, FilterSection } from './FilterDrawer'
import Icon from './Icon'
import { Badge } from './Badge'
import { Button } from './Page'
import { Unavailable } from './Unavailable'
import { STATUS_ORDER } from '../../lib/workflow'
import type { BookingStatus } from '../../lib/workflow'
import type { ChipKey } from '../../lib/queries/bookings'
import { PROJECT_TYPES } from '../../lib/projectTypes'
import { DateRangePresets } from './DateRangePresets'

export interface BooqableRentalFilterDrawerProps {
  /** Render only filter contents when hosted by the shared app panel. */
  embedded?: boolean
  id?: string
  open: boolean
  onClose: () => void
  resultCount: number | null
  activeCount: number
  onClearAll: () => void
  /** Stage facet */
  statusFilter: Set<BookingStatus>
  onToggleStatus: (status: BookingStatus) => void
  /** Project Type facet — neutral chips, never status-colored (spec §3) */
  projectTypeFilter: Set<string>
  onToggleProjectType: (projectType: string) => void
  /** Quick filter preset */
  quickFilter: ChipKey
  onSelectQuickFilter: (chip: ChipKey) => void
  /** Date range filter and presets */
  dateRange?: { from: string; to: string }
  onChangeDateRange?: (range: { from: string; to: string }) => void
  /** Sub-rental toggle */
  subOn: boolean
  onToggleSub: () => void
  /** Money visibility (Law 6) */
  money?: boolean
  /** Live stage counts */
  stageCounts?: Record<string, number | null>
  /**
   * ADOPTIONS item 9 (RAIL §1): Export is rail furniture, pinned at the
   * bottom — never in the header. The drawer owns "what slice am I looking
   * at", so the export of that slice lives with it. The handler stays the
   * page's own audited path (columns, money gate, export audit); this is
   * placement, not a second CSV writer. Absent = no export affordance.
   */
  onExport?: () => void
  /** Portal to document.body (defaults to true except in test runs) */
  portal?: boolean | undefined
}

interface PresetOption {
  key: ChipKey
  label: string
  icon: 'queues' | 'box' | 'truck' | 'alert_triangle' | 'invoice' | 'check'
  description?: string
}

const BOOQABLE_PRESETS: PresetOption[] = [
  { key: 'All', label: 'All', icon: 'queues' },
  { key: 'Upcoming', label: 'Upcoming', icon: 'box', description: 'Bookings awaiting warehouse packing' },
  { key: 'Tomorrow', label: 'Tomorrow', icon: 'truck', description: 'Starts tomorrow' },
  { key: 'Returning', label: 'Returning', icon: 'queues', description: 'Expected return' },
  { key: 'On Rent', label: 'On Rent', icon: 'truck', description: 'Equipment active with clients' },
  { key: 'Overdue', label: 'Overdue', icon: 'alert_triangle', description: 'Past return deadline and not checked in' },
  { key: 'Payment Due', label: 'Payment Due', icon: 'invoice', description: 'Unpaid or partial deposits' },
]

export function BooqableRentalFilterDrawer({
  embedded = false,
  id,
  open,
  onClose,
  resultCount,
  activeCount,
  onClearAll,
  statusFilter,
  onToggleStatus,
  projectTypeFilter,
  onToggleProjectType,
  quickFilter,
  onSelectQuickFilter,
  dateRange,
  onChangeDateRange,
  subOn,
  onToggleSub,
  money = false,
  stageCounts = {},
  onExport,
  portal,
}: BooqableRentalFilterDrawerProps) {
  const generatedDrawerId = useId()
  const drawerId = id ?? generatedDrawerId

  const content = (
      <div style={{ display: 'grid', gap: 'var(--sp-xs)', paddingBottom: 'var(--sp-md)' }}>
        {/* Section 1: Booqable Quick Presets / Views */}
        <FilterSection
          title="Smart Views & Presets"
          defaultOpen
          action={
            quickFilter !== 'All' ? (
              <button
                type="button"
                onClick={() => onSelectQuickFilter('All')}
                style={{
                  border: 'none',
                  background: 'transparent',
                  color: 'var(--link)',
                  fontSize: 'var(--t-meta)',
                  fontWeight: 600,
                  cursor: 'pointer',
                  padding: 0,
                }}
              >
                Reset
              </button>
            ) : null
          }
        >
          <div style={{ display: 'grid', gap: 6 }}>
            {BOOQABLE_PRESETS.map((p) => {
              // Hide payment preset if user cannot view money (Law 6)
              if (p.key === 'Payment Due' && !money) return null
              const isSelected = quickFilter === p.key

              return (
                <button
                  key={p.key}
                  type="button"
                  className="tap"
                  aria-pressed={isSelected}
                  onClick={() => onSelectQuickFilter(p.key)}
                  style={{
                    display: 'flex',
                    alignItems: 'center',
                    gap: 10,
                    minHeight: 44,
                    padding: '0 12px',
                    borderRadius: 'var(--r-sm)',
                    border: `1px solid ${isSelected ? 'var(--primary)' : 'var(--border)'}`,
                    background: isSelected ? 'var(--hover-card)' : 'var(--card)',
                    color: isSelected ? 'var(--primary)' : 'var(--text)',
                    cursor: 'pointer',
                    textAlign: 'left',
                    fontFamily: 'inherit',
                    transition: 'all 120ms ease',
                    outline: 'none',
                  }}
                  onFocus={(e) => { e.currentTarget.style.outline = '2px solid var(--input-focus)'; e.currentTarget.style.outlineOffset = '2px'; }}
                  onBlur={(e) => { e.currentTarget.style.outline = 'none'; }}
                >
                  <span
                    style={{
                      display: 'grid',
                      placeItems: 'center',
                      width: 28,
                      height: 28,
                      borderRadius: 'var(--r-badge)',
                      background: isSelected ? 'var(--primary)' : 'var(--chip-gray-bg)',
                      color: isSelected ? 'var(--on-brand)' : 'var(--text2)',
                      flexShrink: 0,
                    }}
                  >
                    <Icon name={p.icon} size={15} />
                  </span>
                  <div style={{ flex: 1, minWidth: 0 }}>
                    <div style={{ fontSize: 'var(--t-ui)', fontWeight: isSelected ? 700 : 500 }}>
                      {p.label}
                    </div>
                  </div>
                  {isSelected && (
                    <Icon name="check" size={16} style={{ color: 'var(--primary)', flexShrink: 0 }} />
                  )}
                </button>
              )
            })}
          </div>
        </FilterSection>

        {/* Section 2: Rental Stage / Status Facets — inline chip grid instead of accordion */}
        <div style={{ marginBottom: 'var(--sp-lg)' }}>
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 'var(--sp-sm)' }}>
            <h3 style={{ fontSize: 'var(--t-ui)', fontWeight: 700, color: 'var(--text)', letterSpacing: '-0.01em' }}>
              Status
            </h3>
            {statusFilter.size > 0 && (
              <Badge tone="primary" label={`${statusFilter.size} active`} size="sm" variant="square" />
            )}
          </div>
          <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6 }}>
            {STATUS_ORDER.map((stage) => {
              const isChecked = statusFilter.has(stage)
              const count = stageCounts[stage]

              return (
                <label
                  key={stage}
                  style={{
                    display: 'inline-flex',
                    alignItems: 'center',
                    gap: 8,
                    minHeight: 44,
                    padding: '0 12px',
                    borderRadius: 'var(--r-sm)',
                    border: `1px solid ${isChecked ? 'var(--primary)' : 'var(--border)'}`,
                    background: isChecked ? 'var(--hover-card)' : 'transparent',
                    cursor: 'pointer',
                    outline: 'none',
                  }}
                  onFocus={(e) => { e.currentTarget.style.outline = '2px solid var(--input-focus)'; e.currentTarget.style.outlineOffset = '2px'; }}
                  onBlur={(e) => { e.currentTarget.style.outline = 'none'; }}
                >
                  <input
                    type="checkbox"
                    aria-label={`Filter by status: ${stage}`}
                    checked={isChecked}
                    onChange={() => onToggleStatus(stage)}
                    style={{
                      width: 16,
                      height: 16,
                      flexShrink: 0,
                      accentColor: 'var(--primary)',
                    }}
                  />
                  <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                    <Badge tone={stage === 'Closed' ? 'neutral' : stage === 'Returned' ? 'in' : 'progress'} label={stage} size="sm" variant="square" />
                  </div>
                  {count !== undefined && count !== null && (
                    <span
                      className="figure"
                      style={{
                        fontSize: 'var(--t-meta)',
                        color: 'var(--muted)',
                        fontVariantNumeric: 'tabular-nums',
                        fontWeight: 600,
                      }}
                    >
                      {count}
                    </span>
                  )}
                </label>
              )
            })}
          </div>
        </div>

        {/* Section 2b: Project Type facet — checkbox grid mirroring Status, but
            deliberately badge-less and neutral: the type is not an operational
            state, so it never borrows a status tone (spec §3). */}
        <div style={{ marginBottom: 'var(--sp-lg)' }}>
          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 'var(--sp-sm)' }}>
            <h3 style={{ fontSize: 'var(--t-ui)', fontWeight: 700, color: 'var(--text)', letterSpacing: '-0.01em' }}>
              Project Type
            </h3>
            {projectTypeFilter.size > 0 && (
              <Badge tone="primary" label={`${projectTypeFilter.size} active`} size="sm" variant="square" />
            )}
          </div>
          <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6 }}>
            {PROJECT_TYPES.map((type) => {
              const isChecked = projectTypeFilter.has(type)

              return (
                <label
                  key={type}
                  style={{
                    display: 'inline-flex',
                    alignItems: 'center',
                    gap: 8,
                    minHeight: 44,
                    padding: '0 12px',
                    borderRadius: 'var(--r-sm)',
                    border: `1px solid ${isChecked ? 'var(--primary)' : 'var(--border)'}`,
                    background: isChecked ? 'var(--hover-card)' : 'transparent',
                    cursor: 'pointer',
                    outline: 'none',
                    fontSize: 'var(--t-meta)',
                    fontWeight: isChecked ? 600 : 500,
                    color: 'var(--text2)',
                    whiteSpace: 'nowrap',
                  }}
                  onFocus={(e) => { e.currentTarget.style.outline = '2px solid var(--input-focus)'; e.currentTarget.style.outlineOffset = '2px'; }}
                  onBlur={(e) => { e.currentTarget.style.outline = 'none'; }}
                >
                  <input
                    type="checkbox"
                    checked={isChecked}
                    onChange={() => onToggleProjectType(type)}
                    aria-label={`Filter by project type ${type}`}
                    style={{
                      width: 16,
                      height: 16,
                      flexShrink: 0,
                      accentColor: 'var(--primary)',
                    }}
                  />
                  {type}
                </label>
              )
            })}
          </div>
        </div>

        {/* Section 3: Booqable Date Range Presets */}
        {onChangeDateRange && (
          <FilterSection
            title="Date"
            defaultOpen
            badge={
              (dateRange?.from || dateRange?.to) ? (
                <Badge tone="primary" label="Filtered" size="sm" />
              ) : undefined
            }
            action={
              (dateRange?.from || dateRange?.to) ? (
                <button
                  type="button"
                  onClick={() => onChangeDateRange({ from: '', to: '' })}
                  style={{
                    border: 'none',
                    background: 'transparent',
                    color: 'var(--link)',
                    fontSize: 'var(--t-meta)',
                    fontWeight: 600,
                    cursor: 'pointer',
                    padding: 0,
                  }}
                >
                  Reset
                </button>
              ) : null
            }
          >
            <DateRangePresets
              from={dateRange?.from ?? ''}
              to={dateRange?.to ?? ''}
              onChange={onChangeDateRange}
            />
          </FilterSection>
        )}

        {/* Section 4: Sourcing & External Equipment */}
        <FilterSection
          title="Fulfillment & Sourcing"
          defaultOpen
        >
          <label
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: 10,
              minHeight: 44,
              padding: '0 12px',
              borderRadius: 'var(--r-sm)',
              border: `1px solid ${subOn ? 'var(--primary)' : 'var(--border)'}`,
              background: subOn ? 'var(--hover-card)' : 'transparent',
              cursor: 'pointer',
            }}
          >
            <input
              type="checkbox"
              aria-label="Filter sub-rentals only"
              checked={subOn}
              onChange={onToggleSub}
              style={{
                width: 16,
                height: 16,
                flexShrink: 0,
                accentColor: 'var(--primary)',
              }}
            />
            <div style={{ flex: 1, minWidth: 0 }}>
              <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
                <span style={{ fontSize: 'var(--t-ui)', fontWeight: subOn ? 700 : 500, color: 'var(--text)' }}>
                  Sub-rented Equipment Only
                </span>
                <Badge tone="ext" label="External" size="sm" />
              </div>
              <div style={{ fontSize: '11px', color: 'var(--muted)', marginTop: 2 }}>
                Narrows to bookings sourcing equipment from 3rd-party vendors
              </div>
            </div>
          </label>
        </FilterSection>

        {/* Pinned export — rail furniture (RAIL §1). Rides the page's own
            handler, so the money gate and audit travel with it. */}
        {onExport && (
          <div style={{ paddingTop: 'var(--sp-xs)' }}>
            <Button icon="download" onClick={onExport}>
              Export CSV
            </Button>
          </div>
        )}

        {/* Save as new filter */}
        <div style={{ paddingTop: 'var(--sp-xs)' }}>
          <Unavailable reason="Saved filters are not built yet — there is nowhere to store one and nothing settles who it is shared with.">
            <div style={{ width: '100%' }}>
              <Button icon="flag" disabled>
                Save as new filter
              </Button>
            </div>
          </Unavailable>
        </div>
      </div>
  )

  if (embedded) return open ? <>{content}<div style={{ display: 'flex', gap: 8, paddingTop: 12, borderTop: '1px solid var(--border)', flexWrap: 'wrap' }}><Button onClick={onClearAll}>Clear All</Button><Button variant="primary" onClick={onClose}>{resultCount !== null ? `Show ${resultCount} Results` : 'Apply'}</Button></div></> : null

  return (
    <FilterDrawer
      id={drawerId}
      open={open}
      onClose={onClose}
      portal={portal}
      side="left"
      desktopMode="overlay"
      resultCount={resultCount}
      noun={resultCount === 1 ? 'rental' : 'rentals'}
      activeCount={activeCount}
      onClearAll={onClearAll}
      standardFooter
      onApply={onClose}
      applyLabel={resultCount !== null ? `Show ${resultCount} Results` : 'Apply'}
    >
      {content}
    </FilterDrawer>
  )
}

/**
 * Alias for BooqableRentalFilterDrawer.
 * Wraps the design system's FilterDrawer primitive to provide domain-specific facets
 * (status, presets, date range, sub-rentals) for Rentals.
 */
export const RentalFilterDrawer = BooqableRentalFilterDrawer
export type RentalFilterDrawerProps = BooqableRentalFilterDrawerProps
