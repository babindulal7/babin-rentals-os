<file path="src/lib/queries/rentalViews.ts">
import { listBookings } from './bookings'
import { applyListFilters, type FilterBuilder, type ListFilters } from './listQuery'
import { supabase } from '../supabase'

export const RENTAL_VIEWS = [
  { id: 'All', label: 'All', icon: 'checklist', stages: [] },
  { id: 'Draft', label: 'Draft', icon: 'file', stages: ['Draft'] },
  { id: 'Quote', label: 'Quote', icon: 'file', stages: ['Quote'] },
  { id: 'Upcoming', label: 'Upcoming', icon: 'calendar', stages: ['Quote', 'Booked', 'Packed'] },
  { id: 'Out', label: 'Out', icon: 'truck', stages: ['On Rent'] },
  { id: 'Returns', label: 'Returns', icon: 'return_arrow', stages: ['Returned'] },
  { id: 'Closed', label: 'Closed', icon: 'lock', stages: ['Closed'] },
  // ADOPTIONS item 4 (Booqable §9.2): the excluded population's census.
  // Cancelled is a presence flag, not a stage (Law 3 / 0015) — every other
  // view excludes it, so without this row a cancelled booking disappears with
  // no visible opt-in. Counted with the flag flipped; never added to All.
  { id: 'Cancelled', label: 'Cancelled', icon: 'close', stages: [] },
] as const

export interface RentalViewCount { id: string; count: number | null }
interface DraftCountBuilder extends FilterBuilder<DraftCountBuilder>, PromiseLike<{ count: number | null; error: { message: string } | null }> {}

/** Facets count the matching registry, never the displayed page. No money is selected. */
export async function listRentalViewCounts(filters: ListFilters): Promise<{ rows: RentalViewCount[] }> {
  const { stage: _stage, ...chips } = filters.chips ?? {}
  const base = { ...filters, chips, page: undefined, range: undefined, sort: undefined }
  const booked = await Promise.all(RENTAL_VIEWS.map(async (view) => {
    if (view.id === 'Draft') return null
    if (view.id === 'Cancelled') {
      // The census half of the exclusion: same base narrowings, flag flipped.
      // No stage constraint — Cancelled preserves where the booking died.
      const result = await listBookings({ ...base, presence: { cancelled_at: true }, chips, headOnly: true, excludeArchived: true })
      const total = result.total
      return typeof total === 'number' && !Number.isNaN(total) ? total : null
    }
    const result = await listBookings({ ...base, chips: { ...chips, ...(view.stages.length ? { stage: [...view.stages] } : {}) }, headOnly: true, excludeArchived: true })
    const total = result.total
    return typeof total === 'number' && !Number.isNaN(total) ? total : null
  }))
  // A line-level Sub-Rental facet only provides saved booking ids; it cannot answer drafts.
  let drafts: number | null = null
  if (!chips.id?.length) {
    const { project_type: projectTypes, ...draftChips } = chips
    // JSON-path facets recurse through the SDK's JSON type; the HEAD projection needs only this structural builder.
    const head = supabase.from('rental_drafts').select('id', { count: 'exact', head: true }).eq('status', 'Active')
    const query = applyListFilters(head as unknown as DraftCountBuilder, {
      ...base,
      chips: { ...draftChips, ...(projectTypes?.length ? { 'data->>kind': projectTypes } : {}) },
      searchColumns: ['data->>bookingNo', 'data->>project', 'data->>kind', 'data->>kindOther', 'data->>clientName'],
      dateRange: filters.dateRange ? { ...filters.dateRange, column: 'data->>pickup' } : undefined,
      presence: undefined,
    })
    const { count, error } = await query
    if (error) throw new Error(`Could not count rental drafts: ${error.message}`)
    drafts = typeof count === 'number' && !Number.isNaN(count) ? count : null
  }
  return { rows: RENTAL_VIEWS.map((view, index) => {
    const bCount = booked[index]
    const bNum = typeof bCount === 'number' && !Number.isNaN(bCount) ? bCount : null
    let count: number | null = null
    if (view.id === 'Draft') {
      count = drafts
    } else if (view.id === 'All') {
      if (bNum === null || drafts === null) {
        count = null
      } else {
        count = bNum + drafts
      }
    } else {
      count = bNum
    }
    return { id: view.id, count }
  }) }
}
</file>

<file path="src/lib/queries/reportSupport.ts">
import { supabase } from '../supabase'
import { parseMoney, rupees, type Paisa } from '../money'

/**
 * **Shared pieces for the report reads (Phase 6 Task 3.4, Law 16 pass).**
 *
 * Every report query used to `try { … } catch { return MOCK_* }`, and most also
 * returned the MOCK block when the read succeeded with no rows, then patched
 * individual figures with `|| MOCK.metric`. So an outage, an empty database and
 * a quiet month all drew the same invented numbers. RULING 2026-10-15/16
 * (RULINGS-2026-10-16.md, R-P6-STATES): a failed read throws and the page draws
 * Error + Retry; a successful empty read is an honest empty; a figure with no
 * source reads {@link NOT_TRACKED}, never a plausible number.
 */

/** What a figure with no source in the database reads. Never a plausible default. */
export const NOT_TRACKED = 'Not tracked yet'

/** The filters every report toolbar hands its query. */
export interface ReportFilterOptions {
  from?: string | undefined
  to?: string | undefined
  branchId?: string | undefined
}

interface ReadResult {
  data: unknown
  error: { message: string } | null
}

/**
 * The rows of a read, or a throw naming which read failed.
 *
 * `data: null` with no error is an empty read (PostgREST returns `[]`, but a
 * mock or a head-only read may not) — an honest zero rows, not a failure.
 */
export function rowsOf<T>(res: ReadResult, what: string): T[] {
  if (res.error) throw new Error(`${what}: ${res.error.message}`)
  return Array.isArray(res.data) ? (res.data as T[]) : []
}

/** `booking_lines` columns every money figure in the reports is built from. */
export interface PricedLine {
  line_total?: number | string | null
  qty?: number | null
  days?: number | null
  rate?: number | string | null
  discount_amount?: number | string | null
  voided_at?: string | null
}

/**
 * Recorded net line value in paisa; legacy rows without a total retain the
 * qty × days × rate − discount fallback.
 *
 * `booking_lines.rate` and `discount_amount` are RUPEES (numeric(14,2), see
 * `bookings.ts`). The reports used to compute this in rupees and then pass
 * `Math.round(total / 100)` to `rupees()`, which printed one hundredth of the
 * real figure. A voided line is worth nothing.
 */
export function lineValue(line: PricedLine, fallbackDays = 1): Paisa {
  if (line.voided_at) return 0 as Paisa
  // 0168 records the net quote price, including structures/rulesets. Never
  // rebuild it from a daily rate or subtract its discount a second time.
  if (line.line_total != null) {
    const recorded = String(line.line_total)
    if (!/^\d+(?:\.\d+)?$/.test(recorded)) throw new Error('Invalid recorded booking-line total')
    const amount = parseMoney(recorded)
    if (amount === null || !Number.isSafeInteger(amount)) throw new Error('Recorded booking-line total exceeds safe paisa range')
    return amount
  }
  const qty = Number(line.qty ?? 1) || 1
  const days = Number(line.days ?? fallbackDays) || fallbackDays
  const rate = Number(line.rate ?? 0) || 0
  const discount = Number(line.discount_amount ?? 0) || 0
  return rupees(Math.max(0, qty * days * rate - discount))
}

/** Sum of {@link lineValue} over a booking's lines. */
export function linesValue(lines: readonly PricedLine[] | null | undefined, fallbackDays = 1): Paisa {
  return (lines ?? []).reduce((acc, l) => acc + lineValue(l, fallbackDays), 0) as Paisa
}

/** Whole-number share, or 0 when there is nothing to share (the count beside it says so). */
export function percentOf(part: number, whole: number): number {
  return whole > 0 ? Math.round((part / whole) * 100) : 0
}

/** The name on an embedded `clients!client_id(name)` row, or an em dash. */
export function embeddedName(embed: unknown): string {
  const obj = Array.isArray(embed) ? embed[0] : embed
  const name = (obj as { name?: unknown } | null | undefined)?.name
  return typeof name === 'string' && name.trim() ? name : '—'
}

/**
 * Every live booking line's priced columns, grouped by booking.
 *
 * Read from `booking_lines_v`, never the base table: 0062 revokes `rate` and
 * `discount_amount` on `booking_lines` from every signed-in session, so an
 * embedded `booking_lines(rate, …)` is refused outright (42501) — which is why
 * every money figure on these reports used to fall through to seed data on
 * live. The view returns them to money-visible roles and null to the rest.
 */
export interface ReportLine extends PricedLine {
  booking_id: string
  product_id: string | null
  bundle_id: string | null
}

export async function readLineValues(): Promise<Map<string, ReportLine[]>> {
  const res = await supabase
    .from('booking_lines_v')
    .select('booking_id, product_id, bundle_id, qty, days, rate, discount_amount, line_total, voided_at')
    .is('voided_at', null)
  const rows = rowsOf<ReportLine>(res, 'Booking line values read failed')
  const out = new Map<string, ReportLine[]>()
  for (const r of rows) {
    const list = out.get(r.booking_id)
    if (list) list.push(r)
    else out.set(r.booking_id, [r])
  }
  return out
}

/** Postgres "permission denied" — a column this session may not read. */
export function isPermissionDenied(err: { code?: string; message?: string } | null | undefined): boolean {
  return err?.code === '42501' || /permission denied/i.test(err?.message ?? '')
}
</file>

<file path="src/lib/queries/salesVatReports.ts">
import { supabase } from '../supabase'
import { parseMoney, type Paisa } from '../money'
import { BS_MONTHS, formatAdMonth, toBs } from '../bs'
import { embeddedName, percentOf, rowsOf, type ReportFilterOptions } from './reportSupport'

export type { ReportFilterOptions } from './reportSupport'

export interface SalesReportMetrics {
  totalInvoiced: Paisa
  netSales: Paisa
  totalVat: Paisa
  totalDiscounts: Paisa
  totalCollected: Paisa
  totalOutstanding: Paisa
  invoiceCount: number
  collectionRate: number
}

export interface InvoiceStatusBreakdownItem {
  status: string
  count: number
  amount: Paisa
  percent: number
}

export interface SalesTrendPoint {
  period: string
  invoiced: Paisa
  collected: Paisa
}

export interface TopClientSalesItem {
  clientId: string
  clientName: string
  invoiceCount: number
  totalInvoiced: Paisa
  totalPaid: Paisa
  balance: Paisa
}

export interface SalesInvoiceItem {
  id: string
  invoiceNo: string
  bookingNo: string
  clientName: string
  clientPan?: string | undefined
  issueDate: string
  dueDate: string
  subtotal: Paisa
  taxAmount: Paisa
  grandTotal: Paisa
  paidAmount: Paisa
  status: string
}

export interface SalesReportData {
  metrics: SalesReportMetrics
  statusBreakdown: InvoiceStatusBreakdownItem[]
  monthlyTrend: SalesTrendPoint[]
  topClients: TopClientSalesItem[]
  invoices: SalesInvoiceItem[]
}

export interface VatMonthlyRow {
  month: string
  bsMonth: string
  taxableSales: Paisa
  vatAmount: Paisa
  exemptSales: Paisa
  grossSales: Paisa
}

export interface VatTaxReportData {
  metrics: {
    totalGrossTurnover: Paisa
    taxableTurnover: Paisa
    totalOutputVat: Paisa
    exemptTurnover: Paisa
    effectiveVatRate: number
    invoicesCount: number
  }
  monthlySchedule: VatMonthlyRow[]
  taxRegister: SalesInvoiceItem[]
}

/*
 * RULING 2026-10-16 (R-P6-STATES, Law 16): this read returned MOCK_SALES /
 * MOCK_VAT on a failure and on an empty period, the monthly trend and VAT
 * schedule were always the mock blocks, and the effective rate was the literal
 * 13.0. It selected `tax_amount`, `grand_total` and `clients.pan_number`, none
 * of which exist (0006: `vat_amount`, `total_amount`; clients: `pan_vat`), so
 * on live it could ONLY ever show the mock figures. It now reads the real
 * columns, throws on failure, returns honest zeros, and builds the VAT
 * schedule per Bikram Sambat month from `issue_date` (BS rendered, never
 * stored). Draft and Void invoices are not sales and are left out.
 * Revert = restore MOCK_SALES/MOCK_VAT and the `catch`.
 */

type InvoiceRow = {
  id: string
  invoice_no: string
  client_id: string | null
  status: string
  issue_date: string | null
  due_date: string | null
  subtotal: number | string | null
  discount_amount: number | string | null
  taxable_amount: number | string | null
  vat_rate: number | string | null
  vat_amount: number | string | null
  total_amount: number | string | null
  paid_amount: number | string | null
  outstanding_amount: number | string | null
  voided_at: string | null
  clients?: unknown
  bookings?: unknown
}

const money = (v: number | string | null | undefined): Paisa => {
  const raw = String(v ?? 0)
  const amount = /^\d+(?:\.\d{1,2})?$/.test(raw) ? parseMoney(raw) : null
  if (amount === null || !Number.isSafeInteger(amount)) throw new Error('Invalid or unsafe invoice amount')
  return amount
}

const PAGE_SIZE = 500
const MAX_ROWS = 50_000

function bsMonthOf(isoDate: string): { key: string; label: string } | null {
  const bs = toBs(new Date(`${isoDate.slice(0, 10)}T12:00:00Z`))
  if (!bs) return null
  return { key: `${bs.year}-${String(bs.month).padStart(2, '0')}`, label: `${BS_MONTHS[bs.month - 1] ?? ''} ${bs.year}` }
}

export async function getSalesVatReport(options?: ReportFilterOptions): Promise<{ sales: SalesReportData; vat: VatTaxReportData }> {
  const invoiceQuery = () => {
    let query = supabase
    .from('invoices')
    .select(
      'id, invoice_no, client_id, status, issue_date, due_date, subtotal, discount_amount, taxable_amount, vat_rate, vat_amount, total_amount, paid_amount, outstanding_amount, voided_at, clients!client_id(name, pan_vat), bookings!booking_id(booking_no)',
    )
    .neq('status', 'Draft')
    .neq('status', 'Void')
    .is('voided_at', null)
    .order('issue_date', { ascending: false })
    .order('id', { ascending: false })
    if (options?.from) query = query.gte('issue_date', options.from)
    if (options?.to) query = query.lte('issue_date', options.to)
    if (options?.branchId) query = query.eq('branch_id', options.branchId)
    return query
  }

  // A register/export must contain the same invoices as its headline totals.
  // Continue until an empty confirmed page, including servers with a lower
  // page cap. A failed page or repeated row refuses the whole partial report.
  const rows: InvoiceRow[] = []
  const seen = new Set<string>()
  while (true) {
    const result = await invoiceQuery().range(rows.length, rows.length + PAGE_SIZE - 1)
    if (!Array.isArray(result.data) && !result.error) throw new Error('Invoices read returned no confirmed dataset')
    const page = rowsOf<InvoiceRow>(result, 'Invoices read failed')
    if (page.length === 0) break
    for (const row of page) {
      if (!row.id || seen.has(row.id)) throw new Error('Invoice register changed during pagination; retry the report')
      seen.add(row.id)
      rows.push(row)
    }
    if (rows.length > MAX_ROWS) throw new Error('Invoice register exceeds safe report limit; narrow the period')
  }

  let invoiced = 0
  let net = 0
  let vatTotal = 0
  let discounts = 0
  let paidTotal = 0
  let outstanding = 0
  let taxable = 0
  let exempt = 0
  const statusMap = new Map<string, { count: number; amount: number }>()
  const clientMap = new Map<string, { name: string; count: number; invoiced: number; paid: number }>()
  const monthMap = new Map<string, VatMonthlyRow & { invoicedTotal: number; collectedTotal: number }>()
  const invoices: SalesInvoiceItem[] = []

  for (const r of rows) {
    const total = money(r.total_amount)
    const sub = money(r.subtotal)
    const vat = money(r.vat_amount)
    const taxableAmt = money(r.taxable_amount)
    const paid = money(r.paid_amount)
    const discount = money(r.discount_amount)
    if (discount > sub) throw new Error('Invalid invoice amount: discount exceeds subtotal')
    invoiced += total
    net += sub - discount
    vatTotal += vat
    discounts += discount
    paidTotal += paid
    outstanding += money(r.outstanding_amount)
    // An invoice with no VAT charged is exempt (or zero-rated) turnover.
    const isExempt = vat === 0
    if (isExempt) exempt += taxableAmt
    else taxable += taxableAmt
    if (![invoiced, net, vatTotal, discounts, paidTotal, outstanding, taxable, exempt, taxable + exempt].every(Number.isSafeInteger)) {
      throw new Error('Invoice report exceeds safe paisa range; narrow the period')
    }

    const st = statusMap.get(r.status) ?? { count: 0, amount: 0 }
    st.count++
    st.amount += total
    statusMap.set(r.status, st)

    const client = (Array.isArray(r.clients) ? r.clients[0] : r.clients) as { name?: string; pan_vat?: string | null } | null | undefined
    const clientName = embeddedName(r.clients)
    const cKey = r.client_id ?? clientName
    const cl = clientMap.get(cKey) ?? { name: clientName, count: 0, invoiced: 0, paid: 0 }
    cl.count++
    cl.invoiced += total
    cl.paid += paid
    clientMap.set(cKey, cl)

    if (r.issue_date) {
      const bm = bsMonthOf(r.issue_date)
      if (bm) {
        const row =
          monthMap.get(bm.key) ??
          ({ month: formatAdMonth(new Date(`${r.issue_date.slice(0, 10)}T12:00:00Z`)), bsMonth: bm.label, taxableSales: 0 as Paisa, vatAmount: 0 as Paisa, exemptSales: 0 as Paisa, grossSales: 0 as Paisa, invoicedTotal: 0, collectedTotal: 0 } as VatMonthlyRow & {
            invoicedTotal: number
            collectedTotal: number
          })
        row.taxableSales = (row.taxableSales + (isExempt ? 0 : taxableAmt)) as Paisa
        row.exemptSales = (row.exemptSales + (isExempt ? taxableAmt : 0)) as Paisa
        row.vatAmount = (row.vatAmount + vat) as Paisa
        row.grossSales = (row.grossSales + total) as Paisa
        row.invoicedTotal += total
        row.collectedTotal += paid
        monthMap.set(bm.key, row)
      }
    }

    const booking = (Array.isArray(r.bookings) ? r.bookings[0] : r.bookings) as { booking_no?: string } | null | undefined
    invoices.push({
      id: r.id,
      invoiceNo: r.invoice_no,
      bookingNo: booking?.booking_no ?? '—',
      clientName,
      clientPan: client?.pan_vat?.trim() || undefined,
      issueDate: r.issue_date ?? '',
      dueDate: r.due_date ?? '',
      subtotal: sub,
      taxAmount: vat,
      grandTotal: total,
      paidAmount: paid,
      status: r.status,
    })
  }

  const count = rows.length
  const months = [...monthMap.entries()].sort((a, b) => a[0].localeCompare(b[0])).map(([, v]) => v)
  const vatBase = taxable + exempt

  const sales: SalesReportData = {
    metrics: {
      totalInvoiced: invoiced as Paisa,
      netSales: net as Paisa,
      totalVat: vatTotal as Paisa,
      totalDiscounts: discounts as Paisa,
      totalCollected: paidTotal as Paisa,
      totalOutstanding: outstanding as Paisa,
      invoiceCount: count,
      collectionRate: invoiced > 0 ? Number(((paidTotal / invoiced) * 100).toFixed(1)) : 0,
    },
    statusBreakdown: [...statusMap.entries()]
      .sort((a, b) => b[1].count - a[1].count)
      .map(([status, v]) => ({ status, count: v.count, amount: v.amount as Paisa, percent: percentOf(v.count, count) })),
    monthlyTrend: months.map((m) => ({ period: m.bsMonth, invoiced: m.invoicedTotal as Paisa, collected: m.collectedTotal as Paisa })),
    topClients: [...clientMap.entries()]
      .map(([clientId, v]) => ({
        clientId,
        clientName: v.name,
        invoiceCount: v.count,
        totalInvoiced: v.invoiced as Paisa,
        totalPaid: v.paid as Paisa,
        balance: Math.max(0, v.invoiced - v.paid) as Paisa,
      }))
      .sort((a, b) => b.totalInvoiced - a.totalInvoiced)
      .slice(0, 5),
    invoices,
  }

  const vat: VatTaxReportData = {
    metrics: {
      totalGrossTurnover: invoiced as Paisa,
      taxableTurnover: taxable as Paisa,
      totalOutputVat: vatTotal as Paisa,
      exemptTurnover: exempt as Paisa,
      effectiveVatRate: vatBase > 0 ? Number(((vatTotal / vatBase) * 100).toFixed(1)) : 0,
      invoicesCount: count,
    },
    monthlySchedule: months.map(({ invoicedTotal: _i, collectedTotal: _c, ...row }) => row),
    taxRegister: invoices,
  }

  return { sales, vat }
}
</file>

<file path="src/lib/queries/useLoad.ts">
import { useCallback, useEffect, useRef, useState } from 'react'

/**
 * **The one-shot read behind a report or settings pane — `useList`'s sibling
 * for screens whose data is a summary, not a filtered list.**
 *
 * PLAN.md Phase 6 asks every routed view to draw five states. The secondary
 * views (reports, Settings panes, admin) mostly read once on mount, and each
 * wrote its own `useEffect(() => { void query().then(setX) }, [])` — with no
 * `.catch`, no loading flag and, in several, the result discarded. That is how
 * a report ends up with no Loading state and no Error state at all: there was
 * nothing to draw them from. This hook is the thing to draw them from, and it
 * hands `PageBody` exactly the shape `useList` does, so the two stay one
 * contract:
 *
 *   - `error` is the bare REASON (`PageBody` writes "Could not load …").
 *   - a failed REFRESH keeps the previous `data`, so `hasRows` can show the
 *     banner above stale-but-true figures rather than blanking them.
 *
 * ## Offline is a reason, not a sixth component
 *
 * The shell already draws the Offline bar on every route (`App.tsx`,
 * `OfflineBanner`, `useNetwork()`). What a screen adds is the per-read half:
 * when a read fails while the browser reports itself offline, the failure is
 * almost certainly the connection, and "fetch failed" tells the operator
 * nothing they can act on. So the reason becomes {@link OFFLINE_REASON} — what
 * happened, why, and what to do — and the read retries by itself on the
 * `online` event, so reconnecting is the fix rather than reconnecting and then
 * finding the Retry button.
 *
 * ## What it deliberately does not do
 *
 * No cache and no background refetch (TanStack Query's job, as `useList`
 * says). And no fallback value: a failed read is `error`, never a zero or a
 * seed figure dressed as data (Law 16).
 */

/**
 * The reason a read failed while the browser was offline.
 *
 * Written as the message beneath `PageBody`'s "Could not load …" title, so it
 * does not repeat that half — it says why, and how to fix it.
 */
export const OFFLINE_REASON =
  'This device is offline, so the read never reached the server. It will try again on its own when the connection returns, or press Retry.'

/** True when the browser reports no network. A browser that cannot say counts as online. */
export function isBrowserOffline(): boolean {
  return typeof navigator !== 'undefined' && navigator.onLine === false
}

/**
 * The reason to show for a failed read: the offline sentence when the browser
 * is offline, otherwise the error's own message.
 *
 * Exported so a screen that keeps its own load state (Staff Directory) words
 * an offline failure the same way as every screen that uses the hook.
 */
export function loadFailureReason(err: unknown): string {
  if (isBrowserOffline()) return OFFLINE_REASON
  if (err instanceof Error && err.message) return err.message
  if (typeof err === 'string' && err) return err
  return 'The read failed without saying why.'
}

export interface LoadResult<T> {
  /** The last SUCCESSFUL result; null until the first one lands. A failed refresh leaves it alone. */
  data: T | null
  /** True while a read is in flight — the first one, or a Retry. */
  loading: boolean
  /** The bare reason the latest read failed, or null. See the header: never a finished sentence. */
  error: string | null
  /** Whether the latest failure happened while the browser was offline. */
  offline: boolean
  /** Re-runs the read. Bound to the error state's Retry. */
  reload: () => void
  /** When `data` last came back from a successful read. */
  lastFetchedAt: Date | null
}

export interface UseLoadOptions {
  /**
   * `false` skips the read entirely — for a session that may not see the
   * surface, whose restricted state must not be preceded by a request for data
   * it cannot have. `loading` is false while disabled.
   */
  enabled?: boolean
  /**
   * A value that, when it changes, re-runs the read (a period, a filter set).
   * A string so a fresh object literal per render does not refetch forever —
   * the same reason `useList` keys on `filterKey`.
   */
  key?: string
}

export function useLoad<T>(fetcher: () => Promise<T>, options: UseLoadOptions = {}): LoadResult<T> {
  const enabled = options.enabled ?? true
  const key = options.key ?? ''

  const [data, setData] = useState<T | null>(null)
  const [loading, setLoading] = useState(enabled)
  const [error, setError] = useState<string | null>(null)
  const [offline, setOffline] = useState(false)
  const [lastFetchedAt, setLastFetchedAt] = useState<Date | null>(null)
  const [nonce, setNonce] = useState(0)

  // The fetcher is usually an inline arrow; held in a ref so a new identity is
  // not a reason to re-query — only `key`, `enabled` or a Retry are.
  const fetcherRef = useRef(fetcher)
  fetcherRef.current = fetcher

  useEffect(() => {
    if (!enabled) {
      setLoading(false)
      return
    }
    let cancelled = false
    setLoading(true)
    setError(null)
    setOffline(false)

    fetcherRef
      .current()
      .then((res) => {
        if (cancelled) return
        setData(res)
        setLastFetchedAt(new Date())
      })
      .catch((err: unknown) => {
        if (cancelled) return
        setOffline(isBrowserOffline())
        setError(loadFailureReason(err))
      })
      .finally(() => {
        if (!cancelled) setLoading(false)
      })

    // A key change mid-flight must not let the older, slower response win.
    return () => {
      cancelled = true
    }
  }, [enabled, key, nonce])

  const reload = useCallback(() => setNonce((n) => n + 1), [])

  // Reconnecting is the fix for an offline failure, so it is also the retry.
  useEffect(() => {
    if (!offline) return
    const onOnline = () => setNonce((n) => n + 1)
    window.addEventListener('online', onOnline)
    return () => window.removeEventListener('online', onOnline)
  }, [offline])

  return { data, loading, error, offline, reload, lastFetchedAt }
}
</file>

<file path="src/lib/auth.tsx">
import { createContext, useContext, useEffect, useRef, useState, useCallback, ReactNode } from 'react'
import { supabase, IS_MOCK } from './supabase'
import { getSetting } from './settingsStore'
import { hydrateSharedSettings } from './settingsSync'
import { recordLogin, recordLogout } from './authAudit'
import { captureError } from './monitoring'
import { purgeDeviceReadCaches } from './devicePurge'
import { loadFailureReason } from './queries/useLoad'

/**
 * The session role IS the system role. They were separate unions until 8 Aug 2026,
 * which forced a lossy shim on every screen that needed a capability check.
 * `SystemRole` is now the business 8, so there is one vocabulary and no mapping.
 */
export type { SystemRole as Role } from '../types/database'
import type { SystemRole } from '../types/database'
type Role = SystemRole

export interface AuthUser {
  id: string
  name: string
  role: Role
  isSharedDevice: boolean
}

/**
 * The verdict from `verify_staff_pin` (migration 0066).
 *
 * `ok` is the ONLY field that may unlock anything, and it is true only when the
 * database compared a bcrypt hash and it matched. Every other shape — no
 * session, no PIN enrolled, locked out, deactivated staff row, malformed input,
 * or a network failure that never reached Postgres — resolves to `ok: false`.
 * There is deliberately no third state: a lock that cannot verify must stay
 * locked, and an `undefined` would eventually be read as falsy-but-fine by
 * somebody.
 */
export type PinRejection =
  | 'no_session'
  | 'no_pin'
  | 'locked'
  | 'inactive'
  | 'malformed'
  | 'incorrect'
  | 'unavailable'

export interface PinVerdict {
  ok: boolean
  // `| undefined` is spelled out on every optional field below because this
  // project runs `exactOptionalPropertyTypes: true` — "absent" and "present and
  // undefined" are different types, and the RPC mapper produces the latter.
  reason?: PinRejection | undefined
  attemptsRemaining?: number | undefined
  lockedUntil?: string | null | undefined
  /** Present only for `unavailable` — the underlying failure, for the screen to show verbatim. */
  message?: string | undefined
}

/** What `staff_pin_status` reports about the caller's own PIN. Never a hash. */
export interface PinStatus {
  hasPin: boolean
  setAt?: string | null | undefined
  lockedUntil?: string | null | undefined
  lastUsedAt?: string | null | undefined
  /**
   * Set when the status check itself FAILED — the reason, worded for an
   * operator. `hasPin` is still `false` in that case (the under-claim below
   * stands, and the lock trigger reads only `hasPin`), but the Settings row can
   * now say "could not check" instead of a bare "Not set" it does not know.
   */
  unavailable?: string | undefined
}

interface AuthContextType {
  user: AuthUser | null
  /**
   * True until the very first session lookup resolves. `Shell` must not bounce
   * to /login while this is true, or every page refresh flashes the login screen
   * before the restored session lands.
   */
  loading: boolean
  signIn: (email: string, password: string) => Promise<{ error: string | null }>
  /**
   * Send a password-reset link to `email`.
   *
   * ⚠ Read `requestPasswordReset`'s own comment before writing UI against this.
   * A `null` error does **not** mean an email was sent — Supabase answers the
   * same way for an address with no account, deliberately.
   */
  requestPasswordReset: (email: string) => Promise<{ error: string | null }>
  /** Set a new password for the session established by a recovery link. */
  updatePassword: (password: string) => Promise<{ error: string | null }>
  /**
   * True once Supabase has reported `PASSWORD_RECOVERY` for this tab — i.e. the
   * visitor arrived by clicking a reset link, and the session that now exists is
   * a recovery session rather than a normal sign-in.
   */
  isPasswordRecovery: boolean
  logout: () => void
  isLocked: boolean
  setLocked: (locked: boolean) => void
  /**
   * Draw the curtain now, without signing out.
   *
   * Refuses when this session has no PIN — locking someone behind a credential
   * they do not hold leaves them with "Sign out instead" as the only way
   * forward, which is a worse outcome than not locking. `hasPin` is exposed so
   * a caller can hide the control rather than offer one that declines.
   */
  lockNow: () => void
  /** Whether this session has a PIN enrolled, so a lock can actually be reopened. */
  hasPin: boolean
  /**
   * Enrol or rotate the current session's own PIN.
   *
   * There is no `userId` parameter and there is no admin variant here, because
   * `set_staff_pin` takes none — the subject is `auth_user_id()`. See 0066.
   */
  setStaffPin: (pin: string) => Promise<{ error: string | null }>
  /**
   * Check a PIN against the current session's enrolled one.
   *
   * ⚠ This does NOT sign anyone in and cannot. It re-admits a session that
   * already holds a JWT. A caller that treats a true verdict as authentication
   * is rebuilding `VITE_DEV_AUTH_BYPASS` — see the `signIn` comment below for
   * what that cost.
   */
  verifyStaffPin: (pin: string) => Promise<PinVerdict>
  /** Whether this session has a PIN, for the settings row. Never returns a hash. */
  staffPinStatus: () => Promise<PinStatus>
  /** Remove the current session's own PIN. */
  revokeOwnStaffPin: () => Promise<{ error: string | null }>
}

const AuthContext = createContext<AuthContextType | undefined>(undefined)

/**
 * Real Supabase Auth, wired 11 Aug 2026 (replaced a hardcoded mock session that
 * made every visitor an Owner and made `Shell`'s existing `if (!user)` guard
 * unreachable).
 *
 * IDENTITY CONTRACT — `auth.users.id` IS `public.users.id`. Migration 0041's
 * PostgREST `db_pre_request` hook copies `auth.uid()` into the
 * `app.current_user_id` GUC that every RLS policy reads, so the role resolved
 * here and the role the database enforces are the same fact from the same row.
 * The UI gate is therefore a convenience, never the security boundary — Law 6
 * is enforced by RLS (PLAN.md §0).
 */
export function AuthProvider({ children }: { children: ReactNode }) {
  const [user, setUser] = useState<AuthUser | null>(null)
  /* Latest signed-in id for `logout`, which has no dependency on render state (G6 Logout audit row). */
  const userIdRef = useRef<string | null>(null)
  const [loading, setLoading] = useState(true)
  const [isLocked, setLocked] = useState(false)
  const [isPasswordRecovery, setPasswordRecovery] = useState(false)
  const [hasPin, setHasPin] = useState(false)

  /**
   * Resolve the staff row for a signed-in identity. The role must come from
   * `users.primary_role` — never from JWT metadata, which the client could
   * tamper with and which no RLS policy consults.
   */
  const loadProfile = useCallback(async (authId: string, fallbackEmail: string | undefined) => {
    const { data, error } = await supabase
      .from('users')
      .select('id, full_name, primary_role')
      .eq('id', authId)
      .maybeSingle()

    /*
     * ⛔ THE READ FAILED. This is NOT the same fact as "there is no staff row",
     * and until 16 Aug 2026 this function treated them identically
     * (`if (error || !data)`), which silently demoted the signed-in Owner to
     * `Client`.
     *
     * Found by driving the app, not by reading it. `loadProfile` runs again on
     * every `onAuthStateChange` — including `TOKEN_REFRESHED`, roughly hourly.
     * When that re-read failed, the header changed from "Babin Dulal · Owner" to
     * "babindulal7@gmail.com · Client" mid-session and `/finance` began saying
     * *"Access restricted. Your role (Client) does not have access to this
     * module."* to the owner of the business. A page reload restored Owner,
     * which is what makes it so hard to report: it looks like a fluke.
     *
     * The demotion also explains the shape of the two `PROGRESS.md` incidents on
     * 12 Aug — "signed in, everything empty" — and migrations 0056/0059 were
     * both written chasing that symptom at the RLS layer. This is the same
     * symptom arriving from the client side.
     *
     * A failed read tells us NOTHING about who this session is, so it must not
     * answer the question. Keep whatever identity we had already resolved: the
     * role is a fact about the staff row, not about the health of one request,
     * and it cannot have changed because a fetch timed out. If nothing was
     * resolved yet, stay `null` — `Shell` sends an unresolved session to /login,
     * which is honest, rather than rendering a Client UI over an Owner account.
     */
    if (error) {
      captureError(error, { where: 'auth.reReadStaffRow', authId })
      setUser((previous) => previous)
      return
    }

    if (!data) {
      // Authenticated against Supabase but carrying no staff row — a real state
      // (an auth user created outside the staff table), and now genuinely
      // distinguishable from the branch above. Deliberately NOT defaulted to a
      // working role: an unknown identity gets `Client`, the portal-only role
      // every staff policy already excludes.
      setUser({
        id: authId,
        // Empty, NOT 'Unknown user'. See the note below.
        name: fallbackEmail ?? '',
        role: 'Client' as Role,
        isSharedDevice: false,
      })
      return
    }

    /*
     * `name` falls back to the EMPTY STRING, never to a placeholder.
     *
     * It was `?? 'Unknown user'`, and that is the most dangerous shape of this
     * defect because it is at the SOURCE: every screen downstream reads
     * `user.name` and stamps it as the actor on a record — a damage approval, a
     * late-fee waiver, a cleaning attribution, a CSV export's provenance row.
     * Those screens now guard by asking whether a name exists, and
     * `'Unknown user'` is a non-empty string, so it sails through every one of
     * them and lands in the record as though someone signed it.
     *
     * An empty string fails those guards, which is the point: a session whose
     * staff row carries no name and no email cannot attribute work, and the
     * screens refuse rather than writing a name nobody has. The identity is
     * still valid for reading — `id` and `role` are real and RLS answers to
     * them; it is only attribution that is withheld.
     *
     * RESOLVED 12 Aug 2026 — this was a `TODO(decision)` asking whether a staff
     * row may exist with no `full_name`. It may not: `users.full_name` is
     * **NOT NULL** on the live database (checked directly, alongside `email` and
     * `primary_role`, all three NOT NULL). So for a row that EXISTS, `full_name`
     * is always present and the `?? fallbackEmail ?? ''` chain never degrades.
     *
     * The empty string is kept anyway, and is not dead defence: the branch above
     * — an authenticated user carrying NO staff row at all — has no `full_name`
     * to read, and `fallbackEmail` is itself optional. That is the case the
     * empty string exists for, and it is a real state (an auth user created
     * outside the staff table).
     */
    setUser({
      id: data.id,
      name: data.full_name ?? fallbackEmail ?? '',
      role: data.primary_role as Role,
      isSharedDevice: false,
    })
  }, [])

  useEffect(() => {
    let cancelled = false

    supabase.auth.getSession().then(({ data }) => {
      if (cancelled) return
      const session = data.session
      if (!session) {
        setUser(null)
        setLoading(false)
        return
      }
      void loadProfile(session.user.id, session.user.email).finally(() => {
        if (!cancelled) setLoading(false)
      })
    })

    const { data: sub } = supabase.auth.onAuthStateChange((event, session) => {
      if (cancelled) return

      /*
       * A recovery link is the ONLY way `PASSWORD_RECOVERY` fires. Supabase
       * establishes a real session when the link is followed, so without this
       * flag `/reset-password` cannot tell "arrived by clicking the emailed
       * link" from "already signed in and typed the URL". The first may set a
       * new password without knowing the old one; the second is a stranger at
       * an unattended desk. `setPasswordRecovery(false)` is deliberately NOT
       * called on other events — the flag is cleared by `updatePassword`
       * succeeding or by `logout`, so a token refresh mid-form does not eject
       * someone from the screen they are legitimately using.
       */
      if (event === 'PASSWORD_RECOVERY') setPasswordRecovery(true)
      if (event === 'SIGNED_IN' && session) recordLogin(session.user.id, session.user.last_sign_in_at)

      if (!session) {
        setUser(null)
        setLoading(false)
        return
      }
      void loadProfile(session.user.id, session.user.email).finally(() => {
        if (!cancelled) setLoading(false)
      })
    })

    return () => {
      cancelled = true
      sub.subscription.unsubscribe()
    }
  }, [loadProfile])

  /**
   * Supabase Auth, and nothing else.
   *
   * ⛔ There were two dev doors here — `VITE_DEV_AUTH_BYPASS` (Owner on page
   * load, no credentials) and a credential fallback (Owner for
   * `owner@babinrentals.com` / `babindulal7@gmail.com` with `123`). Both were
   * removed 12 Aug 2026. Do not reintroduce either.
   *
   * They set the React `user` without signing in to Supabase, so there was no
   * JWT: every query went out as `anon`, RLS denied it, and the app rendered a
   * header reading "Owner" over empty lists — HTTP 200, no error, correct-looking
   * empty states. That failure has no symptom, and it cost a full session: a
   * database holding 120 seeded bookings was twice diagnosed as an empty
   * database, and two migrations were written against the wrong cause before the
   * request logs settled it.
   *
   * Both doors carried a loud `console.warn` saying exactly this would happen.
   * It was not enough — which is the argument against any replacement.
   *
   * The convenience they bought is real but narrow: driving layout, gating and
   * refusal paths. Anything about data arriving needs a session RLS will answer,
   * and only this call produces one.
   */
  const signIn = useCallback(async (email: string, password: string) => {
    const { error } = await supabase.auth.signInWithPassword({ email, password })
    // onAuthStateChange populates `user`; only the failure path is reported here.
    return { error: error ? error.message : null }
  }, [])

  /**
   * Email a password-reset link. Built 15 Aug 2026.
   *
   * ## ⚠ A `null` error here does NOT mean an email was sent
   *
   * `resetPasswordForEmail` answers identically for an address that has an
   * account and one that does not — that is deliberate on Supabase's side, and
   * it is the correct behaviour: an endpoint that distinguishes them is an
   * account-enumeration oracle, and the accounts in question are staff of a
   * business whose client list is commercially sensitive.
   *
   * The consequence for this app is specific and it is the whole reason this
   * comment is long: **the screen must not say "we sent you an email."** It
   * cannot know that. `ForgotPassword.tsx` says "if that address has an account"
   * instead, which is the true statement and costs the operator nothing. Writing
   * the confident sentence here would put a fresh entry in
   * `SUCCESS_FABRICATION_REGISTER_2026-08-12.md` — a screen reporting an
   * outcome it did not verify — three days after that register was closed.
   *
   * ## `redirectTo` is not enough on its own
   *
   * The link only returns to this app if the URL is in the project's **Auth →
   * URL Configuration → Redirect URLs** allow-list. It is not set from code and
   * no migration can set it; an unlisted URL silently falls back to the Site
   * URL, which sends the operator somewhere else entirely with a valid token in
   * the address bar. Add `http://localhost:3000/reset-password` for development
   * and the deployed origin for production.
   */
  const requestPasswordReset = useCallback(async (email: string) => {
    /*
     * The mock data source's auth stub implements getSession, signInWithPassword,
     * onAuthStateChange and signOut, and nothing else — reasonably, since it
     * accepts any password for three known addresses and so has no password to
     * reset. Calling straight through would be a TypeError in the console and a
     * spinner that never resolves on the screen. Refused by name instead.
     */
    if (typeof supabase.auth.resetPasswordForEmail !== 'function') {
      return {
        error:
          'Password reset needs the live Supabase project, and this build is running on the mock data ' +
          'source (VITE_DATA_SOURCE=mock). Mock sign-in accepts any password, so there is nothing to reset.',
      }
    }

    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${window.location.origin}/reset-password`,
    })
    return { error: error ? error.message : null }
  }, [])

  /**
   * Set a new password on the session a recovery link established.
   *
   * Supabase requires a session for this call and the recovery link provides
   * one, which is why there is no "old password" field: possession of the link
   * sent to the address on the staff row IS the proof. It will also succeed for
   * an ordinary signed-in session, which is what makes `isPasswordRecovery`
   * necessary on the screen rather than here — this function's job is the write,
   * not deciding who may reach it.
   */
  const updatePassword = useCallback(async (password: string) => {
    // Same reason as `requestPasswordReset` — the mock stub has no `updateUser`.
    if (typeof supabase.auth.updateUser !== 'function') {
      return {
        error:
          'Setting a password needs the live Supabase project, and this build is running on the mock data ' +
          'source (VITE_DATA_SOURCE=mock).',
      }
    }

    const { error } = await supabase.auth.updateUser({ password })
    if (!error) setPasswordRecovery(false)
    return { error: error ? error.message : null }
  }, [])

  /*
   * ── the staff PIN (migration 0066) ────────────────────────────────────────
   *
   * Four thin bindings. Every rule that matters — the 6-digit shape, the weak-PIN
   * list, the 5-attempt ceiling, the 15-minute lockout, "one live PIN per person"
   * — lives in the database, not here. That is not tidiness: this file runs in the
   * browser, so anything it enforces is a suggestion. The RPCs are reachable with
   * a fetch and no numpad.
   *
   * The mock data source implements `rpc()` and answers unimplemented functions
   * with PostgREST error 42883, so calling straight through would technically
   * work and would surface `[mock] rpc("verify_staff_pin") is not implemented`.
   * That is honest but it reads as a bug. Refused by name instead, matching
   * `requestPasswordReset` above.
   */

  const setStaffPin = useCallback(async (pin: string) => {
    if (IS_MOCK) {
      return {
        error:
          'Setting a PIN needs the live Supabase project, and this build is running on the mock data ' +
          'source (VITE_DATA_SOURCE=mock). The mock store has no staff_auth_pins table to write to.',
      }
    }

    // Wrapped for the same reason `verifyStaffPin` is: a thrown fetch must
    // become a returned error, not a rejected promise. The Settings test suite
    // caught this shape as an unhandled rejection while every assertion still
    // passed — a partial auth mock left the RPC undefined and the failure
    // surfaced nowhere the screen could show it.
    try {
      const { error } = await supabase.rpc('set_staff_pin', { p_pin: pin })
      // The database raises with the operator-facing sentence already written
      // ("That PIN is six identical digits. Choose another."), so it is passed
      // through rather than restated — one wording, one place to change it.
      if (!error) setHasPin(true)
      return { error: error ? error.message : null }
    } catch (cause) {
      return { error: cause instanceof Error ? cause.message : 'The PIN could not be set.' }
    }
  }, [])

  const verifyStaffPin = useCallback(async (pin: string): Promise<PinVerdict> => {
    if (IS_MOCK) {
      return {
        ok: false,
        reason: 'unavailable',
        message:
          'PIN unlock needs the live Supabase project, and this build is running on the mock data ' +
          'source (VITE_DATA_SOURCE=mock). Sign in with your password.',
      }
    }

    /*
     * FAILS CLOSED, and the try/catch is the reason this is not a one-liner.
     *
     * A thrown fetch — offline tablet, dead Wi-Fi in the warehouse, Kong
     * restarting — must not escape to the caller as a rejected promise. The
     * lock overlay awaits this; an unhandled rejection there leaves the numpad
     * disabled with no message, which an operator reads as "the tablet froze"
     * and resolves by force-quitting into a still-live session on a shared
     * device. So every failure becomes an explicit `ok: false`.
     */
    try {
      const { data, error } = await supabase.rpc('verify_staff_pin', { p_pin: pin })

      if (error) {
        return { ok: false, reason: 'unavailable', message: error.message }
      }

      const verdict = (data ?? {}) as Record<string, unknown>

      // `ok` is read strictly. A truthy-but-not-true value (a string "false", a
      // 1, a null) is not a match, and this is the one comparison in the app
      // where being lenient would open a lock.
      return {
        ok: verdict['ok'] === true,
        reason: verdict['reason'] as PinVerdict['reason'],
        attemptsRemaining:
          typeof verdict['attempts_remaining'] === 'number'
            ? (verdict['attempts_remaining'] as number)
            : undefined,
        lockedUntil: (verdict['locked_until'] as string | null) ?? null,
      }
    } catch (cause) {
      return {
        ok: false,
        reason: 'unavailable',
        message: cause instanceof Error ? cause.message : 'The PIN could not be checked.',
      }
    }
  }, [])

  const staffPinStatus = useCallback(async (): Promise<PinStatus> => {
    if (IS_MOCK) return { hasPin: false }

    /*
     * `hasPin: false` on every failure, and that default is chosen rather than
     * convenient.
     *
     * This drives a settings row that offers either "Set a PIN" or
     * "Change / Remove". Defaulting the other way — assuming a PIN exists
     * because the check failed — would offer Remove for something that may not
     * be there and hide the only action that helps. Under-claiming is the safe
     * direction for a credential the caller cannot see.
     *
     * It does NOT gate the lock screen; `verifyStaffPin` answers that
     * separately, and it fails closed.
     */
    try {
      const { data, error } = await supabase.rpc('staff_pin_status')
      if (error) return { hasPin: false, unavailable: loadFailureReason(error.message) }
      if (!data) return { hasPin: false, unavailable: 'The PIN status check returned nothing.' }

      const status = data as Record<string, unknown>
      return {
        hasPin: status['has_pin'] === true,
        setAt: (status['set_at'] as string | null) ?? null,
        lockedUntil: (status['locked_until'] as string | null) ?? null,
        lastUsedAt: (status['last_used_at'] as string | null) ?? null,
      }
    } catch (cause) {
      return { hasPin: false, unavailable: loadFailureReason(cause) }
    }
  }, [])

  const revokeOwnStaffPin = useCallback(async () => {
    if (IS_MOCK) {
      return { error: 'Removing a PIN needs the live Supabase project (VITE_DATA_SOURCE=mock).' }
    }
    try {
      const { error } = await supabase.rpc('revoke_own_staff_pin')
      // Keeps `hasPin` — and therefore the idle branch between lock and
      // sign-out — correct without waiting for the next status read.
      if (!error) setHasPin(false)
      return { error: error ? error.message : null }
    } catch (cause) {
      return { error: cause instanceof Error ? cause.message : 'The PIN could not be removed.' }
    }
  }, [])

  /**
   * Kept synchronous-looking because existing call sites (`Header`,
   * `HandoverSheet`) call it and then navigate in the same tick. Clearing local
   * state immediately is the honest behaviour — the network sign-out that
   * follows cannot fail in a way that should keep the session on screen.
   */
  const logout = useCallback(() => {
    const leavingId = userIdRef.current
    setUser(null)
    setLocked(false)
    setPasswordRecovery(false)
    setHasPin(false)
    /* G6: the Logout row is written while the session is still valid, then the sign-out follows (bounded). */
    void recordLogout(leavingId).finally(() => void supabase.auth.signOut())
    /*
     * Law 6 — the identity is leaving the device, so its rows must leave with
     * it. Workbox keys its two PostgREST caches on URL alone, so without this an
     * Owner's cached booking bodies (deposit_paisa, total_paisa) are served by
     * NetworkFirst to the money-blind user who signs in next on the same
     * warehouse tablet, where RLS can no longer reach them. The outbox is
     * deliberately spared — see `devicePurge.ts`.
     *
     * Fire-and-forget for the same reason `signOut()` is: this function is
     * called and then navigated away from in the same tick, and a sign-out must
     * never be blocked by a cache API.
     */
    void purgeDeviceReadCaches()
  }, [])

  /*
   * ── the lock trigger ──────────────────────────────────────────────────────
   *
   * Added 24 Aug 2026. Until then NOTHING in the app ever called
   * `setLocked(true)`: `App.tsx` rendered `ScreenLock` when `isLocked` and
   * cleared it on unlock, `HandoverSheet` called `logout()` rather than locking,
   * and `sessionTimeoutMinutes` — an editable, persisted setting reading
   * "Signed out after this long idle" — was read by no code at all. So the
   * screen lock was unreachable and the timeout was decoration.
   *
   * ## It locks. It never signs out. And it is OFF unless switched on.
   *
   * **Ruled by the owner, 25 Aug 2026**, overriding the sign-out fallback this
   * comment used to argue for. Two rules, both load-bearing:
   *
   *   1. **The idle lock is OFF by default.** `sessionTimeoutMinutes` stores `0`
   *      for off, and an absent/NaN/nonsense value is read as off too. The
   *      failure direction matters: a misread setting must not start
   *      interrupting people who never asked for it.
   *   2. **The PIN re-locks the screen; nothing here ever calls `logout()`.**
   *      With no PIN there is nothing to unlock with, so the timer does nothing
   *      at all rather than signing the operator out.
   *
   * The earlier reasoning — that a PIN-less session "cannot be reopened, so
   * locking would strand the operator at a curtain whose only exit is the
   * sign-out they were going to get anyway" — is sound about the curtain and
   * wrong about the cost. A packer signed out mid-Handover loses the session's
   * work; an unlocked screen in a warehouse does not. Given that trade the owner
   * ruled for the unlocked screen.
   *
   * This was not academic. `staffPinStatus()` returns `hasPin: false` whenever
   * the PIN RPCs are missing, which is the case on the live project today
   * (`0066`–`0068` are unapplied). Shipping the old branch would have signed
   * every production user out after 30 idle minutes — a behaviour nobody has
   * today, arriving with no lock screen and no Lock button.
   *
   * ## A timestamp plus one interval, not a timer per event
   *
   * Re-arming a `setTimeout` on every `mousemove` is thousands of timer
   * operations a minute on a page an operator is actively using. Recording a
   * number is free, and one 15-second interval does the comparison.
   *
   * It also behaves correctly when the tab is backgrounded, which the timer
   * approach does not: browsers throttle timers in hidden tabs, so a 30-minute
   * `setTimeout` can fire late or not at all. Comparing wall-clock time means a
   * tablet asleep for an hour locks on the first check after it wakes.
   */
  /*
   * Whether this session holds a PIN, resolved once per identity.
   *
   * The lock trigger below has to know BEFORE the timeout fires — asking at
   * that moment would mean an await between "idle" and "locked", and a failed
   * lookup there would have to choose between locking someone out of a session
   * they can reopen and leaving an idle tablet open. Resolving it up front makes
   * the timeout branch synchronous and certain.
   */
  useEffect(() => {
    if (!user) {
      setHasPin(false)
      return
    }
    let cancelled = false
    void staffPinStatus().then((status) => {
      if (!cancelled) setHasPin(status.hasPin)
    })
    return () => {
      cancelled = true
    }
  }, [user, staffPinStatus])

  const lastActivityAt = useRef(Date.now())

  const lockNow = useCallback(() => {
    if (!hasPin) return
    setLocked(true)
  }, [hasPin])

  /* G1: shared settings load once a staff session exists — before that, RLS would return nothing. */
  const signedInId = user?.id ?? null
  userIdRef.current = signedInId
  useEffect(() => {
    if (signedInId) void hydrateSharedSettings()
  }, [signedInId])

  useEffect(() => {
    // Nothing to lock when signed out, and no point re-arming while the curtain
    // is already drawn.
    if (!user || isLocked) return

    const minutes = Number(getSetting('sessionTimeoutMinutes'))
    // 0 is how the store spells "off", and off is the default (ruled 25 Aug
    // 2026). Anything unreadable is treated as off for the same reason: this
    // reads a value a user can edit, and the safe direction for a misread is
    // "do not start locking people out", not "fall back to 30 minutes".
    if (!Number.isFinite(minutes) || minutes < 1) return
    const timeoutMs = minutes * 60_000

    const note = () => {
      lastActivityAt.current = Date.now()
    }

    const EVENTS = ['mousedown', 'mousemove', 'keydown', 'touchstart', 'scroll', 'wheel'] as const
    for (const e of EVENTS) window.addEventListener(e, note, { passive: true })

    const id = window.setInterval(() => {
      if (Date.now() - lastActivityAt.current < timeoutMs) return
      // Lock only. No `logout()` branch — see the ruling above. A PIN-less
      // session simply keeps running; the alternative loses a packer's work.
      if (hasPin) setLocked(true)
    }, 15_000)

    // Start the clock from now rather than from whenever the last event was, so
    // enabling the lock does not immediately fire on a stale timestamp.
    note()

    return () => {
      window.clearInterval(id)
      for (const e of EVENTS) window.removeEventListener(e, note)
    }
  }, [user, isLocked, hasPin, logout])

  return (
    <AuthContext.Provider
      value={{
        user,
        loading,
        signIn,
        requestPasswordReset,
        updatePassword,
        isPasswordRecovery,
        logout,
        isLocked,
        setLocked,
        lockNow,
        hasPin,
        setStaffPin,
        verifyStaffPin,
        staffPinStatus,
        revokeOwnStaffPin,
      }}
    >
      {children}
    </AuthContext.Provider>
  )
}

const FALLBACK_AUTH_CONTEXT: AuthContextType = {
  user: null,
  loading: true,
  signIn: async () => ({ error: 'Auth not initialized' }),
  requestPasswordReset: async () => ({ error: 'Auth not initialized' }),
  updatePassword: async () => ({ error: 'Auth not initialized' }),
  isPasswordRecovery: false,
  logout: () => {},
  isLocked: false,
  setLocked: () => {},
  lockNow: () => {},
  hasPin: false,
  setStaffPin: async () => ({ error: 'Auth not initialized' }),
  verifyStaffPin: async () => ({ ok: false, reason: 'unavailable', message: 'Auth not initialized' }),
  staffPinStatus: async () => ({ hasPin: false }),
  revokeOwnStaffPin: async () => ({ error: 'Auth not initialized' }),
}

export function useAuth() {
  const context = useContext(AuthContext)
  if (context === undefined) {
    if (import.meta.env.DEV) {
      console.warn('[useAuth] Called outside AuthProvider or during HMR re-evaluation. Returning fallback loading state.')
    }
    return FALLBACK_AUTH_CONTEXT
  }
  return context
}
