          color: gate.ok ? STATUS.in.fg : STATUS.danger.fg,
          fontSize: 'var(--t-meta)',
          fontWeight: 600,
          lineHeight: 1.5,
        }}
      >
        <Icon name={gate.ok ? 'check' : 'alert_triangle'} size={15} style={{ flexShrink: 0, marginTop: 1 }} />
        <span>{gate.ok ? `${article(value)} ${value}% discount may be applied.` : gate.why}</span>
      </div>
    </>
  )
}

