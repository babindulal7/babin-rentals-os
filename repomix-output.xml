    const handleConfirm = vi.fn()
    const handleClose = vi.fn()

    await act(async () => {
      root.render(
        <MemoryRouter>
          <ReturnSettlementModal
            isOpen={true}
            onClose={handleClose}
            bookingNo="BK-2026-0715"
            clientName="Himalayan Films Pvt. Ltd."
            clientPhone="+9779800000001"
