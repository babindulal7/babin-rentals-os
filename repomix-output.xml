  color: var(--btn-primary-fg);
  border: 1px solid transparent;
}

.movement-card__cta-btn.is-dominant:hover {
  background: var(--hover-button);
  filter: brightness(1.08);
}

.movement-card__cta-btn.is-secondary,
.movement-card__cta-btn.is-prep {
