/**
 * src/components/ui/creation/CreationDrawer.tsx — Babin Rentals OS
 *
 * CreationDrawer component for New Equipment and New Expense workflows.
 *
 * Enforces:
 * - Law 6 Money Blindness: Daily rate, replacement value, acquisition costs,
 *   and expense amounts are completely absent for money-blind roles
 *   (Warehouse, Technician, Driver, Client).
 * - Touch targets >= 44x44px (Law 15).
 * - Safe dirty-state discard confirmation.
 * - Form validation (equipment name, category, tracking mode, serials).
 */

import React, { useEffect, useId, useState } from 'react'
import { createPortal } from 'react-dom'
import Icon from '../Icon'
import { Button } from '../Button'
import { useToast } from '../Toast'
import { useAuth } from '../../../lib/auth'
import { canViewMoney } from '../../../lib/rbac'
import { Modal } from '../Modal'

export interface CreationDrawerProps {
  isOpen: boolean
  actionId: string
  contextData?: Record<string, unknown> | undefined
  onClose: () => void
  onSuccess?: ((record: Record<string, unknown>) => void) | undefined
}

export function CreationDrawer({
  isOpen,
  actionId,
  contextData = {},
  onClose,
  onSuccess,
}: CreationDrawerProps) {
  const { user } = useAuth()
  const { showSuccessToast } = useToast()
  const formId = useId()
  const isMoneyViewer = user ? canViewMoney(user.role) : false

  // ── Equipment Form State ──
  const [eqName, setEqName] = useState('')
  const [eqCategory, setEqCategory] = useState('Camera')
  const [eqBrand, setEqBrand] = useState('')
  const [eqModel, setEqModel] = useState('')
  const [eqSerial, setEqSerial] = useState('')
  const [eqAssetId, setEqAssetId] = useState('')
  const [eqTrackingMode, setEqTrackingMode] = useState<'serialized' | 'bulk'>('serialized')
  const [eqQuantity, setEqQuantity] = useState(1)
  const [eqCondition, setEqCondition] = useState<'New' | 'Good' | 'Fair'>('Good')
  const [eqLocation, setEqLocation] = useState('Main Warehouse')
  const [eqAccessories, setEqAccessories] = useState('')
  const [eqDailyRate, setEqDailyRate] = useState('')
  const [eqReplacementCost, setEqReplacementCost] = useState('')

  // ── Expense Form State ──
  const [expTitle, setExpTitle] = useState('')
  const [expCategory, setExpCategory] = useState('Maintenance')
  const [expAmount, setExpAmount] = useState('')
  const [expDate, setExpDate] = useState(() => new Date().toISOString().split('T')[0] ?? '')
  const [expNotes, setExpNotes] = useState('')

  const [loading, setLoading] = useState(false)
  const [errors, setErrors] = useState<Record<string, string>>({})
  const [showDiscardConfirm, setShowDiscardConfirm] = useState(false)

  useEffect(() => {
    if (isOpen) {
      setEqName(typeof contextData.equipmentName === 'string' ? contextData.equipmentName : '')
      setEqCategory('Camera')
      setEqBrand('')
      setEqModel('')
      setEqSerial('')
      setEqAssetId('')
      setEqTrackingMode('serialized')
      setEqQuantity(1)
      setEqCondition('Good')
      setEqLocation('Main Warehouse')
      setEqAccessories('')
      setEqDailyRate('')
      setEqReplacementCost('')

      setExpTitle('')
      setExpCategory('Maintenance')
      setExpAmount('')
      setExpDate(new Date().toISOString().split('T')[0] ?? '')
      setExpNotes('')

      setErrors({})
      setShowDiscardConfirm(false)
    }
  }, [isOpen, contextData])

  const isDirty = Boolean(
    eqName ||
    eqBrand ||
    eqModel ||
    eqSerial ||
    eqAssetId ||
    eqAccessories ||
    eqDailyRate ||
    expTitle ||
    expAmount
  )

  const handleRequestClose = () => {
    if (isDirty) {
      setShowDiscardConfirm(true)
    } else {
      onClose()
    }
  }

  const handleSaveEquipment = async (e: React.FormEvent) => {
    e.preventDefault()
    const newErrors: Record<string, string> = {}
    if (!eqName.trim()) {
      newErrors.eqName = 'Equipment name is required.'
    }
    if (eqTrackingMode === 'serialized' && !eqSerial.trim()) {
      newErrors.eqSerial = 'Serial number is required for tracked assets.'
    }
    if (Object.keys(newErrors).length > 0) {
      setErrors(newErrors)
      return
    }

    setLoading(true)
    try {
      const record = {
        id: `eq-${Date.now()}`,
        name: eqName.trim(),
        category: eqCategory,
        brand: eqBrand.trim(),
        model: eqModel.trim(),
        serialNumber: eqSerial.trim(),
        assetId: eqAssetId.trim() || `EQ-${Date.now().toString().slice(-4)}`,
        trackingMode: eqTrackingMode,
        quantity: eqQuantity,
        condition: eqCondition,
        location: eqLocation,
        accessories: eqAccessories.trim() ? eqAccessories.split(',').map((s) => s.trim()) : [],
        // Financial fields included only if user is authorized
        ...(isMoneyViewer && eqDailyRate
          ? { dailyRate: Math.round(parseFloat(eqDailyRate) * 100) }
          : {}),
        ...(isMoneyViewer && eqReplacementCost
          ? { replacementCost: Math.round(parseFloat(eqReplacementCost) * 100) }
          : {}),
      }

      showSuccessToast(
        'Equipment Registered',
        `${eqName.trim()} has been added to inventory.`
      )

      onSuccess?.(record)
      onClose()
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Failed to register equipment.'
      setErrors({ form: msg })
    } finally {
      setLoading(false)
    }
  }

  const handleSaveExpense = async (e: React.FormEvent) => {
    e.preventDefault()
    const newErrors: Record<string, string> = {}
    if (!expTitle.trim()) {
      newErrors.expTitle = 'Expense title or payee is required.'
    }
    if (!expAmount.trim() || isNaN(Number(expAmount))) {
      newErrors.expAmount = 'Valid amount in NPR is required.'
    }
    if (Object.keys(newErrors).length > 0) {
      setErrors(newErrors)
      return
    }

    setLoading(true)
    try {
      const record = {
        id: `exp-${Date.now()}`,
        title: expTitle.trim(),
        category: expCategory,
        amountPaisa: Math.round(parseFloat(expAmount) * 100),
        date: expDate,
        notes: expNotes.trim(),
        recordedBy: user?.name ?? 'Staff',
      }

      showSuccessToast(
        'Expense Recorded',
        `${expTitle.trim()} logged under ${expCategory}.`
      )

      onSuccess?.(record)
      onClose()
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Failed to save expense.'
      setErrors({ form: msg })
    } finally {
      setLoading(false)
    }
  }

  if (!isOpen) return null

  const titleText = actionId === 'expense.new' ? 'New Expense' : 'New Equipment'
  const isEquipment = actionId !== 'expense.new'

  return createPortal(
    <div
      style={{
        position: 'fixed',
        inset: 0,
        zIndex: 'var(--z-drawer)',
        display: 'flex',
        justifyContent: 'flex-end',
      }}
    >
      {/* Backdrop */}
      <div
        onClick={handleRequestClose}
        style={{
          position: 'fixed',
          inset: 0,
          background: 'var(--scrim)',
          backdropFilter: 'blur(2px)',
          animation: 'fadeIn 150ms ease-out',
        }}
      />

      {/* Drawer Panel */}
      <aside
        role="dialog"
        aria-modal="true"
        aria-label={titleText}
        style={{
          position: 'relative',
          width: '100%',
          maxWidth: 480,
          height: '100dvh',
          background: 'var(--card)',
          borderLeft: '1px solid var(--border)',
          boxShadow: 'var(--shadow-modal, -4px 0 24px rgba(0,0,0,0.2))',
          display: 'flex',
          flexDirection: 'column',
          zIndex: 'calc(var(--z-drawer) + 1)',
          animation: 'slideInRight 200ms cubic-bezier(0.16, 1, 0.3, 1)',
        }}
      >
        {/* Header */}
        <div
          style={{
            padding: '16px 20px',
            borderBottom: '1px solid var(--border)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            background: 'var(--card2)',
          }}
        >
          <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
            <span
              style={{
                width: 32,
                height: 32,
                borderRadius: 'var(--r-btn, 8px)',
                background: 'var(--nav-active-bg)',
                color: 'var(--primary)',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
              }}
            >
              <Icon name={isEquipment ? 'box' : 'card'} size={18} />
            </span>
            <h2 style={{ margin: 0, fontSize: 'var(--t-h3, 18px)', fontWeight: 700, color: 'var(--text)' }}>
              {titleText}
            </h2>
          </div>
          <button
            type="button"
            onClick={handleRequestClose}
            aria-label="Close drawer"
            style={{
              minWidth: 44,
              minHeight: 44,
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              background: 'transparent',
              border: 'none',
              borderRadius: 'var(--r-btn, 8px)',
              color: 'var(--text2)',
              cursor: 'pointer',
            }}
          >
            <Icon name="close" size={18} />
          </button>
        </div>

        {/* Scrollable Body */}
        <div style={{ flex: 1, overflowY: 'auto', padding: 20 }}>
          {isEquipment ? (
            <form id={formId} onSubmit={handleSaveEquipment} style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
              {/* Equipment Name */}
              <div>
                <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                  Equipment Model Name *
                </label>
                <input
                  type="text"
                  value={eqName}
                  onChange={(e) => {
                    setEqName(e.target.value)
                    if (errors.eqName) setErrors((prev) => ({ ...prev, eqName: '' }))
                  }}
                  placeholder="e.g. Sony FX3 Cinema Camera"
                  autoFocus
                  style={{
                    width: '100%',
                    minHeight: 44,
                    padding: '0 12px',
                    borderRadius: 'var(--r-btn, 8px)',
                    border: `1px solid ${errors.eqName ? 'var(--danger)' : 'var(--border)'}`,
                    background: 'var(--card)',
                    color: 'var(--text)',
                    fontSize: 'var(--t-body, 14px)',
                  }}
                />
                {errors.eqName && (
                  <div style={{ color: 'var(--danger-text)', fontSize: 'var(--t-caption, 12px)', marginTop: 4 }}>
                    {errors.eqName}
                  </div>
                )}
              </div>

              {/* Category & Tracking Mode */}
              <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 10 }}>
                <div>
                  <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                    Category *
                  </label>
                  <select
                    value={eqCategory}
                    onChange={(e) => setEqCategory(e.target.value)}
                    style={{
                      width: '100%',
                      minHeight: 44,
                      padding: '0 10px',
                      borderRadius: 'var(--r-btn, 8px)',
                      border: '1px solid var(--border)',
                      background: 'var(--card)',
                      color: 'var(--text)',
                      fontSize: 'var(--t-body, 14px)',
                    }}
                  >
                    <option value="Camera">Camera</option>
                    <option value="Lens">Lens</option>
                    <option value="Lighting">Lighting</option>
                    <option value="Audio">Audio</option>
                    <option value="Grip">Grip & Rigging</option>
                    <option value="Drone">Drone</option>
                    <option value="Accessories">Accessories</option>
                  </select>
                </div>
                <div>
                  <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                    Tracking Mode
                  </label>
                  <select
                    value={eqTrackingMode}
                    onChange={(e) => setEqTrackingMode(e.target.value as 'serialized' | 'bulk')}
                    style={{
                      width: '100%',
                      minHeight: 44,
                      padding: '0 10px',
                      borderRadius: 'var(--r-btn, 8px)',
                      border: '1px solid var(--border)',
                      background: 'var(--card)',
                      color: 'var(--text)',
                      fontSize: 'var(--t-body, 14px)',
                    }}
                  >
                    <option value="serialized">Serialized (Individual Unit)</option>
                    <option value="bulk">Bulk / Quantity Tracked</option>
                  </select>
                </div>
              </div>

              {/* Brand & Model */}
              <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 10 }}>
                <div>
                  <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                    Brand
                  </label>
                  <input
                    type="text"
                    value={eqBrand}
                    onChange={(e) => setEqBrand(e.target.value)}
                    placeholder="e.g. Sony, Canon, Aputure"
                    style={{
                      width: '100%',
                      minHeight: 44,
                      padding: '0 10px',
                      borderRadius: 'var(--r-btn, 8px)',
                      border: '1px solid var(--border)',
                      background: 'var(--card)',
                      color: 'var(--text)',
                    }}
                  />
                </div>
                <div>
                  <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                    Model
                  </label>
                  <input
                    type="text"
                    value={eqModel}
                    onChange={(e) => setEqModel(e.target.value)}
                    placeholder="e.g. ILME-FX3"
                    style={{
                      width: '100%',
                      minHeight: 44,
                      padding: '0 10px',
                      borderRadius: 'var(--r-btn, 8px)',
                      border: '1px solid var(--border)',
                      background: 'var(--card)',
                      color: 'var(--text)',
                    }}
                  />
                </div>
              </div>

              {/* Serial & Asset ID */}
              <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 10 }}>
                <div>
                  <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                    Serial Number {eqTrackingMode === 'serialized' ? '*' : ''}
                  </label>
                  <input
                    type="text"
                    value={eqSerial}
                    onChange={(e) => {
                      setEqSerial(e.target.value)
                      if (errors.eqSerial) setErrors((prev) => ({ ...prev, eqSerial: '' }))
                    }}
                    placeholder="e.g. SN-8839210"
                    style={{
                      width: '100%',
                      minHeight: 44,
                      padding: '0 10px',
                      borderRadius: 'var(--r-btn, 8px)',
                      border: `1px solid ${errors.eqSerial ? 'var(--danger)' : 'var(--border)'}`,
                      background: 'var(--card)',
                      color: 'var(--text)',
                    }}
                  />
                  {errors.eqSerial && (
                    <div style={{ color: 'var(--danger-text)', fontSize: 'var(--t-caption, 12px)', marginTop: 4 }}>
                      {errors.eqSerial}
                    </div>
                  )}
                </div>
                <div>
                  <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                    Internal Asset Code
                  </label>
                  <input
                    type="text"
                    value={eqAssetId}
                    onChange={(e) => setEqAssetId(e.target.value)}
                    placeholder="Auto-minted if blank"
                    style={{
                      width: '100%',
                      minHeight: 44,
                      padding: '0 10px',
                      borderRadius: 'var(--r-btn, 8px)',
                      border: '1px solid var(--border)',
                      background: 'var(--card)',
                      color: 'var(--text)',
                    }}
                  />
                </div>
              </div>

              {/* Condition & Location */}
              <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 10 }}>
                <div>
                  <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                    Initial Condition
                  </label>
                  <select
                    value={eqCondition}
                    onChange={(e) => setEqCondition(e.target.value as 'New' | 'Good' | 'Fair')}
                    style={{
                      width: '100%',
                      minHeight: 44,
                      padding: '0 10px',
                      borderRadius: 'var(--r-btn, 8px)',
                      border: '1px solid var(--border)',
                      background: 'var(--card)',
                      color: 'var(--text)',
                    }}
                  >
                    <option value="New">New / Mint</option>
                    <option value="Good">Good / Field-ready</option>
                    <option value="Fair">Fair / Functional</option>
                  </select>
                </div>
                <div>
                  <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                    Storage Location
                  </label>
                  <input
                    type="text"
                    value={eqLocation}
                    onChange={(e) => setEqLocation(e.target.value)}
                    placeholder="e.g. Main Warehouse, Bay 2"
                    style={{
                      width: '100%',
                      minHeight: 44,
                      padding: '0 10px',
                      borderRadius: 'var(--r-btn, 8px)',
                      border: '1px solid var(--border)',
                      background: 'var(--card)',
                      color: 'var(--text)',
                    }}
                  />
                </div>
              </div>

              {/* Included Accessories */}
              <div>
                <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                  Included Accessories (comma separated)
                </label>
                <input
                  type="text"
                  value={eqAccessories}
                  onChange={(e) => setEqAccessories(e.target.value)}
                  placeholder="e.g. 2x Batteries, Dual Charger, Top Handle, Hard Case"
                  style={{
                    width: '100%',
                    minHeight: 44,
                    padding: '0 10px',
                    borderRadius: 'var(--r-btn, 8px)',
                    border: '1px solid var(--border)',
                    background: 'var(--card)',
                    color: 'var(--text)',
                  }}
                />
              </div>

              {/* LAW 6 ENFORCEMENT: Financial details HIDDEN for money-blind roles */}
              {isMoneyViewer && (
                <div
                  style={{
                    padding: 12,
                    borderRadius: 'var(--r-btn, 8px)',
                    background: 'var(--card2)',
                    border: '1px solid var(--border)',
                    display: 'flex',
                    flexDirection: 'column',
                    gap: 10,
                  }}
                >
                  <div style={{ fontSize: 'var(--t-meta, 13px)', fontWeight: 600, color: 'var(--text)' }}>
                    Commercial Pricing & Value (NPR)
                  </div>
                  <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 10 }}>
                    <div>
                      <label style={{ fontSize: 'var(--t-caption, 12px)', color: 'var(--text2)', display: 'block', marginBottom: 2 }}>
                        Daily Rental Rate (Rs.)
                      </label>
                      <input
                        type="number"
                        min="0"
                        value={eqDailyRate}
                        onChange={(e) => setEqDailyRate(e.target.value)}
                        placeholder="e.g. 3500"
                        style={{
                          width: '100%',
                          minHeight: 44,
                          padding: '0 10px',
                          borderRadius: 'var(--r-btn, 8px)',
                          border: '1px solid var(--border)',
                          background: 'var(--card)',
                          color: 'var(--text)',
                        }}
                      />
                    </div>
                    <div>
                      <label style={{ fontSize: 'var(--t-caption, 12px)', color: 'var(--text2)', display: 'block', marginBottom: 2 }}>
                        Replacement Value (Rs.)
                      </label>
                      <input
                        type="number"
                        min="0"
                        value={eqReplacementCost}
                        onChange={(e) => setEqReplacementCost(e.target.value)}
                        placeholder="e.g. 450000"
                        style={{
                          width: '100%',
                          minHeight: 44,
                          padding: '0 10px',
                          borderRadius: 'var(--r-btn, 8px)',
                          border: '1px solid var(--border)',
                          background: 'var(--card)',
                          color: 'var(--text)',
                        }}
                      />
                    </div>
                  </div>
                </div>
              )}
            </form>
          ) : (
            /* Expense Form */
            <form id={formId} onSubmit={handleSaveExpense} style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
              <div>
                <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                  Expense Title / Payee *
                </label>
                <input
                  type="text"
                  value={expTitle}
                  onChange={(e) => {
                    setExpTitle(e.target.value)
                    if (errors.expTitle) setErrors((prev) => ({ ...prev, expTitle: '' }))
                  }}
                  placeholder="e.g. Cable replacement at New Road"
                  autoFocus
                  style={{
                    width: '100%',
                    minHeight: 44,
                    padding: '0 12px',
                    borderRadius: 'var(--r-btn, 8px)',
                    border: `1px solid ${errors.expTitle ? 'var(--danger)' : 'var(--border)'}`,
                    background: 'var(--card)',
                    color: 'var(--text)',
                  }}
                />
                {errors.expTitle && (
                  <div style={{ color: 'var(--danger-text)', fontSize: 'var(--t-caption, 12px)', marginTop: 4 }}>
                    {errors.expTitle}
                  </div>
                )}
              </div>

              <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 10 }}>
                <div>
                  <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                    Amount (NPR) *
                  </label>
                  <input
                    type="number"
                    min="0"
                    step="1"
                    value={expAmount}
                    onChange={(e) => {
                      setExpAmount(e.target.value)
                      if (errors.expAmount) setErrors((prev) => ({ ...prev, expAmount: '' }))
                    }}
                    placeholder="Rs. Amount"
                    style={{
                      width: '100%',
                      minHeight: 44,
                      padding: '0 10px',
                      borderRadius: 'var(--r-btn, 8px)',
                      border: `1px solid ${errors.expAmount ? 'var(--danger)' : 'var(--border)'}`,
                      background: 'var(--card)',
                      color: 'var(--text)',
                    }}
                  />
                  {errors.expAmount && (
                    <div style={{ color: 'var(--danger-text)', fontSize: 'var(--t-caption, 12px)', marginTop: 4 }}>
                      {errors.expAmount}
                    </div>
                  )}
                </div>
                <div>
                  <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                    Category
                  </label>
                  <select
                    value={expCategory}
                    onChange={(e) => setExpCategory(e.target.value)}
                    style={{
                      width: '100%',
                      minHeight: 44,
                      padding: '0 10px',
                      borderRadius: 'var(--r-btn, 8px)',
                      border: '1px solid var(--border)',
                      background: 'var(--card)',
                      color: 'var(--text)',
                    }}
                  >
                    <option value="Maintenance">Maintenance & Repairs</option>
                    <option value="Transport">Transport & Fuel</option>
                    <option value="Packaging">Consumables & Packaging</option>
                    <option value="Utilities">Office & Utilities</option>
                    <option value="SubRental">Sub-rental Expense</option>
                    <option value="Other">Other</option>
                  </select>
                </div>
              </div>

              <div>
                <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                  Date
                </label>
                <input
                  type="date"
                  value={expDate}
                  onChange={(e) => setExpDate(e.target.value)}
                  style={{
                    width: '100%',
                    minHeight: 44,
                    padding: '0 10px',
                    borderRadius: 'var(--r-btn, 8px)',
                    border: '1px solid var(--border)',
                    background: 'var(--card)',
                    color: 'var(--text)',
                  }}
                />
              </div>

              <div>
                <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                  Notes & Bill Reference
                </label>
                <textarea
                  rows={3}
                  value={expNotes}
                  onChange={(e) => setExpNotes(e.target.value)}
                  placeholder="Receipt number, vendor, or notes"
                  style={{
                    width: '100%',
                    padding: '8px 10px',
                    borderRadius: 'var(--r-btn, 8px)',
                    border: '1px solid var(--border)',
                    background: 'var(--card)',
                    color: 'var(--text)',
                    fontFamily: 'inherit',
                  }}
                />
              </div>
            </form>
          )}
        </div>

        {/* Footer */}
        <div
          style={{
            padding: '16px 20px',
            borderTop: '1px solid var(--border)',
            background: 'var(--card2)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'flex-end',
            gap: 10,
          }}
        >
          <Button variant="ghost" onClick={handleRequestClose} disabled={loading}>
            Cancel
          </Button>
          <Button
            variant="primary"
            icon="check"
            onClick={isEquipment ? handleSaveEquipment : handleSaveExpense}
            disabled={loading}
          >
            {loading ? 'Saving…' : isEquipment ? 'Add Equipment' : 'Record Expense'}
          </Button>
        </div>
      </aside>

      {/* Discard Confirmation Modal */}
      {showDiscardConfirm && (
        <Modal
          isOpen={true}
          onClose={() => setShowDiscardConfirm(false)}
          title="Discard Unsaved Changes?"
          size="sm"
        >
          <p style={{ margin: '0 0 16px', color: 'var(--text2)', fontSize: 'var(--t-body, 14px)' }}>
            You have unsaved changes in this drawer. Are you sure you want to discard them?
          </p>
          <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 8 }}>
            <Button variant="secondary" onClick={() => setShowDiscardConfirm(false)}>
              Keep Editing
            </Button>
            <Button
              variant="danger"
              onClick={() => {
                setShowDiscardConfirm(false)
                onClose()
              }}
            >
              Discard Changes
            </Button>
          </div>
        </Modal>
      )}
    </div>,
    document.body
  )
}
</file>

<file path="src/components/ui/creation/CreationWizard.tsx">
/**
 * src/components/ui/creation/CreationWizard.tsx — Babin Rentals OS
 *
 * 4-Step Creation Wizard for New Rental and New Quote workflows.
 *
 * Implements:
 * 1. Customer and rental details (AD + BS date support, 06:00-06:00 rental policy)
 * 2. Equipment, bundles and availability
 * 3. Duration, logistics, crew and commercial details
 * 4. Review, Save Draft and Confirm (distinct actions!)
 *
 * Rules:
 * - No booking confirmation when form opens.
 * - No equipment allocation until reservation/confirmation.
 * - Preserves unsaved draft when opening nested Add Client workflow.
 * - Money-blind roles (Law 6) never see rate calculations or pricing.
 * - Touch targets >= 44x44px (Law 15).
 */

import { useEffect, useState } from 'react'
import { useNavigate } from 'react-router-dom'
import { Modal } from '../Modal'
import { Button } from '../Button'
import Icon from '../Icon'
import { useToast } from '../Toast'
import { useAuth } from '../../../lib/auth'
import { toBs, formatBs } from '../../../lib/bs'
import { rentalDaysBetween } from '../../../lib/rentalDays'
import { QuickCreateDialog } from './QuickCreateDialog'

export interface CreationWizardProps {
  isOpen: boolean
  actionId: string
  contextData?: Record<string, unknown> | undefined
  onClose: () => void
  onSuccess?: ((record: Record<string, unknown>) => void) | undefined
}

export interface WizardDraftState {
  step: 1 | 2 | 3 | 4
  clientId: string
  clientName: string
  projectName: string
  startDate: string
  startTime: string
  endDate: string
  endTime: string
  deliveryType: 'Pickup' | 'Delivery'
  items: Array<{ id: string; name: string; quantity: number; ratePaisa?: number }>
  notes: string
}

export function CreationWizard({
  isOpen,
  actionId,
  contextData = {},
  onClose,
  onSuccess,
}: CreationWizardProps) {
  const navigate = useNavigate()
  useAuth()
  const { showSuccessToast } = useToast()
  const isQuote = actionId === 'quote.new'

  const [step, setStep] = useState<1 | 2 | 3 | 4>(1)

  // Draft Form State
  const [clientId, setClientId] = useState('')
  const [clientName, setClientName] = useState('')
  const [projectName, setProjectName] = useState('')
  const [startDate, setStartDate] = useState(() => {
    const d = new Date()
    return d.toISOString().split('T')[0] ?? '2026-07-31'
  })
  const [startTime, setStartTime] = useState('06:00')
  const [endDate, setEndDate] = useState(() => {
    const d = new Date()
    d.setDate(d.getDate() + 1)
    return d.toISOString().split('T')[0] ?? '2026-08-01'
  })
  const [endTime, setEndTime] = useState('06:00')
  const [deliveryType, setDeliveryType] = useState<'Pickup' | 'Delivery'>('Pickup')
  const [items, setItems] = useState<Array<{ id: string; name: string; quantity: number }>>([
    { id: 'item-1', name: 'Sony FX3 Cinema Camera Kit', quantity: 1 },
  ])
  const [newItemName, setNewItemName] = useState('')
  const [notes, setNotes] = useState('')

  // Nested Quick-Create Client dialog state
  const [quickClientOpen, setQuickClientOpen] = useState(false)
  const [loading, setLoading] = useState(false)
  const [errors, setErrors] = useState<Record<string, string>>({})

  useEffect(() => {
    if (isOpen) {
      setStep(1)
      if (typeof contextData.clientId === 'string') {
        setClientId(contextData.clientId)
      }
      if (typeof contextData.clientName === 'string') {
        setClientName(contextData.clientName)
      }
      if (typeof contextData.bookingNo === 'string') {
        setProjectName(`Derived from ${contextData.bookingNo}`)
      }
      setErrors({})
    }
  }, [isOpen, contextData])

  // Compute rental days according to 06:00-06:00 policy
  const startIso = `${startDate}T${startTime}:00Z`
  const endIso = `${endDate}T${endTime}:00Z`
  const computedDays = rentalDaysBetween(startIso, endIso)
  const dayCount = computedDays != null && computedDays > 0 ? computedDays : 1

  // Nepali BS Date calculations
  const bsStartStr = (() => {
    try {
      const bs = toBs(new Date(startIso))
      return bs ? formatBs(bs) : null
    } catch {
      return null
    }
  })()

  const bsEndStr = (() => {
    try {
      const bs = toBs(new Date(endIso))
      return bs ? formatBs(bs) : null
    } catch {
      return null
    }
  })()

  const handleAddItem = () => {
    if (!newItemName.trim()) return
    setItems((prev) => [
      ...prev,
      {
        id: `item-${Date.now()}`,
        name: newItemName.trim(),
        quantity: 1,
      },
    ])
    setNewItemName('')
  }

  const handleRemoveItem = (id: string) => {
    setItems((prev) => prev.filter((i) => i.id !== id))
  }

  const handleNestedClientCreated = (record: Record<string, unknown>) => {
    if (typeof record.id === 'string') setClientId(record.id)
    if (typeof record.name === 'string') setClientName(record.name)
    setQuickClientOpen(false)
    showSuccessToast(
      'Client Linked',
      `${String(record.name)} attached to this ${isQuote ? 'quote' : 'rental'}. Draft preserved.`
    )
  }

  const handleSaveDraft = async () => {
    setLoading(true)
    try {
      const draftRecord = {
        id: `draft-${Date.now()}`,
        isQuote,
        status: 'Draft',
        client: clientName || 'Walk-in Client',
        clientId,
        projectName: projectName || 'Untitled Project',
        startDate,
        endDate,
        rentalDays: dayCount,
        deliveryType,
        items,
        notes,
        createdAt: new Date().toISOString(),
      }

      showSuccessToast(
        isQuote ? 'Quote Draft Saved' : 'Rental Draft Saved',
        `${projectName || 'Draft'} saved. You can resume anytime from Rentals.`
      )

      onSuccess?.(draftRecord)
      onClose()
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Failed to save draft.'
      setErrors({ form: msg })
    } finally {
      setLoading(false)
    }
  }

  const handleConfirmBooking = async () => {
    if (!clientName.trim()) {
      setErrors({ client: 'Please specify or select a client before confirming.' })
      setStep(1)
      return
    }

    setLoading(true)
    try {
      const bookingNo = `BK-2026-${Math.floor(1000 + Math.random() * 9000)}`
      const record = {
        id: `booking-${Date.now()}`,
        bookingNo,
        status: isQuote ? 'Draft' : 'Booked',
        client: clientName,
        clientId,
        projectName,
        startDate,
        endDate,
        rentalDays: dayCount,
        deliveryType,
        items,
        notes,
        confirmedAt: new Date().toISOString(),
      }

      showSuccessToast(
        isQuote ? 'Quotation Generated' : 'Booking Confirmed',
        `${isQuote ? 'Quote' : 'Booking'} ${bookingNo} created for ${clientName}.`
      )

      onSuccess?.(record)
      onClose()
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Confirmation failed.'
      setErrors({ form: msg })
    } finally {
      setLoading(false)
    }
  }

  const handleOpenFullWorkspace = () => {
    onClose()
    navigate('/rentals?action=new')
  }

  const wizardTitle = isQuote ? 'New Commercial Quote' : 'New Rental Booking'

  return (
    <>
      <Modal
        isOpen={isOpen && !quickClientOpen}
        onClose={onClose}
        title={wizardTitle}
        subtitle={
          <span style={{ fontSize: 'var(--t-meta, 13px)', color: 'var(--muted)' }}>
            Step {step} of 4: {
              step === 1
                ? 'Client & Schedule'
                : step === 2
                  ? 'Equipment & Bundles'
                  : step === 3
                    ? 'Logistics & Crew'
                    : 'Review & Commitment'
            }
          </span>
        }
        size="lg"
      >
        <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
          {/* Step Progress Pills */}
          <div style={{ display: 'flex', alignItems: 'center', gap: 6, borderBottom: '1px solid var(--border)', paddingBottom: 12 }}>
            {[
              { num: 1, label: '1. Client & Dates' },
              { num: 2, label: '2. Equipment' },
              { num: 3, label: '3. Logistics' },
              { num: 4, label: '4. Review & Save' },
            ].map((s) => (
              <div
                key={s.num}
                style={{
                  flex: 1,
                  display: 'flex',
                  alignItems: 'center',
                  gap: 6,
                  padding: '6px 10px',
                  borderRadius: 'var(--r-btn, 8px)',
                  background: step === s.num ? 'var(--nav-active-bg)' : 'var(--card2)',
                  border: `1px solid ${step === s.num ? 'var(--primary)' : 'var(--border)'}`,
                  color: step === s.num ? 'var(--primary-text)' : 'var(--text2)',
                  fontWeight: step === s.num ? 700 : 500,
                  fontSize: 'var(--t-caption, 12px)',
                }}
              >
                <span>{s.label}</span>
              </div>
            ))}
          </div>

          {/* ── STEP 1: Client & Schedule ── */}
          {step === 1 && (
            <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
              {/* Client Selection */}
              <div>
                <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 4 }}>
                  <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)' }}>
                    Client *
                  </label>
                  <button
                    type="button"
                    onClick={() => setQuickClientOpen(true)}
                    style={{
                      background: 'transparent',
                      border: 'none',
                      color: 'var(--primary-text)',
                      cursor: 'pointer',
                      fontSize: 'var(--t-caption, 12px)',
                      fontWeight: 600,
                      display: 'flex',
                      alignItems: 'center',
                      gap: 4,
                    }}
                  >
                    <Icon name="plus" size={13} />
                    <span>Quick Add Client (Preserves Draft)</span>
                  </button>
                </div>
                <input
                  type="text"
                  value={clientName}
                  onChange={(e) => {
                    setClientName(e.target.value)
                    if (errors.client) setErrors((prev) => ({ ...prev, client: '' }))
                  }}
                  placeholder="Type client name or select..."
                  autoFocus
                  style={{
                    width: '100%',
                    minHeight: 44,
                    padding: '0 12px',
                    borderRadius: 'var(--r-btn, 8px)',
                    border: `1px solid ${errors.client ? 'var(--danger)' : 'var(--border)'}`,
                    background: 'var(--card)',
                    color: 'var(--text)',
                    fontSize: 'var(--t-body, 14px)',
                  }}
                />
                {errors.client && (
                  <div style={{ color: 'var(--danger-text)', fontSize: 'var(--t-caption, 12px)', marginTop: 4 }}>
                    {errors.client}
                  </div>
                )}
              </div>

              {/* Project Title */}
              <div>
                <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                  Project / Production Name
                </label>
                <input
                  type="text"
                  value={projectName}
                  onChange={(e) => setProjectName(e.target.value)}
                  placeholder="e.g. Commercial Shoot, Music Video, Wedding"
                  style={{
                    width: '100%',
                    minHeight: 44,
                    padding: '0 12px',
                    borderRadius: 'var(--r-btn, 8px)',
                    border: '1px solid var(--border)',
                    background: 'var(--card)',
                    color: 'var(--text)',
                  }}
                />
              </div>

              {/* Date & Time Range with 06:00-06:00 Rental Policy & BS display */}
              <div
                style={{
                  padding: 12,
                  borderRadius: 'var(--r-btn, 8px)',
                  background: 'var(--card2)',
                  border: '1px solid var(--border)',
                  display: 'flex',
                  flexDirection: 'column',
                  gap: 10,
                }}
              >
                <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
                  <div style={{ fontSize: 'var(--t-meta, 13px)', fontWeight: 600, color: 'var(--text)' }}>
                    Rental Schedule (06:00 → 06:00 Operational Policy)
                  </div>
                  <span className="eyebrow-pill" style={{ textTransform: 'none' }}>
                    {dayCount} {dayCount === 1 ? 'rental day' : 'rental days'}
                  </span>
                </div>

                <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 12 }}>
                  <div>
                    <label style={{ fontSize: 'var(--t-caption, 12px)', color: 'var(--text2)', display: 'block', marginBottom: 2 }}>
                      Pickup Date & Time
                    </label>
                    <div style={{ display: 'flex', gap: 6 }}>
                      <input
                        type="date"
                        value={startDate}
                        onChange={(e) => setStartDate(e.target.value)}
                        style={{
                          flex: 1,
                          minHeight: 44,
                          padding: '0 8px',
                          borderRadius: 'var(--r-btn, 8px)',
                          border: '1px solid var(--border)',
                          background: 'var(--card)',
                          color: 'var(--text)',
                        }}
                      />
                      <input
                        type="time"
                        value={startTime}
                        onChange={(e) => setStartTime(e.target.value)}
                        style={{
                          width: 85,
                          minHeight: 44,
                          padding: '0 6px',
                          borderRadius: 'var(--r-btn, 8px)',
                          border: '1px solid var(--border)',
                          background: 'var(--card)',
                          color: 'var(--text)',
                        }}
                      />
                    </div>
                    {bsStartStr && (
                      <div style={{ fontSize: '11px', color: 'var(--muted)', marginTop: 4 }}>
                        BS: {bsStartStr}
                      </div>
                    )}
                  </div>

                  <div>
                    <label style={{ fontSize: 'var(--t-caption, 12px)', color: 'var(--text2)', display: 'block', marginBottom: 2 }}>
                      Return Date & Time
                    </label>
                    <div style={{ display: 'flex', gap: 6 }}>
                      <input
                        type="date"
                        value={endDate}
                        onChange={(e) => setEndDate(e.target.value)}
                        style={{
                          flex: 1,
                          minHeight: 44,
                          padding: '0 8px',
                          borderRadius: 'var(--r-btn, 8px)',
                          border: '1px solid var(--border)',
                          background: 'var(--card)',
                          color: 'var(--text)',
                        }}
                      />
                      <input
                        type="time"
                        value={endTime}
                        onChange={(e) => setEndTime(e.target.value)}
                        style={{
                          width: 85,
                          minHeight: 44,
                          padding: '0 6px',
                          borderRadius: 'var(--r-btn, 8px)',
                          border: '1px solid var(--border)',
                          background: 'var(--card)',
                          color: 'var(--text)',
                        }}
                      />
                    </div>
                    {bsEndStr && (
                      <div style={{ fontSize: '11px', color: 'var(--muted)', marginTop: 4 }}>
                        BS: {bsEndStr}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* ── STEP 2: Equipment & Bundles ── */}
          {step === 2 && (
            <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
              <div style={{ display: 'flex', gap: 8 }}>
                <input
                  type="text"
                  value={newItemName}
                  onChange={(e) => setNewItemName(e.target.value)}
                  onKeyDown={(e) => {
                    if (e.key === 'Enter') {
                      e.preventDefault()
                      handleAddItem()
                    }
                  }}
                  placeholder="Search and add equipment or bundle..."
                  autoFocus
                  style={{
                    flex: 1,
                    minHeight: 44,
                    padding: '0 12px',
                    borderRadius: 'var(--r-btn, 8px)',
                    border: '1px solid var(--border)',
                    background: 'var(--card)',
                    color: 'var(--text)',
                  }}
                />
                <Button variant="primary" icon="plus" onClick={handleAddItem} disabled={!newItemName.trim()}>
                  Add Item
                </Button>
              </div>

              {/* Items List */}
              <div
                style={{
                  border: '1px solid var(--border)',
                  borderRadius: 'var(--r-btn, 8px)',
                  overflow: 'hidden',
                  background: 'var(--card)',
                }}
              >
                <div
                  style={{
                    padding: '8px 12px',
                    background: 'var(--card2)',
                    borderBottom: '1px solid var(--border)',
                    fontSize: 'var(--t-caption, 12px)',
                    fontWeight: 600,
                    color: 'var(--text2)',
                    display: 'flex',
                    justifyContent: 'space-between',
                  }}
                >
                  <span>Line Items ({items.length})</span>
                  <span>Quantity</span>
                </div>
                {items.length === 0 ? (
                  <div style={{ padding: 24, textAlign: 'center', color: 'var(--muted)' }}>
                    No equipment added yet. Add items above.
                  </div>
                ) : (
                  items.map((item) => (
                    <div
                      key={item.id}
                      style={{
                        padding: '10px 12px',
                        borderBottom: '1px solid var(--border)',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'space-between',
                      }}
                    >
                      <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                        <Icon name="box" size={16} />
                        <span style={{ fontWeight: 600, color: 'var(--text)' }}>{item.name}</span>
                      </div>
                      <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
                        <span className="eyebrow-pill" style={{ textTransform: 'none' }}>
                          Qty: {item.quantity}
                        </span>
                        <button
                          type="button"
                          onClick={() => handleRemoveItem(item.id)}
                          aria-label={`Remove ${item.name}`}
                          style={{
                            background: 'transparent',
                            border: 'none',
                            color: 'var(--danger-text)',
                            cursor: 'pointer',
                            padding: 4,
                          }}
                        >
                          <Icon name="close" size={15} />
                        </button>
                      </div>
                    </div>
                  ))
                )}
              </div>
            </div>
          )}

          {/* ── STEP 3: Logistics & Notes ── */}
          {step === 3 && (
            <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
              <div>
                <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 6 }}>
                  Handover & Dispatch Method
                </label>
                <div style={{ display: 'flex', gap: 10 }}>
                  {(['Pickup', 'Delivery'] as const).map((mode) => (
                    <button
                      key={mode}
                      type="button"
                      onClick={() => setDeliveryType(mode)}
                      style={{
                        flex: 1,
                        minHeight: 44,
                        padding: '0 12px',
                        borderRadius: 'var(--r-btn, 8px)',
                        border: `1px solid ${deliveryType === mode ? 'var(--primary)' : 'var(--border)'}`,
                        background: deliveryType === mode ? 'var(--nav-active-bg)' : 'var(--card)',
                        color: deliveryType === mode ? 'var(--primary-text)' : 'var(--text)',
                        fontWeight: deliveryType === mode ? 700 : 500,
                        cursor: 'pointer',
                        display: 'flex',
                        alignItems: 'center',
                        justifyContent: 'center',
                        gap: 6,
                        transition: 'all var(--dur-fast, 120ms) ease',
                      }}
                    >
                      <Icon name={mode === 'Pickup' ? 'package' : 'truck'} size={16} />
                      <span>{mode === 'Pickup' ? 'Self Pickup at Warehouse' : 'Delivery to Shoot Location'}</span>
                    </button>
                  ))}
                </div>
              </div>

              <div>
                <label style={{ fontSize: 'var(--t-caption, 12px)', fontWeight: 600, color: 'var(--text2)', display: 'block', marginBottom: 4 }}>
                  Logistics & Crew Notes
                </label>
                <textarea
                  rows={4}
                  value={notes}
                  onChange={(e) => setNotes(e.target.value)}
                  placeholder="Special instructions, designated driver/operator, security deposit notes..."
                  style={{
                    width: '100%',
                    padding: '8px 12px',
                    borderRadius: 'var(--r-btn, 8px)',
                    border: '1px solid var(--border)',
                    background: 'var(--card)',
                    color: 'var(--text)',
                    fontFamily: 'inherit',
                  }}
                />
              </div>
            </div>
          )}

          {/* ── STEP 4: Review, Save Draft & Confirm ── */}
          {step === 4 && (
            <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
              <div
                style={{
                  padding: 14,
                  borderRadius: 'var(--r-btn, 8px)',
                  background: 'var(--card2)',
                  border: '1px solid var(--border)',
                  display: 'flex',
                  flexDirection: 'column',
                  gap: 8,
                }}
              >
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                  <h3 style={{ margin: 0, fontSize: 'var(--t-h3, 16px)', fontWeight: 700, color: 'var(--text)' }}>
                    {projectName || 'Rental Booking Summary'}
                  </h3>
                  <span className="eyebrow-pill" style={{ textTransform: 'none' }}>
                    {isQuote ? 'Quotation' : 'Booking'}
                  </span>
                </div>
                <div style={{ fontSize: 'var(--t-meta, 13px)', color: 'var(--text2)' }}>
                  Client: <strong>{clientName || 'Unassigned'}</strong>
                </div>
                <div style={{ fontSize: 'var(--t-meta, 13px)', color: 'var(--text2)' }}>
                  Duration: {startDate} → {endDate} (<strong>{dayCount} {dayCount === 1 ? 'day' : 'days'}</strong>)
                </div>
                <div style={{ fontSize: 'var(--t-meta, 13px)', color: 'var(--text2)' }}>
                  Equipment Count: <strong>{items.length} lines</strong>
                </div>
                <div style={{ fontSize: 'var(--t-meta, 13px)', color: 'var(--text2)' }}>
                  Dispatch Mode: <strong>{deliveryType}</strong>
                </div>
              </div>

              <div
                style={{
                  padding: 12,
                  borderRadius: 'var(--r-btn, 8px)',
                  background: 'var(--chip-blue-bg)',
                  border: '1px solid var(--primary)',
                  fontSize: 'var(--t-caption, 12px)',
                  color: 'var(--chip-blue-fg)',
                  lineHeight: 1.5,
                }}
              >
                <strong>Rule Enforced:</strong> Save Draft preserves your choices without allocating physical gear or minting financial claims. Confirm Booking commits the reservation.
              </div>
            </div>
          )}

          {/* Navigation Controls */}
          <div
            style={{
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
              paddingTop: 14,
              borderTop: '1px solid var(--border)',
            }}
          >
            <div>
              {step > 1 ? (
                <Button variant="secondary" icon="chevron_left" onClick={() => setStep((s) => (s - 1) as 1 | 2 | 3 | 4)}>
                  Back
                </Button>
              ) : (
                <Button variant="ghost" onClick={handleOpenFullWorkspace} title="Switch to unconstrained four-step full page">
                  Open Full Page
                </Button>
              )}
            </div>

            <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
              <Button variant="ghost" onClick={onClose} disabled={loading}>
                Cancel
              </Button>

              {step < 4 ? (
                <Button variant="primary" icon="chevron_right" onClick={() => setStep((s) => (s + 1) as 1 | 2 | 3 | 4)}>
                  Continue
                </Button>
              ) : (
                <>
                  <Button variant="secondary" onClick={handleSaveDraft} disabled={loading}>
                    Save Draft
                  </Button>
                  <Button variant="primary" icon="check" onClick={handleConfirmBooking} disabled={loading}>
                    {loading ? 'Processing…' : isQuote ? 'Generate Quote' : 'Confirm Booking'}
                  </Button>
                </>
              )}
            </div>
          </div>
        </div>
      </Modal>

      {/* Nested Add Client Modal — Draft is completely preserved! */}
      {quickClientOpen && (
        <QuickCreateDialog
          isOpen={true}
          actionId="client.new"
          contextData={{ clientName }}
          onClose={() => setQuickClientOpen(false)}
          onSuccess={handleNestedClientCreated}
        />
      )}
    </>
  )
}
