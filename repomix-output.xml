                                                fontWeight: 600,
                                                cursor: 'pointer',
                                                fontFamily: 'inherit',
                                                border: verified
                                                  ? '1px solid var(--success)'
                                                  : dep.critical
                                                    ? '1px dashed var(--danger)'
