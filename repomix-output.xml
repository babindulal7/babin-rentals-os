}

.report-group-code {
  font-family: var(--font-id, 'Source Sans 3', sans-serif);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
  color: var(--muted);
  font-weight: 700;
  font-size: var(--t-meta, 13px);
}

.report-group-count {
  font-family: var(--font-id, 'Source Sans 3', sans-serif);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
  font-size: var(--t-meta, 12px);
  font-weight: 700;
  color: var(--text2);
  background: var(--card);
  border: 1px solid var(--border);
  padding: 2px 7px;
  border-radius: var(--r-pill, 9999px);
