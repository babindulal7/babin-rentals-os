                alignItems: 'center',
                gap: 6,
                minHeight: 44,
                padding: '0 12px',
                borderRadius: 'var(--r-sm)',
                border: `1px solid ${showKpis ? 'var(--nav-active-accent)' : 'var(--border)'}`,
                background: showKpis ? 'var(--select-bg)' : 'var(--card)',
                color: showKpis ? 'var(--select-fg)' : 'var(--text2)',
                fontSize: 'var(--t-meta)',
                fontWeight: 600,
                cursor: 'pointer',
                fontFamily: 'inherit',
