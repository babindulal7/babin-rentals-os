<file path="src/lib/queries/inventoryReports.ts">
import { supabase } from '../supabase'

/**
 * Inventory report — REAL counts only (Law 16, RULING 2026-10-06).
 *
 * The only honest source here is `product_units_v.status`, which carries no
 * money. Everything else the old page showed (utilization %, inventory
 * accuracy %, health tiers, category value) had no source and was a seeded
 * snapshot; those are absent and the page says "not measured".
 *
 * A failed read is `null`, never zero: zero would claim an empty warehouse.
 */

/** The locked ten `inventory_state` values, in the order of Inventory.md §4.1. */
export const INVENTORY_STATES = [
  'In Stock',
  'Reserved',
  'Packed',
  'On Rent',
  'Returning',
  'Inspection',
  'Cleaning',
  'Maintenance',
  'Missing',
  'Retired',
] as const

export type InventoryState = (typeof INVENTORY_STATES)[number]

export interface StatusCount {
  status: InventoryState
  count: number
}

export interface InventoryReportSummary {
  /** Units by lifecycle state. */
  byStatus: StatusCount[]
  /** Every unit ever registered, Retired included. */
  totalUnits: number
  /** Units still in the fleet: everything except Retired. */
  activeUnits: number
  /** Units in state `In Stock`. */
  inStock: number
}

/** Pure: derive the summary from per-status counts. */
export function summariseStatusCounts(byStatus: StatusCount[]): InventoryReportSummary {
  const totalUnits = byStatus.reduce((n, s) => n + s.count, 0)
  const retired = byStatus.find((s) => s.status === 'Retired')?.count ?? 0
  const inStock = byStatus.find((s) => s.status === 'In Stock')?.count ?? 0
  return { byStatus, totalUnits, activeUnits: totalUnits - retired, inStock }
}

/** Share of `total` as a whole percent; null when there is nothing to divide. */
export function sharePercent(count: number, total: number): number | null {
  return total > 0 ? Math.round((count / total) * 100) : null
}

/**
 * Throws when any read fails, so the page draws Error + Retry.
 *
 * RULING 2026-10-15: this returned `null` on failure and the page printed
 * "Could not load unit counts" with no way to retry; it now throws the first
 * failure's reason for `useLoad`. A count of `null` is a failure too — a
 * figure the read did not return is not a zero (Law 16). Revert = restore the
 * try/catch returning `null`.
 */
export async function getInventoryReportSummary(): Promise<InventoryReportSummary> {
  const results = await Promise.all(
    INVENTORY_STATES.map((status) =>
      supabase.from('product_units_v').select('id', { count: 'exact', head: true }).eq('status', status),
    ),
  )
  results.forEach((r, i) => {
    if (r.error) throw new Error(`getInventoryReportSummary failed on ${INVENTORY_STATES[i]}: ${r.error.message}`)
    if (r.count === null) throw new Error(`getInventoryReportSummary: no count returned for ${INVENTORY_STATES[i]}`)
  })
  return summariseStatusCounts(
    INVENTORY_STATES.map((status, i): StatusCount => ({ status, count: results[i]?.count ?? 0 })),
  )
}
</file>

<file path="src/lib/queries/liquidity.ts">
import { supabase } from '../supabase'
import { rupees, type Paisa } from '../money'
import { rowsOf, type ReportFilterOptions } from './reportSupport'

/**
 * Cash Flow and Working Capital — read from the ledgers, never from a seed.
 *
 * RULING 2026-10-16 (R-P6-STATES, Law 16): `getLiquiditySummary` read the
 * ledgers, then both pages discarded the result and rendered
 * `data/liquidityReports` — one invented closed month, an invented opening
 * balance, an invented Rs 56,000 equipment purchase — on every path. The read
 * itself was wrong three ways:
 *   - it filtered `payments.status = 'Completed'`, which is not a
 *     `payment_status` value (Received · Refunded · Failed · Cancelled, 0001):
 *     Postgres rejects the literal, so "collected" could never be read. It is
 *     `'Received'` (the same bug Pulse had — RULINGS-2026-10-16);
 *   - it selected `invoices.total` / `balance`, which do not exist (0006:
 *     `total_amount`, `outstanding_amount`);
 *   - it summed every payment, deposits included — but a deposit is a
 *     liability, never revenue or own cash (Law 4).
 *
 * Both reads now throw on failure (Error + Retry) and return honest zeros on
 * an empty period. What no table records — the bank balance, so opening and
 * closing cash, runway, capital spend, and therefore working capital itself —
 * is `null`, which the pages print as "Not tracked yet".
 * Revert = restore `getLiquiditySummary` and its `catch`.
 */

const money = (v: number | string | null | undefined): Paisa => rupees(Number(v ?? 0) || 0)
const sum = <T,>(rows: T[], f: (r: T) => number): Paisa => rows.reduce((a, r) => a + f(r), 0) as Paisa
const DAY = 86_400_000

export interface ExpenseCategoryLine {
  category: string
  amount: Paisa
}

export interface CashFlowSummary {
  /** Rental payments received in the period (Advance Payment, status Received). */
  collected: Paisa
  /** Refund payments made in the period. */
  refunds: Paisa
  /** Expenses with status Paid, by expense date. */
  expensesPaid: Paisa
  expensesByCategory: ExpenseCategoryLine[]
  /** collected − refunds − expensesPaid. */
  netOperatingCash: Paisa
  /** Deposits taken and given back in the period — held in trust, not own cash (Law 4). */
  depositsReceived: Paisa
  depositsReleased: Paisa
  /** Invoices issued in the period (not Draft/Void). */
  invoiced: Paisa
  /** collected ÷ invoiced; null when nothing was invoiced. */
  collectionRatePct: number | null
  /** No bank balance is recorded anywhere, so these have no source. */
  openingCash: null
  closingCash: null
  capitalSpend: null
  runwayMonths: null
}

export async function getCashFlowSummary(options: ReportFilterOptions = {}): Promise<CashFlowSummary> {
  let paymentsQ = supabase.from('payments').select('amount, payment_type').eq('status', 'Received')
  let expensesQ = supabase.from('expenses').select('amount, category_id').eq('status', 'Paid')
  let movementsQ = supabase.from('deposit_movements').select('movement_type, amount')
  let invoicesQ = supabase.from('invoices').select('total_amount').neq('status', 'Draft').neq('status', 'Void').is('voided_at', null)
  if (options.from) {
    paymentsQ = paymentsQ.gte('payment_date', options.from)
    expensesQ = expensesQ.gte('expense_date', options.from)
    movementsQ = movementsQ.gte('created_at', options.from)
    invoicesQ = invoicesQ.gte('issue_date', options.from)
  }
  if (options.to) {
    paymentsQ = paymentsQ.lte('payment_date', options.to)
    expensesQ = expensesQ.lte('expense_date', options.to)
    movementsQ = movementsQ.lte('created_at', options.to)
    invoicesQ = invoicesQ.lte('issue_date', options.to)
  }
  if (options.branchId) {
    paymentsQ = paymentsQ.eq('branch_id', options.branchId)
    expensesQ = expensesQ.eq('branch_id', options.branchId)
    invoicesQ = invoicesQ.eq('branch_id', options.branchId)
  }

  const [paymentsRes, expensesRes, categoriesRes, movementsRes, invoicesRes] = await Promise.all([
    paymentsQ,
    expensesQ,
    supabase.from('expense_categories').select('id, name'),
    movementsQ,
    invoicesQ,
  ])
  const payments = rowsOf<{ amount: number | string | null; payment_type: string }>(paymentsRes, 'Payments read failed')
  const expenses = rowsOf<{ amount: number | string | null; category_id: string | null }>(expensesRes, 'Expenses read failed')
  const categories = rowsOf<{ id: string; name: string | null }>(categoriesRes, 'Expense categories read failed')
  const movements = rowsOf<{ movement_type: string; amount: number | string | null }>(movementsRes, 'Deposit movements read failed')
  const invoices = rowsOf<{ total_amount: number | string | null }>(invoicesRes, 'Invoices read failed')

  const collected = sum(payments.filter((p) => p.payment_type === 'Advance Payment'), (p) => money(p.amount))
  const refunds = sum(payments.filter((p) => p.payment_type === 'Refund'), (p) => money(p.amount))
  const expensesPaid = sum(expenses, (e) => money(e.amount))
  const invoiced = sum(invoices, (i) => money(i.total_amount))

  const categoryName = new Map(categories.map((c) => [c.id, c.name?.trim() || '—']))
  const byCat = new Map<string, number>()
  for (const e of expenses) {
    const name = (e.category_id && categoryName.get(e.category_id)) || 'Uncategorised'
    byCat.set(name, (byCat.get(name) ?? 0) + money(e.amount))
  }

  return {
    collected,
    refunds,
    expensesPaid,
    expensesByCategory: [...byCat.entries()].map(([category, amount]) => ({ category, amount: amount as Paisa })).sort((a, b) => b.amount - a.amount),
    netOperatingCash: (collected - refunds - expensesPaid) as Paisa,
    depositsReceived: sum(movements.filter((m) => m.movement_type === 'Received'), (m) => money(m.amount)),
    depositsReleased: sum(movements.filter((m) => m.movement_type === 'Released'), (m) => money(m.amount)),
    invoiced,
    collectionRatePct: invoiced > 0 ? Math.round((collected / invoiced) * 100) : null,
    openingCash: null,
    closingCash: null,
    capitalSpend: null,
    runwayMonths: null,
  }
}

export interface ReceivableAgeing {
  label: string
  amount: Paisa
  invoices: number
}

export interface WorkingCapitalSummary {
  /** Outstanding on open invoices (Sent · Partially Paid · Overdue), now. */
  receivables: Paisa
  overdueReceivables: Paisa
  ageing: ReceivableAgeing[]
  /** Deposits held in trust now: received − refunded − applied (Law 4 — a liability). */
  depositsHeld: Paisa
  /** Expenses approved but not yet paid — the only payable the schema records. */
  approvedUnpaidExpenses: Paisa
  /** Days sales outstanding: receivables ÷ (invoiced over the last 90 days ÷ 90); null with no recent invoicing. */
  daysSalesOutstanding: number | null
  /** No bank balance and no supplier-invoice table: these have no source. */
  cash: null
  workingCapital: null
  currentRatio: null
}

const OPEN_STATUSES = ['Sent', 'Partially Paid', 'Overdue']

export async function getWorkingCapitalSummary(
  options: Pick<ReportFilterOptions, 'branchId'> = {},
  now: Date = new Date(),
): Promise<WorkingCapitalSummary> {
  const since = new Date(now.getTime() - 90 * DAY).toISOString().slice(0, 10)
  let openQ = supabase.from('invoices').select('outstanding_amount, due_date').in('status', OPEN_STATUSES).is('voided_at', null)
  let recentQ = supabase.from('invoices').select('total_amount').neq('status', 'Draft').neq('status', 'Void').is('voided_at', null).gte('issue_date', since)
  let depositsQ = supabase.from('security_deposits').select('received_amount, refunded_amount, applied_amount')
  let expensesQ = supabase.from('expenses').select('amount').eq('status', 'Approved')
  if (options.branchId) {
    openQ = openQ.eq('branch_id', options.branchId)
    recentQ = recentQ.eq('branch_id', options.branchId)
    depositsQ = depositsQ.eq('branch_id', options.branchId)
    expensesQ = expensesQ.eq('branch_id', options.branchId)
  }
  const [openRes, recentRes, depositsRes, expensesRes] = await Promise.all([openQ, recentQ, depositsQ, expensesQ])
  const open = rowsOf<{ outstanding_amount: number | string | null; due_date: string | null }>(openRes, 'Open invoices read failed')
  const recent = rowsOf<{ total_amount: number | string | null }>(recentRes, 'Recent invoices read failed')
  const deposits = rowsOf<{ received_amount: number | string | null; refunded_amount: number | string | null; applied_amount: number | string | null }>(
    depositsRes,
    'Security deposits read failed',
  )
  const expenses = rowsOf<{ amount: number | string | null }>(expensesRes, 'Expenses read failed')

  const buckets = [
    { label: 'Not yet due', min: -Infinity, max: 0 },
    { label: '1–30 days', min: 1, max: 30 },
    { label: '31–60 days', min: 31, max: 60 },
    { label: '61–90 days', min: 61, max: 90 },
    { label: '90+ days', min: 91, max: Infinity },
  ].map((b) => ({ ...b, amount: 0, invoices: 0 }))
  let receivables = 0
  let overdue = 0
  for (const o of open) {
    const amt = money(o.outstanding_amount)
    if (amt <= 0) continue
    receivables += amt
    const due = Date.parse(o.due_date ?? '')
    const days = Number.isNaN(due) ? 0 : Math.floor((now.getTime() - due) / DAY)
    if (days > 0) overdue += amt
    const bucket = buckets.find((b) => days >= b.min && days <= b.max)
    if (bucket) {
      bucket.amount += amt
      bucket.invoices++
    }
  }
  const recentInvoiced = sum(recent, (i) => money(i.total_amount))

  return {
    receivables: receivables as Paisa,
    overdueReceivables: overdue as Paisa,
    ageing: buckets.map((b) => ({ label: b.label, amount: b.amount as Paisa, invoices: b.invoices })),
    depositsHeld: sum(deposits, (d) => Math.max(0, money(d.received_amount) - money(d.refunded_amount) - money(d.applied_amount))),
    approvedUnpaidExpenses: sum(expenses, (e) => money(e.amount)),
    daysSalesOutstanding: recentInvoiced > 0 ? Math.round(receivables / (recentInvoiced / 90)) : null,
    cash: null,
    workingCapital: null,
    currentRatio: null,
  }
}
</file>

<file path="src/lib/queries/operationReports.ts">
import { supabase } from '../supabase'
import { embeddedName, percentOf, rowsOf, type ReportFilterOptions } from './reportSupport'

export type { ReportFilterOptions } from './reportSupport'

export interface OperationMetrics {
  totalPickups: number
  /** No source yet: nothing records the scheduled handover time a session is measured against. */
  onTimePickupRate: number | null
  totalReturns: number
  /** Share of returned bookings whose `actual_return_at` is on or before `return_at`; null when none has returned. */
  onTimeReturnRate: number | null
  currentlyOverdue: number
  totalPackingJobs: number
  /** No source yet: packing does not record a verified-vs-expected line count. */
  packingFulfillmentRate: number | null
  /** Share of completed handovers with government ID verified; null when there were none. */
  idVerificationRate: number | null
}

export interface DeliveryMethodBreakdown {
  method: string
  count: number
  percent: number
}

export interface PickupSessionItem {
  id: string
  bookingNo: string
  clientName: string
  pickupAt: string
  deliveryType: string
  receiverName: string
  idVerified: boolean
  staffName: string
  status: string
}

export interface ReturnConditionBreakdown {
  condition: string
  count: number
  percent: number
}

export interface ReturnSessionItem {
  id: string
  bookingNo: string
  clientName: string
  returnAt: string
  returningPerson: string
  /** The worst inspected condition on the session's lines, or "Not inspected". */
  condition: string
  damageSuspected: boolean
  status: string
}

export interface OverdueRentalItem {
  id: string
  bookingNo: string
  clientName: string
  project: string
  scheduledReturn: string
  daysOverdue: number
  deliveryType: string
  severity: 'moderate' | 'critical' | 'severe'
}

export interface PackingJobItem {
  id: string
  bookingNo: string
  clientName: string
  project: string
  pickupScheduled: string
  itemCount: number
  state: 'pending' | 'packed' | 'partial'
}

export interface OperationsReportData {
  metrics: OperationMetrics
  deliveryMethods: DeliveryMethodBreakdown[]
  returnConditions: ReturnConditionBreakdown[]
  pickups: PickupSessionItem[]
  returns: ReturnSessionItem[]
  overdueList: OverdueRentalItem[]
  packingJobs: PackingJobItem[]
}

/*
 * RULING 2026-10-16 (R-P6-STATES, Law 16): this read returned MOCK_OPERATIONS on
 * a failure and on an empty database, and patched figures one by one with
 * `|| MOCK_OPERATIONS.metrics…` — the on-time, fulfilment and ID rates were
 * literals (93.5, 88.1, 98.2, 95.7) on every path. It now throws on failure,
 * returns honest empties, and a rate with no source is `null` ("Not tracked
 * yet" on the page). Also fixed, each of which hid every live session:
 *   - `operation_kind` is Handover/Return (0001), not 'dispatch'/'return';
 *   - `session_state` is 'Completed', not 'completed';
 *   - `return_lines` has no cleaning_required/damage_suspected columns — the
 *     read failed silently; damage is now `condition` Damaged/Lost (0001
 *     `item_condition`), and cleaning is not claimed at all;
 *   - the staff name was the literal 'Warehouse Staff'; it is now the
 *     session's `warehouse_staff_id` user.
 * Revert = restore MOCK_OPERATIONS and the `catch`.
 */

const CONDITION_RANK: Record<string, number> = { Excellent: 0, Good: 1, Fair: 2, Damaged: 3, Lost: 4 }

type BookingRow = {
  id: string
  booking_no: string
  stage: string
  pickup_at: string
  return_at: string
  actual_return_at: string | null
  delivery_type: string | null
  project: string | null
  cancelled_at: string | null
  clients?: unknown
  booking_lines?: { qty: number | null; voided_at: string | null }[] | null
}

type SessionRow = {
  id: string
  booking_id: string
  operation: string
  state: string
  started_at: string | null
  completed_at: string | null
  cancelled_at: string | null
  warehouse_staff_id: string | null
  receiver_name: string | null
  pickup_person_name: string | null
  returning_person_name: string | null
  government_id_verified: boolean | null
}

type ReturnLineRow = { session_id: string | null; condition: string | null }

function severityOf(daysLate: number): OverdueRentalItem['severity'] {
  return daysLate >= 6 ? 'severe' : daysLate >= 3 ? 'critical' : 'moderate'
}

export async function getOperationsReport(options?: ReportFilterOptions, now: Date = new Date()): Promise<OperationsReportData> {
  let bookingsQuery = supabase
    .from('bookings')
    .select(
      'id, booking_no, stage, pickup_at, return_at, actual_return_at, delivery_type, project, cancelled_at, clients!client_id(name), booking_lines(qty, voided_at)',
    )
  if (options?.from) bookingsQuery = bookingsQuery.gte('pickup_at', options.from)
  if (options?.to) bookingsQuery = bookingsQuery.lte('pickup_at', options.to)
  if (options?.branchId) bookingsQuery = bookingsQuery.eq('branch_id', options.branchId)

  const [bookingsRes, sessionsRes, linesRes, usersRes] = await Promise.all([
    bookingsQuery,
    supabase
      .from('operation_sessions')
      .select(
        'id, booking_id, operation, state, started_at, completed_at, cancelled_at, warehouse_staff_id, receiver_name, pickup_person_name, returning_person_name, government_id_verified',
      )
      .in('operation', ['Handover', 'Return'])
      .order('completed_at', { ascending: false }),
    supabase.from('return_lines').select('session_id, condition'),
    supabase.from('users').select('id, full_name'),
  ])

  const bookings = rowsOf<BookingRow>(bookingsRes, 'Operations bookings read failed')
  const sessions = rowsOf<SessionRow>(sessionsRes, 'Operation sessions read failed')
  const returnLines = rowsOf<ReturnLineRow>(linesRes, 'Return lines read failed')
  const users = rowsOf<{ id: string; full_name: string | null }>(usersRes, 'Staff names read failed')

  const byId = new Map(bookings.map((b) => [b.id, b]))
  const staffName = new Map(users.map((u) => [u.id, u.full_name?.trim() || '—']))
  const nowMs = now.getTime()

  const deliveryMap = new Map<string, number>()
  const overdueList: OverdueRentalItem[] = []
  const packingJobs: PackingJobItem[] = []
  let returnedCount = 0
  let returnedOnTime = 0

  for (const b of bookings) {
    if (b.cancelled_at) continue
    const method = b.delivery_type || 'Not set'
    deliveryMap.set(method, (deliveryMap.get(method) ?? 0) + 1)

    if (b.actual_return_at) {
      returnedCount++
      if (Date.parse(b.actual_return_at) <= Date.parse(b.return_at)) returnedOnTime++
    }

    if (b.stage === 'On Rent' && !b.actual_return_at) {
      const retMs = Date.parse(b.return_at)
      if (!Number.isNaN(retMs) && retMs < nowMs) {
        const daysLate = Math.max(1, Math.floor((nowMs - retMs) / 86_400_000))
        overdueList.push({
          id: b.id,
          bookingNo: b.booking_no,
          clientName: embeddedName(b.clients),
          project: b.project?.trim() || '—',
          scheduledReturn: b.return_at,
          daysOverdue: daysLate,
          deliveryType: method,
          severity: severityOf(daysLate),
        })
      }
    }

    if (b.stage === 'Booked' || b.stage === 'Packed') {
      packingJobs.push({
        id: b.id,
        bookingNo: b.booking_no,
        clientName: embeddedName(b.clients),
        project: b.project?.trim() || '—',
        pickupScheduled: b.pickup_at,
        itemCount: (b.booking_lines ?? []).filter((l) => !l.voided_at).reduce((acc, l) => acc + (Number(l.qty) || 0), 0),
        state: b.stage === 'Packed' ? 'packed' : 'pending',
      })
    }
  }

  const worstBySession = new Map<string, string>()
  for (const l of returnLines) {
    if (!l.session_id || !l.condition) continue
    const prev = worstBySession.get(l.session_id)
    if (prev === undefined || (CONDITION_RANK[l.condition] ?? 0) > (CONDITION_RANK[prev] ?? 0)) worstBySession.set(l.session_id, l.condition)
  }

  const pickups: PickupSessionItem[] = []
  const returns: ReturnSessionItem[] = []
  let handovers = 0
  let idVerified = 0

  for (const s of sessions) {
    if (s.cancelled_at) continue
    const b = byId.get(s.booking_id)
    // A session outside the filtered bookings is outside the period/branch.
    if (!b || b.cancelled_at) continue
    const when = s.completed_at ?? s.started_at ?? ''
    const status = s.state
    if (s.operation === 'Handover') {
      if (s.state === 'Completed') {
        handovers++
        if (s.government_id_verified) idVerified++
      }
      pickups.push({
        id: s.id,
        bookingNo: b.booking_no,
        clientName: embeddedName(b.clients),
        pickupAt: when,
        deliveryType: b.delivery_type || 'Not set',
        receiverName: s.receiver_name?.trim() || s.pickup_person_name?.trim() || '—',
        idVerified: Boolean(s.government_id_verified),
        staffName: (s.warehouse_staff_id && staffName.get(s.warehouse_staff_id)) || '—',
        status,
      })
    } else if (s.operation === 'Return') {
      const condition = worstBySession.get(s.id) ?? 'Not inspected'
      returns.push({
        id: s.id,
        bookingNo: b.booking_no,
        clientName: embeddedName(b.clients),
        returnAt: when,
        returningPerson: s.returning_person_name?.trim() || '—',
        condition,
        damageSuspected: condition === 'Damaged' || condition === 'Lost',
        status,
      })
    }
  }

  const methodTotal = [...deliveryMap.values()].reduce((a, n) => a + n, 0)
  const condMap = new Map<string, number>()
  for (const r of returns) condMap.set(r.condition, (condMap.get(r.condition) ?? 0) + 1)

  return {
    metrics: {
      totalPickups: handovers,
      onTimePickupRate: null,
      totalReturns: returns.length,
      onTimeReturnRate: returnedCount > 0 ? Number(((returnedOnTime / returnedCount) * 100).toFixed(1)) : null,
      currentlyOverdue: overdueList.length,
      totalPackingJobs: packingJobs.length,
      packingFulfillmentRate: null,
      idVerificationRate: handovers > 0 ? Number(((idVerified / handovers) * 100).toFixed(1)) : null,
    },
    deliveryMethods: [...deliveryMap.entries()]
      .sort((a, b) => b[1] - a[1])
      .map(([method, count]) => ({ method, count, percent: percentOf(count, methodTotal) })),
    returnConditions: [...condMap.entries()]
      .sort((a, b) => (CONDITION_RANK[a[0]] ?? -1) - (CONDITION_RANK[b[0]] ?? -1))
      .map(([condition, count]) => ({ condition, count, percent: percentOf(count, returns.length) })),
    pickups: pickups.slice(0, 10),
    returns: returns.slice(0, 10),
    overdueList: overdueList.sort((a, b) => b.daysOverdue - a.daysOverdue),
    packingJobs: packingJobs.sort((a, b) => a.pickupScheduled.localeCompare(b.pickupScheduled)).slice(0, 10),
  }
}
</file>

<file path="src/lib/queries/productReports.ts">
import { supabase } from '../supabase'
import type { Paisa } from '../money'
import { lineValue, readLineValues, rowsOf, type ReportFilterOptions } from './reportSupport'

/**
 * Product Reports — catalogue, demand and stock, from the catalogue itself.
 *
 * RULING 2026-10-16 (R-P6-STATES, Law 16): this read counted `products_v`
 * (falling back to the seed list's length when the count was 0) and the page
 * rendered `data/productReports` — invented sales trends, profit trends,
 * turnover, returns, suppliers and products — on every path. It now returns:
 *
 *   - catalogue counts                     — `products` (active / total)
 *   - demand in the period                 — priced lines (`booking_lines_v`) on
 *                                            non-cancelled bookings picked up in it
 *   - revenue by category, top products    — the same lines, money-visible roles
 *                                            only (the view nulls rates otherwise)
 *   - products with no booking in period   — active products none of those lines name
 *   - at or below reorder level            — `total_quantity` ≤ `reorder_level`
 *
 * Profit, turnover, returns and supplier ranking have no source and are not
 * returned. Throws on failure; an empty catalogue is empty.
 * Revert = restore the seed re-exports and the `catch`.
 */

export interface ProductReportRow {
  productId: string
  name: string
  category: string
  bookings: number
  quantityBooked: number
  revenue: Paisa
}

export interface CategoryRevenue {
  category: string
  revenue: Paisa
  bookings: number
}

export interface LowStockRow {
  productId: string
  name: string
  onHand: number
  reorderLevel: number
}

export interface ProductReportsSummary {
  productCount: number
  activeProducts: number
  productsBooked: number
  revenue: Paisa
  byCategory: CategoryRevenue[]
  topRevenue: ProductReportRow[]
  /** Active products no booking in the period named. */
  notBooked: { productId: string; name: string; category: string }[]
  lowStock: LowStockRow[]
}

type ProductRow = {
  id: string
  name: string | null
  category_id: string | null
  is_active: boolean | null
  total_quantity: number | null
  reorder_level: number | null
}

export async function getProductReportsSummary(options?: ReportFilterOptions): Promise<ProductReportsSummary> {
  let bookingsQ = supabase.from('bookings').select('id').is('cancelled_at', null)
  if (options?.from) bookingsQ = bookingsQ.gte('pickup_at', options.from)
  if (options?.to) bookingsQ = bookingsQ.lte('pickup_at', options.to)
  if (options?.branchId) bookingsQ = bookingsQ.eq('branch_id', options.branchId)

  const [productsRes, categoriesRes, bookingsRes, lineMap] = await Promise.all([
    supabase.from('products').select('id, name, category_id, is_active, total_quantity, reorder_level'),
    supabase.from('inventory_categories').select('id, name'),
    bookingsQ,
    readLineValues(),
  ])
  const products = rowsOf<ProductRow>(productsRes, 'Products read failed')
  const categories = rowsOf<{ id: string; name: string | null }>(categoriesRes, 'Categories read failed')
  const bookings = rowsOf<{ id: string }>(bookingsRes, 'Bookings read failed')

  const categoryName = new Map(categories.map((c) => [c.id, c.name?.trim() || '—']))
  const catOf = (p: ProductRow | undefined) => (p?.category_id && categoryName.get(p.category_id)) || 'Uncategorised'
  const productById = new Map(products.map((p) => [p.id, p]))

  const perProduct = new Map<string, { bookings: Set<string>; qty: number; revenue: number }>()
  for (const b of bookings) {
    for (const l of lineMap.get(b.id) ?? []) {
      if (!l.product_id) continue
      const acc = perProduct.get(l.product_id) ?? { bookings: new Set<string>(), qty: 0, revenue: 0 }
      acc.bookings.add(b.id)
      acc.qty += Number(l.qty) || 0
      acc.revenue += lineValue(l)
      perProduct.set(l.product_id, acc)
    }
  }

  const rows: ProductReportRow[] = [...perProduct.entries()].map(([id, v]) => ({
    productId: id,
    name: productById.get(id)?.name?.trim() || '—',
    category: catOf(productById.get(id)),
    bookings: v.bookings.size,
    quantityBooked: v.qty,
    revenue: v.revenue as Paisa,
  }))

  const catMap = new Map<string, { revenue: number; bookings: Set<string> }>()
  for (const [id, v] of perProduct) {
    const cat = catOf(productById.get(id))
    const acc = catMap.get(cat) ?? { revenue: 0, bookings: new Set<string>() }
    acc.revenue += v.revenue
    v.bookings.forEach((b) => acc.bookings.add(b))
    catMap.set(cat, acc)
  }

  const active = products.filter((p) => p.is_active !== false)
  return {
    productCount: products.length,
    activeProducts: active.length,
    productsBooked: perProduct.size,
    revenue: rows.reduce((a, r) => a + r.revenue, 0) as Paisa,
    byCategory: [...catMap.entries()]
      .map(([category, v]) => ({ category, revenue: v.revenue as Paisa, bookings: v.bookings.size }))
      .sort((a, b) => b.revenue - a.revenue || b.bookings - a.bookings),
    topRevenue: [...rows].sort((a, b) => b.revenue - a.revenue || b.bookings - a.bookings).slice(0, 10),
    notBooked: active
      .filter((p) => !perProduct.has(p.id))
      .map((p) => ({ productId: p.id, name: p.name?.trim() || '—', category: catOf(p) }))
      .sort((a, b) => a.name.localeCompare(b.name)),
    lowStock: active
      .filter((p) => (p.reorder_level ?? 0) > 0 && (p.total_quantity ?? 0) <= (p.reorder_level ?? 0))
      .map((p) => ({ productId: p.id, name: p.name?.trim() || '—', onHand: p.total_quantity ?? 0, reorderLevel: p.reorder_level ?? 0 })),
  }
}
</file>

<file path="src/lib/queries/promotionsReports.ts">
import { supabase } from '../supabase'
import { rupees, type Paisa } from '../money'
import { linesValue, readLineValues, rowsOf, type ReportFilterOptions } from './reportSupport'

/**
 * Promotions & Discounts — coupons, redemptions, discount sources and bundles.
 *
 * RULING 2026-10-16 (R-P6-STATES, Law 16): this read counted coupons,
 * redemptions and bundles (with `|| 842`-style seed fallbacks), summed a
 * `booking_discounts.discount_amount` column that does not exist, and the page
 * rendered `data/promotionsReports` on every path. It now returns:
 *
 *   - per coupon: redemptions in the period and discount given — `coupon_redemptions`
 *   - revenue on bookings that redeemed a coupon — priced lines (`booking_lines_v`)
 *   - discounts by source (count and average percent) — `booking_discounts`
 *   - bundle lines booked and their value — `booking_lines_v.bundle_id`
 *
 * Throws on failure; a period with no promotion activity is empty.
 * Revert = restore the seed re-exports and the `catch`.
 */

export interface CouponPerformanceRow {
  couponId: string
  code: string
  discountPercent: number | null
  isActive: boolean
  redemptions: number
  discountGiven: Paisa
  bookingRevenue: Paisa
}

export interface DiscountSourceRow {
  source: string
  count: number
  averagePercent: number | null
}

export interface BundleUsageRow {
  bundleId: string
  name: string
  bookings: number
  revenue: Paisa
}

export interface PromotionsReportsSummary {
  couponCount: number
  activeCoupons: number
  redemptionCount: number
  discountsGiven: Paisa
  /** Value of the priced lines on bookings that redeemed a coupon in the period. */
  promotionRevenue: Paisa
  /** Revenue ÷ discount given; null when no discount was given. */
  returnOnPromotion: number | null
  coupons: CouponPerformanceRow[]
  discountSources: DiscountSourceRow[]
  bundles: BundleUsageRow[]
}

export async function getPromotionsReportsSummary(options?: ReportFilterOptions): Promise<PromotionsReportsSummary> {
  let redemptionsQ = supabase.from('coupon_redemptions').select('coupon_id, booking_id, discount_amount, redeemed_at')
  let discountsQ = supabase.from('booking_discounts').select('discount_source, percent, applied_at')
  let bookingsQ = supabase.from('bookings').select('id').is('cancelled_at', null)
  if (options?.from) {
    redemptionsQ = redemptionsQ.gte('redeemed_at', options.from)
    discountsQ = discountsQ.gte('applied_at', options.from)
    bookingsQ = bookingsQ.gte('pickup_at', options.from)
  }
  if (options?.to) {
    redemptionsQ = redemptionsQ.lte('redeemed_at', options.to)
    discountsQ = discountsQ.lte('applied_at', options.to)
    bookingsQ = bookingsQ.lte('pickup_at', options.to)
  }
  if (options?.branchId) {
    discountsQ = discountsQ.eq('branch_id', options.branchId)
    bookingsQ = bookingsQ.eq('branch_id', options.branchId)
  }

  const [couponsRes, redemptionsRes, discountsRes, bundlesRes, bookingsRes, lineMap] = await Promise.all([
    supabase.from('coupons').select('id, code, discount_percent, is_active'),
    redemptionsQ,
    discountsQ,
    supabase.from('bundles').select('id, name'),
    bookingsQ,
    readLineValues(),
  ])
  const coupons = rowsOf<{ id: string; code: string; discount_percent: number | string | null; is_active: boolean | null }>(couponsRes, 'Coupons read failed')
  const redemptions = rowsOf<{ coupon_id: string; booking_id: string; discount_amount: number | string | null }>(redemptionsRes, 'Coupon redemptions read failed')
  const discounts = rowsOf<{ discount_source: string | null; percent: number | string | null }>(discountsRes, 'Booking discounts read failed')
  const bundles = rowsOf<{ id: string; name: string | null }>(bundlesRes, 'Bundles read failed')
  const bookings = rowsOf<{ id: string }>(bookingsRes, 'Bookings read failed')

  const perCoupon = new Map<string, { n: number; discount: number; revenue: number }>()
  let discountsGiven = 0
  let promotionRevenue = 0
  for (const r of redemptions) {
    const d = rupees(Number(r.discount_amount ?? 0) || 0)
    const rev = linesValue(lineMap.get(r.booking_id))
    const acc = perCoupon.get(r.coupon_id) ?? { n: 0, discount: 0, revenue: 0 }
    acc.n++
    acc.discount += d
    acc.revenue += rev
    perCoupon.set(r.coupon_id, acc)
    discountsGiven += d
    promotionRevenue += rev
  }

  const sourceMap = new Map<string, { count: number; pctSum: number; pctN: number }>()
  for (const d of discounts) {
    const source = d.discount_source?.trim() || 'Not set'
    const acc = sourceMap.get(source) ?? { count: 0, pctSum: 0, pctN: 0 }
    acc.count++
    if (d.percent != null && d.percent !== '') {
      acc.pctSum += Number(d.percent) || 0
      acc.pctN++
    }
    sourceMap.set(source, acc)
  }

  const bundleName = new Map(bundles.map((b) => [b.id, b.name?.trim() || '—']))
  const perBundle = new Map<string, { bookings: Set<string>; revenue: number }>()
  for (const b of bookings) {
    for (const l of lineMap.get(b.id) ?? []) {
      if (!l.bundle_id) continue
      const acc = perBundle.get(l.bundle_id) ?? { bookings: new Set<string>(), revenue: 0 }
      acc.bookings.add(b.id)
      acc.revenue += linesValue([l])
      perBundle.set(l.bundle_id, acc)
    }
  }

  return {
    couponCount: coupons.length,
    activeCoupons: coupons.filter((c) => c.is_active !== false).length,
    redemptionCount: redemptions.length,
    discountsGiven: discountsGiven as Paisa,
    promotionRevenue: promotionRevenue as Paisa,
    returnOnPromotion: discountsGiven > 0 ? Number((promotionRevenue / discountsGiven).toFixed(1)) : null,
    coupons: coupons
      .map((c) => {
        const acc = perCoupon.get(c.id)
        return {
          couponId: c.id,
          code: c.code,
          discountPercent: c.discount_percent == null || c.discount_percent === '' ? null : Number(c.discount_percent),
          isActive: c.is_active !== false,
          redemptions: acc?.n ?? 0,
          discountGiven: (acc?.discount ?? 0) as Paisa,
          bookingRevenue: (acc?.revenue ?? 0) as Paisa,
        }
      })
      .sort((a, b) => b.redemptions - a.redemptions || a.code.localeCompare(b.code)),
    discountSources: [...sourceMap.entries()]
      .map(([source, v]) => ({ source, count: v.count, averagePercent: v.pctN > 0 ? Number((v.pctSum / v.pctN).toFixed(1)) : null }))
      .sort((a, b) => b.count - a.count),
    bundles: [...perBundle.entries()]
      .map(([id, v]) => ({ bundleId: id, name: bundleName.get(id) ?? '—', bookings: v.bookings.size, revenue: v.revenue as Paisa }))
      .sort((a, b) => b.revenue - a.revenue || b.bookings - a.bookings),
  }
}
</file>

<file path="src/lib/queries/rentalReports.ts">
import { supabase } from '../supabase'
import type { Paisa } from '../money'
import { rentalDaysBetween } from '../rentalDays'
import { embeddedName, isPermissionDenied, linesValue, percentOf, readLineValues, rowsOf, type ReportFilterOptions } from './reportSupport'

export type { ReportFilterOptions } from './reportSupport'

export interface RentalPerformanceMetrics {
  totalBookings: number
  activeRentals: number
  completedRentals: number
  cancelledRentals: number
  totalRevenue: Paisa
  averageBookingValue: Paisa
  totalRentalDays: number
  averageDurationDays: number
}

export interface StageBreakdownItem {
  stage: string
  count: number
  revenue: Paisa
  percent: number
}

export interface ProjectTypeBreakdownItem {
  projectType: string
  count: number
  revenue: Paisa
  percent: number
}

export interface TopBookingItem {
  id: string
  bookingNo: string
  clientName: string
  project: string
  days: number
  stage: string
  value: Paisa
}

export interface RentalPerformanceReportData {
  metrics: RentalPerformanceMetrics
  stages: StageBreakdownItem[]
  /**
   * Null when this session may not read `bookings.project_type` — the column
   * is granted by 0161/0162, which live does not have yet. The card then says
   * so instead of failing the whole report.
   */
  projectTypes: ProjectTypeBreakdownItem[] | null
  topBookings: TopBookingItem[]
}

export interface DurationBucket {
  key: string
  label: string
  minDays: number
  maxDays: number
  count: number
  sharePercent: number
  totalDays: number
  revenue: Paisa
  avgDailyRate: Paisa
}

export interface RentalDurationReportData {
  totalRentals: number
  averageDuration: number
  medianDuration: number
  longestDuration: number
  shortestDuration: number
  buckets: DurationBucket[]
}

export interface CancellationReasonItem {
  reason: string
  count: number
  percent: number
  lostRevenue: Paisa
}

export interface CancelledBookingItem {
  id: string
  bookingNo: string
  clientName: string
  project: string
  cancelledAt: string
  scheduledPickup: string
  lostRevenue: Paisa
  reason: string
}

export interface CancellationsReportData {
  totalCancellations: number
  cancellationRate: number
  totalLostRevenue: Paisa
  /** Mean days between cancelling and the scheduled pickup; null when no cancellation carries both dates. */
  averageNoticeDays: number | null
  reasons: CancellationReasonItem[]
  cancelledBookings: CancelledBookingItem[]
}

/*
 * RULING 2026-10-16 (R-P6-STATES, Law 16): these reads returned MOCK_PERFORMANCE /
 * MOCK_DURATION / MOCK_CANCELLATIONS on a failed read AND on an empty one, and
 * the trend was always the mock block. They now throw on failure (the page
 * draws Error + Retry) and return honest zeros on an empty period. Also fixed
 * while here, each of which made a live figure wrong:
 *   - cancellation is `bookings.cancelled_at` (0015), not `stage = 'Cancelled'`
 *     — Postgres rejects that literal, so the Cancellations tab could only ever
 *     show the mock block;
 *   - "completed" is Returned/Closed (the canonical six have no 'Completed');
 *   - money was computed in rupees then divided by 100 again (see `lineValue`);
 *   - line money was read from base `booking_lines`, whose rate columns 0062
 *     revokes — it now comes from `booking_lines_v` (`readLineValues`).
 * Revert = restore the MOCK_* constants and each `catch`.
 */

type BookingRow = {
  id: string
  booking_no: string
  stage: string
  pickup_at: string
  return_at: string
  project: string | null
  cancelled_at: string | null
  cancellation_reason?: string | null
  clients?: unknown
}

// Loosely typed on purpose: supabase-js's builder generics recurse past tsc's
// depth limit when threaded through a helper (TS2589).
// eslint-disable-next-line @typescript-eslint/no-explicit-any
type AnyQuery = any

function filtered(q: AnyQuery, options?: ReportFilterOptions): AnyQuery {
  let out = q
  if (options?.from) out = out.gte('pickup_at', options.from)
  if (options?.to) out = out.lte('pickup_at', options.to)
  if (options?.branchId) out = out.eq('branch_id', options.branchId)
  return out
}

function daysOf(b: Pick<BookingRow, 'pickup_at' | 'return_at'>): number {
  return rentalDaysBetween(b.pickup_at, b.return_at) ?? 1
}

export async function getRentalPerformanceReport(options?: ReportFilterOptions): Promise<RentalPerformanceReportData> {
  const [res, typeRes, lineMap] = await Promise.all([
    filtered(
      supabase.from('bookings').select('id, booking_no, stage, pickup_at, return_at, project, cancelled_at, clients!client_id(name)'),
      options,
    ),
    filtered(supabase.from('bookings').select('id, project_type'), options),
    readLineValues(),
  ])
  const rows = rowsOf<BookingRow>(res, 'Rental performance read failed')
  // The one tolerated refusal: a column grant live has not received yet.
  const typesReadable = !(typeRes.error && isPermissionDenied(typeRes.error))
  const typeById = new Map(
    (typesReadable ? rowsOf<{ id: string; project_type: string | null }>(typeRes, 'Project type read failed') : []).map((r) => [
      r.id,
      r.project_type,
    ]),
  )

  let totalRevenue = 0
  let totalRentalDays = 0
  let active = 0
  let completed = 0
  let cancelled = 0
  const stageMap = new Map<string, { count: number; revenue: number }>()
  const typeMap = new Map<string, { count: number; revenue: number }>()
  const top: TopBookingItem[] = []

  for (const b of rows) {
    const days = daysOf(b)
    const value = linesValue(lineMap.get(b.id), days)
    const isCancelled = b.cancelled_at != null
    const stage = isCancelled ? 'Cancelled' : b.stage
    if (isCancelled) cancelled++
    else if (b.stage === 'Packed' || b.stage === 'On Rent') active++
    else if (b.stage === 'Returned' || b.stage === 'Closed') completed++

    const st = stageMap.get(stage) ?? { count: 0, revenue: 0 }
    st.count++
    st.revenue += value
    stageMap.set(stage, st)

    const type = typeById.get(b.id)?.trim() || 'Not set'
    const pt = typeMap.get(type) ?? { count: 0, revenue: 0 }
    pt.count++
    pt.revenue += value
    typeMap.set(type, pt)

    if (isCancelled) continue
    totalRevenue += value
    totalRentalDays += days
    top.push({
      id: b.id,
      bookingNo: b.booking_no,
      clientName: embeddedName(b.clients),
      project: b.project?.trim() || '—',
      days,
      stage,
      value,
    })
  }

  const total = rows.length
  const live = total - cancelled
  top.sort((a, b) => b.value - a.value)

  return {
    metrics: {
      totalBookings: total,
      activeRentals: active,
      completedRentals: completed,
      cancelledRentals: cancelled,
      totalRevenue: totalRevenue as Paisa,
      averageBookingValue: (live > 0 ? Math.round(totalRevenue / live) : 0) as Paisa,
      totalRentalDays,
      averageDurationDays: live > 0 ? Number((totalRentalDays / live).toFixed(1)) : 0,
    },
    stages: [...stageMap.entries()]
      .sort((a, b) => b[1].count - a[1].count)
      .map(([stage, v]) => ({ stage, count: v.count, revenue: v.revenue as Paisa, percent: percentOf(v.count, total) })),
    projectTypes: !typesReadable
      ? null
      : [...typeMap.entries()]
      .sort((a, b) => b[1].count - a[1].count)
      .slice(0, 5)
      .map(([projectType, v]) => ({ projectType, count: v.count, revenue: v.revenue as Paisa, percent: percentOf(v.count, total) })),
    topBookings: top.slice(0, 5),
  }
}

const BUCKETS = [
  { key: '1d', label: '1 Day', minDays: 1, maxDays: 1 },
  { key: '2-3d', label: '2–3 Days', minDays: 2, maxDays: 3 },
  { key: '4-7d', label: '4–7 Days', minDays: 4, maxDays: 7 },
  { key: '8-14d', label: '8–14 Days', minDays: 8, maxDays: 14 },
  { key: '15d+', label: '15+ Days', minDays: 15, maxDays: 9999 },
] as const

export async function getRentalDurationReport(options?: ReportFilterOptions): Promise<RentalDurationReportData> {
  const [res, lineMap] = await Promise.all([
    filtered(supabase.from('bookings').select('id, pickup_at, return_at').is('cancelled_at', null), options),
    readLineValues(),
  ])
  const rows = rowsOf<Pick<BookingRow, 'id' | 'pickup_at' | 'return_at'>>(res, 'Rental duration read failed')

  const acc = BUCKETS.map((b) => ({ ...b, count: 0, totalDays: 0, revenue: 0 }))
  const durations: number[] = []
  for (const b of rows) {
    const days = daysOf(b)
    durations.push(days)
    const bucket = acc.find((d) => days >= d.minDays && days <= d.maxDays) ?? acc[acc.length - 1]
    if (!bucket) continue
    bucket.count++
    bucket.totalDays += days
    bucket.revenue += linesValue(lineMap.get(b.id), days)
  }
  durations.sort((a, b) => a - b)
  const n = durations.length
  const sum = durations.reduce((a, d) => a + d, 0)

  return {
    totalRentals: n,
    averageDuration: n > 0 ? Number((sum / n).toFixed(1)) : 0,
    medianDuration: n > 0 ? (durations[Math.floor(n / 2)] ?? 0) : 0,
    longestDuration: durations[n - 1] ?? 0,
    shortestDuration: durations[0] ?? 0,
    buckets: acc.map((b) => ({
      key: b.key,
      label: b.label,
      minDays: b.minDays,
      maxDays: b.maxDays,
      count: b.count,
      sharePercent: percentOf(b.count, n),
      totalDays: b.totalDays,
      revenue: b.revenue as Paisa,
      avgDailyRate: (b.totalDays > 0 ? Math.round(b.revenue / b.totalDays) : 0) as Paisa,
    })),
  }
}

export async function getCancellationsReport(options?: ReportFilterOptions): Promise<CancellationsReportData> {
  const [allRes, cancelRes, lineMap] = await Promise.all([
    filtered(supabase.from('bookings').select('id'), options),
    filtered(
      supabase
        .from('bookings')
        .select('id, booking_no, pickup_at, return_at, project, cancelled_at, cancellation_reason, clients!client_id(name)')
        .not('cancelled_at', 'is', null),
      options,
    ),
    readLineValues(),
  ])
  const totalAll = rowsOf(allRes, 'Booking count read failed').length
  const rows = rowsOf<BookingRow>(cancelRes, 'Cancellations read failed')

  let lostTotal = 0
  let noticeHours = 0
  let noticeCount = 0
  const reasonMap = new Map<string, { count: number; lost: number }>()
  const list: CancelledBookingItem[] = []

  for (const b of rows) {
    const lost = linesValue(lineMap.get(b.id), daysOf(b))
    lostTotal += lost
    // The DB refuses a cancellation without a reason (0002/0015 check); an
    // empty one here is an older row, and it says so rather than guessing.
    const reason = b.cancellation_reason?.trim() || 'No reason recorded'
    const r = reasonMap.get(reason) ?? { count: 0, lost: 0 }
    r.count++
    r.lost += lost
    reasonMap.set(reason, r)

    const c = b.cancelled_at ? Date.parse(b.cancelled_at) : NaN
    const p = Date.parse(b.pickup_at)
    if (!Number.isNaN(c) && !Number.isNaN(p)) {
      noticeHours += Math.max(0, (p - c) / 3_600_000)
      noticeCount++
    }

    list.push({
      id: b.id,
      bookingNo: b.booking_no,
      clientName: embeddedName(b.clients),
      project: b.project?.trim() || '—',
      cancelledAt: b.cancelled_at ?? '',
      scheduledPickup: b.pickup_at,
      lostRevenue: lost,
      reason,
    })
  }

  const n = rows.length
  return {
    totalCancellations: n,
    cancellationRate: totalAll > 0 ? Number(((n / totalAll) * 100).toFixed(1)) : 0,
    totalLostRevenue: lostTotal as Paisa,
    averageNoticeDays: noticeCount > 0 ? Number((noticeHours / noticeCount / 24).toFixed(1)) : null,
    reasons: [...reasonMap.entries()]
      .sort((a, b) => b[1].count - a[1].count)
      .map(([reason, v]) => ({ reason, count: v.count, percent: percentOf(v.count, n), lostRevenue: v.lost as Paisa })),
    cancelledBookings: list,
  }
}
</file>

<file path="src/lib/queries/salesVatReports.ts">
import { supabase } from '../supabase'
import { rupees, type Paisa } from '../money'
import { BS_MONTHS, formatAdMonth, toBs } from '../bs'
import { embeddedName, percentOf, rowsOf, type ReportFilterOptions } from './reportSupport'

export type { ReportFilterOptions } from './reportSupport'

export interface SalesReportMetrics {
