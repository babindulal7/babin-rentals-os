import type { RentalDraftData } from '../../../actions/rentals/saveDraft'
import { readLocal, removeLocal, writeLocal } from '../../../lib/safeStorage'

/**
 * # A device-local copy of an UNSAVED New Rental (C4)
 *
 * Once the first **Save draft** lands, New Rental already autosaves to the
 * server every 2.5 s (`NewRental.tsx`, the `draftHasUnsavedChanges` effect).
 * What nothing protected was the stretch BEFORE that first save: a coordinator
 * who has built a ten-line quote and then has the tab reloaded, the tablet
 * sleep or the battery die loses all of it.
 *
 * This is that stretch, and only that. It writes the same `RentalDraftData`
 * snapshot the server draft uses, to this device, and offers it back.
 *
 * ## Why not autosave the new booking to the server too
 *
 * A server write creates a draft row and, with it, a booking number and a
 * `client_uuid` (Law 8). Doing that on every keystroke of a form nobody has
 * chosen to save would leave stray drafts behind. Restoring is therefore a
 * **choice** (a banner with Restore and Discard), never automatic.
 *
 * ## What it will not do
 *
 * - **Shared devices.** Not written when `isSharedDevice` is true: a client's
 *   name and project on a counter tablet is the next person's to read.
 * - **Per user.** The key carries the user id, so one login never restores
 *   another's work.
 * - **Money.** Nothing here computes or interprets a figure; it stores what the
 *   form already holds, and the pricing pipeline recalculates on restore.
 * - **Stale copies.** A copy older than `MAX_AGE_MS` is dropped on read.
 */

const KEY_PREFIX = 'br.newRentalLocalDraft.v1.'

/** A week: long enough to cover a weekend, short enough not to resurrect last month's quote. */
export const MAX_AGE_MS = 7 * 24 * 60 * 60 * 1000

export interface LocalDraft {
  data: RentalDraftData
  /** AD, UTC (law 7). */
  savedAt: string
}

const keyFor = (userId: string): string => `${KEY_PREFIX}${userId}`

/** A form with nothing entered is not worth a copy and must not offer a restore. */
export function isMeaningful(data: RentalDraftData): boolean {
  return (
    data.lines.length > 0 ||
    data.crew.length > 0 ||
    data.project.trim() !== '' ||
    (data.selectedClientId !== null && data.selectedClientId !== '') ||
    data.specialInstructions.trim() !== ''
  )
}

export function writeLocalDraft(userId: string, data: RentalDraftData, now: Date = new Date()): boolean {
  if (!userId || !isMeaningful(data)) return false
  const payload: LocalDraft = { data, savedAt: now.toISOString() }
  return writeLocal(keyFor(userId), JSON.stringify(payload))
}

export function readLocalDraft(userId: string, now: Date = new Date()): LocalDraft | null {
  if (!userId) return null
  const raw = readLocal(keyFor(userId))
  if (raw === null) return null
  try {
    const parsed = JSON.parse(raw) as Partial<LocalDraft> | null
    const data = parsed?.data
    const savedAt = parsed?.savedAt
    if (!data || data.version !== 1 || !Array.isArray(data.lines) || !Array.isArray(data.crew)) throw new Error('shape')
    if (typeof savedAt !== 'string' || Number.isNaN(Date.parse(savedAt))) throw new Error('shape')
    if (now.getTime() - Date.parse(savedAt) > MAX_AGE_MS) throw new Error('stale')
    if (!isMeaningful(data)) throw new Error('empty')
    return { data, savedAt }
  } catch {
    /* Unreadable, stale or empty: it can never be restored, so stop carrying it. */
    removeLocal(keyFor(userId))
    return null
  }
}

export function clearLocalDraft(userId: string): void {
  if (userId) removeLocal(keyFor(userId))
}
</file>

<file path="src/modules/rentals/booking/newClientDraft.ts">
import { rupees } from '../../../lib/money'
import { normalizedPhone } from '../../../lib/queries/clients'
import type { ClientRecord, ClientType, MembershipTier, OrganisationType } from '../../../lib/queries/clients'
import type { CreateClientInput, CreateClientResult } from '../../../actions/clients/createClient'

/**
 * **What a client created from a booking actually saves — and what it does not.**
 *
 * Extracted from `AddClientModal.tsx` so the two questions that decide whether
 * that dialog tells the truth are pure, readable and testable:
 *
 *  1. **What goes to the database** (`createClientInputFrom`) — the column set
 *     `actions/clients/createClient.ts` writes, and nothing else.
 *  2. **What the booking page is then told** (`clientRecordFrom`) — a
 *     `ClientRecord` carrying only values the database now holds, so the record
 *     handed back matches what re-reading that client would return.
 *
 * Law 1 as well: the mapping rules below are not layout, and a page is not
 * where they belong.
 *
 * ## The three fields this module deliberately has no slot for
 *
 * `AddClientModal` collects Contact Person, Credit Limit and Payment Terms.
 * None of the three can be written by the create path, and `NewClientDraft`
 * below has no field for any of them so that they cannot be smuggled in:
 *
 *  - **Contact Person** — there is no contact column on `clients`. A contact is
 *    a row in `client_contacts` (`0005_clients.sql`), a different table;
 *    `createClient.execute` inserts into `clients` alone and its
 *    `ClientInsertPayload` names no contact column.
 *  - **Credit Limit** → `clients.approved_credit_limit`, and **Payment Terms**
 *    → `clients.payment_terms`. `0005_clients.sql`'s own comment on the pair:
 *    *"Written ONLY by an Approved client_commercial_overrides row. No direct
 *    UPDATE path, for any role including Owner."* `CreateClientInput` has no
 *    parameter for either, which is that rule expressed in the type.
 *
 * `paymentTerms` has a second, independent problem worth recording where the
 * next reader will find it: `PAYMENT_TERMS_OPTIONS` in `data/clients.ts` offers
 * `Due on Pickup · Due on Return · Net 7 · Net 15 · Net 30 · Prepaid · Custom`,
 * while the stored `payment_terms` enum (`0001_enums.sql:845`) is
 * `Immediate · 7 days · 15 days · 30 days`. **Not one option the operator can
 * pick is a member of the stored type.** Even with an approval path in place,
 * the list would have to be mapped or re-ruled first.
 */

/* ── defaults for a freshly created record ───────────────────────────────
 *
 * The first two match what `modules/clients/AddClient.tsx` already defaults to
 * (`useState<ClientType>('Organisation')` and `useState<MembershipTier>('Creator')`),
 * so a client created from a booking and a client created from the Clients
 * module come out identical. Neither is a new product decision made here.
 */
export const DEFAULT_CLIENT_TYPE: ClientType = 'Organisation'

/**
 * ⚠ **TODO(decision) — nothing writes a `client_memberships` row.**
 *
 * `membership` is required on `ClientRecord` and has no way to spell "has not
 * joined anything", so a value has to go here. This one is not measured: a
 * client created by this dialog holds no membership row at all, because a tier
 * is a row in `client_memberships` and neither `createClient` nor this module
 * writes one. `queries/clients.ts` hits the same wall from the other side and
 * puts `UNJOINED_MEMBERSHIP_PLACEHOLDER` ('Academy') there, documenting it as
 * "a fabricated fact on a real record" pending a `'None'` member on
 * `MembershipTier`.
 *
 * Left at 'Creator' rather than switched, because the two placeholders are
 * different tiers and choosing between them moves pricing — that is the ruling,
 * not a refactor. `AddClientModal`'s confirmation therefore states that the
 * tier is not stored rather than presenting it as saved.
 */
export const DEFAULT_MEMBERSHIP: MembershipTier = 'Creator'

/** Mirrors `AddClient.tsx`'s own `orgType` default. */
export const DEFAULT_ORGANISATION_TYPE: OrganisationType = 'Production House'

/**
 * `clients.org_subtype` — every member of the `client_organisation_subtype`
 * enum (`0001_enums.sql:796`), in the enum's own order.
 *
 * The list is duplicated from `AddClient.tsx`'s local `ORG_TYPES` only because
 * neither `data/clients.ts` nor anywhere else exports one; the closed
 * `OrganisationType` union types both copies, and
 * `__tests__/newClientDraft.test.ts` reads the migration and fails if this
 * array and the enum ever drift apart.
 */
export const ORGANISATION_TYPES: readonly OrganisationType[] = [
  'Production House',
  'Rental House',
  'College / Institution',
  'Corporate / Agency',
  'Government / NGO',
  'Broadcaster',
  'Other',
]

/** Exactly the fields a client created from a booking can be saved with. */
export interface NewClientDraft {
  clientType: ClientType
  /**
   * Required by CHECK `clients_org_subtype_pairing` whenever the type is
   * Organisation, and forbidden when it is Individual — so it is carried
   * always and sent conditionally.
   */
  organisationType: OrganisationType
  name: string
  /** The **stored** form, `+9779801234567`. Callers run `canonicalPhone()` first. */
  phone: string
  email: string
  /** `clients.pan_vat` — CHECK: exactly nine digits, or absent. */
  pan: string
  notes: string
}

/**
 * The payload for `createClient`.
 *
 * `clientType` is narrowed rather than cast: `ClientType` carries a third
 * member, `'Unassigned'`, which `clients.type_parent` has no enum member for.
 * The dialog's two-button toggle cannot produce it, but the type can, and an
 * absent value lands the client in the Unassigned bucket honestly instead of
 * sending a member the database does not have.
 */
export function createClientInputFrom(draft: NewClientDraft, clientUuid: string): CreateClientInput {
  const typed = draft.clientType === 'Organisation' || draft.clientType === 'Individual'
  return {
    name: draft.name.trim(),
    phone: draft.phone,
    email: draft.email.trim(),
    ...(typed ? { clientType: draft.clientType as 'Organisation' | 'Individual' } : {}),
    ...(draft.clientType === 'Organisation' ? { orgSubtype: draft.organisationType } : {}),
    panVat: draft.pan.trim(),
    notes: draft.notes.trim(),
    isDraft: false,
    clientUuid,
  }
}

/**
 * The record handed to the booking page — **only** what the row now holds.
 *
 * Every placeholder below is either a value the database applied itself or the
 * same stand-in `queries/clients.ts:toClientRecord` produces for a client with
 * no such data, so selecting this client and re-reading it later do not
 * disagree:
 *
 *  - `creditLimitPaisa: 0` — `approved_credit_limit` is left NULL on insert and
 *    `toClientRecord` maps NULL to `0 as Paisa`.
 *  - `contactPerson` em-dashes — `toClientRecord` writes `'—'` for each of the
 *    three when the client has no `client_contacts` row, and a client created
 *    here has none.
 *  - `paymentTerms` **absent** — the column takes its `'Immediate'` default, and
 *    `toClientRecord` does not publish it at all, so absent is what a re-read
 *    gives.
 *  - `clientSinceAd` **absent** — `clients.client_since` defaults to
 *    `current_date` **on the server**, which `createClient` returns nothing of.
 *    Stamping the device's own date here would assert a date nobody read back;
 *    `ClientHistoryDrawer` already renders the absence as "Not recorded on this
 *    client." rather than a number. (Law 7 is not the reason — it is satisfied
 *    either way; the reason is that the value is unknown to this process.)
 */
export function clientRecordFrom(draft: NewClientDraft, saved: CreateClientResult): ClientRecord {
  const pan = draft.pan.trim()
  const notes = draft.notes.trim()
  return {
    /* The client CODE, like every other `ClientRecord.id` on screen … */
    id: saved.clientCode,
    /* … and the `clients.id` uuid, which is what the booking write needs.
       Without it the booking page auto-selects this record and Confirm
       refuses it as sample data (`!client?.dbId`). */
    dbId: saved.clientId,
    name: saved.name,
    clientType: draft.clientType,
    ...(draft.clientType === 'Organisation' ? { organisationType: draft.organisationType } : {}),
    membership: DEFAULT_MEMBERSHIP,
    phone: saved.phone,
    email: draft.email.trim(),
    currentRentalsCount: 0,
    activeBookings: [],
    outstandingPaisa: rupees(0),
    depositHeldPaisa: rupees(0),
    creditLimitPaisa: rupees(0),
    creditUsedPaisa: rupees(0),
    lastRentalAd: '—',
    lastRentalBs: '—',
    address: '',
    contactPerson: { name: '—', designation: '—', phone: '—' },
    kycStatus: 'Not Submitted',
    kycDocsCount: 0,
    totalRentalsCount: 0,
    totalSpentPaisa: rupees(0),
    ...(pan ? { pan } : {}),
    ...(notes ? { notes } : {}),
  }
}

/**
 * The clients a duplicate can actually be found among — the ones the database
 * has confirmed, i.e. the ones carrying a `dbId`.
 *
 * `ClientRecord.dbId` is populated **only** by `queries/clients.ts:toClientRecord`
 * (its own doc comment says so), so a row without one came from the seed array
 * in `data/clients.ts` and describes no client the business has. Announcing
 * "this phone number is already on file" from such a row states a fact about
 * demo data as though it were a fact about the client list.
 *
 * This is not belt-and-braces against a caller that forgets to pass a pool.
 * `NewRental.tsx` keeps `clientPool` seeded from `CLIENTS_DATA` and swaps it for
 * live rows only `if (bookableClients.length > 0)` — so even a caller doing
 * everything right hands over seed rows whenever the read fails or comes back
 * empty, which is exactly when a false duplicate would be most confusing.
 */
export function confirmedClients(pool: readonly ClientRecord[] | undefined): readonly ClientRecord[] {
  return pool ? pool.filter((c) => Boolean(c.dbId)) : []
}

/**
 * The client already on file under this phone number, if there is one.
 *
 * `normalizedPhone` is the shared normalizer from `data/clients` — the same one
 * the Duplicate/Merge Center and `lib/clientImport` use, so a number cannot
 * match here and miss there. A merged-away record is skipped: Law 3 keeps it in
 * the list, but it is not the client to send the operator to.
 */
export function findPhoneDuplicate(
  pool: readonly ClientRecord[],
  storedPhone: string,
): ClientRecord | null {
  const digits = normalizedPhone(storedPhone)
  if (!digits) return null
  return pool.find((c) => !c.mergedIntoId && normalizedPhone(c.phone) === digits) ?? null
}
</file>

<file path="src/modules/rentals/booking/newRentalGuards.ts">
import { validateDiscount } from '../../../lib/discount'
import { formatMoney, type Paisa } from '../../../lib/money'
import type { ClientRecord } from '../../../lib/queries/clients'
import type { CrewRole } from '../../../lib/queries/crew'
import type { PricingPipelineResult } from '../../../lib/pricingPipeline'
import { dbRejectsRole } from './CrewSearch'
import type { EquipmentAvailabilitySource } from './itemCatalogue'
import { PRODUCT_ID_RE } from './newRentalUtils'

/**
 * One reason Confirm Booking is refused, in the shape the rail's blocking-
 * notices card renders.
 *
 * `action` is one of `runNoticeAction`'s verbs and is **optional**: a refusal
 * the operator cannot act on from this screen gets no button rather than a
 * button that silently does nothing. (§12's "every alert carries exactly one
 * action" governs `alerts`, and every alert-derived notice still carries one.)
 */
export interface BlockingNotice {
  text: string
  action?: string
}

export interface RentalAlertItem {
  text: string
  severity: 'Critical' | 'Warning' | 'Information'
  action: string
}

/** Everything `confirmWriteRefusals` needs to know, and nothing else. */
export interface ConfirmWriteState {
  /** Whether a client is chosen at all. `false` is the alert model's own Critical, not ours. */
  clientSelected: boolean
  /** The chosen client's `clients.id` uuid — `null` when it came from the seed array. */
  clientDbId: string | null
  /** Has the live client read landed? It changes what a missing uuid MEANS. */
  clientsAreLive: boolean
  lineCount: number
  /** The first line whose id is not a `products.id` uuid, by name; `null` if none. */
  sampleLineName: string | null
  /** Law 6 — whether this role is shown equipment rates at all. */
  canBookingMoney: boolean
  /** AUD-026: Whether the selected client is flagged as Blocked or On-Stop. */
  clientIsBlocked?: boolean
}

/**
 * ⛔ NR-10 — the four refusals that used to live ONLY inside the Confirm
 * handler, lifted out so one computation answers both the card and the button.
 *
 * The defect: `confirmBlocked` was `critical.length > 0 || days === 0`, and the
 * handler then refused, in its own body and with its own sentences, on a client
 * with no `dbId`, on zero lines, on a money-blind role and on a line id that is
 * not a uuid. None of those four reached `blockingNotices`, so the rail's card
 * said **"Nothing is blocking this booking · Every requirement for Confirm
 * Booking is met"**, the button was enabled, and the press failed into the
 * inline error line. Two lists describing one rule, and they had already
 * drifted.
 *
 * These are the handler's own refusals, verbatim in substance, re-written as
 * standalone sentences so they read correctly in the card as well as after
 * "Not confirmed — " in the error line.
 *
 * Pure and exported for `__tests__/newRentalGuards.test.ts`.
 */
export function confirmWriteRefusals(s: ConfirmWriteState): BlockingNotice[] {
  const out: BlockingNotice[] = []
  /* Only when a client IS chosen: "No client selected" is already a Critical in
     the alert model, and stating it twice is its own defect. */
  if (s.clientSelected && !s.clientDbId) {
    out.push({
      text: s.clientsAreLive
        ? 'The selected client came from sample data and has no database record, so there is nothing to book against. Pick a client from the live list.'
        : 'The client list has not loaded from the database yet, so the selected client is sample data. Wait for it to load, then re-select the client.',
      action: 'Select Client',
    })
  }
  if (s.clientIsBlocked) {
    out.push({
      text: 'This client is flagged as Blocked from equipment rentals. Quotation or confirmation is restricted without manager override.',
      action: 'View Client',
    })
  }
  if (s.lineCount === 0) {
    out.push({
      text: 'Add at least one equipment item before confirming.',
      action: 'Open Equipment',
    })
  }
  /* Law 6 — `listInventory({ withMoney: false })` returns no `dailyRate`, so
     every line this role holds carries `ratePaisa` 0. Sending that would
     persist the display placeholder as the price of the booking. */
  if (!s.canBookingMoney) {
    out.push({
      text: 'Equipment rates are hidden for your role, so this booking cannot be priced from this screen — every line would be saved at Rs 0. Ask a colleague who can see rates to confirm it.',
    })
  }
  if (s.sampleLineName !== null) {
    out.push({
      text: `"${s.sampleLineName}" is a sample row, not a product in the catalogue, so it cannot be saved. Remove it and add the item from the live catalogue.`,
      action: 'Open Equipment',
    })
  }
  return out
}

export interface RentalAlertsInput {
  conflictLines: readonly { id?: string; text: string }[]
  availabilitySource: EquipmentAvailabilitySource
  client: ClientRecord | undefined
  govId: string
  kind: string
  discountPct: number
  crew: Array<{ role: CrewRole | string; name: string }>
  canBookingMoney: boolean
  depositRequiredPaisa: Paisa
  depositReceivedPaisa: Paisa
  depositPendingPaisa: Paisa
  outstandingPaisa: Paisa
  days: number
  clientsAreLive: boolean
  lines: readonly { productId?: string | null | undefined; id?: string | undefined; name: string }[]
  equipmentLines: readonly { productId?: string | null | undefined; id?: string | undefined; name: string }[]
  pricing: PricingPipelineResult
}

export interface RentalAlertsResult {
  alerts: RentalAlertItem[]
  critical: RentalAlertItem[]
  advisories: RentalAlertItem[]
  blockingNotices: BlockingNotice[]
  confirmBlocked: boolean
}

export const MISSING_GOV_ID_TEXT = 'Missing client ID or PAN'

export function deriveRentalAlertsAndNotices(input: RentalAlertsInput): RentalAlertsResult {
  const discountVerdict = validateDiscount(input.discountPct)
  const discountUnapproved = !discountVerdict.valid

  const alerts: RentalAlertItem[] = [
    ...input.conflictLines.map((c) => ({
      text: `Equipment conflict — ${c.text}`,
      severity: 'Critical' as const,
      action: 'Open Inventory',
    })),
    ...(input.availabilitySource.state === 'failed'
      ? [
          {
            text: `Availability could not be checked for these dates: ${input.availabilitySource.reason}. Confirm will re-check and refuse if anything is short.`,
            severity: 'Warning' as const,
            action: 'Open Equipment',
          },
        ]
      : []),
    ...(!input.client ? [{ text: 'No client selected', severity: 'Critical' as const, action: 'Select Client' }] : []),
    ...(input.kind.trim() === ''
      ? [{ text: 'Select a project type before confirming this rental.', severity: 'Critical' as const, action: 'Open Client & Dates' }]
      : []),
    /* Ruled 8 Oct 2026 (RULINGS-2026-10-08.md): a missing ID/PAN is a WARNING.
       Neither confirmRental nor the database requires one, and a page may not
       invent a gate the engines do not hold. It stays visible as an advisory. */
    ...(input.client && input.govId.trim().length === 0 ? [{ text: MISSING_GOV_ID_TEXT, severity: 'Warning' as const, action: 'Edit Client' }] : []),
    ...(input.client && (input.client.isBlocked || input.client.onStop)
      ? [
          {
            text: `Client is blocked: ${input.client.blockReason || input.client.onStop?.reason || 'Account flagged as on-stop'}`,
            severity: 'Critical' as const,
            action: 'View Client',
          },
        ]
      : []),
    ...(discountUnapproved
      ? [{ text: discountVerdict.error ?? 'Discount is not a valid percentage.', severity: 'Critical' as const, action: 'Fix Discount' }]
      : []),
    ...input.crew
      .filter((c) => dbRejectsRole(c.role as CrewRole))
      .map((c) => ({
        text: `${c.name}'s role — ${c.role} — is not one the database accepts, so this booking cannot be confirmed while they are on it`,
        severity: 'Critical' as const,
        action: 'Open Crew',
      })),
    ...(input.canBookingMoney && input.client && input.client.outstandingPaisa > 0
      ? [{ text: `Client has ${formatMoney(input.client.outstandingPaisa)} outstanding`, severity: 'Warning' as const, action: 'View Client' }]
      : []),
    ...(input.canBookingMoney && input.depositRequiredPaisa > input.depositReceivedPaisa
      ? [{ text: `Deposit ${formatMoney(input.depositPendingPaisa)} pending`, severity: 'Warning' as const, action: 'Receive Deposit' }]
      : []),
    ...(input.canBookingMoney && input.outstandingPaisa > 0 ? [{ text: 'Rental outstanding', severity: 'Warning' as const, action: 'Receive Payment' }] : []),
  ]
  const critical = alerts.filter((a) => a.severity === 'Critical')

  const blockingNotices: BlockingNotice[] = [
    ...(input.days === 0 ? [{ text: 'The return must be later than the pickup — check the times as well as the dates.', action: 'Open Dates' }] : []),
    ...critical.map((a) => ({ text: a.text, action: a.action })),
    ...confirmWriteRefusals({
      clientSelected: Boolean(input.client),
      clientDbId: input.client?.dbId ?? null,
      clientIsBlocked: Boolean(input.client?.isBlocked || input.client?.onStop),
      clientsAreLive: input.clientsAreLive,
      lineCount: input.lines.length,
      sampleLineName: input.equipmentLines.find((l) => !PRODUCT_ID_RE.test(l.productId ?? l.id ?? ''))?.name ?? null,
      canBookingMoney: input.canBookingMoney,
    }),
    ...input.pricing.discounts.validationErrors.map((err) => ({ text: err, action: 'Open Pricing' })),
    ...input.pricing.securityDeposit.validationErrors.map((err) => ({ text: err, action: 'Open Pricing' })),
  ]
  const confirmBlocked = blockingNotices.length > 0

  // Warnings the confirm panel shows without blocking. Only the ID/PAN notice
  // for now; deposit and outstanding warnings keep their existing surfaces.
  const advisories = alerts.filter((a) => a.text === MISSING_GOV_ID_TEXT)
  return { alerts, critical, advisories, blockingNotices, confirmBlocked }
}
</file>

<file path="src/modules/rentals/booking/newRentalUtils.ts">
/**
 * Pure utilities for the New Rental page.
 *
 * Extracted from NewRental.tsx to keep the component focused on rendering.
 * These have no UI, network, or Supabase dependencies — they are plain
 * functions and types that can be tested in isolation and reused.
 */

import { rentalDaysBetween } from '../../../lib/rentalDays'
import { NPT_OFFSET_STRING } from '../../../lib/operationalDay'
import { getSetting } from '../../../lib/settingsStore'
import { roundHalfUp } from '../../../lib/money'
import type { Paisa } from '../../../lib/money'

/** One day in milliseconds — used for date arithmetic defaults. */
export const DAY = 86400000

/**
 * The VAT rate is **read from Settings**, never a literal.
 *
 * `VAT_PCT = 13` used to live here and is deleted: `PLAN.md` §5 Conventions
 * bans "a hardcoded VAT rate", and `WIREFRAME_RULINGS_2026-08-12.md` §7 rules
 * that spec 01's drawn `VAT 13%` is read as `VAT {rate}%` off
 * `settingsStore`'s `vatRatePercent`. Read once per mount — the same shape
 * every other consumer of `getSetting` uses; a rate changed in another tab
 * lands on the next mount, not mid-booking.
 */
export function readVatRatePercent(): number {
  const n = Number(getSetting('vatRatePercent'))
  return Number.isFinite(n) ? n : 0
}

/** Canonical JSON serialisation for dirty checks — order-independent. */
export function stableJson(value: unknown): string {
  if (Array.isArray(value)) return `[${value.map(stableJson).join(',')}]`
  if (value !== null && typeof value === 'object') {
    const entries = Object.entries(value as Record<string, unknown>)
      .filter(([, child]) => child !== undefined)
      .sort(([a], [b]) => a.localeCompare(b))
    return `{${entries.map(([key, child]) => `${JSON.stringify(key)}:${stableJson(child)}`).join(',')}}`
  }
  return JSON.stringify(value)
}

/**
 * The two pickers of one end of the booking — a `YYYY-MM-DD` date and an
 * `HH:mm` wall-clock time — as a single instant, or `null` if either is
 * unparseable.
 *
 * This is the **same construction `confirmBooking` sends** (`new
 * Date(\`${date}T${time}\`)`, local wall-clock in, `.toISOString()` — AD/UTC —
 * out, Law 7). It exists so the page cannot measure the booking over one pair
 * of instants and store it over another: before NR-19 the length was computed
 * from the DATES ALONE while the write sent date+time, so the two disagreed by
 * up to a day at every booking whose times were not midnight.
 *
 * `null` rather than a fallback instant: an unparseable value is not midnight,
 * and `DateTimeField` never lets one through anyway — `commitDate` reverts to
 * the last good date and `commitTime` to the last good time, so the guard here
 * is a type-level one rather than a state this screen can reach.
 */
export function bookingInstant(date: string, time: string): Date | null {
  if (!date || !time) return null
  let isoTime = time.trim()
  if (!/[Z+-]/.test(isoTime)) {
    if (isoTime.length === 5) isoTime = `${isoTime}:00`
    isoTime = `${isoTime}${NPT_OFFSET_STRING}`
  }
  const d = new Date(`${date}T${isoTime}`)
  return Number.isNaN(d.getTime()) ? null : d
}

/**
 * The booking's length in whole rental days, or `0` for a window that is not a
 * booking at all.
 *
 * The arithmetic is **not** here — `lib/rentalDays.ts` owns it (Law 1), and its
 * header settles which of this repo's three day-counts this is: the priced
 * span, elapsed ms ÷ 86 400 000, rounded half-up, floored at 1. What is here is
 * the page's own gate, and only that: a return at or before the pickup is `0`,
 * which every date-dependent thing on this screen reads as "unset" (an em dash,
 * never a zero — §8.6) and which blocks Confirm.
 *
 * ⛔ NR-19 — the page used to difference the two `YYYY-MM-DD` picker values and
 * ignore the times beside them, so a 09:00 → 18:00 same-day hire measured 0 and
 * was refused for being zero days long. `createRental.validate` refuses only a
 * return strictly BEFORE the pickup, and the write sends date+time, so the page
 * was rejecting bookings its own action would have taken. Measured over the
 * instants that are actually stored, that hire is 9 h → the engine's floor of
 * one rental day.
 *
 * `0` cannot be a stored length: Law 9 and six `days >= 1` CHECKs, and Confirm
 * is blocked while this is 0.
 */
export function bookingDays(pickupAt: Date | null, returnAt: Date | null): number {
  if (!pickupAt || !returnAt || returnAt.getTime() <= pickupAt.getTime()) return 0
  return rentalDaysBetween(pickupAt.toISOString(), returnAt.toISOString()) ?? 0
}

/** Regex matching a UUID v4 (products.id). */
export const PRODUCT_ID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i

/** §10.1 — line amount, rounded once at the end (half-up), same convention `lib/money.ts`'s `price()` uses internally. */
export function lineAmountPaisa(line: { qty: number; days: number; ratePaisa: Paisa; discountPct: number }): Paisa {
  return roundHalfUp(line.qty * line.days * line.ratePaisa * (1 - line.discountPct / 100)) as Paisa
}

/** Common shoot presets — NOT a ceiling, just conveniences. */
export const SHOOT_PRESETS = [
  { id: '1-day', label: '1-Day Shoot', icon: 'timer' as const, description: 'Single-day shoot (07:00 → 20:00, 1 rental day)' },
  { id: 'weekend', label: 'Weekend (Fri–Mon)', icon: 'calendar_week' as const, description: 'Weekend shoot (Friday 14:00 → Monday 10:00, 3 rental days)' },
  { id: '3-day', label: '3-Day Commercial', icon: 'video' as const, description: '3-day commercial shoot (08:00 → Day 3 20:00, 3 rental days)' },
  { id: '1-week', label: '1-Week Production', icon: 'calendar_event' as const, description: '7-day production block (08:00 → Day 7 20:00, 7 rental days)' },
] as const
</file>

<file path="src/modules/rentals/booking/OverbookingOverrideModal.tsx">
import { useState } from 'react'
import Icon from '../../../components/ui/Icon'
import { Modal } from '../../../components/ui/Modal'
import { Button } from '../../../components/ui/Button'
import type { EquipmentResult } from './itemCatalogue'

/**
 * redesign v1 §3 — the overbooking valve's override dialog. Only reachable
 * when Settings ▸ Financial ▸ Booking rules ▸ Allow overbooking is on
 * (`lib/bookingRules.ts`); a row or chip that cannot be added is otherwise
 * inert.
 *
 * ## ⛔ NR-11 — it asked for a reason and an approver, and threw both away
 *
 * This required a reason of at least 10 characters **and** a named approver
 * before the confirm button — then labelled "Book it anyway", now "Add it
 * anyway" — could be pressed. Neither field went anywhere:
 * `onOverbook(unit)` hands the caller the unit and nothing else, and
 * `AddItemPanel` adds it exactly as any other pick. The operator was made to
 * justify an override to a dialog that forgot the justification the moment it
 * closed.
 *
 * **Checked before removing them (option b of the two).** Nothing in this build
 * can carry an overbooking reason or approver:
 *
 * - `actions/rentals/createRental.ts` accepts `reason` / `approverId` on a
 *   **discount** (`CreateRentalDiscount`) and on nothing else; `CreateRentalLine`
 *   carries `lineNote` and no approval field of any kind;
 * - the word "overbook" appears in `supabase/migrations/**` only as the
 *   `fulfillment_status` enum member `'Overbooked'` (`0001_enums.sql`) and a
 *   TODO comment about it. That member belongs to `fulfillment_outcomes`
 *   (`0003_operations.sql:1509`), which is a real table recording a per-line
 *   shortage — but it has **no reason and no approver column**, it requires a
 *   `booking_id not null` (this screen is a draft with no booking row), and no
 *   code in `src/` reads or writes it: the only occurrences outside the
 *   migrations are in the generated `types/supabase.ts`;
 * - `lib/bookingRules.ts` is a `localStorage` flag, not a record.
 *
 * So the fields are gone rather than collected and dropped. Where an
 * overbooking override should be recorded — a `booking_lines` note, an audit
 * row, columns added to `fulfillment_outcomes`, or its own table with an
 * approver FK — is a schema question. TODO(decision), PLAN.md §4: nothing here
 * invents a column for it.
 *
 * ## What the override actually does, stated on the dialog
 *
 * It adds the unit. It does **not** clear the conflict: `confirmRental` plans
 * the assignment and throws `AssignmentIncompleteError` unless every line has
 * units free for the booking's window (`confirmRental.ts:435-436`), so Confirm
 * stays refused while nothing is free — by the database, not by this screen's
 * opinion. What it buys is a draft or quote that holds the item the client
 * asked for while the clash is sorted out, which is why it is not simply a
 * disabled row.
 *
 * Sub-rent is listed first and marked preferred, per the 27 Jul lock this spec
 * cites. It has nowhere to dispatch to, though: sub-renting attaches to a
 * *confirmed* booking (`BookingDetail.tsx`'s Create Sub-Rental), and this
 * screen is still a draft with no booking id. Rather than fabricate that
 * workflow for a row that does not exist yet, choosing it disables "Add it anyway" and
 * states the honest reason plainly instead.
 */

export interface OverbookingOverrideModalProps {
  isOpen: boolean
  onClose: () => void
  unit: EquipmentResult | null
  /** Fires for "Add it anyway" — the caller adds the unit as an internal pick with the clash listed. */
  onOverbook: (unit: EquipmentResult) => void
  /** Fires when sub-renting — adds the unit as a Sub-rental line to be cross-hired from partner. */
  onSubRent?: (unit: EquipmentResult) => void
}

export function OverbookingOverrideModal({ isOpen, onClose, unit, onOverbook, onSubRent }: OverbookingOverrideModalProps) {
  const [choice, setChoice] = useState<'sub-rent' | 'overbook'>('sub-rent')

  const close = () => {
    setChoice('sub-rent')
    onClose()
  }

  if (!unit) return null

  /* A serialised unit is named by its serial and has a status; a live product
     row has neither — it is a product, and what is known about it is the
     window verdict. Both are stated in the words the row itself carries. */
  const what = unit.serial !== '—' ? unit.serial : unit.name
  const why = unit.status ?? unit.availability.detail

  return (
    <Modal
      isOpen={isOpen}
      onClose={close}
      size="sm"
      title={`${what} is not free for these dates`}
      subtitle={unit.committedTo !== '—' ? `${why} · ${unit.committedTo}` : why}
      footer={
        <>
          <Button variant="ghost" onClick={close}>Cancel</Button>
          <Button
            variant="primary"
            onClick={() => {
              if (choice === 'sub-rent') {
                if (onSubRent) onSubRent(unit)
                else onOverbook(unit)
              } else {
                onOverbook(unit)
              }
              close()
            }}
          >
            {choice === 'sub-rent' ? 'Add as Sub-Rental' : 'Add it anyway'}
          </Button>
        </>
      }
    >
      <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
        <label style={{ display: 'flex', gap: 'var(--sp-sm)', alignItems: 'flex-start', cursor: 'pointer' }}>
          <input type="radio" name="overbooking-choice" checked={choice === 'sub-rent'} onChange={() => setChoice('sub-rent')} style={{ marginTop: 3 }} />
          <span>
            <span style={{ display: 'block', fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>Sub-rent this item instead</span>
            <span style={{ display: 'block', fontSize: 'var(--t-th)', color: 'var(--link)', fontWeight: 700, textTransform: 'uppercase', letterSpacing: '0.03em' }}>Preferred</span>
          </span>
        </label>
        <label style={{ display: 'flex', gap: 'var(--sp-sm)', alignItems: 'flex-start', cursor: 'pointer' }}>
          <input type="radio" name="overbooking-choice" checked={choice === 'overbook'} onChange={() => setChoice('overbook')} style={{ marginTop: 3 }} />
          <span style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>Add it to this booking anyway</span>
        </label>

        {choice === 'sub-rent' ? (
          <p style={{ margin: 0, display: 'flex', gap: 7, alignItems: 'flex-start', fontSize: 'var(--t-meta)', color: 'var(--text2)', lineHeight: 1.45 }}>
            <Icon name="info" size={13} style={{ flexShrink: 0, marginTop: 2, color: 'var(--muted)' }} />
            The equipment is added to this booking as a <strong>Sub-Rental</strong> line. It will be cross-hired
            from an external partner/supplier, bypassing the internal inventory conflict for these dates.
          </p>
        ) : (
          <p style={{ margin: 0, display: 'flex', gap: 7, alignItems: 'flex-start', fontSize: 'var(--t-meta)', color: 'var(--text2)', lineHeight: 1.45 }}>
            <Icon name="alert_triangle" size={13} style={{ flexShrink: 0, marginTop: 2, color: 'var(--warn-text)' }} />
            <span>
              The item goes onto this booking and the clash stays listed. <strong>Confirm remains blocked</strong>
              {' '}until a unit is free for these dates — reserving is enforced by the database, not by this screen —
              so use this to hold the item on a draft or quote while the clash is resolved.
            </span>
          </p>
        )}
      </div>
    </Modal>
  )
}
</file>

<file path="src/modules/rentals/booking/RentalFinancialRail.tsx">
import type { CSSProperties } from 'react'
import Icon from '../../../components/ui/Icon'
import { Button } from '../../../components/ui/Button'
import { Input } from '../../../components/ui'
import type { PricingPipelineResult } from '../../../lib/pricingPipeline'
import { formatMoney } from '../../../lib/money'
import { DiscountChips } from './DiscountChips'
import { Field, MoneyRow } from './BookingFormWidgets'
import { VatToggle } from './VatToggle'

export interface PromoNotice {
  tone: 'success' | 'danger'
  text: string
}

export interface RentalFinancialRailProps {
  pricing: PricingPipelineResult
  vatOn: boolean
  vatRatePercent: number
  onToggleVat: (on: boolean) => void
  canCrewMoney: boolean
  canViewMoney: boolean
  isDesktop: boolean
  inputStyle: CSSProperties
  discountPct: number
  discountCap: number
  onDiscountPct: (n: number) => void
  onSelectDiscountPreset: (pct: number, reason?: string) => void
  manualDiscountReason: string
  onManualDiscountReason: (v: string) => void
  manualDiscountAuthorizedBy: string
  onManualDiscountAuthorizedBy: (v: string) => void
  womenDopEligible: boolean
  onWomenDopEligible: (v: boolean) => void
  isStudentBundle: boolean
  promoCodeInput: string
  onPromoCodeInput: (v: string) => void
  promoCodeApplied: string | null
  onApplyPromo: (code: string) => void
  onRemovePromo: () => void
  promoNotice: PromoNotice | null
  manualDepositOverride: boolean
  onManualDepositOverrideChange: (on: boolean) => void
  manualDepositAmount: string
  onManualDepositAmount: (v: string) => void
  depositOverrideReason: string
  onDepositOverrideReason: (v: string) => void
  depositAuthorizedBy: string
  onDepositAuthorizedBy: (v: string) => void
}

const sub = {
  margin: '0 0 8px',
  fontSize: 'var(--t-th)',
  fontWeight: 700,
  color: 'var(--text2)',
  letterSpacing: '0.04em',
  textTransform: 'uppercase',
} as const

const moneyBlock = {
  background: 'var(--card2)',
  borderRadius: 'var(--r-card)',
  padding: 'var(--sp-md)',
  minWidth: 0,
} as const

/**
 * New Rental Section 5 — Pricing & Terms (extracted from `NewRental.tsx`).
 *
 * Read-only breakdown from `pricing` (engine-computed paisa integers) plus
 * controlled discount / promo / VAT / deposit inputs. No arithmetic here:
 * every figure comes from `src/lib/pricingPipeline.ts` and is formatted by
 * `src/lib/money.ts`. Law 5: the deposit card is liability-isolated, never in
 * the rental total. Law 6: money-blind roles get nothing (`null`), not a mask.
 */
export function RentalFinancialRail({
  pricing,
  vatOn,
  vatRatePercent,
  onToggleVat,
  canCrewMoney,
  canViewMoney,
  isDesktop,
  inputStyle,
  discountPct,
  discountCap,
  onDiscountPct,
  onSelectDiscountPreset,
  manualDiscountReason,
  onManualDiscountReason,
  manualDiscountAuthorizedBy,
  onManualDiscountAuthorizedBy,
  womenDopEligible,
  onWomenDopEligible,
  isStudentBundle,
  promoCodeInput,
  onPromoCodeInput,
  promoCodeApplied,
  onApplyPromo,
  onRemovePromo,
  promoNotice,
  manualDepositOverride,
  onManualDepositOverrideChange,
  manualDepositAmount,
  onManualDepositAmount,
  depositOverrideReason,
  onDepositOverrideReason,
  depositAuthorizedBy,
  onDepositAuthorizedBy,
}: RentalFinancialRailProps) {
  if (!canViewMoney) return null
  return (
    <div
      style={{
        display: 'grid',
        gridTemplateColumns: isDesktop ? 'repeat(2, minmax(0,1fr))' : '1fr',
        gap: 'var(--sp-md)',
      }}
    >
      {/* Column 1: Rental Charges Breakdown */}
      <div style={moneyBlock}>
        <h3 style={sub}>Rental Charges</h3>
        {[
          { l: 'Equipment Rental', v: formatMoney(pricing.equipmentSubtotalPaisa) },
          {
            l: 'Bundles',
            v: pricing.bundleSubtotalPaisa > 0 ? formatMoney(pricing.bundleSubtotalPaisa) : '—',
          },
          {
            l: 'Sub-Rental',
            v:
              pricing.subRentalSubtotalPaisa > 0
                ? formatMoney(pricing.subRentalSubtotalPaisa)
                : '—',
          },
          {
            l: 'Services & custom lines',
            v:
              pricing.servicesSubtotalPaisa > 0
                ? formatMoney(pricing.servicesSubtotalPaisa)
                : '—',
          },
          ...(canCrewMoney
            ? [
                {
                  l: 'Crew Charges',
                  v:
                    pricing.crewSubtotalPaisa > 0
                      ? formatMoney(pricing.crewSubtotalPaisa)
                      : '—',
                },
              ]
            : []),
          {
            l: 'Transport',
            v:
              pricing.deliverySubtotalPaisa > 0
                ? formatMoney(pricing.deliverySubtotalPaisa)
                : '—',
          },
        ].map((r) => (
          <MoneyRow key={r.l} label={r.l} value={r.v} {...(r.v === '—' ? { tone: 'var(--muted)' } : {})} />
        ))}
        <div style={{ borderTop: '1px solid var(--border)', marginTop: 6, paddingTop: 6 }}>
          <MoneyRow label="Subtotal" value={formatMoney(pricing.grossSubtotalPaisa)} />
          <MoneyRow
            label={
              pricing.discounts.appliedPercent > 0
                ? `Discount (${pricing.discounts.appliedPercent}%${pricing.discounts.capped ? ' - CAPPED' : ''})`
                : 'Discount'
            }
            value={
              pricing.discounts.discountPaisa > 0
                ? `− ${formatMoney(pricing.discounts.discountPaisa)}`
                : '—'
            }
            {...(pricing.discounts.discountPaisa > 0 ? { tone: 'var(--danger-text)' } : {})}
          />
          <MoneyRow label="Taxable Amount" value={formatMoney(pricing.taxableSubtotalPaisa)} />
          <MoneyRow
            label={vatOn ? `VAT (${pricing.vatRatePercent}%)` : 'VAT — off for this booking'}
            value={vatOn ? formatMoney(pricing.vatPaisa) : '—'}
            {...(vatOn ? {} : { tone: 'var(--muted)' })}
          />
        </div>
        <div style={{ marginTop: 8, paddingTop: 8, borderTop: '1px solid var(--border)' }}>
          <MoneyRow label="RENTAL TOTAL" value={formatMoney(pricing.rentalTotalPaisa)} big />
        </div>
        <div style={{ marginTop: 12, paddingTop: 10, borderTop: '1px solid var(--border)' }}>
          <MoneyRow
            label="Security Deposit (Refundable)"
            value={formatMoney(pricing.securityDeposit.requiredPaisa)}
            tone="var(--text2)"
          />
          <p style={{ margin: '2px 0 8px', fontSize: '11px', color: 'var(--muted)' }}>
            Held as a separate liability guarantee. Not taxable, not rental revenue.
          </p>
          <MoneyRow
            label={`Advance Required (${pricing.advanceRequiredPaisa === pricing.rentalTotalPaisa && pricing.rentalTotalPaisa <= 500000 ? '100%' : pricing.rentalTotalPaisa <= 1000000 ? 'Rs 5,000' : '50%'})`}
            value={formatMoney(pricing.advanceRequiredPaisa)}
            tone="var(--st-primary-fg)"
            strong
          />
          <p style={{ margin: '2px 0 0', fontSize: '11px', color: 'var(--muted)' }}>
            Tier policy: ≤ Rs 5,000 (100%) · ≤ Rs 10,000 (Rs 5,000) · &gt; Rs 10,000 (50%)
          </p>
        </div>
      </div>

      {/* Column 2: Discounts, VAT & Security Deposit Policy */}
      <div style={{ display: 'flex', flexDirection: 'column', gap: 'var(--sp-md)' }}>
        <div style={moneyBlock}>
          <h3 style={sub}>Discounts & Taxes</h3>
          <div style={{ marginTop: 8 }}>
            <Field label="Manual Discount % *">
              <Input
                type="number"
                min={0}
                max={discountCap}
                value={discountPct}
                onChange={(e) =>
                  onDiscountPct(Math.min(discountCap, Math.max(0, Number(e.target.value) || 0)))
                }
                style={inputStyle}
              />
            </Field>
            <div style={{ marginTop: 8 }}>
              <DiscountChips
                percent={discountPct}
                onPercent={onDiscountPct}
                amount={formatMoney(pricing.discounts.discountPaisa)}
                onSelectPreset={onSelectDiscountPreset}
              />
            </div>

            {discountPct > 0 && (
              <div
                style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 8, marginTop: 10 }}
              >
                <Field label="Discount Reason *">
                  <Input
                    value={manualDiscountReason}
                    onChange={(e) => onManualDiscountReason(e.target.value)}
                    placeholder="e.g. Director courtesy"
                    style={inputStyle}
                  />
                </Field>
                <Field label="Authorized By *">
                  <Input
                    value={manualDiscountAuthorizedBy}
                    onChange={(e) => onManualDiscountAuthorizedBy(e.target.value)}
                    placeholder="e.g. Babin"
                    style={inputStyle}
                  />
                </Field>
              </div>
            )}

            {/* Women DoP / Director toggle */}
            <label
              htmlFor="women-dop-eligible"
              style={{
                display: 'flex',
                alignItems: 'center',
                gap: 8,
                marginTop: 12,
                cursor: 'pointer',
                fontSize: 'var(--t-meta)',
              }}
            >
              <input
                id="women-dop-eligible"
                type="checkbox"
                aria-label="Women DoP / Director (+5% discount)"
                checked={womenDopEligible}
                onChange={(e) => onWomenDopEligible(e.target.checked)}
                style={{ cursor: 'pointer', width: 16, height: 16 }}
              />
              <span>
                <strong>Women DoP / Director (+5% discount)</strong>
                <span style={{ display: 'block', color: 'var(--muted)', fontSize: '11px' }}>
                  Encouraging women cinematographers & filmmakers in Nepal.
                </span>
              </span>
            </label>

            {/* Student bundle indicator */}
            {isStudentBundle && (
              <div
                style={{
                  marginTop: 10,
                  padding: '6px 10px',
                  borderRadius: 'var(--r-btn)',
                  background: 'var(--st-info-bg, #eff6ff)',
                  color: 'var(--st-info-fg, #1e40af)',
                  fontSize: '12px',
                }}
              >
                <Icon
                  name="info"
                  size={12}
                  style={{ display: 'inline', marginRight: 4, verticalAlign: '-1px' }}
                />
                Student/College bundle detected — subsidized flat rate lines are protected from
                stacking discounts.
              </div>
            )}

            {/* Promo code */}
            <div style={{ marginTop: 12, paddingTop: 10, borderTop: '1px solid var(--border)' }}>
              <Field label="Promo code (optional)">
                <div style={{ display: 'flex', gap: 8 }}>
                  <Input
                    value={promoCodeInput}
                    onChange={(e) => {
                      onPromoCodeInput(e.target.value.toUpperCase())
                    }}
                    placeholder="Promo code"
                    style={{ ...inputStyle, textTransform: 'uppercase' }}
                  />
                  <Button variant="secondary" type="button" onClick={() => onApplyPromo(promoCodeInput.trim().toUpperCase())}>
                    Apply
                  </Button>
                  {promoCodeApplied && (
                    <Button variant="ghost" type="button" onClick={onRemovePromo}>
                      Clear
                    </Button>
                  )}
                </div>
              </Field>
              {promoNotice && (
                <div
                  style={{
                    marginTop: 6,
                    fontSize: '12px',
                    color:
                      promoNotice.tone === 'success'
                        ? 'var(--st-success-fg, #065f46)'
                        : 'var(--danger-text)',
                  }}
                >
                  {promoNotice.text}
                </div>
              )}
            </div>

            {/* Stacking cap indicator */}
            {pricing.discounts.capped && (
              <div
                style={{
                  marginTop: 10,
                  padding: '6px 10px',
                  borderRadius: 'var(--r-btn)',
                  background: 'var(--st-warning-bg, #fffbeb)',
                  color: 'var(--st-warning-fg, #92400e)',
                  fontSize: '12px',
                }}
              >
                <Icon
                  name="alert_triangle"
                  size={12}
                  style={{ display: 'inline', marginRight: 4, verticalAlign: '-1px' }}
                />
                Discounts capped at 25% maximum per company policy.
              </div>
            )}

            {/* Validation errors */}
            {pricing.discounts.validationErrors.length > 0 && (
              <div
                style={{
                  marginTop: 9,
                  padding: 10,
                  borderRadius: 'var(--r-btn)',
                  background: 'var(--st-danger-bg)',
                }}
              >
                {pricing.discounts.validationErrors.map((err, i) => (
                  <div
                    key={i}
                    style={{
                      display: 'flex',
                      gap: 6,
                      alignItems: 'flex-start',
                      fontSize: 'var(--t-meta)',
                      fontWeight: 600,
                      color: 'var(--st-danger-fg)',
                      lineHeight: 1.4,
                    }}
                  >
                    <Icon name="error" size={12} style={{ flexShrink: 0, marginTop: 2 }} />
                    {err}
                  </div>
                ))}
              </div>
            )}
          </div>

          <div style={{ marginTop: 14, paddingTop: 10, borderTop: '1px solid var(--border)' }}>
            <VatToggle ratePercent={vatRatePercent} on={vatOn} onChange={onToggleVat} />
          </div>
        </div>

        {/* Security Deposit Block */}
        <div style={moneyBlock}>
          <h3 style={sub}>Security Deposit</h3>
          <div
            style={{
              display: 'flex',
              justifyContent: 'space-between',
              alignItems: 'center',
              marginTop: 8,
            }}
          >
            <span style={{ fontSize: 'var(--t-meta)', color: 'var(--text2)' }}>
              Recommended Deposit
            </span>
            <span style={{ fontSize: 'var(--t-meta)', fontWeight: 600 }}>
              {formatMoney(pricing.securityDeposit.recommendedPaisa)}
            </span>
          </div>

          <label
            htmlFor="manual-deposit-override"
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: 8,
              marginTop: 10,
              cursor: 'pointer',
              fontSize: 'var(--t-meta)',
            }}
          >
            <input
              id="manual-deposit-override"
              type="checkbox"
              aria-label="Manual security deposit override"
              checked={manualDepositOverride}
              onChange={(e) => onManualDepositOverrideChange(e.target.checked)}
              style={{ cursor: 'pointer', width: 16, height: 16 }}
            />
            <span>Manual Deposit Override</span>
          </label>

          {manualDepositOverride && (
            <div style={{ marginTop: 10, display: 'flex', flexDirection: 'column', gap: 8 }}>
              <Field label="Override Amount (Rs) *">
                <Input
                  type="number"
                  min={0}
                  value={manualDepositAmount}
                  onChange={(e) => onManualDepositAmount(e.target.value)}
                  placeholder="0"
                  style={inputStyle}
                />
              </Field>
              <Field label="Override Reason *">
                <Input
                  value={depositOverrideReason}
                  onChange={(e) => onDepositOverrideReason(e.target.value)}
                  placeholder="e.g. Low risk repeat client with corporate guarantee"
                  style={inputStyle}
                />
              </Field>
              <Field label="Authorized By *">
                <Input
                  value={depositAuthorizedBy}
                  onChange={(e) => onDepositAuthorizedBy(e.target.value)}
                  placeholder="e.g. Managing Director Babin"
                  style={inputStyle}
                />
              </Field>
            </div>
          )}

          {pricing.securityDeposit.validationErrors.length > 0 && (
            <div
              style={{
                marginTop: 9,
                padding: 10,
                borderRadius: 'var(--r-btn)',
                background: 'var(--st-danger-bg)',
              }}
            >
              {pricing.securityDeposit.validationErrors.map((err, i) => (
                <div
                  key={i}
                  style={{
                    display: 'flex',
                    gap: 6,
                    alignItems: 'flex-start',
                    fontSize: 'var(--t-meta)',
                    fontWeight: 600,
                    color: 'var(--st-danger-fg)',
                    lineHeight: 1.4,
                  }}
                >
                  <Icon name="error" size={12} style={{ flexShrink: 0, marginTop: 2 }} />
                  {err}
                </div>
              ))}
            </div>
          )}

          <p
            style={{
              margin: '10px 0 0',
              fontSize: 'var(--t-meta)',
              color: 'var(--muted)',
              lineHeight: 1.5,
            }}
          >
            <strong>Security Deposit Policy:</strong> Any security deposit required is held as a
            separate liability guarantee. It is never credited towards rental charges and does not
            reduce rental outstanding.
          </p>
          <p
            style={{
              margin: '10px 0 0',
              fontSize: 'var(--t-meta)',
              color: 'var(--muted)',
              lineHeight: 1.5,
            }}
          >
            <strong>Payment Recording:</strong> New Rental creates the booking reservation. Advance
            payments and security deposits are officially recorded with receipt numbers directly on
            the <strong>Booking Detail</strong> page once the booking and invoice are created.
          </p>
        </div>
      </div>
    </div>
  )
}
</file>

<file path="src/modules/rentals/booking/RentalLineItemsTree.tsx">
import { Fragment, useMemo } from 'react'
import './rental-line-items.css'
import { Link } from 'react-router-dom'
import Icon from '../../../components/ui/Icon'
import type { IconName } from '../../../components/ui/Icon'
import { DataTableShell } from '../../../components/ui/DataTable'
import { NumberStepper, RowMenu, TouchInset, srOnly } from './BookingFormWidgets'
import { formatMoney, roundHalfUp, type Paisa } from '../../../lib/money'
import { INV_STYLE, type InvStatus } from '../../../lib/queries/inventory'
import { STATUS } from '../../../lib/status'
import { IntelCard } from '../../../components/ui/IntelCard'
import { newRentalEquipmentGlance, newRentalEquipmentDetail } from '../../../data/newRentalEquipmentIntel'
import type { AvailabilityVerdict, EquipmentConflictSummary, EquipmentResult } from './itemCatalogue'
import type { GateContext } from '../../../lib/fieldGating'
import type { SystemRole } from '../../../types/database'
import type { PricingPipelineResult } from '../../../lib/pricingPipeline'

export interface Line {
  lineNote?: string | undefined
  serviceBasis?: 'Flat' | 'Per day' | undefined
  supplierCost?: number | undefined
  bookingLineId?: string | undefined
  id: string
  clientUuid?: string | undefined
  parentClientUuid?: string | null | undefined
  lineType?: 'Equipment' | 'Bundle' | 'Accessory' | 'Service' | 'Sub-rental' | 'Manual item' | undefined
  isIncluded?: boolean | undefined
  productId?: string | null | undefined
  bundleId?: string | null | undefined
  bundleCode?: string | undefined
  bundleName?: string | undefined
  name: string
  serial: string
  category: string
  ratePaisa: Paisa
  days: number
  daysOverridden?: boolean | undefined
  qty: number
  discountPct: number
  location: string
  status?: InvStatus | undefined
  committedTo: string
}

export function lineAmountPaisa(l: Line): Paisa {
  return roundHalfUp(l.qty * l.days * l.ratePaisa * (1 - l.discountPct / 100)) as Paisa
}

export interface LineGroup {
  key: string
  kind: 'bundle' | 'model'
  label: string
  lines: Line[]
}

export function groupLines(lines: readonly Line[]): LineGroup[] {
  const order: string[] = []
  const byKey = new Map<string, LineGroup>()
  for (const l of lines) {
    const key = l.bundleCode ? `bundle:${l.bundleCode}` : `model:${l.name}`
    let g = byKey.get(key)
    if (!g) {
      g = {
        key,
        kind: l.bundleCode ? 'bundle' : 'model',
        label: l.bundleCode ? (l.bundleName ?? l.bundleCode) : l.name,
        lines: [],
      }
      byKey.set(key, g)
      order.push(key)
    }
    g.lines.push(l)
  }
  return order.map((k) => byKey.get(k)).filter((g): g is LineGroup => g !== undefined)
}

export function isNested(g: LineGroup): boolean {
  return g.kind === 'bundle' || g.lines.length > 1
}

const th = {
  textAlign: 'left' as const,
  padding: '7px 9px',
  fontSize: 'var(--t-th)',
  fontWeight: 700,
  color: 'var(--text2)',
  letterSpacing: '0.03em',
  textTransform: 'uppercase' as const,
  whiteSpace: 'nowrap' as const,
  borderBottom: '1px solid var(--border)',
}

const td = {
  height: 'var(--row-min-h)',
  padding: '7px 9px',
  fontSize: 'var(--t-meta)',
  color: 'var(--text)',
  whiteSpace: 'nowrap' as const,
}

export interface RentalLineItemsTreeProps {
  lines: Line[]
  setLines: React.Dispatch<React.SetStateAction<Line[]>>
  collapsedBundles: Record<string, boolean>
  setCollapsedBundles: React.Dispatch<React.SetStateAction<Record<string, boolean>>>
  canBookingMoney: boolean
  conflictSummary: EquipmentConflictSummary | { conflicts?: readonly unknown[]; state?: string; text?: string; verdictByLineId: Map<string, AvailabilityVerdict> | ReadonlyMap<string, AvailabilityVerdict> }
  liveEquipment?: readonly EquipmentResult[] | null | undefined
  gateContext: GateContext
  user?: { id: string; role: SystemRole } | null
  navigate: (path: string) => void
  totalUnits: number
  bundleCount: number
  days: number
  pricing: PricingPipelineResult
  readOnly?: boolean
}

export function RentalLineItemsTree({
  lines,
  setLines,
  collapsedBundles,
  setCollapsedBundles,
  canBookingMoney,
  conflictSummary,
  liveEquipment,
  gateContext: gctx,
  user,
  navigate,
  totalUnits,
  bundleCount,
  days,
  pricing,
  readOnly = false,
}: RentalLineItemsTreeProps) {
  const lineGroups = useMemo(() => groupLines(lines), [lines])

  const equipmentColumns: Array<{ key: string; align: 'left' | 'right' }> = useMemo(
    () =>
      canBookingMoney
        ? [
            { key: 'Item', align: 'left' },
            { key: 'Category', align: 'left' },
            { key: 'Qty', align: 'right' },
            { key: 'Days', align: 'right' },
            { key: 'Rate / day', align: 'right' },
            { key: 'Disc.', align: 'right' },
            { key: 'Amount', align: 'right' },
            { key: 'Availability', align: 'left' },
            { key: '', align: 'right' },
          ]
        : [
            { key: 'Item', align: 'left' },
            { key: 'Category', align: 'left' },
            { key: 'Qty', align: 'right' },
            { key: 'Days', align: 'right' },
            { key: 'Availability', align: 'left' },
            { key: '', align: 'right' },
          ],
    [canBookingMoney],
  )

  const linePill = (
    l: Line,
  ): { label: string; title: string; bg: string; fg: string; icon: IconName; rank: number } => {
    if (l.lineType === 'Service' || l.lineType === 'Manual item') {
      return {
        label: 'Not inventory-tracked',
        title: `${l.lineType} — no serial assignment or availability check applies.`,
        bg: 'var(--st-neutral-bg)',
        fg: 'var(--st-neutral-fg)',
        icon: 'info',
        rank: 0,
      }
    }
    if (l.status) {
      const inv = INV_STYLE[l.status]
      return {
        label: l.status,
        title: l.committedTo !== '—' ? `${l.status} — committed to ${l.committedTo}` : l.status,
        bg: inv.bg === 'transparent' ? 'var(--st-in-bg)' : inv.bg,
        fg: inv.bg === 'transparent' ? 'var(--st-in-fg)' : inv.fg,
        icon: inv.icon,
        rank: l.status === 'In Stock' ? 0 : 3,
      }
    }
    const v: AvailabilityVerdict | undefined = conflictSummary.verdictByLineId.get(l.id)
    if (v === undefined) {
      return {
        label: 'Not checked',
        title: 'No availability answer for this line',
        bg: 'var(--st-neutral-bg)',
        fg: 'var(--st-neutral-fg)',
        icon: 'info',
        rank: 1,
      }
    }
    const t = STATUS[v.tone]
    return {
      label: v.label,
      title: v.detail,
      bg: t.bg,
      fg: t.fg,
      icon: v.icon,
      rank: v.level === 'available' ? 0 : v.level === 'unknown' ? 1 : v.level === 'partial' ? 2 : 3,
    }
  }

  const renderEquipmentRow = (
    l: Line,
    child: boolean,
    groupLabel: string,
    menuItems?: Array<{ label: string; icon: IconName; onClick: () => void }>,
  ) => {
    const pill = linePill(l)
    const intelRow = l.productId ? liveEquipment?.find((candidate) => candidate.productKey === l.productId) : undefined
    return (
      <tr role="row" className={child ? "rental-line-row rental-line-child" : "rental-line-row"} key={l.id} style={{ borderBottom: '1px solid var(--border)' }}>
        <td role="cell" data-label="Item" style={{ ...td, whiteSpace: 'normal', maxWidth: 260, paddingLeft: child ? 26 : 9 }}>
          <span style={{ display: 'flex', alignItems: 'baseline', gap: 5 }}>
            {child && (
              <span aria-hidden="true" style={{ color: 'var(--muted)', fontSize: 'var(--t-th)', flexShrink: 0 }}>
                └
              </span>
            )}
            {intelRow && l.productId ? (
              <IntelCard
                glance={newRentalEquipmentGlance(intelRow)}
                detail={newRentalEquipmentDetail(intelRow)}
                detailTitle={l.name}
                entityType="equipment"
                entityId={l.productId}
                context="new-rental"
                gateContext={gctx}
                actionContext={user ? { userId: user.id, role: user.role } : null}
              >
                <span
                  data-intel-identifier
                  className="identifier"
                  style={{
                    fontSize: child ? 'var(--t-meta)' : 'var(--t-ui)',
                    fontWeight: 600,
                    color: 'var(--link)',
                    lineHeight: 1.25,
                  }}
                >
                  {child && <span style={srOnly}>Part of {groupLabel}: </span>}
                  {l.name}
                </span>
              </IntelCard>
            ) : (
              <span
                style={{
                  fontSize: child ? 'var(--t-meta)' : 'var(--t-ui)',
                  fontWeight: 600,
                  color: 'var(--text)',
                  lineHeight: 1.25,
                }}
              >
                {child && <span style={srOnly}>Part of {groupLabel}: </span>}
                {l.name}
              </span>
            )}
          </span>
          <span
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: 6,
              marginTop: 1,
              fontSize: 'var(--t-th)',
              color: 'var(--text2)',
              flexWrap: 'wrap',
            }}
          >
            {l.lineType === 'Sub-rental' ? (
              <span
                style={{
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: 3,
                  padding: '1px 6px',
                  borderRadius: 'var(--r-badge)',
                  background: 'var(--gold-soft, rgba(217, 119, 6, 0.15))',
                  color: 'var(--gold, #d97706)',
                  fontWeight: 700,
                  fontSize: 'var(--t-th)',
                }}
              >
                <Icon name="box" size={10} />
                Sub-rental
              </span>
            ) : l.lineType === 'Service' || l.lineType === 'Manual item' ? (
              <span>{l.lineType}</span>
            ) : l.serial !== '—' ? (
              <Link
                className="identifier"
                to={`/inventory/${l.serial}`}
                style={{ color: 'inherit', textDecoration: 'none' }}
                title={`Open unit ${l.serial} in Inventory`}
              >
                {l.serial}
              </Link>
            ) : (
              <span>Bulk stock — no serial</span>
            )}
            <span aria-hidden style={{ opacity: 0.5 }}>
              ·
            </span>
            <span>{l.location}</span>
            {l.bundleName && !child && (
              <span
                title={`Added as part of the ${l.bundleName} bundle`}
                style={{
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: 3,
                  padding: '0 5px',
                  borderRadius: 'var(--r-badge)',
                  background: 'var(--st-primary-bg)',
                  color: 'var(--st-primary-fg)',
                  fontWeight: 700,
                }}
              >
                <Icon name="package" size={10} />
                {l.bundleName}
              </span>
            )}
          </span>
        </td>
        <td role="cell" data-label="Category" style={{ ...td, color: 'var(--text2)' }}>{l.category}</td>
        <td role="cell" data-label="Quantity" style={{ ...td, textAlign: 'right' }} title={l.serial !== '—' ? 'One serialized unit per row' : undefined}>
          <NumberStepper
            value={l.qty}
            disabled={readOnly || l.serial !== '—'}
            label={`quantity for ${l.name}`}
            onChange={(n) => setLines((p) => p.map((x) => (x.id === l.id ? { ...x, qty: n } : x)))}
          />
        </td>
        <td role="cell" data-label="Days" style={{ ...td, textAlign: 'right' }}>
          <NumberStepper
            value={l.days}
            disabled={readOnly}
            label={`days for ${l.name}`}
            onChange={(n) =>
              setLines((p) => p.map((x) => (x.id === l.id ? { ...x, days: n, daysOverridden: true } : x)))
            }
          />
        </td>
        {canBookingMoney && (
          <>
            <td role="cell" data-label="Rate / day" className="figure" style={{ ...td, textAlign: 'right', color: 'var(--text2)' }}>
              {formatMoney(l.ratePaisa)}
            </td>
            <td role="cell" data-label="Discount" style={{ ...td, textAlign: 'right' }}>
              {l.discountPct > 0 ? (
                <span
                  className="figure"
                  title={`${l.discountPct}% line discount`}
                  style={{
                    display: 'inline-flex',
                    alignItems: 'center',
                    height: 18,
                    padding: '0 6px',
                    borderRadius: 'var(--r-badge)',
                    background: 'var(--st-neutral-bg)',
                    color: 'var(--st-neutral-fg)',
                    fontSize: 'var(--t-th)',
                    fontWeight: 700,
                  }}
                >
                  −{l.discountPct}%
                </span>
              ) : (
                <span style={{ color: 'var(--muted)' }}>—</span>
              )}
            </td>
            <td role="cell" data-label="Amount" className="figure" style={{ ...td, textAlign: 'right', fontWeight: 700 }}>
              {formatMoney(lineAmountPaisa(l))}
            </td>
          </>
        )}
        <td role="cell" data-label="Availability" style={td}>
          <span
            title={pill.title}
            style={{
              display: 'inline-flex',
              alignItems: 'center',
              gap: 'var(--sp-xs)',
              height: 20,
              padding: '0 7px',
              borderRadius: 'var(--r-badge)',
              fontSize: 'var(--t-th)',
              fontWeight: 700,
              background: pill.bg,
              color: pill.fg,
            }}
          >
            <Icon name={pill.icon} size={11} />
            {pill.label}
          </span>
        </td>
        <td role="cell" data-label="Actions" style={{ ...td, width: 34, textAlign: 'right' }}>
          {!readOnly && (
            menuItems ? (
              <RowMenu label={`Actions for ${l.name}`} items={menuItems} />
            ) : (
              <button
                type="button"
                className="press"
                aria-label={`Remove ${l.name} from this booking`}
                title={`Remove ${l.name}`}
                onClick={() => setLines((p) => p.filter((x) => x.id !== l.id))}
                style={{
                  position: 'relative',
                  width: 26,
                  height: 26,
                  display: 'grid',
                  placeItems: 'center',
                  borderRadius: 'var(--r-xs)',
                  border: 'none',
                  background: 'transparent',
                  color: 'var(--muted)',
                  cursor: 'pointer',
                }}
              >
                <TouchInset />
                <Icon name="close" size={13} />
              </button>
            )
          )}
        </td>
      </tr>
    )
  }

  if (lines.length === 0) {
    return (
      <div className="new-rental-empty-products">
        <Icon name="box" size={22} />
        <p>Search above to add equipment or a bundle.</p>
      </div>
    )
  }

  return (
    <>
      <div className="rental-line-items">
      <DataTableShell className="rental-line-items-shell" ariaLabel="Booking equipment and bundles">
        <table role="table" aria-label="Selected rental items" className="rental-line-table">
          <thead role="rowgroup">
            <tr role="row" style={{ background: 'var(--th-bg)' }}>
              {equipmentColumns.map((c, i) => (
                <th role="columnheader" key={c.key || `col-${i}`} scope="col" style={{ ...th, textAlign: c.align }}>
                  {c.key}
                </th>
              ))}
            </tr>
          </thead>
          <tbody role="rowgroup">
            {lineGroups.map((g) => {
              const nested = isNested(g)
              const isCollapsed = Boolean(collapsedBundles[g.key])
              const groupUnits = g.lines.reduce((s, l) => s + l.qty, 0)
              const dayValues = Array.from(new Set(g.lines.map((l) => l.days)))
              const minDays = Math.min(...dayValues)
              const maxDays = Math.max(...dayValues)
              const groupAmountPaisa = g.lines.reduce((s, l) => s + lineAmountPaisa(l), 0) as Paisa
              const parentPill = g.lines
                .map(linePill)
                .reduce((worst, x) => (x.rank > worst.rank ? x : worst))
              const menuItems = [
                {
                  label: nested ? `Remove all ${g.lines.length} lines` : 'Remove from this booking',
                  icon: 'close' as IconName,
                  onClick: () => setLines((p) => p.filter((x) => !g.lines.some((y) => y.id === x.id))),
                },
                ...(!nested && g.lines[0] && g.lines[0].serial !== '—'
                  ? [
                      {
                        label: 'Open in Inventory',
                        icon: 'external_link' as IconName,
                        onClick: () => navigate(`/inventory/${g.lines[0]?.serial ?? ''}`),
                      },
                    ]
                  : []),
              ]

              return (
                <Fragment key={g.key}>
                  {nested ? (
                    <tr role="row" className="rental-line-row rental-line-group" style={{ borderBottom: '1px solid var(--border)', background: 'var(--card2)' }}>
                      <td role="cell" data-label="Item" style={{ ...td, whiteSpace: 'normal', maxWidth: 260 }}>
                        <span style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
                          <button
                            type="button"
                            className="new-rental-bundle-toggle press"
                            onClick={() => setCollapsedBundles((prev) => ({ ...prev, [g.key]: !prev[g.key] }))}
                            aria-label={isCollapsed ? `Expand ${g.label}` : `Collapse ${g.label}`}
                            aria-expanded={!isCollapsed}
                            title={isCollapsed ? 'Expand components' : 'Collapse components'}
                            style={{ position: 'relative' }}
                          >
                            <TouchInset />
                            <Icon name={isCollapsed ? 'chevron_right' : 'chevron_down'} size={12} />
                          </button>
                          <Icon
                            name={g.kind === 'bundle' ? 'package' : 'box'}
                            size={13}
                            style={{ color: 'var(--text2)', flexShrink: 0 }}
                          />
                          <span style={{ fontSize: 'var(--t-ui)', fontWeight: 700, color: 'var(--text)', lineHeight: 1.25 }}>
                            {g.label}
                          </span>
                        </span>
                        <span style={{ display: 'block', marginTop: 1, marginLeft: 28, fontSize: 'var(--t-th)', color: 'var(--text2)' }}>
                          {g.kind === 'bundle'
                            ? `Bundle · ${g.lines.length} component${g.lines.length === 1 ? '' : 's'}${isCollapsed ? ' (collapsed)' : ''}`
                            : `${g.lines.length} units${isCollapsed ? ' (collapsed)' : ''}`}
                        </span>
                      </td>
                      <td role="cell" data-label="Category" style={{ ...td, color: 'var(--text2)' }}>{g.lines[0]?.category ?? '—'}</td>
                      <td role="cell" data-label="Quantity" className="figure" style={{ ...td, textAlign: 'right', fontWeight: 700 }}>
                        {groupUnits}
                      </td>
                      <td role="cell" data-label="Days" className="figure" style={{ ...td, textAlign: 'right', fontWeight: 700 }}>
                        {minDays === maxDays ? minDays : `${minDays}–${maxDays}`}
                      </td>
                      {canBookingMoney && (
                        <>
                          <td role="cell" data-label="Rate / day" style={{ ...td, textAlign: 'right', color: 'var(--muted)' }}>—</td>
                          <td role="cell" data-label="Discount" style={{ ...td, textAlign: 'right', color: 'var(--muted)' }}>—</td>
                          <td role="cell" data-label="Amount" className="figure" style={{ ...td, textAlign: 'right', fontWeight: 700 }}>
                            {formatMoney(groupAmountPaisa)}
                          </td>
                        </>
                      )}
                      <td role="cell" data-label="Availability" style={td}>
                        <span
                          title={parentPill.title}
                          style={{
                            display: 'inline-flex',
                            alignItems: 'center',
                            gap: 'var(--sp-xs)',
                            height: 20,
                            padding: '0 7px',
                            borderRadius: 'var(--r-badge)',
                            fontSize: 'var(--t-th)',
                            fontWeight: 700,
                            background: parentPill.bg,
                            color: parentPill.fg,
                          }}
                        >
                          <Icon name={parentPill.icon} size={11} />
                          {parentPill.label}
                        </span>
                      </td>
                      <td role="cell" data-label="Actions" style={{ ...td, width: 34, textAlign: 'right' }}>
                        {!readOnly && <RowMenu label={`Actions for ${g.label}`} items={menuItems} />}
                      </td>
                    </tr>
                  ) : null}
                  {(!nested || !isCollapsed) &&
                    g.lines.map((l) => renderEquipmentRow(l, nested, g.label, nested ? undefined : menuItems))}
                </Fragment>
              )
            })}
          </tbody>
        </table>
      </DataTableShell>
      </div>

      <div
        style={{
          display: 'flex',
          gap: 'var(--sp-lg)',
          flexWrap: 'wrap',
          alignItems: 'baseline',
          marginTop: 10,
          paddingTop: 9,
          borderTop: '1px solid var(--border)',
          fontSize: 'var(--t-meta)',
        }}
      >
        {[
          { l: 'Items', v: lines.length === 0 ? '—' : `${totalUnits}` },
          { l: 'Bundles', v: bundleCount === 0 ? '—' : String(bundleCount) },
          { l: 'Rental Days', v: days === 0 ? '—' : String(days) },
        ].map((x) => (
          <span key={x.l} style={{ display: 'inline-flex', gap: 5 }}>
            <span style={{ color: 'var(--text2)' }}>{x.l}</span>
            <span className="figure" style={{ fontWeight: 700, color: x.v === '—' ? 'var(--muted)' : 'var(--text)' }}>
              {x.v}
            </span>
          </span>
        ))}
        {canBookingMoney && (
          <span style={{ marginLeft: 'auto', display: 'inline-flex', gap: 7, alignItems: 'baseline' }}>
            <span style={{ color: 'var(--text2)' }}>Line Subtotal</span>
            <span className="figure" style={{ fontWeight: 700, fontSize: 'var(--t-ui)' }}>
              {formatMoney(
                (pricing.equipmentSubtotalPaisa + pricing.bundleSubtotalPaisa + pricing.servicesSubtotalPaisa) as Paisa,
              )}
            </span>
          </span>
        )}
      </div>
    </>
  )
}
</file>

<file path="src/modules/rentals/booking/useNewRentalCatalogue.ts">
import { useEffect, useMemo, useState } from 'react'
import { listClientRecords, type ClientRecord } from '../../../lib/queries/clients'
import { listInventory } from '../../../lib/queries/inventory'
import { readProductAvailability } from '../../../lib/queries/productAvailability'
import { listBundleRecords } from '../../../lib/queries/bundleRecords'
import { bundleCapacityView } from '../../../lib/bundleCapacityView'
import type { BundleRecord } from '../../../data/bundles'
import type { RentalWindow } from '../../../lib/availability'
import { listCrewMembers, type CrewMember } from '../../../lib/queries/crew'
import {
  bundleResults,
  equipmentResultsFrom,
  type BookingWindow,
  type BundleResult,
  type EquipmentAvailabilitySource,
  type EquipmentResult,
  type LiveEquipmentRow,
} from './itemCatalogue'

export interface UseNewRentalCatalogueOptions {
  canBookingMoney: boolean
  pickupAt: Date | null
  returnAt: Date | null
  bookingWindow: BookingWindow
}

export interface UseNewRentalCatalogueResult {
  clientPool: ClientRecord[]
  setClientPool: React.Dispatch<React.SetStateAction<ClientRecord[]>>
  clientsAreLive: boolean
  liveRows: readonly LiveEquipmentRow[] | null
  liveCrew: readonly CrewMember[] | null
  liveBundles: readonly BundleRecord[] | null
  poolSettled: boolean
  poolError: string | null
  availabilitySource: EquipmentAvailabilitySource
  liveEquipment: readonly EquipmentResult[] | null
  liveBundleResults: readonly BundleResult[]
}

/**
 * Encapsulates the live database reads and windowed availability queries
 * for New Rental's clients, equipment inventory, crew roster, and bundles.
 */
export function useNewRentalCatalogue({
  canBookingMoney,
  pickupAt,
  returnAt,
  bookingWindow,
}: UseNewRentalCatalogueOptions): UseNewRentalCatalogueResult {
  const [clientPool, setClientPool] = useState<ClientRecord[]>([])
  const [clientsAreLive, setClientsAreLive] = useState(false)
  const [liveRows, setLiveRows] = useState<readonly LiveEquipmentRow[] | null>(null)
  const [liveCrew, setLiveCrew] = useState<readonly CrewMember[] | null>(null)
  const [liveBundles, setLiveBundles] = useState<readonly BundleRecord[] | null>(null)
  const [poolSettled, setPoolSettled] = useState(false)
  const [poolError, setPoolError] = useState<string | null>(null)

  useEffect(() => {
    let cancelled = false
    void (async () => {
      try {
        const [clients, inventory, crewResult] = await Promise.all([
          listClientRecords(),
          listInventory({ page: { index: 0, size: 500 }, withMoney: canBookingMoney }),
          listCrewMembers(),
        ])
        if (cancelled) return
        const bookableClients = clients.filter((c) => !!c.dbId)
        setClientPool(bookableClients)
        setClientsAreLive(true)
        const rows = inventory.rows.filter((r) => r.isActive)
        if (rows.length > 0) setLiveRows(rows)

        if (crewResult && crewResult.rows && crewResult.rows.length > 0) {
          setLiveCrew(crewResult.rows)
        }
      } catch (e: unknown) {
        if (!cancelled) setPoolError(e instanceof Error ? e.message : String(e))
      } finally {
        if (!cancelled) setPoolSettled(true)
      }
    })()
    return () => {
      cancelled = true
    }
  }, [canBookingMoney])

  const [availabilitySource, setAvailabilitySource] = useState<EquipmentAvailabilitySource>({
    state: 'checking',
  })

  useEffect(() => {
    if (!pickupAt || !returnAt || returnAt.getTime() <= pickupAt.getTime()) {
      setAvailabilitySource({ state: 'no-window' })
      return
    }
    if (poolError !== null) {
      setAvailabilitySource({ state: 'failed', reason: poolError })
      return
    }
    if (liveRows === null) {
      setAvailabilitySource(poolSettled ? { state: 'ready', byProduct: new Map() } : { state: 'checking' })
      return
    }

    let cancelled = false
    setAvailabilitySource({ state: 'checking' })
    const window: RentalWindow = { fromAd: pickupAt.toISOString(), toAd: returnAt.toISOString() }
    void (async () => {
      try {
        const [byProduct, bundles] = await Promise.all([
          readProductAvailability(window, liveRows.map((r) => r.id)),
          listBundleRecords(window, { withMoney: canBookingMoney }),
        ])
        if (!cancelled) {
          setAvailabilitySource({ state: 'ready', byProduct })
          if (bundles && bundles.length > 0) {
            /* G4: kit capacity from the same windowed answers the catalogue rows use. A component with no
               answer (or a serialised product with no unit rows) yields no capacity at all — never a guess. */
            const freeOf = (id: string): number | undefined => {
              const a = byProduct.get(id)
              if (!a || (a.mode === 'unit' && a.unitsOwned === 0)) return undefined
              return a.unitsFree
            }
            setLiveBundles(bundles.map((b) => ({ ...b, kitCapacity: bundleCapacityView(b.lines, freeOf) })))
          }
        }
      } catch (e: unknown) {
        if (!cancelled) {
          setAvailabilitySource({ state: 'failed', reason: e instanceof Error ? e.message : String(e) })
        }
      }
    })()
    return () => {
      cancelled = true
    }
  }, [liveRows, pickupAt, returnAt, poolError, poolSettled, canBookingMoney])

  const liveEquipment = useMemo(
    () => (liveRows === null ? null : equipmentResultsFrom(liveRows, availabilitySource)),
    [liveRows, availabilitySource],
  )

  const liveBundleResults = useMemo(
    () => bundleResults(bookingWindow, liveBundles ?? undefined),
    [bookingWindow, liveBundles],
  )

  return {
    clientPool,
    setClientPool,
    clientsAreLive,
    liveRows,
    liveCrew,
    liveBundles,
    poolSettled,
    poolError,
    availabilitySource,
    liveEquipment,
    liveBundleResults,
  }
}
</file>

<file path="src/modules/rentals/booking/useNewRentalClient.ts">
import {
  useCallback,
  useEffect,
  useMemo,
  useRef,
  useState,
  type Dispatch,
  type MutableRefObject,
  type RefObject,
  type SetStateAction,
} from 'react'
import type { ClientRecord } from '../../../lib/queries/clients'
import { clientHealth, type ClientHealthVerdict } from './clientHealth'

export interface UseNewRentalClientOptions {
  searchParams: URLSearchParams
  clientPool: ClientRecord[]
  setClientPool: Dispatch<SetStateAction<ClientRecord[]>>
  setGovId: Dispatch<SetStateAction<string>>
  showSuccessToast: (title: string, desc?: string) => void
}

export interface UseNewRentalClientResult {
  selectedClientId: string | null
  setSelectedClientId: Dispatch<SetStateAction<string | null>>
  client: ClientRecord | undefined
  quickViewOpen: boolean
  setQuickViewOpen: Dispatch<SetStateAction<boolean>>
  historyOpen: boolean
  setHistoryOpen: Dispatch<SetStateAction<boolean>>
  addClientOpen: boolean
  setAddClientOpen: Dispatch<SetStateAction<boolean>>
  clientFieldRef: RefObject<HTMLDivElement | null>
  clientFieldTouched: boolean
  setClientFieldTouched: Dispatch<SetStateAction<boolean>>
  suppressClientListOnFocus: MutableRefObject<boolean>
  focusClientInput: () => void
  openAddClient: () => void
  closeAddClient: () => void
  selectClient: (c: ClientRecord) => void
  onClientCreated: (created: ClientRecord) => void
  health: ClientHealthVerdict | null
}

/**
 * Encapsulates client pool selection, URL synchronization,
 * health signal computation, focus suppression, and client drawer/modal disclosures.
 */
export function useNewRentalClient({
  searchParams,
  clientPool,
  setClientPool,
  setGovId,
  showSuccessToast,
}: UseNewRentalClientOptions): UseNewRentalClientResult {
  const [selectedClientId, setSelectedClientId] = useState<string | null>(
    () => searchParams.get('clientId') || searchParams.get('client') || null,
  )

  const client: ClientRecord | undefined = useMemo(
    () => clientPool.find((c) => c.id === selectedClientId || (c.dbId && c.dbId === selectedClientId)),
    [clientPool, selectedClientId],
  )

  /* Connect URL client parameter to selection as soon as client pool loads */
  useEffect(() => {
    const rawParam = searchParams.get('clientId') || searchParams.get('client')
    if (!rawParam) return
    const match = clientPool.find((c) => c.id === rawParam || (c.dbId && c.dbId === rawParam))
    if (match) {
      if (selectedClientId !== match.id) {
        setSelectedClientId(match.id)
      }
      if (match.pan) {
        setGovId(match.pan)
      }
    }
  }, [clientPool, searchParams, selectedClientId, setGovId])

  // Disclosures over the workspace: quick view, history, add client
  const [quickViewOpen, setQuickViewOpen] = useState(false)
  const [historyOpen, setHistoryOpen] = useState(false)
  const [addClientOpen, setAddClientOpen] = useState(false)

  const clientFieldRef = useRef<HTMLDivElement | null>(null)
  const [clientFieldTouched, setClientFieldTouched] = useState(false)
  const suppressClientListOnFocus = useRef(false)

  const focusClientInput = useCallback(() => {
    suppressClientListOnFocus.current = true
    const input = clientFieldRef.current?.querySelector<HTMLInputElement>('input[role="combobox"]')
    if (input) input.focus()
    else suppressClientListOnFocus.current = false
  }, [])

  const openAddClient = useCallback(() => {
    focusClientInput()
    setAddClientOpen(true)
  }, [focusClientInput])

  const closeAddClient = useCallback(() => {
    suppressClientListOnFocus.current = true
    setAddClientOpen(false)
  }, [])

  const selectClient = useCallback(
    (c: ClientRecord) => {
      setSelectedClientId(c.id)
      setGovId(c.pan ?? '')
    },
    [setGovId],
  )

  const onClientCreated = useCallback(
    (created: ClientRecord) => {
      setClientPool((prev) => (prev.some((c) => c.id === created.id) ? prev : [created, ...prev]))
      setSelectedClientId(created.id)
      setGovId(created.pan ?? '')
      showSuccessToast('Client added', `${created.name} is selected on this booking.`)
    },
    [setClientPool, setGovId, showSuccessToast],
  )

  const health = useMemo(() => (client ? clientHealth(client) : null), [client])

  return {
    selectedClientId,
    setSelectedClientId,
    client,
    quickViewOpen,
    setQuickViewOpen,
    historyOpen,
    setHistoryOpen,
    addClientOpen,
    setAddClientOpen,
    clientFieldRef,
    clientFieldTouched,
    setClientFieldTouched,
    suppressClientListOnFocus,
    focusClientInput,
    openAddClient,
    closeAddClient,
    selectClient,
    onClientCreated,
    health,
  }
}
</file>

<file path="src/modules/rentals/booking/useNewRentalLogistics.ts">
import {
  useCallback,
  useMemo,
  useState,
  type Dispatch,
  type SetStateAction,
} from 'react'
import { rupees, type Paisa } from '../../../lib/money'
import { crewPool, type CrewMember } from '../../../lib/queries/crew'
import type { QuoteSnapshot } from '../../../lib/queries/quoteEditor'
import type { CrewLine } from './CrewSection'
import type { TransportDetails } from './CrewAndTransportSection'

export interface UseNewRentalLogisticsOptions {
  liveCrew?: readonly CrewMember[] | null
  quoteSnapshot?: QuoteSnapshot | null
}

export interface UseNewRentalLogisticsResult {
  // Delivery & Return
  deliveryType: 'Client Pickup' | 'Babin Delivery'
  setDeliveryType: Dispatch<SetStateAction<'Client Pickup' | 'Babin Delivery'>>
  deliveryChargePaisa: Paisa
  setDeliveryChargePaisa: Dispatch<SetStateAction<Paisa>>
  fuelChargePaisa: Paisa
  setFuelChargePaisa: Dispatch<SetStateAction<Paisa>>
  vehicle: string
  setVehicle: Dispatch<SetStateAction<string>>
  numberPlate: string
  setNumberPlate: Dispatch<SetStateAction<string>>
  driverContact: string
  setDriverContact: Dispatch<SetStateAction<string>>
  pickupLocation: string
  setPickupLocation: Dispatch<SetStateAction<string>>
  returnLocation: string
  setReturnLocation: Dispatch<SetStateAction<string>>
  specialInstructions: string
  setSpecialInstructions: Dispatch<SetStateAction<string>>
  returnPickupType: 'Client Return' | 'Babin Pickup'
  setReturnPickupType: Dispatch<SetStateAction<'Client Return' | 'Babin Pickup'>>
  returnPickupAddress: string
  setReturnPickupAddress: Dispatch<SetStateAction<string>>
  returnPickupTime: string
  setReturnPickupTime: Dispatch<SetStateAction<string>>
  returnPickupChargePaisa: number
  setReturnPickupChargePaisa: Dispatch<SetStateAction<number>>

  // Crew state & handlers
  crew: CrewLine[]
  setCrew: Dispatch<SetStateAction<CrewLine[]>>
  seedCrewLine: (m: CrewMember) => CrewLine
  addCrew: (crewId: string) => void
  removeCrew: (crewId: string) => void
  handleUpdateCrew: (crewId: string, updates: Partial<CrewLine>) => void

  // Transport calculations & consolidated updater
  clientPickup: boolean
  quoteFuelPaisa: Paisa
  outgoingTransportPaisa: number
  returnTransportPaisa: number
  transportPaisa: Paisa
  transportDetails: TransportDetails
  handleUpdateTransport: (updates: Partial<TransportDetails>) => void
}

/**
 * Encapsulates logistics state: crew roster assignments, delivery transport details,
 * return-pickup coordination, and vehicle/driver recording.
 */
export function useNewRentalLogistics({
  liveCrew,
  quoteSnapshot,
}: UseNewRentalLogisticsOptions): UseNewRentalLogisticsResult {
  // Delivery & Outgoing Transport
  const [deliveryType, setDeliveryType] = useState<'Client Pickup' | 'Babin Delivery'>('Client Pickup')
  const [deliveryChargePaisa, setDeliveryChargePaisa] = useState<Paisa>(rupees(0) as Paisa)
  const [fuelChargePaisa, setFuelChargePaisa] = useState<Paisa>(rupees(0) as Paisa)
  const [vehicle, setVehicle] = useState('')
  const [numberPlate, setNumberPlate] = useState('')
  const [driverContact, setDriverContact] = useState('')
  const [pickupLocation, setPickupLocation] = useState('')
  const [returnLocation, setReturnLocation] = useState('')
  const [specialInstructions, setSpecialInstructions] = useState('')

  // Return Pickup Logistics (§3.3)
  const [returnPickupType, setReturnPickupType] = useState<'Client Return' | 'Babin Pickup'>('Client Return')
  const [returnPickupAddress, setReturnPickupAddress] = useState('')
  const [returnPickupTime, setReturnPickupTime] = useState('18:00')
  const [returnPickupChargePaisa, setReturnPickupChargePaisa] = useState<number>(0)

  // Crew state
  const [crew, setCrew] = useState<CrewLine[]>(() => [])

  const seedCrewLine = useCallback(
    (m: CrewMember): CrewLine => ({
      crewId: m.id,
      name: m.name,
      role: m.role,
      phone: m.phone,
      dayRatePaisa: m.dayRatePaisa,
      overtimePaisa: rupees(0) as Paisa,
      accommodationPaisa: rupees(0) as Paisa,
      mealsPaisa: rupees(0) as Paisa,
    }),
    [],
  )

  const addCrew = useCallback(
    (crewId: string) => {
      const rosterPool = crewPool(liveCrew)
      const m = rosterPool.find((x) => x.id === crewId)
      if (!m || crew.some((c) => c.crewId === crewId)) return
      setCrew((p) => [...p, seedCrewLine(m)])
    },
    [liveCrew, crew, seedCrewLine],
  )

  const removeCrew = useCallback((crewId: string) => {
    setCrew((p) => p.filter((c) => c.crewId !== crewId))
  }, [])

  const handleUpdateCrew = useCallback((crewId: string, updates: Partial<CrewLine>) => {
    setCrew((p) => p.map((c) => (c.crewId === crewId ? { ...c, ...updates } : c)))
  }, [])

  // §9.2 — Client Pickup forces both transport charges to zero.
  const clientPickup = deliveryType === 'Client Pickup'
  const quoteFuelPaisa =
    clientPickup && quoteSnapshot?.values.delivery_type !== 'Client Pickup'
      ? (0 as Paisa)
      : fuelChargePaisa
  const outgoingTransportPaisa = (clientPickup ? 0 : deliveryChargePaisa) + quoteFuelPaisa
  const returnTransportPaisa = returnPickupType === 'Client Return' ? 0 : returnPickupChargePaisa
  const transportPaisa = (outgoingTransportPaisa + returnTransportPaisa) as Paisa

  const transportDetails = useMemo<TransportDetails>(
    () => ({
      clientPickup,
      deliveryType,
      vehicle,
      numberPlate,
      driverContact,
      pickupLocation,
      returnLocation,
      specialInstructions,
      returnPickupType,
      returnPickupAddress,
      returnPickupTime,
      returnPickupChargePaisa,
      deliveryChargePaisa,
      fuelChargePaisa,
      transportPaisa,
    }),
    [
      clientPickup,
      deliveryType,
      vehicle,
      numberPlate,
      driverContact,
      pickupLocation,
      returnLocation,
      specialInstructions,
      returnPickupType,
      returnPickupAddress,
      returnPickupTime,
      returnPickupChargePaisa,
      deliveryChargePaisa,
      fuelChargePaisa,
      transportPaisa,
    ],
  )

  const handleUpdateTransport = useCallback((updates: Partial<TransportDetails>) => {
    if (updates.deliveryType !== undefined) {
      setDeliveryType(updates.deliveryType)
    } else if (updates.clientPickup !== undefined) {
      setDeliveryType(updates.clientPickup ? 'Client Pickup' : 'Babin Delivery')
    }
    if (updates.vehicle !== undefined) setVehicle(updates.vehicle)
    if (updates.numberPlate !== undefined) setNumberPlate(updates.numberPlate)
    if (updates.driverContact !== undefined) setDriverContact(updates.driverContact)
    if (updates.pickupLocation !== undefined) setPickupLocation(updates.pickupLocation)
    if (updates.returnLocation !== undefined) setReturnLocation(updates.returnLocation)
    if (updates.specialInstructions !== undefined) setSpecialInstructions(updates.specialInstructions)
    if (updates.returnPickupType !== undefined) setReturnPickupType(updates.returnPickupType)
    if (updates.returnPickupAddress !== undefined) setReturnPickupAddress(updates.returnPickupAddress)
    if (updates.returnPickupTime !== undefined) setReturnPickupTime(updates.returnPickupTime)
    if (updates.returnPickupChargePaisa !== undefined) setReturnPickupChargePaisa(updates.returnPickupChargePaisa)
    if (updates.deliveryChargePaisa !== undefined) setDeliveryChargePaisa(updates.deliveryChargePaisa)
    if (updates.fuelChargePaisa !== undefined) setFuelChargePaisa(updates.fuelChargePaisa)
  }, [])

  return {
    deliveryType,
    setDeliveryType,
    deliveryChargePaisa,
    setDeliveryChargePaisa,
    fuelChargePaisa,
    setFuelChargePaisa,
    vehicle,
    setVehicle,
    numberPlate,
    setNumberPlate,
    driverContact,
    setDriverContact,
    pickupLocation,
    setPickupLocation,
    returnLocation,
    setReturnLocation,
    specialInstructions,
    setSpecialInstructions,
    returnPickupType,
    setReturnPickupType,
    returnPickupAddress,
    setReturnPickupAddress,
    returnPickupTime,
    setReturnPickupTime,
    returnPickupChargePaisa,
    setReturnPickupChargePaisa,
    crew,
    setCrew,
    seedCrewLine,
    addCrew,
    removeCrew,
    handleUpdateCrew,
    clientPickup,
    quoteFuelPaisa,
    outgoingTransportPaisa,
    returnTransportPaisa,
    transportPaisa,
    transportDetails,
    handleUpdateTransport,
  }
}
