        match_state: 'Matched',
        matched_item_id: 'unit-uuid-1',
        matched_serial: 'SN-FX9-1002',
        match_source: 'Manual match',
      });

      expect(events![0]!.payload).toMatchObject({
        evidenceId: '11111111-1111-4111-8111-111111111111',
        action: 'review',
        matchState: 'Matched',
      });
