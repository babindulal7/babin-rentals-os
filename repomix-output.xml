    db.state.tables.set('booking_crew_lines_v', [
      {
        client_uuid: 'bbbbbbbb-0000-4000-8000-000000000002',
        name: 'Sita',
        crew_role: 'Grip',
        day_rate: 3000,
        days: 2,
        overtime: 0,
        accommodation: 0,
        meals: 0,
        voided_at: '2026-09-01T00:00:00.000Z',
      },
