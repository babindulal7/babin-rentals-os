  border: 1px solid var(--st-ready-border);
}

.movement-card__case-pill.is-prep {
  background: var(--st-warn-bg);
  color: var(--st-warn-fg);
  border: 1px solid var(--st-warn-border);
}

.movement-card__deposit-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: var(--t-th);
  font-weight: 600;
  padding: 2px 8px;
  border-radius: var(--r-sm, 6px);
  background: rgba(217, 168, 60, 0.12);
  color: var(--gold, var(--st-warn-fg));
  border: 1px solid rgba(217, 168, 60, 0.28);
  white-space: nowrap;
}

.movement-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.movement-card__time {
  font-size: var(--t-body);
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.01em;
  font-family: var(--font-id, 'Source Sans 3', sans-serif);
  font-variant-numeric: tabular-nums;
}

.movement-card__main {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.movement-card__title {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  font-size: var(--t-ui);
  flex-wrap: wrap;
}

.movement-card__number {
  display: inline-flex;
  align-items: center;
  padding: 2px 6px;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  border: 1px solid var(--border);
  color: var(--text2);
  font-size: var(--t-th);
  font-family: var(--font-id, 'Source Sans 3', sans-serif);
  font-variant-numeric: tabular-nums;
  font-weight: 500;
}

.movement-card__booking-link {
  display: inline-flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  min-height: 44px;
  max-width: 100%;
