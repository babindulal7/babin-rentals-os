  if (draftLoading || quoteLoading) {
    return (
      <div style={{ padding: 'var(--sp-xl)', maxWidth: 1000, margin: '40px auto' }}>
        <LoadingSkeleton type="card" label="Loading draft booking…" />
      </div>
