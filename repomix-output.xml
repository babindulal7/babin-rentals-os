                  }, minmax(0, 1fr))`,
                  gap: 'var(--sp-md)',
                }}
              >
                {group.cards.map((card) => (
                  <Link
                    key={card.tab}
                    to={card.to}
                    onClick={(e) => {
                      e.preventDefault()
                      setTab(card.tab)
                    }}
                    style={{
                      ...cardStyle,
                      display: 'flex',
                      alignItems: 'flex-start',
                      gap: 12,
                      minHeight: 88,
                      padding: 14,
                      textAlign: 'left',
                      fontFamily: 'inherit',
                      cursor: 'pointer',
                      border: '1px solid var(--border)',
                      background: 'var(--card)',
                      textDecoration: 'none',
