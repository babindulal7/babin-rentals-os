<file path="src/modules/today/dashboard.css">
/* ============================================================================
   DASHBOARD PAGE — movement board styling (UI Consistency Phase 1)

   This file must NEVER mutate the application-wide theme. It previously held
   root-scoped theme overrides that repainted global shell tokens (--app, --bg, --sidebar,
   --brand, --nav-active-*) whenever the Dashboard route was mounted — navigating to
   Today changed every other screen's chrome. Those blocks are gone: the
   palette has exactly one home (styles/theme.css), and this page only
   defines component-scoped aliases that READ the canonical tokens.

   Page-shell width/gap, header typography and button styling are owned by
   PageShell / PageHeader / Button — not by this file.
   ========================================================================== */

.rental-dashboard {
  --dashboard-accent: var(--primary);
  --dashboard-accent-strong: var(--primary-text);
  --dashboard-accent-soft: var(--ext-bg);
}

/* Center viewport on dispatch operations: Pickups and Returns columns side-by-side */
.rental-dashboard__panels {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: start;
  gap: 1.25rem;
  min-width: 0;
}

.movement-panel {
  position: relative;
  min-width: 0;
  overflow: visible;
  border: 1px solid var(--w10, var(--border));
  border-radius: var(--r-card, 14px);
  background: var(--surface-card, var(--card));
  box-shadow: var(--shadow-sm);
  transition: box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
}

.movement-panel__header {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 0.875rem;
  min-height: 5rem;
  padding: 1.15rem 1.25rem;
  border-bottom: 1px solid var(--w08, var(--border));
  background: var(--card);
  border-top-left-radius: var(--r-card, 14px);
  border-top-right-radius: var(--r-card, 14px);
}

.movement-panel__icon {
  display: grid;
  width: 2.75rem;
  height: 2.75rem;
  place-items: center;
  border-radius: var(--r-btn);
  background: var(--select-bg);
  color: var(--select-fg);
}

.movement-panel__heading {
  min-width: 0;
}

.movement-panel__heading h2 {
  margin: 0;
  color: var(--text);
  font-family: 'Outfit', var(--font-display);
  font-size: var(--t-h3);
  font-weight: 700;
  letter-spacing: -0.025em;
}

.movement-panel__heading p {
  margin: 0.25rem 0 0;
  overflow: hidden;
  color: var(--text2);
  font-size: var(--t-meta);
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.movement-panel__filter {
  position: relative;
  z-index: 4;
}

/* ─── Unified Master Dispatch Date Control ────────────────────────────────── */
.dashboard-master-date-control {
  position: relative;
  /* The calendar is portaled; its trigger stays below shell search overlays. */
  z-index: auto;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  padding: 2px;
  border: 1px solid var(--border);
  border-radius: var(--r-btn, 8px);
  background: var(--card2);
  box-shadow: var(--shadow-sm);
}

.dashboard-master-date-control__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  border: 0;
  border-radius: calc(var(--r-btn, 8px) - 2px);
  background: transparent;
  color: var(--text2);
  cursor: pointer;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}

.dashboard-master-date-control__btn:hover {
  background: var(--hover-card);
  color: var(--text);
}

.dashboard-master-date-control__btn:active {
  filter: brightness(0.96);
}

.dashboard-master-date-control__date-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  /* Wide enough for "Wednesday" / "Tomorrow" + the AD·BS line, so the › arrow does not move as the
     day changes. */
  min-width: 12.5rem;
  min-height: 44px;
  padding: 0.25rem 0.75rem;
  border: 0;
  border-radius: calc(var(--r-btn, 8px) - 2px);
  background: transparent;
  color: var(--text);
  cursor: pointer;
  text-align: left;
  white-space: nowrap;
  transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}

.dashboard-master-date-control__date-btn:hover {
  background: var(--hover-card);
}

.dashboard-master-date-control__date-btn[aria-expanded='true'] {
  background: var(--dashboard-accent-soft);
}

.dashboard-master-date-control__text {
  display: grid;
  line-height: 1.15;
  min-width: 0;
}

.dashboard-master-date-control__primary {
  font-size: var(--t-ui);
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--text);
}

.dashboard-master-date-control__date-btn.is-today .dashboard-master-date-control__primary {
  color: var(--dashboard-accent-strong);
}

.dashboard-master-date-control__secondary {
  font-size: var(--t-meta);
  font-weight: 500;
  color: var(--text2);
  font-variant-numeric: tabular-nums;
}

.dashboard-date-filter {
  position: relative;
}

.dashboard-date-filter__button {
  display: grid;
  grid-template-columns: 2.65rem minmax(4.8rem, auto) auto;
  align-items: center;
  min-height: 2.75rem;
  padding: 0 0.85rem 0 0;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: var(--r-btn);
  background: var(--card2);
  color: var(--text);
  box-shadow: var(--shadow-sm), var(--specular-rim);
  font: 600 var(--t-meta)/1 var(--font-body);
  cursor: pointer;
  transition: border-color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}

.dashboard-date-filter__button:hover,
.dashboard-date-filter__button[aria-expanded='true'] {
  border-color: var(--dashboard-accent);
  background: var(--card);
  box-shadow: var(--shadow-card), var(--specular-rim);
}

.dashboard-date-filter__button:active {
  filter: brightness(0.98);
}

.dashboard-date-filter__button:focus-visible,
.dashboard-calendar button:focus-visible,
.movement-panel__row:focus-visible,
.movement-panel__action:focus-visible,
.movement-panel__number:focus-visible {
  outline: 2px solid var(--dashboard-accent);
  outline-offset: 2px;
}

.dashboard-date-filter__calendar {
  display: grid;
  min-height: 2.75rem;
  place-items: center;
  border-right: 1px solid var(--border);
  color: var(--dashboard-accent-strong);
}

.dashboard-date-filter__label {
  padding-inline: 0.75rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dashboard-calendar {
  position: absolute;
  top: calc(100% + 0.65rem);
  right: 0;
  z-index: 50;
  width: min(360px, calc(100vw - 24px));
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--card);
  color: var(--text);
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.08);
  animation: dashboard-calendar-in 160ms ease-out;
}

@keyframes dashboard-calendar-in {
  from {
    opacity: 0;
    transform: translateY(-0.4rem);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.dashboard-calendar__heading {
  display: flex;
  align-items: start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
}

.dashboard-calendar__heading strong {
  display: block;
  font-size: var(--t-ui);
  font-weight: 700;
  letter-spacing: -0.01em;
}

.dashboard-calendar__heading span {
  display: block;
  margin-top: 2px;
  color: var(--text2);
  font-size: var(--t-th);
}

.dashboard-calendar__heading button {
  display: grid;
  flex: 0 0 44px;
  width: 44px;
  height: 44px;
  margin: -8px -10px 0 0;
  place-items: center;
  border: 0;
  border-radius: var(--r-xs);
  background: transparent;
  color: var(--text2);
  cursor: pointer;
}

.dashboard-calendar__heading button:hover {
  background: var(--card2);
  color: var(--text);
}

.dashboard-calendar__quick {
  display: grid;
  grid-template-columns: 0.9fr 1.2fr 1.35fr;
  gap: 6px;
  margin-bottom: 12px;
}

.dashboard-calendar__quick button {
  min-height: 44px;
  padding: 0 7px;
  border: 1px solid var(--border);
  border-radius: var(--r-sm, 8px);
  background: var(--card);
  color: var(--text2);
  font: 600 var(--t-th)/1.1 var(--font-body);
  cursor: pointer;
}

.dashboard-calendar__quick button:hover,
.dashboard-calendar__mode button:hover {
  border-color: var(--primary);
  color: var(--primary);
}

.dashboard-calendar__quick button[aria-pressed='true'] {
  border-color: var(--primary);
  background: var(--primary);
  color: var(--btn-primary-fg, #fff);
}

.dashboard-calendar__mode {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 4px;
  margin-bottom: 14px;
  padding: 4px;
  border: 1px solid var(--border);
  border-radius: var(--r-sm, 8px);
  background: var(--card2);
}

.dashboard-calendar__mode button {
  min-height: 36px;
  border: 1px solid transparent;
  border-radius: calc(var(--r-sm, 8px) - 2px);
  background: transparent;
  color: var(--text2);
  font: 700 var(--t-th)/1 var(--font-body);
  cursor: pointer;
}

.dashboard-calendar__mode button[aria-pressed='true'] {
  border-color: var(--border);
  background: var(--card);
  color: var(--text);
  box-shadow: var(--shadow-sm);
}

.movement-panel__table {
  min-width: 0;
  overflow: hidden;
  border-radius: 0 0 0.625rem 0.625rem;
}

.movement-panel__table-head,
.movement-panel__row {
  display: grid;
  grid-template-columns: minmax(4.5rem, 0.85fr) minmax(7rem, 1.45fr) minmax(6.4rem, 1.1fr) minmax(3.35rem, 0.55fr) minmax(5.5rem, 0.9fr) minmax(5.6rem, 0.95fr);
  align-items: center;
