                              {isResolved ? 'Reopen' : 'Done'}
                            </button>
                            <button
                              type="button"
                              aria-label={n.pinned ? 'Unpin note' : 'Pin note'}
                              onClick={() => handleTogglePin(n.id)}
                              title={n.pinned ? 'Unpin' : 'Pin'}
                              style={{
                                minWidth: 44,
                                minHeight: 44,
                                padding: '4px 6px',
                                border: 'none',
                                background: 'transparent',
                                color: n.pinned ? 'var(--accent)' : 'var(--muted)',
                                cursor: 'pointer',
                                display: 'inline-flex',
                                alignItems: 'center',
                                justifyContent: 'center',
