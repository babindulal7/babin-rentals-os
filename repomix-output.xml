<file path="src/modules/rentals/booking/useNewRentalCatalogue.ts">
import { useEffect, useMemo, useState } from 'react'
import { listClientRecords, type ClientRecord } from '../../../lib/queries/clients'
import { listInventory } from '../../../lib/queries/inventory'
import { readProductAvailability } from '../../../lib/queries/productAvailability'
import { listBundleRecords } from '../../../lib/queries/bundleRecords'
import { bundleCapacityView } from '../../../lib/bundleCapacityView'
import type { BundleRecord } from '../../../data/bundles'
import type { RentalWindow } from '../../../lib/availability'
import { listCrewMembers, type CrewMember } from '../../../lib/queries/crew'
import {
  bundleResults,
  equipmentResultsFrom,
  type BookingWindow,
  type BundleResult,
  type EquipmentAvailabilitySource,
  type EquipmentResult,
  type LiveEquipmentRow,
} from './itemCatalogue'

export interface UseNewRentalCatalogueOptions {
  canBookingMoney: boolean
  pickupAt: Date | null
  returnAt: Date | null
  bookingWindow: BookingWindow
}

export interface UseNewRentalCatalogueResult {
  clientPool: ClientRecord[]
  setClientPool: React.Dispatch<React.SetStateAction<ClientRecord[]>>
  clientsAreLive: boolean
  liveRows: readonly LiveEquipmentRow[] | null
  liveCrew: readonly CrewMember[] | null
  liveBundles: readonly BundleRecord[] | null
  poolSettled: boolean
  poolError: string | null
  availabilitySource: EquipmentAvailabilitySource
  liveEquipment: readonly EquipmentResult[] | null
  liveBundleResults: readonly BundleResult[]
}

/**
 * Encapsulates the live database reads and windowed availability queries
 * for New Rental's clients, equipment inventory, crew roster, and bundles.
 */
export function useNewRentalCatalogue({
  canBookingMoney,
  pickupAt,
  returnAt,
  bookingWindow,
}: UseNewRentalCatalogueOptions): UseNewRentalCatalogueResult {
  const [clientPool, setClientPool] = useState<ClientRecord[]>([])
  const [clientsAreLive, setClientsAreLive] = useState(false)
  const [liveRows, setLiveRows] = useState<readonly LiveEquipmentRow[] | null>(null)
  const [liveCrew, setLiveCrew] = useState<readonly CrewMember[] | null>(null)
  const [liveBundles, setLiveBundles] = useState<readonly BundleRecord[] | null>(null)
  const [poolSettled, setPoolSettled] = useState(false)
  const [poolError, setPoolError] = useState<string | null>(null)

  useEffect(() => {
    let cancelled = false
    void (async () => {
      try {
        const [clients, inventory, crewResult] = await Promise.all([
          listClientRecords(),
          listInventory({ page: { index: 0, size: 500 }, withMoney: canBookingMoney }),
          listCrewMembers(),
        ])
        if (cancelled) return
        const bookableClients = clients.filter((c) => !!c.dbId)
        setClientPool(bookableClients)
        setClientsAreLive(true)
        const rows = inventory.rows.filter((r) => r.isActive)
        if (rows.length > 0) setLiveRows(rows)

        if (crewResult && crewResult.rows && crewResult.rows.length > 0) {
          setLiveCrew(crewResult.rows)
        }
      } catch (e: unknown) {
        if (!cancelled) setPoolError(e instanceof Error ? e.message : String(e))
      } finally {
        if (!cancelled) setPoolSettled(true)
      }
    })()
    return () => {
      cancelled = true
    }
  }, [canBookingMoney])

  const [availabilitySource, setAvailabilitySource] = useState<EquipmentAvailabilitySource>({
    state: 'checking',
  })

  useEffect(() => {
    if (!pickupAt || !returnAt || returnAt.getTime() <= pickupAt.getTime()) {
      setAvailabilitySource({ state: 'no-window' })
      return
    }
    if (poolError !== null) {
      setAvailabilitySource({ state: 'failed', reason: poolError })
      return
    }
    if (liveRows === null) {
      setAvailabilitySource(poolSettled ? { state: 'ready', byProduct: new Map() } : { state: 'checking' })
      return
    }

    let cancelled = false
    setAvailabilitySource({ state: 'checking' })
    const window: RentalWindow = { fromAd: pickupAt.toISOString(), toAd: returnAt.toISOString() }
    void (async () => {
      try {
        const [byProduct, bundles] = await Promise.all([
          readProductAvailability(window, liveRows.map((r) => r.id)),
          listBundleRecords(window, { withMoney: canBookingMoney }),
        ])
        if (!cancelled) {
          setAvailabilitySource({ state: 'ready', byProduct })
          if (bundles && bundles.length > 0) {
            /* G4: kit capacity from the same windowed answers the catalogue rows use. A component with no
               answer (or a serialised product with no unit rows) yields no capacity at all — never a guess. */
            const freeOf = (id: string): number | undefined => {
              const a = byProduct.get(id)
              if (!a || (a.mode === 'unit' && a.unitsOwned === 0)) return undefined
              return a.unitsFree
            }
            setLiveBundles(bundles.map((b) => ({ ...b, kitCapacity: bundleCapacityView(b.lines, freeOf) })))
          }
        }
      } catch (e: unknown) {
        if (!cancelled) {
          setAvailabilitySource({ state: 'failed', reason: e instanceof Error ? e.message : String(e) })
        }
      }
    })()
    return () => {
      cancelled = true
    }
  }, [liveRows, pickupAt, returnAt, poolError, poolSettled, canBookingMoney])

  const liveEquipment = useMemo(
    () => (liveRows === null ? null : equipmentResultsFrom(liveRows, availabilitySource)),
    [liveRows, availabilitySource],
  )

  const liveBundleResults = useMemo(
    () => bundleResults(bookingWindow, liveBundles ?? undefined),
    [bookingWindow, liveBundles],
  )

  return {
    clientPool,
    setClientPool,
    clientsAreLive,
    liveRows,
    liveCrew,
    liveBundles,
    poolSettled,
    poolError,
    availabilitySource,
    liveEquipment,
    liveBundleResults,
  }
}
</file>

<file path="src/modules/rentals/booking/useNewRentalClient.ts">
import {
  useCallback,
  useEffect,
  useMemo,
  useRef,
  useState,
  type Dispatch,
  type MutableRefObject,
  type RefObject,
  type SetStateAction,
} from 'react'
import type { ClientRecord } from '../../../lib/queries/clients'
import { clientHealth, type ClientHealthVerdict } from './clientHealth'

export interface UseNewRentalClientOptions {
  searchParams: URLSearchParams
  clientPool: ClientRecord[]
  setClientPool: Dispatch<SetStateAction<ClientRecord[]>>
  setGovId: Dispatch<SetStateAction<string>>
  showSuccessToast: (title: string, desc?: string) => void
}

export interface UseNewRentalClientResult {
  selectedClientId: string | null
  setSelectedClientId: Dispatch<SetStateAction<string | null>>
  client: ClientRecord | undefined
  quickViewOpen: boolean
  setQuickViewOpen: Dispatch<SetStateAction<boolean>>
  historyOpen: boolean
  setHistoryOpen: Dispatch<SetStateAction<boolean>>
  addClientOpen: boolean
  setAddClientOpen: Dispatch<SetStateAction<boolean>>
  clientFieldRef: RefObject<HTMLDivElement | null>
  clientFieldTouched: boolean
  setClientFieldTouched: Dispatch<SetStateAction<boolean>>
  suppressClientListOnFocus: MutableRefObject<boolean>
  focusClientInput: () => void
  openAddClient: () => void
  closeAddClient: () => void
  selectClient: (c: ClientRecord) => void
  onClientCreated: (created: ClientRecord) => void
  health: ClientHealthVerdict | null
}

/**
 * Encapsulates client pool selection, URL synchronization,
 * health signal computation, focus suppression, and client drawer/modal disclosures.
 */
export function useNewRentalClient({
  searchParams,
  clientPool,
  setClientPool,
  setGovId,
  showSuccessToast,
}: UseNewRentalClientOptions): UseNewRentalClientResult {
  const [selectedClientId, setSelectedClientId] = useState<string | null>(
    () => searchParams.get('clientId') || searchParams.get('client') || null,
  )

  const client: ClientRecord | undefined = useMemo(
    () => clientPool.find((c) => c.id === selectedClientId || (c.dbId && c.dbId === selectedClientId)),
    [clientPool, selectedClientId],
  )

  /* Connect URL client parameter to selection as soon as client pool loads */
  useEffect(() => {
    const rawParam = searchParams.get('clientId') || searchParams.get('client')
    if (!rawParam) return
    const match = clientPool.find((c) => c.id === rawParam || (c.dbId && c.dbId === rawParam))
    if (match) {
      if (selectedClientId !== match.id) {
        setSelectedClientId(match.id)
      }
      if (match.pan) {
        setGovId(match.pan)
      }
    }
  }, [clientPool, searchParams, selectedClientId, setGovId])

  // Disclosures over the workspace: quick view, history, add client
  const [quickViewOpen, setQuickViewOpen] = useState(false)
  const [historyOpen, setHistoryOpen] = useState(false)
  const [addClientOpen, setAddClientOpen] = useState(false)

  const clientFieldRef = useRef<HTMLDivElement | null>(null)
  const [clientFieldTouched, setClientFieldTouched] = useState(false)
  const suppressClientListOnFocus = useRef(false)

  const focusClientInput = useCallback(() => {
    suppressClientListOnFocus.current = true
    const input = clientFieldRef.current?.querySelector<HTMLInputElement>('input[role="combobox"]')
    if (input) input.focus()
    else suppressClientListOnFocus.current = false
  }, [])

  const openAddClient = useCallback(() => {
    focusClientInput()
    setAddClientOpen(true)
  }, [focusClientInput])

  const closeAddClient = useCallback(() => {
    suppressClientListOnFocus.current = true
    setAddClientOpen(false)
  }, [])

  const selectClient = useCallback(
    (c: ClientRecord) => {
      setSelectedClientId(c.id)
      setGovId(c.pan ?? '')
    },
    [setGovId],
  )

  const onClientCreated = useCallback(
    (created: ClientRecord) => {
      setClientPool((prev) => (prev.some((c) => c.id === created.id) ? prev : [created, ...prev]))
      setSelectedClientId(created.id)
      setGovId(created.pan ?? '')
      showSuccessToast('Client added', `${created.name} is selected on this booking.`)
    },
    [setClientPool, setGovId, showSuccessToast],
  )

  const health = useMemo(() => (client ? clientHealth(client) : null), [client])

  return {
    selectedClientId,
    setSelectedClientId,
    client,
    quickViewOpen,
    setQuickViewOpen,
    historyOpen,
    setHistoryOpen,
    addClientOpen,
    setAddClientOpen,
    clientFieldRef,
    clientFieldTouched,
    setClientFieldTouched,
    suppressClientListOnFocus,
    focusClientInput,
    openAddClient,
    closeAddClient,
    selectClient,
    onClientCreated,
    health,
  }
}
</file>

<file path="src/modules/rentals/booking/useNewRentalLogistics.ts">
import {
  useCallback,
  useMemo,
  useState,
  type Dispatch,
  type SetStateAction,
} from 'react'
import { rupees, type Paisa } from '../../../lib/money'
import { crewPool, type CrewMember } from '../../../lib/queries/crew'
import type { QuoteSnapshot } from '../../../lib/queries/quoteEditor'
import type { CrewLine } from './CrewSection'
import type { TransportDetails } from './CrewAndTransportSection'

export interface UseNewRentalLogisticsOptions {
  liveCrew?: readonly CrewMember[] | null
  quoteSnapshot?: QuoteSnapshot | null
}

export interface UseNewRentalLogisticsResult {
  // Delivery & Return
  deliveryType: 'Client Pickup' | 'Babin Delivery'
  setDeliveryType: Dispatch<SetStateAction<'Client Pickup' | 'Babin Delivery'>>
  deliveryChargePaisa: Paisa
  setDeliveryChargePaisa: Dispatch<SetStateAction<Paisa>>
  fuelChargePaisa: Paisa
  setFuelChargePaisa: Dispatch<SetStateAction<Paisa>>
  vehicle: string
  setVehicle: Dispatch<SetStateAction<string>>
  numberPlate: string
  setNumberPlate: Dispatch<SetStateAction<string>>
  driverContact: string
  setDriverContact: Dispatch<SetStateAction<string>>
  pickupLocation: string
  setPickupLocation: Dispatch<SetStateAction<string>>
  returnLocation: string
  setReturnLocation: Dispatch<SetStateAction<string>>
  specialInstructions: string
  setSpecialInstructions: Dispatch<SetStateAction<string>>
  returnPickupType: 'Client Return' | 'Babin Pickup'
  setReturnPickupType: Dispatch<SetStateAction<'Client Return' | 'Babin Pickup'>>
  returnPickupAddress: string
  setReturnPickupAddress: Dispatch<SetStateAction<string>>
  returnPickupTime: string
  setReturnPickupTime: Dispatch<SetStateAction<string>>
  returnPickupChargePaisa: number
  setReturnPickupChargePaisa: Dispatch<SetStateAction<number>>

  // Crew state & handlers
  crew: CrewLine[]
  setCrew: Dispatch<SetStateAction<CrewLine[]>>
  seedCrewLine: (m: CrewMember) => CrewLine
  addCrew: (crewId: string) => void
  removeCrew: (crewId: string) => void
  handleUpdateCrew: (crewId: string, updates: Partial<CrewLine>) => void

  // Transport calculations & consolidated updater
  clientPickup: boolean
  quoteFuelPaisa: Paisa
  outgoingTransportPaisa: number
  returnTransportPaisa: number
  transportPaisa: Paisa
  transportDetails: TransportDetails
  handleUpdateTransport: (updates: Partial<TransportDetails>) => void
}

/**
 * Encapsulates logistics state: crew roster assignments, delivery transport details,
 * return-pickup coordination, and vehicle/driver recording.
 */
export function useNewRentalLogistics({
  liveCrew,
  quoteSnapshot,
}: UseNewRentalLogisticsOptions): UseNewRentalLogisticsResult {
  // Delivery & Outgoing Transport
  const [deliveryType, setDeliveryType] = useState<'Client Pickup' | 'Babin Delivery'>('Client Pickup')
  const [deliveryChargePaisa, setDeliveryChargePaisa] = useState<Paisa>(rupees(0) as Paisa)
  const [fuelChargePaisa, setFuelChargePaisa] = useState<Paisa>(rupees(0) as Paisa)
  const [vehicle, setVehicle] = useState('')
  const [numberPlate, setNumberPlate] = useState('')
  const [driverContact, setDriverContact] = useState('')
  const [pickupLocation, setPickupLocation] = useState('')
  const [returnLocation, setReturnLocation] = useState('')
  const [specialInstructions, setSpecialInstructions] = useState('')

  // Return Pickup Logistics (§3.3)
  const [returnPickupType, setReturnPickupType] = useState<'Client Return' | 'Babin Pickup'>('Client Return')
  const [returnPickupAddress, setReturnPickupAddress] = useState('')
  const [returnPickupTime, setReturnPickupTime] = useState('18:00')
  const [returnPickupChargePaisa, setReturnPickupChargePaisa] = useState<number>(0)

  // Crew state
  const [crew, setCrew] = useState<CrewLine[]>(() => [])

  const seedCrewLine = useCallback(
    (m: CrewMember): CrewLine => ({
      crewId: m.id,
      name: m.name,
      role: m.role,
      phone: m.phone,
      dayRatePaisa: m.dayRatePaisa,
      overtimePaisa: rupees(0) as Paisa,
      accommodationPaisa: rupees(0) as Paisa,
      mealsPaisa: rupees(0) as Paisa,
    }),
    [],
  )

  const addCrew = useCallback(
    (crewId: string) => {
      const rosterPool = crewPool(liveCrew)
      const m = rosterPool.find((x) => x.id === crewId)
      if (!m || crew.some((c) => c.crewId === crewId)) return
      setCrew((p) => [...p, seedCrewLine(m)])
    },
    [liveCrew, crew, seedCrewLine],
  )

  const removeCrew = useCallback((crewId: string) => {
    setCrew((p) => p.filter((c) => c.crewId !== crewId))
  }, [])

  const handleUpdateCrew = useCallback((crewId: string, updates: Partial<CrewLine>) => {
    setCrew((p) => p.map((c) => (c.crewId === crewId ? { ...c, ...updates } : c)))
  }, [])

  // §9.2 — Client Pickup forces both transport charges to zero.
  const clientPickup = deliveryType === 'Client Pickup'
  const quoteFuelPaisa =
    clientPickup && quoteSnapshot?.values.delivery_type !== 'Client Pickup'
      ? (0 as Paisa)
      : fuelChargePaisa
  const outgoingTransportPaisa = (clientPickup ? 0 : deliveryChargePaisa) + quoteFuelPaisa
  const returnTransportPaisa = returnPickupType === 'Client Return' ? 0 : returnPickupChargePaisa
  const transportPaisa = (outgoingTransportPaisa + returnTransportPaisa) as Paisa

  const transportDetails = useMemo<TransportDetails>(
    () => ({
      clientPickup,
      deliveryType,
      vehicle,
      numberPlate,
      driverContact,
      pickupLocation,
      returnLocation,
      specialInstructions,
      returnPickupType,
      returnPickupAddress,
      returnPickupTime,
      returnPickupChargePaisa,
      deliveryChargePaisa,
      fuelChargePaisa,
      transportPaisa,
    }),
    [
      clientPickup,
      deliveryType,
      vehicle,
      numberPlate,
      driverContact,
      pickupLocation,
      returnLocation,
      specialInstructions,
      returnPickupType,
      returnPickupAddress,
      returnPickupTime,
      returnPickupChargePaisa,
      deliveryChargePaisa,
      fuelChargePaisa,
      transportPaisa,
    ],
  )

  const handleUpdateTransport = useCallback((updates: Partial<TransportDetails>) => {
    if (updates.deliveryType !== undefined) {
      setDeliveryType(updates.deliveryType)
    } else if (updates.clientPickup !== undefined) {
      setDeliveryType(updates.clientPickup ? 'Client Pickup' : 'Babin Delivery')
    }
    if (updates.vehicle !== undefined) setVehicle(updates.vehicle)
    if (updates.numberPlate !== undefined) setNumberPlate(updates.numberPlate)
    if (updates.driverContact !== undefined) setDriverContact(updates.driverContact)
    if (updates.pickupLocation !== undefined) setPickupLocation(updates.pickupLocation)
    if (updates.returnLocation !== undefined) setReturnLocation(updates.returnLocation)
    if (updates.specialInstructions !== undefined) setSpecialInstructions(updates.specialInstructions)
    if (updates.returnPickupType !== undefined) setReturnPickupType(updates.returnPickupType)
    if (updates.returnPickupAddress !== undefined) setReturnPickupAddress(updates.returnPickupAddress)
    if (updates.returnPickupTime !== undefined) setReturnPickupTime(updates.returnPickupTime)
    if (updates.returnPickupChargePaisa !== undefined) setReturnPickupChargePaisa(updates.returnPickupChargePaisa)
    if (updates.deliveryChargePaisa !== undefined) setDeliveryChargePaisa(updates.deliveryChargePaisa)
    if (updates.fuelChargePaisa !== undefined) setFuelChargePaisa(updates.fuelChargePaisa)
  }, [])

  return {
    deliveryType,
    setDeliveryType,
    deliveryChargePaisa,
    setDeliveryChargePaisa,
    fuelChargePaisa,
    setFuelChargePaisa,
    vehicle,
    setVehicle,
    numberPlate,
    setNumberPlate,
    driverContact,
    setDriverContact,
    pickupLocation,
    setPickupLocation,
    returnLocation,
    setReturnLocation,
    specialInstructions,
    setSpecialInstructions,
    returnPickupType,
    setReturnPickupType,
    returnPickupAddress,
    setReturnPickupAddress,
    returnPickupTime,
    setReturnPickupTime,
    returnPickupChargePaisa,
    setReturnPickupChargePaisa,
    crew,
    setCrew,
    seedCrewLine,
    addCrew,
    removeCrew,
    handleUpdateCrew,
    clientPickup,
    quoteFuelPaisa,
    outgoingTransportPaisa,
    returnTransportPaisa,
    transportPaisa,
    transportDetails,
    handleUpdateTransport,
  }
}
</file>

<file path="src/modules/rentals/booking/useNewRentalNavigation.ts">
import {
  useCallback,
  useEffect,
  type Dispatch,
  type SetStateAction,
} from 'react'
import type { ClientRecord } from '../../../lib/queries/clients'

export interface UseNewRentalNavigationOptions {
  client: ClientRecord | undefined
  navigate: (to: string) => void
  setQuickViewOpen: Dispatch<SetStateAction<boolean>>
  setOpen: Dispatch<SetStateAction<boolean[]>>
  sections: readonly string[]
  editBookingId?: string | undefined
  saveDraft: () => Promise<void> | void
  saveQuote: () => Promise<void> | void
  confirmBooking: () => Promise<void> | void
  confirmBlocked: boolean
  saveState: string
  onValidationAttempt?: (() => void) | undefined
  firstBlockingAction?: string | undefined
}

export interface UseNewRentalNavigationResult {
  jumpToSection: (targetId: string, focusSelector?: string) => void
  runNoticeAction: (action: string) => void
}

/**
 * Encapsulates power-user keyboard shortcuts (⌘S, ⌘Enter, Alt+1..4)
 * and deep-linking section jumps / notice actions.
 */
export function useNewRentalNavigation({
  client,
  navigate,
  setQuickViewOpen,
  setOpen,
  sections,
  editBookingId,
  saveDraft,
  saveQuote,
  confirmBooking,
  confirmBlocked,
  saveState,
  onValidationAttempt,
  firstBlockingAction,
}: UseNewRentalNavigationOptions): UseNewRentalNavigationResult {
  /** Redesign v1 §6 — Review card / alert notice jumps to the section that owns the fact. */
  const jumpToSection = useCallback(
    (targetId: string, focusSelector?: string) => {
      const sectionIndex = sections.findIndex((_, i) => `section-${i}` === targetId)
      if (sectionIndex >= 0) {
        setOpen((prev) => prev.map((v, j) => (j === sectionIndex ? true : v)))
      }
      globalThis.requestAnimationFrame(() => {
        const section = document.getElementById(targetId)
        section?.scrollIntoView({
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'start',
        })
        // Focus the actual field, never the invisible native Select bridge.
        const fieldSelectors = focusSelector
          ? [focusSelector]
          : ['input:not([disabled]), textarea:not([disabled]), button[role="combobox"]:not([disabled])', 'button:not([disabled])']
        const field = fieldSelectors.flatMap((selector) => Array.from(section?.querySelectorAll<HTMLElement>(selector) ?? []))
          .find((el) => !el.closest('[hidden]') && el.getAttribute('aria-hidden') !== 'true' && el.tabIndex >= 0)
        field?.focus({ preventScroll: true })
      })
    },
    [sections, setOpen],
  )

  /**
   * §12 — every notice carries exactly one action, and both the blocking-notices
   * card and the warnings card dispatch through here.
   */
  const runNoticeAction = useCallback(
    (action: string) => {
      if (action === 'Open Inventory') navigate('/inventory')
      if ((action === 'View Client' || action === 'Edit Client') && client) setQuickViewOpen(true)
      if (action === 'Select Client') jumpToSection('section-0')
      if (action === 'Open Client & Dates') jumpToSection('section-0', 'button[role="combobox"][aria-label="Project type"]')
      if (action === 'Open Dates') jumpToSection('section-1')
      if (action === 'Open Equipment') jumpToSection('section-2')
      if (action === 'Open Crew') jumpToSection('section-3')
      if (action === 'Open Pricing') jumpToSection('section-5')
      if (action === 'Fix Discount') {
        jumpToSection('section-5', 'input[type="number"]')
      }
      if (action === 'Receive Payment' || action === 'Receive Deposit') {
        document.getElementById('rail-booking-summary')?.scrollIntoView({ behavior: 'smooth', block: 'center' })
      }
    },
    [client, jumpToSection, navigate, setQuickViewOpen],
  )

  // Power-user keyboard shortcuts: save, confirm, and direct section access.
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      // ⌘S or Ctrl+S: Save Draft
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 's') {
        e.preventDefault()
        if (saveState === 'saving') return
        if (editBookingId) void saveQuote()
        else void saveDraft()
        return
      }

      // ⌘Enter or Ctrl+Enter: Confirm Booking
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault()
        if (saveState === 'saving') return
        if (editBookingId) { void saveQuote(); return }
        onValidationAttempt?.()
        if (!confirmBlocked) void confirmBooking()
        else if (firstBlockingAction) runNoticeAction(firstBlockingAction)
        else jumpToSection('rail-booking-summary')
        return
      }

      // Alt+1 to Alt+4: Jump to the corresponding section or summary.
      if (e.altKey && !e.ctrlKey && !e.metaKey && e.key >= '1' && e.key <= '4') {
        e.preventDefault()
        const target = ({
          '1': 'section-0',
          '2': 'section-2',
          '3': 'section-5',
          '4': 'rail-booking-summary',
        } as Record<string, string>)[e.key]
        if (target === 'section-5') {
          setOpen((prev) => prev.map((value, index) => index === 5 || value))
        }
        document.getElementById(target ?? '')?.scrollIntoView({ block: 'start', behavior: 'smooth' })
      }
    }

    window.addEventListener('keydown', handleKeyDown)
    return () => window.removeEventListener('keydown', handleKeyDown)
  }, [confirmBlocked, saveState, saveDraft, confirmBooking, editBookingId, saveQuote, setOpen, onValidationAttempt, firstBlockingAction, runNoticeAction, jumpToSection])

  return {
    jumpToSection,
    runNoticeAction,
  }
}
</file>

<file path="src/modules/rentals/booking/useNewRentalPricing.ts">
import { useMemo } from 'react'
import {
  calculatePricingPipeline,
  type PricingPipelineResult,
  type PromoCodeDefinition,
} from '../../../lib/pricingPipeline'
import { rupees, type Paisa } from '../../../lib/money'
import { rentalDaysBetween } from '../../../lib/rentalDays'
import {
  productDepositPaisa,
  recommendedDepositWithProducts,
  type ProductDepositTerms,
} from '../../../lib/productDeposit'
import { lineAmountPaisa, type Line } from './RentalLineItemsTree'
import type { CrewLine } from './CrewSection'

export interface UseNewRentalPricingOptions {
  lines: Line[]
  crew: CrewLine[]
  days: number
  pickup: string
  ret: string
  pickupAt: Date | null
  clientPickup: boolean
  deliveryChargePaisa: Paisa
  quoteFuelPaisa: Paisa
  returnTransportPaisa: number
  discountPct: number
  manualDiscountReason: string
  manualDiscountAuthorizedBy: string
  womenDopEligible: boolean
  promoCodeApplied: PromoCodeDefinition | null
  vatOn: boolean
  vatRatePercent: number
  savedDepositPaisa: Paisa | null
  /** C6 — deposit terms of the products on the booking; empty/omitted leaves the flat rule alone. */
  productDepositTerms?: ReadonlyMap<string, ProductDepositTerms> | undefined
  manualDepositOverride: boolean
  manualDepositAmount: string
  depositOverrideReason: string
  depositAuthorizedBy: string
}

export interface PricingBreakdown {
  equipment: Paisa
  crew: Paisa
  transport: Paisa
  subtotal: Paisa
  discount: Paisa
  taxable: Paisa
  vat: Paisa
  rentalTotal: Paisa
  outstanding: Paisa
}

export interface UseNewRentalPricingResult {
  standaloneEquipmentLines: Line[]
  equipmentLines: Line[]
  bundleLines: Line[]
  subRentalLines: Line[]
  equipmentPaisa: Paisa
  bundlePaisa: Paisa
  subRentalPaisa: Paisa
  servicePaisa: Paisa
  crewChargesPaisa: Paisa
  isStudentBundle: boolean
  recommendedDepositPaisa: Paisa
  manualDepositPaisa: Paisa | null
  pricing: PricingPipelineResult
  breakdown: PricingBreakdown
  depositRequiredPaisa: Paisa
  depositReceivedPaisa: Paisa
  depositPendingPaisa: Paisa
  pricingHints: Record<number, Paisa>
}

/**
 * Pure calculation hook for the New Rental pricing pipeline (Law 1 engine authority).
 * Encapsulates equipment line grouping, gear totals, crew charges, transport additions,
 * deposit liability calculation (Law 5), promo/discounts, and duration pricing hints.
 */
export function useNewRentalPricing({
  lines,
  crew,
  days,
  pickup,
  ret,
  pickupAt,
  clientPickup,
  deliveryChargePaisa,
  quoteFuelPaisa,
  returnTransportPaisa,
  discountPct,
  manualDiscountReason,
  manualDiscountAuthorizedBy,
  womenDopEligible,
  promoCodeApplied,
  vatOn,
  vatRatePercent,
  savedDepositPaisa,
  productDepositTerms,
  manualDepositOverride,
  manualDepositAmount,
  depositOverrideReason,
  depositAuthorizedBy,
}: UseNewRentalPricingOptions): UseNewRentalPricingResult {
  const standaloneEquipmentLines = useMemo(
    () => lines.filter((l) => (l.lineType === undefined || l.lineType === 'Equipment') && !l.isIncluded),
    [lines],
  )
  const equipmentLines = standaloneEquipmentLines

  const bundleLines = useMemo(
    () => lines.filter((l) => l.lineType === 'Bundle'),
    [lines],
  )

  const equipmentPaisa = useMemo(
    () => standaloneEquipmentLines.reduce((s, l) => s + lineAmountPaisa(l), 0) as Paisa,
    [standaloneEquipmentLines],
  )
  const bundlePaisa = useMemo(
    () => bundleLines.reduce((s, l) => s + lineAmountPaisa(l), 0) as Paisa,
    [bundleLines],
  )
  const subRentalLines = useMemo(
    () => lines.filter((l) => l.lineType === 'Sub-rental'),
    [lines],
  )
  const subRentalPaisa = useMemo(
    () => subRentalLines.reduce((s, l) => s + lineAmountPaisa(l), 0) as Paisa,
    [subRentalLines],
  )
  const servicePaisa = useMemo(
    () =>
      lines
        .filter((l) => l.lineType === 'Service' || l.lineType === 'Manual item')
        .reduce((s, l) => s + lineAmountPaisa(l), 0) as Paisa,
    [lines],
  )
  const crewChargesPaisa = useMemo(
    () =>
      crew.reduce(
        (s, c) =>
          s +
          c.dayRatePaisa * (c.days ?? days) +
          c.overtimePaisa +
          c.accommodationPaisa +
          c.mealsPaisa,
        0,
      ) as Paisa,
    [crew, days],
  )

  const isStudentBundle = useMemo(
    () =>
      lines.some(
        (l) =>
          l.bundleName?.toLowerCase().includes('student') ||
          l.category?.toLowerCase().includes('student') ||
          l.category?.toLowerCase().includes('college'),
      ),
    [lines],
  )

  const recommendedDepositPaisa = useMemo<Paisa>(() => {
    const totalGear = equipmentPaisa + bundlePaisa + subRentalPaisa
    if (totalGear <= 0) return 0 as Paisa
    const flatRule = Math.max(500000, Math.round(totalGear)) as Paisa
    /* C6 — raised, never lowered, by what the products themselves ask. */
    const fromProducts = productDepositTerms ? productDepositPaisa(lines, productDepositTerms) : (0 as Paisa)
    return recommendedDepositWithProducts(flatRule, fromProducts)
  }, [equipmentPaisa, bundlePaisa, subRentalPaisa, lines, productDepositTerms])

  const manualDepositPaisa = useMemo<Paisa | null>(() => {
    if (!manualDepositOverride) return null
    const num = Number(manualDepositAmount)
    return Number.isFinite(num) && num >= 0 ? (rupees(num) as Paisa) : null
  }, [manualDepositOverride, manualDepositAmount])

  const pricing = useMemo<PricingPipelineResult>(() => {
    const promo = promoCodeApplied
    return calculatePricingPipeline({
      equipmentSubtotalPaisa: equipmentPaisa,
      bundleSubtotalPaisa: bundlePaisa,
      subRentalSubtotalPaisa: subRentalPaisa,
      servicesSubtotalPaisa: servicePaisa,
      crewSubtotalPaisa: crewChargesPaisa,
      deliveryChargePaisa: ((clientPickup ? 0 : deliveryChargePaisa) + returnTransportPaisa) as Paisa,
      fuelChargePaisa: quoteFuelPaisa,
      discounts: {
        manualDiscountPercent: discountPct,
        manualDiscountReason: manualDiscountReason.trim() || null,
        manualDiscountAuthorizedBy: manualDiscountAuthorizedBy.trim() || null,
        womenDopEligible,
        promoCode: promo,
        isStudentBundle,
      },
      vatEnabled: vatOn,
      vatRatePercent,
      recommendedDepositPaisa: savedDepositPaisa ?? recommendedDepositPaisa,
      manualDepositOverridePaisa: manualDepositPaisa,
      depositOverrideReason: manualDepositOverride ? depositOverrideReason.trim() || null : null,
      depositAuthorizedBy: manualDepositOverride ? depositAuthorizedBy.trim() || null : null,
      bookingDateAd: pickupAt?.toISOString(),
    })
  }, [
    equipmentPaisa,
    bundlePaisa,
    subRentalPaisa,
    servicePaisa,
    crewChargesPaisa,
    clientPickup,
    deliveryChargePaisa,
    quoteFuelPaisa,
    returnTransportPaisa,
    discountPct,
    manualDiscountReason,
    manualDiscountAuthorizedBy,
    womenDopEligible,
    promoCodeApplied,
    isStudentBundle,
    vatOn,
    vatRatePercent,
    recommendedDepositPaisa,
    savedDepositPaisa,
    manualDepositOverride,
    manualDepositPaisa,
    depositOverrideReason,
    depositAuthorizedBy,
    pickupAt,
  ])

  const breakdown = useMemo<PricingBreakdown>(
    () => ({
      equipment: pricing.equipmentSubtotalPaisa,
      crew: pricing.crewSubtotalPaisa,
      transport: pricing.deliverySubtotalPaisa,
      subtotal: pricing.grossSubtotalPaisa,
      discount: pricing.discounts.discountPaisa,
      taxable: pricing.taxableSubtotalPaisa,
      vat: pricing.vatPaisa,
      rentalTotal: pricing.rentalTotalPaisa,
      outstanding: pricing.rentalTotalPaisa,
    }),
    [pricing],
  )

  const depositRequiredPaisa = pricing.securityDeposit.requiredPaisa
  const depositReceivedPaisa = rupees(0) as Paisa
  const depositPendingPaisa = depositRequiredPaisa

  const pricingHints = useMemo(() => {
    const hints: Record<number, Paisa> = {}
    const rentalDays = rentalDaysBetween(pickup, ret) ?? 1
    if (rentalDays > 0 && pricing.rentalTotalPaisa > 0) {
      const dailyRate = Math.round(pricing.rentalTotalPaisa / rentalDays)
      for (const d of [1, 3, 7]) {
        hints[d] = (dailyRate * d) as Paisa
      }
    }
    return hints
  }, [pricing.rentalTotalPaisa, pickup, ret])

  return {
    standaloneEquipmentLines,
    equipmentLines,
    bundleLines,
    subRentalLines,
    equipmentPaisa,
    bundlePaisa,
    subRentalPaisa,
    servicePaisa,
    crewChargesPaisa,
    isStudentBundle,
    recommendedDepositPaisa,
    manualDepositPaisa,
    pricing,
    breakdown,
    depositRequiredPaisa,
    depositReceivedPaisa,
    depositPendingPaisa,
    pricingHints,
  }
}
</file>

<file path="src/modules/rentals/booking/useNewRentalProductDeposits.ts">
import { useEffect, useMemo, useState } from 'react'
import { fetchProductDepositTerms } from '../../../lib/queries/productDeposits'
import type { ProductDepositTerms } from '../../../lib/productDeposit'
import type { Line } from './RentalLineItemsTree'

export interface UseNewRentalProductDepositsResult {
  terms: ReadonlyMap<string, ProductDepositTerms>
  /** Set when the read failed: the recommended deposit is then the flat rule only. */
  error: string | null
}

const EMPTY: ReadonlyMap<string, ProductDepositTerms> = new Map()

/**
 * Loads the deposit terms of the products on the booking (C6). Only the product
 * ids are keyed on, so changing a quantity or a rate does not refetch. The
 * pricing hook stays pure; this is the one place that reads.
 */
export function useNewRentalProductDeposits(lines: readonly Line[]): UseNewRentalProductDepositsResult {
  const key = useMemo(
    () =>
      [...new Set(lines.map((l) => l.productId).filter((id): id is string => Boolean(id)))]
        .sort()
        .join(','),
    [lines],
  )
  const [terms, setTerms] = useState<ReadonlyMap<string, ProductDepositTerms>>(EMPTY)
  const [error, setError] = useState<string | null>(null)

  useEffect(() => {
    if (key === '') {
      setTerms(EMPTY)
      setError(null)
      return
    }
    let active = true
    void fetchProductDepositTerms(key.split(','))
      .then((next) => {
        if (!active) return
        setTerms(next)
        setError(null)
      })
      .catch((err: unknown) => {
        if (!active) return
        setTerms(EMPTY)
        setError(err instanceof Error ? err.message : String(err))
      })
    return () => {
      active = false
    }
  }, [key])

  return { terms, error }
}
</file>

<file path="src/modules/rentals/booking/useNewRentalTiming.ts">
import {
  useCallback,
  useMemo,
  useState,
  type Dispatch,
  type SetStateAction,
} from 'react'
import { getBusinessToday, toBs, type BsDate } from '../../../lib/bs'
import {
  DAY,
  SHOOT_PRESETS,
  bookingDays,
  bookingInstant,
} from './newRentalUtils'
import type { BookingWindow } from './itemCatalogue'

export interface UseNewRentalTimingOptions {
  searchParams: URLSearchParams
}

export interface UseNewRentalTimingResult {
  pickup: string
  setPickup: Dispatch<SetStateAction<string>>
  ret: string
  setRet: Dispatch<SetStateAction<string>>
  pickupTime: string
  setPickupTime: Dispatch<SetStateAction<string>>
  returnTime: string
  setReturnTime: Dispatch<SetStateAction<string>>
  pickupAt: Date | null
  returnAt: Date | null
  days: number
  dayWord: 'day' | 'days'
  bookingWindow: BookingWindow
  pickupBs: BsDate | null
  applyShootPreset: (presetId: (typeof SHOOT_PRESETS)[number]['id']) => void
}

/**
 * Encapsulates rental window timing, Kathmandu business day defaults,
 * calendar conversion (AD/BS), and fast shoot duration presets.
 */
export function useNewRentalTiming({
  searchParams,
}: UseNewRentalTimingOptions): UseNewRentalTimingResult {
  const fromParam = searchParams.get('from')
  const toParam = searchParams.get('to')

  const [pickup, setPickup] = useState(() =>
    fromParam && !Number.isNaN(Date.parse(fromParam))
      ? fromParam
      : getBusinessToday().toISOString().slice(0, 10),
  )
  const [ret, setRet] = useState(() =>
    toParam && !Number.isNaN(Date.parse(toParam))
      ? toParam
      : new Date(getBusinessToday().getTime() + DAY).toISOString().slice(0, 10),
  )
  const [pickupTime, setPickupTime] = useState('09:00')
  const [returnTime, setReturnTime] = useState('18:00')

  const pickupAt = useMemo(() => bookingInstant(pickup, pickupTime), [pickup, pickupTime])
  const returnAt = useMemo(() => bookingInstant(ret, returnTime), [ret, returnTime])
  const days = useMemo(() => bookingDays(pickupAt, returnAt), [pickupAt, returnAt])
  const dayWord = days === 1 ? 'day' : 'days'
  const bookingWindow = useMemo<BookingWindow>(
    () => ({ pickupAd: pickupAt, returnAd: returnAt }),
    [pickupAt, returnAt],
  )
  const pickupBs = useMemo(() => toBs(new Date(pickup)), [pickup])

  const applyShootPreset = useCallback(
    (presetId: (typeof SHOOT_PRESETS)[number]['id']) => {
      const base = new Date(pickup ? `${pickup}T12:00:00Z` : `${getBusinessToday().toISOString().slice(0, 10)}T12:00:00Z`)
      if (Number.isNaN(base.getTime())) return

      if (presetId === '1-day') {
        const pStr = base.toISOString().slice(0, 10)
        setPickup(pStr)
        setPickupTime('07:00')
        setRet(pStr)
        setReturnTime('20:00')
      } else if (presetId === 'weekend') {
        const dayOfWeek = base.getDay()
        const daysUntilFriday = (5 - dayOfWeek + 7) % 7
        const fri = new Date(base.getTime() + daysUntilFriday * DAY)
        const mon = new Date(fri.getTime() + 3 * DAY)
        setPickup(fri.toISOString().slice(0, 10))
        setPickupTime('14:00')
        setRet(mon.toISOString().slice(0, 10))
        setReturnTime('10:00')
      } else if (presetId === '3-day') {
        const pStr = base.toISOString().slice(0, 10)
        const rDate = new Date(base.getTime() + 2 * DAY)
        setPickup(pStr)
        setPickupTime('08:00')
        setRet(rDate.toISOString().slice(0, 10))
        setReturnTime('20:00')
      } else if (presetId === '1-week') {
        const pStr = base.toISOString().slice(0, 10)
        const rDate = new Date(base.getTime() + 6 * DAY)
        setPickup(pStr)
        setPickupTime('08:00')
        setRet(rDate.toISOString().slice(0, 10))
        setReturnTime('20:00')
      }
    },
    [pickup],
  )

  return {
    pickup,
    setPickup,
    ret,
    setRet,
    pickupTime,
    setPickupTime,
    returnTime,
    setReturnTime,
    pickupAt,
    returnAt,
    days,
    dayWord,
    bookingWindow,
    pickupBs,
    applyShootPreset,
  }
}
</file>

