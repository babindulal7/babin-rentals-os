            border: '1px solid var(--border)',
            borderRadius: 'var(--r-card)',
            padding: '14px 16px',
            boxShadow: 'var(--shadow-card)',
            display: 'flex',
            alignItems: 'center',
            gap: 12,
            textAlign: 'left',
            cursor: 'pointer',
          }}
        >
          <div
            style={{
              width: 40,
              height: 40,
              borderRadius: 'var(--r-sm)',
              background: 'rgba(28, 92, 196, 0.08)',
              color: 'var(--accent)',
              display: 'grid',
              placeItems: 'center',
            }}
          >
            <Icon name="checklist" size={20} />
          </div>
          <div>
            <div style={{ fontSize: '11px', fontWeight: 600, color: 'var(--muted)', textTransform: 'uppercase' }}>
              Open Tasks
            </div>
            <div style={{ fontSize: '20px', fontWeight: 700, color: 'var(--text)', fontFamily: 'var(--font-mono, monospace)', fontVariantNumeric: 'tabular-nums' }}>
              {stats.open}
            </div>
          </div>
        </button>

        <button
          type="button"
          onClick={() => {
            setStatusFilter('resolved')
          }}
          style={{
            background: 'var(--card)',
            border: '1px solid var(--border)',
            borderRadius: 'var(--r-card)',
            padding: '14px 16px',
            boxShadow: 'var(--shadow-card)',
            display: 'flex',
            alignItems: 'center',
            gap: 12,
            textAlign: 'left',
            cursor: 'pointer',
          }}
        >
          <div
            style={{
              width: 40,
              height: 40,
              borderRadius: 'var(--r-sm)',
              background: 'rgba(47, 158, 68, 0.1)',
              color: 'var(--success-text)',
              display: 'grid',
              placeItems: 'center',
            }}
          >
            <Icon name="check" size={20} />
          </div>
          <div>
            <div style={{ fontSize: '11px', fontWeight: 600, color: 'var(--muted)', textTransform: 'uppercase' }}>
              Resolved Today
            </div>
            <div style={{ fontSize: '20px', fontWeight: 700, color: 'var(--text)', fontFamily: 'var(--font-mono, monospace)', fontVariantNumeric: 'tabular-nums' }}>
              {stats.resolved}
            </div>
          </div>
        </button>
      </div>

      {/* Main Layout: Feed on Left, Composer on Right Rail */}
      <div className="notes-layout-grid">
        {/* Left Column: Search, Active Filters & Notes Feed */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
          {/* Controls Bar: Search & Status / Priority */}
          <div
            style={{
              background: 'var(--card)',
              border: '1px solid var(--border)',
              borderRadius: 'var(--r-card)',
              padding: '12px 16px',
              boxShadow: 'var(--shadow-card)',
              display: 'flex',
              flexDirection: 'column',
              gap: 12,
            }}
          >
            {/* Top row: Search, Status tabs, Priority toggle, Sort */}
            <div style={{ display: 'flex', gap: 10, flexWrap: 'wrap', alignItems: 'center' }}>
              <div style={{ flex: 1, minWidth: 200, position: 'relative' }}>
                <input
                  ref={searchInputRef}
                  type="text"
                  aria-label="Search notes"
                  value={searchTerm}
                  onChange={e => setSearchTerm(e.target.value)}
                  placeholder="Search notes by keyword, booking ID, author, asset tag... (Press / to focus)"
                  style={{
                    width: '100%',
                    minHeight: 44,
                    padding: '0 36px 0 34px',
                    borderRadius: 'var(--r-sm)',
                    border: '1px solid var(--border)',
                    background: 'var(--input-bg)',
                    color: 'var(--text)',
                    fontSize: '13px',
                  }}
                />
                <span style={{ position: 'absolute', left: 10, top: '50%', transform: 'translateY(-50%)', color: 'var(--muted)', pointerEvents: 'none' }}>
                  <Icon name="search" size={16} />
                </span>
                {searchTerm && (
                  <button
                    type="button"
                    onClick={() => setSearchTerm('')}
                    style={{
                      position: 'absolute',
                      right: 8,
                      top: '50%',
                      transform: 'translateY(-50%)',
                      background: 'none',
                      border: 'none',
                      color: 'var(--muted)',
                      cursor: 'pointer',
                      padding: 4,
                    }}
                  >
                    <Icon name="close" size={14} />
                  </button>
                )}
              </div>

              {/* Status tabs */}
              <div style={{ display: 'flex', borderRadius: 'var(--r-sm)', border: '1px solid var(--border)', overflow: 'hidden' }}>
                {(['all', 'open', 'resolved', 'pinned'] as const).map(tab => (
                  <button
                    key={tab}
                    type="button"
                    aria-pressed={statusFilter === tab}
                    onClick={() => setStatusFilter(tab)}
                    style={{
                      minHeight: 44,
                      padding: '0 12px',
                      border: 'none',
                      background: statusFilter === tab ? 'var(--accent)' : 'var(--card)',
                      color: statusFilter === tab ? '#fff' : 'var(--text2)',
                      fontSize: '12px',
                      fontWeight: 600,
                      cursor: 'pointer',
                      textTransform: 'capitalize',
                      transition: 'background var(--dur-fast)',
                    }}
                  >
                    {tab}
                  </button>
                ))}
              </div>

              {/* Priority filter toggle */}
              <button
                type="button"
                aria-pressed={priorityFilter === 'urgent'}
                onClick={() => setPriorityFilter(prev => prev === 'all' ? 'urgent' : 'all')}
                style={{
                  minHeight: 44,
                  padding: '0 12px',
                  borderRadius: 'var(--r-sm)',
                  border: `1px solid ${priorityFilter === 'urgent' ? 'var(--danger)' : 'var(--border)'}`,
                  background: priorityFilter === 'urgent' ? 'rgba(217, 72, 69, 0.12)' : 'var(--card)',
                  color: priorityFilter === 'urgent' ? 'var(--danger)' : 'var(--text2)',
                  fontSize: '12px',
                  fontWeight: 600,
                  cursor: 'pointer',
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: 6,
                }}
              >
                <Icon name="bell" size={14} />
                {priorityFilter === 'urgent' ? 'Urgent Only' : 'All Urgency'}
              </button>

              {/* Sort Selector */}
              <select
                aria-label="Sort notes by"
                value={sortBy}
                onChange={e => setSortBy(e.target.value as typeof sortBy)}
                style={{
                  minHeight: 44,
                  padding: '0 10px',
                  borderRadius: 'var(--r-sm)',
                  border: '1px solid var(--border)',
                  background: 'var(--input-bg)',
                  color: 'var(--text)',
                  fontSize: '12px',
                  fontWeight: 600,
                }}
              >
                <option value="pinned-first">📌 Pinned First</option>
                <option value="newest">⏱ Newest First</option>
                <option value="oldest">⏳ Oldest First</option>
                <option value="priority">🚨 Priority First</option>
              </select>
            </div>

            {/* Category Filter Pills */}
            <div style={{ display: 'flex', gap: 6, overflowX: 'auto', paddingBottom: 2 }}>
              {(['All', ...CATEGORIES] as const).map(cat => {
                const count = categoryCounts[cat] ?? 0
                const isActive = filterCategory === cat
                return (
                  <button
                    key={cat}
                    type="button"
                    aria-pressed={isActive}
                    onClick={() => setFilterCategory(cat)}
                    style={{
                      minHeight: 44,
                      padding: '4px 12px',
                      borderRadius: 'var(--r-pill)',
                      border: `1px solid ${isActive ? 'var(--accent)' : 'var(--border)'}`,
                      background: isActive ? 'var(--accent)' : 'var(--surface-2)',
                      color: isActive ? '#fff' : 'var(--text2)',
                      fontSize: '12px',
                      fontWeight: 600,
                      cursor: 'pointer',
                      whiteSpace: 'nowrap',
                      display: 'inline-flex',
                      alignItems: 'center',
                      gap: 6,
                    }}
                  >
                    <span>{cat}</span>
                    <span
                      style={{
                        padding: '1px 6px',
                        borderRadius: 10,
                        background: isActive ? 'rgba(255, 255, 255, 0.25)' : 'var(--card)',
                        fontSize: '10px',
                        fontFamily: 'var(--font-mono, monospace)',
                      }}
                    >
                      {count}
                    </span>
                  </button>
                )
              })}
            </div>

            {/* Active Entity Tag Filter Banner */}
            {selectedEntityFilter && (
              <div
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  padding: '6px 12px',
                  borderRadius: 'var(--r-sm)',
                  background: 'rgba(28, 92, 196, 0.08)',
                  border: '1px solid var(--border)',
                  fontSize: '12px',
                }}
              >
                <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                  <Icon name={getReferenceIconName(selectedEntityFilter)} size={14} style={{ color: 'var(--accent)' }} />
                  <span>Filtered to entity:</span>
                  <span style={{ fontFamily: 'var(--font-mono, monospace)', fontWeight: 700, color: 'var(--accent)' }}>
                    {selectedEntityFilter}
                  </span>
                </div>
                <button
                  type="button"
                  onClick={() => setSelectedEntityFilter(null)}
                  style={{
                    minHeight: 44,
                    background: 'none',
                    border: 'none',
                    color: 'var(--accent)',
                    cursor: 'pointer',
                    fontSize: '11px',
                    fontWeight: 600,
                  }}
                >
                  Clear Entity Filter ×
                </button>
              </div>
            )}
          </div>

          {/* Notes Feed: Cards View vs Compact Table View */}
          {filteredNotes.length === 0 ? (
            <div
              style={{
                background: 'var(--card)',
                border: '1px solid var(--border)',
                borderRadius: 'var(--r-card)',
                padding: '48px 20px',
                textAlign: 'center',
                color: 'var(--muted)',
              }}
            >
              <div
                style={{
                  width: 48,
                  height: 48,
                  borderRadius: '50%',
                  background: 'var(--surface-2)',
                  display: 'grid',
                  placeItems: 'center',
                  margin: '0 auto 12px',
                }}
              >
                <Icon name="checklist" size={24} style={{ color: 'var(--muted)' }} />
              </div>
              <div style={{ fontSize: '15px', fontWeight: 600, color: 'var(--text)', marginBottom: 4 }}>
                No internal notes found
              </div>
              <div style={{ fontSize: '13px', maxWidth: 400, margin: '0 auto 16px' }}>
                {searchTerm || filterCategory !== 'All' || statusFilter !== 'all' || selectedEntityFilter
                  ? 'No notes match your active filter criteria. Try clearing search or filters.'
                  : 'The team dispatch scratchpad is currently empty. Post a new shift note on the right.'}
              </div>
              {(searchTerm || filterCategory !== 'All' || statusFilter !== 'all' || selectedEntityFilter) && (
                <Button
                  variant="secondary"
                  onClick={() => {
                    setSearchTerm('')
                    setFilterCategory('All')
                    setStatusFilter('all')
                    setSelectedEntityFilter(null)
                  }}
                >
                  Reset All Filters
                </Button>
              )}
            </div>
          ) : viewMode === 'compact' ? (
            /* Compact Operations Table */
            <div style={{ overflowX: 'auto' }}>
              <table className="notes-compact-table">
                <thead>
                  <tr>
                    <th style={{ width: 140 }}>Author / Time</th>
                    <th style={{ width: 130 }}>Ref / Entity</th>
                    <th style={{ width: 130 }}>Category</th>
                    <th>Message & Dispatch Remark</th>
                    <th style={{ width: 130, textAlign: 'right' }}>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  {filteredNotes.map(n => {
                    const isResolved = n.status === 'resolved'
                    const isUrgent = n.priority === 'urgent'
                    const allRefs = n.referenceIds && n.referenceIds.length > 0
                      ? n.referenceIds
                      : extractReferenceIds(n.text)

                    return (
                      <tr
                        key={n.id}
                        className={`${isResolved ? 'is-resolved' : ''} ${isUrgent && !isResolved ? 'is-urgent' : ''}`}
                      >
                        <td>
                          <div style={{ fontWeight: 600, color: 'var(--text)' }}>{n.author}</div>
                          <div style={{ fontSize: '11px', color: 'var(--muted)' }}>{n.at}</div>
                        </td>
                        <td>
                          {allRefs.length > 0 ? (
                            <div style={{ display: 'flex', flexWrap: 'wrap', gap: 4 }}>
                              {allRefs.map(ref => (
                                <button
                                  key={ref}
                                  type="button"
                                  onClick={() => setSelectedEntityFilter(ref)}
                                  className="note-ref-chip"
                                  title={`Filter by ${ref}`}
                                >
                                  <Icon name={getReferenceIconName(ref)} size={11} />
                                  {ref}
                                </button>
                              ))}
                            </div>
                          ) : (
                            <span style={{ color: 'var(--muted)', fontSize: '11px' }}>—</span>
                          )}
                        </td>
                        <td>
                          <Badge
                            label={n.category}
                            tone={
                              n.category === 'Gear Alert' || n.category === 'Equipment Alert'
                                ? 'danger'
                                : n.category === 'Shift Handover'
                                ? 'primary'
                                : 'neutral'
                            }
                          />
                        </td>
                        <td>
                          <div
                            style={{
                              textDecoration: isResolved ? 'line-through' : 'none',
                              color: isResolved ? 'var(--muted)' : 'var(--text)',
                              lineHeight: 1.4,
                            }}
                          >
                            {n.text}
                          </div>
                        </td>
                        <td style={{ textAlign: 'right' }}>
                          <div style={{ display: 'inline-flex', gap: 4, alignItems: 'center' }}>
                            <button
                              type="button"
                              onClick={() => handleToggleResolve(n.id)}
                              title={isResolved ? 'Reopen task' : 'Mark as done'}
                              style={{
                                minHeight: 44,
                                padding: '4px 10px',
                                borderRadius: 'var(--r-sm)',
                                border: '1px solid var(--border)',
                                background: isResolved ? 'var(--surface-2)' : 'rgba(47, 158, 68, 0.08)',
                                color: isResolved ? 'var(--muted)' : 'var(--success-text)',
                                cursor: 'pointer',
                                fontSize: '11px',
                                fontWeight: 600,
                                display: 'inline-flex',
                                alignItems: 'center',
                              }}
                            >
                              {isResolved ? 'Reopen' : 'Done'}
                            </button>
                            <button
                              type="button"
                              aria-label={n.pinned ? 'Unpin note' : 'Pin note'}
                              onClick={() => handleTogglePin(n.id)}
                              title={n.pinned ? 'Unpin' : 'Pin'}
                              style={{
                                minWidth: 44,
                                minHeight: 44,
                                padding: '4px 6px',
                                border: 'none',
                                background: 'transparent',
                                color: n.pinned ? 'var(--accent)' : 'var(--muted)',
                                cursor: 'pointer',
                                display: 'inline-flex',
                                alignItems: 'center',
                                justifyContent: 'center',
                              }}
                            >
                              <Icon name="bell" size={14} fill={Boolean(n.pinned)} />
                            </button>
                          </div>
                        </td>
                      </tr>
                    )
                  })}
                </tbody>
              </table>
            </div>
          ) : (
            /* Cards View */
            <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
              {filteredNotes.map(n => {
                const isEditing = editingId === n.id
                const isResolved = n.status === 'resolved'
                const isPinned = Boolean(n.pinned)
                const isUrgent = n.priority === 'urgent'

                const tone: 'danger' | 'primary' | 'warning' | 'neutral' =
                  n.category === 'Gear Alert' || n.category === 'Equipment Alert'
                    ? 'danger'
                    : n.category === 'Shift Handover'
                    ? 'primary'
                    : n.category === 'Logistics & Transport'
                    ? 'primary'
                    : n.category === 'Client Remark'
                    ? 'warning'
                    : 'neutral'

                const initials = n.author
                  .split(' ')
                  .map(w => w[0])
                  .join('')
                  .slice(0, 2)
                  .toUpperCase()

                // Extract all references in text
                const allRefs = n.referenceIds && n.referenceIds.length > 0
                  ? n.referenceIds
                  : extractReferenceIds(n.text)

                return (
                  <div
                    key={n.id}
                    className={`note-card ${isPinned ? 'is-pinned' : ''} ${isResolved ? 'is-resolved' : ''} ${isUrgent && !isResolved ? 'is-urgent' : ''}`}
                  >
                    {/* Top Row: Author & Badges & Quick Action Controls */}
                    <div style={{ display: 'flex', alignItems: 'flex-start', justifyContent: 'space-between', gap: 10, marginBottom: 10 }}>
                      <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
                        <span
                          style={{
                            width: 32,
                            height: 32,
                            borderRadius: '50%',
                            background: isResolved ? 'var(--surface-2)' : 'var(--nav-active-bg)',
                            border: '1px solid var(--border)',
                            display: 'grid',
                            placeItems: 'center',
                            fontSize: '11px',
                            fontWeight: 700,
                            color: isResolved ? 'var(--muted)' : 'var(--accent)',
                            flexShrink: 0,
                          }}
                        >
                          {initials}
                        </span>
                        <div>
                          <div style={{ fontSize: '13px', fontWeight: 700, lineHeight: 1.2, color: 'var(--text)' }}>
                            {n.author}
                          </div>
                          <div style={{ fontSize: '11px', color: 'var(--muted)', marginTop: 2 }}>
                            {n.authorRole} · {n.at}
                          </div>
                        </div>
                      </div>

                      {/* Badges Cluster */}
                      <div style={{ display: 'flex', alignItems: 'center', gap: 6, flexWrap: 'wrap' }}>
                        {isPinned && (
                          <span
                            style={{
                              display: 'inline-flex',
                              alignItems: 'center',
                              gap: 3,
                              padding: '2px 7px',
                              borderRadius: 'var(--r-pill)',
                              background: 'rgba(28, 92, 196, 0.1)',
                              color: 'var(--accent)',
                              fontSize: '11px',
                              fontWeight: 700,
                            }}
                          >
                            <Icon name="bell" size={11} fill />
                            PINNED
                          </span>
                        )}

                        {isUrgent && !isResolved && (
                          <Badge label="URGENT" tone="danger" />
                        )}

                        <Badge label={n.category} tone={tone} />

                        {isResolved ? (
                          <span
                            style={{
                              display: 'inline-flex',
                              alignItems: 'center',
                              gap: 3,
                              padding: '2px 8px',
                              borderRadius: 'var(--r-pill)',
                              background: 'rgba(47, 158, 68, 0.12)',
                              color: 'var(--success-text)',
                              fontSize: '11px',
                              fontWeight: 700,
                            }}
                          >
                            <Icon name="check" size={11} />
                            RESOLVED
                          </span>
                        ) : null}

                        {/* Pin and Delete Buttons */}
                        <button
                          type="button"
                          aria-label={isPinned ? 'Unpin note' : 'Pin note to top'}
                          onClick={() => handleTogglePin(n.id)}
                          title={isPinned ? 'Unpin note' : 'Pin note to top'}
                          style={{
                            minWidth: 44,
                            minHeight: 44,
                            border: 'none',
                            background: 'transparent',
                            color: isPinned ? 'var(--accent)' : 'var(--muted)',
                            cursor: 'pointer',
                            padding: 6,
                            borderRadius: 'var(--r-sm)',
                            display: 'grid',
                            placeItems: 'center',
                          }}
                        >
                          <Icon name="bell" size={15} fill={isPinned} />
                        </button>

                        <button
                          type="button"
                          aria-label="Delete note"
                          onClick={() => handleDelete(n.id)}
                          title="Delete note"
                          style={{
                            minWidth: 44,
                            minHeight: 44,
                            border: 'none',
                            background: 'transparent',
                            color: 'var(--muted)',
                            cursor: 'pointer',
                            padding: 6,
                            borderRadius: 'var(--r-sm)',
                            display: 'grid',
                            placeItems: 'center',
                          }}
                        >
                          <Icon name="close" size={15} />
                        </button>
                      </div>
                    </div>

                    {/* Note Body or Inline Edit Mode */}
                    {isEditing ? (
                      <div style={{ marginTop: 8, display: 'flex', flexDirection: 'column', gap: 10 }}>
                        <textarea
                          rows={3}
                          aria-label="Edit note content"
                          value={editDraft}
                          onChange={e => setEditDraft(e.target.value)}
                          style={{
                            width: '100%',
                            padding: '8px 10px',
                            borderRadius: 'var(--r-sm)',
                            border: '1px solid var(--accent)',
                            background: 'var(--input-bg)',
                            color: 'var(--text)',
                            fontSize: 'var(--t-body)',
                            fontFamily: 'inherit',
                          }}
                        />

                        {/* Edit attached ID */}
                        <div style={{ display: 'flex', alignItems: 'center', gap: 8, flexWrap: 'wrap' }}>
                          <span style={{ fontSize: '11px', color: 'var(--muted)', fontWeight: 600 }}>Linked Entity:</span>
                          {editRefId ? (
                            <span className="attached-ref-chip">
                              <Icon name={getReferenceIconName(editRefId)} size={12} />
                              {editRefId}
                              <button
                                type="button"
                                onClick={() => setEditRefId(null)}
                                title="Remove linked entity"
                              >
                                ×
                              </button>
                            </span>
                          ) : (
                            <button
                              type="button"
                              onClick={() => setIsEditingEntitySelectorOpen(true)}
                              style={{
                                minHeight: 44,
                                padding: '3px 10px',
                                borderRadius: 'var(--r-sm)',
                                border: '1px solid var(--border)',
                                background: 'var(--surface-2)',
                                color: 'var(--text2)',
                                fontSize: '11px',
                                cursor: 'pointer',
                                display: 'inline-flex',
                                alignItems: 'center',
                                gap: 4,
                              }}
                            >
                              <Icon name="barcode" size={12} />
                              + Select ID
                            </button>
                          )}
                        </div>

                        <div style={{ display: 'flex', gap: 8, alignItems: 'center', flexWrap: 'wrap' }}>
                          <select
                            value={editCategory}
                            aria-label="Edit note category"
                            onChange={e => setEditCategory(e.target.value as NoteCategory)}
                            style={{
                              padding: '6px 10px',
                              borderRadius: 'var(--r-sm)',
                              border: '1px solid var(--border)',
                              background: 'var(--input-bg)',
                              color: 'var(--text)',
                              fontSize: '11px',
                              minHeight: 44,
                            }}
                          >
                            {CATEGORIES.map(c => (
                              <option key={c} value={c}>{c}</option>
                            ))}
                          </select>
                          <select
                            value={editPriority}
                            aria-label="Edit note priority"
                            onChange={e => setEditPriority(e.target.value as NotePriority)}
                            style={{
                              padding: '6px 10px',
                              borderRadius: 'var(--r-sm)',
                              border: '1px solid var(--border)',
                              background: 'var(--input-bg)',
                              color: 'var(--text)',
                              fontSize: '11px',
                              minHeight: 44,
                            }}
                          >
                            <option value="low">Low</option>
                            <option value="normal">Normal</option>
                            <option value="high">High</option>
                            <option value="urgent">Urgent</option>
                          </select>
                          <div style={{ flex: 1 }} />
                          <Button variant="secondary" onClick={handleCancelEdit} style={{ minHeight: 44, padding: '0 16px' }}>
                            Cancel
                          </Button>
                          <Button variant="primary" onClick={() => handleSaveEdit(n.id)} style={{ minHeight: 44, padding: '0 16px' }}>
                            Save
                          </Button>
                        </div>
                      </div>
                    ) : (
                      <>
                        <div
                          style={{
                            fontSize: 'var(--t-body)',
                            color: isResolved ? 'var(--muted)' : 'var(--text)',
                            lineHeight: 1.5,
                            whiteSpace: 'pre-wrap',
                            textDecoration: isResolved ? 'line-through' : 'none',
                          }}
                        >
                          {n.text}
                        </div>

                        {/* Interactive Clickable Reference Links with entity icons */}
                        {allRefs.length > 0 && (
                          <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6, marginTop: 10 }}>
                            {allRefs.map(ref => (
                              <div key={ref} style={{ display: 'inline-flex', alignItems: 'center', gap: 4 }}>
                                <Link
                                  to={getReferenceUrl(ref)}
                                  className="note-ref-chip"
                                  title={`Open ${ref} details page`}
                                >
                                  <Icon name={getReferenceIconName(ref)} size={12} />
                                  {ref}
                                  <Icon name="external_link" size={10} style={{ opacity: 0.7 }} />
                                </Link>
                                <button
                                  type="button"
                                  onClick={() => setSelectedEntityFilter(ref)}
                                  title={`Filter all notes by ${ref}`}
                                  style={{
                                    minHeight: 44,
                                    border: 'none',
                                    background: 'var(--surface-2)',
                                    color: 'var(--muted)',
                                    cursor: 'pointer',
                                    padding: '0 10px',
                                    borderRadius: 'var(--r-sm)',
                                    fontSize: '10px',
                                    display: 'inline-flex',
                                    alignItems: 'center',
                                  }}
                                >
                                  Filter
                                </button>
                              </div>
                            ))}
                          </div>
                        )}

                        {/* Resolution Attribution */}
                        {isResolved && n.resolvedBy && (
                          <div
                            style={{
                              marginTop: 10,
                              padding: '6px 10px',
                              borderRadius: 'var(--r-sm)',
                              background: 'rgba(47, 158, 68, 0.08)',
                              color: 'var(--success-text)',
                              fontSize: '11px',
                              display: 'inline-flex',
                              alignItems: 'center',
                              gap: 6,
                            }}
                          >
                            <Icon name="check" size={12} />
                            Completed by {n.resolvedBy}
                          </div>
                        )}

                        {/* Card Bottom Actions */}
                        <div
                          style={{
                            display: 'flex',
                            alignItems: 'center',
                            justifyContent: 'space-between',
                            marginTop: 12,
                            paddingTop: 8,
                            borderTop: '1px solid var(--border)',
                          }}
                        >
                          <button
                            type="button"
                            onClick={() => handleToggleResolve(n.id)}
                            style={{
                              minHeight: 44,
                              padding: '0 12px',
                              borderRadius: 'var(--r-sm)',
                              border: `1px solid ${isResolved ? 'var(--border)' : 'var(--success-border, rgba(47, 158, 68, 0.4))'}`,
                              background: isResolved ? 'var(--surface-2)' : 'rgba(47, 158, 68, 0.08)',
                              color: isResolved ? 'var(--muted)' : 'var(--success-text)',
                              fontSize: '12px',
                              fontWeight: 600,
                              cursor: 'pointer',
                              display: 'inline-flex',
                              alignItems: 'center',
                              gap: 6,
                              transition: 'all var(--dur-fast)',
                            }}
                          >
                            <Icon name="check" size={14} />
                            {isResolved ? 'Reopen Task' : 'Mark as Done'}
                          </button>

                          <div style={{ display: 'flex', gap: 6, alignItems: 'center' }}>
                            <button
                              type="button"
                              onClick={() => handleStartEdit(n)}
                              title="Edit note"
                              style={{
                                minHeight: 44,
                                padding: '0 10px',
                                borderRadius: 'var(--r-sm)',
                                border: 'none',
                                background: 'transparent',
                                color: 'var(--muted)',
                                cursor: 'pointer',
                                fontSize: '11px',
                                display: 'inline-flex',
                                alignItems: 'center',
                                gap: 4,
                              }}
                            >
                              <Icon name="edit" size={13} />
                              Edit
                            </button>

                            <button
                              type="button"
                              onClick={() => {
                                if (navigator.clipboard) {
                                  void navigator.clipboard.writeText(n.text).then(() => {
                                    toast?.showSuccessToast('Copied', 'Note text copied.')
                                  })
                                }
                              }}
                              title="Copy text"
                              style={{
                                minHeight: 44,
                                padding: '0 10px',
                                borderRadius: 'var(--r-sm)',
                                border: 'none',
                                background: 'transparent',
                                color: 'var(--muted)',
                                cursor: 'pointer',
                                fontSize: '11px',
                                display: 'inline-flex',
                                alignItems: 'center',
                                gap: 4,
                              }}
                            >
                              <Icon name="copy" size={13} />
                              Copy
                            </button>
                          </div>
                        </div>
                      </>
                    )}
                  </div>
                )
              })}
            </div>
          )}
        </div>

        {/* Right Column: Note Composer & Entity Picker */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
          {/* Note Composer Card */}
          <div
            style={{
              background: 'var(--card)',
              border: '1px solid var(--border)',
              borderRadius: 'var(--r-card)',
              padding: 18,
              boxShadow: 'var(--shadow-card)',
            }}
          >
            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 12 }}>
              <div style={{ fontSize: '13px', fontWeight: 700, color: 'var(--text)' }}>
                Post Internal Dispatch Note
              </div>
              <span style={{ fontSize: '11px', color: 'var(--muted)' }}>
                Ctrl+Enter to post
              </span>
            </div>

            {/* Quick Templates */}
            <div style={{ marginBottom: 12 }}>
              <div style={{ fontSize: '11px', color: 'var(--muted)', marginBottom: 6, fontWeight: 600 }}>
                Quick Prompts:
              </div>
              <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6 }}>
                {QUICK_TEMPLATES.map(t => (
                  <button
                    key={t.label}
                    type="button"
                    className="note-template-pill"
                    onClick={() => handleApplyTemplate(t)}
                  >
                    {t.label}
                  </button>
                ))}
              </div>
            </div>

            <form onSubmit={handlePost} style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
              <textarea
                ref={textareaRef}
                rows={4}
                aria-label="Internal note draft"
                value={draft}
                onChange={e => setDraft(e.target.value)}
                onKeyDown={e => {
                  if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {
                    e.preventDefault()
                    handlePost()
                  }
                }}
                placeholder="Log equipment defect, turnover checklist, booking warning... Use IDs like BR-2613 or EQ-SONY-FX6-02."
                style={{
                  width: '100%',
                  padding: '10px 12px',
                  borderRadius: 'var(--r-sm)',
                  border: '1px solid var(--border)',
                  background: 'var(--input-bg)',
                  color: 'var(--text)',
                  fontSize: 'var(--t-body)',
                  resize: 'vertical',
                  minHeight: 90,
                  fontFamily: 'inherit',
                  lineHeight: 1.45,
                }}
              />

              {/* Entity ID Attachment Section */}
              <div
                style={{
                  padding: '10px 12px',
                  borderRadius: 'var(--r-sm)',
                  background: 'var(--surface-2)',
                  border: '1px solid var(--border)',
                  display: 'flex',
                  flexDirection: 'column',
                  gap: 8,
                }}
              >
                <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
                  <span style={{ fontSize: '11px', fontWeight: 600, color: 'var(--text2)', display: 'flex', alignItems: 'center', gap: 5 }}>
                    <Icon name="barcode" size={13} style={{ color: 'var(--accent)' }} />
                    Entity ID Tag:
                  </span>
                  <button
                    type="button"
                    onClick={() => setIsEntitySelectorOpen(true)}
                    style={{
                      background: 'none',
                      border: 'none',
                      color: 'var(--accent)',
                      fontSize: '11px',
                      fontWeight: 600,
                      cursor: 'pointer',
                      padding: 0,
                    }}
                  >
                    {attachedRefId ? 'Change ID ↗' : '+ Select / Search ID ↗'}
                  </button>
                </div>

                {attachedRefId ? (
                  <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
                    <span className="attached-ref-chip">
                      <Icon name={getReferenceIconName(attachedRefId)} size={13} />
                      {attachedRefId}
                      <button
                        type="button"
                        onClick={() => setAttachedRefId(null)}
                        title="Remove attached ID"
                      >
                        ×
                      </button>
                    </span>
                    <span style={{ fontSize: '11px', color: 'var(--muted)' }}>
                      Linked to note
                    </span>
                  </div>
                ) : detectedRef ? (
                  <div style={{ display: 'flex', alignItems: 'center', gap: 6, fontSize: '11px' }}>
                    <span style={{ color: 'var(--muted)' }}>Detected in text:</span>
                    <span className="note-ref-chip">
                      <Icon name={getReferenceIconName(detectedRef)} size={11} />
                      {detectedRef}
                    </span>
                  </div>
                ) : (
                  /* Quick Suggested Entity Chips */
                  <div style={{ display: 'flex', flexWrap: 'wrap', gap: 4 }}>
                    {suggestedEntities.map(item => (
                      <button
                        key={item.code}
                        type="button"
                        onClick={() => setAttachedRefId(item.code)}
                        style={{
                          padding: '2px 8px',
                          borderRadius: 'var(--r-pill)',
                          border: '1px solid var(--border)',
                          background: 'var(--card)',
                          color: 'var(--text)',
                          fontSize: '10px',
                          fontFamily: 'var(--font-mono, monospace)',
                          fontWeight: 600,
                          cursor: 'pointer',
                        }}
                        title={`Attach ${item.code} (${item.title})`}
                      >
                        +{item.code}
                      </button>
                    ))}
                  </div>
                )}
              </div>

              {/* Category and Urgency */}
              <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 8 }}>
                <div>
                  <label style={{ display: 'block', fontSize: '11px', fontWeight: 600, color: 'var(--text2)', marginBottom: 4 }}>
                    Category
                  </label>
                  <select
                    value={category}
                    onChange={e => setCategory(e.target.value as NoteCategory)}
                    style={{
                      width: '100%',
                      minHeight: 44,
                      padding: '0 10px',
                      borderRadius: 'var(--r-sm)',
                      border: '1px solid var(--border)',
                      background: 'var(--input-bg)',
                      color: 'var(--text)',
                      fontSize: '12px',
                      fontWeight: 600,
                    }}
                  >
                    {CATEGORIES.map(c => (
                      <option key={c} value={c}>{c}</option>
                    ))}
                  </select>
                </div>

                <div>
                  <label style={{ display: 'block', fontSize: '11px', fontWeight: 600, color: 'var(--text2)', marginBottom: 4 }}>
                    Urgency
                  </label>
                  <select
                    value={priority}
                    onChange={e => setPriority(e.target.value as NotePriority)}
                    style={{
                      width: '100%',
                      minHeight: 44,
                      padding: '0 10px',
                      borderRadius: 'var(--r-sm)',
                      border: '1px solid var(--border)',
                      background: 'var(--input-bg)',
                      color: 'var(--text)',
                      fontSize: '12px',
                      fontWeight: 600,
                    }}
                  >
                    <option value="low">Low Priority</option>
                    <option value="normal">Normal</option>
                    <option value="high">High Priority</option>
                    <option value="urgent">🚨 Urgent Attention</option>
                  </select>
                </div>
              </div>

              <Button
                variant="primary"
                type="submit"
                disabled={!draft.trim()}
                style={{ minHeight: 44, justifyContent: 'center' }}
              >
                <Icon name="plus" size={16} />
                Post to Dispatch Log
              </Button>
            </form>
          </div>

          {/* Guidelines Box */}
          <div
            style={{
              background: 'var(--surface-2)',
              border: '1px solid var(--border)',
              borderRadius: 'var(--r-card)',
              padding: '14px 16px',
              fontSize: '12px',
              color: 'var(--text2)',
              lineHeight: 1.5,
            }}
          >
            <div style={{ fontWeight: 700, color: 'var(--text)', marginBottom: 6, display: 'flex', alignItems: 'center', gap: 6 }}>
              <Icon name="info" size={15} style={{ color: 'var(--accent)' }} />
              Ops Protocol & Shortcuts
            </div>
            <ul style={{ margin: 0, paddingLeft: 18, display: 'flex', flexDirection: 'column', gap: 4 }}>
              <li>
                Click <strong>Select / Search ID</strong> to link equipment tags (<code>EQ-SONY-FX6-02</code>), bookings (<code>BR-2613</code>), or client codes.
              </li>
              <li>Press <kbd style={{ padding: '1px 5px', borderRadius: 3, background: 'var(--card)', border: '1px solid var(--border)', fontSize: '11px' }}>Ctrl+Enter</kbd> to quickly submit your note.</li>
              <li>Press <kbd style={{ padding: '1px 5px', borderRadius: 3, background: 'var(--card)', border: '1px solid var(--border)', fontSize: '11px' }}>/</kbd> to instantly focus search.</li>
              <li>Use <strong>Shift Brief</strong> button to export formatted summaries for WhatsApp or Telegram turnover.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  )
}
</file>

<file path="src/modules/notes/notes.css">
/**
 * notes.css — Styles for Team Internal Notes & Dispatch Log
 * Babin Rentals OS
 */

.notes-page-container {
  display: flex;
  flex-direction: column;
  gap: var(--sp-lg);
  padding: var(--sp-lg);
  max-width: 1440px;
  margin: 0 auto;
  width: 100%;
}

@media (max-width: 767px) {
  .notes-page-container {
    padding: var(--sp-md);
    gap: var(--sp-md);
  }
}

.notes-metrics-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--sp-md);
}

@media (max-width: 1200px) {
  .notes-metrics-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 767px) {
  .notes-metrics-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 480px) {
  .notes-metrics-grid {
    grid-template-columns: 1fr;
  }
}

.notes-layout-grid {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: var(--sp-lg);
  align-items: start;
}

@media (max-width: 1200px) {
  .notes-layout-grid {
    grid-template-columns: 1fr;
  }
}

.note-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--r-card);
  padding: 16px 18px;
  box-shadow: var(--shadow-card);
  transition: border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  position: relative;
}

.note-card:hover {
  border-color: var(--border2);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
}

.note-card.is-pinned {
  border-color: var(--accent);
  background: rgba(28, 92, 196, 0.02);
}

.note-card.is-resolved {
  opacity: 0.85;
  background: var(--surface-2);
}

.note-card.is-urgent {
  border-left: 4px solid var(--danger);
}

.note-ref-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 8px;
  border-radius: var(--r-sm);
  background: var(--surface-2);
  border: 1px solid var(--border);
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  font-variant-numeric: tabular-nums;
  font-size: 11px;
  font-weight: 700;
  color: var(--accent);
  text-decoration: none;
  transition: all var(--dur-fast) var(--ease);
  cursor: pointer;
}

.note-ref-chip:hover {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}

.note-template-pill {
  font-size: 11px;
  font-weight: 600;
  padding: 5px 11px;
  border-radius: var(--r-pill);
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text2);
  cursor: pointer;
  white-space: nowrap;
  transition: all var(--dur-fast) var(--ease);
}

.note-template-pill:hover {
  background: var(--surface-2);
  color: var(--text);
  border-color: var(--accent);
}

/* Attached Reference Chip inside Composer */
.attached-ref-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: var(--r-sm);
  background: rgba(28, 92, 196, 0.12);
  border: 1px solid var(--accent);
  color: var(--accent);
  font-family: var(--font-mono, 'JetBrains Mono', monospace);
  font-size: 12px;
  font-weight: 700;
}

.attached-ref-chip button {
  background: none;
  border: none;
  color: var(--accent);
  cursor: pointer;
  padding: 0;
  display: flex;
  align-items: center;
  line-height: 1;
}

/* Compact Table View */
.notes-compact-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--r-card);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.notes-compact-table th {
  padding: 10px 14px;
  background: var(--surface-2);
  border-bottom: 1px solid var(--border);
  font-size: 11px;
  font-weight: 700;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  text-align: left;
}

.notes-compact-table td {
  padding: 10px 14px;
  border-bottom: 1px solid var(--border);
  font-size: 12px;
  color: var(--text);
  vertical-align: middle;
}

.notes-compact-table tr:last-child td {
  border-bottom: none;
}

.notes-compact-table tr:hover td {
  background: rgba(28, 92, 196, 0.03);
}

.notes-compact-table tr.is-resolved td {
  background: var(--surface-2);
  color: var(--muted);
}

.notes-compact-table tr.is-urgent td {
  background: rgba(217, 72, 69, 0.03);
}

.notes-view-btn {
  min-height: 36px;
  padding: 0 10px;
  border-radius: var(--r-sm);
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text2);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  transition: all var(--dur-fast);
}

.notes-view-btn.is-active {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}
</file>

