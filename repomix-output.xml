}

/* -----------------------------------------------------------------------------
 * Application Header Integrations for Rentals List
 * -------------------------------------------------------------------------- */
.workspace-header-right-actions {
  min-width: 0;
}

.rentals-header-actions {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-width: 0;
}

/* Secondary actions hidden below 1280px to prevent header overflow */
.rentals-header-desktop-action {
  display: none !important;
}

@media (min-width: 1280px) {
  .rentals-header-desktop-action {
    display: inline-flex !important;
  }
}

/* Data age badge: visible at desktop band (1280px+) */
.rentals-header-data-age {
  display: none;
}

@media (min-width: 1280px) {
  .rentals-header-data-age {
    display: inline-flex;
    align-items: center;
  }
