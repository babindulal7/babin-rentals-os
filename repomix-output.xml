      canOperate: true,
      bookingNo: 'BK-2026-0715',
    })
    expect(closerAction.label).toBe('Close Rental')
    expect(closerAction.disabled).toBe(false)

    // And direct action invocation by Warehouse staff is refused by capability gate
    await expect(
