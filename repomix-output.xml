                      <td style={td}>{formatAdDateTime(r.returnAt)}</td>
                      <td style={td}>{r.returningPerson}</td>
                      <td style={td}>
                        <span
                          style={{
                            display: 'inline-block',
                            padding: '2px 8px',
                            borderRadius: 'var(--r-sm)',
                            fontSize: 'var(--t-meta)',
                            background: r.damageSuspected
                              ? 'var(--status-danger-bg)'
