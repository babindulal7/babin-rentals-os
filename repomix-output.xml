                    <span>{g}</span>
                    <span className="figure" style={{ marginLeft: 'auto', fontWeight: 600 }}>
                      {lines.length} line{lines.length === 1 ? '' : 's'}
                    </span>
                  </div>
                  <ul style={{ listStyle: 'none', margin: 0, padding: 0 }}>
                    {lines.map((l) => {
                      const lv = lineVerdict(l, bookingWindow)
                      const unpriced = !isPriced(l)
                      return (
                        <li
                          key={`${g}-${l.model}`}
