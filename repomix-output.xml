                            const tone = LINE_TONE[s]
                            const dim = highlight !== null && r.group !== highlight
                            return (
                              <tr key={r.key} className={`floor-table-row ${s === 'Packed' ? 'is-packed' : s === 'Missing' ? 'is-missing' : ''}`} style={{ opacity: dim ? 0.35 : 1 }}>
