<file path="src/actions/clients/importClients.ts">
import { createAction, type ActionConfig } from '../core'
import { saveRecord } from '../recordEditor'
import { supabase } from '../../lib/supabase'
import { findClientMatches } from '../../lib/queries/clients'
import { canImportClients } from '../../lib/clientImport'
import { recordFields, validateRecord, type RecordValues } from '../../lib/recordEditor'
import { EVENT_TYPES } from '../../events/eventBus'
import { PHONE_STORED_RE } from '../../lib/phone'

export interface ClientImportEntry { rowIndex: number; clientUuid: string; values: RecordValues }
export interface ClientImportOutcome {
  rowIndex: number; status: 'saved' | 'failed' | 'unconfirmed' | 'pending';
  clientId?: string; clientCode?: string; message?: string;
}
export interface ImportClientsInput {
  rows: readonly ClientImportEntry[];
  onProgress?: (outcomes: readonly ClientImportOutcome[]) => void;
  shouldStop?: () => boolean;
}
export interface ImportClientsResult { outcomes: ClientImportOutcome[] }
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
const TIMEOUT_MS = 20_000
class ImportConfirmationTimeout extends Error {}

/** A timeout is uncertain: the server may have saved the row. Retry its original receipt key. */
async function confirmedWithin<T>(work: Promise<T>): Promise<T> {
  let timer: ReturnType<typeof setTimeout> | undefined
  try {
    return await Promise.race([work, new Promise<never>((_, reject) => {
      timer = setTimeout(() => reject(new ImportConfirmationTimeout('Save confirmation timed out. Retry this import to check the same save; a second client will not be created.')), TIMEOUT_MS)
    })])
  } finally { if (timer !== undefined) clearTimeout(timer) }
}

export const importClientsConfig: ActionConfig<ImportClientsInput, ImportClientsResult> = {
  name: 'IMPORT_CLIENTS', permissions: ['client.create'], implemented: true,
  validate(input) {
    if (!input.rows.length) throw new Error('Include at least one valid client row.')
    const keys = new Set<string>(), phones = new Set<string>(), emails = new Set<string>(), indices = new Set<number>()
    const fields = new Set(recordFields.client.map(f => f.key))
    for (const row of input.rows) {
      if (!Number.isInteger(row.rowIndex) || row.rowIndex < 0 || indices.has(row.rowIndex)) throw new Error('Every import row must have a unique row number.')
      if (!UUID.test(row.clientUuid) || keys.has(row.clientUuid.toLowerCase())) throw new Error('Every import row must have its own save key.')
      indices.add(row.rowIndex); keys.add(row.clientUuid.toLowerCase())
      if (Object.keys(row.values).some(key => !fields.has(key))) throw new Error('An import row contains an unsupported field.')
      const errors = validateRecord('client', row.values)
      if (!PHONE_STORED_RE.test(String(row.values.phone))) errors.phone = 'Use the confirmed +977 phone number from the preview.'
      const type = row.values.type_parent
      if (type != null && !['Organisation', 'Individual'].includes(String(type))) errors.type_parent = 'Client Type is not recognized.'
      if (type === 'Organisation' && !recordFields.client.find(f => f.key === 'org_subtype')?.options?.includes(String(row.values.org_subtype))) errors.org_subtype = 'Select an Organisation Type.'
      if (type !== 'Organisation' && row.values.org_subtype != null) errors.org_subtype = 'Only an Organisation can have an Organisation Type.'
      if (Object.keys(errors).length) throw new Error(`Row ${row.rowIndex + 1}: ${Object.values(errors).join(' ')}`)
      const phone = String(row.values.phone), email = String(row.values.email ?? '').toLowerCase()
      if (phones.has(phone) || (email && emails.has(email))) throw new Error('Repeated phone or email in the import. Include only one matching row.')
      phones.add(phone); if (email) emails.add(email)
    }
  },
  async execute(input, ctx) {
    if (!canImportClients(ctx.role)) throw new Error('Your role cannot import client contact records.')
    if (ctx.isOnline === false || (typeof navigator !== 'undefined' && navigator.onLine === false)) throw new Error('Connect to import clients. Your file and mappings are still here.')

    // RecordValues are scalar: copying before the first await keeps each receipt's request immutable.
    const rows = input.rows.map(row => ({ ...row, values: { ...row.values } }))
    importClientsConfig.validate({ rows })

    // Reconcile previous attempts before duplicate checking. No money is selected.
    const owned = new Set<string>()
    for (let offset = 0; offset < rows.length; offset += 100) {
      const { data, error } = await confirmedWithin(Promise.resolve(supabase.from('clients').select('id, client_uuid').in('client_uuid', rows.slice(offset, offset + 100).map(row => row.clientUuid))))
      if (error) throw new Error(`Previous saves could not be checked: ${error.message}`)
      for (const row of (data ?? []) as unknown as Array<{ id: string }>) owned.add(row.id)
    }
    const matches = await confirmedWithin(findClientMatches({
      phones: rows.map(row => String(row.values.phone)), emails: rows.map(row => String(row.values.email ?? '')),
    }))
    if (matches.some(match => !owned.has(match.dbId ?? match.id))) throw new Error('One or more rows match an existing client. Nothing new was saved. Review the duplicate and skip that row.')

    const outcomes: ClientImportOutcome[] = rows.map(row => ({ rowIndex: row.rowIndex, status: 'pending' }))
    const events: Array<{ type: string; payload: unknown }> = []
    for (let index = 0; index < rows.length; index++) {
      if (input.shouldStop?.()) break
      const row = rows[index]!
      try {
        const saved = await confirmedWithin(saveRecord({ kind: 'client', id: null, expectedRevision: null, clientUuid: row.clientUuid, values: row.values, rows: [] }, ctx))
        if (!saved.id || !saved.code || !saved.revision) throw new Error('Save confirmation was incomplete. Retry with the same save key.')
        outcomes[index] = { rowIndex: row.rowIndex, status: 'saved', clientId: saved.id, clientCode: saved.code }
        events.push({ type: EVENT_TYPES.CLIENT_CREATED, payload: { clientId: saved.id, clientCode: saved.code, userId: ctx.userId } })
      } catch (error: unknown) {
        outcomes[index] = {
          rowIndex: row.rowIndex, status: error instanceof ImportConfirmationTimeout ? 'unconfirmed' : 'failed',
          message: error instanceof Error ? error.message : 'This row could not be saved. Retry with the same save key.',
        }
        input.onProgress?.([...outcomes])
        break
      }
      input.onProgress?.([...outcomes])
    }
    return { result: { outcomes }, events }
  },
}
export const importClients = createAction(importClientsConfig)
</file>

<file path="src/actions/clients/mergeClients.ts">
import { createAction, type ActionContext, type ActionConfig } from '../core';
import { EVENT_TYPES } from '../../events/eventBus';
import { idempotentInsert, safeUpdate, generateClientUuid } from '../../lib/dataAccess';
import { supabase } from '../../lib/supabase';
import { getClientRecord } from '../../lib/queries/clients';

export type MergeClientsInput = {
  /** UUID or client_code of the surviving client */
  survivorId: string;
  /** UUID or client_code of the duplicate client to be merged and deactivated */
  duplicateId: string;
  /** Optional custom typed confirmation word/phrase (cannot be empty or 'yes') */
  typedConfirmation?: string;
  /** Optional Law 8 idempotency key */
  clientUuid?: string;
};

export type MergeClientsResult = {
  success: boolean;
  survivorId: string;
  duplicateId: string;
  movedSummary: {
    bookings: number;
    invoices: number;
    security_deposits: number;
    cases: number;
    contacts: number;
    documents: number;
    notes: number;
  };
};

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

export const mergeClientsConfig: ActionConfig<MergeClientsInput, MergeClientsResult> = {
  name: 'MERGE_CLIENTS',
  permissions: ['client.merge'],
  implemented: true,

  validate: (input) => {
    if (!input.survivorId || !input.survivorId.trim()) {
      throw new Error('Survivor client ID is required.');
    }
    if (!input.duplicateId || !input.duplicateId.trim()) {
      throw new Error('Duplicate client ID is required.');
    }
    if (input.survivorId.trim() === input.duplicateId.trim()) {
      throw new Error('Cannot merge a client into itself.');
    }
    if (input.typedConfirmation !== undefined) {
      const trimmed = input.typedConfirmation.trim().toLowerCase();
      if (!trimmed || trimmed === 'yes') {
        throw new Error('Typed confirmation cannot be empty or "yes".');
      }
    }
    if (input.clientUuid !== undefined && !UUID_RE.test(input.clientUuid)) {
      throw new Error('A valid clientUuid is required.');
    }
  },

  execute: async (input, ctx: ActionContext) => {
    if (ctx.isOnline === false || (typeof navigator !== 'undefined' && navigator.onLine === false)) {
      throw new Error('This device is offline. Merging clients reassigns financial and booking history and cannot be queued offline.');
    }
    const rawSurvivor = input.survivorId.trim();
    const rawDuplicate = input.duplicateId.trim();

    // 1. Resolve both clients
    const [survivorProfile, duplicateProfile] = await Promise.all([
      getClientRecord(rawSurvivor),
      getClientRecord(rawDuplicate),
    ]);

    if (!survivorProfile) {
      throw new Error(`Survivor client '${rawSurvivor}' not found.`);
    }
    if (!duplicateProfile) {
      throw new Error(`Duplicate client '${rawDuplicate}' not found.`);
    }

    const survivorId = survivorProfile.id;
    const duplicateId = duplicateProfile.id;

    if (survivorId === duplicateId) {
      throw new Error('Cannot merge a client into itself.');
    }

    if (survivorProfile.deactivatedAtAd) {
      throw new Error(`Survivor client '${survivorProfile.record.id}' is deactivated and cannot receive merged records.`);
    }
    if (duplicateProfile.deactivatedAtAd) {
      throw new Error(`Duplicate client '${duplicateProfile.record.id}' has already been deactivated or merged.`);
    }

    // 2. Count and repoint related records
    /* Every repoint is error-checked: an unchecked PATCH that fails silently
       leaves the duplicate's rows behind in a "merged" state. A failed
       repoint stops the merge loudly rather than half-completing it. */
    const repoint = async (table: string): Promise<void> => {
      const { error } = await supabase
        .from(table as 'cases')
        .update({ client_id: survivorId })
        .eq('client_id', duplicateId);
      if (error) {
        throw new Error(
          `Merging stopped — repointing ${table} rows to the survivor failed: ${error.message}. ` +
            `Earlier tables may already have moved; re-run the merge once this is fixed.`,
        );
      }
    };

    // Bookings
    const { data: dupBookings, error: bookingsReadError } = await supabase
      .from('bookings')
      .select('id')
      .eq('client_id', duplicateId);
    if (bookingsReadError) {
      throw new Error(`Could not list the duplicate's bookings: ${bookingsReadError.message}`);
    }
    const bookingIds = (dupBookings ?? []).map((b) => b.id as string);
    const bookingsCount = bookingIds.length;
    if (bookingsCount > 0) {
      await repoint('bookings');
    }

    // Cases follow bookings (linked_booking_id) — the `cases` table has no
    // client_id column, so a direct repoint cannot exist. (An earlier version
    // of this block queried `cases.client_id`; the query 42703'd silently
    // every time. If the product wants case moves on merge, they move with
    // the booking, not with a second update.) The summary counts the ones that
    // moved WITH the bookings — read after the repoint.
    let casesCount = 0;
    if (bookingIds.length > 0) {
      const { count: linkedCases } = await supabase
        .from('cases')
        .select('*', { count: 'exact', head: true })
        .in('linked_booking_id', bookingIds);
      casesCount = linkedCases ?? 0;
    }

    // Invoices
    const { count: invoicesCount } = await supabase
      .from('invoices')
      .select('*', { count: 'exact', head: true })
      .eq('client_id', duplicateId);
    if ((invoicesCount ?? 0) > 0) {
      await repoint('invoices');
    }

    // Security Deposits
    const { count: depositsCount } = await supabase
      .from('security_deposits')
      .select('*', { count: 'exact', head: true })
      .eq('client_id', duplicateId);
    if ((depositsCount ?? 0) > 0) {
      await repoint('security_deposits');
    }

    // Contacts: repoint, set is_primary = false so survivor keeps its own primary contact
    const { count: contactsCount } = await supabase
      .from('client_contacts')
      .select('*', { count: 'exact', head: true })
      .eq('client_id', duplicateId);
    if ((contactsCount ?? 0) > 0) {
      const { error: contactsError } = await supabase
        .from('client_contacts')
        .update({ client_id: survivorId, is_primary: false })
        .eq('client_id', duplicateId);
      if (contactsError) {
        throw new Error(`Merging stopped — repointing contacts failed: ${contactsError.message}`);
      }
    }

    // Documents
    const { count: documentsCount } = await supabase
      .from('client_documents')
      .select('*', { count: 'exact', head: true })
      .eq('client_id', duplicateId);
    if ((documentsCount ?? 0) > 0) {
      await repoint('client_documents');
    }

    // Notes
    const { count: notesCount } = await supabase
      .from('client_notes')
      .select('*', { count: 'exact', head: true })
      .eq('client_id', duplicateId);
    if ((notesCount ?? 0) > 0) {
      await repoint('client_notes');
    }

    const movedSummary = {
      bookings: bookingsCount ?? 0,
      invoices: invoicesCount ?? 0,
      security_deposits: depositsCount ?? 0,
      // Moved WITH their bookings — counted right after the bookings repoint.
      cases: casesCount,
      contacts: contactsCount ?? 0,
      documents: documentsCount ?? 0,
      notes: notesCount ?? 0,
    };

    // 3. Deactivate the duplicate client
    const now = new Date().toISOString();
    const actionUuid = input.clientUuid || generateClientUuid();

    const updateRes = await safeUpdate(
      'clients' as never,
      duplicateId,
      {
        status: 'Deactivated',
        deactivated_at: now,
        deactivated_by: ctx.userId,
        deactivation_reason: `Merged into ${survivorProfile.record.id}`,
        merged_into_client_id: survivorId,
        updated_at: now,
      } as never,
      actionUuid,
      { returnRow: false }
    );
    if (updateRes?.error) {
      throw new Error(`Failed to deactivate duplicate client: ${String((updateRes.error as { message?: string }).message ?? updateRes.error)}`);
    }

    // 4. Insert audit record in client_merges
    const confirmation = input.typedConfirmation?.trim() || `MERGE ${duplicateProfile.record.id} INTO ${survivorProfile.record.id}`;
    const mergeRow = {
      client_uuid: actionUuid,
      surviving_client_id: survivorId,
      merged_client_id: duplicateId,
      typed_confirmation: confirmation,
      moved_summary: movedSummary,
      created_by: ctx.userId,
    };

    const insertRes = await idempotentInsert('client_merges' as never, mergeRow as never, { returnRow: false });
    if (insertRes?.error) {
      throw new Error(`Failed to log client merge audit record: ${String((insertRes.error as { message?: string }).message ?? insertRes.error)}`);
    }

    // 5. Emit domain event
    const events = [
      {
        type: EVENT_TYPES.CLIENT_MERGED,
        payload: {
          survivorId,
          survivorCode: survivorProfile.record.id,
          duplicateId,
          duplicateCode: duplicateProfile.record.id,
          movedSummary,
          timestamp: now,
          userId: ctx.userId,
        },
      },
    ];

    return {
      result: {
        success: true,
        survivorId,
        duplicateId,
        movedSummary,
      },
      events,
    };
  },
};

export const mergeClients = createAction<MergeClientsInput, MergeClientsResult>(mergeClientsConfig);
</file>

<file path="src/actions/clients/updateClient.ts">
import { createAction, type ActionConfig, type ActionContext } from '../core'
import { EVENT_TYPES } from '../../events/eventBus'
import { safeUpdate, idempotentInsert } from '../../lib/dataAccess'
import type { Database } from '../../types/database'
import { supabase } from '../../lib/supabase'
import { getClientRecord } from '../../lib/queries/clients'
import { isValidLocalPhone, canonicalPhone, PHONE_STORED_RE } from '../../lib/phone'

export type UpdateClientInput = {
  clientId: string
  patch: Record<string, unknown>
  clientUuid?: string | undefined
}

export type UpdateClientResult = {
  success: boolean
  clientId: string
  clientCode?: string | undefined
  changedKeys: string[]
}

const CLIENT_UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i

const FORBIDDEN_KEYS = new Set([
  'id',
  'client_code',
  'client_uuid',
  'created_at',
  'created_by',
  'status',
  'deactivated_at',
  'deactivated_by',
  'deactivation_reason',
  'merged_into_client_id',
  // 0005:162-164 & 0130: Written ONLY by an Approved client_commercial_overrides row.
  'approved_credit_limit',
  'approvedCreditLimit',
  'payment_terms',
  'paymentTerms',
])

export const updateClientConfig: ActionConfig<UpdateClientInput, UpdateClientResult> = {
  name: 'UPDATE_CLIENT',
  permissions: ['client.update'],
  implemented: true,

  validate: (input) => {
    if (!input.clientId || input.clientId.trim() === '') {
      throw new Error('Client ID is required.')
    }
    if (!input.patch || Object.keys(input.patch).length === 0) {
      throw new Error('Nothing to update — the patch is empty.')
    }

    for (const key of Object.keys(input.patch)) {
      if (FORBIDDEN_KEYS.has(key)) {
        throw new Error(`Field '${key}' cannot be modified through updateClient.`)
      }
    }

    if ('phone' in input.patch) {
      const rawPhone = input.patch.phone
      if (rawPhone === null || rawPhone === undefined || String(rawPhone).trim() === '') {
        throw new Error('Phone is required — duplicate detection and merge match on it.')
      }
      const strPhone = String(rawPhone).trim()
      if (!PHONE_STORED_RE.test(strPhone) && !isValidLocalPhone(strPhone)) {
        throw new Error('Must be a 10-digit Nepali mobile starting 97 or 98 — for example 9801234567.')
      }
    }

    if ('pan' in input.patch || 'pan_vat' in input.patch) {
      const rawPan = input.patch.pan ?? input.patch.pan_vat
      if (rawPan !== null && rawPan !== undefined && String(rawPan).trim() !== '') {
        const strPan = String(rawPan).trim()
        if (!/^[0-9]{9}$/.test(strPan)) {
          throw new Error('PAN/VAT must be exactly 9 digits.')
        }
      }
    }
  },

  execute: async (input, ctx: ActionContext) => {
    if (ctx.isOnline === false || (typeof navigator !== 'undefined' && navigator.onLine === false)) {
      throw new Error('This device is offline. Client edits are not queued offline — try again when back online.')
    }

    const rawId = input.clientId.trim()
    let resolvedId = rawId
    let clientCode: string | undefined

    if (CLIENT_UUID_RE.test(rawId)) {
      resolvedId = rawId
      try {
        const profile = await getClientRecord(rawId)
        if (profile) clientCode = profile.record.id
      } catch {
        // Fall back to resolvedId
      }
    } else {
      const profile = await getClientRecord(rawId)
      if (!profile) {
        throw new Error(`No client with identifier '${rawId}' exists, so nothing was changed.`)
      }
      resolvedId = profile.id
      clientCode = profile.record.id
    }

    const patch = input.patch
    const clientPayload: Record<string, unknown> = {}

    if ('name' in patch && patch.name !== undefined) clientPayload.name = String(patch.name).trim()
    if ('phone' in patch && patch.phone !== undefined) {
      const p = String(patch.phone).trim()
      clientPayload.phone = PHONE_STORED_RE.test(p) ? p : canonicalPhone(p)
    }
    if ('email' in patch) clientPayload.email = patch.email ? String(patch.email).trim() : null
    if ('pan' in patch) clientPayload.pan_vat = patch.pan ? String(patch.pan).trim() : null
    if ('pan_vat' in patch) clientPayload.pan_vat = patch.pan_vat ? String(patch.pan_vat).trim() : null
    if ('address' in patch) clientPayload.address_line = patch.address ? String(patch.address).trim() : null
    if ('address_line' in patch) clientPayload.address_line = patch.address_line ? String(patch.address_line).trim() : null
    if ('city' in patch) clientPayload.city = patch.city ? String(patch.city).trim() : null
    if ('district' in patch) clientPayload.district = patch.district ? String(patch.district).trim() : null
    if ('postalCode' in patch) clientPayload.postal_code = patch.postalCode ? String(patch.postalCode).trim() : null
    if ('postal_code' in patch) clientPayload.postal_code = patch.postal_code ? String(patch.postal_code).trim() : null
    if ('country' in patch && patch.country !== undefined) clientPayload.country = String(patch.country).trim()
    if ('businessRegistrationNo' in patch) {
      clientPayload.business_registration = patch.businessRegistrationNo ? String(patch.businessRegistrationNo).trim() : null
    }
    if ('business_registration' in patch) {
      clientPayload.business_registration = patch.business_registration ? String(patch.business_registration).trim() : null
    }
    if ('website' in patch) clientPayload.website = patch.website ? String(patch.website).trim() : null
    if ('billingAddress' in patch) clientPayload.billing_address = patch.billingAddress ? String(patch.billingAddress).trim() : null
    if ('billing_address' in patch) clientPayload.billing_address = patch.billing_address ? String(patch.billing_address).trim() : null
    if ('notes' in patch) clientPayload.notes = patch.notes ? String(patch.notes).trim() : null
    if ('tags' in patch) clientPayload.tags = patch.tags ?? []
    if ('clientType' in patch) clientPayload.type_parent = patch.clientType ?? null
    if ('type_parent' in patch) clientPayload.type_parent = patch.type_parent ?? null
    if ('organisationType' in patch) clientPayload.org_subtype = patch.organisationType ?? null
    if ('org_subtype' in patch) clientPayload.org_subtype = patch.org_subtype ?? null
    if ('portal_default_language' in patch) clientPayload.portal_default_language = patch.portal_default_language
    if ('preferred_contact_channels' in patch) clientPayload.preferred_contact_channels = patch.preferred_contact_channels

    const hasContactFields = 'contact_name' in patch || 'contact_designation' in patch || 'contact_phone' in patch
    if (hasContactFields) {
      const { data: existingContact, error: contactReadErr } = await supabase
        .from('client_contacts')
        .select('id')
        .eq('client_id', resolvedId)
        .eq('is_primary', true)
        .eq('status', 'Active')
        .maybeSingle()

      if (contactReadErr) {
        throw new Error(`Could not read primary contact for client '${resolvedId}': ${contactReadErr.message}`)
      }

      if (existingContact && (existingContact as { id: string }).id) {
        const contactUpdate: Record<string, unknown> = {}
        if ('contact_name' in patch && patch.contact_name !== undefined) {
          contactUpdate.full_name = String(patch.contact_name).trim()
        }
        if ('contact_designation' in patch) {
          contactUpdate.designation = patch.contact_designation ? String(patch.contact_designation).trim() : null
        }
        if ('contact_phone' in patch) {
          contactUpdate.phone = patch.contact_phone ? String(patch.contact_phone).trim() : null
        }
        if (Object.keys(contactUpdate).length > 0) {
          const contactRes = await safeUpdate(
            'client_contacts' as unknown as keyof Database['public']['Tables'],
            (existingContact as { id: string }).id,
            contactUpdate as unknown as Database['public']['Tables']['branches']['Update'],
            input.clientUuid,
          )
          if (contactRes.error) {
            throw new Error(`Failed to update primary contact: ${String((contactRes.error as { message?: string }).message ?? contactRes.error)}`)
          }
        }
      } else if (patch.contact_name && String(patch.contact_name).trim()) {
        const contactIns = await idempotentInsert('client_contacts' as unknown as keyof Database['public']['Tables'], {
          client_id: resolvedId,
          full_name: String(patch.contact_name).trim(),
          designation: patch.contact_designation ? String(patch.contact_designation).trim() : null,
          phone: patch.contact_phone ? String(patch.contact_phone).trim() : null,
          is_primary: true,
          client_uuid: input.clientUuid,
        } as unknown as Database['public']['Tables']['branches']['Insert'])
        if (contactIns.error) {
          throw new Error(`Failed to create primary contact: ${String((contactIns.error as { message?: string }).message ?? contactIns.error)}`)
        }
      }
    }

    if (Object.keys(clientPayload).length > 0) {
      const { data: updatedRow, error } = await safeUpdate(
        'clients' as unknown as keyof Database['public']['Tables'],
        resolvedId,
        clientPayload as unknown as Database['public']['Tables']['branches']['Update'],
        input.clientUuid,
        { returnRow: true, returningColumns: 'id, client_code, name, phone, updated_at' },
      )
      if (error) {
        throw new Error(`Failed to update client: ${String((error as { message?: string }).message ?? error)}`)
      }
      if (!updatedRow) {
        throw new Error(`Update returned no row for client '${resolvedId}'. Nothing was saved.`)
      }
      if ((updatedRow as unknown as { client_code?: string }).client_code) {
        clientCode = (updatedRow as unknown as { client_code: string }).client_code
      }
    }

    const changedKeys = Object.keys(input.patch)
    return {
      result: {
        success: true,
        clientId: resolvedId,
        clientCode,
        changedKeys,
      },
      events: [
        {
          type: EVENT_TYPES.CLIENT_UPDATED,
          payload: {
            clientId: resolvedId,
            clientCode,
            changedKeys,
            timestamp: new Date().toISOString(),
            userId: ctx.userId,
          },
        },
      ],
    }
  },
}

export const updateClient = createAction<UpdateClientInput, UpdateClientResult>(updateClientConfig)
</file>

<file path="src/actions/crew/__tests__/bookCrew.test.ts">
import { beforeEach, describe, expect, it, vi } from 'vitest'
import { bookCrewConfig } from '../bookCrew'
const state = vi.hoisted(() => ({
  booking: { id: '11111111-1111-4111-8111-111111111111', booking_no: 'B-1', pickup_at: '2026-09-13T04:15:00Z', return_at: '2026-09-15T04:15:00Z', stage: 'Booked', cancelled_at: null as string | null, closed_at: null },
  people: [{ id: '22222222-2222-4222-8222-222222222222', crew_code: 'CR-1', primary_role: 'Sound', full_name: 'Crew One', daily_rate: 6500, is_active: true }],
  inserted: [] as Record<string, unknown>[], missingBooking: false, bookingError: false, insertError: false, duplicate: false,
}))
vi.mock('../../../lib/supabase', () => ({
  newClientUuid: () => 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
  supabase: {
    from: (table: string) => {
      let field = ''
      let value: unknown
      let inField = ''
      let inValues: unknown[] = []
      let rowsToInsert: Record<string, unknown>[] = []

      const query: any = {
        select: vi.fn(() => query),
        eq: (key: string, val: unknown) => {
          field = key
          value = val
          return query
        },
        in: (key: string, vals: unknown[]) => {
          inField = key
          inValues = vals
          return query
        },
        insert: (data: Record<string, unknown> | Record<string, unknown>[]) => {
          rowsToInsert = Array.isArray(data) ? data : [data]
          return query
        },
        maybeSingle: async () => {
          if (table === 'bookings') return { data: state.missingBooking ? null : state.booking, error: state.bookingError ? { message: 'Connection failed' } : null }
          if (table === 'crew_profiles_v2_v') return { data: state.people.find((p) => p[field as 'id' | 'crew_code'] === value) ?? null, error: null }
          return { data: state.duplicate ? { ...state.inserted[state.inserted.length - 1], id: 'saved' } : null, error: null }
        },
        single: async () => {
          state.inserted.push(...rowsToInsert)
          return { data: state.insertError || state.duplicate ? null : { id: `saved-${state.inserted.length}` }, error: state.insertError ? { code: '408', message: 'Network failed' } : state.duplicate ? { code: '23505', message: 'duplicate client_uuid' } : null }
        },
        then: (resolve: (val: any) => void, reject?: (err: any) => void) => {
          if (table === 'crew_profiles_v2_v') {
            const matches = state.people.filter((p) => inValues.includes(p[inField as 'id' | 'crew_code']))
            return Promise.resolve({ data: matches, error: null }).then(resolve, reject)
          }
          if (table === 'crew_assignments') {
            if (state.insertError) {
              return Promise.resolve({ data: null, error: { code: '408', message: 'Network failed' } }).then(resolve, reject)
            }
            if (state.duplicate) {
              state.inserted.push(...rowsToInsert)
              return Promise.resolve({ data: null, error: { code: '23505', message: 'duplicate client_uuid' } }).then(resolve, reject)
            }
            state.inserted.push(...rowsToInsert)
            const savedData = rowsToInsert.map((_, i) => ({ id: `saved-${state.inserted.length - rowsToInsert.length + i + 1}` }))
            return Promise.resolve({ data: savedData, error: null }).then(resolve, reject)
          }
          if (table === 'crew_assignments_v') {
            if (state.duplicate) {
              const matched = state.inserted.map((ins) => ({ ...ins, id: 'saved' }))
              return Promise.resolve({ data: matched, error: null }).then(resolve, reject)
            }
            return Promise.resolve({ data: [], error: null }).then(resolve, reject)
          }
          return Promise.resolve({ data: null, error: null }).then(resolve, reject)
        },
      }
      return query
    },
  },
}))
const ctx = { userId: 'operator', role: 'Owner' as const }
const input = () => ({ bookingId: state.booking.id, crewIds: [state.people[0]!.id], clientUuid: 'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb' })
beforeEach(() => { state.inserted = []; state.missingBooking = false; state.bookingError = false; state.insertError = false; state.duplicate = false; state.booking.cancelled_at = null; state.booking.stage = 'Booked'; state.people[0]!.is_active = true })
describe('bookCrew confirmed writes', () => {
  it('saves the chosen booking and person with real default dates and rate', async () => {
    const { result, events } = await bookCrewConfig.execute(input(), ctx)
    expect(result).toEqual({ success: true, count: 1, assignmentIds: ['saved-1'] })
    expect(state.inserted[0]).toMatchObject({ booking_id: state.booking.id, crew_id: state.people[0]!.id, days: 3, daily_rate: 6500, line_total: 19500, call_time: state.booking.pickup_at, client_uuid: input().clientUuid })
    expect(events).toHaveLength(1)
  })
  it('persists supplied role, times, rate, days and notes', async () => {
    await bookCrewConfig.execute({ ...input(), role: 'Audio lead', callTime: '2026-09-13T05:00:00Z', wrapTime: '2026-09-13T10:00:00Z', days: 1, dailyRate: 0, notes: '  Stage A  ' }, ctx)
    expect(state.inserted[0]).toMatchObject({ role_on_shoot: 'Audio lead', days: 1, daily_rate: 0, line_total: 0, notes: 'Stage A', wrap_time: '2026-09-13T10:00:00Z' })
  })
  it('never falls back to another booking when the target is missing', async () => {
    state.missingBooking = true
    await expect(bookCrewConfig.execute(input(), ctx)).rejects.toThrow('not found')
    expect(state.inserted).toHaveLength(0)
  })
  it('propagates booking read failure without writing', async () => {
    state.bookingError = true
    await expect(bookCrewConfig.execute(input(), ctx)).rejects.toThrow('Connection failed')
    expect(state.inserted).toHaveLength(0)
  })
  it.each(['Closed', 'cancelled'])('refuses terminal booking %s', async (stage) => {
    if (stage === 'Closed') state.booking.stage = stage
    else state.booking.cancelled_at = '2026-09-13T00:00:00Z'
    await expect(bookCrewConfig.execute(input(), ctx)).rejects.toThrow('cancelled or closed')
  })
  it('refuses inactive crew', async () => {
    state.people[0]!.is_active = false
    await expect(bookCrewConfig.execute(input(), ctx)).rejects.toThrow('inactive')
    expect(state.inserted).toHaveLength(0)
  })
  it('preflights every crew member before writing a batch', async () => {
    await expect(bookCrewConfig.execute({ ...input(), crewIds: [state.people[0]!.id, 'missing'] }, ctx)).rejects.toThrow('unavailable')
    expect(state.inserted).toHaveLength(0)
  })
  it('does not report a network failure as a saved or queued assignment', async () => {
    state.insertError = true
    await expect(bookCrewConfig.execute(input(), ctx)).rejects.toThrow('not saved')
  })
  it('confirms duplicate requests by reading the existing row', async () => {
    state.duplicate = true
    const { result } = await bookCrewConfig.execute(input(), ctx)
    expect(result.assignmentIds).toEqual(['saved'])
  })
  it('refuses a priced assignment for Coordinator', async () => {
    await expect(bookCrewConfig.execute(input(), { ...ctx, role: 'Coordinator' })).rejects.toThrow('Owner, Admin, or Manager')
    expect(state.inserted).toHaveLength(0)
  })
  it('batches lookups and atomically inserts multiple crew members', async () => {
    state.people.push({
      id: '33333333-3333-4333-8333-333333333333',
      crew_code: 'CR-2',
      primary_role: 'Gaffer',
      full_name: 'Crew Two',
      daily_rate: 8000,
      is_active: true,
    })
    const { result, events } = await bookCrewConfig.execute(
      {
        ...input(),
        crewIds: [state.people[0]!.id, state.people[1]!.id],
      },
      ctx,
    )
    expect(result).toEqual({ success: true, count: 2, assignmentIds: ['saved-1', 'saved-2'] })
    expect(state.inserted).toHaveLength(2)
    expect(state.inserted[0]).toMatchObject({ crew_id: state.people[0]!.id, daily_rate: 6500 })
    expect(state.inserted[1]).toMatchObject({ crew_id: state.people[1]!.id, daily_rate: 8000 })
    expect(events[0]?.payload).toMatchObject({ crewCount: 2 })
  })
  it.each([{ days: 1.5 }, { days: NaN }, { dailyRate: Infinity }, { dailyRate: -1 }, { clientUuid: 'bad-key' }, { bookingId: '' }, { callTime: 'bad date' }, { wrapTime: '2026-09-12T00:00:00Z' }])('refuses invalid input %j', async (override) => {
    await expect(bookCrewConfig.execute({ ...input(), ...override }, ctx)).rejects.toThrow()
    expect(state.inserted).toHaveLength(0)
  })
})
