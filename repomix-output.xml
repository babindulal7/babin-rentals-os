                </thead>
                <tbody>
                  {data?.staffSummaries.slice(0, 5).map((s) => (
                    <tr key={s.userId}>
                      <td style={td}>
                        <div style={{ fontWeight: 600, color: 'var(--text)' }}>{s.name}</div>
                      </td>
