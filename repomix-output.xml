// @vitest-environment jsdom
import { act } from 'react'
import { createRoot } from 'react-dom/client'
import { describe, expect, it, vi } from 'vitest'
import { RentalFinancialRail } from '../RentalFinancialRail'
import type {
  AppliedDiscountBreakdown,
