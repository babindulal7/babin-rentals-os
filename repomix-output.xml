<file path="src/modules/settings/useSettingsLoad.ts">
import { useCallback, useEffect, useState } from 'react'
import { readSettings, languageCodeOf } from '../../lib/settingsStore'
import { hydrateSharedSettings } from '../../lib/settingsSync'
import type { SettingsRecord } from '../../lib/settingsStore'
import { applyLanguage } from '../../lib/i18n'

/**
 * **The settings load — §11.1: *"A settings page must show a loading state —
 * stale settings are wrong settings."***
 *
 * The page used to read the store in a `useState` initialiser and render
 * immediately. That is not a loading state; it is the absence of one, and it
 * quietly assumes the read cannot fail. Two things make it a real boundary:
 *
 *  1. **`readSettings()` can throw.** It touches `window.localStorage`, which
 *     raises `SecurityError` outright when storage is disabled or blocked by a
 *     third-party-cookie policy, and can raise on a corrupt profile. A page
 *     that assumes it succeeded renders the *defaults* while the operator
 *     believes they are looking at their own VAT rate — which is exactly the
 *     "stale settings are wrong settings" failure, in its worst form: silent.
 *  2. **`applyLanguage()` is genuinely asynchronous.** A Nepali session has to
 *     have its catalogue and faces applied before the page paints, or the first
 *     frame is in the wrong language.
 *
 * So the states are three and they are distinct: `loading` renders a skeleton
 * that says what it is waiting for, `error` renders what failed and offers a
 * retry, `ready` renders the page. No timer is involved anywhere — a fake delay
 * would be a fake loading state, which is worse than none.
 */

export type SettingsLoad =
  | { status: 'loading' }
  | { status: 'error'; message: string }
  | { status: 'ready'; settings: SettingsRecord }

export interface SettingsLoadResult {
  load: SettingsLoad
  /** Re-runs the read. Bound to the error state's Retry. */
  reload: () => void
  /** Applies a saved patch to the loaded record without a second read. */
  patch: (p: Partial<SettingsRecord>) => void
}

export function useSettingsLoad(): SettingsLoadResult {
  const [load, setLoad] = useState<SettingsLoad>({ status: 'loading' })
  const [attempt, setAttempt] = useState(0)

  useEffect(() => {
    let live = true
    setLoad({ status: 'loading' })

    void (async () => {
      try {
        const settings = readSettings()
        /* The stored language is applied before the page is declared ready, so
           a Nepali session never paints an English first frame. */
        await applyLanguage(languageCodeOf(settings.language))
        if (live) setLoad({ status: 'ready', settings })
        /* Best-effort and AFTER the first paint: offline, the screen shows what this device had; once the
           shared values arrive they replace it. Never blocks the page on the network. */
        void hydrateSharedSettings()
          .then(() => {
            if (live) setLoad({ status: 'ready', settings: readSettings() })
          })
          .catch(() => undefined)
      } catch (e) {
        if (!live) return
        setLoad({
          status: 'error',
          message:
            e instanceof Error && e.message
              ? e.message
              : 'This browser refused access to its local storage, so the saved settings could not be read.',
        })
      }
    })()

    return () => {
      live = false
    }
  }, [attempt])

  const reload = useCallback(() => setAttempt((a) => a + 1), [])

  const patch = useCallback((p: Partial<SettingsRecord>) => {
    setLoad((l) => (l.status === 'ready' ? { status: 'ready', settings: { ...l.settings, ...p } } : l))
  }, [])

  return { load, reload, patch }
}
</file>

<file path="src/modules/today/AlertsPanel.tsx">
import { Link } from 'react-router-dom'
import Icon from '../../components/ui/Icon'
import { STATUS } from '../../lib/status'
import type { AlertRow } from '../../types/today'
import { cardStyle } from '../../components/ui/Page'
import { PageBody } from '../../components/ui/PageBody'
import { Unavailable } from '../../components/ui/Unavailable'

/**
 * Dashboard.md §8 — priority-sorted.
 *
 * §8: **"every alert carries its own primary action… an alert with no action is
 * a notification, not an alert."** `Dashboard.PNG` draws no button on these
 * rows, and matching the render had left them inert text. **The whole row is the
 * action instead**: it is a `<Link>` to `a.to` carrying `a.action` as its
 * accessible name. That is pixel-identical to the render — no button appears —
 * while every alert is openable and §8 holds.
 *
 * ## Why this no longer filters to Critical
 *
 * ⚠ This panel used to render `CRITICAL_ALERTS` only, and cited exactly one
 * authority for doing so: §5.6's *"the Critical Alerts KPI is 'open alerts at
 * Critical priority only' and 'must equal the Alerts column count'"*. Spec 02
 * §2.1's KPI strip is **Out · In · Overdue · Cash due** — there is no Critical
 * Alerts card left for that invariant to hold against. Keeping the filter would
 * have left it with a dangling justification: the panel would go on hiding every
 * High-priority row (today, the quotes past their stated date) for a reason no
 * longer stated anywhere on the screen.
 *
 * So the filter is gone and **every alert this screen fetched is listed,
 * priority-sorted** — §8's own rule, which never asked for a filter. The
 * card-equals-column half of §5.6 survives in the only form spec 02 leaves room
 * for: `Today.tsx`'s reachable "Alerts" KPI counts the same array it passes
 * here, so the figure and the list cannot drift.
 *
 * ## Where the rows come from now
 *
 * ⛔ This panel used to render `criticalAlertsFor(money)` — six hand-typed rows
 * in `data/today.ts`: a battery three days overdue, a lens needing inspection,
 * invoice #INV-1021 unpaid at Rs 48,000, a missing SmallRig cage, a generator
 * service. Not one had a query behind it, and the money gate was a string sniff
 * (`a.right.startsWith('Rs')`).
 *
 * Every row is now built from a real booking by `overdueAlert` /
 * `quoteLapsedAlert` in `data/today.ts`, off two named filter sets that already
 * existed in `queries/bookings.ts`:
 *
 *   Critical  ← `overdue(businessNowAd())`        — On Rent, due back before now, never returned
 *   High      ← `quotesExpiring(businessNowAd())` — still a Quote, stated date passed
 *
 * **`useCanViewMoney` is gone from this file.** Neither alert carries a rupee
 * figure or a money action, so there is nothing for Law 6 to remove. The five
 * alert kinds that DID need other sources — equipment missing, maintenance due,
 * unpaid invoices, damage findings, inspection jobs — are simply not rendered:
 * `damage_findings` (0003:449), `payments` (0006:176) and the maintenance tables
 * have no list query yet, and an alert nobody can act on is the notification §8
 * says not to draw.
 */
/**
 * §8's order. A `Record` rather than an index lookup, so a fourth priority
 * cannot be added to `AlertRow` without deciding where it sorts.
 */
const PRIORITY_RANK: Record<AlertRow['priority'], number> = { Critical: 0, High: 1, Normal: 2 }

/**
 * §8's order, applied without mutating the caller's array.
 *
 * `Array.prototype.sort` is stable in every engine this ships to, which is the
 * property that matters here: within a priority band the rows keep the order
 * their query returned them in, so Critical rows stay in due-date order rather
 * than being reshuffled by the sort that groups them.
 *
 * Exported so the ordering can be pinned by a test without rendering a router.
 */
export function sortAlerts(alerts: readonly AlertRow[]): AlertRow[] {
  return [...alerts].sort((a, b) => PRIORITY_RANK[a.priority] - PRIORITY_RANK[b.priority])
}

export default function AlertsPanel({
  alerts,
  loading,
  error,
  onRetry,
}: {
  /** Every alert this screen fetched, at any priority, already built from query rows. */
  alerts: AlertRow[]
  loading: boolean
  error: string | null
  onRetry: () => void
}) {
  /* Sorted here rather than by the caller: the order is this panel's rule (§8). */
  const rows = sortAlerts(alerts)
  const critical = rows.filter((a) => a.priority === 'Critical').length

  return (
    <section style={{ ...cardStyle, display: 'flex', flexDirection: 'column', minWidth: 0, height: '100%' }}>
      <div style={{ display: 'flex', alignItems: 'center', padding: '13px 15px', borderBottom: '1px solid var(--border)' }}>
        <h2 style={{ margin: 0, fontSize: 'var(--t-ui)', fontWeight: 700, color: 'var(--text)' }}>Alerts</h2>
        {/* Law 11 — never colour alone. The pill was a bare red number; it now
            carries an icon and states, in its accessible name and beside it,
            how many of the total are Critical. The red is the third signal, not
            the only one. */}
        <span
          style={{
            marginLeft: 'var(--sp-sm)',
            height: 21,
            padding: '0 8px',
            borderRadius: 'var(--r-badge)',
            background: 'var(--st-danger-bg)',
            color: 'var(--st-danger-fg)',
            fontSize: 'var(--t-meta)',
            fontWeight: 700,
            display: 'inline-flex',
            alignItems: 'center',
            gap: 5,
          }}
          aria-label={loading ? 'Alert count loading' : `${rows.length} alerts, ${critical} critical`}
        >
          <Icon name="alert_triangle" size={12} fill />
          {/* Not a count of anything until the query has answered — an
              authoritative "0" over a still-loading list is a wrong figure. */}
          <span className="figure">{loading ? '—' : rows.length}</span>
          {!loading && critical > 0 && (
            <span className="figure" style={{ fontWeight: 600, opacity: 0.85 }}>
              · {critical} critical
            </span>
          )}
        </span>
        <Unavailable reason="Notification Center is not built yet — all active operational alerts are displayed in this panel.">
          <span
            style={{ marginLeft: 'auto', fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--muted)', cursor: 'not-allowed' }}
          >
            View all
          </span>
        </Unavailable>
      </div>

      {/*
        ⛔ This panel had NO empty state at all: an empty list rendered a header,
        a `0` badge and a blank body. Zero alerts is the best state this screen
        can be in and it should say so.
      */}
      <div style={{ flex: 1, ...(loading || error !== null || rows.length === 0 ? { padding: '14px 15px' } : {}) }}>
        <PageBody
          loading={loading}
          error={error}
          hasRows={rows.length > 0}
          onRetry={onRetry}
          empty={!loading && error === null && rows.length === 0}
          noun="alerts"
          skeleton="table"
          skeletonRows={3}
          emptyTitle="Nothing needs attention"
          emptyMessage="No booking is overdue and no quote has passed its stated date."
        >
          {rows.map((a, i) => {
            const c = STATUS[a.statusKey]
            return (
              <Link
                key={a.to + a.title}
                to={a.to}
                aria-label={`${a.action}: ${a.priority} — ${a.title} — ${a.detail}`}
                className="lift"
                style={{
                  display: 'grid',
                  gridTemplateColumns: '34px minmax(0,1fr) auto',
                  gap: 12,
                  padding: '12px 15px',
                  borderBottom: i < rows.length - 1 ? '1px solid var(--border)' : 'none',
                  alignItems: 'center',
                  color: 'inherit',
                  textDecoration: 'none',
                  transition: 'background-color 0.15s ease',
                }}
              >
                <span
                  style={{
                    width: 34,
                    height: 34,
                    borderRadius: 10,
                    background: c.bg,
                    color: c.fg,
                    display: 'grid',
                    placeItems: 'center',
                    flexShrink: 0,
                    boxShadow: 'var(--shadow-sm)',
                  }}
                >
                  <Icon name={a.icon} size={16} fill />
                </span>

                <div style={{ minWidth: 0 }}>
                  <div style={{ display: 'flex', alignItems: 'center', gap: 7, minWidth: 0 }}>
                    <span
                      title={a.title}
                      style={{
                        fontSize: 'var(--t-ui)',
                        fontWeight: 700,
                        color: 'var(--text)',
                        overflow: 'hidden',
                        textOverflow: 'ellipsis',
                        whiteSpace: 'nowrap',
                      }}
                    >
                      {a.title}
                    </span>
                    {/* Law 11 — the priority the list is sorted by is a word on
                        the row, not an inference from the icon's tint. */}
                    <span
                      style={{
                        flexShrink: 0,
                        fontSize: 'var(--t-meta)',
                        fontWeight: 700,
                        letterSpacing: '0.05em',
                        textTransform: 'uppercase',
                        /* --danger-text, not --st-danger-fg. This word sits
                           bare on the row — its sibling branch is --muted, not
                           a fill — and --st-danger-fg is --on-danger = #ffffff
                           in both themes. The CRITICAL label was white on the
                           card, so Law 11's required WORD was missing exactly
                           on the rows that most need it. */
                        color: a.priority === 'Critical' ? 'var(--danger-text)' : 'var(--muted)',
                      }}
                    >
                      {a.priority}
                    </span>
                  </div>
                  <div
                    title={a.detail}
                    style={{
                      marginTop: 2,
                      fontSize: 'var(--t-meta)',
                      color: 'var(--text2)',
                      overflow: 'hidden',
                      textOverflow: 'ellipsis',
                      whiteSpace: 'nowrap',
                    }}
                  >
                    {a.detail}
                  </div>
                </div>

                <span
                  style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: STATUS[a.rightTone].fg, whiteSpace: 'nowrap', paddingTop: 2 }}
                >
                  {a.right}
                </span>
              </Link>
            )
          })}
        </PageBody>
      </div>

      {/*
        ⛔ The "+ N more alerts" footer is gone with the Critical-only filter it
        existed to apologise for: the N it counted was the High-priority rows
        this panel was hiding, and they are now in the list above it. "View all"
        in the header still reaches the full notification history, which is a
        different and larger set.
      */}
    </section>
  )
}
</file>

<file path="src/modules/today/TimelinePanel.tsx">
import { Link } from 'react-router-dom'
import { STATUS, BRAND } from '../../lib/status'
import { clockNowMinutes, timeOf, statusKeyOf, dotTone, type MovementRow } from '../../lib/queries/today'
import { cardStyle } from '../../components/ui/Page'
import { PageBody } from '../../components/ui/PageBody'

/**
 * Dashboard.md §9 — the day's movements on a rail.
 *
 * ## Why this panel is still here after spec 02
 *
 * Spec 02 §2.1 draws four regions — KPI strip, OUTGOING, INCOMING, and a right
 * rail of ALERTS + CALENDAR mini — and no timeline at any of the three widths.
 * It removes nothing in words, and `WIREFRAME_RULINGS_2026-08-12.md` §1 is
 * explicit that **"a panel survives unless a spec removes it in prose"**; §1
 * then names this panel among the two judgement calls it flagged rather than
 * deleted: *"Today's `TimelinePanel` duplicates the calendar card's day list and
 * is drawn in no wireframe. Leave it; raise separately. `Dashboard.md` §9 still
 * asks for it."* So it stays, full-width beneath the arrangement rather than
 * inside either of spec 02's two tracks, and the duplication question is raised
 * rather than answered here.
 *
 * The rows are the *same objects* the Outgoing and Incoming lists render (§4
 * Single Source Rule), merged by `mergeByTime` in `Today.tsx` — one query pair,
 * not a third fetch — so a booking cannot appear here at a different time, with
 * a different package, or at a different stage. The reference render did exactly
 * that: ABC Films' pickup sat at 09:00 AM in the column and 06:00 AM on the
 * timeline, Ready in one and Completed in the other.
 *
 * Statuses are Foundation §01 stages — **not** the six Dashboard.md §9 lists,
 * three of which ("Booked", "Packed", "Returned") are not statuses at all.
 * §9's other rule still holds and is still obeyed: **purple is never used
 * here.** §4.2 bans the hue outright.
 *
 * §9 — "status-coloured dots". The dot reads the *same* source as the badge
 * beside it (the Foundation stage category), so the two cannot disagree; an
 * overdue row is the one override, because being late is a fact about the row
 * that its stage does not carry. `dotTone` lives in `data/today` because the
 * calendar card's day list draws the same dots for the same rows.
 *
 * ⛔ The row used to read `{client} — {kit}`. `kit` was the package name and
 * `bookings` has no column for it; it now reads `bookings.project`, the
 * booking's own title, with an explicit non-value when it is null.
 */

/** §9 is chronological, and a busy day carries more rows than fit. Show the ones around now. */
const WINDOW = 8

export default function TimelinePanel({
  title = "Today's Timeline",
  rows,
  loading,
  error,
  isFiltered,
  filteredByChips,
  onRetry,
  onClearFilters,
  periodLabel,
}: {
  title?: string
  rows: MovementRow[]
  loading: boolean
  error: string | null
  isFiltered: boolean
  /** Chips picked on either list, as opposed to only the period moving —
   *  decides whether the empty state may blame "these filters" (1 Sep #7). */
  filteredByChips: boolean
  onRetry: () => void
  onClearFilters: () => void
  periodLabel: string
}) {
  /* The clock position this render sits at (AR-03). It was a module-scope
     constant built from a day marker, so it was 05:45 all day: the rail opened
     on the first movement after 05:45 and ringed it as "now" at 4pm. Read once
     per render so the window and the ring below cannot disagree with each other. */
  const nowMinutes = clockNowMinutes()
  const first = rows.findIndex((m) => m.at >= nowMinutes)
  const start = Math.max(0, Math.min(first < 0 ? rows.length : first - 2, rows.length - WINDOW))
  const ROWS = rows.slice(start, start + WINDOW)

  return (
    <section style={{ ...cardStyle, minWidth: 0, height: '100%' }}>
      <div style={{ display: 'flex', alignItems: 'center', padding: '13px 15px', borderBottom: '1px solid var(--border)' }}>
        <h2 style={{ margin: 0, fontSize: 'var(--t-ui)', fontWeight: 700, color: 'var(--text)' }}>{title}</h2>
        {/* ⛔ This read `{rows.length === MOVE_TOTAL ? MOVE_TOTAL : rows.length}`
            — both branches the same value, a leftover from the seed era. */}
        <span className="figure" style={{ marginLeft: 'var(--sp-sm)', fontSize: 'var(--t-meta)', color: 'var(--muted)' }}>
          {ROWS.length} of {rows.length}
        </span>
        <Link
          to="/calendar"
          style={{ marginLeft: 'auto', fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--link)', textDecoration: 'none' }}
        >
          View full timeline
        </Link>
      </div>

      <div style={{ padding: '12px 15px 14px', position: 'relative' }}>
        <PageBody
          loading={loading}
          error={error}
          hasRows={rows.length > 0}
          onRetry={onRetry}
          empty={!loading && error === null && rows.length === 0}
          emptyIsFiltered={isFiltered}
          onClearFilters={onClearFilters}
          noun="movements"
          skeleton="table"
          skeletonRows={WINDOW}
          {...(isFiltered && filteredByChips
            ? {} // chips narrowed a list — "match these filters" is true
            : isFiltered
              ? {
                  /* Only the period moved — same honesty rule as MovementList. */
                  emptyTitle: `No movements ${periodLabel}`,
                  emptyMessage: 'Nothing is scheduled in this period.',
                  clearLabel: 'Back to Today',
                }
              : { emptyTitle: `No movements ${periodLabel}`, emptyMessage: 'Nothing is scheduled in this period.' })}
        >
          {ROWS.length > 0 && (
            <span
              aria-hidden
              style={{ position: 'absolute', left: 21, top: 20, bottom: 22, width: 1.5, background: 'var(--border)' }}
            />
          )}

          {ROWS.map((t) => {
            const dot = BRAND[dotTone(t)]
            const st = STATUS[statusKeyOf(t)]
            // The current moment is the first movement not yet passed.
            const current = t.at >= nowMinutes && !ROWS.some((o) => o.at >= nowMinutes && o.at < t.at)
            return (
              <Link
                key={t.id}
                to={`/rentals/${t.bookingNo}`}
                className="lift"
                style={{
                  display: 'grid',
                  gridTemplateColumns: '13px 72px 68px minmax(0,1fr) auto',
                  gap: 10,
                  alignItems: 'center',
                  padding: '6px 8px',
                  borderRadius: 'var(--r-xs)',
                  position: 'relative',
                  textDecoration: 'none',
                  transition: 'background-color 0.15s ease',
                }}
              >
                {/* The current moment is a ring, not a bigger dot — reads at a glance. */}
                <span
                  aria-hidden
                  style={{
                    width: current ? 12 : 9,
                    height: current ? 12 : 9,
                    borderRadius: 'var(--r-badge)',
                    background: current ? 'var(--card)' : dot,
                    border: current ? `3px solid ${dot}` : 'none',
                    justifySelf: 'center',
                    zIndex: 1,
                  }}
                />
                <span className="figure" style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text2)' }}>
                  {timeOf(t)}
                </span>
                <span style={{ fontSize: 'var(--t-meta)', fontWeight: 600, color: 'var(--text)' }}>{t.kind}</span>
                <span
                  style={{
                    fontSize: 'var(--t-meta)',
                    color: 'var(--text2)',
                    overflow: 'hidden',
                    textOverflow: 'ellipsis',
                    whiteSpace: 'nowrap',
                  }}
                >
                  <span aria-hidden style={{ color: 'var(--muted)', marginRight: 7 }}>•</span>
                  {t.client} — {t.project ?? '—'}
                </span>
                <span
                  style={{
                    display: 'inline-flex',
                    alignItems: 'center',
                    height: 21,
                    padding: '0 8px',
                    borderRadius: 'var(--r-badge)',
                    background: st.bg,
                    color: st.fg,
                    fontSize: 'var(--t-meta)',
                    fontWeight: 600,
                    whiteSpace: 'nowrap',
                  }}
                >
                  {t.status}
                </span>
              </Link>
            )
          })}
        </PageBody>
      </div>
    </section>
  )
}
