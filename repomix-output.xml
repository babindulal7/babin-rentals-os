/* ---- scale: identical in both themes ---- */
:root {
  /* radius */
  /* Operational UI: restrained corners, with round badges reserved for counts. */
  --r-btn: 8px;
  --r-card: 10px;
  --r-input: 8px;
  --r-modal: 12px;
  --r-chip: 6px;    /* status blocks */
  --r-badge: 999px; /* numeric count badges ONLY */

  /* §3.3 / §7.3 - the law is the HIT AREA, not the paint. */
  --tap: 44px;
  --row-min-h: 56px;
  --icon-stroke: 1.5;
  --icon-stroke-fill: 2.0;

  /* ══ §4 status blocks — ALL SOLID ═══════════════════════════════════════
     v4.1 killed the solid-vs-outline fill rule: every status is a solid block
     and the word inside carries the meaning (§7.4, never colour alone). Gold
     is the ONLY outline left on screen.

     These st-* names are what lib/status.ts and the screens already read, so
     they are kept and REPOINTED rather than renamed — the rename would have
     touched every call site for no gain. Two of them change meaning, which is
     the whole point of v4.1:
       --st-out-*  was green "solid = out of the warehouse" -> now ORANGE,
                   because On Rent is orange: the gear is with the client.
       --st-in-*   was a soft green wash -> now SOLID green: home & settled.
     ══════════════════════════════════════════════════════════════════════ */
  --st-neutral-bg: var(--neutral);  --st-neutral-fg: var(--on-neutral); --st-neutral-border: color-mix(in srgb, var(--st-neutral-fg) 40%, transparent);  /* Quote, Draft */
  --st-primary-bg: var(--primary);  --st-primary-fg: var(--on-primary); --st-primary-border: color-mix(in srgb, var(--st-primary-fg) 42%, transparent);  /* Booked, Reserved, Issued */
  --st-progress-bg: var(--ready);   --st-progress-fg: var(--on-ready);   --st-progress-border: color-mix(in srgb, var(--st-progress-fg) 45%, transparent); /* Packed, Due Soon, Partial, Cleaning, Maintenance */
  --st-out-bg: var(--warn);         --st-out-fg: var(--on-warn);         --st-out-border: color-mix(in srgb, var(--st-out-fg) 45%, transparent);         /* On Rent, Picked Up — out with the client */
  --st-in-bg: var(--success);       --st-in-fg: var(--on-success);       --st-in-border: color-mix(in srgb, var(--st-in-fg) 42%, transparent);       /* Returned, Available, Paid — home */
  --st-danger-bg: var(--danger);    --st-danger-fg: var(--on-danger);    --st-danger-border: color-mix(in srgb, var(--st-danger-fg) 42%, transparent);    /* Overdue, Damaged, Unpaid, Blocked */
  --st-dim-bg: var(--dim);          --st-dim-fg: var(--on-dim);          --st-dim-border: color-mix(in srgb, var(--st-dim-fg) 38%, transparent);          /* Closed, Void, Retired, Deactivated */

  /* Canonical v4.1 spellings, for code written against the spec directly. */
  --st-ready-bg: var(--ready);      --st-ready-fg: var(--on-ready);
  --st-warn-bg: var(--warn);               --st-warn-fg: var(--on-warn);
  --st-success-bg: var(--success);  --st-success-fg: var(--on-success);
  /* Compact-element radii — chips, tags, icon wrappers: smaller than a full
     button/card/input, so they don't share those tokens. Added after an audit
     found --r-sm's 8px and --r-xs's 6px as the two most common hardcoded
     radius literals with no token (130 and 76 occurrences respectively). */
  --r-sm: 8px;
  --r-xs: 6px;

  /* Inline links take the text-safe primary in both themes. The pre-v4.1 note
     here explained that gold was reserved for the dark primary button — v4.1
     retired gold from every action (§2), so there is nothing left to avoid
     colliding with; links are simply the primary hue. */
  --link: var(--primary-text);

  /* Aliases for a handful of call sites (SubRental.tsx, CasesWorkspace.tsx,
     CasesReports.tsx) that reference --good/--bad/--info directly instead of
     the canonical *-text tokens above. Previously undefined — `color:
     var(--bad)` with no such custom property resolves to the inherited
     colour, silently dropping the red/green/blue signal these screens
     depend on. Aliased rather than migrating every call site, since the
     tokens already carry the right per-theme values. */
  --good: var(--success-text);
  --bad: var(--danger-text);
  --info: var(--primary-text);

  /*
    ---- alias registry, 22 Aug audit ----
    Every remaining token referenced somewhere in src/ but defined nowhere. An
    undefined custom property makes the whole declaration compute to `unset` —
    the colour silently becomes the inherited one, the background becomes
    transparent, the font-size becomes the parent's — so each of these was a
    live rendering bug, not a style preference. Same policy as --good/--bad/
    --info above: alias to the canonical token rather than migrating every
    call site. Each alias resolves per-theme because the token it points at
    does; none of these may gain a literal value later — fix the canonical
    token instead.

    Who reads what:
      --hover       chip/tab/thead washes — PurchaseRequests, StockCheck,
                    BundleItemsTable, BundleSummaryRail, archive/UnifiedInbox
      --bg          recessed panel + in-card input fills — AddBundle,
                    BundleItemsTable, BundleSummaryRail, InventoryTree
      --warn        amber figures/priorities — CasesWorkspace, SubRental,
                    CasesReports (the fourth member of --good/--bad/--info)
      --orange-text PurchaseRequests, archive/SystemMonitor. "Orange" is this
                    theme's warning family; a separate orange is banned (§4.2)
      --danger-bg / --success-bg
                    soft status fills behind status text — BarcodeScannerModal,
                    SystemRestoreModal (no fallback there: the fills were
                    TRANSPARENT), CreateInvoice/RecordPayment/RefundPayment
                    modals. The st-* pairs are the same meaning, already themed
      --text-1/-2/-3, --text3
                    CashFlowReport/WorkingCapitalReport's hyphenated spelling
                    and StaffReports' --text3 for the same three-step ramp
      --fs-meta     CashFlow/WorkingCapital meta lines — the --t-meta step
                    under its px-era name (resolves to rem; scales the same)
      --shadow-sm   Today, AlertsPanel — the smallest elevation that exists
      --on-accent   Finance.tsx ink-on-accent-fill (white in both themes)
      --nav-active-accent-bg
                    BarcodeScannerModal's selected scan-type — the intended
                    token was the nav-active pair's bg half
  */
  --hover: var(--hover-card);
  /*
    Two more of the same, found 1 Sep and confirmed in the running app by
    probing a live element (both resolved to the empty string, so the probe
    inherited body's size/colour instead of the step it asked for):
      --t-caption  AdjustCreditLimitModal ×3, UpgradeTierModal ×2,
                   LogMaintenanceModal ×1 — the caption step under a name the
                   scale never defined (it has --fs-caption and --t-meta). The
                   six labels rendered at inherited BODY size, flattening the
                   label/value hierarchy in all three modals.
      --text-dim   Tools.tsx ×2 — the "Presets:" labels, which lost their
                   muted step and rendered at full text strength.
    Re-declared in the [data-floor]/[data-wall] blocks below for the same
    reason --t-title/--t-base are: a :root-only alias freezes at the un-stepped
    value inside those subtrees.
  */
  --t-caption: var(--t-meta);
  --text-dim: var(--muted);
  /* --bg is a REAL per-theme token in v4.1 (see the palette above), not an
     alias. --warn is likewise real now (v4.1's orange); its six legacy
     caution-text call sites moved to --ready-text first, per spec §11. */
  --orange-text: var(--ready-text);

  /*
    ⚠ REGRESSION FIX, 25 Aug 2026. The v4.1 repaint renamed the yellow hue to
    --ready / --ready-text and DELETED --progress / --progress-text with the
    old palette — but 77 declarations across 28 files still read them. An
    undefined custom property makes the whole declaration compute to `unset`,
    so each of those silently inherited its colour instead of failing: every
    yellow "needs attention" signal in the app (INV_DOT's Packed / Inspection /
    Cleaning / Maintenance, calendar bar styles, purchase-request priorities,
    the warehouse map) rendered as inherited text colour.

    This is the exact failure the "alias registry, 22 Aug audit" block above
    was written to catch, and the repaint reintroduced it. Aliased rather than
    migrating 28 files, for the same reason that registry gives: the alias
    resolves per-theme because the token it points at does.

    --progress IS the v4.1 yellow. It is NOT --warn (orange): "in progress /
    waiting" is the in-house-work meaning, which §2 assigns to yellow.
  */
  --progress: var(--ready);
  --progress-text: var(--ready-text);
  --danger-bg: var(--st-danger-bg);
  --success-bg: var(--st-in-bg);
  --warning-bg: var(--st-progress-bg); /* App.tsx OfflineBanner read this and it never existed */
  --text-1: var(--text);
  --text-2: var(--muted); /* v4.1 §3.1 names this #8B8E96 = --muted */
  --text-3: var(--muted);
  --text3: var(--muted);
  --fs-meta: var(--t-meta);
  --shadow-sm: var(--shadow-card);
  /* Ink on a brand FILL. v4.1 gives every hue its own on-colour (--on-warn,
     --on-ready, …) because yellow and orange cannot carry white; --on-brand is
     the legacy single name for the same idea and is white in both themes, so
     it maps to --on-primary. Kept because five call sites still read it, and
     an undefined custom property computes to `unset` rather than failing
     loudly — it silently inherits, which is how this went unnoticed. */
  --on-brand: var(--on-primary);
  --on-accent: var(--on-brand);
  --nav-active-accent-bg: var(--nav-active-bg);

  /* spacing */
  --sp-xs: 4px;
  --sp-sm: 8px;
  --sp-md: 12px;
  --sp-lg: 16px;
  --sp-xl: 24px;
  --sp-2xl: 32px;
  --sp-3xl: 40px;

  /* type scale */
  --fs-display: 40px;
  --fs-h1: 32px;
  --fs-h2: 28px;
  --fs-h3: 24px;
  --fs-h4: 20px;
  --fs-title: 18px;
  --fs-body: 16px;
  --fs-small: 14px;
  --fs-caption: 12px;

  --dur: 180ms;
  --dur-fast: 120ms;
  --dur-theme: 200ms;
  /* Filter System v1.0 §20 — "slide animation 180–240ms ease-out". The middle of
     the band. The global prefers-reduced-motion block below kills it outright. */
  --dur-drawer: 220ms;

  /* Spring physics & signature silky curves.
     --ease is v4.2 §5's app-wide easing token. It was READ in four places
     (body + .card here, Page.tsx, Card.tsx) before it was ever DEFINED — an
     undefined custom property invalidates the whole transition declaration at
     computed-value time, so all four transitions were silently dead. Same bug
     class as the alias registry below. */
  --ease: cubic-bezier(0.16, 1, 0.3, 1);
  --transition: all 0.2s var(--ease);
  --transition-smooth: all 0.2s var(--ease);
  --transition-fast: all 0.12s var(--ease);
  /* No --ease-spring / --ease-bounce: both had ZERO readers, and §5 rules ONE
     curve app-wide. A bounce curve in particular is exactly what the spec's
     "the curve changes, the numbers do not" language forbids reintroducing. */

  /* The sticky header's own height, so anything that must sit UNDER it stops
     guessing.

     `CollapsibleAside` and `FilterDrawer` both offset by `var(--header-h)`, and
     until this existed both fell back to a hardcoded 64px while `Header.tsx`
     actually measured 59 (10px padding × 2 + a 38px tallest child + its 1px
     border) — so every sticky rail in the app sat 5px lower than the header it
     was clearing. `Header.tsx` sets its own `min-height` FROM this token, so the
     number cannot drift away from the element again. */
  --header-h: var(--global-header-height);
  --shell-nav-w: var(--app-sidebar-width);

  /* ── Canonical structural tokens (UI Consistency Phase 1) ────────────────
     These used to live in ui-v2.css's own :root block, where they sat next to
     a full re-declaration of the palette. The palette now belongs to THIS
     file alone; ui-v2.css carries component/layout rules only. */

  /* Spacing scale (aliased to canonical --sp-* tokens) */
  --space-1: var(--sp-xs);
  --space-2: var(--sp-sm);
  --space-3: var(--sp-md);
  --space-4: var(--sp-lg);
  --space-5: 20px;
  --space-6: var(--sp-xl);
  --space-8: var(--sp-2xl);
  --space-10: var(--sp-3xl);
  --space-12: 48px;
  --space-16: 64px;

  /* Control-height scale. --control-height IS --tap (the 44px law). */
  --control-height: 44px;
  --control-height-lg: 48px;

  /* Page-shell geometry. responsive.css narrows --page-padding below 1280;
     no other file may change either token. */
  --page-padding: clamp(14px, 1.35vw, 18px);
  --section-gap: var(--space-4);

  /* Brand aliases. ui-v2-era rules and a handful of components read --brand;
     it aliases the canonical --primary triple (never a fourth colour). */
  --brand: var(--primary);
  --brand-ink: var(--on-primary);
  --brand-text: var(--primary-text);
}

/* ---- base ---- */
* {
  box-sizing: border-box;
}

/*
  ── `.tap` — the 44px hit area, for controls whose PAINT must stay smaller ──

  DESIGN_DIRECTION_SPEC_v4.1 §5: "Compact 34px visual is allowed in dense
  toolbars ONLY with an invisible pseudo-element extending the hit area to 44 —
  **the law is the HIT AREA, not the paint**." §7.3: "44px hit areas
  everywhere; rows >= 56px."

  Use this when growing the box would wreck a dense layout: a pagination arrow
  in a toolbar strip, a remove glyph inside a chip, a row action in a table
  cell. Where the box CAN grow, prefer `min-height: var(--tap)` — a real 44px
  control is better than a 32px control wearing a 44px coat.

  Three things this gets right that the first attempt did not:

   1. It is NOT behind `@media (pointer: coarse)`. The spec says every device,
      desktop included — a mouse user with a tremor, or a packer using a stylus
      on a docked tablet, needs the same target.
   2. It does NOT set `pointer-events: none`. That was the whole bug in the
      first version: a pseudo-element with pointer-events none is decorative,
      clicks pass through it, and the hit area is not extended at all. Left
      default, the ::after is part of the host's own hit region.
   3. It grows BOTH axes. `width: max(100%, var(--tap))` keeps a control that is
      already wider than 44 at its own width and only inflates the short axis.

  ⚠ Targets closer together than 44px will OVERLAP once both grow, and the one
  later in the DOM wins. That is a spacing problem, not a class problem — space
  the controls, do not silently drop the target.
*/
.tap {
  position: relative;
}
.tap::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: max(100%, var(--tap));
  height: max(100%, var(--tap));
}

/* min-height, not height: a fixed 100% caps the document at one viewport and
   clips anything below the fold instead of scrolling it. */
html,
body,
#root {
  min-height: 100%;
}

/* ── Foundation v2.2 §4.3.8 · reference declaration ────────────────────── */

:root {
  --font-display: 'Outfit', system-ui, sans-serif;
  --font-body: 'Source Sans 3', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --font-mono: 'Source Sans 3', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --font-id: 'Source Sans 3', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --font-num: 'Source Sans 3', system-ui, -apple-system, 'Segoe UI', sans-serif;
  /* Declared, not loaded — §4.3.7 keeps Devanagari off the English path. */
  --font-ne-display: 'Asar', serif;
  --font-ne-body: 'Hind', system-ui, sans-serif;

  /*
    §4.3.6 — **fluid, not fixed.** Every value is `rem`, so the whole scale
    follows the root below and one variable moves the entire application.
    At 1280 / at 1920:
  */
  --t-h1: 2.1rem;    /* 31 / 36 */
  --t-h2: 1.45rem;   /* 22 / 25 */
  --t-h3: 1.2rem;    /* 18 / 20 */
  /* Added 22 Aug: SystemRestoreModal and PricingCalculator were already asking
     for a step between h3 and body — undefined, their font-size computed to
     the inherited size, flattening modal headings into body copy. */
  --t-h4: 1.1rem;    /* 17 / 19 */
  --t-kpi: 1.6rem;   /* 24 / 27 */
  --t-body: 1rem;    /* 15 / 17 */
  --t-ui: 0.93rem;   /* 14 / 16 */
  --t-meta: 0.85rem; /* 13 / 14 */
  --t-th: 0.75rem;   /* 11 / 13 — the floor; nothing renders below it */

  /* Two spellings found in the wild for steps that already exist. Aliased for
     the same reason as the registry above; the canonical names are the ones
     new code should use. Re-declared in the floor/wall blocks below — an
     alias's var() substitutes where the alias is DECLARED, so a :root-only
     alias would freeze at the un-stepped value inside [data-floor]. */
  --t-title: var(--t-h3); /* archive/UnifiedInbox */
  --t-base: var(--t-body); /* auth/HandoverSheet */
}

/* RULINGS-2026-10-07: clearer small text at the shared type scale. Keep rem
   sizing and user scale, but round UI/meta/caption sizes to whole CSS pixels.
   Older browsers keep the existing fractional scale declared above. */
@supports (font-size: round(nearest, 1rem, 1px)) {
  :root {
    --t-ui: round(nearest, 0.93rem, 1px);
    --t-meta: round(nearest, 0.85rem, 1px);
    --t-th: round(nearest, 0.75rem, 1px);
  }
}

/*
  §4.3.6 — the root. 15px at 1280 → 17px at 1920, then it stops: on a wide
  screen a dense operations tool should show *more information*, not bigger
  letters, so the extra width goes to columns.

  Two things make this correct rather than merely clever:
   1. the middle term is `rem + vw`, **never pure `vw`** — pure vw ignores
      browser zoom, so Ctrl+ would do nothing, a WCAG 1.4.4 failure;
   2. the root is **never a fixed px** — `html { font-size: 16px }` would
      override the text size the user chose in their OS or browser.

  `--ui-scale` is §4.3.11's per-user setting, multiplied in here so it is
  additive to browser zoom rather than a replacement for it.
*/
html {
  font-size: calc(clamp(0.9375rem, 0.6875rem + 0.3125vw, 1.0625rem) * var(--ui-scale, 1));
}

html[lang='ne'] {
  /* Devanagari optical x-height parity (+3% scale offset so Hind/Asar glyphs match Latin visual rhythm) */
  font-size: calc(clamp(0.9375rem, 0.6875rem + 0.3125vw, 1.0625rem) * var(--ui-scale, 1) * 1.03);
}

/*
  §4.3.6 — "Floor screens run one step up." Pack, Handover, Return, Reset and
  the Scanner are read at arm's length, often in motion, sometimes one-handed.

  This re-declares the *tokens* rather than setting `--ui-scale`, because
  `--ui-scale` is only read by `html { font-size: … }` and `rem` always resolves
  against the root — setting it on a subtree looks like it works and moves
  nothing. `--ui-scale` stays §4.3.11's per-user control; this is the per-screen
  step, and the two multiply.
*/
[data-floor='true'] {
  --tap: 48px; /* Gloved-hand floor minimum hit target (enhanced from 44px) */
  --floor-step: 1.1;
  --t-h1: calc(2.1rem * var(--floor-step));
  --t-h2: calc(1.45rem * var(--floor-step));
  --t-h3: calc(1.2rem * var(--floor-step));
  --t-h4: calc(1.1rem * var(--floor-step));
  --t-kpi: calc(1.6rem * var(--floor-step));
  --t-body: calc(1rem * var(--floor-step));
  --t-ui: calc(0.93rem * var(--floor-step));
  --t-meta: calc(0.85rem * var(--floor-step));
  --t-th: calc(0.75rem * var(--floor-step));
  /* Aliases re-declared so they substitute the STEPPED values above — a
     custom property's var() resolves where the property is declared, and the
     :root declaration would hand this subtree the un-stepped h3/body. */
  --t-title: var(--t-h3);
  --t-base: var(--t-body);
  --t-caption: var(--t-meta);
  font-size: var(--t-body);
}

/* DEVICES.md §7 build order item 6 — the wall display, read across a room
   rather than held in a hand. Same re-declare-at-the-root trick as
   [data-floor='true'] above (rem always resolves against the document root,
   not a scoped ancestor), at DEVICES.md's own named 1.4x. */
[data-wall='true'] {
  --wall-step: 1.4;
  --t-h1: calc(2.1rem * var(--wall-step));
  --t-h2: calc(1.45rem * var(--wall-step));
  --t-h3: calc(1.2rem * var(--wall-step));
  --t-h4: calc(1.1rem * var(--wall-step));
  --t-kpi: calc(1.6rem * var(--wall-step));
  --t-body: calc(1rem * var(--wall-step));
  --t-ui: calc(0.93rem * var(--wall-step));
  --t-meta: calc(0.85rem * var(--wall-step));
  --t-th: calc(0.75rem * var(--wall-step));
  /* Same re-declaration as [data-floor] — see the note there. */
  --t-title: var(--t-h3);
  --t-base: var(--t-body);
  --t-caption: var(--t-meta);
  font-size: var(--t-body);
}

body {
  margin: 0;
  background-color: var(--app);
  background-image: none;
  background-attachment: fixed;
  color: var(--text);
  font-family: var(--font-body);
  font-size: var(--t-body);
  font-weight: 500;
  line-height: 1.5;
  /* Native rasterization, real font weight outlines; italic remains available.
     Smoothing switches are platform-specific, not a Windows sharpness filter. */
  -webkit-font-smoothing: auto;
  -moz-osx-font-smoothing: auto;
  font-synthesis: style;
  /*
    NO transition here, deliberately — measured 1 Sep, not assumed.

    This line used to read `transition: background … var(--ease), color …`, and
    it did nothing at all while `--ease` was undefined: an unresolvable var()
    makes the shorthand invalid at computed-value time, so the longhands fell
    back to their initial `0s`. Defining `--ease` (v4.2 §5) would have switched
    it on for the first time, and switching it on is what exposed the mismatch:

     · `background` here is a linear-gradient set through the shorthand.
       background-image does not interpolate — measured on the theme toggle, it
       jumps from cream to navy on the very first frame.
     · `color` DOES interpolate, over 200ms.

    So the pair guarantees a disagreement: the canvas lands instantly on the new
    theme while the body's ink is still crossing to it. Toggling to dark, that
    is ~200ms of near-black text arriving on an already-navy canvas. In dev the
    same edge fires on cold load (Vite injects CSS after first paint, so the
    style change is a real transition start) — body ink was caught frozen at
    black over the navy canvas, which is the unreadable end of the same bug.

    Surfaces keep their own transitions (.card, the sidebar, buttons), so the
    toggle still eases where easing is actually possible. The canvas and the ink
    on it now change together, in one frame.
  */
}

/* Bordered card variant for dense lists / tables where separation is needed */
.card--bordered {
  border: 1.5px solid var(--border);
}

/* DESIGN_DIRECTION_SPEC v4.2 §4 & §6 Card Glass & Layered Elevation */
.card {
  background: var(--surface-card);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  box-shadow: var(--shadow-card);
  /* Border removed per design audit: cards use background color for elevation */
  border: none;
  border-radius: var(--r-card);
  transition: box-shadow var(--dur) var(--ease), background-color var(--dur) var(--ease), border-color var(--dur) var(--ease);
}

@media (hover: hover) and (pointer: fine) {
  .card.interactive:hover,
  .card[data-interactive='true']:hover {
    box-shadow: var(--shadow-lg);
  }
  .card--bordered.interactive:hover,
  .card--bordered[data-interactive='true']:hover {
    box-shadow: var(--shadow-lg);
  }
}

/* Tables stay solid per DESIGN_DIRECTION_SPEC v4.2 §4 */
table,
.table-container {
  background: var(--surface);
  backdrop-filter: none !important;
}

/* ── v4.2 §4 — glass kill-switches ───────────────────────────────────────────
   `prefers-reduced-transparency` and `prefers-contrast: more` → fully opaque,
   and `[data-floor]` keeps its kill-switch until card glass is measured on the
   real warehouse tablet (200-row packing list) — the spec commits glass on
   floor screens only after that measurement.

   Two halves, because glass is two properties:
   · the TOKENS go opaque — components paint with var(--card)/var(--surface-card)
     inline, so repointing the tokens at the solid surface colours reaches every
     card without touching a component. The triple selector matches the
     specificity of `:root[data-theme='dark']` so the dark rgba values cannot
     win the cascade over this override.
   · the BLUR dies with `!important` on *, which also beats the inline
     `backdropFilter` styles in Card.tsx/Page.tsx/Toast.tsx/Select.tsx. */
@media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
  :root,
  :root[data-theme='light'],
  :root[data-theme='dark'] {
    --surface-card: var(--surface);
    --surface-card-hover: var(--surface-2);
    --card: var(--surface);
    --sidebar: var(--surface);
  }
  * {
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }
}

/* CARDS only, and that is the whole scope §4 asks for: "measure a 200-row
   packing list … before committing CARD glass on floor screens". Chrome is an
   unconditional glass surface in §4, so it is deliberately NOT killed here.

   ⚠ It could not be killed from here anyway: `data-floor` is stamped on
   `<main>` (App.tsx), and the three readers of `--sidebar` — Header, BottomBar,
   Sidebar — are all mounted OUTSIDE `<main>` as siblings in the shell row.
   Custom properties only reach descendants, so a `--sidebar` override in this
   block is dead code that reads like a guarantee. Verified in the running app:
   `main.contains(header)` and `main.contains(aside)` are both false, while
   cards are inside. Do not add `--sidebar` back without ALSO moving the
   attribute — and moving it to :root would drag the [data-floor] type-scale
   step onto the chrome too, which is a different (and unruled) change. */
[data-floor='true'] {
  --surface-card: var(--surface);
  --surface-card-hover: var(--surface-2);
  --card: var(--surface);
  --tap: 48px;
  /* Anti-glare contrast for industrial warehouse floor surfaces */
  letter-spacing: 0.01em;
}
[data-floor='true'] * {
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

/* Floor hit-targets & glove-friendly ergonomics */
[data-floor='true'] button:not(.btn-link):not([data-compact]),
[data-floor='true'] .tap:not([data-compact]),
[data-floor='true'] select,
[data-floor='true'] input[type='text'],
[data-floor='true'] input[type='search'] {
  min-height: 48px !important;
}

/* Match the specificity of the general button floor above so primary verbs
   keep their 56px minimum rather than being reduced to 48px. */
[data-floor='true'] button[data-primary-verb]:not(.btn-link),
[data-floor='true'] button.btn-floor-primary:not(.btn-link),
[data-floor='true'] .btn-floor-primary {
  min-height: 56px !important;
}

[data-floor='true'] input[type='checkbox'] {
  min-width: 22px;
  min-height: 22px;
  cursor: pointer;
}

[data-floor='true'] .serial,
[data-floor='true'] .identifier,
[data-floor='true'] [data-serial] {
  font-family: var(--font-id);
  font-weight: 700;
  letter-spacing: 0.03em;
}

/* §4.3.2 — Outfit carries the brand voice, never body copy. */
h1,
h2,
h3,
.title,
.card-title {
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: -0.02em;
  text-wrap: balance;
}

/* §4.3.2 — tabular-nums for numeric columns and figures */
.kpi-value {
  font-family: var(--font-num, var(--font-id));
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

/*
  §4.3.4 — identifiers & numbers: serials, booking IDs, QR payloads, PAN.
  Source Sans 3 with tabular figures gives a clean, modern look while aligning numbers perfectly.
*/
.identifier,
.serial,
.booking-id {
  font-family: var(--font-id);
  font-variant-numeric: tabular-nums;
}

/*
  §4.3.1 — figures, money, counts, percentages, and times.
*/
.figure,
td,
.money {
  font-family: var(--font-num, var(--font-id));
  font-variant-numeric: tabular-nums;
}

/* RULING 2026-10-15: an amount is one token — "Rs 74,940.75" never breaks
   after "Rs" in a narrow column. Opt-in class, not `.figure`, which also
   wraps names and badges in some tables. */
.money {
  white-space: nowrap;
}

/* §4.3.6 — KPI values and prominent figures */
.kpi-value,
.figure-lg {
  font-family: var(--font-num, var(--font-id));
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

/* ── §4.3.5 · Nepali ───────────────────────────────────────────────────── */

:root[lang='ne'] body,
:root[lang='ne'] td,
:root[lang='ne'] th,
:root[lang='ne'] button,
:root[lang='ne'] label {
  font-family: var(--font-ne-body);
  /* Devanagari matras need the vertical room (§4.3.6). */
  line-height: 1.6;
}

/*
  §4.3.5 point 1 — **never bold Asar.** It ships in one weight; a component
  asking for 600 makes the browser synthesise a fake bold, which smears
  Devanagari conjuncts. Nepali hierarchy comes from size alone.
*/
:root[lang='ne'] h1,
:root[lang='ne'] h2,
:root[lang='ne'] h3,
:root[lang='ne'] .title,
:root[lang='ne'] .kpi-value {
  font-family: var(--font-ne-display);
  font-weight: 400;
}

/* Focus ring 2px, theme-aware — matches the input focus colour. */
:where(a, button, input, select, textarea, [tabindex]):focus-visible {
  outline: 2px solid var(--input-focus);
  outline-offset: 2px;
}

/* ── .focus-host — the ring for an input that lives inside a bordered box ─────
   Added 25 Aug 2026.

   THE BUG THIS CLOSES

   A pattern repeats across ~14 screens: a bordered container holding a bare
   input, where the input carries `border: 'none', outline: 'none'` inline so the
   CONTAINER draws the boundary. The intent is right; the effect is that those
   controls have no focus indicator at all.

   The rule above cannot save them, twice over. `:where()` has zero specificity
   by definition, and an inline style outranks any stylesheet rule regardless —
   so `style={{ outline: 'none' }}` wins permanently. A keyboard operator tabbing
   into the command palette, a workspace note field, or a queue filter gets no
   indication of where they are.

   WHY :focus-within ON THE HOST RATHER THAN DELETING THE INLINE outline

   Deleting `outline: 'none'` does restore a ring, but it draws it around the
   INPUT, inside the container that is already drawing a border — two nested
   outlines, the inner one clipped by the padding. Ringing the host is what the
   design intends: the box IS the control as far as the operator is concerned.

   Applied by adding `className="focus-host"` to the container. The input keeps
   its inline `outline: 'none'`, which is now correct rather than harmful — it
   stops the double ring.

   `:focus-within` is not `:focus-visible`, so this also lights up on a mouse
   click into the field. That is deliberate: these are search and note fields on
   a warehouse tablet, where "which box am I typing into" is worth showing
   whatever put the caret there. */
.focus-host:focus-within {
  outline: 2px solid var(--input-focus);
  outline-offset: 2px;
}

/*
  The movement row's geometry lives here rather than inline, because the
  breakpoint below has to be able to win — an inline grid-template-columns
  beats any stylesheet rule that isn't !important.
  62px, not 56: "09:00 AM" needs 58px at 11.5px mono, and §6 keeps the time on
  one line.
*/
.movement-row {
  display: grid;
  grid-template-columns: 62px 34px minmax(0, 1fr) auto;
}
.row-avatar {
  display: grid;
}

/*
  §2 targets 1920px. Below roughly 1560 the three columns get narrow enough
  that the client name and the package start clipping, and the first things
  worth losing are the two that carry no information the row doesn't repeat:
  the decorative avatar, and the *label* on Open Booking — the icon and its
  aria-label survive, so the primary action never disappears.
*/
/*
   DOCUMENTED COMPONENT-LEVEL EXCEPTION (UI Consistency Phase 1): 1560px is a
   movement-row density collapse, not a layout band — everything at 768/1280
   is handled in responsive.css. Do not add more thresholds like this.
*/
@media (max-width: 1560px) {
  .movement-row {
    grid-template-columns: 58px minmax(0, 1fr) auto;
  }
  .row-avatar,
  .row-open-label {
    display: none;
  }
}

/* ── Tactile Interactive Transitions & Click Compression ──
   Feedback is colour/brightness only — never a translate or scale, so a
   pressed button cannot push its neighbours or read as "moving". */
button,
a.btn,
[role="button"],
input[type="button"],
input[type="submit"] {
  font-family: inherit;
  cursor: pointer;
  transition: background-color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease), filter var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
}

button:active:not(:disabled),
.press:active:not(:disabled),
a.btn:active,
[role="button"]:active:not([aria-disabled="true"]) {
  filter: brightness(0.96);
}

button:hover,
button:active,
a.btn:hover,
a.btn:active,
[role="button"]:hover,
[role="button"]:active,
.ui-button:hover,
.ui-button:active {
  transform: none;
}

/* ── Smooth Form Inputs with Glow Focus Rings ── */
input:not([type="checkbox"]):not([type="radio"]),
select,
textarea {
  transition: border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease;
}
input:not([type="checkbox"]):not([type="radio"]):focus,
select:focus,
textarea:focus {
  outline: none;
  border-color: var(--primary) !important;
  box-shadow: 0 0 0 3px rgba(56, 106, 247, 0.22) !important;
}

/* ── Glassmorphism Utility ── */
.glass {
  background: var(--surface) !important;
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1.5px solid var(--border);
}

/* ── Card Levitation & Micro-Elevation ──
   Hover feedback is shadow/border only — a card that lifts with translateY
   moves every sibling below it, which reads as page jitter. */
.card,
section[id] {
  transition: box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, background-color 0.2s ease;
}

.lift {
  transition: box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, background-color 0.2s ease;
}
.lift:hover,
.card-interactive:hover {
  box-shadow: var(--shadow-lg);
  border-color: var(--lift-accent, var(--border2));
}

.press {
  transition: filter 0.12s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.12s ease;
}
.press:active:not(:disabled) {
  filter: brightness(0.96);
}

@media (prefers-reduced-motion: reduce) {
  *,
  .lift,
  .card,
  button,
  .press {
    transition: none !important;
    animation: none !important;
  }
  .lift:hover,
  .card-interactive:hover {
    transform: none;
  }
  .press:active,
  button:active {
    transform: none;
  }
}

/* ── Sleek, Clean Native-Feel Scrollbars ── */
* {
  scrollbar-width: thin;
  scrollbar-color: var(--border2) transparent;
}
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: var(--border2);
  border-radius: 999px;
  transition: background-color 0.2s ease;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--muted);
}
::-webkit-scrollbar-corner {
  background: transparent;
}

/* ── lazy-load spinner ──────────────────────────────────────────────────── */
@keyframes spin { to { transform: rotate(360deg) } }

/* ── v4.2 §5 — the four Miraz keyframes, ported on OUR duration scale ───────
   The frames carry no timing; call sites use --dur/--dur-fast with var(--ease)
   (120–240ms — Miraz's 200–250ms numbers are NOT adopted, only the curve).
   `transform`/`opacity` only, so none of them lay the page out mid-flight.
   The global prefers-reduced-motion block kills all four. */
@keyframes fadeIn { from { opacity: 0 } to { opacity: 1 } }
@keyframes slideUp { from { opacity: 0; transform: translateY(12px) } to { opacity: 1; transform: none } }
@keyframes toastIn { from { opacity: 0; transform: translateY(12px) scale(0.96) } to { opacity: 1; transform: none } }
@keyframes pop { 0% { transform: scale(0.96) } 60% { transform: scale(1.02) } 100% { transform: scale(1) } }

/* ── loading-skeleton blocks (StateViews.tsx) ─────────────────────────────── */
@keyframes pulse { 0%, 100% { opacity: 1 } 50% { opacity: 0.5 } }

/* ── filter drawer (FilterDrawer.tsx) · §20 ───────────────────────────────────
   Four keyframes rather than one, because the panel arrives from a different
   edge on each of the three cases it has: the left rail, the right rail, and
   the phone sheet that comes up from the bottom.

   `transform` only — animating `left`/`right` would lay the page out again on
   every frame of a 200ms slide, on a screen already re-querying live.

   The prefers-reduced-motion block above sets `animation: none !important`
   globally, so all four are already opted out for anyone who asked. The panel's
   unmount is on a TIMER rather than `animationend` for exactly that reason: with
   the animation suppressed the event never fires, and a drawer waiting for it
   would never close. */
@keyframes drawer-in-left { from { transform: translateX(-100%) } to { transform: none } }
@keyframes drawer-in-right { from { transform: translateX(100%) } to { transform: none } }
@keyframes drawer-in-up { from { transform: translateY(100%) } to { transform: none } }
@keyframes drawer-out-left { from { transform: none } to { transform: translateX(-100%) } }
@keyframes drawer-out-right { from { transform: none } to { transform: translateX(100%) } }
@keyframes drawer-out-down { from { transform: none } to { transform: translateY(100%) } }
@keyframes scrim-in { from { opacity: 0 } to { opacity: 1 } }
@keyframes scrim-out { from { opacity: 1 } to { opacity: 0 } }

/* ── PIN pad rejection (PinPad.tsx) ───────────────────────────────────────────
   A rejected entry has to be perceivable, and the dots are the only thing on
   the lock screen that can carry it. `transform` only — the dots sit in a flex
   row and animating position would relayout on every frame.

   The prefers-reduced-motion block above sets `animation: none !important`
   globally, so this is already opted out for anyone who asked; the danger
   fill/border PinPad sets from React state is what remains, and that is the
   half that must not be motion-dependent. The `invalid` flag is cleared by a
   TIMER, not `animationend` — under reduced motion that event never fires and
   the pad would stay red forever (the lesson from the filter drawer above). */
@keyframes pinpad-shake {
  0%, 100% { transform: translateX(0) }
  20%      { transform: translateX(-6px) }
  40%      { transform: translateX(6px) }
  60%      { transform: translateX(-4px) }
  80%      { transform: translateX(4px) }
}
.pinpad-invalid { animation: pinpad-shake 200ms ease-in-out }

/* ============================================================================
   OPERATIONS UI PRIMITIVES — shared modernization layer

   These selectors deliberately sit on the small shared component surface
   (Page, Card, Button and Table). They improve the whole product without
   repainting individual workflow screens or changing their business logic.
   ========================================================================== */

h1,
h2,
h3 {
  text-wrap: balance;
}

p {
  text-wrap: pretty;
}

.page-header {
  width: 100%;
  max-width: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-3);
  padding-bottom: 2px;
}

.page-header__description {
  max-width: 65ch;
  line-height: 1.55;
}

.page-header__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--sp-sm);
  margin-left: auto;
  align-self: flex-start;
  flex-shrink: 0;
}

/* Cards must not clip or isolate the dropdowns rendered inside them. */
.surface-card__header {
  background: color-mix(in srgb, var(--surface-card) 76%, transparent);
}

.ui-button {
  -webkit-tap-highlight-color: transparent;
  border-width: 1.5px;
}

/* Persistent creation action in desktop and tablet sidebar (light/dark blue,
   high-contrast yellow by its own accessibility palette). No extra nav row. */
.app-navigation .app-nav__new-rental {
  background: var(--btn-primary-bg);
  color: var(--btn-primary-fg);
  border: 1.5px solid transparent;
  box-shadow: var(--shadow-xs);
}

.app-navigation .app-nav__new-rental:hover {
  background: var(--hover-button);
  color: var(--btn-primary-fg);
}

.app-navigation .app-nav__new-rental:focus-visible {
  outline: 2px solid var(--input-border-focus, var(--input-focus));
  outline-offset: 2px;
}

@media (hover: hover) and (pointer: fine) {
  .ui-button:hover:not(:disabled) {
    filter: brightness(1.06);
  }

  .ui-button--primary:hover:not(:disabled) {
    box-shadow: var(--shadow-primary-glow);
  }

  .ui-button--secondary:hover:not(:disabled),
  .ui-button--outline:hover:not(:disabled),
  .ui-button--ghost:hover:not(:disabled) {
    background: var(--hover-card) !important;
  }
}

.ui-button:disabled {
  filter: none;
  transform: none;
}

.kpi-card[role='button'] {
  outline: none;
}

.kpi-card[role='button']:focus-visible {
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--input-focus) 28%, transparent), var(--shadow-card);
}

.data-table-shell {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-inline: contain;
  background: var(--surface) !important;
  border: 1.5px solid var(--border);
  border-radius: var(--r-card);
}

.data-table {
  min-width: 100%;
  background: var(--surface);
}

.data-table__head {
  text-transform: none !important;
  letter-spacing: 0.015em !important;
}

.data-table__head th {
  padding-block: 0 !important;
}

.data-table__head th > span {
  display: inline-flex;
  min-height: var(--tap);
  align-items: center;
}

.data-table__sort {
  display: inline-flex;
  min-height: var(--tap);
  align-items: center;
  gap: 6px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--r-xs);
  background: transparent;
  color: inherit;
  font: inherit;
  font-weight: 600;
  letter-spacing: inherit;
  text-align: inherit;
}

.data-table__sort:hover {
  color: var(--text);
}

.data-table__row td {
  height: var(--row-min-h);
}

.data-table__row:nth-child(even) {
  background: color-mix(in srgb, var(--surface) 97%, var(--primary));
}

.data-table__row--interactive:hover,
.data-table__row--interactive:focus-visible {
  background: var(--hover-row) !important;
}

.data-table__row--interactive:focus-visible {
  outline: 2px solid var(--input-focus);
  outline-offset: -2px;
}

.data-table__skeleton {
  position: relative;
  overflow: hidden;
  background: var(--surface-2) !important;
}

.data-table__skeleton::after {
  content: '';
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--text) 8%, transparent), transparent);
  animation: table-skeleton-sheen 1.4s var(--ease) infinite;
}

@keyframes table-skeleton-sheen {
  to { transform: translateX(100%); }
}

/* Shared by bespoke live tables and the generic Table component. Keep row
   status/selection backgrounds owned by each workflow. */
.operations-table > tbody > tr > td {
  height: var(--row-min-h);
}
.operations-table > tbody > tr:focus-within {
  outline: 2px solid var(--input-focus);
  outline-offset: -2px;
}
.operations-table > thead > tr > th {
  text-transform: none;
  letter-spacing: 0.015em;
}

@media (prefers-reduced-motion: reduce) {
  .ui-button:hover:not(:disabled),
  .ui-button:active:not(:disabled) {
    transform: none;
  }
  .data-table__skeleton::after {
    animation: none;
    transform: none;
  }
}

/* ── RULING 2026-10-13 — "Glass" theme: the Obsidian Glass hybrid ───────────
   Babin chose (13 Oct, option A): Obsidian Glass chrome + cards, Black Titanium
   solid tables/inputs, blue as the ONLY accent. Status hues are untouched —
   every --st-* / --success / --warn / --danger value is inherited from the
   dark block above, so this layer cannot change what a status means.

   It is a STYLE LAYER on the dark theme, not a fourth palette: lib/theme.tsx
   resolves mode 'glass' to data-theme='dark' and stamps data-style='glass', so
   every `theme === 'dark'` branch in the app still holds.

   Kept from v4.2 §4: tint floor 0.85 (text over a moving backdrop must stay
   verifiable at 4.5:1), tables solid, [data-floor] kill-switch (it redefines
   --card/--surface-card on <main> and so still wins on floor screens), and the
   reduced-transparency / more-contrast kill-switch (re-declared below because
   this selector out-ranks the one in that block).

   Revert = delete from this comment to the end of the file, and the 'glass'
   additions in lib/theme.tsx, index.html, Settings.tsx, sections/shared.tsx
   and Sidebar.tsx.

   13 Oct, later: Glass is now a FINISH on either base — Light + Glass is the
   frosted twin below. `check:contrast` gates both by compositing. */
:root[data-theme='dark'][data-style='glass'] {
  --app: #05080e;
  --bg: #05080e;
  --bg0: #030509;

  /* Black Titanium — the SOLID surfaces (tables, inputs, menus) */
  --surface: #121722;
  --surface-2: #181f2c;
  --inset: #0c1018;
  --inset2: #10151f;
  --modal: #131924;
  --dropdown: #131924;

  /* Obsidian Glass — translucent cards and chrome, floor 0.85 */
  --glass-tint: 0.85;
  --card: rgba(18, 24, 36, 0.85);
  --card2: rgba(26, 33, 48, 0.85);
  --surface-card: rgba(18, 24, 36, 0.85);
  --surface-card-hover: rgba(26, 33, 48, 0.88);
  --sidebar: rgba(8, 12, 19, 0.85);

  --border: rgba(255, 255, 255, 0.12);
  --specular-rim: 0 1px 0 rgba(255, 255, 255, 0.07) inset;
  --shadow-card: 0 1px 0 rgba(255, 255, 255, 0.06) inset, 0 12px 32px rgba(0, 0, 0, 0.42);
}

/* ── RULING 2026-10-13 — Glass on Light ("frosted") ─────────────────────────
   The same finish on the light base (mode 'glass-light' → data-theme='light' +
   data-style='glass'). Porcelain solid surfaces are simply Light's own — tables,
   inputs and menus stay #fff, so nothing is redeclared for them. Frosted white
   cards and chrome at the same 0.85 floor; status hues, primary and the orange
   booking-date ink are inherited from the light block unchanged.

   On a light canvas a glow DARKENS what sits on it (the opposite of Obsidian),
   so the blue is kept faint enough that muted text on the bare canvas still
   clears 4.5:1. `check:contrast` composites every layer and fails the gate if
   it does not. The white bloom only lightens, so it cannot cost contrast.
   Revert = delete this palette and its body rule, and 'glass-light' in
   lib/theme.tsx and index.html. */
:root[data-theme='light'][data-style='glass'] {
  --app: #e4ebf5;
  --bg: #e4ebf5;
  --bg0: #dae3ef;

  --glass-tint: 0.85;
  --card: rgba(255, 255, 255, 0.85);
  --card2: rgba(237, 243, 250, 0.85);
  --surface-card: rgba(255, 255, 255, 0.85);
  --surface-card-hover: rgba(238, 244, 251, 0.9);
  --sidebar: rgba(255, 255, 255, 0.85);

  --specular-rim: 0 1px 0 rgba(255, 255, 255, 0.9) inset;
  --shadow-card: 0 1px 0 rgba(255, 255, 255, 0.85) inset, 0 10px 28px rgba(15, 23, 42, 0.09);
}

/* The glow the glass refracts. Blue only — no violet, no amber (13 Oct: amber
   would read as the orange On Rent / yellow Packed status). Fixed so it does
   not scroll with long lists. */
:root[data-theme='dark'][data-style='glass'] body {
  background-image:
    radial-gradient(110% 85% at 68% -12%, rgba(47, 125, 255, 0.40), transparent 62%),
    radial-gradient(95% 90% at 8% 112%, rgba(47, 125, 255, 0.32), transparent 64%),
    radial-gradient(55% 60% at 100% 75%, rgba(96, 120, 170, 0.18), transparent 65%);
  background-attachment: fixed;
}
:root[data-theme='light'][data-style='glass'] body {
  background-image:
    radial-gradient(110% 85% at 68% -12%, rgba(108, 155, 255, 0.18), transparent 62%),
    radial-gradient(95% 90% at 8% 112%, rgba(108, 155, 255, 0.16), transparent 64%),
    radial-gradient(60% 60% at 100% 72%, rgba(255, 255, 255, 0.75), transparent 65%);
  background-attachment: fixed;
}

/* Everything below is the finish itself, shared by both bases. */

/* Chrome: the sidebar is the one shell surface with no blur of its own. */
:root[data-style='glass'] .app-navigation {
  backdrop-filter: blur(20px) saturate(140%);
  -webkit-backdrop-filter: blur(20px) saturate(140%);
}

/* Cards pick up the hairline rim the glass needs to read as an edge. --w08 is
   white on dark and slate on light, so the one rule fits both. */
:root[data-style='glass'] .card {
  border: 1.5px solid var(--w12);
  backdrop-filter: blur(20px) saturate(140%);
  -webkit-backdrop-filter: blur(20px) saturate(140%);
}

/* Floating layers (menus, listboxes, popovers, dialogs, tooltips) paint with
   the same translucent var(--card) as panels, but they sit OVER text, so
   without blur the page reads through them (13 Oct bug: Today's "24 coming
   back" showed through the More menu). Blur makes them true glass. Selected by
   role so no component changes; the kill-switches below still remove it. */
:root[data-style='glass'] :is([role='menu'], [role='listbox'], [role='dialog'], [role='alertdialog'], [role='tooltip'], .global-add-menu) {
  backdrop-filter: blur(24px) saturate(140%);
  -webkit-backdrop-filter: blur(24px) saturate(140%);
}

@media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
  :root[data-theme='dark'][data-style='glass'],
  :root[data-theme='light'][data-style='glass'] {
    --card: var(--surface);
    --card2: var(--surface-2);
    --surface-card: var(--surface);
    --surface-card-hover: var(--surface-2);
    --sidebar: var(--surface);
  }
  /* Theme-scoped on purpose: a bare :root[data-style='glass'] body would lose
     to the two glow rules above on specificity and leave the glow on. */
  :root[data-theme='dark'][data-style='glass'] body,
  :root[data-theme='light'][data-style='glass'] body {
    background-image: none;
  }
}
</file>

