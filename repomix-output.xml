import { supabase } from '../supabase'
import { rupees, type Paisa } from '../money'
import { rowsOf, type ReportFilterOptions } from './reportSupport'

/**
 * Client Reports — the client base, booking frequency, and receivables.
 *
 * RULING 2026-10-16 (R-P6-STATES, Law 16): this read counted clients (with
 * `|| 1248` / `|| 436` fallbacks) and the page rendered `data/clientReports` —
 * invented growth curves, retention, ageing, top clients, high-risk clients and
 * "insights" — on every path. It now returns what the tables record:
 *
 *   - client base, new in period, members      — `clients`, `client_memberships`
 *   - booked / repeat clients, frequency bands  — non-cancelled `bookings` picked up in the period
 *   - invoiced per client in the period          — `invoices` (not Draft/Void), money roles only
 *   - receivables and their ageing, now          — open invoices' `outstanding_amount` by `due_date`
 *
 * Throws on failure; an empty client base is empty. A money-blind session
 * does not read invoices at all (Law 6). Revert = restore the seed re-exports
 * and the `catch`.
 */

export interface ClientReportRow {
  clientId: string
  code: string
  name: string
  bookings: number
  invoiced: Paisa | null
  outstanding: Paisa | null
}

export interface AgeingBucket {
  label: string
  amount: Paisa
  invoices: number
}

export interface FrequencyBand {
  label: string
  clients: number
}

export interface HighRiskClient {
  clientId: string
  name: string
  overdue: Paisa
  oldestDaysOverdue: number
}

export interface ClientReportsSummary {
  totalClients: number
  activeClients: number
  newClients: number
  members: number
  bookedClients: number
  repeatClients: number
  frequency: FrequencyBand[]
  /** Clients with bookings or invoices in the period, most valuable first. */
  topClients: ClientReportRow[]
  money: {
    invoiced: Paisa
    receivables: Paisa
    ageing: AgeingBucket[]
    highRisk: HighRiskClient[]
  } | null
}

const OPEN_STATUSES = ['Sent', 'Partially Paid', 'Overdue']
const DAY = 86_400_000

export async function getClientReportsSummary(
  options: ReportFilterOptions = {},
  { includeMoney = true, now = new Date() }: { includeMoney?: boolean; now?: Date } = {},
): Promise<ClientReportsSummary> {
  let bookingsQ = supabase.from('bookings').select('client_id').is('cancelled_at', null)
  if (options.from) bookingsQ = bookingsQ.gte('pickup_at', options.from)
  if (options.to) bookingsQ = bookingsQ.lte('pickup_at', options.to)
  if (options.branchId) bookingsQ = bookingsQ.eq('branch_id', options.branchId)

  // Law 6 — a money-blind session never builds, let alone sends, an invoice read.
  const invoiceReads = () => {
    let invoicedQ = supabase
      .from('invoices')
      .select('client_id, total_amount')
      .neq('status', 'Draft')
      .neq('status', 'Void')
      .is('voided_at', null)
    if (options.from) invoicedQ = invoicedQ.gte('issue_date', options.from)
    if (options.to) invoicedQ = invoicedQ.lte('issue_date', options.to)
    if (options.branchId) invoicedQ = invoicedQ.eq('branch_id', options.branchId)
    let openQ = supabase.from('invoices').select('client_id, outstanding_amount, due_date').in('status', OPEN_STATUSES).is('voided_at', null)
    if (options.branchId) openQ = openQ.eq('branch_id', options.branchId)
    return [invoicedQ, openQ] as const
  }
  const none = Promise.resolve({ data: [], error: null })
  const [invoicedRead, openRead] = includeMoney ? invoiceReads() : [none, none]

  const [clientsRes, membershipsRes, bookingsRes, invoicedRes, openRes] = await Promise.all([
    supabase.from('clients').select('id, client_code, name, status, created_at, merged_into_client_id'),
    supabase.from('client_memberships').select('client_id, superseded_at'),
    bookingsQ,
    invoicedRead,
    openRead,
  ])
  const clients = rowsOf<{ id: string; client_code: string | null; name: string | null; status: string | null; created_at: string | null; merged_into_client_id: string | null }>(
    clientsRes,
    'Clients read failed',
  ).filter((c) => !c.merged_into_client_id)
  const memberships = rowsOf<{ client_id: string; superseded_at: string | null }>(membershipsRes, 'Memberships read failed')
  const bookings = rowsOf<{ client_id: string }>(bookingsRes, 'Bookings read failed')
  const invoiced = rowsOf<{ client_id: string; total_amount: number | string | null }>(invoicedRes, 'Invoices read failed')
  const open = rowsOf<{ client_id: string; outstanding_amount: number | string | null; due_date: string | null }>(openRes, 'Open invoices read failed')

  const fromMs = options.from ? Date.parse(options.from) : -Infinity
  const toMs = options.to ? Date.parse(options.to) : Infinity
  const newClients = clients.filter((c) => {
    const t = Date.parse(c.created_at ?? '')
    return !Number.isNaN(t) && t >= fromMs && t <= toMs
  }).length

  const bookingsByClient = new Map<string, number>()
  for (const b of bookings) bookingsByClient.set(b.client_id, (bookingsByClient.get(b.client_id) ?? 0) + 1)
  const invoicedByClient = new Map<string, number>()
  for (const i of invoiced) invoicedByClient.set(i.client_id, (invoicedByClient.get(i.client_id) ?? 0) + rupees(Number(i.total_amount ?? 0) || 0))

  const buckets = [
    { label: 'Not yet due', min: -Infinity, max: 0 },
    { label: '1–30 days', min: 1, max: 30 },
    { label: '31–60 days', min: 31, max: 60 },
    { label: '61–90 days', min: 61, max: 90 },
    { label: '90+ days', min: 91, max: Infinity },
  ].map((b) => ({ ...b, amount: 0, invoices: 0 }))
  const outstandingByClient = new Map<string, number>()
  const risk = new Map<string, { overdue: number; oldest: number }>()
  let receivables = 0
  for (const o of open) {
    const amt = rupees(Number(o.outstanding_amount ?? 0) || 0)
    if (amt <= 0) continue
    receivables += amt
    outstandingByClient.set(o.client_id, (outstandingByClient.get(o.client_id) ?? 0) + amt)
    const due = Date.parse(o.due_date ?? '')
    const days = Number.isNaN(due) ? 0 : Math.floor((now.getTime() - due) / DAY)
    const bucket = buckets.find((b) => days >= b.min && days <= b.max)
    if (bucket) {
      bucket.amount += amt
      bucket.invoices++
    }
    if (days > 60) {
      const r = risk.get(o.client_id) ?? { overdue: 0, oldest: 0 }
      r.overdue += amt
      r.oldest = Math.max(r.oldest, days)
      risk.set(o.client_id, r)
    }
  }

  const clientById = new Map(clients.map((c) => [c.id, c]))
  const nameOf = (id: string) => clientById.get(id)?.name?.trim() || '—'
  const involved = new Set([...bookingsByClient.keys(), ...invoicedByClient.keys()])
  const topClients: ClientReportRow[] = [...involved]
    .map((id) => ({
      clientId: id,
      code: clientById.get(id)?.client_code ?? '—',
      name: nameOf(id),
      bookings: bookingsByClient.get(id) ?? 0,
      invoiced: includeMoney ? ((invoicedByClient.get(id) ?? 0) as Paisa) : null,
      outstanding: includeMoney ? ((outstandingByClient.get(id) ?? 0) as Paisa) : null,
    }))
    .sort((a, b) => (b.invoiced ?? 0) - (a.invoiced ?? 0) || b.bookings - a.bookings)
    .slice(0, 10)

  const counts = [...bookingsByClient.values()]
  const band = (min: number, max: number) => counts.filter((n) => n >= min && n <= max).length

  return {
    totalClients: clients.length,
    activeClients: clients.filter((c) => c.status === 'Active').length,
    newClients,
    members: new Set(memberships.filter((m) => !m.superseded_at).map((m) => m.client_id)).size,
    bookedClients: bookingsByClient.size,
    repeatClients: counts.filter((n) => n >= 2).length,
    frequency: [
      { label: '1 booking', clients: band(1, 1) },
      { label: '2–3 bookings', clients: band(2, 3) },
      { label: '4–6 bookings', clients: band(4, 6) },
      { label: '7+ bookings', clients: band(7, Infinity) },
    ],
    topClients,
    money: includeMoney
      ? {
          invoiced: [...invoicedByClient.values()].reduce((a, n) => a + n, 0) as Paisa,
          receivables: receivables as Paisa,
          ageing: buckets.map((b) => ({ label: b.label, amount: b.amount as Paisa, invoices: b.invoices })),
          highRisk: [...risk.entries()]
            .map(([id, r]) => ({ clientId: id, name: nameOf(id), overdue: r.overdue as Paisa, oldestDaysOverdue: r.oldest }))
            .sort((a, b) => b.overdue - a.overdue)
            .slice(0, 10),
        }
      : null,
  }
}
</file>

<file path="src/lib/queries/damageMaintenanceReports.ts">
import { supabase } from '../supabase'
import { rupees, type Paisa } from '../money'
import { embeddedName, percentOf, rowsOf, type ReportFilterOptions } from './reportSupport'

export type { ReportFilterOptions } from './reportSupport'

export interface DamageIncidentItem {
  id: string
  bookingNo: string
  clientName: string
  unitName: string
  serial: string
  description: string
  /** `damage_findings.severity` is free text; 'Not set' when blank. */
  severity: string
  estimatedCost: Paisa
  chargedAmount: Paisa
  approvalState: string
  disposition: string
  raisedAt: string
}

export interface SeverityBreakdownItem {
  severity: string
  count: number
  percent: number
  totalCost: Paisa
}

export interface DamageTypeBreakdownItem {
  damageType: string
  count: number
  percent: number
}

export interface RepairJobItem {
  id: string
  recordNo: string
  unitName: string
  serial: string
  issue: string
  vendorOrShop: string
  cost: Paisa
  priority: string
  status: string
  startedAt: string
  completedAt?: string | undefined
  /** Null until the record carries both a start and a completion. */
  turnaroundDays: number | null
}

export interface ServicingItem {
  id: string
  recordNo: string
  unitName: string
  serial: string
  serviceType: string
  scheduledDate: string
  performedBy: string
  status: string
}

export interface SidelinedUnitItem {
  id: string
  serial: string
  modelName: string
  status: string
  sidelinedSince: string
  reason: string
}

export interface DamageMaintenanceReportData {
  metrics: {
    totalFindings: number
    totalDamageCost: Paisa
    totalChargedToClient: Paisa
    activeRepairs: number
    averageTurnaroundDays: number | null
    totalRepairSpend: Paisa
    routineServicesCompleted: number
    /** In Stock ÷ every unit not Retired, now; null with no units. */
    fleetAvailabilityRate: number | null
    sidelinedUnitsCount: number
    /** Units In Stock right now. */
    rentalReadyUnits: number
  }
  severityBreakdown: SeverityBreakdownItem[]
  damageTypeBreakdown: DamageTypeBreakdownItem[]
  incidents: DamageIncidentItem[]
  repairs: RepairJobItem[]
  servicing: ServicingItem[]
  sidelinedUnits: SidelinedUnitItem[]
}

/*
 * RULING 2026-10-16 (R-P6-STATES, Law 16): this read returned MOCK_DM on a
 * failure and on an empty database, patched every metric with `|| MOCK_DM…`,
 * always showed the mock sidelined units, and stamped every incident with the
 * literal booking 'BK-2026-0042', client 'Production Client' and unit 'Rental
 * Equipment Unit'. It now throws on failure, returns honest empties, resolves
 * unit/booking/client/technician from their tables, and a figure with no
 * source is `null` ("Not tracked yet"). Money comes from the `_v` views —
 * `estimated_cost`, `cost` and the case amounts are revoked on the base tables
 * (0077/0130), so the old read was refused on live. Revert = restore MOCK_DM
 * and the `catch`.
 */

/** Units out of rotation right now (inventory_state, Inventory.md §4.1). */
const SIDELINED_STATES = ['Inspection', 'Cleaning', 'Maintenance', 'Missing'] as const

type FindingRow = {
  id: string
  unit_id: string | null
  return_line_id: string | null
  case_id: string | null
  damage_type: string | null
  description: string | null
  severity: string | null
  estimated_cost: number | string | null
  approval_state: string | null
  disposition: string | null
  created_at: string
}

type MaintenanceRow = {
  id: string
  record_no: string
  product_unit_id: string | null
  maintenance_type: string | null
  priority: string | null
  status: string | null
  description: string | null
  vendor_name: string | null
  cost: number | string | null
  scheduled_date: string | null
  started_at: string | null
  completed_at: string | null
  performed_by: string | null
  created_at: string
}

type UnitRow = { id: string; product_id: string | null; serial_no: string | null; status: string; updated_at: string | null }

const money = (v: number | string | null | undefined): Paisa => rupees(Number(v ?? 0) || 0)

export async function getDamageMaintenanceReport(options?: ReportFilterOptions): Promise<DamageMaintenanceReportData> {
  let findingsQuery = supabase
    .from('damage_findings_v')
    .select('id, unit_id, return_line_id, case_id, damage_type, description, severity, estimated_cost, approval_state, disposition, created_at')
    .is('voided_at', null)
    .order('created_at', { ascending: false })
  let maintenanceQuery = supabase
    .from('maintenance_records_v')
    .select(
      'id, record_no, product_unit_id, maintenance_type, priority, status, description, vendor_name, cost, scheduled_date, started_at, completed_at, performed_by, created_at',
    )
    .order('created_at', { ascending: false })
  if (options?.from) {
    findingsQuery = findingsQuery.gte('created_at', options.from)
    maintenanceQuery = maintenanceQuery.gte('created_at', options.from)
  }
  if (options?.to) {
    findingsQuery = findingsQuery.lte('created_at', options.to)
    maintenanceQuery = maintenanceQuery.lte('created_at', options.to)
  }

  const [findingsRes, maintenanceRes, casesRes, unitsRes, productsRes, usersRes] = await Promise.all([
    findingsQuery,
    maintenanceQuery,
    supabase.from('cases_v').select('id, charged_to_client_amount'),
    supabase.from('product_units_v').select('id, product_id, serial_no, status, updated_at'),
    supabase.from('products').select('id, name'),
    supabase.from('users').select('id, full_name'),
  ])
  const findings = rowsOf<FindingRow>(findingsRes, 'Damage findings read failed')
  const records = rowsOf<MaintenanceRow>(maintenanceRes, 'Maintenance records read failed')
  const cases = rowsOf<{ id: string; charged_to_client_amount: number | string | null }>(casesRes, 'Cases read failed')
  const units = rowsOf<UnitRow>(unitsRes, 'Units read failed')
  const products = rowsOf<{ id: string; name: string | null }>(productsRes, 'Products read failed')
  const users = rowsOf<{ id: string; full_name: string | null }>(usersRes, 'Staff names read failed')

  // Finding → return line → booking line → booking, only for the findings that have one.
  const returnLineIds = [...new Set(findings.map((f) => f.return_line_id).filter((x): x is string => !!x))]
  const bookingOfFinding = new Map<string, { bookingNo: string; clientName: string }>()
  if (returnLineIds.length > 0) {
    const rl = rowsOf<{ id: string; booking_line_id: string }>(
      await supabase.from('return_lines').select('id, booking_line_id').in('id', returnLineIds),
      'Return lines read failed',
    )
    const lineIds = [...new Set(rl.map((r) => r.booking_line_id))]
    const bl = lineIds.length
      ? rowsOf<{ id: string; booking_id: string }>(
          await supabase.from('booking_lines').select('id, booking_id').in('id', lineIds),
          'Booking lines read failed',
        )
      : []
    const bookingIds = [...new Set(bl.map((l) => l.booking_id))]
    const bk = bookingIds.length
      ? rowsOf<{ id: string; booking_no: string; clients?: unknown }>(
          await supabase.from('bookings').select('id, booking_no, clients!client_id(name)').in('id', bookingIds),
          'Bookings read failed',
        )
      : []
    const lineToBooking = new Map(bl.map((l) => [l.id, l.booking_id]))
    const bookingById = new Map(bk.map((b) => [b.id, { bookingNo: b.booking_no, clientName: embeddedName(b.clients) }]))
    const rlToBooking = new Map(rl.map((r) => [r.id, bookingById.get(lineToBooking.get(r.booking_line_id) ?? '')]))
    for (const f of findings) {
      const hit = f.return_line_id ? rlToBooking.get(f.return_line_id) : undefined
      if (hit) bookingOfFinding.set(f.id, hit)
    }
  }

  const productName = new Map(products.map((p) => [p.id, p.name?.trim() || '—']))
  const unitById = new Map(units.map((u) => [u.id, u]))
  const userName = new Map(users.map((u) => [u.id, u.full_name?.trim() || '—']))
  const chargedByCase = new Map(cases.map((c) => [c.id, money(c.charged_to_client_amount)]))
  const unitLabel = (id: string | null) => {
    const u = id ? unitById.get(id) : undefined
    return { unitName: (u?.product_id && productName.get(u.product_id)) || '—', serial: u?.serial_no?.trim() || '—' }
  }

  // ── Damage ──
  let totalDamage = 0
  let totalCharged = 0
  const severityMap = new Map<string, { count: number; cost: number }>()
  const typeMap = new Map<string, number>()
  const incidents: DamageIncidentItem[] = []
  for (const f of findings) {
    const cost = money(f.estimated_cost)
    const charged = (f.case_id && chargedByCase.get(f.case_id)) || (0 as Paisa)
    totalDamage += cost
    totalCharged += charged
    const severity = f.severity?.trim() || 'Not set'
    const sv = severityMap.get(severity) ?? { count: 0, cost: 0 }
    sv.count++
    sv.cost += cost
    severityMap.set(severity, sv)
    const type = f.damage_type?.trim() || 'Not set'
    typeMap.set(type, (typeMap.get(type) ?? 0) + 1)
    const booking = bookingOfFinding.get(f.id)
    incidents.push({
      id: f.id,
      bookingNo: booking?.bookingNo ?? '—',
      clientName: booking?.clientName ?? '—',
      ...unitLabel(f.unit_id),
      description: f.description?.trim() || '—',
      severity,
      estimatedCost: cost,
      chargedAmount: charged,
      approvalState: f.approval_state ?? '—',
      disposition: f.disposition ?? 'Not decided',
      raisedAt: f.created_at,
    })
  }

  // ── Repairs & servicing ──
  const repairs: RepairJobItem[] = []
  const servicing: ServicingItem[] = []
  let repairSpend = 0
  let turnaroundTotal = 0
  let turnaroundCount = 0
  for (const m of records) {
    const type = m.maintenance_type?.toLowerCase() ?? ''
    const unit = unitLabel(m.product_unit_id)
    if (type.includes('repair') || type.includes('corrective')) {
      repairSpend += money(m.cost)
      let days: number | null = null
      if (m.started_at && m.completed_at) {
        const s = Date.parse(m.started_at)
        const c = Date.parse(m.completed_at)
        if (!Number.isNaN(s) && !Number.isNaN(c)) {
          days = Math.max(1, Math.round((c - s) / 86_400_000))
          turnaroundTotal += days
          turnaroundCount++
        }
      }
      repairs.push({
        id: m.id,
        recordNo: m.record_no,
        ...unit,
        issue: m.description?.trim() || '—',
        vendorOrShop: m.vendor_name?.trim() || '—',
        cost: money(m.cost),
        priority: m.priority?.trim() || '—',
        status: m.status?.trim() || '—',
        startedAt: m.started_at ?? m.created_at,
        completedAt: m.completed_at ?? undefined,
        turnaroundDays: days,
      })
    } else {
      servicing.push({
        id: m.id,
        recordNo: m.record_no,
        ...unit,
        serviceType: m.maintenance_type?.trim() || 'Not set',
        scheduledDate: m.scheduled_date ?? '',
        performedBy: (m.performed_by && userName.get(m.performed_by)) || '—',
        status: m.status?.trim() || '—',
      })
    }
  }

  // ── Fleet, as it stands now (not period-filtered: a unit's state is current) ──
  const fleet = units.filter((u) => u.status !== 'Retired')
  const ready = fleet.filter((u) => u.status === 'In Stock').length
  const sidelined = fleet.filter((u) => (SIDELINED_STATES as readonly string[]).includes(u.status))

  const nFindings = findings.length
  const typeTotal = [...typeMap.values()].reduce((a, n) => a + n, 0)
  return {
    metrics: {
      totalFindings: nFindings,
      totalDamageCost: totalDamage as Paisa,
      totalChargedToClient: totalCharged as Paisa,
      activeRepairs: repairs.filter((r) => r.status === 'In Progress').length,
      averageTurnaroundDays: turnaroundCount > 0 ? Number((turnaroundTotal / turnaroundCount).toFixed(1)) : null,
      totalRepairSpend: repairSpend as Paisa,
      routineServicesCompleted: servicing.filter((s) => s.status === 'Completed').length,
      fleetAvailabilityRate: fleet.length > 0 ? Number(((ready / fleet.length) * 100).toFixed(1)) : null,
      sidelinedUnitsCount: sidelined.length,
      rentalReadyUnits: ready,
    },
    severityBreakdown: [...severityMap.entries()]
      .sort((a, b) => b[1].count - a[1].count)
      .map(([severity, v]) => ({ severity, count: v.count, percent: percentOf(v.count, nFindings), totalCost: v.cost as Paisa })),
    damageTypeBreakdown: [...typeMap.entries()]
      .sort((a, b) => b[1] - a[1])
      .map(([damageType, count]) => ({ damageType, count, percent: percentOf(count, typeTotal) })),
    incidents: incidents.slice(0, 10),
    repairs: repairs.slice(0, 10),
    servicing: servicing.slice(0, 10),
    sidelinedUnits: sidelined.map((u) => ({
      id: u.id,
      serial: u.serial_no?.trim() || '—',
      modelName: (u.product_id && productName.get(u.product_id)) || '—',
      status: u.status,
      sidelinedSince: u.updated_at ?? '',
      reason: u.status,
    })),
  }
}
</file>

