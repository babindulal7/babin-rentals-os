              )
            })}
          </section>

          {/* ── warehouse list ────────────────────────────────────────── */}
          <div id="warehouse-list">
            <Card bodyStyle={{ padding: 0 }}>
              <div
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  gap: 'var(--sp-sm)',
