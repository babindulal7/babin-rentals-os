                  Filtered by alert: {alerts.find((a) => a.key === alertFilter)?.label}
                  <button type="button" style={{ ...linkStyle, marginLeft: 'auto' }} onClick={() => setAlertFilter(null)}>
                    Clear
                  </button>
                </div>
              )}

              {visible.length === 0 ? (
                <div style={{ padding: '20px 14px' }}>
                  <EmptyState
