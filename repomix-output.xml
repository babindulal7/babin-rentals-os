  referenceId?: string | undefined | undefined // Auto-detected ID like BR-2613, INV-2041, Q-1049
  referenceIds?: string[] | undefined | undefined
  text: string
  pinned?: boolean | undefined
}

const STORAGE_KEY = 'babin_internal_notes_v1'

