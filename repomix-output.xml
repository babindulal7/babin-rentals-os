  taxRegister: SalesInvoiceItem[]
}

/*
 * RULING 2026-10-16 (R-P6-STATES, Law 16): this read returned MOCK_SALES /
 * MOCK_VAT on a failure and on an empty period, the monthly trend and VAT
 * schedule were always the mock blocks, and the effective rate was the literal
 * 13.0. It selected `tax_amount`, `grand_total` and `clients.pan_number`, none
 * of which exist (0006: `vat_amount`, `total_amount`; clients: `pan_vat`), so
 * on live it could ONLY ever show the mock figures. It now reads the real
 * columns, throws on failure, returns honest zeros, and builds the VAT
 * schedule per Bikram Sambat month from `issue_date` (BS rendered, never
 * stored). Draft and Void invoices are not sales and are left out.
 * Revert = restore MOCK_SALES/MOCK_VAT and the `catch`.
 */

type InvoiceRow = {
  id: string
  invoice_no: string
  client_id: string | null
  status: string
  issue_date: string | null
  due_date: string | null
  subtotal: number | string | null
  discount_amount: number | string | null
  taxable_amount: number | string | null
  vat_rate: number | string | null
  vat_amount: number | string | null
  total_amount: number | string | null
  paid_amount: number | string | null
  outstanding_amount: number | string | null
  voided_at: string | null
  clients?: unknown
  bookings?: unknown
}

const money = (v: number | string | null | undefined): Paisa => rupees(Number(v ?? 0) || 0)

function bsMonthOf(isoDate: string): { key: string; label: string } | null {
  const bs = toBs(new Date(`${isoDate.slice(0, 10)}T12:00:00Z`))
  if (!bs) return null
  return { key: `${bs.year}-${String(bs.month).padStart(2, '0')}`, label: `${BS_MONTHS[bs.month - 1] ?? ''} ${bs.year}` }
}

export async function getSalesVatReport(options?: ReportFilterOptions): Promise<{ sales: SalesReportData; vat: VatTaxReportData }> {
  let query = supabase
    .from('invoices')
    .select(
      'id, invoice_no, client_id, status, issue_date, due_date, subtotal, discount_amount, taxable_amount, vat_rate, vat_amount, total_amount, paid_amount, outstanding_amount, voided_at, clients!client_id(name, pan_vat), bookings!booking_id(booking_no)',
    )
    .neq('status', 'Draft')
    .neq('status', 'Void')
    .is('voided_at', null)
    .order('issue_date', { ascending: false })
  if (options?.from) query = query.gte('issue_date', options.from)
  if (options?.to) query = query.lte('issue_date', options.to)
  if (options?.branchId) query = query.eq('branch_id', options.branchId)

  const rows = rowsOf<InvoiceRow>(await query, 'Invoices read failed')

  let invoiced = 0
  let net = 0
  let vatTotal = 0
  let discounts = 0
  let paidTotal = 0
  let outstanding = 0
  let taxable = 0
  let exempt = 0
  const statusMap = new Map<string, { count: number; amount: number }>()
  const clientMap = new Map<string, { name: string; count: number; invoiced: number; paid: number }>()
  const monthMap = new Map<string, VatMonthlyRow & { invoicedTotal: number; collectedTotal: number }>()
  const invoices: SalesInvoiceItem[] = []

  for (const r of rows) {
    const total = money(r.total_amount)
    const sub = money(r.subtotal)
    const vat = money(r.vat_amount)
    const taxableAmt = money(r.taxable_amount)
    const paid = money(r.paid_amount)
    invoiced += total
    net += sub
    vatTotal += vat
    discounts += money(r.discount_amount)
    paidTotal += paid
    outstanding += money(r.outstanding_amount)
    // An invoice with no VAT charged is exempt (or zero-rated) turnover.
    const isExempt = vat === 0
    if (isExempt) exempt += taxableAmt
    else taxable += taxableAmt

    const st = statusMap.get(r.status) ?? { count: 0, amount: 0 }
    st.count++
    st.amount += total
    statusMap.set(r.status, st)

    const client = (Array.isArray(r.clients) ? r.clients[0] : r.clients) as { name?: string; pan_vat?: string | null } | null | undefined
    const clientName = embeddedName(r.clients)
    const cKey = r.client_id ?? clientName
    const cl = clientMap.get(cKey) ?? { name: clientName, count: 0, invoiced: 0, paid: 0 }
    cl.count++
    cl.invoiced += total
    cl.paid += paid
    clientMap.set(cKey, cl)

    if (r.issue_date) {
      const bm = bsMonthOf(r.issue_date)
      if (bm) {
        const row =
          monthMap.get(bm.key) ??
          ({ month: formatAdMonth(new Date(`${r.issue_date.slice(0, 10)}T12:00:00Z`)), bsMonth: bm.label, taxableSales: 0 as Paisa, vatAmount: 0 as Paisa, exemptSales: 0 as Paisa, grossSales: 0 as Paisa, invoicedTotal: 0, collectedTotal: 0 } as VatMonthlyRow & {
            invoicedTotal: number
            collectedTotal: number
          })
        row.taxableSales = (row.taxableSales + (isExempt ? 0 : taxableAmt)) as Paisa
        row.exemptSales = (row.exemptSales + (isExempt ? taxableAmt : 0)) as Paisa
        row.vatAmount = (row.vatAmount + vat) as Paisa
        row.grossSales = (row.grossSales + total) as Paisa
        row.invoicedTotal += total
        row.collectedTotal += paid
        monthMap.set(bm.key, row)
      }
    }

    const booking = (Array.isArray(r.bookings) ? r.bookings[0] : r.bookings) as { booking_no?: string } | null | undefined
    invoices.push({
      id: r.id,
      invoiceNo: r.invoice_no,
      bookingNo: booking?.booking_no ?? '—',
      clientName,
      clientPan: client?.pan_vat?.trim() || undefined,
      issueDate: r.issue_date ?? '',
      dueDate: r.due_date ?? '',
      subtotal: sub,
      taxAmount: vat,
      grandTotal: total,
      paidAmount: paid,
      status: r.status,
    })
  }

  const count = rows.length
  const months = [...monthMap.entries()].sort((a, b) => a[0].localeCompare(b[0])).map(([, v]) => v)
  const vatBase = taxable + exempt

  const sales: SalesReportData = {
    metrics: {
      totalInvoiced: invoiced as Paisa,
      netSales: net as Paisa,
      totalVat: vatTotal as Paisa,
      totalDiscounts: discounts as Paisa,
      totalCollected: paidTotal as Paisa,
      totalOutstanding: outstanding as Paisa,
      invoiceCount: count,
      collectionRate: invoiced > 0 ? Number(((paidTotal / invoiced) * 100).toFixed(1)) : 0,
    },
    statusBreakdown: [...statusMap.entries()]
      .sort((a, b) => b[1].count - a[1].count)
      .map(([status, v]) => ({ status, count: v.count, amount: v.amount as Paisa, percent: percentOf(v.count, count) })),
    monthlyTrend: months.map((m) => ({ period: m.bsMonth, invoiced: m.invoicedTotal as Paisa, collected: m.collectedTotal as Paisa })),
    topClients: [...clientMap.entries()]
      .map(([clientId, v]) => ({
        clientId,
        clientName: v.name,
        invoiceCount: v.count,
        totalInvoiced: v.invoiced as Paisa,
        totalPaid: v.paid as Paisa,
        balance: Math.max(0, v.invoiced - v.paid) as Paisa,
      }))
      .sort((a, b) => b.totalInvoiced - a.totalInvoiced)
      .slice(0, 5),
    invoices: invoices.slice(0, 10),
  }

  const vat: VatTaxReportData = {
    metrics: {
      totalGrossTurnover: invoiced as Paisa,
      taxableTurnover: taxable as Paisa,
      totalOutputVat: vatTotal as Paisa,
      exemptTurnover: exempt as Paisa,
      effectiveVatRate: vatBase > 0 ? Number(((vatTotal / vatBase) * 100).toFixed(1)) : 0,
      invoicesCount: count,
    },
    monthlySchedule: months.map(({ invoicedTotal: _i, collectedTotal: _c, ...row }) => row),
    taxRegister: invoices.slice(0, 10),
  }

  return { sales, vat }
}
</file>

<file path="src/lib/queries/staffReports.ts">
import { supabase } from '../supabase'
import { rupees, type Paisa } from '../money'
import { linesValue, readLineValues, rowsOf, type ReportFilterOptions } from './reportSupport'

/**
 * Staff Performance — per person, from the rows they are recorded against.
 *
 * RULING 2026-10-16 (R-P6-STATES, Law 16): this read fetched `users` and
 * `audit_events`, kept only a count, and the page rendered `data/staffReports`
 * — five invented people with invented revenue, collections, task counts,
 * response times and "performance scores" — on every path, including a failed
 * read. It now attributes what the schema records:
 *
 *   - bookings created and their value  — `bookings.created_by`, `booking_lines_v`
 *   - rental collections received       — `payments.received_by`, Advance Payment,
 *                                          status Received (deposits are a
 *                                          liability, never revenue — Law 4)
 *   - floor sessions completed          — `operation_sessions.completed_by`
 *
 * Response time and a performance score have no source and are not returned.
 * It throws on failure; a period with no activity is an empty list.
 * Revert = restore the seed re-exports and the `catch`.
 */

export interface StaffPerformanceRow {
  userId: string
  name: string
  role: string
  bookingsCreated: number
  bookingValue: Paisa
  collections: Paisa
  sessionsCompleted: number
}

export interface StaffReportsSummary {
  rows: StaffPerformanceRow[]
  totals: {
    bookingsCreated: number
    bookingValue: Paisa
    collections: Paisa
    sessionsCompleted: number
  }
}

export async function getStaffReportsSummary(options?: ReportFilterOptions): Promise<StaffReportsSummary> {
  let bookingsQ = supabase.from('bookings').select('id, created_by').is('cancelled_at', null)
  let paymentsQ = supabase
    .from('payments')
    .select('received_by, amount')
    .eq('status', 'Received')
    .eq('payment_type', 'Advance Payment')
  let sessionsQ = supabase.from('operation_sessions').select('completed_by').eq('state', 'Completed')
  if (options?.from) {
    bookingsQ = bookingsQ.gte('created_at', options.from)
    paymentsQ = paymentsQ.gte('payment_date', options.from)
    sessionsQ = sessionsQ.gte('completed_at', options.from)
  }
  if (options?.to) {
    bookingsQ = bookingsQ.lte('created_at', options.to)
    paymentsQ = paymentsQ.lte('payment_date', options.to)
    sessionsQ = sessionsQ.lte('completed_at', options.to)
  }
  if (options?.branchId) {
    bookingsQ = bookingsQ.eq('branch_id', options.branchId)
    paymentsQ = paymentsQ.eq('branch_id', options.branchId)
  }

  const [usersRes, bookingsRes, paymentsRes, sessionsRes, lineMap] = await Promise.all([
    supabase.from('users').select('id, full_name, primary_role'),
    bookingsQ,
    paymentsQ,
    sessionsQ,
    readLineValues(),
  ])
  // `users` is RLS-scoped (0120): a role that sees fewer staff gets '—' names, not a failure.
  const users = rowsOf<{ id: string; full_name: string | null; primary_role: string | null }>(usersRes, 'Staff read failed')
  const bookings = rowsOf<{ id: string; created_by: string | null }>(bookingsRes, 'Bookings read failed')
  const payments = rowsOf<{ received_by: string | null; amount: number | string | null }>(paymentsRes, 'Payments read failed')
  const sessions = rowsOf<{ completed_by: string | null }>(sessionsRes, 'Sessions read failed')

  const byUser = new Map<string, StaffPerformanceRow>()
  const userById = new Map(users.map((u) => [u.id, u]))
  const rowFor = (id: string): StaffPerformanceRow => {
    let row = byUser.get(id)
    if (!row) {
      const u = userById.get(id)
      row = {
        userId: id,
        name: u?.full_name?.trim() || '—',
        role: u?.primary_role ?? '—',
        bookingsCreated: 0,
        bookingValue: 0 as Paisa,
        collections: 0 as Paisa,
        sessionsCompleted: 0,
      }
      byUser.set(id, row)
    }
    return row
  }

  for (const b of bookings) {
    if (!b.created_by) continue
    const row = rowFor(b.created_by)
    row.bookingsCreated++
    row.bookingValue = (row.bookingValue + linesValue(lineMap.get(b.id))) as Paisa
  }
  for (const p of payments) {
    if (!p.received_by) continue
    const row = rowFor(p.received_by)
    row.collections = (row.collections + rupees(Number(p.amount ?? 0) || 0)) as Paisa
  }
  for (const s of sessions) {
    if (!s.completed_by) continue
    rowFor(s.completed_by).sessionsCompleted++
  }

  const rows = [...byUser.values()].sort((a, b) => b.collections - a.collections || b.bookingValue - a.bookingValue)
  return {
    rows,
    totals: {
      bookingsCreated: rows.reduce((a, r) => a + r.bookingsCreated, 0),
      bookingValue: rows.reduce((a, r) => a + r.bookingValue, 0) as Paisa,
      collections: rows.reduce((a, r) => a + r.collections, 0) as Paisa,
      sessionsCompleted: rows.reduce((a, r) => a + r.sessionsCompleted, 0),
    },
  }
}
</file>

