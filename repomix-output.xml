            : s.id === 'sec-relationships'
              ? Boolean(e.relationships)
              : s.id === 'sec-location'
                ? Boolean(e.location)
                : s.id === 'sec-purchase'
                  ? Boolean(e.purchasePrice || e.replacementValue)
                  : s.id === 'sec-pricing'
                    ? Boolean(e.dailyRate || e.deposit)
