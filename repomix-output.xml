  return (
    <>
      <tr style={{ borderBottom: '1px solid var(--border)', background: inBundle ? 'var(--success-bg)' : undefined }}>
        <td style={{ ...td, paddingRight: 'var(--sp-xs)' }}>
          <span style={{ display: 'flex', alignItems: 'center', gap: 5 }}>
            {kids.length > 0 ? (
              <button
