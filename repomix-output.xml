/* ── §3 · KPI cards, §2 chips — derived from a case array, never hand-typed ──
 * Every function below defaults to the seed `CASES` but accepts any array,
 * so the component can re-derive the same figures against a locally-edited
 * copy (after "Confirm Disposition") without duplicating the formulas.
 */

export function statusCounts(cases: Case[] = CASES): Record<CaseStatus, number> {
  return CASE_STATUSES.reduce((acc, s) => ({ ...acc, [s]: cases.filter((c) => c.status === s).length }), {} as Record<CaseStatus, number>)
}

export function flagCounts(cases: Case[] = CASES): Record<CaseFlag, number> {
  return CASE_FLAGS.reduce((acc, f) => ({ ...acc, [f]: cases.filter((c) => c.flags.includes(f)).length }), {} as Record<CaseFlag, number>)
}

export const STATUS_COUNTS = statusCounts()
export const FLAG_COUNTS = flagCounts()

/** §3 — "Open Cases = Open + Under Review + Awaiting Decision + In Progress." */
export function openCasesCount(cases: Case[] = CASES): number {
  return cases.filter((c) => isOpenStatus(c.status)).length
}

/** §3 — "Assessed value of open cases." */
export function exposurePaisa(cases: Case[] = CASES): Paisa {
  return cases.filter((c) => isOpenStatus(c.status)).reduce((sum, c) => (sum + c.assessedPaisa) as Paisa, rupees(0))
}

/** §3 — "Charged + claimed + covered, settled this month." Partner recovery and Absorbed are deliberately excluded — the formula names three buckets, not six. */
export function recoveredThisMonthPaisa(cases: Case[] = CASES): Paisa {
  return cases
    .filter((c) => isSettledStatus(c.status) && c.settledAd && c.settledAd.getUTCFullYear() === TODAY.getUTCFullYear() && c.settledAd.getUTCMonth() === TODAY.getUTCMonth())
    .reduce((sum, c) => (sum + c.chargedToClientPaisa + c.insuranceClaimedPaisa + c.warrantyCoveredPaisa) as Paisa, rupees(0))
}

export function awaitingDecisionCount(cases: Case[] = CASES): number {
  return statusCounts(cases)['Awaiting Decision']
}

/**
 * The default allocation a disposition applies the moment it is confirmed
 * (§6.2's "before it happens" preview, made real). Charge Client applies
 * whatever deposit is held immediately; the remainder stays outstanding
 * until invoiced and paid, exactly like the seeded CASE-2026-0040.
 */
export function defaultAllocationFor(
  c: Case,
  disposition: string,
): Partial<Pick<Case, 'chargedToClientPaisa' | 'depositAppliedPaisa' | 'insuranceClaimedPaisa' | 'warrantyCoveredPaisa' | 'recoveredFromPartnerPaisa' | 'absorbedPaisa'>> {
  switch (disposition) {
    case 'Charge Client':
      return { depositAppliedPaisa: chargeClientProjection(c).depositApplied }
    case 'Warranty Claim':
      return { warrantyCoveredPaisa: c.assessedPaisa }
    case 'Found':
    case 'Client Returned':
    case 'Write Off':
    case 'Absorb':
    case 'Fully Waived':
      return { absorbedPaisa: c.assessedPaisa }
    case 'Recover from Partner':
      return { recoveredFromPartnerPaisa: c.assessedPaisa }
    default:
      return {}
  }
}

/** Resolved/Closed dispositions need no further work; everything else moves to In Progress once a decision is recorded. */
const TERMINAL_ON_CONFIRM = new Set(['Found', 'Client Returned', 'Write Off', 'Absorb', 'Fully Waived', 'Recover from Partner', 'Warranty Claim'])
export function statusAfterDisposition(disposition: string): CaseStatus {
  return TERMINAL_ON_CONFIRM.has(disposition) ? 'Resolved' : 'In Progress'
}

/* ── module-load assertions — mirrors `reset.ts`'s GROUP_SUM / TOTAL_TASKS checks ── */

/**
 * ⛔ Every check below used to `throw` at module scope. A module-evaluation
 * throw is **uncatchable** — it runs before React mounts, so no boundary can
 * catch it and the operator gets a blank white screen with nothing in it.
 * `lib/money.ts` hit exactly this and fixed it by *reporting* the failure
 * instead of throwing; the same pattern is used here.
 *
 * Every invariant still runs on every load — §2, §3, §4.2, §5.2, §7.1 and §7.3
 * are all still checked, and the loop now collects *all* violations rather than
 * stopping at the first, which is strictly more information than the throw gave.
 * The result is exported so the screen can state it, and logged so a broken seed
 * is never silent even before a screen reads it.
 */
export const CASES_SEED_ERROR: string | null = (() => {
  const problems: string[] = []

  const sumOfChips = CASE_STATUSES.reduce((s, k) => s + STATUS_COUNTS[k], 0)
  if (sumOfChips !== CASES.length) {
    problems.push(`§2 chip reconciliation violated: chips sum to ${sumOfChips}, CASES has ${CASES.length} rows`)
  }

  const openByFormula = STATUS_COUNTS.Open + STATUS_COUNTS['Under Review'] + STATUS_COUNTS['Awaiting Decision'] + STATUS_COUNTS['In Progress']
  const openByFilter = openCasesCount()
  if (openByFormula !== openByFilter) {
    problems.push(`§3 "Open Cases" formula violated: chip sum gives ${openByFormula}, isOpenStatus() filter gives ${openByFilter}`)
  }

  for (const c of CASES) {
    if (!/^CASE-\d{4}-\d{4}$/.test(c.id)) {
      problems.push(`§4.2 ID registry violated: "${c.id}" is not CASE-YYYY-NNNN (four digits)`)
    }
    if (c.linked.linkedRecordKind === 'Sub-Rental' && !/^SR-\d{4}-\d{4}$/.test(c.linked.linkedRecordId)) {
      problems.push(`§4.2 ID registry violated: "${c.linked.linkedRecordId}" is not SR-YYYY-NNNN (four digits) — §0 defect #6`)
    }
    if (c.disposition !== null && !DISPOSITIONS_BY_TYPE[c.type].includes(c.disposition)) {
      problems.push(`§5.2 violated: "${c.disposition}" is not a valid disposition for type ${c.type} on ${c.id}`)
    }
    // §7.1 / §0 defect #3 — no allocation before a disposition is set.
    if (c.disposition === null) {
      const a = allocationOf(c)
      const untouched = a.chargedToClient === 0 && a.depositApplied === 0 && a.insuranceClaimed === 0 && a.warrantyCovered === 0 && a.recoveredFromPartner === 0 && a.absorbed === 0
      if (!untouched || outstandingOf(c) !== c.assessedPaisa) {
        problems.push(`§7.1 violated: ${c.id} has no disposition yet but carries a non-zero allocation`)
      }
    }
    // §7.3 — allocation must balance before Closed.
    if (c.status === 'Closed' && allocatedTotal(c) !== c.assessedPaisa) {
      problems.push(`§7.3 violated: ${c.id} is Closed but Assessed ${String(c.assessedPaisa)} ≠ allocated ${String(allocatedTotal(c))}`)
    }
  }

  return problems.length === 0
    ? null
    : `Cases seed data does not reconcile: ${problems.join('; ')}. Figures on this screen cannot be trusted — see src/data/cases.ts.`
})()

if (CASES_SEED_ERROR) {
  console.error(CASES_SEED_ERROR)
  captureError(new Error(CASES_SEED_ERROR), { where: 'seed.cases' })
}

/* ── misc seed reference data ─────────────────────────────────────────── */

export const OWNERS = ['Sunil', 'Nabin', 'Rajan'] as const
export const ROWS_PER_PAGE_OPTIONS = [10, 25, 50] as const

/** §9 — Case creation is a separate, undefined flow (only the queue+rail screen is in scope). */
export const NEW_CASE_UNAVAILABLE_REASON = 'Case creation is not built yet — only the queue and rail are in scope for this pass.'
/** No export pipeline exists — no cases report builder or CSV writer anywhere in the build. The old button toasted "Generating cases report…" while generating nothing (the exact fabrication src/actions/core.ts §1 names). */
export const CASES_EXPORT_UNAVAILABLE_REASON = 'Export is not built yet — no cases report or CSV generator exists in this build, so nothing can be downloaded from here.'
/** §10 — the workspace route has no field list yet; §12 checklist item "Case Workspace route defined and reachable" stays open until it does. */
export const CASE_WORKSPACE_ROUTE = (id: string) => `/inventory/cases/${id}` // moved from /operations/cases 30 Aug
</file>

<file path="src/data/clientIntel.ts">
/**
 * Hover Intel System v2.1 §1 — the Client card.
 *
 * Builds an already-gated `IntelGlance`/`IntelGroup[]` pair for one
 * `ClientRecord`. Every field-level decision goes through `lib/fieldGating.ts`
 * — this file never checks a role literal itself, so `ClientsDirectory.tsx`
 * and `ClientDetail.tsx` cannot drift into gating the same field two
 * different ways.
 *
 * §4.1's explicit Coordinator carve-out ("Coordinator = booking-level money +
 * client balance/deposit only") is honoured field-by-field inside the Money
 * group. Where the spec has no such carve-out — Commercial's discount terms,
 * for instance, just says "Gated" — the stricter full-tier reading is used,
 * consistent with the same rule's "no asset ROI, no crew pay, no supplier
 * margin" trend of keeping Coordinator to booking + balance only.
 */

import { createElement } from 'react'
import type { ClientRecord } from './clients'
import { TIER_TONE, creditStopFactsOf, evaluateCreditStop, readOverdueStopDays } from './clients'
import { formatMoney } from '../lib/money'
import type { GateContext } from '../lib/fieldGating'
import { canViewMoneyField, canViewPII, canViewDocuments, canViewNotes, canViewOnStopReason, moneyScope } from '../lib/fieldGating'
import type { IntelGlance, IntelGroup, IntelField } from '../components/ui/IntelCard'
import { STATUS } from '../lib/status'
import type { StatusKey } from '../lib/status'

/**
 * **Blocked and On Stop are two different facts, and the hover card used to
 * conflate them.**
 *
 * This file previously carried its own `isOnStop(client)` returning
 * `client.isBlocked || client.onStop` — a *stored* flag, ORed with a block.
 * Rulings §11.2 replaced that with a **derived** credit state
 * (`evaluateCreditStop` in `./clients`), and `ClientsDirectory` was moved onto
 * it while this file was not. The result was visible: one row could read
 * "On Stop" in the directory and "On-Stop: Clear" in its own hover card at the
 * same time, because the two were answering different questions.
 *
 * Now there is one predicate. The two facts are reported separately, because
 * they intersect rather than nest (`0005_clients.sql`: *"Flags coexist with the
 * client's state"*):
 *
 *  · **Blocked** — a `client_flags` row. Someone decided this client may not book.
 *  · **On Stop** — derived from credit: over the approved limit, or holding an
 *    invoice more than `overdueStopDays` past due. Nobody set it; it is computed.
 *
 * `indeterminate` is deliberately *not* folded into `false`. A limb that could
 * not run is not a limb that passed — a Warehouse session cannot read the money,
 * so it must be told the check did not run rather than shown "clear".
 */
interface StopState {
  /** A `client_flags` block — someone set this. */
  blocked: boolean
  /** Derived credit stop — computed, never stored. */
  onStop: boolean
  /** No limb could run. Never render this as "clear". */
  indeterminate: boolean
  /** Figure-free, already gated. Empty when nothing fired. */
  reasons: string[]
}

function stopStateOf(client: ClientRecord, gctx: GateContext): StopState {
  const canViewMoney = canViewMoneyField(gctx, 'client-balance')
  const verdict = evaluateCreditStop(creditStopFactsOf(client, { canViewMoney }), {
    overdueStopDays: readOverdueStopDays(),
    canViewMoney,
  })
  return {
    blocked: Boolean(client.isBlocked),
    onStop: verdict.onStop,
    indeterminate: verdict.indeterminate,
    /* §4.4 — the *reason* is PII-gated even where the *state* is not, so a floor
       role sees that a client is on stop without seeing why. `reasons` is the
       figure-free set; `details` (which carries rupees) is never read here. */
    reasons: canViewOnStopReason(gctx) ? verdict.reasons : [],
  }
}

/**
 * Risk-tag keyword list — a display-classification call, not a business rule
 * (the same category `lateReturns >= 2` below is documented as): which free-text
 * `client.tags` strings read as risk-flavoured ("Payment Risk", "Chargeback
 * Hold") versus neutral/positive ("Gold Tier", "Broadcast"). Matched
 * case-insensitively as a substring so "Payment Risk" and "On Hold" both hit
 * without enumerating every possible tag. A tag that matches none of these
 * keeps rendering as a plain neutral badge, exactly as it did before this fix.
 */
const RISK_TAG_KEYWORDS = ['risk', 'overdue', 'hold', 'flag', 'block', 'dispute', 'chargeback']

function isRiskTag(tag: string): boolean {
  const lower = tag.toLowerCase()
  return RISK_TAG_KEYWORDS.some((kw) => lower.includes(kw))
}

/**
 * De-emphasized field value for a genuinely-undecided "Open ⭐" placeholder —
 * a display-classification call, not a business rule, same escape hatch as
 * `riskField` below: `IntelField.value` is typed `ReactNode` precisely so a
 * builder can hand back a `--muted`-coloured span instead of a plain string
 * (see also `supplierIntel.ts`'s gold badge for the same pattern). The
 * placeholder text and "Open ⭐ #N" decision-tracking label are unchanged —
 * this only lowers how loud the field reads next to real data in the same
 * group, which is why callers also move it to the end of its group.
 */
function mutedField(label: string, text: string): IntelField {
  return {
    label,
    value: createElement('span', { style: { color: 'var(--muted)', fontStyle: 'italic' } }, text),
  }
}

/**
 * Reliability risk tone — "never colour alone" (CLAUDE.md's Law list),
 * applied to a single `IntelField.value` rather than the whole field/badge
 * component. `IntelField` carries no `tone`/`variant` prop of its own (only
 * `label`/`value`/`trigger` — see `components/ui/IntelCard.tsx`), so this
 * follows the same escape hatch `supplierIntel.ts`'s gold "Active external
 * units" badge and `crewIntel.ts`'s month strip already use: `IntelField.value`
 * is typed `ReactNode` precisely so a builder can hand back a coloured
 * `createElement` span instead of a plain string. `createElement`, not JSX,
 * because this stays a plain `.ts` module like every sibling card builder.
 *
 * The colour (`STATUS.danger`'s bg/fg pair — red is "the only alarm colour",
 * `lib/status.ts`) is paired with a text qualifier appended to the value
 * itself ("· Flagged"), not left to carry the warning alone — the same
 * bg/fg/padding/radius shape `IntelCard.tsx`'s own `Glance` badge rendering
 * uses for `IntelBadge`, reused here so a toned Reliability field reads as
 * the same "badge" language the rest of the card already speaks.
 */
function riskField(label: string, text: string, atRisk: boolean): IntelField {
  if (!atRisk) return { label, value: text }
  const tone: StatusKey = 'danger'
  const t = STATUS[tone]
  return {
    label,
    value: createElement(
      'span',
      {
        style: {
          display: 'inline-flex',
          alignItems: 'center',
          height: 20,
          padding: '0 7px',
          borderRadius: 'var(--r-badge)',
          background: t.bg,
          color: t.fg,
          fontSize: 'var(--t-meta)',
          fontWeight: 600,
          whiteSpace: 'nowrap',
        },
      },
      `${text} · Flagged`,
    ),
  }
}

export function clientGlance(client: ClientRecord, gctx: GateContext): IntelGlance {
  const stop = stopStateOf(client, gctx)
  /* Either fact withholds the booking action. They are still reported
     separately below — "blocked" and "over credit limit" call for different
     conversations with the client. */
  const barred = stop.blocked || stop.onStop

  const badges = [
    { label: client.membership, tone: TIER_TONE[client.membership] },
    ...(client.tags ?? []).slice(0, 2).map((t) => ({ label: t, ...(isRiskTag(t) ? { tone: 'danger' as StatusKey } : {}) })),
  ]

  const lines: string[] = []
  if (stop.blocked) {
    lines.push('Blocked — no new bookings')
  }
  if (stop.onStop) {
    /* The reasons are figure-free and already role-gated in `stopStateOf`, so a
       floor session gets "On Stop" with no rupee figure rather than nothing. */
    lines.push(stop.reasons.length ? `On Stop — ${stop.reasons.join(' · ')}` : 'On Stop — credit')
  } else if (stop.indeterminate && !stop.blocked) {
    /* Law 12 and the §11.2 rule that an unevaluable limb is not a passing one:
       say the check did not run. Rendering nothing here reads as "clear". */
    lines.push('Credit check did not run on this record')
  }
  lines.push(`${client.currentRentalsCount} active rental${client.currentRentalsCount === 1 ? '' : 's'} · ${client.totalRentalsCount} lifetime`)
  if (canViewMoneyField(gctx, 'client-balance')) {
    lines.push(
      client.outstandingPaisa > 0
        ? `Owes ${formatMoney(client.outstandingPaisa)} · deposit ${formatMoney(client.depositHeldPaisa)} held`
        : `No balance due · deposit ${formatMoney(client.depositHeldPaisa)} held`,
    )
  }

  return {
    avatarLabel: client.name.slice(0, 2).toUpperCase(),
    avatarTone: TIER_TONE[client.membership],
    title: client.name,
    /* `neutral`, not `in`, when the check could not run. There is no `warn` in
       `StatusKey` and inventing one would be wrong anyway: an unevaluated credit
       state is not a warning, it is an absence of information, and `neutral` is
       the only token that claims nothing. `in` would claim health. */
    statusDot: barred ? 'danger' : stop.indeterminate ? 'neutral' : 'in',
    subtitle: `${client.clientType}${client.company ? ` · ${client.company}` : ''}`,
    badges,
    lines,
    // §4.4's "block is visible to everyone who tries to book" is served by the
    // status dot and the On-Stop line above; the action itself is simply
    // absent when blocked, the same "forbidden things are absent" rule the
    // rest of the app follows rather than a disabled button with no reason.
    ...(barred ? {} : { primaryAction: { label: 'New booking', to: '/rentals/new' } }),
  }
}

export function clientDetailGroups(client: ClientRecord, gctx: GateContext): IntelGroup[] {
  const groups: IntelGroup[] = []
  const stop = stopStateOf(client, gctx)

  groups.push({
    title: 'Identity',
    fields: [
      { label: 'Name', value: client.name },
      ...(client.company ? [{ label: 'Company', value: client.company }] : []),
      { label: 'Client type', value: client.clientType },
      { label: 'Tags', value: client.tags?.length ? client.tags.join(', ') : '—' },
      { label: 'Client since', value: client.clientSinceAd ?? '—' },
      ...(canViewPII(gctx) ? [{ label: 'PAN / VAT no.', value: client.pan ?? 'Not on file' }] : []),
    ],
  })

  if (canViewPII(gctx)) {
    const addresses = client.addresses ?? [{ kind: 'Billing' as const, label: 'On file', address: client.address }]
    groups.push({
      title: 'Contact',
      fields: [
        { label: 'Phone', value: client.phone },
        { label: 'Email', value: client.email || '—' },
        ...addresses.map((a) => ({ label: `${a.kind} address (${a.label})`, value: a.address })),
      ],
    })
  }

  groups.push({
    title: 'Membership',
    fields: [
      { label: 'Level', value: client.membership },
      { label: 'Member since', value: client.clientSinceAd ?? '—' },
      // Open ⭐ #2 — no benefit matrix is ruled yet. Stated, not guessed.
      // Muted + last: a genuinely-undecided product question, not data — see `mutedField`.
      mutedField('Benefits', 'Not yet defined (Open ⭐ #2 — membership benefit matrix)'),
    ],
  })

  if (moneyScope(gctx) === 'full') {
    groups.push({
      title: 'Commercial',
      fields: [
        { label: 'Standing discount', value: client.standingDiscountPercent !== undefined ? `${client.standingDiscountPercent}%` : '—' },
        { label: 'Discount source', value: client.discountSource ?? '—' },
        { label: 'Payment terms', value: client.paymentTerms ?? '—' },
        // Open ⭐ #1 — no per-category deposit-% table is ruled yet.
        // Muted + last: a genuinely-undecided product question, not data — see `mutedField`.
        mutedField('Deposit override', 'Not set (Open ⭐ #1 — per-category deposit % table)'),
      ],
    })
  }

  const moneyFields: IntelField[] = []
  if (canViewMoneyField(gctx, 'client-balance')) {
    moneyFields.push(
      { label: 'Outstanding balance', value: formatMoney(client.outstandingPaisa) },
      { label: 'Deposit held', value: formatMoney(client.depositHeldPaisa) },
    )
  }
  if (moneyScope(gctx) === 'full') {
    moneyFields.push(
      { label: 'Payments received', value: formatMoney(client.totalSpentPaisa) },
    )
  }
  if (moneyFields.length > 0) groups.push({ title: 'Money', fields: moneyFields })

  /*
   * §4.4 — the state itself is never gated, only its reason.
   *
   * Two rows, because Blocked and On Stop are two facts (Rulings §11.2).
   * Blocked is a `client_flags` row somebody set, so it still has a reason, a
   * setter and a date. **On Stop has none of those** — it is derived from credit
   * state, nobody sets it, and asking "set by whom" of a computed value is how
   * the old stored flag got here. Its explanation is the limb that fired.
   */
  groups.unshift({
    title: 'Credit control',
    fields: [
      { label: 'Blocked', value: stop.blocked ? 'Blocked from new bookings' : 'No' },
      ...(stop.blocked && canViewOnStopReason(gctx)
        ? ([
            { label: 'Block reason', value: client.blockReason ?? '—' },
          ] as IntelField[])
        : []),
      {
        label: 'On-Stop',
        /* Never "Clear" when no limb could run — that is the claim §11.2
           forbids, and it is what a money-blind session would otherwise read. */
        value: stop.onStop
          ? 'On Stop — no new bookings'
          : stop.indeterminate
            ? 'Check did not run on this record'
            : 'Clear',
      },
      ...(stop.onStop && stop.reasons.length
        ? ([{ label: 'Why', value: stop.reasons.join(' · ') }] as IntelField[])
        : []),
    ],
  })

  groups.push({
    title: 'Activity',
    fields: [
      ...(client.activeBookings ?? []).map((b): IntelField => ({ label: b, value: 'Currently booked', trigger: { label: 'Open', to: `/rentals/${b}` } })),
      { label: 'Last rental', value: (client.lastRentalBs ?? '—') === '—' ? 'No rental yet' : `${client.lastRentalBs} BS · ${client.lastRentalAd ?? '—'}` },
    ],
  })

  // Reliability [NEW] — counts visible to all staff; no ₨-recovered figure
  // exists in this data model yet, so there is nothing here to money-gate.
  //
  // Design-critique fix: damage/missing cases and a high late-return count
  // used to render as plain, uncoloured fields — the one Reliability block
  // in the app that skipped CLAUDE.md's "never colour alone" law every other
  // status indicator here follows. `damageCases`/`missingCases` map directly
  // onto `lib/status.ts`'s own doc for 'danger' ("Red — Overdue, Damaged,
  // Missing, Blocked. The only alarm colour."), so any count above zero gets
  // flagged. `lateReturns` has no ruled threshold anywhere in this file or
  // `bookingIntel.ts` (the closest precedent, `DISCOUNT_APPROVAL_THRESHOLD`,
  // is a money policy, not a risk one) — `>= 2` is a judgment call, not a
  // decision to cite, made because 1 late return in dozens of rentals reads
  // as noise while repeat lateness reads as a pattern.
  if (client.reliability) {
    const r = client.reliability
    groups.push({
      title: 'Reliability',
      fields: [
        riskField('Late returns', `${r.lateReturns} / ${r.totalReturns}`, r.lateReturns >= 2),
        riskField('Damage cases', String(r.damageCases), r.damageCases > 0),
        riskField('Missing cases', String(r.missingCases), r.missingCases > 0),
        { label: 'Avg days late', value: r.avgDaysLateOverall.toFixed(1) },
      ],
    })
  }

  if (canViewDocuments(gctx)) {
    groups.push({
      title: 'Documents',
      fields: [
        { label: 'KYC status', value: client.kycStatus },
        { label: 'Documents on file', value: String(client.kycDocsCount) },
      ],
    })
  }

  if (canViewNotes(gctx) && client.notes) {
    groups.push({ title: 'Notes', fields: [{ label: 'Internal note', value: client.notes }] })
  }

  return groups
}
</file>

