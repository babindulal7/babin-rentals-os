                          role="button"
                          aria-label={`Open ${client.name}'s profile`}
                          aria-pressed={isSelected}
                          tabIndex={0}
                          onClick={() => setSelectedClientId(isSelected ? null : client.id)}
                          onKeyDown={(e) => {
                            // Only the row itself opening/closing the profile
