const BEFORE_EVERYTHING = '2026-08-01T00:00:00.000Z'

const map = (overrides: Partial<BookingListRow> = {}, nowAd = BEFORE_EVERYTHING) =>
  toRentalListRow({ ...ROW, ...overrides }, nowAd)

describe('toRentalListRow — the columns that survived', () => {
