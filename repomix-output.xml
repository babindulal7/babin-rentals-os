function formatOperationBookingId(bookingNo: string | null | undefined): string {
  if (!bookingNo) return '—'
  const trimmed = bookingNo.trim()
  if (/^#?\d+$/.test(trimmed)) {
    const digits = trimmed.replace(/^#/, '')
    return `#${digits.padStart(4, '0')}`
  }
  return trimmed
}

