                    <Icon name="file" size={16} style={{ color: 'var(--text2)', flexShrink: 0 }} />
                    <span style={{ flex: 1, minWidth: 0, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', fontSize: 'var(--t-meta)', color: 'var(--text)' }}>
                      {d.file.name}
