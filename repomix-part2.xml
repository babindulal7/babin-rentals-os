import React, { createContext, useContext, useEffect, useState } from 'react'
import { syncEngine, type SyncState } from './syncEngine'
import { useToast } from '../components/ui/Toast'

interface SyncContextValue extends SyncState {
  triggerSync: () => Promise<void>
}

const SyncContext = createContext<SyncContextValue>({
  status: 'synced',
  pendingCount: 0,
  lastSyncTime: null,
  triggerSync: async () => {},
})

export const useSync = () => useContext(SyncContext)

export function SyncProvider({ children }: { children: React.ReactNode }) {
  const [syncState, setSyncState] = useState<SyncState>(syncEngine.getState())
  const { showSuccessToast } = useToast()

  useEffect(() => {
    const unsubscribe = syncEngine.subscribe((next) => {
      setSyncState(next)
    })
    syncEngine.refreshPendingCount()
    return unsubscribe
  }, [])

  const triggerSync = async () => {
    /* Law 12 — toasts carry successes only. The offline and failure outcomes
       land in SyncState (`status` / `error`), which syncAll writes before
       returning; the shell renders that inline and it persists until the next
       sync resolves it. Only the success gets a toast. */
    const res = await syncEngine.syncAll()
    if (res.success) {
      showSuccessToast('Sync Complete', 'Cloud database & local cache are 100% in sync.')
    }
  }

  return (
    <SyncContext.Provider value={{ ...syncState, triggerSync }}>
      {children}
    </SyncContext.Provider>
  )
}
</file>

<file path="src/lib/textSize.ts">
/**
 * **Text size — Foundation v2.2 §4.3.11.**
 *
 * > "Viewport width is a decent proxy for physical size but it cannot tell a
 * > 27-inch 1080p monitor from a 13-inch one, and it knows nothing about
 * > eyesight. So §4.3.6 handles the screen and this handles the person."
 *
 * One variable moves the whole application, because every size in §4.3.6 is
 * expressed in `rem` and the root multiplies by `--ui-scale`. **No component
 * opts in and none can opt out** — that is the point of putting it on the root
 * rather than threading a prop.
 *
 * It is **additive to browser zoom, not a replacement for it.** The root clamp
 * uses `rem + vw` rather than pure `vw` precisely so Ctrl+ keeps working
 * alongside this (WCAG 1.4.4).
 */

import { readLocal, writeLocal } from './safeStorage'

export type TextSize = 'compact' | 'default' | 'large'

export const TEXT_SIZES: Array<{ key: TextSize; label: string; scale: number; who: string }> = [
  { key: 'compact', label: 'Compact', scale: 0.9, who: 'Coordinator on a large desktop who wants more rows visible' },
  { key: 'default', label: 'Default', scale: 1, who: '' },
  { key: 'large', label: 'Large', scale: 1.15, who: 'Warehouse tablet, or anyone who wants it' },
]

export const TEXT_SIZE_KEY = 'br-text-size'

export function scaleOf(size: TextSize): number {
  return TEXT_SIZES.find((s) => s.key === size)?.scale ?? 1
}

export function readTextSize(): TextSize {
  /* Guarded — WebKit throws SecurityError on this access under Lockdown Mode
     or "Block All Cookies", where Chrome returns null. See `safeStorage.ts`. */
  const v = readLocal(TEXT_SIZE_KEY)
  return v === 'compact' || v === 'large' || v === 'default' ? v : 'default'
}

/**
 * §4.3.11 — "applied before first paint so nothing reflows on load." The same
 * write runs from an inline script in `index.html`; this is the runtime path
 * for when the user changes it.
 */
export function applyTextSize(size: TextSize): void {
  document.documentElement.style.setProperty('--ui-scale', String(scaleOf(size)))
  /* The scale is applied above regardless; only remembering it can fail. */
  writeLocal(TEXT_SIZE_KEY, size)
}
</file>

<file path="src/lib/theme.tsx">
import { createContext, useContext, useEffect, useState, type ReactNode } from 'react'
import { readLocal, writeLocal, onMediaChange } from './safeStorage'

/* RULING 2026-10-13: 'glass' = the Obsidian Glass hybrid (dark theme + glass
   style layer). Resolves to 'dark' so every `theme === 'dark'` branch keeps
   working; the look lives only in theme.css under [data-style='glass'].
   Revert = remove 'glass' here and the [data-style='glass'] blocks in theme.css.
   RULING 2026-10-13: 'glass-light' = the same glass finish on the light theme
   (frosted). Resolves to 'light'. Revert = remove 'glass-light' here, in
   index.html, and the [data-theme='light'][data-style='glass'] blocks. */
export type ThemeMode = 'system' | 'dark' | 'light' | 'high-contrast' | 'glass' | 'glass-light'
export type ResolvedTheme = 'dark' | 'light' | 'high-contrast'
/* RULING 2026-10-13: the three buttons every theme picker shows. Light and Dark
   pick the base and KEEP the glass finish; Glass turns the finish on or off on
   the current base. So Light + Glass = frosted, Dark + Glass = Obsidian. */
export type ThemeChoice = 'light' | 'dark' | 'glass'

interface ThemeCtx {
  mode: ThemeMode
  theme: ResolvedTheme
  /** The glass finish is on (either base). */
  glass: boolean
  setMode: (mode: ThemeMode) => void
  choose: (choice: ThemeChoice) => void
  toggle: () => void
}

const Ctx = createContext<ThemeCtx>({
  mode: 'system',
  theme: 'light',
  glass: false,
  setMode: () => {},
  choose: () => {},
  toggle: () => {},
})

const KEY = 'br-theme-mode'

const getSystemTheme = (): ResolvedTheme => {
  if (typeof window !== 'undefined' && window.matchMedia) {
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
  }
  return 'light'
}

export function ThemeProvider({ children, initial = 'light' }: { children: ReactNode; initial?: ResolvedTheme }) {
  const [mode, setModeState] = useState<ThemeMode>(() => {
    /*
     * DESIGN_DIRECTION_SPEC_v4.2 §2 — DEFAULT THEME = LIGHT.
     * Supersedes the 24 Aug dark-first ruling. Both themes stay; per-user toggle persists.
     */
    if (typeof window === 'undefined') return 'light'
    /* `readLocal`, not `localStorage.getItem` — this runs inside ThemeProvider's
       useState initializer, which is ABOVE every ErrorBoundary in the tree, and
       WebKit throws SecurityError on the property access under Lockdown Mode or
       "Block All Cookies". Unguarded, a preference lookup blanked the whole app
       on Apple devices. See `safeStorage.ts`. */
    const saved = readLocal(KEY) as ThemeMode | null
    return saved === 'dark' || saved === 'light' || saved === 'high-contrast' || saved === 'glass' || saved === 'glass-light' || saved === 'system' ? saved : 'light'
  })

  const [systemTheme, setSystemTheme] = useState<ResolvedTheme>(() => {
    const sys = getSystemTheme()
    return sys || initial
  })

  useEffect(() => {
    /* `MediaQueryList.addEventListener` is Safari 14+; 13 and earlier have only
       `addListener`, and calling the modern one there throws — in a mount
       effect above every ErrorBoundary, which is a blank page on an older iPad
       rather than a theme that fails to follow the system. */
    return onMediaChange('(prefers-color-scheme: dark)', (matches) =>
      setSystemTheme(matches ? 'dark' : 'light'),
    )
  }, [])

  const glass = mode === 'glass' || mode === 'glass-light'
  const theme: ResolvedTheme =
    mode === 'system' ? systemTheme : mode === 'glass' ? 'dark' : mode === 'glass-light' ? 'light' : mode

  useEffect(() => {
    document.documentElement.dataset['theme'] = theme
    if (glass) document.documentElement.dataset['style'] = 'glass'
    else delete document.documentElement.dataset['style']
    /* A device that cannot remember the theme still gets the theme. */
    writeLocal(KEY, mode)
  }, [mode, theme, glass])

  const setMode = (newMode: ThemeMode) => {
    setModeState(newMode)
  }

  const choose = (choice: ThemeChoice) => {
    if (choice === 'glass') {
      setModeState(glass ? (theme === 'light' ? 'light' : 'dark') : theme === 'light' ? 'glass-light' : 'glass')
    } else if (choice === 'light') {
      setModeState(glass ? 'glass-light' : 'light')
    } else {
      setModeState(glass ? 'glass' : 'dark')
    }
  }

  const toggle = () => {
    setModeState((m) => {
      const current = m === 'system' ? systemTheme : m
      if (current === 'light' || current === 'glass-light') return 'dark'
      if (current === 'dark') return 'glass'
      if (current === 'glass') return 'high-contrast'
      return 'light'
    })
  }

  return (
    <Ctx.Provider value={{ mode, theme, glass, setMode, choose, toggle }}>
      {children}
    </Ctx.Provider>
  )
}

export const useTheme = () => useContext(Ctx)
</file>

<file path="src/lib/useFirstRun.ts">
import { useEffect, useState } from 'react'

// Helper to detect first run and set a flag
export function useFirstRun(): { firstRun: boolean; setFirstRun: (value: boolean) => void } {
  const [firstRun, setFirstRun] = useState(true)

  useEffect(() => {
    const stored = localStorage.getItem('babin-first-run')
    if (stored === 'true') {
      setFirstRun(false)
    } else {
      // Mark as not first run after this effect
      localStorage.setItem('babin-first-run', 'true')
      setFirstRun(true) // Will be false on next mount
    }
  }, [])

  return { firstRun, setFirstRun }
}

// Onboarding step type
export interface OnboardingStep {
  id: string
  title: string
  description: string
  cta?: string
  onCTA?: () => void
}

const DEFAULT_STEPS: OnboardingStep[] = [
  {
    id: 'step1',
    title: 'Welcome to Babin Rentals OS',
    description: 'Manage equipment rentals, track inventory, and handle crew scheduling all in one place.',
  },
  {
    id: 'step2',
    title: 'Create Your First Rental',
    description: 'Start by adding a client, selecting equipment, and setting the rental dates.',
    cta: 'Start Now',
  },
  {
    id: 'step3',
    title: 'Set Delivery & Terms',
    description: 'Configure delivery type, pricing, and payment terms for your rental.',
  },
  {
    id: 'step4',
    title: 'You\'re All Set!',
    description: 'Begin renting equipment and managing your inventory. All data is saved to the cloud.',
  },
]

// Onboarding hook
export function useOnboarding(onComplete: () => void) {
  const { firstRun } = useFirstRun()
  const [currentStep, setCurrentStep] = useState(1)
  const [steps, setSteps] = useState<OnboardingStep[]>([])

  useEffect(() => {
    if (firstRun) {
      setSteps(DEFAULT_STEPS.map((s) => s.id === 'step2' ? { ...s, onCTA: () => setCurrentStep(3) } : s))
    }
  }, [firstRun])

  const completeOnboarding = () => {
    localStorage.setItem('babin-first-run', 'true')
    setCurrentStep(steps.length + 1)
    onComplete()
  }

  return {
    firstRun,
    currentStep,
    steps,
    completeOnboarding,
    isComplete: currentStep > steps.length,
  }
}
</file>

