<file path="src/lib/clientImportRecovery.ts">
import { IMPORT_TARGET_FIELDS, buildImportPreview, importClientValues, type ImportTargetField } from './clientImport'
import type { ClientImportEntry, ClientImportOutcome } from '../actions/clients/importClients'

export interface ClientImportRecoveryDraft {
  fileName: string
  rawRows: string[][]
  hasHeaderRow: boolean
  mapping: Record<number, ImportTargetField>
  skippedRows: number[]
  batch: ClientImportEntry[] | null
  outcomes: ClientImportOutcome[]
}
export interface ClientImportRecoveryResult { ok: boolean; error: string | null }
type RecoveryStorage = Pick<Storage, 'getItem' | 'setItem' | 'removeItem'>
const KEY = 'babin.clientImportRecovery.v1'
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
const object = (value: unknown): value is Record<string, unknown> => typeof value === 'object' && value !== null && !Array.isArray(value)
const same = (left: unknown, right: unknown): boolean => {
  if (!object(left) || !object(right)) return left === right
  const keys = Object.keys(left)
  return keys.length === Object.keys(right).length && keys.every(key => left[key] === right[key])
}
const exactKeys = (value: Record<string, unknown>, keys: string[]) => Object.keys(value).every(key => keys.includes(key))

/** Stored outcomes are progress hints only. Replay every immutable batch key through the server on resume. */
function validDraft(value: unknown): value is ClientImportRecoveryDraft {
  if (!object(value) || !exactKeys(value, ['fileName', 'rawRows', 'hasHeaderRow', 'mapping', 'skippedRows', 'batch', 'outcomes'])) return false
  if (typeof value.fileName !== 'string' || !value.fileName || typeof value.hasHeaderRow !== 'boolean') return false
  if (!Array.isArray(value.rawRows) || !value.rawRows.length || !value.rawRows.every(row => Array.isArray(row) && row.every(cell => typeof cell === 'string'))) return false
  const rawRows = value.rawRows as string[][]
  const dataRows = value.hasHeaderRow ? rawRows.slice(1) : rawRows
  const columns = rawRows[0]?.length ?? 0
  if (!object(value.mapping) || !Object.entries(value.mapping).every(([index, target]) => /^(0|[1-9]\d*)$/.test(index) && Number(index) < columns && IMPORT_TARGET_FIELDS.some(field => field.key === target))) return false
  const validIndex = (index: unknown): index is number => typeof index === 'number' && Number.isInteger(index) && index >= 0 && index < dataRows.length
  if (!Array.isArray(value.skippedRows) || !value.skippedRows.every(validIndex) || new Set(value.skippedRows).size !== value.skippedRows.length) return false
  if (!Array.isArray(value.outcomes) || (value.batch !== null && !Array.isArray(value.batch))) return false
  if (value.batch === null) return value.outcomes.length === 0
  if (!value.batch.length) return false
  const preview = buildImportPreview(dataRows, value.mapping as Record<number, ImportTargetField>, [], new Set(value.skippedRows))
  const keys = new Set<string>(), indices = new Set<number>()
  for (const row of value.batch) {
    if (!object(row) || !exactKeys(row, ['rowIndex', 'clientUuid', 'values']) || !validIndex(row.rowIndex) || typeof row.clientUuid !== 'string' || !UUID.test(row.clientUuid) || indices.has(row.rowIndex) || keys.has(row.clientUuid.toLowerCase())) return false
    const source = preview[row.rowIndex]
    if (!source?.record || source.skip || source.errors.length || !same(row.values, importClientValues(source.record))) return false
    keys.add(row.clientUuid.toLowerCase()); indices.add(row.rowIndex)
  }
  const outcomes = new Set<number>()
  for (const row of value.outcomes) {
    if (!object(row) || !exactKeys(row, ['rowIndex', 'status', 'clientId', 'clientCode', 'message']) || !validIndex(row.rowIndex) || !indices.has(row.rowIndex) || outcomes.has(row.rowIndex) || !['saved', 'failed', 'unconfirmed', 'pending'].includes(String(row.status))) return false
    if (['clientId', 'clientCode', 'message'].some(key => row[key] !== undefined && typeof row[key] !== 'string')) return false
    if (row.status === 'saved' && (!row.clientId || !row.clientCode)) return false
    outcomes.add(row.rowIndex)
  }
  return true
}

function storageOrBrowser(storage?: RecoveryStorage): RecoveryStorage { return storage ?? window.localStorage }
const failure = (): ClientImportRecoveryResult => ({ ok: false, error: 'This browser could not preserve the unfinished import. Keep this page open and retry recovery before saving.' })

/** One active draft bounds storage; unchanged state produces no storage write. No retention policy is invented. */
export function saveClientImportRecovery(actorId: string, draft: ClientImportRecoveryDraft, storage?: RecoveryStorage): ClientImportRecoveryResult {
  if (!actorId || !validDraft(draft)) return { ok: false, error: 'The import recovery data is invalid. Review the file before saving.' }
  try {
    const target = storageOrBrowser(storage)
    const encoded = JSON.stringify({ version: 1, actorId, draft })
    if (target.getItem(KEY) !== encoded) target.setItem(KEY, encoded)
    return { ok: true, error: null }
  } catch { return failure() }
}

export function discardClientImportRecovery(_actorId: string, storage?: RecoveryStorage): ClientImportRecoveryResult {
  try { storageOrBrowser(storage).removeItem(KEY); return { ok: true, error: null } } catch { return failure() }
}

export function loadClientImportRecovery(actorId: string, storage?: RecoveryStorage): { draft: ClientImportRecoveryDraft | null; error: string | null } {
  try {
    const target = storageOrBrowser(storage), encoded = target.getItem(KEY)
    if (!encoded) return { draft: null, error: null }
    let stored: unknown
    try { stored = JSON.parse(encoded) } catch { target.removeItem(KEY); return { draft: null, error: 'The unfinished import could not be read. Choose the CSV file again.' } }
    // Different actors never see names, contacts, filenames or row outcomes from the previous session.
    if (!actorId || !object(stored) || stored.actorId !== actorId) { target.removeItem(KEY); return { draft: null, error: null } }
    if (stored.version !== 1 || !exactKeys(stored, ['version', 'actorId', 'draft']) || !validDraft(stored.draft)) {
      target.removeItem(KEY)
      return { draft: null, error: 'The unfinished import is invalid. Choose the CSV file again.' }
    }
    return { draft: stored.draft, error: null }
  } catch { return { draft: null, error: failure().error } }
}
</file>

<file path="src/lib/documentStorage.ts">
import { formatAd } from './bs'
import { supabase, IS_MOCK } from './supabase'

/**
 * =============================================================================
 * documentStorage.ts — AUD-010 (P2)
 *
 * Connect PDF generation to Supabase Storage bucket `documents`.
 * Generates compliant PDF blobs for commercial/operational documents
 * (Tax Invoices, Rental Agreements, Quotations, Delivery Notes, etc.)
 * and uploads them to Supabase Storage with signed URL generation.
 * =============================================================================
 */

export const DOCUMENTS_STORAGE_BUCKET = 'documents'

export interface GeneratePdfOptions {
  documentNo: string
  title: string
  docType: string
  party?: string | undefined
  bookingNo?: string | undefined
  dateStr?: string | undefined
  lines?: Array<{
    description: string
    qty?: number | undefined
    rate?: string | number | undefined
    total?: string | number | undefined
  }> | undefined
  totalAmount?: string | number | undefined
}

export interface StoredDocumentResult {
  documentNo: string
  docType: string
  storagePath: string
  signedUrl: string
  fileSizeBytes: number
  publicUrl?: string | undefined
}

/**
 * Escapes characters for PDF literal strings `( ... )`.
 */
function escapePdfText(text: string): string {
  return text
    .replace(/\\/g, '\\\\')
    .replace(/\(/g, '\\(')
    .replace(/\)/g, '\\)')
    .replace(/[\r\n]+/g, ' ')
}

/**
 * Builds a clean, compliant PDF 1.4 binary byte array.
 * Contains page dimensions, Helvetica font definitions, and formatted stream text.
 */
export function buildPdfByteArray(lines: string[]): Uint8Array {
  // Build stream content: text drawing instructions
  // Origin is bottom-left (0,0), standard 8.5x11 inch page = 612 x 792 points.
  let streamBody = 'BT\n/F1 12 Tf\n54 738 Td\n18 TL\n'
  for (const line of lines) {
    if (line.startsWith('### ')) {
      streamBody += `/F1 16 Tf (${escapePdfText(line.slice(4))}) Tj /F1 12 Tf T*\n`
    } else if (line.startsWith('## ')) {
      streamBody += `/F1 14 Tf (${escapePdfText(line.slice(3))}) Tj /F1 12 Tf T*\n`
    } else if (line.startsWith('---')) {
      streamBody += '0 -6 Td (______________________________________________________________________________) Tj 0 6 Td T*\n'
    } else if (line.trim() === '') {
      streamBody += 'T*\n'
    } else {
      streamBody += `(${escapePdfText(line)}) Tj T*\n`
    }
  }
  streamBody += 'ET\n'

  const encoder = new TextEncoder()
  const streamBytes = encoder.encode(streamBody)

  // PDF Structure:
  // Obj 1: Catalog
  // Obj 2: Pages
  // Obj 3: Page
  // Obj 4: Font (Helvetica)
  // Obj 5: Stream Content
  const header = '%PDF-1.4\n'

  const obj1 = '1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n'
  const obj2 = '2 0 obj\n<< /Type /Pages /Kids [3 0 R] /Count 1 >>\nendobj\n'
  const obj3 =
    '3 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 5 0 R /Resources << /Font << /F1 4 0 R >> >> >>\nendobj\n'
  const obj4 = '4 0 obj\n<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>\nendobj\n'

  const obj5Prefix = `5 0 obj\n<< /Length ${streamBytes.byteLength} >>\nstream\n`
  const obj5Suffix = '\nendstream\nendobj\n'

  const partsBeforeStream = encoder.encode(header + obj1 + obj2 + obj3 + obj4 + obj5Prefix)
  const partsAfterStreamText = obj5Suffix

  // Calculate offsets for xref
  const offset1 = encoder.encode(header).byteLength
  const offset2 = offset1 + encoder.encode(obj1).byteLength
  const offset3 = offset2 + encoder.encode(obj2).byteLength
  const offset4 = offset3 + encoder.encode(obj3).byteLength
  const offset5 = offset4 + encoder.encode(obj4).byteLength

  const streamEndOffset = partsBeforeStream.byteLength + streamBytes.byteLength + encoder.encode(partsAfterStreamText).byteLength

  const xref =
    `xref\n0 6\n` +
    `0000000000 65535 f \n` +
    `${String(offset1).padStart(10, '0')} 00000 n \n` +
    `${String(offset2).padStart(10, '0')} 00000 n \n` +
    `${String(offset3).padStart(10, '0')} 00000 n \n` +
    `${String(offset4).padStart(10, '0')} 00000 n \n` +
    `${String(offset5).padStart(10, '0')} 00000 n \n`

  const trailer = `trailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n${streamEndOffset}\n%%EOF\n`

  const trailerBytes = encoder.encode(xref + trailer)

  // Concatenate all bytes
  const totalLength = partsBeforeStream.byteLength + streamBytes.byteLength + encoder.encode(partsAfterStreamText).byteLength + trailerBytes.byteLength
  const result = new Uint8Array(totalLength)

  let offset = 0
  result.set(partsBeforeStream, offset)
  offset += partsBeforeStream.byteLength

  result.set(streamBytes, offset)
  offset += streamBytes.byteLength

  const afterBytes = encoder.encode(partsAfterStreamText)
  result.set(afterBytes, offset)
  offset += afterBytes.byteLength

  result.set(trailerBytes, offset)
  return result
}

/**
 * Generates a document PDF Blob from metadata and line items.
 */
export function generateDocumentPdfBlob(options: GeneratePdfOptions): Blob {
  const dateStr = options.dateStr ? (/^\d{4}-\d{2}-\d{2}/.test(options.dateStr) ? formatAd(new Date(options.dateStr)) : options.dateStr) : formatAd(new Date())
  const contentLines: string[] = [
    '============================================================',
    `                 BABIN RENTALS OS — ${options.docType.toUpperCase()}`,
    '============================================================',
    '',
    `Document Number: ${options.documentNo}`,
    `Date of Issue:   ${dateStr}`,
    options.bookingNo ? `Booking Ref:     ${options.bookingNo}` : '',
    options.party ? `Party:           ${options.party}` : '',
    `Title:           ${options.title}`,
    '',
    '------------------------------------------------------------',
    'DESCRIPTION                     QTY      RATE         TOTAL',
    '------------------------------------------------------------',
  ]

  if (options.lines && options.lines.length > 0) {
    for (const line of options.lines) {
      const desc = (line.description || 'Item').padEnd(30).substring(0, 30)
      const qty = String(line.qty ?? 1).padStart(4)
      const rate = String(line.rate ?? 0).padStart(9)
      const total = String(line.total ?? 0).padStart(12)
      contentLines.push(`${desc} ${qty}  ${rate}  ${total}`)
    }
  } else {
    contentLines.push('No line items recorded.')
  }

  contentLines.push('---')
  if (options.totalAmount !== undefined) {
    contentLines.push(`Total Amount:   NPR ${options.totalAmount}`)
    contentLines.push('---')
  }

  contentLines.push('')
  contentLines.push('Authorized Signature: _______________________      Date: _______________')
  contentLines.push('')
  contentLines.push('Babin Rentals · Kathmandu, Nepal · info@babinrentals.com')

  const byteArray = buildPdfByteArray(contentLines.filter((l) => l !== undefined))
  return new Blob([byteArray as unknown as BlobPart], { type: 'application/pdf' })
}

interface StorageBucketClient {
  upload: (path: string, file: Blob | ArrayBuffer | string, options?: { contentType?: string; upsert?: boolean; cacheControl?: string; duplex?: 'half' | 'full' }) => Promise<{ data: { path: string; fullPath: string; id?: string } | null; error: Error | null }>
  createSignedUrl: (path: string, expiresIn: number, options?: { download?: boolean; transform?: { width: number; height: number; resize: 'cover' | 'contain' | 'fill' } }) => Promise<{ data: { signedUrl: string } | null; error: Error | null }>
  download: (path: string, options?: { transform?: { width: number; height: number; resize: 'cover' | 'contain' | 'fill' } }) => Promise<{ data: Blob | null; error: Error | null }>
  getPublicUrl: (path: string) => { data: { publicUrl: string } }
  list: (folder?: string, options?: { limit?: number; offset?: number; sortBy?: { column: string; order: 'asc' | 'desc' } }) => Promise<{ data: Array<{ name: string; id: string; updated_at: string; created_at: string; last_accessed_at: string; metadata: Record<string, unknown> }> | null; error: Error | null }>
  remove: (paths: string[]) => Promise<{ data: Array<{ name: string }> | null; error: Error | null }>
  move: (fromPath: string, toPath: string) => Promise<{ data: { path: string } | null; error: Error | null }>
  copy: (fromPath: string, toPath: string) => Promise<{ data: { path: string } | null; error: Error | null }>
}

function getBucketStorageClient(): StorageBucketClient {
  if (IS_MOCK) {
    throw new Error('Mock mode not supported for document storage. Use real Supabase client.')
  }
  const client = supabase!
  if (!client.storage || typeof client.storage.from !== 'function') {
    throw new Error('Supabase storage client not available')
  }
  return client.storage.from(DOCUMENTS_STORAGE_BUCKET) as unknown as StorageBucketClient
}

/**
 * Uploads a document payload to Supabase Storage bucket `documents`
 * and creates a signed URL.
 */
export async function uploadDocumentToStorage(options: {
  docType: string
  documentNo: string
  content: Blob | ArrayBuffer | string
  mimeType?: string | undefined
}): Promise<StoredDocumentResult> {
  const { data: identity, error: authError } = await supabase.auth.getUser()
  if (authError || !identity.user) throw new Error('Sign in before uploading a document.')
  const cleanDocNo = options.documentNo.replace(/[^a-zA-Z0-9_-]/g, '_')
  const storagePath = `staff/${identity.user.id}/${cleanDocNo}_${crypto.randomUUID()}.pdf`

  const contentType = options.mimeType || 'application/pdf'
  const storage = getBucketStorageClient()

  // 1. Upload to Supabase Storage
  const { error: uploadError } = await storage.upload(storagePath, options.content, {
    contentType,
  })

  if (uploadError) {
    throw new Error(`Failed to upload document to storage: ${uploadError.message || 'Unknown upload failure'}`)
  }

  // 2. Generate signed URL (valid for 7 days = 604,800 seconds)
  const { data: signedData, error: signError } = await storage.createSignedUrl(
    storagePath,
    60 * 60 * 24 * 7,
  )

  if (signError || !signedData?.signedUrl) {
    throw new Error('Document upload completed, but secure viewing could not be confirmed. Retry access without replacing the stored file.')
  }
  const signedUrl = signedData.signedUrl

  let fileSizeBytes = 0
  if (options.content instanceof Blob) {
    fileSizeBytes = options.content.size
  } else if (typeof options.content === 'string') {
    fileSizeBytes = new TextEncoder().encode(options.content).byteLength
  } else if (options.content instanceof ArrayBuffer) {
    fileSizeBytes = options.content.byteLength
  }

  return {
    documentNo: options.documentNo,
    docType: options.docType,
    storagePath,
    signedUrl,
    fileSizeBytes,
  }
}

/**
 * Generates PDF bytes and uploads directly to Supabase Storage in one step.
 */
export async function generateAndStoreDocumentPdf(
  options: GeneratePdfOptions,
): Promise<StoredDocumentResult> {
  const pdfBlob = generateDocumentPdfBlob(options)
  return uploadDocumentToStorage({
    docType: options.docType,
    documentNo: options.documentNo,
    content: pdfBlob,
    mimeType: 'application/pdf',
  })
}

/**
 * Retrieves a fresh signed URL for an existing storage path.
 */
export async function getDocumentSignedUrl(
  storagePath: string,
  expiresInSeconds = 60 * 60 * 24 * 7,
): Promise<string | null> {
  const storage = getBucketStorageClient()
  const { data, error } = await storage.createSignedUrl(storagePath, expiresInSeconds)
  if (!error && data?.signedUrl) {
    return data.signedUrl
  }
  console.warn(`Could not create signed URL for ${storagePath}:`, error?.message)
  return null
}

/**
 * Downloads a document from Supabase Storage.
 */
export async function downloadDocumentFromStorage(
  storagePath: string,
): Promise<{ data: Blob | null; error: Error | { message: string } | null }> {
  const storage = getBucketStorageClient()
  return storage.download(storagePath)
}
</file>

<file path="src/lib/evidenceStorage.ts">
import { supabase, IS_MOCK } from './supabase'
import { generateClientUuid } from './dataAccess'
import type { Database } from '../types/supabase'

/** A private bucket installed by a reviewed database migration, never from the browser. */
export const EVIDENCE_STORAGE_BUCKET = 'evidence'

type EvidenceCategory = Database['public']['Enums']['evidence_category']
type SessionStage = 'Packing' | 'Pickup' | 'Delivery' | 'Return'

/**
 * A session is compulsory for operational evidence. A booking number or a
 * transport plan is not a valid session ID or booking foreign key.
 */
export interface EvidenceSessionReference {
  bookingId: string
  sessionId: string
  operationStage: SessionStage
}

export interface UploadEvidencePhotoOptions {
  file: Blob | File
  filename: string
  category: EvidenceCategory
  reference: EvidenceSessionReference
  /** An authenticated application users.id; database RLS remains authoritative. */
  userId: string
  /** Preserve on retries of the SAME action; never generate a fresh retry key. */
  clientUuid?: string | undefined
}

export interface StoredEvidencePhotoResult {
  id: string
  referenceId: string
  storagePath: string
  /** A temporary viewing link, not evidence of persistence. */
  signedUrl: string | null
  filename: string
  fileSizeBytes: number
  contentHash: string
}

const ACCEPTED_IMAGE_FORMATS: Readonly<Record<string, string>> = {
  'image/jpeg': 'jpg',
  'image/png': 'png',
  'image/webp': 'webp',
}

function assertUuid(value: string, label: string): void {
  if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(value)) {
    throw new Error(`${label} must be a database UUID, not a display identifier`)
  }
}

function assertLiveStorage(): void {
  if (IS_MOCK) throw new Error('Evidence upload requires an authenticated live backend')
  if (!supabase?.storage || typeof supabase.storage.from !== 'function') {
    throw new Error('Evidence storage is unavailable')
  }
}

async function sha256(blob: Blob): Promise<string> {
  if (typeof crypto === 'undefined' || !crypto.subtle) {
    throw new Error('Secure browser hashing is unavailable; evidence was not uploaded')
  }
  const hash = await crypto.subtle.digest('SHA-256', await blob.arrayBuffer())
  return Array.from(new Uint8Array(hash), (x) => x.toString(16).padStart(2, '0')).join('')
}

/**
 * Fail-closed upload of a session-anchored JPEG/PNG/WebP.
 * Returns only when BOTH the physical evidence_files row and its
 * evidence_references link have been confirmed by the backend.
 *
 * This is an online-only operation. A storage object by itself is NOT a
 * completed evidence record. Reuse clientUuid when retrying an unknown result.
 * Data left in storage by an ambiguous network failure requires reconciliation;
 * it is not safe for the browser to silently delete possibly committed proof.
 */
export async function uploadEvidencePhoto(
  options: UploadEvidencePhotoOptions,
): Promise<StoredEvidencePhotoResult> {
  assertLiveStorage()
  const { file, reference } = options
  if (!(file instanceof Blob) || file.size === 0) throw new Error('Choose a non-empty image')
  const format = ACCEPTED_IMAGE_FORMATS[file.type]
  if (!format) throw new Error('Evidence photos must be JPEG, PNG, or WebP')
  if (!options.filename.trim()) throw new Error('Evidence filename is required')
  assertUuid(options.userId, 'User ID')
  assertUuid(reference.bookingId, 'Booking ID')
  assertUuid(reference.sessionId, 'Session ID')
  if (!(['Packing', 'Pickup', 'Delivery', 'Return'] as string[]).includes(reference.operationStage)) {
    throw new Error('Unsupported evidence operation stage')
  }
  const clientUuid = options.clientUuid ?? generateClientUuid()
  assertUuid(clientUuid, 'Evidence retry ID')

  const expectedOperation = reference.operationStage === 'Packing'
    ? 'Packing'
    : reference.operationStage === 'Return'
      ? 'Return'
      : 'Handover'
  const { data: session, error: sessionError } = await supabase
    .from('operation_sessions')
    .select('id, booking_id, operation, state')
    .eq('id', reference.sessionId)
    .single()
  if (sessionError || !session) throw new Error(`Could not verify the evidence session: ${sessionError?.message ?? 'not found'}`)
  if (session.booking_id !== reference.bookingId || session.operation !== expectedOperation) {
    throw new Error('Evidence session does not match the booking and operation')
  }

  const digest = await sha256(file)
  const { data: byKey, error: keyError } = await supabase
    .from('evidence_files').select('id, storage_path, content_hash')
    .eq('client_uuid', clientUuid).maybeSingle()
  if (keyError) throw new Error(`Could not verify evidence retry key: ${keyError.message}`)
  if (byKey && byKey.content_hash !== digest) {
    throw new Error('Evidence retry ID was already used for different image bytes')
  }
  const { data: byHash, error: hashError } = await supabase
    .from('evidence_files').select('id, storage_path, content_hash')
    .eq('content_hash', digest).maybeSingle()
  if (hashError) throw new Error(`Could not check evidence hash: ${hashError.message}`)
  if (byKey && byHash && byKey.id !== byHash.id) {
    throw new Error('Conflicting evidence records; manual reconciliation required')
  }

  let evidence: { id: string; storage_path: string } | null = byKey ?? byHash
  if (!evidence && session.state === 'Completed') {
    throw new Error('Completed handover sessions are sealed; new evidence cannot be attached')
  }

  const storage = supabase.storage.from(EVIDENCE_STORAGE_BUCKET)
  if (!evidence) {
    const cleanName = options.filename.trim().replace(/[^a-zA-Z0-9._-]/g, '_').slice(0, 120)
    const storagePath = `${reference.bookingId}/${reference.sessionId}/${clientUuid}_${cleanName}`
    const { data: uploaded, error: uploadError } = await storage.upload(storagePath, file, {
      contentType: file.type,
      upsert: false,
    })
    if (uploadError || !uploaded || uploaded.path !== storagePath) {
      throw new Error(`Evidence image was not confirmed in private storage: ${uploadError?.message ?? 'invalid upload response'}`)
    }

    const { data: recorded, error: recordError } = await supabase
      .from('evidence_files')
      .insert({
        id: clientUuid,
        client_uuid: clientUuid,
        content_hash: digest,
        storage_path: storagePath,
        original_filename: options.filename,
        media_type: 'Image',
        format,
        size_bytes: file.size,
        category: options.category,
        created_by: options.userId,
      })
      .select('id, storage_path').single()
    if (recordError || !recorded) {
      // The INSERT response may be lost AFTER commit. Never delete on an
      // ambiguous response; surface a failure and allow safe same-key retry.
      throw new Error(`Evidence metadata was not confirmed; retry with the same ID: ${recordError?.message ?? 'empty response'}`)
    }
    evidence = recorded
  }

  const { data: alreadyLinked, error: lookupError } = await supabase
    .from('evidence_references').select('id, booking_id, item_id')
    .eq('evidence_file_id', evidence.id)
    .eq('operation_stage', reference.operationStage)
    .eq('session_id', reference.sessionId)
    .maybeSingle()
  if (lookupError) throw new Error(`Could not verify evidence session link: ${lookupError.message}`)

  if (alreadyLinked && (alreadyLinked.booking_id !== reference.bookingId || alreadyLinked.item_id != null)) {
    throw new Error('Existing evidence link does not match the requested session scope')
  }
  let referenceId = alreadyLinked?.id
  if (!referenceId) {
    if (session.state === 'Completed') {
      throw new Error('The session was sealed before evidence could be linked')
    }
    const linkId = generateClientUuid()
    const { data: linked, error: linkError } = await supabase
      .from('evidence_references')
      .insert({
        id: linkId,
        client_uuid: linkId,
        evidence_file_id: evidence.id,
        operation_stage: reference.operationStage,
        session_id: reference.sessionId,
        booking_id: reference.bookingId,
        created_by: options.userId,
      })
      .select('id').single()
    if (linkError || !linked) {
      throw new Error(`Evidence session link was not confirmed; retry with the same ID: ${linkError?.message ?? 'empty response'}`)
    }
    referenceId = linked.id
  }

  // A viewing URL is optional and expires. A failure here does not undermine
  // the separately confirmed storage + metadata + session reference records.
  let signedUrl: string | null = null
  try {
    const { data, error } = await storage.createSignedUrl(evidence.storage_path, 60 * 60)
    if (!error && data?.signedUrl) signedUrl = data.signedUrl
  } catch {
    // Re-request later via getEvidenceSignedUrl(). Do not invent a local URL.
  }

  return {
    id: evidence.id,
    referenceId,
    storagePath: evidence.storage_path,
    signedUrl,
    filename: options.filename,
    fileSizeBytes: file.size,
    contentHash: digest,
  }
}

export async function getEvidenceSignedUrl(
  storagePath: string,
  expiresInSeconds = 60 * 60,
): Promise<string | null> {
  assertLiveStorage()
  if (!storagePath.trim() || expiresInSeconds < 1) return null
  const { data, error } = await supabase.storage.from(EVIDENCE_STORAGE_BUCKET)
    .createSignedUrl(storagePath, expiresInSeconds)
  return !error ? data?.signedUrl ?? null : null
}
</file>

<file path="src/lib/floorScanStorage.ts">
/**
 * Floor Scan Storage Adapter & Scan Event Queue
 *
 * Persists active warehouse floor scanning sessions (Packing, Handover & Return/Inspection)
 * in storage and queues non-custodial scan events into Dexie IndexedDB outbox.
 *
 * Enforces:
 *  - Technicians never lose scanned serials or inspection notes across tab disconnects.
 *  - Non-custodial barcode scan events are queued offline via Dexie with client_uuid idempotency keys.
 *  - Custodial stage transitions remain fail-closed online RPCs (Law 1, Rule R-40).
 */

import { enqueueMutation, drainQueue } from './offlineQueue'
import { newClientUuid, IS_MOCK } from './supabase'

export type FloorVerb = 'pack' | 'return' | 'handover'

export interface FloorScanRecord<T> {
  bookingId: string
  verb: FloorVerb
  savedAt: string
  payload: T
}

const STORAGE_PREFIX = 'babin-rentals:floor-scan'

// In-memory fallback if localStorage is restricted (e.g. private browsing or sandbox)
const memoryStore = new Map<string, string>()

function storageKey(verb: FloorVerb, bookingId: string): string {
  return `${STORAGE_PREFIX}:${verb}:${bookingId}`
}

function getStorageItem(key: string): string | null {
  try {
    if (typeof window !== 'undefined' && window.localStorage) {
      return window.localStorage.getItem(key)
    }
  } catch {
    // Local storage access blocked or unavailable
  }
  return memoryStore.get(key) ?? null
}

function setStorageItem(key: string, value: string): void {
  try {
    if (typeof window !== 'undefined' && window.localStorage) {
      window.localStorage.setItem(key, value)
      return
    }
  } catch {
    // Quota exceeded or storage unavailable
  }
  memoryStore.set(key, value)
}

function removeStorageItem(key: string): void {
  try {
    if (typeof window !== 'undefined' && window.localStorage) {
      window.localStorage.removeItem(key)
      return
    }
  } catch {
    // Storage unavailable
  }
  memoryStore.delete(key)
}

/**
 * Saves the in-progress floor scanning payload for a booking.
 */
export function saveFloorScan<T>(verb: FloorVerb, bookingId: string, payload: T): void {
  if (!bookingId) return
  const record: FloorScanRecord<T> = {
    bookingId,
    verb,
    savedAt: new Date().toISOString(),
    payload,
  }
  try {
    setStorageItem(storageKey(verb, bookingId), JSON.stringify(record))
  } catch {
    // Ignore serialization issues
  }
}

/**
 * Loads any persisted in-progress floor scan for a booking.
 * Returns null if no valid record exists.
 */
export function loadFloorScan<T>(verb: FloorVerb, bookingId: string): FloorScanRecord<T> | null {
  if (!bookingId) return null
  const raw = getStorageItem(storageKey(verb, bookingId))
  if (!raw) return null
  try {
    const parsed = JSON.parse(raw) as FloorScanRecord<T>
    if (parsed && parsed.bookingId === bookingId && parsed.verb === verb && parsed.payload !== undefined) {
      return parsed
    }
  } catch {
    // Corrupted record
  }
  return null
}

/**
 * Clears the persisted scanning session when completed or explicitly discarded.
 */
export function clearFloorScan(verb: FloorVerb, bookingId: string): void {
  if (!bookingId) return
  removeStorageItem(storageKey(verb, bookingId))
}

export interface FloorScanEventParams {
  bookingId: string
  context: 'packing' | 'handover' | 'return' | 'lookup' | 'stock_check'
  code: string
  codeType?: 'barcode' | 'qr_code' | 'manual_entry' | 'rfid'
  result?: 'accepted' | 'rejected' | 'warning' | 'override'
  resultReason?: string | null
  resolvedUnitId?: string | null
  sessionId?: string | null
  deviceId?: string
}

/**
 * Records a non-custodial scan event into the Dexie offline queue (Law 8).
 * Replays automatically via drainQueue() when network connectivity is present.
 */
export async function recordFloorScanEvent(params: FloorScanEventParams): Promise<boolean> {
  const clientUuid = newClientUuid()
  const payload = {
    client_uuid: clientUuid,
    context: params.context,
    booking_id: params.bookingId,
    session_id: params.sessionId ?? null,
    code: params.code,
    code_type: params.codeType ?? 'barcode',
    resolved_unit_id: params.resolvedUnitId ?? null,
    result: params.result ?? 'accepted',
    result_reason: params.resultReason ?? null,
    scanned_at: new Date().toISOString(),
    queued_offline: typeof navigator !== 'undefined' ? !navigator.onLine : false,
    device_id: params.deviceId ?? (typeof navigator !== 'undefined' ? navigator.userAgent.slice(0, 50) : 'device-web'),
  }

  try {
    const enqueued = await enqueueMutation('scan_events', 'insert', payload, clientUuid)
    if (typeof navigator !== 'undefined' && navigator.onLine && !IS_MOCK) {
      void drainQueue().catch(() => {})
    }
    return enqueued
  } catch (err) {
    console.warn('[FloorScanStorage] Non-critical: could not queue scan event', err)
    return false
  }
}
