/**
 * **Colour — DESIGN_DIRECTION_SPEC_v4.1 §2/§4. Seven hues + gold.**
 *
 * v4.1 replaced the 28 Jul five-colour law. The reasoning that produced "five
 * plus gold" was about *distinguishability* — nine arbitrary hues do not
 * survive a warehouse tablet in daylight. v4.1 keeps that constraint and
 * spends the budget differently: seven hues, each with **exactly one meaning**,
 * so a shelf or a queue can be read by colour before any word is.
 *
 *   blue   committed / scheduled
 *   yellow being worked in-house / waiting
 *   green  home & ready / coming home / settled
 *   orange out with the client        <- On Rent moved here from green
 *   red    problem / money owed / decide now
 *   gray   not started yet
 *   dim    finished / inactive
 *
 * Two things changed that this file is the single point of enforcement for:
 *
 *  1. **Every status is a SOLID block.** The 24 Aug morning solid-vs-outline
 *     fill rule is dead. Gold is the only outline left on screen.
 *  2. **On Rent is ORANGE, Returned is GREEN.** The lifecycle now reads
 *     gray -> blue -> yellow -> orange (gear is out) -> green (safely home)
 *     -> dim. Green stopped meaning "out" and started meaning "home", which is
 *     what the floor actually cares about.
 *
 * Purple is gone. It had been reserved for Sub-Rental; v4.1 makes Sub-Rental
 * the gold OUTLINE mark, so the hue is retired rather than re-pointed.
 *
 * Each key resolves to a CSS variable pair that `styles/theme.css` redefines
 * per theme, so a component never branches on theme and never hardcodes a
 * colour. §7.4 still holds: colour is never the sole carrier — every block
 * renders its word, and STATUS_ICON below keeps the icon part of the token.
 */
import type { IconName } from '../components/ui/Icon'
import type { PaymentStatus } from '../types/database'

export type StatusKey =
  /** Gray, solid — Quote, Draft. "Not started yet." */
  | 'neutral'
  /** Blue, solid — Booked, Reserved, Issued. "Committed / scheduled." */
  | 'primary'
  /** Yellow, solid — Packed, Due Soon, Partial, Cleaning, Maintenance, Reset, QC. */
  | 'progress'
  /** Orange, solid — On Rent, Picked Up, Partial Pickup. "Out with the client." */
  | 'out'
  /** Green, solid — Returned, Available, Returning, Paid. "Home & settled." */
  | 'in'
  /** Red, solid — Overdue, Damaged, Unpaid, Blocked. The only alarm colour. */
  | 'danger'
  /** Dim, solid — Closed, Void, Retired, Deactivated. "Finished / inactive." */
  | 'dim'
  /** Gold, **outline only** — sub-rented / external gear. Never a status. */
  | 'ext'

export interface StatusTokens {
  bg: string
  fg: string
  /**
   * §2 — gold is the ONE outline on screen, so `ext` is the only key that
   * carries a border. Everything else is a solid block (§4).
   */
  border?: string
}

export const STATUS: Record<StatusKey, StatusTokens> = {
  neutral: { bg: 'var(--st-neutral-bg)', fg: 'var(--st-neutral-fg)', border: 'var(--st-neutral-border)' },
  primary: { bg: 'var(--st-primary-bg)', fg: 'var(--st-primary-fg)', border: 'var(--st-primary-border)' },
  progress: { bg: 'var(--st-progress-bg)', fg: 'var(--st-progress-fg)', border: 'var(--st-progress-border)' },
  out: { bg: 'var(--st-out-bg)', fg: 'var(--st-out-fg)', border: 'var(--st-out-border)' },
  in: { bg: 'var(--st-in-bg)', fg: 'var(--st-in-fg)', border: 'var(--st-in-border)' },
  danger: { bg: 'var(--st-danger-bg)', fg: 'var(--st-danger-fg)', border: 'var(--st-danger-border)' },
  dim: { bg: 'var(--st-dim-bg)', fg: 'var(--st-dim-fg)', border: 'var(--st-dim-border)' },
  ext: { bg: 'var(--select-bg)', fg: 'var(--select-fg)', border: 'var(--ext-line)' },
}

/**
 * NOTE ON THE KEY NAME. v4.1 §7.5 is explicit that the spec "recolours them,
 * it does not rename them", so the yellow key keeps the name `progress` even
 * though v4.1 calls the hue "ready". The key is an internal identifier read by
 * ~195 call sites; the *colour* is what changed. Renaming it would have been a
 * mechanical churn that §7.5 forbids for no behavioural gain.
 */

/**
 * §7.4 — "Colour is never the sole carrier. Every status renders colour + icon
 * + label." The icon is part of the token, not left to each call site to
 * remember, so a bare colour chip cannot be built by accident.
 *
 * ## Typed `IconName`, not `string` — this map shipped three broken glyphs
 *
 * It was `Record<StatusKey, string>`, so nothing checked the names against the
 * `Icon` REGISTRY and every call site had to cast with `as IconName`. Three of
 * the eight values named glyphs that do not exist — `neutral` and `dim` both
 * pointed at `circle_dashed`, `progress` at `progress` — and `Icon`'s miss
 * branch rendered them as red `[Icon:…]` developer text **inside status chips
 * on `/clients` and `/crew`**: 51 instances of debug output in front of a
 * client (BUG-001). `RentalsList.tsx` and `CrewBooking.tsx` had each already
 * written a paragraph warning about this exact hazard and removed their own
 * usages; the two remaining live sites were missed.
 *
 * The `IconName` type is what stops it recurring: a name the REGISTRY does not
 * carry is now a compile error here, at the one place the map is written,
 * instead of red text at runtime on whichever screen happens to render it. The
 * `as IconName` casts at the call sites are gone with it — a cast is exactly
 * how the broken names reached the screen. `data/warehouse.ts` and
 * `Maintenance.tsx` already type their equivalent maps this way.
 *
 * Substitutions are from the existing REGISTRY; no glyph was added. `timer` for
 * `progress` follows the established house usage for a waiting state
 * (`warehouse.ts` `Pending: 'timer'`, `BranchesWarehouses.tsx`
 * `'Under Setup': 'timer'`). `neutral` and `dim` keep a **shared** glyph, as
 * they did under `circle_dashed` — colour and word already separate them, and
 * giving them distinct icons would be a design change, not a bug fix.
 */
export const STATUS_ICON: Record<StatusKey, IconName> = {
  neutral: 'dot',
  primary: 'check',
  progress: 'timer',
  out: 'truck',
  in: 'return_arrow',
  danger: 'alert_triangle',
  dim: 'dot',
  ext: 'external_link',
}

/**
 * The **block anatomy** from §4, in one place so no screen re-invents it:
 * solid fill, 11.5px, weight 800, uppercase, 0.04em tracking, radius 6,
 * padding 7x12. A screen that needs a status renders the component that reads
 * this — it never assembles its own.
 */
export const STATUS_BLOCK = {
  fontSize: '11.5px',
  fontWeight: 800,
  textTransform: 'uppercase' as const,
  letterSpacing: '0.04em',
  borderRadius: 'var(--r-chip)',
  padding: '6px 11px',
  border: '1.5px solid var(--border)',
} as const

/**
 * The gold mark is deliberately NOT block anatomy — §4 gives it weight 600 and
 * no uppercase, so it can never be mistaken for a yellow status at a glance.
 */
export const EXT_MARK = {
  fontSize: '11.5px',
  fontWeight: 600,
  letterSpacing: '0.01em',
  borderRadius: 'var(--r-chip)',
  padding: '6px 11px',
  border: '1.5px solid var(--ext-line)',
} as const

/**
 * Solid brand colours for **fills** — KPI icon tiles, dots, bars.
 *
 * `gold` and `purple` are gone: gold because v4.1 §2 forbids it anywhere but
 * the sub-rented outline ("a gold Save button beside a gold sub-rental badge
 * destroys the one distinction a warehouse must see"), purple because the hue
 * is retired outright.
 */
export type BrandKey = 'neutral' | 'primary' | 'progress' | 'warn' | 'success' | 'danger'

export const BRAND: Record<BrandKey, string> = {
  neutral: 'var(--muted)',
  primary: 'var(--primary)',
  progress: 'var(--ready)',
  warn: 'var(--warn)',
  success: 'var(--success)',
  danger: 'var(--danger)',
}

/**
 * The ink that sits **on** a brand fill — an icon glyph inside a coloured tile.
 *
 * Never hard-code `#fff` here. Every pair below was measured against the v4.1
 * §7.8 gate: yellow and orange both fail white ink outright (orange at 3.61:1
 * in the light theme), so both carry dark ink from their own family in BOTH
 * themes. The measurements are recorded in spec §10.
 */
export const BRAND_ON: Record<BrandKey, string> = {
  neutral: 'var(--on-neutral)',
  primary: 'var(--on-primary)',
  progress: 'var(--on-ready)',
  warn: 'var(--on-warn)',
  success: 'var(--on-success)',
  danger: 'var(--on-danger)',
}

/**
 * The same keys for **coloured text on a card**.
 *
 * The brand fills are tuned to read as fills. As 12px text on `--surface` they
 * measure under AA, so each has a text-safe variant that shifts just enough for
 * a red fill and red micro-copy to stay recognisably the same colour without
 * the text being the failing one. §7.8 requires 4.5:1 verified in both themes.
 */
export const BRAND_TEXT: Record<BrandKey, string> = {
  neutral: 'var(--muted)',
  primary: 'var(--primary-text)',
  progress: 'var(--ready-text)',
  warn: 'var(--warn-text)',
  success: 'var(--success-text)',
  danger: 'var(--danger-text)',
}

/* ── Payment status → tone ────────────────────────────────────────────────
 *
 * ⛔ This map existed THREE times: `modules/finance/Payments.tsx`, the payment
 * history on `modules/rentals/BookingDetail.tsx`, and — as a two-way ternary
 * that answered differently — `data/bookingIntel.ts`'s `paymentGlance`. The
 * ledger, the booking's history and the hover card render THE SAME ROW, so
 * three copies is three chances to disagree about whether money arrived, and
 * the ternary already did: it painted `Refunded`, `Failed` and `Cancelled`
 * identically (`progress`, yellow), so a bounced transfer and a refund were
 * one colour, and neither was the red that `Failed` earns.
 *
 * Keyed on `PaymentStatus` so a new enum member is a compile error rather than
 * a silent fallthrough to some default colour.
 */
export const PAYMENT_STATUS_TONE: Record<PaymentStatus, StatusKey> = {
  Received: 'in',
  Refunded: 'neutral',
  Failed: 'danger',
  Cancelled: 'neutral',
}

/**
 * The same map for callers holding a loosely-typed status.
 *
 * `PaymentHistoryRow.status` is a bare `string` (a seed shape), so it cannot
 * index the record above. An unrecognised value resolves to `neutral` — never
 * to `in`: painting an unknown status with the colour that means "the money
 * arrived" is the one wrong answer, and a grey chip beside its own printed
 * word is a legible "we do not recognise this".
 */
export function paymentStatusTone(status: string): StatusKey {
  return (PAYMENT_STATUS_TONE as Record<string, StatusKey | undefined>)[status] ?? 'neutral'
}

/* ── A job state, and how it is painted ───────────────────────────────────
 *
 * `JobState` lives in `lib/workflow.ts` and is shared by Pack, Handover, Return
 * and the case list, so **"finished with exceptions" is not a member to add**
 * for one screen (Law 1). But a job where every row is resolved and some ended
 * badly IS `'Complete'` by that union — and painting it `--success-text` with a
 * checklist puts a green tick directly beside the danger-bordered box the same
 * screen renders to say what went wrong. Two answers to one question, in one
 * glance.
 *
 * The state is unchanged; the chip stops calling it a success. Word, icon and
 * tone move together and the count is in the LABEL (Law 11), so nothing asks
 * the reader to decode a colour.
 *
 * This lives here rather than on a screen because it is now the SECOND floor
 * workspace to need it: Packing shipped `packJobChip` on 6 Sep, and Return's
 * pill had the identical defect — "Complete" in green for a session whose every
 * line was 'Still expected'. A third copy is how the two drift apart, so the
 * exception WORD is a parameter and the rule is not.
 */
export function jobStateChip(
  state: 'Not Started' | 'In Progress' | 'Complete',
  exceptions: number,
  exceptionWord: string,
): { tone: string; icon: IconName; label: string } {
  if (state === 'Complete' && exceptions > 0) {
    return { tone: 'var(--warn-text)', icon: 'alert_triangle', label: `Complete · ${exceptions} ${exceptionWord}` }
  }
  if (state === 'Complete') return { tone: 'var(--success-text)', icon: 'checklist', label: state }
  if (state === 'In Progress') return { tone: 'var(--progress-text)', icon: 'refresh', label: state }
  return { tone: 'var(--text2)', icon: 'dot', label: state }
}
</file>

<file path="src/lib/workspaceContext.tsx">
import { createContext, useContext, useState, useCallback, ReactNode } from 'react'
import type { IconName } from '../components/ui/Icon'
import type { PageActionItem } from '../components/ui/header/pageActionRegistry'

export interface PageHeaderSearchConfig {
  value: string
  onChange: (value: string) => void
  placeholder?: string | undefined
  onClear?: (() => void) | undefined
  onKeyDown?: ((e: React.KeyboardEvent<HTMLInputElement>) => void) | undefined
  ariaLabel?: string | undefined
  inputRef?: React.RefObject<HTMLInputElement> | undefined
}

export interface PageHeaderBulkSelection {
  count: number
  onClear: () => void
  actions: PageActionItem[]
}

export interface WorkspaceHeaderData {
  title: string
  leading?: ReactNode | undefined
  icon?: IconName | undefined
  status?: ReactNode | undefined
  eyebrow?: ReactNode | undefined
  description?: ReactNode | undefined
  breadcrumb?: ReactNode | undefined
  backHref?: string | undefined
  backLabel?: string | undefined
  onBack?: (() => void) | undefined
  unsavedChanges?: boolean | undefined
  isDirty?: boolean | undefined
  search?: PageHeaderSearchConfig | ReactNode | undefined
  actionsConfig?: PageActionItem[] | undefined
  workflowState?: string | undefined
  bulkSelection?: PageHeaderBulkSelection | undefined
  actions?: ReactNode | undefined
  module?: string | undefined
  creationContext?: Record<string, unknown> | undefined
  showAddMenu?: boolean | undefined
  /** The page's own More carries Search, so a phone header drops its Search button (RULING 2026-10-16). */
  searchInMore?: boolean | undefined
}

interface WorkspaceContextType {
  leftPanelElement: HTMLElement | null
  setLeftPanelElement: (el: HTMLElement | null) => void
  rightPanelElement: HTMLElement | null
  setRightPanelElement: (el: HTMLElement | null) => void
  headerInformationElement: HTMLElement | null
  setHeaderInformationElement: (el: HTMLElement | null) => void
  headerActionsElement: HTMLElement | null
  setHeaderActionsElement: (el: HTMLElement | null) => void
  /** Opt-in slots: only pages that use these replace the shell's global search. */
  headerSearchElement: HTMLElement | null
  setHeaderSearchElement: (el: HTMLElement | null) => void
  hasPageSearch: boolean
  setHasPageSearch: (active: boolean) => void
  headerAddActionsElement: HTMLElement | null
  setHeaderAddActionsElement: (el: HTMLElement | null) => void
  hasPageAddActions: boolean
  setHasPageAddActions: (active: boolean) => void
  headerPhoneSearchActionsElement: HTMLElement | null
  setHeaderPhoneSearchActionsElement: (el: HTMLElement | null) => void
  headerSecondaryActionsElement: HTMLElement | null
  setHeaderSecondaryActionsElement: (el: HTMLElement | null) => void
  headerMoreActionsElement: HTMLElement | null
  setHeaderMoreActionsElement: (el: HTMLElement | null) => void
  headerRightActionsElement: HTMLElement | null
  setHeaderRightActionsElement: (el: HTMLElement | null) => void
  hasPageRightActions: boolean
  setHasPageRightActions: (active: boolean) => void
  pageInfo: ReactNode | null
  setPageInfo: (info: ReactNode | null) => void
  headerData: WorkspaceHeaderData | null
  setHeaderData: (data: WorkspaceHeaderData | null) => void
}

const WorkspaceContext = createContext<WorkspaceContextType | null>(null)

export function WorkspaceProvider({ children }: { children: ReactNode }) {
  const [leftPanelElement, setLeftPanelElement] = useState<HTMLElement | null>(null)
  const [rightPanelElement, setRightPanelElement] = useState<HTMLElement | null>(null)
  const [headerInformationElement, setHeaderInformationElement] = useState<HTMLElement | null>(null)
  const [headerActionsElement, setHeaderActionsElement] = useState<HTMLElement | null>(null)
  const [headerSearchElement, setHeaderSearchElement] = useState<HTMLElement | null>(null)
  const [hasPageSearch, setHasPageSearch] = useState(false)
  const [hasPageRightActions, setHasPageRightActions] = useState(false)
  const [headerAddActionsElement, setHeaderAddActionsElement] = useState<HTMLElement | null>(null)
  const [hasPageAddActions, setHasPageAddActions] = useState(false)
  const [headerPhoneSearchActionsElement, setHeaderPhoneSearchActionsElement] = useState<HTMLElement | null>(null)
  const [headerSecondaryActionsElement, setHeaderSecondaryActionsElement] = useState<HTMLElement | null>(null)
  const [headerMoreActionsElement, setHeaderMoreActionsElement] = useState<HTMLElement | null>(null)
  const [headerRightActionsElement, setHeaderRightActionsElement] = useState<HTMLElement | null>(null)
  const [pageInfo, setPageInfo] = useState<ReactNode | null>(null)
  const [headerData, setHeaderDataState] = useState<WorkspaceHeaderData | null>(null)

  const setHeaderData = useCallback((data: WorkspaceHeaderData | null) => {
    setHeaderDataState((prev) => {
      if (prev === data) return prev
      if (!prev || !data) return data
      if (
        prev.title === data.title &&
        prev.icon === data.icon &&
        prev.status === data.status &&
        prev.eyebrow === data.eyebrow &&
        prev.description === data.description &&
        prev.backHref === data.backHref &&
        prev.backLabel === data.backLabel &&
        prev.onBack === data.onBack &&
        prev.unsavedChanges === data.unsavedChanges &&
        prev.isDirty === data.isDirty &&
        prev.search === data.search &&
        prev.actionsConfig === data.actionsConfig &&
        prev.workflowState === data.workflowState &&
        prev.bulkSelection === data.bulkSelection &&
        prev.actions === data.actions &&
        prev.leading === data.leading &&
        prev.breadcrumb === data.breadcrumb &&
        prev.module === data.module &&
        prev.creationContext === data.creationContext &&
        prev.showAddMenu === data.showAddMenu &&
        prev.searchInMore === data.searchInMore
      ) {
        return prev
      }
      return data
    })
  }, [])

  return (
    <WorkspaceContext.Provider value={{
      leftPanelElement, setLeftPanelElement,
      rightPanelElement, setRightPanelElement,
      headerInformationElement, setHeaderInformationElement,
      headerActionsElement, setHeaderActionsElement,
      headerSearchElement, setHeaderSearchElement, hasPageSearch, setHasPageSearch,
      headerAddActionsElement, setHeaderAddActionsElement, hasPageAddActions, setHasPageAddActions,
      headerPhoneSearchActionsElement, setHeaderPhoneSearchActionsElement,
      headerSecondaryActionsElement, setHeaderSecondaryActionsElement,
      headerMoreActionsElement, setHeaderMoreActionsElement,
      headerRightActionsElement, setHeaderRightActionsElement,
      hasPageRightActions, setHasPageRightActions,
      pageInfo, setPageInfo,
      headerData, setHeaderData,
    }}>
      {children}
    </WorkspaceContext.Provider>
  )
}

export function useWorkspace() {
  const ctx = useContext(WorkspaceContext)
  if (!ctx) throw new Error('useWorkspace must be used within a WorkspaceProvider')
  return ctx
}

/**
 * Portal helpers are also rendered by isolated page tests and Storybook-style
 * previews. In those environments there is deliberately no application shell;
 * treating the missing mount point as "not available" keeps the page itself
 * renderable without weakening the strict hook used by the live shell.
 */
export function useOptionalWorkspace() {
  return useContext(WorkspaceContext)
}
</file>

<file path="supabase/migrations/0170_astra_phase0_authorization.sql">
-- ASTRA Phase 0. WRITTEN locally; never apply remotely without N-5 cutover.
-- Existing bytes/records are retained. Unregistered legacy objects fail closed
-- pending the explicit legacy-path mapping decision in OPEN_DECISIONS.md.
begin;

-- SEC-02: estimate is an internal payment-trigger helper, not an API endpoint.
revoke execute on function public.booking_estimate_total(uuid) from public, anon, authenticated;
grant execute on function public.booking_estimate_total(uuid) to service_role;
-- create_booking is SECURITY INVOKER and already marks its pricing transaction.
-- Preserve server pricing for money-blind floor creation without exposing a
-- scalar RPC outside that trusted transaction. No API action sets arbitrary GUCs.
do $migration$
declare definition text;
begin
  select pg_get_functiondef('public.get_model_daily_rate(uuid,uuid)'::regprocedure) into definition;
  definition := replace(definition, E'\r\n', E'\n');
  definition := replace(definition, E'begin\n', E'begin\n  if not auth_can_view_money() and (auth_user_role() not in (''Warehouse'') or current_setting(''app.in_create_booking'', true) is distinct from ''on'') then\n    raise exception ''Financial rate access is not permitted'' using errcode = ''42501'';\n  end if;\n');
  execute definition;
end $migration$;

-- SEC-03: direct client writes cannot claim another human/role. Definer-written
-- server receipts retain their actor (including legitimately attested floor PINs).
create function public.bind_direct_audit_actor() returns trigger
language plpgsql set search_path = public, pg_temp as $$
begin
  if current_user = 'authenticated' then
    if not auth_is_staff() then
      raise exception 'Direct audit submission requires active staff' using errcode = '42501';
    end if;
    new.actor_id := auth_user_id();
    new.actor_role := auth_user_role();
    new.created_at := now();
  end if;
  return new;
end $$;
revoke all on function public.bind_direct_audit_actor() from public, anon, authenticated;
create trigger bind_direct_audit_actor before insert on public.audit_events
for each row execute function public.bind_direct_audit_actor();

-- SEC-04: retain existing last-Owner/self-deactivation invariants while checking
-- the OLD target as well as the NEW privilege level.
create function public.guard_admin_superior_target() returns trigger
language plpgsql set search_path = public, pg_temp as $$
begin
  if new.id is distinct from old.id then
    raise exception 'User identity cannot be changed' using errcode = '42501';
  end if;
  if auth_user_role() = 'Admin' and (old.primary_role = 'Owner' or (old.primary_role = 'Admin' and (
    old.id <> auth_user_id() or new.primary_role is distinct from old.primary_role
    or new.is_active is distinct from old.is_active or new.deactivated_at is distinct from old.deactivated_at
    or new.branch_id is distinct from old.branch_id
  ))) then
    raise exception 'Admin cannot modify Owner or Admin accounts' using errcode = '42501';
  end if;
  return new;
end $$;
revoke all on function public.guard_admin_superior_target() from public, anon, authenticated;
create trigger guard_admin_superior_target before update on public.users
for each row execute function public.guard_admin_superior_target();

-- SEC-05: no recursion through bookings/client RLS when testing driver scope.
create function public.auth_driver_has_open_booking(p_booking uuid) returns boolean
language sql stable security definer set search_path = public, pg_temp as $$
  select auth_user_role() = 'Driver' and exists (
    select 1 from public.delivery_jobs j join public.bookings b on b.id=j.booking_id
    where b.cancelled_at is null and b.archived_at is null and b.stage <> 'Closed' and j.booking_id = p_booking and j.assigned_driver_id = auth_user_id()
      and j.status in ('Scheduled','Ready','In Transit')
  );
$$;
revoke all on function public.auth_driver_has_open_booking(uuid) from public, anon;
grant execute on function public.auth_driver_has_open_booking(uuid) to authenticated;
drop policy clients_select on public.clients;
create policy clients_select on public.clients for select to authenticated using (
  (auth_is_staff() and auth_user_role() <> 'Driver')
  or (auth_user_role() = 'Client' and id = auth_client_id())
);
drop policy bookings_select on public.bookings;
create policy bookings_select on public.bookings for select to authenticated using (
  (auth_is_staff() and auth_user_role() <> 'Driver')
  or (auth_user_role() = 'Client' and client_id = auth_client_id())
  or auth_driver_has_open_booking(id)
);
drop policy booking_lines_select on public.booking_lines;
create policy booking_lines_select on public.booking_lines for select to authenticated using (
  (auth_is_staff() and auth_user_role() <> 'Driver')
  or auth_driver_has_open_booking(booking_id)
  or (auth_user_role() = 'Client' and exists (
    select 1 from public.bookings b where b.id = booking_id and b.client_id = auth_client_id()
  ))
);

-- Driver contact details belong inside a trip, not the client-directory row
-- (which also contains identity/tax/billing fields). Provide a narrow DTO.
create function public.driver_trip_context(p_booking uuid) returns jsonb
language plpgsql stable security definer set search_path = public, pg_temp as $$
declare result jsonb;
begin
  if not auth_driver_has_open_booking(p_booking) then
    raise exception 'An assigned open trip is required' using errcode = '42501';
  end if;
  select jsonb_build_object(
    'bookingId',b.id,'bookingNo',b.booking_no,'pickupAt',b.pickup_at,'returnAt',b.return_at,
    'clientName',c.name,'clientPhone',c.phone,'clientAddress',c.address_line,
    'pickupLocation',b.pickup_location,'returnLocation',b.return_location,
    'items',coalesce((select jsonb_agg(jsonb_build_object('id',l.id,'description',l.description,'quantity',l.qty))
      from booking_lines l where l.booking_id=b.id and l.voided_at is null),'[]'::jsonb)
  ) into result from bookings b join clients c on c.id=b.client_id where b.id=p_booking;
  return result;
end $$;
revoke all on function public.driver_trip_context(uuid) from public, anon;
grant execute on function public.driver_trip_context(uuid) to authenticated;

-- Definer masking views intentionally bypass base-table column grants/RLS.
-- Their old broad staff predicates must not reopen the Driver directory.
-- Keep the staff-roster exception explicitly required by PERMISSIONS P9.
do $views$
declare v record; definition text;
begin
  for v in select c.relname from pg_class c join pg_namespace n on n.oid=c.relnamespace
    where n.nspname='public' and c.relkind='v' and c.relname <> 'staff_directory_v'
  loop
    select regexp_replace(pg_get_viewdef(format('public.%I',v.relname)::regclass,true),';[[:space:]]*$','') into definition;
    execute format('create or replace view public.%I as select scoped.* from (%s) scoped where public.auth_user_role() <> ''Driver''',v.relname,definition);
  end loop;
end $views$;

-- SEC-01: scoped storage access, without creating or deleting any business data.
-- A legacy signed URL is itself a bearer capability. Keep operational metadata
-- readable under 0145, but never return original-file/signature URLs to a
-- money-blind role. Column ACLs enforce this even through direct API queries.
revoke select on public.document_registry from public, anon, authenticated;
revoke select(file_url, signature_url) on public.document_registry from public, anon, authenticated;
grant select(id,client_uuid,document_no,document_type,booking_id,client_id,
  lifecycle_status,file_size_bytes,generated_by,signed_at,signed_by_name,
  voided_at,void_reason,created_at,created_by,updated_at,updated_by)
on public.document_registry to authenticated;

create function public.document_file_location(p_document uuid) returns text
language plpgsql stable security definer set search_path = public, pg_temp as $$
declare location text;
begin
  if auth_can_view_money() is not true or not exists (
    select 1 from public.users u where u.id = auth_user_id()
      and u.is_active and u.deactivated_at is null
  ) then
    raise exception 'Original document access requires monetary authorization' using errcode = '42501';
  end if;
  select d.file_url into location from public.document_registry d where d.id = p_document;
  return location;
end $$;
revoke all on function public.document_file_location(uuid) from public, anon;
grant execute on function public.document_file_location(uuid) to authenticated;

-- Document upload ownership is encoded before metadata registration. Shared
-- financial-staff reads require a registry/invoice link; orphan paths fail closed.
create function public.auth_storage_object_allowed(p_bucket text, p_name text, p_upload boolean)
returns boolean language plpgsql stable security definer set search_path = public, pg_temp as $$
declare
  v_actor uuid := auth_user_id();
  v_role system_role := auth_user_role();
  v_active boolean;
begin
  if v_actor is null then return false; end if;
  select is_active and deactivated_at is null into v_active from users where id = v_actor;
  if v_active is false then return false; end if;
  if p_bucket = 'documents' then
    if p_upload then
      return coalesce(v_active,false) and v_role in ('Owner','Admin','Manager','Coordinator','Accounts')
        and split_part(p_name,'/',1) = 'staff' and split_part(p_name,'/',2) = v_actor::text
        and array_length(string_to_array(p_name,'/'),1) = 3
        and split_part(p_name,'/',3) <> '';
    end if;
    if coalesce(v_active,false) and v_role in ('Owner','Admin','Manager','Coordinator','Accounts')
      and split_part(p_name,'/',1) = 'staff' and split_part(p_name,'/',2) = v_actor::text then
      return true;
    end if;
    if not coalesce(v_active,false) or v_role not in ('Owner','Admin','Manager','Coordinator','Accounts') then
      return false;
    end if;
    return exists (
      select 1 from document_registry d where
        (d.file_url = p_name or split_part(split_part(d.file_url,'/object/sign/documents/',2),'?',1) = p_name)
        -- P4 / N-1: ownership alone cannot authorize an unredacted PDF for a
        -- money-blind role, including Client. Redacted artifacts need their own
        -- verified publication path before any such access can be allowed.
    ) or exists (
      select 1 from public.invoices i where i.pdf_url = p_name
        or split_part(split_part(i.pdf_url,'/object/sign/documents/',2),'?',1) = p_name
    );
  elsif p_bucket = 'evidence' then
    if not coalesce(v_active,false) or v_role not in ('Owner','Admin','Manager','Coordinator','Warehouse','Technician') then
      return false;
    end if;
    -- Session ID/booking ID comparisons use text: malformed paths deny, never cast.
    return exists (
      select 1 from operation_sessions s join bookings b on b.id = s.booking_id
      where s.id::text = split_part(p_name,'/',2) and b.id::text = split_part(p_name,'/',1)
        and (v_role in ('Owner','Admin','Manager') or s.warehouse_staff_id = v_actor or s.started_by = v_actor)
        and (not p_upload or (s.state <> 'Completed' and s.cancelled_at is null and b.cancelled_at is null and b.archived_at is null))
        and array_length(string_to_array(p_name,'/'),1) = 3
    );
  end if;
  return false;
end $$;
revoke all on function public.auth_storage_object_allowed(text,text,boolean) from public, anon;
grant execute on function public.auth_storage_object_allowed(text,text,boolean) to authenticated;

drop policy if exists documents_evidence_select_policy on storage.objects;
drop policy if exists documents_evidence_insert_policy on storage.objects;
drop policy if exists documents_evidence_update_policy on storage.objects;
drop policy if exists documents_evidence_delete_policy on storage.objects;
create policy documents_evidence_select_policy on storage.objects for select to authenticated
using (bucket_id in ('documents','evidence') and public.auth_storage_object_allowed(bucket_id,name,false));
create policy documents_evidence_insert_policy on storage.objects for insert to authenticated
with check (bucket_id in ('documents','evidence') and public.auth_storage_object_allowed(bucket_id,name,true));
-- Restrictive policies prevent a permissive legacy policy from reopening either bucket.
create policy astra_storage_read_boundary on storage.objects as restrictive for select to authenticated
using (bucket_id not in ('documents','evidence') or public.auth_storage_object_allowed(bucket_id,name,false));
create policy astra_storage_insert_boundary on storage.objects as restrictive for insert to authenticated
with check (bucket_id not in ('documents','evidence') or public.auth_storage_object_allowed(bucket_id,name,true));
create policy astra_storage_immutable_update on storage.objects as restrictive for update to authenticated
using (bucket_id not in ('documents','evidence')) with check (bucket_id not in ('documents','evidence'));
create policy astra_storage_immutable_delete on storage.objects as restrictive for delete to authenticated
using (bucket_id not in ('documents','evidence'));

-- Public buckets bypass object SELECT policies for downloads. Keep business
-- buckets private as well as denying anonymous access through permissive policies.
create policy astra_storage_anon_boundary on storage.objects as restrictive for all to anon
using (bucket_id not in ('documents','evidence'))
with check (bucket_id not in ('documents','evidence'));
do $buckets$
begin
  -- The lightweight local prelude does not define hosted Storage's public flag.
  if exists (select 1 from information_schema.columns
    where table_schema = 'storage' and table_name = 'buckets' and column_name = 'public') then
    execute 'update storage.buckets set public = false where id in (''documents'',''evidence'')';
  end if;
end $buckets$;

commit;
</file>

