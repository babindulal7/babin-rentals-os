import { formatAdDateTime } from './bs'
import { formatMoney } from './money'
import type { Paisa } from './money'

export interface RentalSlipData {
  bookingNo: string
  clientName: string
  clientPhone: string
  stage: string
  pickupDate: string
  returnDate: string
  lines: Array<{
    name: string
    serial?: string
    qty: number
    days: number
    amountPaisa?: Paisa
  }>
  subtotalPaisa?: Paisa
  discountPaisa?: Paisa
  vatPaisa?: Paisa
  totalPaisa?: Paisa
  depositPaisa?: Paisa
  advancePaisa?: Paisa
  outstandingPaisa?: Paisa
  operatorName?: string
  branchName?: string
  branchVat?: string
}

/**
 * Generates an 80mm thermal printer format and triggers native window.print() or returns formatted HTML.
 */
export function printRentalSlip(data: RentalSlipData): void {
  if (typeof window === 'undefined') return

  const branch = data.branchName || 'Babin Rentals Kathmandu'
  const vat = data.branchVat || 'VAT: 601234567'
  const dateStr = formatAdDateTime(new Date().toISOString())

  const itemsHtml = data.lines
    .map(
      (l) => `
    <tr style="border-bottom: 1px dashed #ccc;">
      <td style="padding: 4px 0; font-size: 11px;">
        <b>${l.name}</b>${l.serial ? `<br/><span style="font-size: 9px; color: #555;">S/N: ${l.serial}</span>` : ''}
      </td>
      <td style="text-align: center; padding: 4px 0; font-size: 11px;">${l.qty}</td>
      <td style="text-align: center; padding: 4px 0; font-size: 11px;">${l.days}d</td>
      <td style="text-align: right; padding: 4px 0; font-size: 11px;">${l.amountPaisa !== undefined ? formatMoney(l.amountPaisa) : '—'}</td>
    </tr>
  `
    )
    .join('')

  const printWindow = window.open('', '_blank', 'width=380,height=600')
  if (!printWindow) {
    alert('Please allow popups to print thermal receipt slips.')
    return
  }

  const html = `
    <!DOCTYPE html>
    <html>
      <head>
        <title>Rental Voucher — ${data.bookingNo}</title>
        <style>
          @page { size: 80mm auto; margin: 0; }
          body {
            font-family: 'Courier New', Courier, monospace;
            width: 72mm;
            margin: 0 auto;
            padding: 8px 4px;
            color: #000;
            background: #fff;
            font-size: 12px;
            line-height: 1.3;
          }
          .center { text-align: center; }
          .bold { font-weight: bold; }
          .divider { border-top: 1px dashed #000; margin: 6px 0; }
          .double-divider { border-top: 2px solid #000; margin: 6px 0; }
          table { width: 100%; border-collapse: collapse; }
          .flex-between { display: flex; justify-content: space-between; }
        </style>
      </head>
      <body>
        <div class="center bold" style="font-size: 15px; letter-spacing: 1px;">${branch}</div>
        <div class="center" style="font-size: 10px;">${vat}</div>
        <div class="center" style="font-size: 10px;">EQUIPMENT RENTAL HANDOVER SLIP</div>
        
        <div class="divider"></div>

        <div class="flex-between">
          <span>Booking: <b>${data.bookingNo}</b></span>
          <span>Stage: ${data.stage}</span>
        </div>
        <div>Date: ${dateStr}</div>
        <div>Client: <b>${data.clientName}</b></div>
        <div>Phone: ${data.clientPhone}</div>
        <div class="divider"></div>
        <div>Period: ${data.pickupDate} &rarr; ${data.returnDate}</div>

        <div class="divider"></div>

        <table>
          <thead>
            <tr style="border-bottom: 1px solid #000; font-size: 10px;">
              <th style="text-align: left;">ITEM</th>
              <th style="text-align: center;">QTY</th>
              <th style="text-align: center;">DUR</th>
              <th style="text-align: right;">TOTAL</th>
            </tr>
          </thead>
          <tbody>
            ${itemsHtml}
          </tbody>
        </table>

        <div class="divider"></div>

        ${
          data.subtotalPaisa !== undefined
            ? `
          <div class="flex-between"><span>Subtotal:</span><span>${formatMoney(data.subtotalPaisa)}</span></div>
          ${data.discountPaisa ? `<div class="flex-between"><span>Discount:</span><span>-${formatMoney(data.discountPaisa)}</span></div>` : ''}
          ${data.vatPaisa ? `<div class="flex-between"><span>VAT (13%):</span><span>${formatMoney(data.vatPaisa)}</span></div>` : ''}
          <div class="flex-between bold" style="font-size: 13px; margin: 4px 0;"><span>RENTAL TOTAL:</span><span>${formatMoney(data.totalPaisa ?? data.subtotalPaisa)}</span></div>
          <div class="divider"></div>
          ${data.depositPaisa ? `<div class="flex-between"><span>Security Bond:</span><span>${formatMoney(data.depositPaisa)}</span></div>` : ''}
          ${data.advancePaisa ? `<div class="flex-between"><span>Advance Paid:</span><span>${formatMoney(data.advancePaisa)}</span></div>` : ''}
          ${data.outstandingPaisa !== undefined ? `<div class="flex-between bold"><span>BALANCE DUE:</span><span>${formatMoney(data.outstandingPaisa)}</span></div>` : ''}
        `
            : ''
        }

        <div class="double-divider"></div>

        <div style="font-size: 9px; line-height: 1.2; margin-top: 6px;">
          * All equipment checked & verified in operational condition upon handover.<br/>
          * Hirer is liable for damages, missing components or overdue daily rates.
        </div>

        <div style="margin-top: 24px;" class="flex-between">
          <div style="border-top: 1px solid #000; width: 45%; text-align: center; font-size: 9px; padding-top: 3px;">
            Client Signature
          </div>
          <div style="border-top: 1px solid #000; width: 45%; text-align: center; font-size: 9px; padding-top: 3px;">
            Staff: ${data.operatorName || 'Babin HQ'}
          </div>
        </div>

        <div class="center" style="margin-top: 14px; font-size: 9px;">
          Thank you for choosing Babin Rentals!
        </div>

        <script>
          window.onload = function() {
            window.print();
            setTimeout(function() { window.close(); }, 500);
          }
        </script>
      </body>
    </html>
  `

  printWindow.document.open()
  printWindow.document.write(html)
  printWindow.document.close()
}
</file>

<file path="src/lib/productDeposit.ts">
import type { Paisa } from './money'

/**
 * # What a product itself asks as a security deposit (C6)
 *
 * `products.deposit_fixed` and `products.deposit_percent` have been editable on
 * the equipment record since 0004, and nothing ever read them: New Rental's
 * recommended deposit was only "the gear total, never under Rs 5,000". A
 * deposit someone set on a camera body had no effect on the booking.
 *
 * ## The rule (⭐ B-5, the conservative reading — Babin may override)
 *
 * Per unit: a **fixed** deposit wins when it is set; otherwise **percent of the
 * unit's replacement value**; otherwise the product asks for nothing. Per line:
 * unit deposit × quantity (not × days — a deposit is held once). The booking's
 * product deposit is the sum over its physical lines.
 *
 * The recommended deposit is then **the larger of** the existing flat rule and
 * that sum. A product can raise the recommendation; it can never lower it below
 * what the booking asked before this existed. That is the stricter side, and it
 * is reversible with one expression.
 *
 * ## What it is not
 *
 * Not revenue and never part of Rental Total or Outstanding (Law 5) — it feeds
 * only the `recommendedDepositPaisa` input of the pricing pipeline, where the
 * deposit stays its own liability. A staff override (reason + authorising
 * manager) still wins over it, exactly as before.
 *
 * Money-blind sessions read `null` for every figure here (`products_v` masks
 * them), so for them this contributes nothing and the flat rule stands. They
 * never see the deposit in any case (Law 6).
 */

export interface ProductDepositTerms {
  /** `products.deposit_fixed`, whole paisa, or null when unset or masked. */
  fixedPaisa: number | null
  /** `products.deposit_percent`, 0–100, or null when unset or masked. */
  percent: number | null
  /** `products.replacement_value`, whole paisa, or null when unset or masked. */
  replacementPaisa: number | null
}

/** One unit's deposit, in paisa, or null when the product asks for none. */
export function unitDepositPaisa(terms: ProductDepositTerms | undefined): number | null {
  if (!terms) return null
  if (terms.fixedPaisa !== null && Number.isFinite(terms.fixedPaisa) && terms.fixedPaisa > 0) {
    return terms.fixedPaisa
  }
  if (
    terms.percent !== null &&
    terms.replacementPaisa !== null &&
    Number.isFinite(terms.percent) &&
    Number.isFinite(terms.replacementPaisa) &&
    terms.percent > 0 &&
    terms.replacementPaisa > 0
  ) {
    return (terms.replacementPaisa * terms.percent) / 100
  }
  return null
}

export interface DepositLine {
  productId?: string | null | undefined
  qty: number
  lineType?: string | undefined
}

/** Line types that are physical gear and so can carry a product deposit. */
const PHYSICAL = new Set(['Equipment', 'Accessory'])

/** Σ unit deposit × qty over the booking's physical lines, rounded to a whole rupee. */
export function productDepositPaisa(
  lines: readonly DepositLine[],
  terms: ReadonlyMap<string, ProductDepositTerms>,
): Paisa {
  let total = 0
  for (const line of lines) {
    if (!line.productId) continue
    if (line.lineType !== undefined && !PHYSICAL.has(line.lineType)) continue
    if (!Number.isFinite(line.qty) || line.qty <= 0) continue
    const unit = unitDepositPaisa(terms.get(line.productId))
    if (unit !== null) total += unit * line.qty
  }
  return (Math.round(total / 100) * 100) as Paisa
}

/** The recommendation: the flat rule, raised (never lowered) by what the products ask. */
export function recommendedDepositWithProducts(flatRulePaisa: Paisa, fromProductsPaisa: Paisa): Paisa {
  return Math.max(flatRulePaisa, fromProductsPaisa) as Paisa
}
</file>

