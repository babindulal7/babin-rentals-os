<file path="src/lib/safeStorage.ts">
/**
 * # `localStorage` is not a safe operation on WebKit
 *
 * **Found 8 Sep 2026**, diagnosing an app that loaded on an Android phone and
 * showed a blank white page on every Apple device. Every iOS/iPadOS browser is
 * WebKit — Chrome on iPad is Safari's engine wearing Chrome's UI — so
 * "works in Chrome on the phone, fails in Chrome on the iPad" was never a
 * browser difference. It was Blink vs WebKit.
 *
 * ## The mechanism
 *
 * Chrome, asked for `localStorage` where storage is unavailable, hands back a
 * working object or `null`. **Safari throws.** Not on the value — on the
 * *property access itself*, as a `SecurityError` — under:
 *
 *  - **Lockdown Mode**
 *  - Settings ▸ Safari ▸ **Block All Cookies**
 *  - some Private Browsing configurations
 *  - an iframe whose storage is partitioned away
 *
 * Nine call sites across four modules read or wrote storage unguarded, and none
 * of them was inside a `try`. Three of the nine sit **above every
 * `ErrorBoundary`** — `theme.tsx`'s `useState` initializer runs during
 * `ThemeProvider`'s first render, and `collapse.ts` is called by `Sidebar`,
 * which renders at tablet width and up. That last one is why an **iPad** failed
 * where a phone-width device did not: the phone never renders the Sidebar.
 *
 * A throw in any of those is not a lost preference. It is a blank page, with no
 * error UI, on a device with no console.
 *
 * ## The contract
 *
 * Every function here is total: it returns a value or does nothing, and it
 * never throws. A device that cannot store preferences must still run the app —
 * losing a remembered theme is a cost worth paying; losing the app is not.
 *
 * Use this for **preferences**. It is deliberately not a cache and not a
 * database: `offlineQueue` and `localStore` own durable state, and they have
 * their own IndexedDB availability guards.
 */

/**
 * Whether storage answered at all. Not memoised: Lockdown Mode can be toggled
 * without reloading the page, and a stale `true` here is the crash this module
 * exists to prevent.
 */
export function storageAvailable(): boolean {
  try {
    return typeof window !== 'undefined' && !!window.localStorage
  } catch {
    /* The SecurityError described above — the access itself threw. */
    return false
  }
}

/** Read a key, or `null` when storage is unreadable for any reason. */
export function readLocal(key: string): string | null {
  try {
    if (typeof window === 'undefined') return null
    return window.localStorage.getItem(key)
  } catch {
    return null
  }
}

/**
 * Write a key. Returns whether it landed, so a caller that must tell the user
 * "this will not be remembered" can — most callers correctly ignore it.
 *
 * Also swallows `QuotaExceededError`, which Safari raises in Private Browsing
 * with a quota of zero: there, `getItem` works and every `setItem` throws.
 */
export function writeLocal(key: string, value: string): boolean {
  try {
    if (typeof window === 'undefined') return false
    window.localStorage.setItem(key, value)
    return true
  } catch {
    return false
  }
}

/** Remove a key. Silent when storage is unavailable. */
export function removeLocal(key: string): void {
  try {
    if (typeof window === 'undefined') return
    window.localStorage.removeItem(key)
  } catch {
    /* Nothing to remove if nothing could be stored. */
  }
}

/**
 * Every key currently in storage, or `[]`. Used by the settings sweep, which
 * enumerates its own prefix.
 */
export function localKeys(): string[] {
  try {
    if (typeof window === 'undefined') return []
    return Object.keys(window.localStorage)
  } catch {
    return []
  }
}

/**
 * Subscribe to a media query across engines.
 *
 * `MediaQueryList.addEventListener` is **Safari 14+**; 13 and earlier expose
 * only the deprecated `addListener`, and calling the modern one there throws.
 * Both `theme.tsx` and `device.ts` subscribe during a mount effect, so on an
 * older iPad that throw is — again — a blank page rather than a stale value.
 *
 * Returns an unsubscribe that is always safe to call.
 */
export function onMediaChange(query: string, handler: (matches: boolean) => void): () => void {
  try {
    if (typeof window === 'undefined' || !window.matchMedia) return () => {}
    const mq = window.matchMedia(query)
    const listener = (e: MediaQueryListEvent) => handler(e.matches)
    if (typeof mq.addEventListener === 'function') {
      mq.addEventListener('change', listener)
      return () => {
        try {
          mq.removeEventListener('change', listener)
        } catch {
          /* Teardown must not throw during unmount. */
        }
      }
    }
    /* Safari ≤ 13 / older Android WebView. */
    const legacy = mq as MediaQueryList & {
      addListener?: (l: (e: MediaQueryListEvent) => void) => void
      removeListener?: (l: (e: MediaQueryListEvent) => void) => void
    }
    if (typeof legacy.addListener === 'function') {
      legacy.addListener(listener)
      return () => {
        try {
          legacy.removeListener?.(listener)
        } catch {
          /* As above. */
        }
      }
    }
    return () => {}
  } catch {
    return () => {}
  }
}
</file>

<file path="src/lib/scannerFeedback.ts">
/**
 * **Scanner Audio & Haptic Feedback Engine — AUD-002**
 *
 * Provides immediate auditory and tactile feedback for warehouse scanning:
 * - 'ok': Crisp high-pitch double chime (880Hz -> 1760Hz) + single gentle haptic tap
 * - 'wrong': Low warning buzz (180Hz square wave) + double warning vibration pulse
 * - 'error': Low error double buzz (140Hz) + heavy vibration pulse
 */

export type ScanFeedbackTone = 'ok' | 'wrong' | 'error'

let audioCtx: AudioContext | null = null

function getAudioContext(): AudioContext | null {
  if (typeof window === 'undefined') return null
  try {
    const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext
    if (!AudioContextClass) return null
    if (!audioCtx || audioCtx.state === 'closed') {
      audioCtx = new AudioContextClass()
    }
    if (audioCtx.state === 'suspended') {
      void audioCtx.resume()
    }
    return audioCtx
  } catch {
    return null
  }
}

/**
 * Plays a distinct sound chime for scan results.
 */
export function playScanSound(tone: ScanFeedbackTone): void {
  const ctx = getAudioContext()
  if (!ctx) return

  try {
    const now = ctx.currentTime

    if (tone === 'ok') {
      // Pleasant high-pitch double chime (880Hz A5 -> 1760Hz A6)
      const osc1 = ctx.createOscillator()
      const gain1 = ctx.createGain()
      osc1.type = 'sine'
      osc1.frequency.setValueAtTime(880, now)
      gain1.gain.setValueAtTime(0.15, now)
      gain1.gain.exponentialRampToValueAtTime(0.01, now + 0.08)
      osc1.connect(gain1)
      gain1.connect(ctx.destination)
      osc1.start(now)
      osc1.stop(now + 0.08)

      const osc2 = ctx.createOscillator()
      const gain2 = ctx.createGain()
      osc2.type = 'sine'
      osc2.frequency.setValueAtTime(1760, now + 0.09)
      gain2.gain.setValueAtTime(0.2, now + 0.09)
      gain2.gain.exponentialRampToValueAtTime(0.01, now + 0.18)
      osc2.connect(gain2)
      gain2.connect(ctx.destination)
      osc2.start(now + 0.09)
      osc2.stop(now + 0.18)
    } else if (tone === 'wrong') {
      // Low square buzz for unrecognized / wrong item
      const osc = ctx.createOscillator()
      const gain = ctx.createGain()
      osc.type = 'square'
      osc.frequency.setValueAtTime(180, now)
      gain.gain.setValueAtTime(0.18, now)
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25)
      osc.connect(gain)
      gain.connect(ctx.destination)
      osc.start(now)
      osc.stop(now + 0.25)
    } else {
      // Lower double buzz for query/network error
      const osc = ctx.createOscillator()
      const gain = ctx.createGain()
      osc.type = 'sawtooth'
      osc.frequency.setValueAtTime(140, now)
      gain.gain.setValueAtTime(0.2, now)
      gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3)
      osc.connect(gain)
      gain.connect(ctx.destination)
      osc.start(now)
      osc.stop(now + 0.3)
    }
  } catch {
    // Audio playback failures (e.g. autoplay policy) gracefully ignored
  }
}

/**
 * Triggers haptic vibration feedback on supported mobile devices.
 */
export function triggerScanVibration(tone: ScanFeedbackTone): void {
  if (typeof navigator === 'undefined' || !navigator.vibrate) return
  try {
    if (tone === 'ok') {
      navigator.vibrate(60) // Single crisp tap
    } else if (tone === 'wrong') {
      navigator.vibrate([120, 60, 120]) // Warning double pulse
    } else {
      navigator.vibrate([180, 80, 180, 80, 250]) // Heavy error pulse
    }
  } catch {
    // Ignored in non-vibrating environments
  }
}

/**
 * **Peripheral Visual Scan Flash — High-Velocity Warehouse Ergonomics**
 *
 * Flashes a high-saturation full-screen inset glow for 220ms on barcode scan:
 * - 'ok': Vibrant Emerald Green (#10B981)
 * - 'wrong': Warning Amber (#F59E0B)
 * - 'error': High-visibility Crimson (#EF4444)
 *
 * Provides instant peripheral confirmation so floor operators wearing protective
 * glasses or working in glare do not need to pause and read small text.
 */
export function triggerVisualScanFlash(tone: ScanFeedbackTone): void {
  if (typeof document === 'undefined') return
  const id = 'br-scanner-peripheral-flash'
  let flashEl = document.getElementById(id)
  if (!flashEl) {
    flashEl = document.createElement('div')
    flashEl.id = id
    flashEl.setAttribute('aria-hidden', 'true')
    flashEl.style.position = 'fixed'
    flashEl.style.inset = '0'
    flashEl.style.pointerEvents = 'none'
    flashEl.style.zIndex = '99999'
    flashEl.style.transition = 'opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1)'
    document.body.appendChild(flashEl)
  }

  const color = tone === 'ok'
    ? 'rgba(16, 185, 129, 0.5)'
    : tone === 'wrong'
    ? 'rgba(245, 158, 11, 0.55)'
    : 'rgba(239, 68, 68, 0.6)'

  const border = tone === 'ok'
    ? '6px solid rgba(16, 185, 129, 0.95)'
    : tone === 'wrong'
    ? '6px solid rgba(245, 158, 11, 0.95)'
    : '6px solid rgba(239, 68, 68, 0.95)'

  flashEl.style.boxShadow = `inset 0 0 50px ${color}`
  flashEl.style.border = border
  flashEl.style.opacity = '1'

  setTimeout(() => {
    if (flashEl) {
      flashEl.style.opacity = '0'
      flashEl.style.boxShadow = 'none'
      flashEl.style.border = 'none'
    }
  }, 220)
}

/**
 * Unified dispatch helper: triggers audio chime, haptic vibration, and peripheral visual flash.
 */
export function dispatchScanFeedback(tone: ScanFeedbackTone): void {
  playScanSound(tone)
  triggerScanVibration(tone)
  triggerVisualScanFlash(tone)
}
