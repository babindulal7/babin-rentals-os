<file path="src/lib/whatsapp.ts">
/**
 * **WhatsApp deep links — a compose link, never a send.**
 *
 * `WHATSAPP_LINKS_SPEC_v1.0` §1. This module builds a `wa.me` URL that opens
 * WhatsApp with a message already typed. **The staff member presses Send.** We
 * have no API, no webhook and no delivery receipt, so nothing here may ever be
 * recorded as "sent" — see the honesty rule in the spec's §1 and `logPrepared`
 * below. It is the zero-infrastructure bridge until the Communication Center's
 * Cloud API lands; `whatsappTemplates.ts` is deliberately transport-agnostic so
 * those templates migrate unchanged when it does.
 *
 * ## Why a phone number is a parsing problem
 *
 * Nepal dials a 10-digit mobile (`98…`), and `wa.me` requires the full
 * international form with no `+`, no spaces and no dashes. The store holds
 * whatever was typed at the counter. So the normalisation below is the whole
 * mechanism, and its failure case matters more than its success case: a link
 * built on a wrong number opens a chat with a stranger, which is worse than
 * offering no link at all. When the number cannot be trusted this returns
 * `null` and the caller must render its control **disabled with the reason
 * inline** (Law 12 — errors inline and persistent, never a toast).
 */

/** The country code every local 10-digit mobile is missing. */
const NEPAL_CC = '977'

/**
 * Shortest string we will treat as a dialable international number. Eight is
 * the floor for the shortest national numbering plans in use; below it the
 * input is a typo, an extension or a placeholder, not a phone number.
 */
const MIN_INTERNATIONAL_DIGITS = 8

/** A local mobile/landline, before the country code is attached. */
const NEPAL_NATIONAL_DIGITS = 10

/**
 * Normalise a typed phone number to the digits `wa.me` expects, or `null` when
 * the input cannot be trusted (spec §1).
 *
 * Exported separately from `buildWaLink` so a caller can ask *"is there a
 * usable number?"* — to decide whether a button is enabled — without also
 * having to render a message body it may not be allowed to see. That split
 * matters for Law 6: the enabled/disabled decision is not a money decision,
 * but the message body can be.
 */
export function normalisePhone(phone: string | null | undefined): string | null {
  if (!phone) return null
  const digits = phone.replace(/\D/g, '')

  /* Already international. Trust it as typed rather than re-deriving a country
     code we would only be guessing at — a number stored with 977 was stored
     that way deliberately. */
  if (digits.startsWith(NEPAL_CC)) {
    return digits.length > NEPAL_CC.length ? digits : null
  }

  /* The ordinary local case: exactly ten digits is a Nepali number missing its
     country code. Only exactly ten — nine or eleven is a mistyped number, and
     padding or truncating one would invent a recipient. */
  if (digits.length === NEPAL_NATIONAL_DIGITS) return `${NEPAL_CC}${digits}`

  /* A foreign client (a visiting production, a rental partner) whose number is
     already in international form without our country code. Long enough to be
     real, so pass it through as typed; short enough to be junk, so refuse. */
  return digits.length >= MIN_INTERNATIONAL_DIGITS ? digits : null
}

/**
 * Build the `wa.me` compose link, or `null` when the number is unusable.
 *
 * `null` is not an error state to report — it is the signal to render the
 * calling control DISABLED with the inline reason (spec §1, §3). Callers should
 * use {@link NO_PHONE_REASON} so the wording is identical everywhere.
 *
 * The text is `encodeURIComponent`-escaped, which is what carries the
 * templates' newlines (`%0A`) and any `&` in a project name through the query
 * string intact — see the round-trip test.
 */
export function buildWaLink(phone: string | null | undefined, text: string): string | null {
  const number = normalisePhone(phone)
  if (!number) return null
  return `https://wa.me/${number}?text=${encodeURIComponent(text)}`
}

/**
 * The single wording for an unusable number, so the Booking Detail overflow,
 * the payment toast and anything added later cannot drift apart on it.
 */
export const NO_PHONE_REASON = 'No valid phone on this client — add one on the client record first.'

/**
 * Open a composed link. Kept here rather than inlined at call sites so the
 * `noopener` pair is not forgotten: `wa.me` is a third-party origin, and a tab
 * opened without it can reach back through `window.opener`.
 *
 * Returns whether a window was opened, so a caller can tell a blocked popup
 * from a successful hand-off instead of silently claiming success.
 */
export function openWaLink(url: string): boolean {
  if (typeof window === 'undefined') return false
  const win = window.open(url, '_blank', 'noopener,noreferrer')
  return win !== null
}
</file>

<file path="src/lib/whatsappActions.ts">
/**
 * **What a screen may actually offer to send — `WHATSAPP_LINKS_SPEC_v1.0` §3.**
 *
 * `whatsappTemplates.ts` answers *"which templates suit this stage and this
 * role"*; this module answers the next question, which is the one a button
 * needs: *"can this particular message be composed right now, and if not, what
 * is the true reason?"*
 *
 * It is pure — booking facts, settings and a phone number in, menu descriptors
 * out — so the reasons are unit-testable rather than only reachable by driving
 * a screen with four settings in four states.
 *
 * ## Why the reasons matter more than the happy path
 *
 * Every client-facing template needs at least one value this repo did not have
 * before 1 Sep 2026: a usual pickup time, a usual return time, a contact
 * number. The spec files all three under its own §6.1 OPEN list. They are now
 * owner-set settings that default to **blank**, so the honest state on the day
 * this ships is "most of these are unavailable, and each says why". A
 * disabled control that states its cause is the app working correctly (Law 12);
 * a control that sends "Pickup from 10:00 AM" because a developer picked an
 * hour is the app lying in writing to a client.
 */

import { buildWaLink, NO_PHONE_REASON, normalisePhone } from './whatsapp'
import {
  balanceDue,
  bookingConfirmed,
  dispatchManifest,
  gearReady,
  overdue,
  pickupTomorrow,
  returnReceipt,
  returnReminder,
  templatesForStage,
  type WaBusiness,
  type WaStage,
  type WaTemplateId,
  type WaTemplateMeta,
} from './whatsappTemplates'
import type { Paisa } from './money'
import type { SystemRole } from '../types/database'

/** The booking facts a message needs, all read from canonical queries (Law 2). */
export interface WaBookingFacts {
  clientName: string
  bookingNo: string
  stage: WaStage
  startIso: string
  endIso: string
  itemCount: number
  /** A few line descriptions for the confirmation's summary. */
  topLines: string[]
  isOverdue: boolean
  /** `null` when the session may not see money, or when no invoice exists yet. */
  total: Paisa | null
  advance: Paisa | null
  deposit: Paisa | null
  balance: Paisa | null
  hasDamagedOrLost?: boolean
  damageCount?: number
  lostCount?: number
}

/** The owner-set strings. Blank is legal and means "not set" (§6.1). */
export interface WaSettings {
  businessName: string
  businessPhone: string
  defaultPickupTime: string
  defaultReturnTime: string
}

export interface WaAction {
  id: WaTemplateId
  label: string
  /** The composed `wa.me` URL, or `null` when {@link WaAction.unavailable} is set. */
  href: string | null
  /** Present ⇒ render the control disabled and show this verbatim (Law 12). */
  unavailable?: string
}

const SETTINGS_PATH = 'Settings ▸ Organisation ▸ General'

/**
 * Build the menu for one booking, most likely first.
 *
 * Returns `[]` when the stage offers nothing — a Quote, or a money-blind role
 * on a booking whose only remaining message is a money one. An empty array is
 * the signal to omit the group header entirely rather than render an empty
 * menu section.
 */
export function whatsappActionsFor(args: {
  facts: WaBookingFacts
  settings: WaSettings
  role: SystemRole
  /** As stored on the client record; `null`/blank is the ordinary missing case. */
  clientPhone: string | null
}): WaAction[] {
  const { facts, settings, role, clientPhone } = args

  const offered: WaTemplateMeta[] = templatesForStage({
    stage: facts.stage,
    role,
    isOverdue: facts.isOverdue,
    /* Only offer the balance reminder when a balance is both VISIBLE to this
       session and greater than zero. `null` means "not fetched or not
       permitted", which is not the same as "nothing owed" and must not be
       rendered as a reminder for Rs 0. */
    hasBalance: facts.balance != null && facts.balance > 0,
  })

  const business: WaBusiness = {
    businessName: settings.businessName,
    businessPhone: settings.businessPhone,
  }

  /* One phone check for the whole menu: it is the same recipient for every
     template, so a missing number disables all of them for one reason rather
     than repeating itself per row. */
  const phoneOk = normalisePhone(clientPhone) !== null

  return offered.map((meta): WaAction => {
    if (!phoneOk) return { id: meta.id, label: meta.label, href: null, unavailable: NO_PHONE_REASON }

    const built = compose(meta.id, facts, settings, business)
    if (typeof built !== 'string') {
      return { id: meta.id, label: meta.label, href: null, unavailable: built.reason }
    }
    return { id: meta.id, label: meta.label, href: buildWaLink(clientPhone, built) }
  })
}

/** A template that cannot be composed, and the reason a person can act on. */
interface Blocked {
  reason: string
}

function compose(
  id: WaTemplateId,
  f: WaBookingFacts,
  s: WaSettings,
  b: WaBusiness,
): string | Blocked {
  const base = {
    clientName: f.clientName,
    bookingNo: f.bookingNo,
    startIso: f.startIso,
    endIso: f.endIso,
  }

  switch (id) {
    case 'booking_confirmed': {
      /* Two independent gaps, reported separately — being told "set a pickup
         time" when the real problem is a missing invoice would send someone to
         the wrong screen. */
      if (f.total == null) {
        return {
          reason:
            'This booking has no invoiced total to quote yet. The confirmation states a figure, so it waits for the invoice rather than sending a blank one.',
        }
      }
      if (!s.defaultPickupTime) return { reason: missingTime('pickup') }
      return bookingConfirmed(
        {
          ...base,
          lineCount: f.itemCount,
          topLines: f.topLines,
          total: f.total,
          advance: f.advance,
          deposit: f.deposit,
          pickupTime: s.defaultPickupTime,
        },
        b,
      )
    }

    case 'gear_ready': {
      if (!s.defaultPickupTime) return { reason: missingTime('pickup') }
      return gearReady({ ...base, pickupWindow: s.defaultPickupTime }, b)
    }

    case 'pickup_tomorrow': {
      if (!s.defaultPickupTime) return { reason: missingTime('pickup') }
      return pickupTomorrow({ ...base, pickupTime: s.defaultPickupTime }, b)
    }

    case 'return_reminder': {
      if (!s.defaultReturnTime) return { reason: missingTime('return') }
      return returnReminder({ ...base, returnTime: s.defaultReturnTime }, b)
    }

    case 'overdue': {
      if (!s.businessPhone) {
        return {
          reason: `An overdue notice tells the client to ring instead of replying, and no contact number is set. Add one under ${SETTINGS_PATH}.`,
        }
      }
      return overdue(base, b)
    }

    case 'balance_due': {
      /* Unreachable via templatesForStage, which only offers this when the
         balance is a positive number. Kept as a refusal rather than a `!`
         assertion so a future caller cannot turn it into "Rs 0 outstanding". */
      if (f.balance == null || f.balance <= 0) {
        return { reason: 'No outstanding balance is recorded on this booking.' }
      }
      return balanceDue({ clientName: f.clientName, bookingNo: f.bookingNo, balance: f.balance }, b)
    }

    case 'dispatch_manifest': {
      return dispatchManifest(
        {
          ...base,
          itemCount: f.itemCount,
          topItems: f.topLines,
          manifestUrl: null,
        },
        b,
      )
    }

    case 'return_receipt': {
      return returnReceipt(
        {
          ...base,
          itemCount: f.itemCount,
          hasDamagedOrLost: f.hasDamagedOrLost ?? false,
          damageCount: f.damageCount,
          lostCount: f.lostCount,
          depositRefundPaisa: f.deposit,
          balanceDuePaisa: f.balance,
          receiptUrl: null,
        },
        b,
      )
    }

    /* Composed by the payment flow and the closing screen, which hold figures
       a booking row does not — they are not offered from a booking's menu. */
    case 'payment_receipt':
    case 'daily_digest':
      return { reason: 'Sent from its own screen, not from the booking.' }
  }
}

function missingTime(which: 'pickup' | 'return'): string {
  return `No usual ${which} time is set, and this message states one. Add it under ${SETTINGS_PATH} — it is deliberately blank rather than guessed.`
}
</file>

