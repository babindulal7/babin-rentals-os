{
  "name": "babin-rentals-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:3000 && electron electron/main.cjs\"",
    "electron:preview": "npm run build && electron electron/main.cjs --dist",
    "dev:mock": "vite --mode mock",
    "dev:local": "vite --mode localdb",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:apply": "node scripts/apply-migrations-local.mjs",
    "db:list": "node scripts/apply-migrations-local.mjs --list",
    "db:plan": "node scripts/plan-migrations.mjs",
    "db:plan:selftest": "node scripts/plan-migrations.mjs --selftest && node --test scripts/plan-migrations-safety.test.mjs",
    "db:rebuild": "supabase db reset --no-seed && node scripts/apply-migrations-local.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "gates": "node scripts/run-gates.mjs",
    "seed:sql": "node scripts/emit-seed-sql.mjs",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "check:contrast": "node scripts/check-contrast.cjs",
    "check:db": "node scripts/check-db.mjs",
    "check:local-api": "node scripts/check-local-api-access.mjs",
    "test:local-api-guards": "node --check scripts/check-local-api-access.mjs && node --test scripts/local-api-guard.test.mjs && node scripts/check-local-api-access.mjs --help && node --check electron/main.cjs && node --test scripts/test-electron-storage-path.test.mjs",
    "check:rebuild": "node scripts/check-rebuild.mjs",
    "check:pglite": "node scripts/check-pglite.mjs",
    "check:lifecycle": "node scripts/e2e-lifecycle.mjs",
    "check:dump": "node scripts/check-dump.mjs",
    "test:backup": "node --test scripts/backup-db.test.mjs && node --test scripts/check-dump.test.mjs && node --test scripts/restore-sandbox-drill.test.mjs",
    "test:restore-drill": "node --test scripts/restore-sandbox-drill.test.mjs",
    "test:staging-preflight": "node --test scripts/staging-schema-preflight.test.mjs && node --test scripts/verify-staging-readonly.test.mjs",
    "completion": "node scripts/completion.mjs",
    "lint:progress": "node scripts/lint-progress.mjs",
    "lint:shell": "node scripts/check-page-shell-lint.mjs",
    "lint:ui-copy": "node scripts/check-ui-copy.mjs && node --test scripts/check-ui-copy.test.mjs && node --test scripts/test-i18n-review.test.mjs",
    "lint:transitions": "node scripts/check-transition-durations.mjs",
    "db:local": "node scripts/local-db.mjs",
    "storage:local": "node scripts/local-storage.mjs",
    "data:wipe": "node scripts/wipe-user-data.mjs",
    "check:anon": "node scripts/check-anon-exposure.mjs",
    "check:batch-0": "node scripts/rehearse-batch-0-anon-rpcs.mjs",
    "test:audit-coverage": "node scripts/test-audit-trigger-coverage.mjs",
    "test:settings": "node scripts/test-settings-table.mjs",
    "test:saved-views": "node scripts/test-saved-views.mjs",
    "test:operations-grants": "node scripts/test-operations-grants.mjs",
    "test:delivery-route-security": "node scripts/test-delivery-route-branch.mjs",
    "test:delivery-distance-band": "node scripts/test-delivery-distance-band.mjs",
    "test:outsourced-vehicle-quote": "node scripts/test-outsourced-vehicle-quote.mjs",
    "test:waiting-charge": "node scripts/test-waiting-charge-line.mjs",
    "test:pricing-structures": "node scripts/test-pricing-structures.mjs",
    "test:race": "node scripts/test-last-unit-race.mjs",
    "test:server-contracts": "node scripts/test-unit-lifecycle-and-contracts.mjs",
    "test:partial-return": "node scripts/test-partial-return-reservation-release.mjs",
    "test:i18n-review": "node --test scripts/test-i18n-review.test.mjs",
    "i18n:export": "node scripts/i18n-review-export.mjs",
    "i18n:import": "node scripts/i18n-review-import.mjs",
    "check:fixtures": "node scripts/check-no-fixtures.mjs",
    "test:cancellation-branch-security": "node scripts/test-cancellation-branch-boundary.mjs",
    "check:security": "node scripts/check-astra-phase0.mjs && npm run test:operations-grants && node scripts/test-reset-branch-boundary.mjs && node scripts/test-glossary-revisions.mjs && npm run test:cancellation-branch-security -- --candidate && npm run test:cancellation-branch-security",
    "test:online-booking-n7-review": "node scripts/test-online-booking-n7-review.mjs",
    "test:away-mode-db-gate": "node scripts/test-away-mode-db-gate.mjs",
    "test:mfa-db-gate": "node scripts/test-mfa-db-gate.mjs",
    "test:login-audit-db-gate": "node scripts/test-login-audit-db-gate.mjs",
    "db:plan:reviewed": "node scripts/plan-migrations.mjs --accept-rename",
    "test:db-plan-safety": "node --test scripts/plan-migrations-safety.test.mjs",
    "build:staff": "node scripts/check-site-env.mjs staff && tsc --noEmit && vite build --mode staff && node scripts/finalize-site-build.mjs staff && node scripts/verify-site-builds.mjs staff",
    "build:client": "node scripts/check-site-env.mjs client && tsc --noEmit && vite build --mode client && node scripts/finalize-site-build.mjs client && node scripts/verify-site-builds.mjs client",
    "verify:sites": "node scripts/verify-site-builds.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/asar": "^5.3.0",
    "@fontsource/hind": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.47.10",
    "@tabler/icons-react": "^3.46.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "class-variance-authority": "^0.7.1",
    "dexie": "^4.4.4",
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "18.3.1",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.10.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "6.2.6",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "pg": "^8.23.1",
    "supabase": "^2.114.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "6.4.6",
    "vitest": "^3.2.7",
    "wait-on": "^9.1.0"
  }
}
